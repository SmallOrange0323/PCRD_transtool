[
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在吉歐‧格黑納的居住區──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "吶，烏爾姆，",
    "voice": "vo_adv_9009004_000",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "萊拉耶爾殿下應該",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n會更喜歡我剛才找到的",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "「黃金岩漿糖漿」吧？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那可是吉歐‧提格尼亞所沒有的，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "永不冷卻的糖漿呢……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過",
    "voice": "vo_adv_9009004_001",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "味道就只是略酸的檸檬味嘛。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "比起那個，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "去毒的植物魔物醃製物更好吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "什、",
    "voice": "vo_adv_9009004_002",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "什麼去毒的魔物呀！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "怎麼能夠把那種東西拿給萊拉耶爾殿下呢！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我們要找更安心、安全的東西……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咦～",
    "voice": "vo_adv_9009004_003",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "一般常見的東西又沒什麼意思。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "偶爾也要冒險一下吧？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "雖然",
    "voice": "vo_adv_9009004_004",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "是那樣沒有錯！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也不代表可以挑一些奇怪的東西呀！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "得要好好考慮才行……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "所以我才說要分頭行動嘛。",
    "voice": "vo_adv_9009004_005",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我們各自去買適合萊拉耶爾殿下的紀念品，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n再回到這裡集合。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "晚點見了，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊，",
    "voice": "vo_adv_9009004_006",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生～",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊就拜託你了～",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n她要是不小心走丟了會很麻煩的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "慢著！",
    "voice": "vo_adv_9009004_007",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "說我會走丟是什麼意思呀！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……唔。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "她走掉了……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……好。",
    "voice": "vo_adv_9009004_008",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也真是的……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我是絕對不會買那些奇怪的東西的！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這就是這個世界的蘋果……",
    "voice": "vo_adv_9009004_009",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "熱蘋果！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n遠比吉歐‧提格尼亞的蘋果",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要來得更大更紅！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……啊，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不過看起來好像很辣……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咦，",
    "voice": "vo_adv_9009004_010",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這個怎麼樣？",
    "voice": "vo_adv_9009004_011",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "用壓力鍋油炸穀物製成的點心！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n除了葛粉帶有的輕微甜味……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n還稍微加了",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "一點香料。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咦，",
    "voice": "vo_adv_9009004_012",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "請給我這個～",
    "voice": "vo_adv_9009004_013",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n中間這個",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "有點發光的星形水果。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那個，",
    "voice": "vo_adv_9009004_014",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "請給我正中間的",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這個。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "發出微微的光芒正好呢。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德、烏爾姆",
    "words": "「啊，烏爾姆。」\\n「咦，老姊。」",
    "voice": "vo_adv_9009004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳用不著跟過來吧。",
    "voice": "vo_adv_9009004_016",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我才沒有跟著妳呢！",
    "voice": "vo_adv_9009004_017",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不對，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆妳才是不要學我啦。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我是自己選的。",
    "voice": "vo_adv_9009004_018",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德、烏爾姆",
    "words": "就是說啊……",
    "voice": "vo_adv_9009004_019",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我、",
    "voice": "vo_adv_9009004_020",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我覺得不管是哪個，萊拉耶爾殿下都會很高興的……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那當然。",
    "voice": "vo_adv_9009004_021",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這可是我們兩個人挑選的啊？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳也",
    "voice": "vo_adv_9009004_022",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然琳德說出這句話時有些傻眼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但總覺得她的表情很柔和，看起來很愉快。",
    "voice": null,
    "unit_id": null
  }
]
