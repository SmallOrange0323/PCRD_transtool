[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "滿溢著人們笑容的蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在一片祥和的街道上，兩名少女正在散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "謝謝妳今天邀請我，",
    "voice": "vo_adv_5033000_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "栞。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n度過了一段非常有意義的時間呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那真是太好了。",
    "voice": "vo_adv_5033000_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為之前霞",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳有說過，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳也喜歡",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這本推理小說……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是第一次參加作者簽名會，",
    "voice": "vo_adv_5033000_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但沒想到那裡的氣氛那麼友善，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是一次很有意思的體驗呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也是，",
    "voice": "vo_adv_5033000_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然只能在身體狀況良好的時候去參加就是了，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n今天多虧了霞願意陪我過來呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒什麼，",
    "voice": "vo_adv_5033000_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "舉手之勞而已。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n對了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果栞妳方便的話，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n等等要不要去哪裡坐坐，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好好地聊一聊作品呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇，",
    "voice": "vo_adv_5033000_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當然好……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這本推理小說，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "裡面的詭計非常有趣，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我一直想跟人",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好好聊聊呢……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "的確很離奇，",
    "voice": "vo_adv_5033000_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且也很嶄新呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "用流星群來設計的時間差的詭計，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是前所未聞——",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "栞，",
    "voice": "vo_adv_5033000_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳看到了嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n剛剛空中",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有道光……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "movie",
    "movie_id": "503300001"
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "魔法……？",
    "voice": "vo_adv_5033000_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "少女……？",
    "voice": "vo_adv_5033000_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "沒錯！　",
    "voice": "vo_adv_5033000_010",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "純潔的心靈跟",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "可愛的容貌！　",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "還有",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那滿溢而出的無盡的愛！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "為了和平而奮戰，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那就是魔法少女喔！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5033000_011",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "栞。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n妳聽得懂",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這隻魔法生物",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在說什麼嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我有點，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不太能夠理解缺乏邏輯的話呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個……",
    "voice": "vo_adv_5033000_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "摩拉，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會找上我跟霞呢……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "因為魔法國度的女王是這麼說的！",
    "voice": "vo_adv_5033000_013",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n世界上一定會有",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "願意幫助我們的人！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小霞跟小栞！",
    "voice": "vo_adv_5033000_014",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n妳們剛剛",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "救了被困住的我對吧？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我覺得",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這一定就是命運！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我的直覺告訴我！　",
    "voice": "vo_adv_5033000_015",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳們一定就是",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我正在尋找的",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "魔法少女不會錯的！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不，",
    "voice": "vo_adv_5033000_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這不管怎麼想",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都只是純粹的偶然而已……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……不對，霞。",
    "voice": "vo_adv_5033000_017",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔法少女的故事",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一直都是從這種偶然開始的……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n跟可愛的吉祥物邂逅之後，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "瞬間改變了曾經平凡的每一天——",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哇，",
    "voice": "vo_adv_5033000_018",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒想到栞妳",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這麼會說耶……！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5033000_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不是……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我之前有讀過「魔法少女鈴鈴噹」，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一不小心就……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_5033000_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能夠熱烈的談論是件好事啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果是魔法少女的故事，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來會怎麼樣？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯～",
    "voice": "vo_adv_5033000_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "跟吉祥物邂逅之後，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n幾乎——",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "！　",
    "voice": "vo_adv_5033000_022",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這股邪惡的氣息……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "兩位請小心，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那個就在附近！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "——都會出現",
    "voice": "vo_adv_5033000_023",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "敵人呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": "vo_adv_5033000_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我懂了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "話說回來，",
    "voice": "vo_adv_5033000_025",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在這種大街上",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "居然會出現魔物？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "警備是怎麼了……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且那種魔物，",
    "voice": "vo_adv_5033000_026",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n連在書裡也沒有看過……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "果然出現了嗎！",
    "voice": "vo_adv_5033000_027",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
