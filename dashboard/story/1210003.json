  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嚕拉拉，",
    "voice": "vo_adv_1210003_001",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嚕拉拉～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n快點逃離",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥吧～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喔喔～！",
    "voice": "vo_adv_1210003_002",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "美美跑得好努力喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}也要加油喔～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……鏡華，",
    "voice": "vo_adv_1210003_003",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n謝謝妳們三個在玩到一半時",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我們加入！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為{0}接連遇到了很辛苦的事情，",
    "voice": "vo_adv_1210003_004",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這樣好像能讓他的心情好轉。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不，",
    "voice": "vo_adv_1210003_005",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果沒有顧著他，我會很不放心。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為{0}是……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇哇！？",
    "voice": "vo_adv_1210003_006",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你別過來這邊！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你果然是",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "變態可疑分子！！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈☆",
    "voice": "vo_adv_1210003_007",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小孩子是風的孩子，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "充滿了活力呢！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家好好玩吧～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……呼～",
    "voice": "vo_adv_1210003_008",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這三個人果然，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n也和我認識的",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "【小小甜心】一模一樣啊。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿和小雪菲也是，",
    "voice": "vo_adv_1210003_009",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然名字有點不一樣，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但那兩個人果然和我認識的",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "【美食殿堂】的她們沒有不同……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過",
    "voice": "vo_adv_1210003_010",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就只有小凱留和我們剛相遇時一樣，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "渾身都是刺啊～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就算小凱留全身上下的刺多到不行，",
    "voice": "vo_adv_1210003_011",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n她那樣也很可愛……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但我卻",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "覺得有點不放心。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯……",
    "voice": "vo_adv_1210003_012",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在回到蘭德索爾之前，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能不能再和她聊一次呢……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………",
    "voice": "vo_adv_1210003_013",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": "vo_adv_1210003_014",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳來得正好！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "阿囉哈～☆",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳、",
    "voice": "vo_adv_1210003_015",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳突然講這什麼話啊！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不要大聲地找我搭話啦……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……找我有事嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的！",
    "voice": "vo_adv_1210003_016",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "居然能在這種地方再次見到妳，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好巧喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我現在剛好在想小凱留的事情喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳不覺得",
    "voice": "vo_adv_1210003_017",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這果然是命中注定的嗎？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咻咻♪",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我才不覺得",
    "voice": "vo_adv_1210003_018",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是那樣咧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是說，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "凱留是誰啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我叫希留耶啦。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "再者，",
    "voice": "vo_adv_1210003_019",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳說「再次」是什麼意思？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我根本完全不認識",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳這個人啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊嗚～",
    "voice": "vo_adv_1210003_020",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為這個世界正在重複同一天，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我跟妳是",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「初次見面」啊。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為我很高興能見到妳，",
    "voice": "vo_adv_1210003_021",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就不自覺地……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我沒辦法陪妳聊這些莫名其妙的事情。",
    "voice": "vo_adv_1210003_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不要妨礙我散步……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "再見。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請、",
    "voice": "vo_adv_1210003_023",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……怎樣啦？",
    "voice": "vo_adv_1210003_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳還有什麼事？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個……",
    "voice": "vo_adv_1210003_025",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想請妳帶我去一個地方！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為我不熟悉這附近的環境，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒辦法自己過去……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳認識",
    "voice": "vo_adv_1210003_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "剛才和妳在一起的那些人吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n找妳朋友帶路就好啦？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": "vo_adv_1210003_027",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想請妳帶我過去。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果不是和妳",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一起去那個地方……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以就拜託妳了，",
    "voice": "vo_adv_1210003_028",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小希留耶！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嘖……",
    "voice": "vo_adv_1210003_029",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我知道了啦。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n等我帶妳過去後，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳就要從我面前消失喔。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇～！",
    "voice": "vo_adv_1210003_030",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳這種傲嬌的地方好可愛喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳說誰傲嬌啊！？",
    "voice": "vo_adv_1210003_031",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n啊～受不了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳再吵我就不帶妳去囉！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈～☆",
    "voice": "vo_adv_1210003_032",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "別這麼說嘛，麻煩妳了！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好了好了，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唉……",
    "voice": "vo_adv_1210003_033",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是這裡沒錯吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n能從山丘上",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "眺望整個城鎮的地方。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對，",
    "voice": "vo_adv_1210003_034",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是這裡！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡",
    "voice": "vo_adv_1210003_035",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好令人懷念喔……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那時候",
    "voice": "vo_adv_1210003_036",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會來到這裡，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是為了幫助小凱留吧。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我相信這個時候，",
    "voice": "vo_adv_1210003_037",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在蘭德索爾的小凱留，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也正在為了我們努力……！　",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那就這樣，",
    "voice": "vo_adv_1210003_038",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我要走了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "還有，",
    "voice": "vo_adv_1210003_039",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就算在鎮上看到我，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳也不要再裝熟跟我搭話了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我們應該不會再見面了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那個，",
    "voice": "vo_adv_1210003_040",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "幹嘛？",
    "voice": "vo_adv_1210003_041",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳還有什麼事情？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……我認識一個",
    "voice": "vo_adv_1210003_042",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和妳非常像的人。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1210003_043",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "反正那只是和我很像的別──",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對。",
    "voice": "vo_adv_1210003_044",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳或許算是",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和她神似的別人，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但我並不這麼認為。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以……",
    "voice": "vo_adv_1210003_045",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳可以聽我說說",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個人的事情嗎？一下子就好。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這裡是",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我和那個人的回憶之地。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………",
    "voice": "vo_adv_1210003_046",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和妳很像的那個人……",
    "voice": "vo_adv_1210003_047",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "叫做小凱留。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳們的名字很像吧？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "長相也真的是同個模子刻出來的喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_1210003_048",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳和她有一個",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很大的不同。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳看起來……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像比她還要",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再痛苦一點。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "！？",
    "voice": "vo_adv_1210003_049",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我剛遇見",
    "voice": "vo_adv_1210003_050",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留時，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她也渾身都是刺。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是個傲嬌全開的女孩。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她和【美食殿堂】的夥伴們，",
    "voice": "vo_adv_1210003_051",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一起取得了被譽為世界第一好吃水果的",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "密林的果實，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃了用龍的尾巴做成的關東煮……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就在一起經歷這些冒險的過程中，",
    "voice": "vo_adv_1210003_052",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們的羈絆",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "變得越來越深厚。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後她漸漸坦率了起來，",
    "voice": "vo_adv_1210003_053",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開始會跟我們說出她難受的過去",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和真心話。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡……",
    "voice": "vo_adv_1210003_054",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是小凱留把她一直藏在心裡的想法，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n坦承說出來的地方。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以",
    "voice": "vo_adv_1210003_055",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我才想跟和小凱留很像的妳，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n再來這裡一次。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "冒險？",
    "voice": "vo_adv_1210003_056",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "美食……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n妳在講什麼啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "再說，",
    "voice": "vo_adv_1210003_057",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真虧妳有辦法一臉正經地……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n把羈絆這種",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "令人難為情的詞彙講出來啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈，",
    "voice": "vo_adv_1210003_058",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聽妳這麼一說，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或許真的是這樣呢。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那只能用羈絆來描述喔。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後就是啊，",
    "voice": "vo_adv_1210003_059",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有個在【美食殿堂】中心的男孩子，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為這樣的我和小凱留",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "繫起了羈絆。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他那個人穩重",
    "voice": "vo_adv_1210003_060",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "又溫柔，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比一般人還要努力，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我明明比較強，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他卻還是想要保護我……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……來到這個世界時，",
    "voice": "vo_adv_1210003_061",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是孤伶伶的一個人。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但知道",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他也在這裡後，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "減緩了我的不安。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那就和",
    "voice": "vo_adv_1210003_062",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "第一次見到他時的情況一樣。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在我失去所有一切，",
    "voice": "vo_adv_1210003_063",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "獨自進行武者修行時，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他幫助了正在餓肚子的我。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喜歡他的人",
    "voice": "vo_adv_1210003_064",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是只有我而已，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留也非常喜歡他喔？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1210003_065",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "誰喜歡那種人啊！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……呃，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳不是在說我啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但在聽妳",
    "voice": "vo_adv_1210003_066",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "講過這些後……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我開始覺得",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那很像是我認識的人……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這、",
    "voice": "vo_adv_1210003_067",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這種感覺",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是怎麼一回事啊……！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "事情就是這樣，",
    "voice": "vo_adv_1210003_068",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我得想出辦法，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n盡快回到",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "蘭德索爾才行……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為",
    "voice": "vo_adv_1210003_069",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我以後也想一直",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和小凱留一起繼續創造回憶！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且要是",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比以前都還要棒的美好回憶！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以說，",
    "voice": "vo_adv_1210003_070",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請妳",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再等我一下喔……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "希留耶，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請妳",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也為我們加油吧！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "如此這般，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n貪吃佩可在{0}不知道時與希留耶有所交流，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並加深了她想回到蘭德索爾的決心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後，為了取回{0}牽繫起來的羈絆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n脫離這個「人工世界」，貪吃佩可握起了劍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501500"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": "vo_adv_1210003_071",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳是小凱留對吧！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳是……",
    "voice": "vo_adv_1210003_072",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可吧。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳果然",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在另一個世界啊。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那我就放心了……",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幸好那傢伙",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是孤單一人。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想得沒錯！",
    "voice": "vo_adv_1210003_073",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在蘭德索爾的小凱留",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然也在為我們努力！　",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話又說回來，",
    "voice": "vo_adv_1210003_074",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "來幫助我們的人多到很驚人呢……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都很關心{0}……！　",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留居然率領了這麼大一群人，",
    "voice": "vo_adv_1210003_075",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好感動！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧☆　",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果{0}的力量太過強大到會滿溢出來，",
    "voice": "vo_adv_1210003_076",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我會承接住所有一切。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為",
    "voice": "vo_adv_1210003_077",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可是肚子餓得咕嚕咕嚕叫的貪吃佩可！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就算是{0}的力量",
    "voice": "vo_adv_1210003_078",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也會津津有味地品嚐喔！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為留下剩飯不符合我的原則！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果火力全開對這股強大的力量不管用，",
    "voice": "vo_adv_1210003_079",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我只要超越火力全開的極限就行了。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我要超越火力全開囉，",
    "voice": "vo_adv_1210003_080",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把{0}和我的羈絆，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n再一次，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "連結起來吧！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可為了承接從他身上滿溢而出的力量，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n帶著超越火力全開的決心，與異狀的根源劍戟相交。",
    "voice": null,
    "unit_id": null
  }
]
