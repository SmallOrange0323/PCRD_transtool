  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊，",
    "voice": "vo_adv_1027005_001",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n您是來見我嗎？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我好開心……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呀啊！",
    "voice": "vo_adv_1027005_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有魔物！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人！",
    "voice": "vo_adv_1027005_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您為了保護我，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "受傷了……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "竟敢傷害{0}大人……",
    "voice": "vo_adv_1027005_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "你作好覺悟了吧？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘰歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我已經收拾了魔物。",
    "voice": "vo_adv_1027005_005",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為我的關係，真的非常抱歉。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n居然讓{0}大人您受傷了…",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "糟糕！",
    "voice": "vo_adv_1027005_006",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您流血了……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在就替您治療！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請不要動！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": "vo_adv_1027005_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人的血……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……治療？",
