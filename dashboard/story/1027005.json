  },
  {
    "type": "dialogue",
    "name": "惠理子的信",
    "words": "「今天是我的生日，",
    "voice": "vo_adv_1027005_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子的信",
    "words": "我非常想見您一面。」",
