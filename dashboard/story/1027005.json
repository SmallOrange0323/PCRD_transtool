  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這個「散發誘引魔物香氣的藥」，",
    "voice": null,
    "unit_id": 102711
