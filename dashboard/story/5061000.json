    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……咦？",
    "voice": "vo_adv_5061000_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呼，",
    "voice": "vo_adv_5061000_013",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看來是趕上了。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有沒有受傷呀？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "唔哇啊啊啊！？",
    "voice": "vo_adv_5061000_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "又、",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "又出現魔物了──！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "受不了──",
    "voice": "vo_adv_5061000_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是失禮呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "至少今天沒受到攻擊。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好了，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "帶著木材回去吧♪",
