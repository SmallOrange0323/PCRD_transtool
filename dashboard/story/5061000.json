  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小鈴妳真是的，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看妳那樣子是剛起床對吧？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳真的很貪睡呢！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不要在我剛睡醒的時候唸我啦～",
    "voice": "vo_adv_5061000_019",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "看到莉瑪毛茸茸的毛皮以後，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感覺又有點想睡了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "晚安～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "毛茸茸～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小鈴！",
    "voice": "vo_adv_5061000_020",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的毛皮可不是床鋪哦，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "受不了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哎呀？",
    "voice": "vo_adv_5061000_021",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "莉瑪，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "歡迎回來。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳工作辛苦了。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我回來了，小栞。",
    "voice": "vo_adv_5061000_022",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小栞妳才是，起來走動沒問題嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯，",
    "voice": "vo_adv_5061000_023",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天狀態還不錯，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以剛剛也去巡邏過了。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那真是太好了♪",
    "voice": "vo_adv_5061000_024",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真希望小鈴也能向小栞學學呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒關係的。",
    "voice": "vo_adv_5061000_025",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "鈴能夠如此愜意地睡覺，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就代表現在非常和平呀。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是的，",
    "voice": "vo_adv_5061000_026",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小栞妳太溫柔了啦！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我回來了──！",
    "voice": "vo_adv_5061000_027",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哦，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家都在一起啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真陽！",
    "voice": "vo_adv_5061000_028",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "出去兜售辛苦妳了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "照妳的樣子來看，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "似乎賣得很不錯呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "正是如此的啦！",
    "voice": "vo_adv_5061000_029",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牛奶轉眼間就被客人榨光了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n奶油也有許多人",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "像腳底抹油一樣跑來買，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我真是",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "非～常感動啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……我好像",
    "voice": "vo_adv_5061000_030",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感覺到了不好笑的搞笑氣息。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "別說了～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "別妨礙我睡覺～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哦，",
    "voice": "vo_adv_5061000_031",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴起來啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n看來妳很喜歡我的搞笑段子，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那就來個讓妳清醒的",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搞笑段子一百連發吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我～",
    "voice": "vo_adv_5061000_032",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要～！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不想聽，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我才不想聽～！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等等，小鈴！",
    "voice": "vo_adv_5061000_033",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不要把臉埋進我的毛皮啦！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵，",
    "voice": "vo_adv_5061000_034",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那麼",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "既然大家都到齊了，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們來喝杯茶吧。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好啦，",
    "voice": "vo_adv_5061000_035",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴妳也差不多該動一動了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "茶就交給鈴鈴來泡吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦咦～",
    "voice": "vo_adv_5061000_036",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真麻煩～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大家，喝水就行了吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": "vo_adv_5061000_037",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然很開心呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要跟大家在一起，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那些瑣碎的煩心事",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "根本算不了什麼。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對了，",
    "voice": "vo_adv_5061000_038",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "莉瑪，這本書給妳。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是妳之前說想看的書哦。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇啊，",
    "voice": "vo_adv_5061000_039",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝妳，小栞！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？",
    "voice": "vo_adv_5061000_040",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那本書莉瑪",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳之前不是也在看嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯，",
    "voice": "vo_adv_5061000_041",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我非常喜歡這個故事♪",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n所以才會像這樣",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一直反覆地看。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小鈴偶爾也看看這種書如何？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很有趣哦♪",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～",
    "voice": "vo_adv_5061000_042",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這麼說好像潑妳冷水，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我對那種書沒什麼興趣呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦──",
    "voice": "vo_adv_5061000_043",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼呀！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "被欺負的女孩子，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n藉由魔法的力量換上了禮服，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "然後在豪華王宮的舞會中，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n與王子殿下一見鍾情，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這不是很棒的故事嗎！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要是身為一位女孩子，",
    "voice": "vo_adv_5061000_044",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "絕對會有所憧憬的吧！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦──",
    "voice": "vo_adv_5061000_045",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那種輕飄飄的裙子再加上玻璃鞋，我可不想穿呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "既然要用魔法變出東西的話，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我還比較想要睡起來超舒服的床，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還有無窮無盡的紅豆麵包呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯──",
    "voice": "vo_adv_5061000_046",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我也對於那種打扮不太習慣呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比起那些，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我比較想要提升對於搞笑的品味，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n或是讓動物們飽餐一頓啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是的，",
    "voice": "vo_adv_5061000_047",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳們兩個",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣也算正值青春的少女嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小栞應該能理解我的這份心情吧？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這、",
    "voice": "vo_adv_5061000_048",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然也不是無法理解……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但在那之前，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我比較想要的應該是能出席舞會的健康身體，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吧？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "連小栞都這樣！",
    "voice": "vo_adv_5061000_049",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家再多抱有一點少女情懷啦～！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": "vo_adv_5061000_050",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這肯定才是正常的反應吧。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是不是因為我的這副模樣，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓我有些太不切實際了呢？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": "vo_adv_5061000_051",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最喜歡【伊麗莎白牧場】，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也最喜歡大家了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "永遠待在這裡，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "待在這個像太陽般柔和又溫暖的地方。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": "vo_adv_5061000_052",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算只有一次也好，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我想接觸看看像這故事裡的璀璨世界。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這種願望",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一直都存在於我的心中。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我不需要會改變日常的",
    "voice": "vo_adv_5061000_053",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那種戲劇性發展。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過即使只有一點也行，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我想要體驗不同於平常的刺激！　",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……只是隨便說說啦。",
    "voice": "vo_adv_5061000_054",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n明明已經很幸福了，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "再抱著這種奢求，可是會遭天譴的。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哦──",
    "voice": "vo_adv_5061000_055",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說到舞會，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天在跟客人聊天的時候，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我聽說了一件事哦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦，",
    "voice": "vo_adv_5061000_056",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是什麼事呀？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真陽，快告訴我！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳還真有興趣呢，",
    "voice": "vo_adv_5061000_057",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聽說呀，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在某座城鎮有位貴族，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n想要以打開通往社交界的大門這名目，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "舉辦一場大規模的舞會哦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯嗯，",
    "voice": "vo_adv_5061000_058",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "然後呢然後呢？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以呢，",
    "voice": "vo_adv_5061000_059",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "他們似乎正在各地物色舞會的參加者。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這件事跟微不足道的酪農戶無關的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嘿～",
    "voice": "vo_adv_5061000_060",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "貴族大人做事都很大手筆呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就算邀請我去舞會，我也絕對不會去就是了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n小栞感覺倒很有可能被邀請呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我、",
    "voice": "vo_adv_5061000_061",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我對那種事也沒什麼興趣……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "舞會……",
    "voice": "vo_adv_5061000_062",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然是真實存在的呀。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也想要有一天能穿著漂亮的禮服，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "跟別人跳支舞呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只是說說啦。",
    "voice": "vo_adv_5061000_063",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我這身毛茸茸的身體，不可能會有適合的禮服的，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n況且像我這種樣貌，怎麼可能會被貴族邀請呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "夢就只是夢，",
    "voice": "vo_adv_5061000_064",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的心中分得很清楚。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只是做夢的話，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "應該是被允許的吧？　",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後，莉瑪與往常一樣正在砍伐著木材。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿咻──",
    "voice": "vo_adv_5061000_065",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呼……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "肚子餓了，使不上力……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都是因為小鈴說什麼「莉瑪妳變胖了？」這種失禮的話，",
    "voice": "vo_adv_5061000_066",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n害我早上一不小心吃得比平常少，真是失策……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然過分的減肥是不太好，",
    "voice": "vo_adv_5061000_067",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但不管怎樣都會覺得在意呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這已經能算是女孩子的宿命了吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算想吃點什麼，",
    "voice": "vo_adv_5061000_068",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也沒帶便當來，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這附近也沒有能當點心吃的果實，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼辦呀……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說到果實……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有了，",
    "voice": "vo_adv_5061000_069",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "變身蘋果。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "把寶貴的道具用在這種用途上沒問題嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……但是，",
    "voice": "vo_adv_5061000_070",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "肚子餓了也是無可奈何的事！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要開動了──！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嚼嚼嚼，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯──！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗚嗚，",
    "voice": "vo_adv_5061000_071",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "身、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "身體……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "痛痛痛……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看來是",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "成功了呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n雖然能變成人類是很好，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但就只有這份痛楚很難以忍受呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼",
    "voice": "vo_adv_5061000_072",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就繼續工作吧……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我都忘記了！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n人類的樣貌",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "使不出力氣，沒辦法工作啊！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭──！",
    "voice": "vo_adv_5061000_073",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我真是個冒失鬼！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n在蘋果的效用消失之前，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對了，",
    "voice": "vo_adv_5061000_074",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟機會難得，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就去鎮上看看吧！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n如果不是這種樣貌，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可沒辦法隨便去鎮上呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "吃點好吃的東西、",
    "voice": "vo_adv_5061000_075",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "去看看店裡的商品，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "回程時再買些伴手禮！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "越想越開心呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "既然決定好了，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就馬上出發吧～！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": "vo_adv_5061000_076",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "跟山上不同，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "鎮上真是熱鬧呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人們的喧囂、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "滿滿的建築物，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還有從某處飄來的",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "食物香味……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯──",
    "voice": "vo_adv_5061000_077",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "偶爾接觸一些這種刺激也不錯呢！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "總之",
    "voice": "vo_adv_5061000_078",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就先去吃飯吧？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n只吃變身蘋果的話，果然還是有些空虛……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那間裁縫店的櫥窗裡的，",
    "voice": "vo_adv_5061000_079",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇啊……",
    "voice": "vo_adv_5061000_080",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好美麗的禮服！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "跟在書上看到的一模一樣！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n實在是太漂亮了……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是能穿上這種禮服的話，",
    "voice": "vo_adv_5061000_081",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那該有多幸福呀。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n而且如果",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還能出席舞會的話……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呀……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是太棒了。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算沒辦法參加舞會，",
    "voice": "vo_adv_5061000_082",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果只是買下來……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "噫！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n禮、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "禮服原來這麼貴嗎？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算踏實地努力存錢，",
    "voice": "vo_adv_5061000_083",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n等到買得起的時候，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也已經變成老婆婆了……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……果然",
    "voice": "vo_adv_5061000_084",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "美夢就只是一場夢呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "光是能夠看到這麼漂亮的禮服，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我就該感到慶幸了。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "？？？　",
    "words": "那個，",
    "voice": "vo_adv_5061000_085",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "？？？　",
    "words": "那邊那位小姐，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "？？？　",
    "words": "能夠稍微打擾一下嗎？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦，",
    "voice": "vo_adv_5061000_086",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我嗎……？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這、",
    "voice": "vo_adv_5061000_087",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這個人是誰呀。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該不會是什麼團體的招募？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還是推銷？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "感覺不是那樣。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "況且他的打扮也挺有模有樣的。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "其實我",
    "voice": "vo_adv_5061000_088",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "是受命於某位高貴的大人，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "\\n目前正在尋找像您這樣的女性。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這、",
    "voice": "vo_adv_5061000_089",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "如果您願意的話，",
    "voice": "vo_adv_5061000_090",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "要不要參加我家主人主辦的舞會呢？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦，",
    "voice": "vo_adv_5061000_091",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "舞會……？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "您真愛說笑呢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "這絕不是在開玩笑。",
    "voice": "vo_adv_5061000_092",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "如您所見，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "這就是那場舞會的邀請函。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……真的嗎？",
    "voice": "vo_adv_5061000_093",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "是真的。",
    "voice": "vo_adv_5061000_094",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種……",
    "voice": "vo_adv_5061000_095",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種事",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的有可能嗎──！？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對突然敞開的夢想之門，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n莉瑪不禁發出了驚呼。",
    "voice": null,
    "unit_id": null
  }
]
