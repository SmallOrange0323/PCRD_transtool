    "words": "\\n──就是這麼回事吧！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……那、",
    "voice": "vo_adv_1387001_052",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個～",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳從剛才開始，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "都在說些什麼啊……？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n美冬教練？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳有在聽嗎？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "少女在成為臀士之前，",
    "voice": "vo_adv_1387001_053",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就已經是守護家庭的「鬥士」……",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "若菜，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是個可怕的人！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我已經開始期待妳",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有一天能轉變為真正的桃鬥者了！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咿……！？",
    "voice": "vo_adv_1387001_054",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n這個人，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "竟然對著我的屁股講話……！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "太不正常了啦～！　",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "只是平凡地做家事的若菜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "卻獲得了美冬認可。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不僅克服了穿著泳裝的羞恥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與{0}的關係也更加親近，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她又向真正的桃鬥者",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "邁進了一步──",
    "voice": null,
