    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "沒問題的！",
    "voice": "vo_adv_9006513_012",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n總之，只要不消耗掉魔力，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "能夠一次解決掉牠就行了吧？",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n那麼，這時候就該用──",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "「驅獵」！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
