    "type": "dialogue",
    "name": "晴吉",
    "words": "不是……！",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n我用了我的力量",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "來幫他了。",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n因為看起來好像真的很費時……",
