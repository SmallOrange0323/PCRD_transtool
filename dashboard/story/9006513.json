    "type": "dialogue",
    "name": "和正",
    "words": "說、",
    "voice": "vo_adv_9006513_018",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "說得也是！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n首先呢……",
    "voice": null,
    "unit_id": 6411
