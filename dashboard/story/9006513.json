    "type": "dialogue",
    "name": "和正",
    "words": "\\n我會使用大海驚喜箱，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "將獵物趕到你們那裡去！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "然後，你們就卯盡全力",
    "voice": "vo_adv_9006513_019",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "使出猛烈的攻擊。這就是我的計畫！！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "原來如此……！",
    "voice": "vo_adv_9006513_020",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這作戰計畫很好喔……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是啊～",
    "voice": "vo_adv_9006513_021",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難得大叔會想到這麼讚的計畫。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們就按照計畫在那裡等待。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你可別失手囉！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": "vo_adv_9006513_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，和正先生，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一切就拜託你囉～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "遵命！",
    "voice": "vo_adv_9006513_023",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n小姑娘們",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "儘管放心等待吧───！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "……呼，",
    "voice": "vo_adv_9006513_024",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這下全都要憑",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "我一個人的本領了。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "嗯？",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "我一個人……？",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "唔、",
    "voice": "vo_adv_9006513_025",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "啊啊啊～～～！？",
