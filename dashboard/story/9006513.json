    "type": "dialogue",
    "name": "和正",
    "words": "喂，各位！",
    "voice": "vo_adv_9006513_008",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n我這邊也準備好囉！",
    "voice": null,
    "unit_id": 6411
