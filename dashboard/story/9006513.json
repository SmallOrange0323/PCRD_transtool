    "type": "dialogue",
    "name": "和正",
    "words": "那個，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "你們所有人",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "都到那裡去等待並累積力量！",
    "voice": null,
    "unit_id": 6411
  },
