  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "是鈴奈！？",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n太好了～！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
