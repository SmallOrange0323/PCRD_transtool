[
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好了，",
    "voice": "vo_adv_5082308_000",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "已經無處可逃了吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你跑我追的遊戲也到此為止了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是的，",
    "voice": "vo_adv_5082308_001",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "給人多費這麼多力氣。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你竊走的",
    "voice": "vo_adv_5082308_002",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不僅僅是食材而已，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n那是大家期待的",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "年菜材料……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "代表著充滿笑容的新年呀。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_5082308_003",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說得沒錯。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n講得很好嘛。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是這樣。",
    "voice": "vo_adv_5082308_004",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n納命來吧！",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "將我們的新年，",
    "voice": "vo_adv_5082308_005",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還回來！",
    "voice": null,
    "unit_id": 120711
  }
]
