  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了建造新的「鳳凰的庭園」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與鳳凰在吉歐‧格黑納逗留中──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咿咿────────！",
    "voice": "vo_adv_1347003_000",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "每次每次都這樣",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真是的────────！！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "吵死了！",
    "voice": "vo_adv_1347003_001",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "別逃了快讓我吃吧────！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "不對！",
    "voice": "vo_adv_1347003_002",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "要吃的是我！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "快給我讓出來！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為何、",
    "voice": "vo_adv_1347003_003",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為什麼總是以吃我為前提啊！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你們那嘴巴是專門用來吃的嗎！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n用來稱讚我不是比較好嗎啊～～！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "聽好囉！？",
    "voice": "vo_adv_1347003_004",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n雖然我現在是這副模樣，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n但我其實",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "是身為青空霸主的──",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "我當然知道。",
    "voice": "vo_adv_1347003_005",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "妳是六凶其中之一的",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "萬花菲尼克斯吧？",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就是那樣！",
    "voice": "vo_adv_1347003_006",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咦？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你們是知道了",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "還想吃我？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "有傳聞說",
    "voice": "vo_adv_1347003_007",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "只要吃了妳，就能獲得強大的力量呢。",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "\\n滋養強壯不在話下，",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "要是毛髮跟排便都能變得滑順，",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "\\n那我可不能放過啊！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "來，",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "成為我的養分吧！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "竟然想把這偉大而優雅的我",
    "voice": "vo_adv_1347003_008",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "當成營養餐……！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我可不打算變成妳的膳食纖維喔！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "啊，",
    "voice": "vo_adv_1347003_009",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "等等！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "給我等一下！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "\\n──",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "啊啊可惡，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "別拍拍翅膀飛走啊～！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……唔唔，",
    "voice": "vo_adv_1347003_010",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我好震驚……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "他們明明應該知道我真實的模樣，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "還對我實施那種暴行！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n現在的我",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "別說是不死鳥了，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "甚至連信天翁都不如嗎！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "別說是被當成神明了，",
    "voice": "vo_adv_1347003_011",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我甚至不被當成妖魔人看待嘛──！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我還是真實模樣的時候，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "他們明明那麼惶恐的～～～",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "開心的",
    "voice": "vo_adv_1347003_012",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "事……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "跟貪吃佩可她們",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "泡溫泉之類的？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "跟拿娜",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "分享好喝的飲料，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "跟克蘿茜一起在天上飛，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "還有……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……也、",
    "voice": "vo_adv_1347003_013",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也算是",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不全然只有壞事呢。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n也有因為是這個模樣",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才能辦到的事……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你是想這樣說吧？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那、",
    "voice": "vo_adv_1347003_014",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那兩件事能算開心嗎……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你是想鼓勵我吧？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好吧。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "看在你那份心意上，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我會打起精神的♪",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "…………",
    "voice": "vo_adv_1347003_015",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我先",
    "voice": "vo_adv_1347003_016",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "試著跟剛剛那些人談談吧。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n既然要在這片土地上活下去，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我也不能光是四處逃竄。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你想要跟我一起去談",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "的權利吧？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那個……",
    "voice": "vo_adv_1347003_017",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "各位────",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你們聽著！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "偉大而優雅的本人我，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "有重要的事要──",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "吵死了！",
    "voice": "vo_adv_1347003_018",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男流氓",
    "words": "閃遠一點啦鳥仔！！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "鳥、",
    "voice": "vo_adv_1347003_019",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "鳥仔！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "唔，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咦？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "總覺得村子好像",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "比平常還更混亂耶。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "狩獵不死鳥，",
    "voice": "vo_adv_1347003_020",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "女流氓",
    "words": "等跟這傢伙做完了斷後再說！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咦咦！？",
    "voice": "vo_adv_1347003_021",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "同、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "同伴之間起內鬨了！？",
    "voice": null,
