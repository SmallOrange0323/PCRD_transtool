[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在散步時偶然遇到真琴。\\n為了幫忙她的工作，{0}來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔～喔～",
    "voice": "vo_adv_1104001_000",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真不愧是酷暑，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n海水浴場裡的人還真多啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之前休假時跟公主她們去的海灘，",
    "voice": "vo_adv_1104001_001",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n真是個不為人知的好地方啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
    "voice": "vo_adv_1104001_002",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　{0}，怎麼了？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n東張西望的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說今天不是要工作嗎？",
    "voice": "vo_adv_1104001_003",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以現在……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊、原來如此，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你以為是跟往常一樣的巡邏吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱歉抱歉，",
    "voice": "vo_adv_1104001_004",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒有詳細跟你說明工作內容呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我覺得你什麼也不問就跟過來也不太好呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可不要被什麼奇怪的傢伙騙了喔？",
    "voice": "vo_adv_1104001_005",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣會難過的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我？",
    "voice": "vo_adv_1104001_006",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　我當然也……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃，不要忽然問奇怪的問題啦！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個、",
    "voice": "vo_adv_1104001_007",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我剛剛是要說甚麼啊，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是工作內容。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我今天的工作",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是巡邏海灘喔。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就像你看到的，",
    "voice": "vo_adv_1104001_008",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這個時期來海邊玩的遊客很多對吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n所以很容易出現溺水意外啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這些事情",
    "voice": "vo_adv_1104001_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然其實是王都騎士團的工作，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過他們在重要的時候總是會缺席呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為",
    "voice": "vo_adv_1104001_010",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "諸多原因，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就變成我們得出場啦。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼了？",
    "voice": "vo_adv_1104001_011",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　一直盯著這邊看……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我的打扮怎麼了嗎？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為、",
    "voice": "vo_adv_1104001_012",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼要懷疑啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我穿什麼都沒關係吧！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔！",
    "voice": "vo_adv_1104001_013",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　那就來去游……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "才不是呢！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是危險，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "差點就忘記原本的目的了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為是來海邊，",
    "voice": "vo_adv_1104001_014",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不穿泳衣的話反而很奇怪吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我可不是",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為想要玩才穿泳衣喔！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": "vo_adv_1104001_015",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "居然做些奇怪的猜想。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "今天的工作是在海灘巡邏。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "說的帥氣一點的話，就是救生員",
    "voice": "vo_adv_1104001_016",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之類的吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了，",
    "voice": "vo_adv_1104001_017",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為你失憶了所以聽不懂吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所謂的救生員呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是在像這樣的海邊，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n專門救人的專家喔。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過要以救生員自稱的話，",
    "voice": "vo_adv_1104001_018",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n其實要取得各種證照",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有通過許多檢定呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但我就不是了呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了～",
    "voice": "vo_adv_1104001_019",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n今天的我呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "應該說是……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "海邊的巡守員，",
    "voice": "vo_adv_1104001_020",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之類的吧♪",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": "vo_adv_1104001_021",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在開始巡邏之前，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我先教教你在海邊救人時的基本救助方法吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不然要是真的遇到狀況卻什麼都不會",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那就沒意義了吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔，",
    "voice": "vo_adv_1104001_022",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你挺有幹勁的嘛！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很好，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我會嚴格地指導你喔♪",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……嗯，大概就是這樣了吧。",
    "voice": "vo_adv_1104001_023",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n記住急救站的位置了嗎？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可別忘記囉？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你記東西算是很快了呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "然後，",
    "voice": "vo_adv_1104001_024",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "接下來",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是救助溺水的人時，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "如果失去意識的話，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "分秒必爭的急救方法，但是……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯……",
    "voice": "vo_adv_1104001_025",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這部分到時候我來做就好了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不用教你也沒關係吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦咦……",
    "voice": "vo_adv_1104001_026",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可是……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說要是記住了，",
    "voice": "vo_adv_1104001_027",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總有一天說不定會派上用場？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這種想法很不錯呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我知道了、",
    "voice": "vo_adv_1104001_028",
