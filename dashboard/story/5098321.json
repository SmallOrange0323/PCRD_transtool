  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好厲害～",
    "voice": "vo_adv_5098321_001",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一模一樣耶～！",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不過",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "為什麼會出現我們？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……說不定",
    "voice": "vo_adv_5098321_002",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是我們的心靈造成的。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "禊＆美美",
    "words": "咦？",
    "voice": "vo_adv_5098321_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然想送走小繆……",
    "voice": "vo_adv_5098321_004",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "心裡卻……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華，",
    "voice": "vo_adv_5098321_005",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不可以再說了！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唔！",
    "voice": "vo_adv_5098321_006",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……抱歉。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華，",
    "voice": "vo_adv_5098321_007",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "妳不用道歉。",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n沒事的……",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對吧？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也就是說，",
    "voice": "vo_adv_5098321_008",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們心中的想法，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n形成了那些冒牌貨吧。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼……",
    "voice": "vo_adv_5098321_009",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們一定要打敗它們！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嗯，",
    "voice": "vo_adv_5098321_010",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是呀。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊說得沒錯。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果我們不打敗它們……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不克服障礙的話……！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n小繆也會擔心得回不去的！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "看著吧，",
    "voice": "vo_adv_5098321_011",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小繆！",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "會努力加油……",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "會拚盡全力的！",
    "voice": null,
    "unit_id": 122911
  },
  {
