  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人不發一語地爬著樹。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "老爺爺曾告訴過人家，",
    "voice": "vo_adv_5100004_000",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "怕寂寞的羊的故事。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "植物羊先生現在",
    "voice": "vo_adv_5100004_001",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也還是獨自等待著嗎……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有辦法……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好好履行",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "跟老爺爺的約定嗎……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "唉～！",
    "voice": "vo_adv_5100004_002",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我已經",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "爬不動了啦──！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不管怎麼爬，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "景色看起來都一樣……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的有在往上爬吧？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是說呀。",
    "voice": "vo_adv_5100004_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "應該已經爬蠻高的了喔？",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳看，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "往下看的話",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "已經有點可怕了呢。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有點可怕是指……",
    "voice": "vo_adv_5100004_004",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀啊啊！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n已已已、",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "已經爬到這麼高的地方了嗎！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "等等等、",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "等一下……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥……！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是會怕就是會怕嘛！",
    "voice": "vo_adv_5100004_005",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "千萬不要掉下去喔……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「哦、",
    "voice": "vo_adv_5100004_006",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "哦……」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "background",
    "bg_id": "501852"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呼……",
    "voice": "vo_adv_5100004_007",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "天色也開始變暗了，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n今天就在這附近",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "露營吧。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯，",
    "voice": "vo_adv_5100004_008",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "贊成！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我已經走不動了啦……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「哦。",
    "voice": "vo_adv_5100004_009",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳的努力沒有白費呢！",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n離終點就剩一點點了喔。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_5100004_010",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉也辛苦了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不對，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉根本沒有自己走嘛。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「說什麼傻話。",
    "voice": "vo_adv_5100004_011",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "為了不掉下去，我可是有在配合妳的重心，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n幫了妳很多忙耶！？",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n啊──",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不過，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "要我自己抓住妳",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "也很難就是了啦。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊哈哈，",
    "voice": "vo_adv_5100004_012",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "知道啦知道啦。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起嘛！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為有噗吉幫我，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的好走很多喔。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我就說吧──？",
    "voice": "vo_adv_5100004_013",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我是不曉得我之前有沒有做到啦，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n但現在的我",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "可是超級噗吉呢。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我無所不能！",
    "voice": "vo_adv_5100004_014",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n……雖然是還沒到這種程度啦，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n總覺得我能做到更多事了。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_5100004_015",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要是沒有噗吉雷達，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們也不可能來到這裡啊。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉很帥喔！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我用摸摸頭誇獎你吧～！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喂喂，",
    "voice": "vo_adv_5100004_016",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "住手啦，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我會害羞的！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "回去之後一定，",
    "voice": "vo_adv_5100004_017",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n要跟噗爸和噗媽",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "說說途中各式各樣的事喔！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「哦、",
    "voice": "vo_adv_5100004_018",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "哦。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就是說啊。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸欸，",
    "voice": "vo_adv_5100004_019",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要是能拿到更多羊先生的綿毛，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n噗吉會變成怎樣的噗吉呢？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這麼一說，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我好像沒有想過",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "最強的噗吉會是怎麼樣呢。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「不知道呢。",
    "voice": "vo_adv_5100004_020",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n也許是得到",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "可以對魔物使出超強全力揮擊的",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "一顆鐵頭吧。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……鐵頭噗吉啊。",
    "voice": "vo_adv_5100004_021",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "的確好像會很強！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過如果噗吉不再軟綿綿的話，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我應該會有點寂寞吧……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「放心吧，",
    "voice": "vo_adv_5100004_022",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也是！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那",
    "voice": "vo_adv_5100004_023",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "能飛上天之類的。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「那好像也很有趣的樣子……",
    "voice": "vo_adv_5100004_024",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不過",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳要抓著應該會很辛苦吧？」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「而且，",
    "voice": "vo_adv_5100004_025",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "雖然想了這麼多，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n但其實……",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也不覺得現在這樣有什麼不好啊。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n只要跟妳在一起，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "本大爺不管什麼時候都是超級噗吉嘛。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_5100004_026",
    "unit_id": 123211
  },
  {
