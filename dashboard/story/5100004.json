  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這裡看比蘭德索爾還要閃亮呢。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n都快看不出星座了。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "另外，",
    "voice": "vo_adv_5100004_046",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "在下面的森林裡，",
