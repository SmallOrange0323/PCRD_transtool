[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "將騙子交給了王宮騎士團的{0}與凱留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在前往美食殿堂的公會小屋途中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n注意到了貼在佈告欄上的傳單。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1120003_000",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n怎麼了啊？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突然停下來。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "公會管理協會主辦的",
    "voice": "vo_adv_1120003_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "新年題字大會的公告？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟是過年啊，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "新年題字沒什麼好稀奇的吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "叫我看獎品？",
    "voice": "vo_adv_1120003_002",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n獎品是……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "特大招財貓？　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想要這種東西嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種東西只會佔空間吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說是這麼說，",
    "voice": "vo_adv_1120003_003",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又覺得特大招財貓",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有點可愛……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n其實還滿想放在",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "公會小屋的。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真、",
    "voice": "vo_adv_1120003_004",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真拿你沒辦法耶！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n既然你想要特大招財貓的話，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就來幫你吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "加油！　",
    "voice": "vo_adv_1120003_005",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "個頭啦，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也要參加啊。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這是理所當然的吧？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了。",
    "voice": "vo_adv_1120003_006",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n新年題字的用具都備齊了，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要開始囉！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還問",
    "voice": "vo_adv_1120003_007",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "開始什麼。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當然是新年題字……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對喔。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你根本連新年題字是什麼都不知道呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我來示範給你看，",
    "voice": "vo_adv_1120003_008",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你看好了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "首先是",
    "voice": "vo_adv_1120003_009",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "像這樣子沾墨水，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後用筆寫下今年的目標。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要注意紙張有正反面。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？　",
    "voice": "vo_adv_1120003_010",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哪邊才是正面呢？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我記得",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是光滑的那一面才對！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒有錯！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一定是！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_1120003_011",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要來寫字囉。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要寫什麼呢？　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "保守一點寫",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全家平安",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "之類的？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之就先寫那個吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全、",
    "voice": "vo_adv_1120003_012",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "家、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "平、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "安……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完成了！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如何？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你、",
    "voice": "vo_adv_1120003_013",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你那是什麼眼神啊！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你想要說我寫得很差嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那也沒辦法啊！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我一直過著像流浪貓一樣的生活，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以沒學過要怎麼寫出漂亮的字啊！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": "vo_adv_1120003_014",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我都已經示範給你看了，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也快點寫吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "光是有兩個人參賽，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就能提高特大招財貓到手的機率了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "回答得很好，",
    "voice": "vo_adv_1120003_015",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這種氣勢！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我雖然沒對你抱持期待……",
    "voice": "vo_adv_1120003_016",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但你果然",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也寫得很差呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還說什麼",
    "voice": "vo_adv_1120003_017",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對不起。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這不是需要道歉的事情吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你只要努力練習，變厲害就好了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我就是為了這個目的才買來這麼多的紙啊。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "相對的，",
    "voice": "vo_adv_1120003_018",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可不允許你放棄……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但我想",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也不會那麼做吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "盡力去做吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯──",
    "voice": "vo_adv_1120003_019",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然跟一開始比起來好多了，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但總覺得不太行啊──",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我覺得",
    "voice": "vo_adv_1120003_020",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也進步滿多的喔？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我寫得很差，由我來說也沒什麼說服力就是了……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": "vo_adv_1120003_021",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別露出那麼高興的表情！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你寫得還很差啦！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕快再重新開始練習吧！",
    "voice": "vo_adv_1120003_022",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "寫好了寫好了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "點、",
    "voice": "vo_adv_1120003_023",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鉤、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "撇",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是很重要的部分吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "光是注意著這些地方書寫，寫出來的字就很不一樣了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你問我",
    "voice": "vo_adv_1120003_024",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是什麼嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我來教你，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之你先寫吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯，",
    "voice": "vo_adv_1120003_025",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是撇。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那邊是點。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就是鉤喔。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大概。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也沒辦法嘛，",
    "voice": "vo_adv_1120003_026",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這只是聽來的知識啊。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "仔細看著你書寫之後，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總覺得我好像懂了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓我示範一下喔？",
    "voice": "vo_adv_1120003_027",
    "unit_id": 112011
  },
  {
    "type": "still",
    "still_id": "112000301"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大概是",
    "voice": "vo_adv_1120003_028",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡要這樣寫，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該會比較好看吧……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再來，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡要",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？　",
    "voice": "vo_adv_1120003_029",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯──",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是很順利呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明在旁邊看的時候，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺好像已經懂了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再來一次。",
    "voice": "vo_adv_1120003_030",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡要",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好好停住。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡是",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "順順地撇過去。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡則是",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "往上面",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "勾起來的感覺，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "接著是停……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃！？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "still",
    "still_id": "112000302"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_1120003_031",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道啦！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "筆、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "筆滑了一下啦！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "still",
    "still_id": "112000302"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒、",
    "voice": "vo_adv_1120003_032",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我突然打了個嗝！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真傷腦筋呢！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難得寫得很順的說！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n唔、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎、",
    "voice": "vo_adv_1120003_033",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼辦。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n仔細一想，這個姿勢",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就和抱住他沒什麼兩樣啊！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且這傢伙還一臉沒事的樣子。",
    "voice": "vo_adv_1120003_034",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好歹也給我稍微不知所措一點啊……！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_1120003_035",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉～～",
    "voice": "vo_adv_1120003_036",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就我一個人在那邊瞎忙，跟傻瓜一樣。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你不用特地回答我也知道啦！",
    "voice": "vo_adv_1120003_037",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n在寫出滿意的字之前，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就這樣繼續練習吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
