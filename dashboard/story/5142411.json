[
  {
    "type": "background",
    "bg_id": "500881"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "終わってしまいましたね、",
    "voice": "vo_adv_5132411_000",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クリスマス。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "こうして撤収作業を見てると、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いっそう実感させられます……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "でも、",
    "voice": "vo_adv_5132411_001",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "こんなに寂しく思えるのは、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それだけ楽しかったという証ですよね！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そうですね。",
    "voice": "vo_adv_5132411_002",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私もトラブルを前に",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "右往左往するクレジッタさまを",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nたくさん見ることができ、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "とても満足しました。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その歪んだ愉悦は心の中にしまっておきなさい！",
    "voice": "vo_adv_5132411_003",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "でもまあ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "たしかにクリスマスのたった一日のために",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n必死に準備してきたのですから、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "やはり寂しさはありますわね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "──本当にそれだけでしょうか。",
    "voice": "vo_adv_5132411_004",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何か言いまして？　",
    "voice": "vo_adv_5132411_005",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "秘書１号。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いいえ、",
    "voice": "vo_adv_5132411_006",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "何も。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……秘書１号の減らず口は後で塞ぐとして。",
    "voice": "vo_adv_5132411_007",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下が寂しい思いをされているのは由々しき事態。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nというわけで",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下にはこの後少しお付き合い願いますわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "え、",
    "voice": "vo_adv_5132411_008",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いいですけど、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いったい何を……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今回協力していただいた方を招いて打ち上げですわ！",
    "voice": "vo_adv_5132411_009",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nしんみりいい話で終わるのもアリですが、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下にはやはり",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "笑顔でいてもらいませんと！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさまのポケットマネーですので、",
    "voice": "vo_adv_5132411_010",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "どうぞ好きなだけ",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "飲み食いしてください。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふん、",
    "voice": "vo_adv_5132411_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんな言葉でわたくしが慌てると思いまして？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お金なんて使ってなんぼ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "使ったらまた稼げばいいだけですわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……えへへ、",
    "voice": "vo_adv_5132411_012",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "結局最初から最後まで、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nクレジッタさんに頼りっぱなしですね。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それならお言葉に甘えて、",
    "voice": "vo_adv_5132411_013",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いっぱい楽しませてもらいます☆",
    "voice": null,
    "unit_id": 127911
  }
]
