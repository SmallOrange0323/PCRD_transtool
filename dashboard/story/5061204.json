  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "周遭的氣氛好像突然變了……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "直到剛才明明都還很安靜的說，",
    "voice": "vo_adv_5061204_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在卻多了很多",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "魔物的氣息呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我想大概是魔物的公主殿下發揮了真本事吧。",
    "voice": "vo_adv_5061204_002",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "觸碰到這股魔力的魔獸們都開始蠢蠢欲動了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是夠了！",
    "voice": "vo_adv_5061204_003",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣不就沒辦法好好談話了嗎！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我們趕緊去見公主殿下吧！",
    "voice": null,
    "unit_id": 115811
  }
