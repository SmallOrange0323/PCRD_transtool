[
  {
    "type": "background",
    "bg_id": "501162"
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "己の目的を叶えるためには、",
    "voice": "vo_adv_6056501_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n時に表へ姿を現し、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "リスクを冒すことも必要不可欠です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nそのための準備はもちろん欠かしてはなりません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "それは……",
    "voice": "vo_adv_6056501_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "いえ、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方に聞かせる話ではありませんね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nとにかく、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "何事にも準備は大切です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nそのことだけをしっかりと覚えておくように。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "いいですね？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……貴方に会うために姿を見せたわけではありません。",
    "voice": "vo_adv_6056501_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "とはいえ、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "直接会話をするというのも",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "悪くはありませんね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n遠目に観察するだけでは得られない、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴重な情報もありますから。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ええ、",
    "voice": "vo_adv_6056501_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "その通り。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "この体は分身です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nですが、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "分身といえど",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "本体と感覚を共有する設定にしています。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "なので……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "興味本位で私の頬をプニプニと触らないように。",
    "voice": null,
    "unit_id": 107011
  }
]
