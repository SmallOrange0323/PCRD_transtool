  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該不會是所謂的",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「禮物就是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子你」吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你還挺大膽的嘛。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然",
    "voice": "vo_adv_1071500_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是慶祝我生日，那我就不客氣了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不是那個意思？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在已經來不及了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你已經是我的東西了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧，",
