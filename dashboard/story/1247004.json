  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "年初診所最後一天的夜晚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看完診的深月，單手拿著麥酒自暴自棄。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……嗝。",
    "voice": "vo_adv_1247004_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大家氣氛和樂融融的……",
    "voice": "vo_adv_1247004_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "地新會的患者們",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為了迴避，突然全都不來了……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "結果……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我又變回能讓溫泉顧客們放鬆的形象了……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗝。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是不是沒事，",
    "voice": "vo_adv_1247004_002",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才在這裡喝酒啊～？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……你看啦～～",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個眼罩的彈力繩，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "變得鬆垮垮的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……得重新縫了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼！？",
    "voice": "vo_adv_1247004_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你剛剛說親切！？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你說了親切吧，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是這張嘴、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這張嘴說的──！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……嗝。",
    "voice": "vo_adv_1247004_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……真是的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不應該是這樣的啊～",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……嗚嗚。",
    "voice": "vo_adv_1247004_005",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……嗝。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……嗚嗚。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗝。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗝。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "囉嗦～！",
    "voice": "vo_adv_1247004_006",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "囉嗦囉嗦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我才沒有哭呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……真是的，不要看我～",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………嗝。",
    "voice": "vo_adv_1247004_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那是什麼……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那道光。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "background",
    "bg_id": "510301"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………唉。",
    "voice": "vo_adv_1247004_008",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………唉唉。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………我不該來的……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "──是你啊！",
    "voice": "vo_adv_1247004_009",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你在做什麼？",
    "voice": "vo_adv_1247004_010",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n過年怎麼",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "會在這種地方？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_1247004_011",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「妳才是，在這裡做什麼」？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……是啊，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "的確。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天是同學會，",
    "voice": "vo_adv_1247004_012",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是新年的慣例。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n接下來要續攤，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "正要去下一間店。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……咦？",
    "voice": "vo_adv_1247004_013",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你說「但妳看起來心情不太好」",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……是嗎？",
    "voice": "vo_adv_1247004_014",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討厭啦～",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼都瞞不過你",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這場同學會",
    "voice": "vo_adv_1247004_015",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "每年都會辦。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可是每次都有來喔，雖然很讓人意外。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": "vo_adv_1247004_016",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "已婚的同學越來越多……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n理所當然的，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "關於家人和孩子的話題也會變多嘛。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我",
    "voice": "vo_adv_1247004_017",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "並沒有認為結婚就是一切喔？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在不是那種時代，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也還有",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "想做的事。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只是……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼說呢……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "明明大家",
    "voice": "vo_adv_1247004_018",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都在人生階段中不斷前進，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n卻好像只有我",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一直",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在原地踏步的感覺……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然，",
    "voice": "vo_adv_1247004_019",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是我自己的人生。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n既不可能要別人等我，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n也沒辦法",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓別人拉著我前進，這我明白。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖然明白，但……",
    "voice": "vo_adv_1247004_020",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唉。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我在想，",
    "voice": "vo_adv_1247004_021",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是自己的研究能拿出成果，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "心情可能還會好一點吧？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之類的……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之類的之類的……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_1247004_022",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討厭，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大過年的卻說這種事。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大人就是會這樣",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "思考些無聊的事情呢……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_1247004_023",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……不過，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n即使如此，在不久之前……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺和大家什麼都能聊。",
    "voice": "vo_adv_1247004_024",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "無論是焦躁、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不安、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是希望，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼都可以。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n因為大家都站在起跑線。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "然而現在，",
    "voice": "vo_adv_1247004_025",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有種彼此",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好像無法再更進一步的感覺……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對處於不同人生階段的人，要是聊得太過深入，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n無論是受傷、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是被傷害，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都令人害怕。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "即使像這樣每年聚在一起，",
    "voice": "vo_adv_1247004_026",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n感覺好像也只能",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說些不著邊際的表面話……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不論喝多少麥酒，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺還是",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一點都開心不起來……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……你看，",
    "voice": "vo_adv_1247004_027",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就像現在。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你年紀這麼輕，",
    "voice": "vo_adv_1247004_028",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們到底是什麼關係，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n他們雖然一直好奇地往這裡瞧……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "卻沒半個人過來問。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………咦？",
    "voice": "vo_adv_1247004_029",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難道說……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是因為我來參加，",
    "voice": "vo_adv_1247004_030",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大家才難以說出真心話嗎……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "破壞氣氛的人，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是我……？　",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……………這樣啊。",
    "voice": "vo_adv_1247004_031",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n原來是這樣啊……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_1247004_032",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說，",
    "voice": "vo_adv_1247004_033",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你啊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我們兩個，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "接下來要不要一起去新年參拜？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等我一下，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我去跟他們說我不去續攤了──",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦……",
    "voice": "vo_adv_1247004_034",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學們",
    "words": "（騷動聲）……",
    "voice": "vo_adv_1247004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦！！",
    "voice": "vo_adv_1247004_036",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說你！？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等一下──！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦咦！？",
    "voice": "vo_adv_1247004_037",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你在說什麼──！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "男朋友！？",
    "voice": "vo_adv_1247004_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "\\n哇～真的！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "深月真厲害～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不不，等等！",
    "voice": "vo_adv_1247004_039",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "年、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "年紀差！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼看都差太多歲了吧！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等一下！",
    "voice": "vo_adv_1247004_040",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你在說什麼──！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "兒子！？",
    "voice": "vo_adv_1247004_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "\\n深月，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "妳什麼時候！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "\\n不過這麼一說……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "臉好像確實有點像……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "臉哪裡像了啊！",
    "voice": "vo_adv_1247004_042",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有嗎！？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等等……",
    "voice": "vo_adv_1247004_043",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你啊！？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "實驗品！？",
    "voice": "vo_adv_1247004_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "\\n雖然沒辦法大力吐槽……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "\\n但好像可以理解……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種事不要理解！",
    "voice": "vo_adv_1247004_045",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討厭……！",
    "voice": "vo_adv_1247004_046",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣下去會更被大家白眼的──",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "這樣啊～",
    "voice": "vo_adv_1247004_047",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "你",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "和深月是那種關係啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "\\n雖然挺意外的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "但感覺",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "一下就接受了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……咦？",
    "voice": "vo_adv_1247004_048",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說不是這樣──",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "我說，",
    "voice": "vo_adv_1247004_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "你啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "\\n既然你們是那種關係，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "那你要為深月……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "\\n為深月的實驗",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學3",
    "words": "加油喔？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦……",
    "voice": "vo_adv_1247004_050",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "嗯嗯！",
    "voice": "vo_adv_1247004_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "實驗一定很辛苦吧……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "我想。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "\\n應該也有令人沮喪的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "事情吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "\\n我們無法理解的事情",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "肯定也很多。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "所以希望在她身邊的你，",
    "voice": "vo_adv_1247004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "能夠",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學2",
    "words": "好好支持她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "欸～也讓我說句話嘛～",
    "voice": "vo_adv_1247004_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "\\n跟你說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "深月啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "從學生時代就一直在說呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "\\n說「想做新藥」、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "「想用藥來拯救世界」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "這類的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_1247004_054",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唔，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "當我們正在戀愛、玩耍、",
    "voice": "vo_adv_1247004_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "享受青春的時候，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "\\n深月為了實現夢想，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "都在聚精會神地努力念書……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學1",
    "words": "然而，",
