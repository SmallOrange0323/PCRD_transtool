    "name": "怜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只要是你找我，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不管是為了什麼事，我一定都會趕到的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你找我有什麼事嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊。",
    "voice": "vo_adv_1003500_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天是我生日呢。",
