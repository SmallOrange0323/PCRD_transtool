  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "聽你一說，我就馬上趕過來了，",
    "voice": "vo_adv_1003500_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是不是讓你等很久了呢？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思突然把我叫出來……？",
