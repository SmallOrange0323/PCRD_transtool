[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "找到了你，",
    "voice": "vo_adv_1044002_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n今天一整天，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你都得陪著妾身才行！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "其、",
    "voice": "vo_adv_1044002_001",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "其實……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在那之後，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身都無法變回真正的姿態……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就妾身來說，",
    "voice": "vo_adv_1044002_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是很想早點取回原本的力量……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但該怎麼做，",
    "voice": "vo_adv_1044002_003",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才能恢復真正的模樣？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那個時候，你不是也在嗎！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若你有注意到什麼苗頭，就快點告訴妾身！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……沒什麼特別的…",
    "voice": "vo_adv_1044002_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是頭痛。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n再這樣下去，妾身拿不回力量……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉、",
    "voice": "vo_adv_1044002_005",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉唷……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就跟你說了，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別把妾身當孩子看。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是的……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔？",
    "voice": "vo_adv_1044002_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "從身體的深處，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有什麼……！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦！？",
    "voice": "vo_adv_1044002_007",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "恢復原本的姿態了！？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然不知道原因，",
    "voice": "vo_adv_1044002_008",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但做得好啊，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧，",
    "voice": "vo_adv_1044002_009",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在妾身取回真實之力的現在，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n動手支配世界――",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "…………",
    "voice": "vo_adv_1044002_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼啊～！？",
    "voice": "vo_adv_1044002_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "上次也好，",
    "voice": "vo_adv_1044002_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次也罷，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼都很快就變回來了！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n說到底，是否有什麼原因……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊！",
    "voice": "vo_adv_1044002_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難道說……！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眷屬啊！",
    "voice": "vo_adv_1044002_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你再摸一次",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的頭！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂，快點摸啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "still",
    "still_id": "104400101"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯、",
    "voice": "vo_adv_1044002_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很好。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就這樣子，繼續摸妾身的頭。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈！",
    "voice": "vo_adv_1044002_016",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n力量湧現出來了！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然沒錯！",
    "voice": "vo_adv_1044002_017",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n雖然不曉得是什麼原因，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但只要被你觸碰，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就能恢復成這個姿態了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如此一來，",
    "voice": "vo_adv_1044002_018",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只要讓你一直摸妾身就好了！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這不是很簡單嗎！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "糟糕！",
    "voice": "vo_adv_1044002_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "又變回來了！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n再、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "再多碰妾身一下！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "抱緊妾身吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "太、",
    "voice": "vo_adv_1044002_020",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "太近了太近了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n臉太近了啦！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為、",
    "voice": "vo_adv_1044002_021",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼從後面抱！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這該",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼說呢……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這樣子還真是有點害羞啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "恢復為妾身真正的姿態了！？",
    "voice": "vo_adv_1044002_022",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然只要有你在，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就能恢復成這身姿態了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只、",
    "voice": "vo_adv_1044002_023",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只不過……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n若像這樣被抱住，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就不能盡情戰鬥了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要是妾身認真起來，",
    "voice": "vo_adv_1044002_024",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你的身體也撐不住……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這也是個困擾的呢。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……？",
    "voice": "vo_adv_1044002_025",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看樣子再找找看其他",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "能取回力量的方法比較好呢。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可是在擔心你的安危哦。",
    "voice": "vo_adv_1044002_026",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n好好感謝妾身吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且……",
    "voice": "vo_adv_1044002_027",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這方法，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對妾身的心臟也不太好……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……你問那句話是什麼意思？",
    "voice": "vo_adv_1044002_028",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這還用得著說嗎。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只要被你碰觸到，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就會心跳加速――",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊，",
    "voice": "vo_adv_1044002_029",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別讓妾身說些奇怪的話！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
