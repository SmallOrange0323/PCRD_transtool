  {
    "type": "dialogue",
    "name": "凱留",
    "words": "了……？",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鼻、",
    "voice": "vo_adv_1391004_065",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鼻血呢？",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如何！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒有……",
    "voice": "vo_adv_1391004_066",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "流！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒流！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒流鼻血！！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵、",
    "voice": "vo_adv_1391004_067",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈……！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n成功了……",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "成功了……！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唔，",
    "voice": "vo_adv_1391004_068",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n因為你認真地執行，",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我也才能認真地越過高牆。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果是與你一起，",
    "voice": "vo_adv_1391004_069",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n或許總有一天能追上陛下。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不，",
    "voice": "vo_adv_1391004_070",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我一定……",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會超越陛下。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然陛下可能並不希望我這麼做，",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但這是",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我能做到的報恩。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "踏出微小",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "卻確實的一步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n霸瞳天星的光輝寄宿在那對眼眸中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人的故事將繼續下去。",
    "voice": null,
    "unit_id": null
  }
]
