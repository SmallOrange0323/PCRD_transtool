  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "作為修行的收尾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n凱留再次挑戰避開{0}攻擊的特訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然之前完全不行……",
    "voice": "vo_adv_1391004_000",
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但這次我一定要成功！",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "使出全力出招吧！",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "集中……",
    "voice": "vo_adv_1391004_001",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看得見……",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n看穿軌道、",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "躲過──",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唔！？",
    "voice": "vo_adv_1391004_002",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這道光、",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是什麼──",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "background",
    "bg_id": "510305"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊啊～",
    "voice": "vo_adv_1391004_003",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好舒服的熱水呢，真那大人！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n果然錢湯最棒了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……嗯，",
    "voice": "vo_adv_1391004_004",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "還不壞。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "雖然本來應該有更適合的地方。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "唉，",
    "voice": "vo_adv_1391004_005",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "好想趕快搬到更寬敞的公寓呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n那棟長屋真的窄到不行，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n縫隙還會鑽進冷風。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "交給我吧，",
    "voice": "vo_adv_1391004_006",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我跟這傢伙",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "會拼命打工的！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那當然！",
    "voice": "vo_adv_1391004_007",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你也是家人啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n為了不讓真那大人感到拘束，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "目標是高層豪宅！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真愛說大話。",
    "voice": "vo_adv_1391004_008",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "既然說出口，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "就要做到喔。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那當然！",
    "voice": "vo_adv_1391004_009",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……嘿嘿。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……啊。",
    "voice": "vo_adv_1391004_010",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這是──",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "夢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是我一直",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "渴望的景象……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "貧窮、",
    "voice": "vo_adv_1391004_011",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "狹窄，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "又沒有浴室。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但那個可以三人排成川字一起睡的房間，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n是比任何豪宅",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "都珍貴的地方……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是這樣的",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "「夢」……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "趕緊走。",
    "voice": "vo_adv_1391004_012",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "再發呆的話，就要丟下妳了──",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "希留耶。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊、",
    "voice": "vo_adv_1391004_013",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "的！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "抱歉，真那大人！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "510356"
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……",
    "voice": "vo_adv_1391004_014",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "今天真冷。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n在到家前，身體就會冷掉。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊，",
    "voice": "vo_adv_1391004_015",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真那大人，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那邊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n有關東煮的攤販。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……",
    "voice": "vo_adv_1391004_016",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真拿妳沒辦法。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n雖然路邊攤不合我的風格，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "但就允許妳取個暖吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "三人分一碗關東煮，",
    "voice": "vo_adv_1391004_017",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n實在是很寒酸……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "哎呀，",
    "voice": "vo_adv_1391004_018",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "居然會說",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "寒酸，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳也稍微學會些詞語了啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……我就收下這塊炸豆腐餅了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊，",
    "voice": "vo_adv_1391004_019",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真那大人",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "要炸豆腐餅嗎，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n眼光果然高。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那",
    "voice": "vo_adv_1391004_020",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我就吃白蘿蔔。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你呢？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "反正應該是",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雞蛋吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……妳可以吃",
    "voice": "vo_adv_1391004_021",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這個炸豆腐餅喔。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦？",
    "voice": "vo_adv_1391004_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不用，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那是屬於真那大人的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "怎麼？",
    "voice": "vo_adv_1391004_023",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "希留耶，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳是說我的炸豆腐餅入不了口嗎？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不、",
    "voice": "vo_adv_1391004_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不是的……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我就心懷感激地……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "收下了──",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好燙！！！！",
    "voice": "vo_adv_1391004_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒、",
    "voice": "vo_adv_1391004_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒辦法！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我是貓舌頭啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n為什麼會這麼燙……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真沒出息，",
    "voice": "vo_adv_1391004_027",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n關東煮當然燙啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什、",
    "voice": "vo_adv_1391004_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這點小事我可以自己來……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但如果你擅自要做……",
    "voice": "vo_adv_1391004_029",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我是不會阻止你啦。",
