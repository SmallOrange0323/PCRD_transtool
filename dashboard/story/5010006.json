    "name": "鏡餅",
    "words": "――嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "嘎——哈哈哈哈！　",
    "voice": "vo_adv_5010006_044",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "怎麼樣！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和帶來的人們也好厲害呢！",
    "voice": "vo_adv_5010006_045",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧——？",
    "voice": "vo_adv_5010006_046",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "其實這些人，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是今天我們幫助過的人們唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確那個拿斧頭的，",
    "voice": "vo_adv_5010006_047",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我有印象。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然得好好珍惜和人之間的緣分呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "――咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "又有願望附身到新的鏡餅上了！",
    "voice": "vo_adv_5010006_048",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "距離新年已經沒多少時間了。",
    "voice": "vo_adv_5010006_049",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過看這樣子，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n除了這傢伙以外似乎也出現其他被附身的物品……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就算是這樣，我們也不會輸！",
    "voice": "vo_adv_5010006_050",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　優衣。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "――咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？　",
    "voice": "vo_adv_5010006_051",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "鏡餅要跑掉了唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣下去會跑出神殿的！",
    "voice": "vo_adv_5010006_052",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要快點阻止它！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": "vo_adv_5010006_053",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣就好！　",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "它……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "它們判斷留在神殿會有危險。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那我們請客人待在神殿附近比較安全呢。",
    "voice": "vo_adv_5010006_054",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我們，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有辦法好好地一邊保護大家一邊戰鬥嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這回事。",
    "voice": "vo_adv_5010006_055",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "接下來要盡全力上囉！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也要",
    "voice": "vo_adv_5010006_056",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "更——加努力！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "大家！　",
    "voice": "vo_adv_5010006_057",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這裡就交給我們！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "神殿裡剩下的都是些小角色，放心吧！",
    "voice": "vo_adv_5010006_058",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "外面的傢伙就麻煩囉！",
