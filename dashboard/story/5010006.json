  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "做得來嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "做得來！　",
    "voice": "vo_adv_5010006_029",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "我想要保護一起來的女朋友！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "別給我做出讓她擔心的事喔？",
    "voice": "vo_adv_5010006_030",
