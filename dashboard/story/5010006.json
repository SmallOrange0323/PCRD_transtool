    "words": "待會見——！",
    "voice": "vo_adv_5010006_060",
    "unit_id": 108711
  },
  {
    "type": "background",
    "bg_id": "500562"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "――喝啊啊啊！",
    "voice": "vo_adv_5010006_061",
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500562"
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "――咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可真硬啊……！　",
    "voice": "vo_adv_5010006_062",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這傢伙是最後一隻嗎……！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "相較剛剛的鏡餅，",
    "voice": "vo_adv_5010006_063",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "硬度可是無法相比呢……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
