  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接近新年前出現了大量的願望。\\n那些東西變成集合體附在鏡餅上面，\\n變成了巨大的魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "竟然會發生這種事……",
    "voice": "vo_adv_5010006_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總之得讓客人們遠離這裡！",
    "voice": "vo_adv_5010006_001",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n從那東西身上感受到不祥的氣息。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……",
    "voice": "vo_adv_5010006_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "它好像在說什麼？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "禿……",
    "voice": "vo_adv_5010006_003",
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "禿頭治不好！",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "\\n養的狗狗沒有回家！",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "\\n媽媽——！　",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "在哪裡呢——！",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "各種思念混雜在一起……",
    "voice": "vo_adv_5010006_004",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像會變成難纏的對手。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "――咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊！",
    "voice": "vo_adv_5010006_005",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "危險啊！！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然開始作亂了！",
    "voice": "vo_adv_5010006_006",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！　",
    "voice": "vo_adv_5010006_007",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你沒事太好了！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們也沒事！",
    "voice": "vo_adv_5010006_008",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過聚集這麼多願望，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "變成這樣……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "希望能由你來指揮。",
    "voice": "vo_adv_5010006_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "麻煩你下指示了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！　",
    "voice": "vo_adv_5010006_010",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "收到。",
    "voice": "vo_adv_5010006_011",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你用能力支援我。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "OK！　",
    "voice": "vo_adv_5010006_012",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我很快就回來！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你們的對手可是我！",
    "voice": "vo_adv_5010006_013",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n接下來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論是誰，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都不許通過！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "鏡餅",
    "words": "――咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10812
  },
  {
    "type": "background",
    "bg_id": "500552"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哼……",
    "voice": "vo_adv_5010006_014",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不要以為用這種東西可以打倒我們唷！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "放馬過來！　",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這邊！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大家！　",
    "voice": "vo_adv_5010006_015",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "盡可能地從神殿裡面出來！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n請先讓女性和小孩們先過！　",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "拜託了！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不好意思！　",
    "voice": "vo_adv_5010006_016",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有厲害的人在的話，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n能不能跟我們一起戰鬥呢！？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……",
    "voice": "vo_adv_5010006_017",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "……",
    "voice": "vo_adv_5010006_018",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔，",
    "voice": "vo_adv_5010006_019",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有沒有人呢……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "喂～！　",
    "voice": "vo_adv_5010006_020",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我來幫忙了！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～！　",
    "voice": "vo_adv_5010006_021",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是遺失御守的人！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "嘿！　",
    "voice": "vo_adv_5010006_022",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "作為一起幫忙找御守",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "的謝禮，我要戰鬥！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "我也來幫忙囉！　",
    "voice": "vo_adv_5010006_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "那個藍色頭髮的魔族大姊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n是妳的夥伴吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是怜！　",
    "voice": "vo_adv_5010006_024",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是的！　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是我們的夥伴！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "那個大姊剛才幫了我。",
    "voice": "vo_adv_5010006_025",
