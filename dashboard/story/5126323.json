    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像已經放不出我們的闇影了！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這表示牠的力量減弱很多了嗎！？",
    "voice": null,
