[
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，{0}和可可蘿離開蘭德索爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到遠方邊境地帶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_1376002_000",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常感謝您",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "陪在下走這一趟。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將父親大人授予的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「嚮導幼君」的力量",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "進一步提升……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是在下",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "此次的目的。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由於本質上",
    "voice": "vo_adv_1376002_001",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是和精靈魔法等類不同的力量，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "亦不曾見過父親大人全力戰鬥。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要確認力量極限，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最好的辦法就是反覆嘗試了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "反覆使用",
    "voice": "vo_adv_1376002_002",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確認當下的感覺，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "直到熟練。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下認為這是現在",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "提升能力的唯一途徑。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝您的關心。",
    "voice": "vo_adv_1376002_003",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了成為主公大人的助力，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下必定",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會練習到運用自如。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這座森林",
    "voice": "vo_adv_1376002_004",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "距離街道有一段距離，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常適合。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "否則一般人目睹訓練的光景，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許會被嚇到。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這就立刻開始吧。",
    "voice": "vo_adv_1376002_005",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "行使「嚮導老君」之女──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「嚮導幼君」的權能，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n嘗試「破極創天」的力量吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "父親大人",
    "voice": "vo_adv_1376002_006",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在七冠等人之中",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "屬於核心存在，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "此為運用其高階權限，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n將領域與法則",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及整個世界完全破壞，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再重新構築",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的一種……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正所謂禁忌的力量。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "據說過去還是管理者時的厄莉絲，",
    "voice": "vo_adv_1376002_007",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會在滿足條件的時候，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了輪迴而將整個世界進行重置。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下認為原理上",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該是相同性質的。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「翻桌子」……",
    "voice": "vo_adv_1376002_008",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不愧是主公大人，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "形容得很巧妙。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下曾聽說創造進行得不順利時，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有時父親大人採取的最後手段，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就是推翻一切。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這項權能，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許就是來源於此。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然，",
    "voice": "vo_adv_1376002_009",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將整個世界「翻桌子」這種事，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只有身為長老的父親大人能辦到。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下雖然成長了，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能辦到的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "規模",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想必還是有限……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1376002_010",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "前提是能夠將這項權能",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "運用自如才行。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟",
    "voice": "vo_adv_1376002_011",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是足以被視為禁忌的力量。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人和我方的幾位",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "千萬不能夠",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被誤捲入其中。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n必須反覆特訓，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "直到能放心安全運用才行。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接下來，",
    "voice": "vo_adv_1376002_012",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以「嚮導幼君」之名，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n接引偉大的意志於此──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「破極創天」！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "501800"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──看起來如何。",
    "voice": "vo_adv_1376002_013",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n依據在下的命令，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "眼前的領域已被破壞",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並重新構築過了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟、",
    "voice": "vo_adv_1376002_014",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來是重新構築的過程發生了問題。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這種狀態放著不管",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會出大事……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下立刻修正。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "501820"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_1376002_015",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這次變成一片黑暗的空間……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "必須更明確",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "去想像完成的樣子才行呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不是草原也不是山，",
    "voice": "vo_adv_1376002_016",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而是原本自然的景色……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1376002_017",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總、",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總算是",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "恢復成原本的森林了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓您見到這麼難看的場面，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是非常抱歉……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是父親大人，",
    "voice": "vo_adv_1376002_018",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想必能將權能運用得更加自如。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而現在的在下還力有未逮，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來要需要多加鍛鍊。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "啊、",
    "voice": "vo_adv_1376002_019",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "啊哇哇哇哇……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n剛、",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "剛剛的魔法……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_1376002_020",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難道說，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是附近村裡的居民嗎。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "本來以為選了遠離人煙的地方，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是被看見了呢……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嚇到您",
    "voice": "vo_adv_1376002_021",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是不好意思。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛剛那個",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "算是",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一點",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔術。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請放心──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "小、",
    "voice": "vo_adv_1376002_022",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "小姑娘……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不對，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "您、",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "您肯定是神明大人！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "拜託，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "請一定要來我們村裡好嗎！？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下並不是神明大人……",
    "voice": "vo_adv_1376002_023",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，為什麼會希望",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人過去呢？",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "拜託了……",
    "voice": "vo_adv_1376002_024",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "這關係到村子的存亡。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "我們已經只能求神拜佛了……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說得也是呢。",
    "voice": "vo_adv_1376002_025",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n似乎是真的有困擾，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那就不能裝作沒看見。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請帶路",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到您的村莊吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，可可蘿和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在村民的嚮導下造訪了邊境的村子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "大家，",
    "voice": "vo_adv_1376002_026",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "神明大人來啦～！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n幫忙拯救我們村子的大人",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "終於出現啦～！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "真的嗎！？",
    "voice": "vo_adv_1376002_027",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "原來求神是真的能管用啊……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看起來狀況十分嚴重呢。",
    "voice": "vo_adv_1376002_028",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過沒被深究剛剛的力量，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對在下而言倒是好事。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總之，",
    "voice": "vo_adv_1376002_029",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在就先順著大家的話吧……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這種無視主公大人，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只把在下當神明的狀況，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不是很妥當呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位，",
    "voice": "vo_adv_1376002_030",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請聽在下一言。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下並非神明大人。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "站在這邊的這位主公大人",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才是等同於神明的存在，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而在下，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "則是隨從。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "竟然，",
    "voice": "vo_adv_1376002_031",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "原來如此！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "神明大人以及……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "這位",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "可以稱作天使大人嗎。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "請聽聽我們的狀況吧！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_1376002_032",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不好意思……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請稍微陪在下演一會戲。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n畢竟主公大人非常重要這件事，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也算是實話……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "我們村子從古早以前，",
    "voice": "vo_adv_1376002_033",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n就是在附近的森林裡",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "靠狩獵和採集過生活。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "但是最近",
    "voice": "vo_adv_1376002_034",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "森林的狀況不太對勁。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "大量沒見過的魔物住進森林裡，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "我們連靠近都沒辦法靠近。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "要是這種狀態持續下去",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "我們就要餓死了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1376002_035",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大概是因為什麼原因導致魔物狂暴化，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或是來自其他地區的魔物，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才引起了這樣的異常狀態。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但如果對手是魔物，",
    "voice": "vo_adv_1376002_036",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "透過公會管理協會，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n提出討伐委託",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該是最確實的解決方式……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "不，",
    "voice": "vo_adv_1376002_037",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "那不是普通的魔物。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n我曾經試過一次",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "找自認實力好的村民",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "一起去森林。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "覺得魔物什麼的動手擊退就行了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "然而",
    "voice": "vo_adv_1376002_038",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "結果",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "連打都沒打就跑回來了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "光是看到，身體就在顫抖……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "那個",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
