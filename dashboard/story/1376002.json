    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "那麼，",
    "voice": "vo_adv_1376002_067",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "天使可可蘿小姐……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n您的大名將會永遠永遠，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n在我們的村子裡",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "歌頌流傳下去！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那、",
    "voice": "vo_adv_1376002_068",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個稱呼……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是在下的說明有誤導致的，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以請不要這麼做……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對村民的稱讚，可可蘿感到不知所措的同時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n臉上的神情也浮現了一抹自豪……",
