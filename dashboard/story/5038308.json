[
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "切切嚕～～～～～～～～！！",
    "voice": "vo_adv_5038308_000",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": "vo_adv_5038308_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n好朋友X這傢伙，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看來又成功自我進化了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "跟它懷舊玩具般的外表相反，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唯有內部功能可說是最先進的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "吵死了閉嘴，",
    "voice": "vo_adv_5038308_002",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "空有無用知識的戀母情結小矮子。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n趕快放馬過來切嚕。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哼、",
    "voice": "vo_adv_5038308_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看來似乎只有毒舌功能沒有升級呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我的冷靜沉著可是眾所皆知的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "才不會被你那點無聊的挑釁給刺激到——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "吵死了！　",
    "voice": "vo_adv_5038308_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "吵死了，笨～蛋！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不准欺負我們的優妮學姐～廢鐵！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不准說什麼空有無用知識戀母情結小矮子這種話～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她被這種",
    "voice": "vo_adv_5038308_005",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無聊的挑釁刺激到了耶。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而且，",
    "voice": "vo_adv_5038308_006",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "有必要再重複一次",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個毒舌的內容嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮學姐可不僅僅是個空有無用知識的戀母情結小矮子呢！",
    "voice": "vo_adv_5038308_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n她還是個能夠因為被小小甜心們當成「迷路的8歲小優妮」收留，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n索性就直接盡全力陪她們玩扮家家酒的瘋狂18歲少女喔！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "琪愛兒，",
    "voice": "vo_adv_5038308_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳完全沒幫上忙。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳的眼神",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "變得和保育類的蘭德索爾藏狐一樣了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳先把嘴巴閉上，",
    "voice": "vo_adv_5038308_009",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然後把妳那個粗糙的夥伴意識",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "和對上位者的敬意放在天秤的兩端比一下。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳給我閉嘴，笨蛋。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊～！　",
    "voice": "vo_adv_5038308_010",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小優妮，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "竟然罵琪愛兒笨蛋！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哼，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "罵人家笨蛋的人才是笨蛋～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什……",
    "voice": "vo_adv_5038308_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果妳要把",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在本校入學考試中以榜首合格的我定義為笨蛋的話，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n那麼在我以下的妳們全都是大笨蛋了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "笨～蛋！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哼～！",
    "voice": "vo_adv_5038308_012",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n現在又沒有人在講考試的事情，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "笨蛋～笨蛋～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～真是的！",
    "voice": "vo_adv_5038308_013",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "笨蛋跟笨蛋不要再吵那笨吵架了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮＆琪愛兒",
    "words": "不要叫人笨蛋啦，",
    "voice": "vo_adv_5038308_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮＆琪愛兒",
    "words": "笨蛋～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？\\n妳們是怎樣，要打架嗎兩個笨蛋。",
    "voice": "vo_adv_5038308_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "吵死了，笨蛋！",
    "voice": "vo_adv_5038308_016",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳說什麼，笨蛋！",
    "voice": "vo_adv_5038308_017",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我宰了妳喔，笨蛋！",
    "voice": "vo_adv_5038308_018",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "好了啦，快點上啊，",
    "voice": "vo_adv_5038308_019",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "三笨蛋。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "三笨蛋",
    "words": "三笨蛋！？",
    "voice": "vo_adv_5038308_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_5038308_021",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "吶。它在說些什麼啊，那個傢伙。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "竟然對聖德蕾莎的三賢者說這種話，真是意義不明。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯。",
    "voice": "vo_adv_5038308_022",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我會全力支援妳，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳就盡情地大鬧一場吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n聖德蕾莎的三賢者，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是啊！",
    "voice": "vo_adv_5038308_023",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n聖德蕾莎的三賢者，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "三賢者",
    "words": "唔喔喔喔呀啊啊啊啊啊！！",
    "voice": "vo_adv_5038308_024",
    "unit_id": 110811
  }
]
