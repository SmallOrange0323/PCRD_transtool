[
  {
    "type": "background",
    "bg_id": "501800"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──那是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過去確實存在過的一段時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n你的意識慢慢地甦醒過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "與「mimi」的認證，",
    "voice": "vo_adv_5201001_000",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "已確認。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，",
    "voice": "vo_adv_5201001_001",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "準備完畢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n隨時可以開始了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……嗯？",
    "voice": "vo_adv_5201001_002",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你怎麼了？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "為什麼這樣直直盯著我的臉……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n該不會是黑眼圈冒出來了吧？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "討厭啦～",
    "voice": "vo_adv_5201001_003",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "開發得太起勁，就忍不住少睡了嘛。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n看來又要被克莉絲罵了，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "像是「妳給我多注意自己的形象」",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "之類的。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過",
    "voice": "vo_adv_5201001_004",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "她這樣說，也只是想叫我去買",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n跟她有利益關係的化妝品就是了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哎呀，",
    "voice": "vo_adv_5201001_005",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不可以動喔。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很抱歉讓你這麼不自由，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但你的身體現在連接著很多東西。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "因為我們所開發的遊戲，",
    "voice": "vo_adv_5201001_006",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n是跟至今的技術體系截然不同的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "完全沉浸式的VR遊戲，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "所以必須連線監控的資料非常多。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那麼～",
    "voice": "vo_adv_5201001_007",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "差不多該開始了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "身體放鬆～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啟動的關鍵字……",
    "voice": "vo_adv_5201001_008",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還沒正式決定呢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "總之，你只要說",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "「登入」",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就可以了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "──嗨。",
    "voice": "vo_adv_5201001_009",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "歡迎你",
    "voice": "vo_adv_5201001_010",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來到新世界。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然我這樣耍帥，但其實東西全都還在開發中，",
    "voice": "vo_adv_5201001_011",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n連場景都還是半成品呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n如果你能假裝沒看到一堆不堪入目的地方，那就太好了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "身體狀況如何？",
    "voice": "vo_adv_5201001_012",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n能隨心所欲地動嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喔，",
    "voice": "vo_adv_5201001_013",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來沒問題。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊、這樣啊，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，",
    "voice": "vo_adv_5201001_014",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很不好意思，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為你的身體還處於尚未建模的狀態，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以模樣就像是一個毫無表情的人偶……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這點",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "之後會改善的。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我下次會跟似似花說，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然她大概會以忙碌為由而拒絕。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈，",
    "voice": "vo_adv_5201001_015",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "謝謝讚美。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……這應該不是反諷吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀～",
    "voice": "vo_adv_5201001_016",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個身體",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是測試用模型啦，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在製作時好像加上太多個人喜好了呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個應該不會正式實裝，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是現在才看得到的稀有造型喔。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我最近跟克莉絲玩的遊戲是",
    "voice": "vo_adv_5201001_017",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "FPS類型，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以下意識就做成跟那邊相似的風格了～",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然與世界觀不合，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但也因此有種",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "開發中的特殊風味，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_5201001_018",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "既然已經確認完你的動作了，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n事不宜遲，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就請你來協助我的開發工作吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我目前負責的是物件的相關作業。",
    "voice": "vo_adv_5201001_019",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那邊有個岩石吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的工作就是",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "設計、",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "配置那一類的物體。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就像這樣──",
    "voice": "vo_adv_5201001_020",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "生成物件。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接著是",
    "voice": "vo_adv_5201001_021",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於我想要你幫忙的事情。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n……不過你今天",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "才第一次參與開發嘛，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以首先",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就讓身體習慣潛入遊戲時的感覺吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你就隨意在這附近散散步，",
    "voice": "vo_adv_5201001_022",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "試著和這個世界接觸吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "有什麼感覺？",
    "voice": "vo_adv_5201001_023",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很柔軟……？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n哦……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "明明只是暫時將草原紋理給貼上而已，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你竟然會有這種感覺啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或許是你感受性很強的證據。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "目前",
    "voice": "vo_adv_5201001_024",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "能力數值方面還在調整中，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以應該沒辦法忽然就能一拳把岩石擊碎。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然教授可以一副若無其事地辦到就是了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我懂我懂。",
    "voice": "vo_adv_5201001_025",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一看到樹，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就讓人想踢踢看呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但很遺憾地，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不管是會掉落的果實，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還是會發動攻擊的蟲子，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n現在都還不存在呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接下來嘛，",
    "voice": "vo_adv_5201001_026",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你再繼續進行一定程度的身體活動，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n當出現疲勞之類的感覺時，就立刻告訴我。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "聽好囉，",
    "voice": "vo_adv_5201001_027",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n千萬不能遺漏任何一項",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "由自己身體所發出的訊息。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟現在的你",
    "voice": "vo_adv_5201001_028",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正在試用的連接方式跟我們不太一樣。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n將靈魂半數位化……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我就不說明這部分的細節了，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總之尚不清楚這對現實中的身體是否會造成什麼影響。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原本應該在進行更多技術檢證後，才進入實驗階段的……",
    "voice": "vo_adv_5201001_029",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但其他的七冠",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "都堅信天才不會失敗。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n他們和「慎重」",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "實在是搭不上邊啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……啊，抱歉，",
    "voice": "vo_adv_5201001_030",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我不是在說這項研究很危險。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟我也同樣以天才自居嘛。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我可以斷言，你絕對不會遭遇到危險。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話說回來，",
    "voice": "vo_adv_5201001_031",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n在我說話的時候，你一直轉頭看來看去呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "該不會是姐姐我說的話",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "太無聊了？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……不過，",
    "voice": "vo_adv_5201001_032",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個世界會如此吸引人也是當然的吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看到你這樣的反應，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我身為開發者也很高興呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯……",
    "voice": "vo_adv_5201001_033",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "暫停一下吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然你應該還在興頭上，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但先登出好了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你說你什麼都還沒做？",
    "voice": "vo_adv_5201001_034",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "別在意啦，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "今天能確認登入順利就足夠了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我個人是希望",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "盡可能",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "慎重地前進。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_5201001_035",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就從我這裡讓你登出吧～",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……謹慎起見，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來也該實裝強制登出系統呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要謹慎再謹慎",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "才行呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，",
    "voice": "vo_adv_5201001_036",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "辛苦你了～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n抱歉有點手忙腳亂，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "首先要請你接受醫療診斷喔。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "呼吸、",
    "voice": "vo_adv_5201001_037",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "脈搏……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "正常。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n和登入前的數值相同。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在遊戲中出現的身體狀況變化，不會反映在現實的身體上。",
    "voice": "vo_adv_5201001_038",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……這個連接系統",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真是不簡單呢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "只不過……",
    "voice": "vo_adv_5201001_039",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這還只是活動身體的程度。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "若是更深入的體驗，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "例如",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "遭受到足以致命的傷害……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……會發生什麼事？",
    "voice": "vo_adv_5201001_040",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊，",
    "voice": "vo_adv_5201001_041",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "抱歉抱歉，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n竟然把你晾在一旁了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "總而言之，",
    "voice": "vo_adv_5201001_042",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你的身體沒有受到影響。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "「頭昏眼花的感覺」",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "只存在於那個世界。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "之後也會像這樣，",
    "voice": "vo_adv_5201001_043",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "縝密且反覆地",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n在遊戲中活動並接受醫療診斷。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "要是玩了遊戲卻害身體被搞壞，就本末倒置了嘛。",
    "voice": "vo_adv_5201001_044",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "尤其這個遊戲的賣點就是逼真，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n會對現實身體造成的影響，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就算只有0.1％也不能存在。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "總之",
    "voice": "vo_adv_5201001_045",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大概就是這樣，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "今天先到此為止吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n有沒有什麼問題想問？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但我不太擅長說明，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "所以恐怕沒辦法回答得很清楚就是了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……這個問題還真是出其不意呢。",
    "voice": "vo_adv_5201001_046",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你該不會是",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "對我很感興趣？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯～",
    "voice": "vo_adv_5201001_047",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "既然其他的七冠現在都不在位子上，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n稍微閒聊一下也沒關係吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "雖然沒什麼好隱瞞的，",
    "voice": "vo_adv_5201001_048",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "只是講出來很難為情。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我啊……",
    "voice": "vo_adv_5201001_049",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "以前非常討厭人類呢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "現在回想起來，",
    "voice": "vo_adv_5201001_050",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我的思考方式實在是極度傲慢且自我意識過剩，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不久前的我，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "完全看不到自己以外的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "任何事物的價值。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "一方面是出於對醫師父親的憧憬，",
    "voice": "vo_adv_5201001_051",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我也學習過醫術……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但我",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "卻視為理所當然，沒有好好運用這項專長。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我",
    "voice": "vo_adv_5201001_052",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "自以為很了解",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "人類。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我只注視著惡意，而對善意視而不見，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n並打算棄這個世界於不顧呢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這是我走遍地球上的各種地方，",
    "voice": "vo_adv_5201001_053",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n在自己的雙眼見證下所得出的最終答案。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n實在是個很丟人的故事啊。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "然而，",
    "voice": "vo_adv_5201001_054",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我那年少輕狂到了極致的價值觀，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n在與某位少年相遇後，便被徹底粉碎。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊，",
    "voice": "vo_adv_5201001_055",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我不是要講什麼卿卿我我的事喔？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我想對方大概也不記得我了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過，",
    "voice": "vo_adv_5201001_056",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "可以說，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "他改變了我的價值觀。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "誤用自身的天賦異稟，總是只看著事物陰暗面的我，",
    "voice": "vo_adv_5201001_057",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n彷彿正面撞上了一顆太陽──",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大概是這種感覺吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "多虧如此，我……",
    "voice": "vo_adv_5201001_058",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "改變了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我因此得以改變了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這對我而言",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "正是最大的救贖。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我想為了他人而努力、",
    "voice": "vo_adv_5201001_059",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我想從自己能做的事開始做起。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "首先，我想帶給人笑容。",
    "voice": "vo_adv_5201001_060",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n就像那個少年一樣，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "讓他人",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "展露笑容。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "於是我決定創造出",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很多人都能歡笑、享受快樂的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "某樣東西。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在那之後，",
    "voice": "vo_adv_5201001_061",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "總之",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我接受了長老之前就一直向我發出的邀約，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n然後直到今日……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "情況就是這樣。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯，",
    "voice": "vo_adv_5201001_062",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "太好了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我能說",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我喜歡現在的自己。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "只要完成了現在正在製作的遊戲，",
    "voice": "vo_adv_5201001_063",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n應該就能實現我的願望。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "所以……",
    "voice": "vo_adv_5201001_064",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "希望你也能",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "助我一臂之力。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "雖然這對你而言可能是件苦差事或麻煩事，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但你的力量是不可或缺的。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "──為了完成",
    "voice": "vo_adv_5201001_065",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "能拯救人心的遊戲。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七冠──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "迷宮女王。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n模索路晶道出了埋藏於她心中的意志。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了將她過去所見到的光芒",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "也分享給他人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "──交出妳的工作報告。",
    "voice": "vo_adv_5201001_066",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "咦？",
    "voice": "vo_adv_5201001_067",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真稀奇耶，真那，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你竟然會親自過來找我，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n明明平常都是隨便找個員工幫你辦事。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳睡傻了嗎？",
    "voice": "vo_adv_5201001_068",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "實驗品的相關資料是最高機密，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "怎麼可能跟隨便找來的傢伙共享資料。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你說的是。",
    "voice": "vo_adv_5201001_069",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，就是這個──",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "最新的同步資料。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "still",
    "still_id": "520100101"
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201001_070",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "上面寫的",
    "voice": "vo_adv_5201001_071",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是事實吧？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "難道我會把謊話寫上去嗎？",
    "voice": "vo_adv_5201001_072",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是啊。",
    "voice": "vo_adv_5201001_073",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你未免太不信任我了吧！？",
    "voice": "vo_adv_5201001_074",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n應該說我把謊話寫上去又有什麼意義啊。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳的行動本就毫無道理吧。",
    "voice": "vo_adv_5201001_075",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n正因為無法被理解，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "所以妳才是迷宮女王。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……不過，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這份資料看來不假。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "那孩子和角色的同步率真是太驚人了。",
    "voice": "vo_adv_5201001_076",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n光靠「mimi」的潛入功能",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是不可能得出這種數值的。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很厲害吧，",
    "voice": "vo_adv_5201001_077",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "甚至連物件的質感都能感受到喔。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那孩子能說出我們所無法感受的部分，真的是幫了大忙。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "原來如此……",
    "voice": "vo_adv_5201001_078",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真有意思呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n關於現實中的身體所受到的影響，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "特別是致死程度的痛楚，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n要是能讓那孩子體會看看，真不知道會怎麼樣呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真那……",
    "voice": "vo_adv_5201001_079",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你負責的事務不包括這個吧，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n這是我",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "和長老的管轄範圍。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n還有我們做研究就是為了不讓人承受那種感覺。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "哎呀，",
    "voice": "vo_adv_5201001_080",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n那就讓我來幫忙吧？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n例如照顧實驗鼠之類的，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "交給我來做也不錯吧？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你看起來心情很好嘛，真那。",
    "voice": "vo_adv_5201001_081",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n和我聊天有那麼有趣嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "既然如此，要不要開開心心一起吃個午餐？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我請客喔？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……要跟他人同桌用餐，我實在敬謝不敏。",
    "voice": "vo_adv_5201001_082",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那我們就聊到這裡。",
    "voice": "vo_adv_5201001_083",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n反正我該給的東西已經給了，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你快走吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶、真那",
    "words": "「……真是個麻煩的傢伙。」\\n「……真是個狂妄的人。」",
    "voice": "vo_adv_5201001_084",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
