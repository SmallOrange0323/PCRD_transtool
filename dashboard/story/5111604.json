[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "閒得發慌的諾維姆與尾狗刀，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n向偶遇的大吾搭話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "欸欸，",
    "voice": "vo_adv_5111604_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "大鼓我問你，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你為什麼那麼喜歡打架？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "因為我看比我強的人不順眼……",
    "voice": "vo_adv_5111604_001",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喂，等一下，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "大鼓是誰啊？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你因為這樣就找人打架嗎？",
    "voice": "vo_adv_5111604_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "打鼓真是單純啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我單純哪裡礙到你了……",
    "voice": "vo_adv_5111604_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喂，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "慢著！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "打鼓是在叫誰啊！？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唉～",
    "voice": "vo_adv_5111604_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "打噗就是單純這點好啊……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n尾狗刀，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你也多學學人家啊。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦～",
    "voice": "vo_adv_5111604_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我應該不太行吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我沒辦法像打噗那樣不思考就行動。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你們從剛剛就在亂叫些什麼！",
    "voice": "vo_adv_5111604_006",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n我是大吾！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啊？",
    "voice": "vo_adv_5111604_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "等你把很強的人都打倒之後，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "阿噗你要做什麼？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n就不再戰鬥了嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不覺得這樣很空虛嗎？",
    "voice": "vo_adv_5111604_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "小噗，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "人生不是只有戰鬥喔。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你～",
    "voice": "vo_adv_5111604_009",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "們～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "兩～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "個～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n肯定是故意的吧！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n你們夠了喔！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啊哈哈，",
    "voice": "vo_adv_5111604_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你發現啦？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉呀～",
    "voice": "vo_adv_5111604_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們只是想試試，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你什麼時候會注意到。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "從一開始就發現了啦！",
    "voice": "vo_adv_5111604_012",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你們該不會",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是專程來找碴的吧？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "別生氣嘛。",
    "voice": "vo_adv_5111604_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n得阿吾，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你這樣太激動了喔。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我不叫得阿吾！",
    "voice": "vo_adv_5111604_014",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n你們膽子不小嘛……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "既然想打架那就來啊！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "冷靜冷靜，",
    "voice": "vo_adv_5111604_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這就像一種訓練。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "訓練你保持平常心，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "加油，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "太吾。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我不叫太吾！",
    "voice": "vo_adv_5111604_016",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n我受不了了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你們皮給我繃緊！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "容易被挑釁",
    "voice": "vo_adv_5111604_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就是你的弱點。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這麼愛生氣，",
    "voice": "vo_adv_5111604_018",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "很容易正中對手下懷喔？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n大吾。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "閉嘴──！",
    "voice": "vo_adv_5111604_019",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我不是大吾！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "……啊？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "他說他不叫大吾耶。",
    "voice": "vo_adv_5111604_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "該不會",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "叫大骨吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你看，",
    "voice": "vo_adv_5111604_021",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "馬上就中招了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以才叫你要冷靜一點……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "嘎啊啊啊啊啊啊啊！",
    "voice": "vo_adv_5111604_022",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哇！",
    "voice": "vo_adv_5111604_023",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "發飆了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "他超級火大的耶！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "快跑快跑～！",
    "voice": "vo_adv_5111604_024",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆與尾狗刀笑著逃離了現場。",
    "voice": null,
    "unit_id": null
  }
]
