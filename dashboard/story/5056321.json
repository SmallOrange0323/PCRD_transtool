  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不愧是海中王者，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "果然風範十足……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一直稱霸著",
