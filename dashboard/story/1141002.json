  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "不要緊喔。",
    "voice": "vo_adv_1141002_003",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n不如說穿成這樣",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "更適合執行任務吧！",
