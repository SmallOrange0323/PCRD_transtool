    "words": "比起那個，",
    "voice": "vo_adv_1141002_061",
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "告訴我們妳在哪裡拿到糖果的啦！",
    "voice": null,
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們也想要糖果！",
    "voice": "vo_adv_1141002_062",
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是那邊的街道……",
    "voice": "vo_adv_1141002_063",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n走掉了……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "剛剛那樣的感覺還不錯吧？",
    "voice": "vo_adv_1141002_064",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就照這樣繼續執行更多任務吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你們在這裡啊！",
    "voice": "vo_adv_1141002_065",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是、",
    "voice": "vo_adv_1141002_066",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是的！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對對、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對不起！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這些糖果是那個、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "為了要了解小孩子的心情……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們收到消息，",
    "voice": "vo_adv_1141002_067",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "西地區有魔物入侵。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n現在正在疏散民眾避難，快來幫忙。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "魔物！？",
    "voice": "vo_adv_1141002_068",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那不是糟了嗎！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我立刻去通知大家……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "在人潮這麼洶湧的地方",
    "voice": "vo_adv_1141002_069",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "引起恐慌會非常危險，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n要盡量穩當地",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "引導民眾避難。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "雖然妳應該不怕魔物，",
    "voice": "vo_adv_1141002_070",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "但年紀更小的孩子，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n有可能會因為恐懼而無法動彈。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n希望妳盡可能不要讓他們察覺，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "引導他們疏散。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不要讓小孩子察覺……",
    "voice": "vo_adv_1141002_071",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗎？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我試試看！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "就算遇到魔物，",
    "voice": "vo_adv_1141002_072",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "也不得單打獨鬥。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n一定要逃離那裡然後等待支援，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "明白嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我、",
    "voice": "vo_adv_1141002_073",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總、",
    "voice": "vo_adv_1141002_074",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總之先跟剛剛那些人……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該怎麼說才算是穩當啊？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不對，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在可不是思考的時候！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總之",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "先去找他們說話吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "魔物？",
    "voice": "vo_adv_1141002_075",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "每年都會有小朋友說這種惡作劇的話呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "哎呀？",
    "voice": "vo_adv_1141002_076",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "是還想要糖果嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "不過這種話只能在萬聖節這一天說喔？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔唔……",
    "voice": "vo_adv_1141002_077",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "被當成萬聖節的惡作劇了啦……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n該怎麼做他們才會明白呢？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "腳踏實地的努力會獲得成果呢……",
    "voice": "vo_adv_1141002_078",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就和特訓一樣！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "說的也是呢……",
    "voice": "vo_adv_1141002_079",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n英雄是不能放棄的！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？",
    "voice": "vo_adv_1141002_080",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有沒有一個小男生跟一個小女生",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "來過這裡？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "啊，",
    "voice": "vo_adv_1141002_081",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "有來過喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "還說這裡是祕密寶地很開心呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n是你們告訴他們的嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那些孩子去哪裡了？",
    "voice": "vo_adv_1141002_082",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "他們說想要找更多祕密寶地，就往西地區去了喔。",
    "voice": "vo_adv_1141002_083",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "雖然我們有跟他們說那邊沒什麼人煙，去了也沒用呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳說西地區……",
    "voice": "vo_adv_1141002_084",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "糟了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n要去把他們帶回來！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "喔？",
    "voice": "vo_adv_1141002_085",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就如我剛剛說的一樣！",
    "voice": "vo_adv_1141002_086",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n魔物入侵西地區了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n大叔你們也",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不要驚慌，快回到家裡避難吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "咦？",
    "voice": "vo_adv_1141002_087",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "妳說的是真的嗎……？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "明白了吧！",
    "voice": "vo_adv_1141002_088",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "拜託你們了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了帶回小孩子們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茉莉與{0}奔向了西地區。",
    "voice": null,
    "unit_id": null
  }
]
