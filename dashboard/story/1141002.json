  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我的任務就是！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「巡邏並叮嚀那些來參加萬聖節的孩子們」！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為有些孩子們",
