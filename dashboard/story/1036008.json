  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還真巧呢。",
    "voice": "vo_adv_1036008_000",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "兩人竟然為了準備晚餐而巧遇。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這也難得，那到蔬菜店的路上就一起吧。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "馬鈴薯、洋蔥、紅蘿蔔……？",
    "voice": "vo_adv_1036008_001",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "紅、紅蘿蔔……唉……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇呀！這、這道光？和那時候一樣……？",
    "voice": "vo_adv_1036008_002",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀────！？",
    "voice": "vo_adv_1036008_003",
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "510040"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1036008_004",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}也是來買東西的嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n還真巧呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我是被媽媽拜託來買一些晚餐要用的食材。",
    "voice": "vo_adv_1036008_005",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "今天晚餐是吃咖哩喔。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……你問明明是煮咖哩，怎麼不買紅蘿蔔嗎？",
    "voice": "vo_adv_1036008_006",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說、說得也是呢。那是因為，今天紅蘿蔔都賣光了……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……這裡不是還有一大堆？",
    "voice": "vo_adv_1036008_007",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真、真的耶～竟、竟然沒有注意到呢～",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "明明就裝沒看到了，竟然還……",
    "voice": "vo_adv_1036008_008",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊！為什麼你連青椒都丟到了人家的籃子裡啊！",
    "voice": "vo_adv_1036008_009",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "別鬧了好嗎！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你這人真是……",
    "voice": "vo_adv_1036008_010",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼，我就先走一步了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n{0}，再會。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "still",
    "still_id": "103600801"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊？咦……？奇怪了……",
    "voice": "vo_adv_1036008_011",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "找、找不到錢包！？在、在哪裡給弄丟了嗎！？",
    "voice": "vo_adv_1036008_012",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "這位客人，您沒事吧？",
    "voice": "vo_adv_1036008_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n請別著急，再慢慢找找看。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "對、對不起！",
    "voice": "vo_adv_1036008_014",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇哇……後面已經排了那麼長……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n如果沒買成，回家了還會被媽媽給兇一頓……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不、不行！不能拜託你這種事情！",
    "voice": "vo_adv_1036008_015",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我會先把這些東西放回去，然後再回家一趟去拿錢的！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……你說那樣就太大費周章了？",
    "voice": "vo_adv_1036008_016",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n可、可是……再怎麼說這也……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那、那怎麼可以！沒關係的！",
    "voice": "vo_adv_1036008_017",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我自己去找就行了！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇呀！你、你在摸人家的什麼地方呀！！",
    "voice": "vo_adv_1036008_018",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "果、果然……你是個變態對吧！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n奇怪變態的可疑分子！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510040"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……咦？錢包在裙子的口袋裡？",
    "voice": "vo_adv_1036008_019",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真的很抱歉。",
    "voice": "vo_adv_1036008_020",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "多虧了你，真的是幫了大忙。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n明明就是擔心會搞丟了錢包，所以才放到口袋裡的……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真丟臉……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "話說回來，",
    "voice": "vo_adv_1036008_021",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}出來買的，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n也是晚餐的食材對吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "有肉塊和馬鈴薯、洋蔥、紅蘿蔔……",
    "voice": "vo_adv_1036008_022",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是咖哩呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請不要學別人好嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請容我拒絕。",
    "voice": "vo_adv_1036008_023",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n如果要我做，那麼就會變成去紅蘿蔔的咖哩了唷。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}，你會做咖哩嗎？",
    "voice": "vo_adv_1036008_024",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎麼想，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都不像是能夠煮得出來的樣子……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但……是呢。",
    "voice": "vo_adv_1036008_025",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "若不介意的話，下次有機會，請讓我來做點什麼請你吃吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n算是今天的回禮。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "像是咖哩之類的。一些太難的料理我可能還做不太出來，",
    "voice": "vo_adv_1036008_026",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但如果是簡單一點的……像是餅乾的話我會做。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嘻嘻。",
    "voice": "vo_adv_1036008_027",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我會做一大堆餅乾的，你可得吃得飽飽的唷。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊……",
    "voice": "vo_adv_1036008_028",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1036008_029",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，請問怎麼了嗎？　",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "抱，抱歉～",
    "voice": "vo_adv_1036008_030",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n光聽你們的對話，還以為是對新婚夫婦呢。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒想太多就回頭一看，結果是我搞錯了呢。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "新、新婚夫婦！？",
    "voice": "vo_adv_1036008_031",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、",
    "voice": "vo_adv_1036008_032",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "和{0}是新婚夫婦！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳妳妳、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳說、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳說什……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "也是呢。你們是一對兄妹呢～",
    "voice": "vo_adv_1036008_033",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "兄妹！？",
    "voice": "vo_adv_1036008_034",
    "unit_id": 103631
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗚～～～",
    "voice": "vo_adv_1036008_035",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……不開心了嗎？",
    "voice": "vo_adv_1036008_036",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才沒有那回事。你想太多了！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的……還真是位失禮的人呢。竟然說是兄妹……",
    "voice": "vo_adv_1036008_037",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個人，如果真是人家的哥哥……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}……",
    "voice": "vo_adv_1036008_038",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果是我的……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嗚～～！！！",
    "voice": "vo_adv_1036008_039",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
