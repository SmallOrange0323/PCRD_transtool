    "words": "化身成花的模樣的魔物！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟我們接受委託時聽到的特徵是一樣的……！",
    "voice": "vo_adv_9063155_018",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "竟然會擬態成花朵來隱藏！",
