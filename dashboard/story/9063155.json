    "type": "dialogue",
    "name": "莉莉",
    "words": "還是說，這",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是讓魔物大意的作戰……？　",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "意思是……",
    "voice": "vo_adv_9063155_009",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "因為我一直很警戒，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "魔物才不出現的嗎……！？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我、",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我造成了多大的困擾……！　",
