    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐和貪吃佩可小姐一直以來",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n都是像這樣輕鬆面對魔物討伐的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請莉莉小姐",
    "voice": null,
    "unit_id": 105911
  },
