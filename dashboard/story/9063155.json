  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不、",
    "voice": "vo_adv_9063155_011",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不了！",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我不能做出會給可可蘿小姐添麻煩的事。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "緩解緊張這種程度的事，",
    "voice": null,
    "unit_id": 125813
