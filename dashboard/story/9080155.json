[
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_9080155_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵呵！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n你們這些庶民太礙事了！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還不快給我退下？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n華音大人駕到囉～",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵呵♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我原本聽說只是單純討伐小嘍囉的委託……",
    "voice": "vo_adv_9080155_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難不成這才是本體嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這樣就和原本說好的不同了呢，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吉歐‧尼布爾黑爾居然會出現妖魔人。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所謂的「騙了妳們真抱歉」……",
    "voice": "vo_adv_9080155_002",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "的招數嗎？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒想到居然是這麼吵的討伐目標，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我也是第一次聽說。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那大笑的聲壓，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "讓我耳朵好痛……",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不不不不等等等等，",
    "voice": "vo_adv_9080155_003",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "給我等一下妳們幾個。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳們怎～麼突然華麗地無視我啊！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "什麼討伐目標啊！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我才不是什麼敵人呢！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": "vo_adv_9080155_004",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "還好是認錯人。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然我早就知道了。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那麼，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "現在先把情緒降下來冷靜冷靜。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嘶嘶，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好乖好乖。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不准隨便摸我的頭，",
    "voice": "vo_adv_9080155_005",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳這小不點圓眼鏡！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n別把我當成馬對待啦！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那種摸頭方式不是對我，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n而是對",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "阿貓阿馬…………",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "嗯？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "剛才那是",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "什麼聲音？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "鐘聲──",
    "voice": "vo_adv_9080155_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真令人毛骨悚然的迴響。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "敲響鐘聲的，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是這次的敵人嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "居然敲這種陰沉的鐘，",
    "voice": "vo_adv_9080155_007",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "害我背脊發涼。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就由我來親自討伐你──",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呀啊啊啊啊啊！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那個鐘",
    "voice": "vo_adv_9080155_008",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "又響了呢。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n這個聲音",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "該不會有什麼含義吧？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n深月小姐，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳知道嗎？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_9080155_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……深月小姐？",
    "voice": "vo_adv_9080155_010",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以結論而言，",
    "voice": "vo_adv_9080155_011",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n華音會死。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "什麼～～～～！？",
    "voice": "vo_adv_9080155_012",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n妳在說什麼莫名其妙的話啊！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這種奇怪的驚喜真的不用了，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我沒胡說喔。",
    "voice": "vo_adv_9080155_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是吉歐‧尼布爾黑爾的死亡詛咒。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n每當鐘聲響起，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "被詛咒之人的死亡倒數就會推進──",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n而觸發條件，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是妳那高傲的舉止。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果想活命，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "除了閉嘴別無他法。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "也就是說，",
    "voice": "vo_adv_9080155_014",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "只要華音小姐保持本性就會死。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是這個意思嗎？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那還真糟糕。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n妳還是乾脆放棄算了。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳這小不點尖耳朵圓眼鏡，",
    "voice": "vo_adv_9080155_015",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "也太事不關己了吧！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "再說了！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "要我保持安靜也是能做到的！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "……………………",
    "voice": "vo_adv_9080155_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "安靜下來的華音小姐，",
    "voice": "vo_adv_9080155_017",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "反而有點詭異耶。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "～～～～～～～唔！！！",
    "voice": "vo_adv_9080155_018",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n吵死人了～～～！！！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "事到如今，",
    "voice": "vo_adv_9080155_019",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "在被下那什麼詛咒之類的麻煩事前，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我就先迅速打倒敵人，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "趕緊恢復自由身～～！！！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "給我覺悟吧！",
    "voice": "vo_adv_9080155_020",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n本小姐！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "會華麗地～",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "制裁你！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～呵呵呵呵呵！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………華音那種高亢的笑聲，",
    "voice": "vo_adv_9080155_021",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n即使是身為密醫的我，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也覺得沒救了。",
    "voice": null,
    "unit_id": 105111
  }
]
