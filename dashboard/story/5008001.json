  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與{0}他們分別後，流夏抵達村子入口，\\n她踏入了彷彿不允許發出任何驚愕、\\n被寂靜所支配的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看得出來這裡就是那時提到的村子。",
    "voice": "vo_adv_5008001_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過話又說回來……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "……",
    "voice": "vo_adv_5008001_001",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……",
    "voice": "vo_adv_5008001_002",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算流露出對我這個外人",
    "voice": "vo_adv_5008001_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感興趣的眼神，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n也沒有人過來找我搭話。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這到底是怎麼回事？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "每家店",
    "voice": "vo_adv_5008001_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都是關著的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而且……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也沒見到年輕男性的身影……",
    "voice": "vo_adv_5008001_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都外出了嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "喂，",
    "voice": "vo_adv_5008001_006",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "我知道有人在家！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "\\n把能吃的東西都給我交出來！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好，",
    "voice": "vo_adv_5008001_007",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好的！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這裡就是全部了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請拿去……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "少騙我了！　",
    "voice": "vo_adv_5008001_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "還有藏起來的份吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "這不是還有麵包留著嗎！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "拜、",
    "voice": "vo_adv_5008001_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "拜託你，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請留下這塊麵包……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n孩子的肚子已經餓著了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "那種事情關我屁事！",
    "voice": "vo_adv_5008001_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "\\n叫妳把能吃的東西都給我交出來，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "是沒聽到嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到此為止吧。",
    "voice": "vo_adv_5008001_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "啊！？　",
    "voice": "vo_adv_5008001_012",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "怎麼，妳這傢伙！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "少來礙事！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嘿咻。",
    "voice": "vo_adv_5008001_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "什麼！？　",
    "voice": "vo_adv_5008001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "嘖！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼了？　",
    "voice": "vo_adv_5008001_015",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "完全打不中啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "可惡啊！",
    "voice": "vo_adv_5008001_016",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "底子太差了。",
    "voice": "vo_adv_5008001_017",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去重新練過吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "嘿噗啊啊啊！？",
    "voice": "vo_adv_5008001_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "妳、",
    "voice": "vo_adv_5008001_019",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "妳做什麼！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "妳知道對我出手",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "代表什麼意思吧！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "誰想知道啊。",
    "voice": "vo_adv_5008001_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能給你的東西，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n頂多就那路邊地上的小石子。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "趕快拿了走人。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "妳這傢伙……！　",
    "voice": "vo_adv_5008001_021",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "壞人",
    "words": "給我記住！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "已經忘記啦。",
    "voice": "vo_adv_5008001_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳還好吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳、",
    "voice": "vo_adv_5008001_023",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳看妳、",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "做了什麼好事！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "到底該怎麼辦才好……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……這反應真讓人意外。",
    "voice": "vo_adv_5008001_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這是說餓肚子比較好的意思嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳是什麼都不知道，才能說出那種話來……！",
    "voice": "vo_adv_5008001_025",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "嗚嗚嗚……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "小姐。",
    "voice": "vo_adv_5008001_026",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "關於這位母親的無禮，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "能否請妳原諒她呢？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n她也有她的苦衷啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "生活在這村子所有人的家人，",
    "voice": "vo_adv_5008001_027",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n都被那些傢伙當成人質了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "人質？",
    "voice": "vo_adv_5008001_028",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那傢伙就是負責溪谷洞窟採掘的其中一名業者。",
    "voice": "vo_adv_5008001_029",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "村子裡",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "多數的男人為了尋求工作離開村子……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "可是離開以後，",
    "voice": "vo_adv_5008001_030",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "卻沒有任何一人再回來……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "溪谷洞窟？　",
    "voice": "vo_adv_5008001_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那不就是……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "去打探情況的人，也沒有任何人回來。",
    "voice": "vo_adv_5008001_032",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n就算送陳情書到王都尋求幫助，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "也毫無消息。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "村裡的年輕男人都被奪走，",
    "voice": "vo_adv_5008001_033",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "只剩下我這樣的老人和女人小孩。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n所以就算食物被搶奪，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "除了忍耐也別無他法啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………",
    "voice": "vo_adv_5008001_034",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來，",
    "voice": "vo_adv_5008001_035",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "似乎遇到比想像中更差勁的惡徒了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那傢伙說小弟也只是個小弟吧……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "杏奈和{0}也很令人在意，",
    "voice": "vo_adv_5008001_036",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n得盡快前往溪谷了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "小姐，",
    "voice": "vo_adv_5008001_037",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "妳趕快離開這個村子。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n那些傢伙",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "肯定會回來報仇的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會離開的，",
    "voice": "vo_adv_5008001_038",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但並不是因為怕危險。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n而是因為我的夥伴已經前往洞窟了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說不定",
    "voice": "vo_adv_5008001_039",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能順便一起救出這個村子的人們。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n總之我先去看看――",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――呀啊啊啊啊！！　",
    "voice": "vo_adv_5008001_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救命啊啊啊啊啊啊！！？？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "？　",
    "voice": "vo_adv_5008001_041",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼了……？",
    "voice": null,
    "unit_id": 105611
  }
]
