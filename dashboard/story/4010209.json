  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呼，",
    "voice": "vo_adv_4010209_000",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今天也很忙碌呢。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "回家後還有生日派對……",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n校門口真熱鬧呢？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這感覺，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真令人懷念──",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "──果然，",
    "voice": "vo_adv_4010209_001",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是你啊！",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是的，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之前也發生過同樣的事吧？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "明明跟你說過櫻庭學院的戒備森嚴，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要多注意一點。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有事……",
    "voice": "vo_adv_4010209_002",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是這件事的話，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "事先聯絡我不就好了。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我們也不是打通電話還要猶豫的關係吧？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "畢竟是青梅竹馬啊。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你看，",
    "voice": "vo_adv_4010209_003",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為你這麼突然，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看看四周。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "學生們都看著這邊，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "產生不必要的誤解了。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "或許明天就會成為",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "學院裡的傳聞──",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "─",
    "voice": "vo_adv_4010209_004",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "─嗯，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會成為傳聞呢。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "絕對會。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過……",
    "voice": "vo_adv_4010209_005",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n反正也來不及了，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "算了。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n也沒必要",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "隱瞞我們關係很好這件事嘛？　",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝你。",
    "voice": "vo_adv_4010209_006",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我會珍惜",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你送的禮物哦。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對了，",
    "voice": "vo_adv_4010209_007",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這之後有時間嗎？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "偶爾也一起回去吧。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "接送的車……",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "賽巴斯欽已經",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很貼心地先回去了呢。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我就享受和青梅竹馬度過，",
    "voice": "vo_adv_4010209_008",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "輕鬆愉快的",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "生日吧。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以你……",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個叫法",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也改回去吧。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不要叫小咲戀了，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "叫咲戀就好，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很好！",
    "voice": "vo_adv_4010209_009",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那我們",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "牽著手回去吧。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對了，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也去看看",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那間懷舊點心店好了。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺好像",
    "voice": "vo_adv_4010209_010",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "回到以前一樣了，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對吧……♪",
    "voice": null,
    "unit_id": 102831
  }
]
