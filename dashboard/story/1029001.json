[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在散步的{0}，\\n看到了被眾多男性窮追不捨的女孩子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼、",
    "voice": "vo_adv_1029001_000",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n他們還在後面……！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是的！不要再跟過來了啦！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "小望！",
    "voice": "vo_adv_1029001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "\\n等等我們啊！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……呼……",
    "voice": "vo_adv_1029001_002",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n沒、沒地方可逃了……怎麼辦？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀？",
    "voice": "vo_adv_1029001_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你、你要做什麼？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你說躲在你後面嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "即使你突然那麼說我也……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等、等等！",
    "voice": "vo_adv_1029001_004",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你為什麼要拿出武器啊！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你說要和那些人戰鬥？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不行不行！他們都是好人，你不要對他們那麼粗魯！",
    "voice": "vo_adv_1029001_005",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我確實是被他們追著跑，但那些人都不是壞人……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然他們都是好人，但所謂的愛情有時也會成為利刃……",
    "voice": "vo_adv_1029001_006",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是的，好難解釋啊～",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才、才不是呢！怎麼結論會變成那樣啊？",
    "voice": "vo_adv_1029001_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你聽好了？這世上不是只有正義與邪惡……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這麼吵鬧是怎麼回事！？",
    "voice": "vo_adv_1029001_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "嗯，那邊的傢伙！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n在這種地方亮出武器，你究竟想做什麼？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "看來你們兩個就是這場騷動的主謀了吧。",
    "voice": "vo_adv_1029001_009",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "跟我走！讓我聽聽你們的說詞！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸！ ",
    "voice": "vo_adv_1029001_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼會變成那樣！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果被王宮騎士抓到的話，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不知道會被拘留多久！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊啊，真是的！沒辦法了！",
    "voice": "vo_adv_1029001_011",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你跟我來！要逃跑了喔！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……呼……呼～～",
    "voice": "vo_adv_1029001_012",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n總、總算逃跑成功了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣就可以悠哉地……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦！",
    "voice": "vo_adv_1029001_013",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "天都黑了啦！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只能回家睡覺了……難得的休假都泡湯了……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是的……",
    "voice": "vo_adv_1029001_014",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天真倒楣！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這全部都是你的錯啦！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n都怪你在街上拿出武器！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "早知如此，\\n我答應幫粉絲們簽名的話就好了呢。",
    "voice": "vo_adv_1029001_015",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯？瞧你一臉不可思議的樣子，怎麼了？",
    "voice": "vo_adv_1029001_016",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你應該也是想要我的簽名對吧？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……你好像還是一臉困惑……？",
    "voice": "vo_adv_1029001_017",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，咦……？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n難、難道你不知道我是誰嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，嗯……",
    "voice": "vo_adv_1029001_018",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n像這樣面對面應該是第一次。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不是這個意思啦……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看你這麼煩惱，你不知道我是誰對吧？",
    "voice": "vo_adv_1029001_019",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊，還有人不認識我啊。",
    "voice": "vo_adv_1029001_020",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈，抱歉喔！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我也還差得遠呢～",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但你明明不知道我是誰，卻還來救我……",
    "voice": "vo_adv_1029001_021",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你真是個好人呢！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是望。\\n你叫什麼名字呢？",
    "voice": "vo_adv_1029001_022",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喔～我記住了！",
    "voice": "vo_adv_1029001_023",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛剛我竟然還說今天很倒楣，抱歉喔。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n謝謝你救了我，{0}。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為我的關係，造成了你的困擾……",
    "voice": "vo_adv_1029001_024",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我想要向你賠罪……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，對了！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你知道音響盤嗎？\\n那是一種用魔法將音樂存放在魔石裡的東西。",
    "voice": "vo_adv_1029001_025",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是我的音響盤。",
    "voice": "vo_adv_1029001_026",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不介意的話，你願意收下嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我呢，姑且算是個偶像喔！",
    "voice": "vo_adv_1029001_027",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "白天的那些人是我的粉絲。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，你卻不知道我是誰啊。",
    "voice": "vo_adv_1029001_028",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n看來我成為頂尖偶像之路",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還遠著呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可以的話，你也來幫我加油吧！",
    "voice": "vo_adv_1029001_029",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那麼以後再一起玩吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的很謝謝你！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為意想不到的事情，\\n{0}認識了偶像。",
    "voice": null,
    "unit_id": null
  }
]
