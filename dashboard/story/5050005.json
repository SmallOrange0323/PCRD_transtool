    "words": "沒辦法，也只好這樣了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那兩個人到底去哪裡了啊……",
    "voice": "vo_adv_5050005_091",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n大家一直在幫忙找，但依然沒發現……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不行，",
    "voice": "vo_adv_5050005_092",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的到處都找不到。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們也沒找到……",
    "voice": "vo_adv_5050005_093",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這樣啊……",
    "voice": "vo_adv_5050005_094",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "接下來只能期待騎士先生跟茉莉了……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我和{0}一起\\n詢問了鎮上的人！",
    "voice": "vo_adv_5050005_095",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n有問到他們兩個人的線索了喔！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的嗎！？",
    "voice": "vo_adv_5050005_096",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但很奇怪呢，",
    "voice": "vo_adv_5050005_097",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n鎮上的人說看見他們兩個人和鬼魂教父在一起耶。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "咦？",
    "voice": "vo_adv_5050005_098",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那是怎麼回事？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "直接問他不就好了。",
    "voice": "vo_adv_5050005_099",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "走吧！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "……！",
    "voice": "vo_adv_5050005_100",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "嗯！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "走吧！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "擔心兩人安危的紡希邁開了腳步後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大家便一起跟在了她的身後。",
