  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正當{0}要回家時，\\n看見正在空中飛的初音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": "vo_adv_1012002_000",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……呼嚕……",
    "voice": "vo_adv_1012002_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "喂，你看啊。",
    "voice": "vo_adv_1012002_002",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "竟然有個女的睡在這裡？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "嘿嘿嘿，總之先搶走她身上值錢的東西，",
    "voice": "vo_adv_1012002_003",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "再順便讓我們稍微享受一下吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "啊？ ",
    "voice": "vo_adv_1012002_004",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "搞什麼，你這傢伙！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n打算妨礙我們嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "喂！",
    "voice": "vo_adv_1012002_005",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n在我們說話的時候，那個女的不見了喔！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n她去哪裡了！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "你這傢伙做了什麼嗎？",
    "voice": "vo_adv_1012002_006",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n竟敢救走我們的獵物！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "啊，站住！",
    "voice": "vo_adv_1012002_007",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n你想逃走嗎！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500092"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……呼嚕呼嚕……呼嚕呼嚕……",
    "voice": "vo_adv_1012002_008",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "什、",
    "voice": "vo_adv_1012002_009",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "什麼！？ 有個在皇宮前面睡著的傢伙！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可疑的傢伙……逮捕她吧！",
    "voice": "vo_adv_1012002_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你也是這傢伙的同夥嗎！？ 一起逮捕！",
    "voice": "vo_adv_1012002_011",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～……",
    "voice": "vo_adv_1012002_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要起來還太早了啦。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕呼嚕。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500202"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……呼嚕呼嚕……呼嚕呼嚕……呼嚕呼嚕……",
    "voice": "vo_adv_1012002_013",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……嗯嗯～？",
    "voice": "vo_adv_1012002_014",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n感覺有魔物的聲音～嗯呀嗯呀……？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是……家裡不可能會有魔物……",
    "voice": "vo_adv_1012002_015",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，原來這是夢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那麼，晚安～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔……",
    "voice": "vo_adv_1012002_016",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在搖晃？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n真不好睡啊……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……咕嚕咕嚕……",
    "voice": "vo_adv_1012002_017",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n嗚，好痛苦……無法呼吸……咕嚕咕嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但素豪想睡……呼嚕呼嚕……咕嚕咕嚕……",
    "voice": "vo_adv_1012002_018",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……呼嚕呼嚕……呼嚕呼嚕……呼嚕呼嚕……",
    "voice": "vo_adv_1012002_019",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～！ 睡得好飽～！",
    "voice": "vo_adv_1012002_020",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "初音完全恢復了！ 閃亮亮☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦？ 這是哪裡？",
    "voice": "vo_adv_1012002_021",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼我會在這裡～？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，你也在！",
    "voice": "vo_adv_1012002_022",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你好像很想睡……怎麼了嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_1012002_023",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n因為我邊睡邊飛，你很擔心……？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是這樣啊～",
    "voice": "vo_adv_1012002_024",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你不眠不休在照顧我呢！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我有時會在睡夢中不小心使用超能力，",
    "voice": "vo_adv_1012002_025",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n不知不覺就輕飄飄地飛起來呢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為給你添麻煩了，",
    "voice": "vo_adv_1012002_026",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我必須為此道歉",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n及感謝你照顧我！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有什麼希望我做的嗎？",
    "voice": "vo_adv_1012002_027",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我什麼都能為你做喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦～，不要那樣說嘛！",
    "voice": "vo_adv_1012002_028",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我會過意不去的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喂，讓我為你做點什麼嘛～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！ ",
    "voice": "vo_adv_1012002_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "只要是我做得到的事，什麼都可以喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n放心交給我吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為我有超能力，大部分的事情――",
    "voice": "vo_adv_1012002_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇！ 是、是魔物！？",
    "voice": "vo_adv_1012002_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不得了了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，對了！",
    "voice": "vo_adv_1012002_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "作為你照顧我的謝禮，這次就讓我幫你吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "用瞬間移動來逃離魔物吧！ 嘿噫！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "到了～！",
    "voice": "vo_adv_1012002_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n一瞬間就逃掉了喔！ 很厲害吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "耶～，勝利勝利！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 但是，我們瞬間移動到了未知的洞穴……",
    "voice": "vo_adv_1012002_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你知道出口的方向嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不知道對吧……",
    "voice": "vo_adv_1012002_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我也不知道該往哪走比較好……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，沒――事，沒――事！",
    "voice": "vo_adv_1012002_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒關係喔～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n只要再用我的超能力移動……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼哇～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……因為使用了瞬間移動，又變得想睡了……",
    "voice": "vo_adv_1012002_037",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯呀～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對不起喔……晚安……",
    "voice": "vo_adv_1012002_038",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不管等多久，初音都沒有醒來，\\n{0}只好扛著初音，\\n拼命地尋找洞穴的出口……",
    "voice": null,
    "unit_id": null
  }
]
