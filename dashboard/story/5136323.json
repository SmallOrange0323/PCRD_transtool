    "name": "優衣",
    "words": "它一定是",
    "voice": "vo_adv_5136323_001",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在戰鬥的時候",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n學習了我們的動作。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "下一波",
    "voice": "vo_adv_5136323_002",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "將會是目前為止最強的攻擊吧。",
