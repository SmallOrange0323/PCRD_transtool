    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們該做的就只有一件事！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和、優衣、怜",
    "words": "先下手為強！",
    "voice": "vo_adv_5136323_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_5136323_004",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們很有默契呢。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在精靈發動攻擊之前",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "打倒它吧！",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……看來不需要我們提出建議呢。",
