[
  {
    "type": "background",
    "bg_id": "501220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌逃離了追來的娛樂記者。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一個人在神廟中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "想要集中精神於孕育精靈上，然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": "vo_adv_1344003_000",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不行，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "完全無法專心……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是丟臉啊。",
    "voice": "vo_adv_1344003_001",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為那點事",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就讓內心動搖……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不論是作為偶像",
    "voice": "vo_adv_1344003_002",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還是唱喚士，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我都得更加振作才行。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果是像這樣半吊子的我，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "肯定無法孕育精靈…",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我一定",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也讓他失望了吧。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉……",
    "voice": "vo_adv_1344003_003",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "該怎麼辦才好。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然我對蘭法小姐說了師傅什麼的，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但其實差得遠的根本是我才對……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是不像樣……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "──",
    "voice": "vo_adv_1344003_004",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "誰呢？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n明明這裡不太會有人來的──",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "千歌小姐，",
    "voice": "vo_adv_1344003_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "妳在這裡吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唔！",
    "voice": "vo_adv_1344003_006",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個聲音，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是剛剛的娛樂記者……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有什麼事嗎。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這裡是神聖的神廟，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你保持安靜……！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "好啦好啦，",
    "voice": "vo_adv_1344003_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "妳能快點露面嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n要是關在這種地方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n可是會被人臆測些有的沒的喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "要是變成那樣，感到困擾的可會是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "連其他記者都在！？",
    "voice": "vo_adv_1344003_008",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我會開門的，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請不要那麼用力敲門！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "哦哦──",
    "voice": "vo_adv_1344003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "那身服裝",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "還真好看呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "\\n是下次舞台的服裝嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "是怎麼樣呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "告訴我們吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這並不是舞台服裝。",
    "voice": "vo_adv_1344003_010",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我現在想一個人集中精神……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "這可不行吧，千歌小姐。",
    "voice": "vo_adv_1344003_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n身為當紅偶像，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n居然想一個人獨處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_1344003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "\\n所謂的偶像，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "必須總是在粉絲看得到的地方才行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就、",
    "voice": "vo_adv_1344003_013",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就算你們這麼說……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我是為了唱喚士的修行而來的。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n如果是要採訪，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "等結束後我會接受的，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以今天能請你們回去嗎？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "難不成",
    "voice": "vo_adv_1344003_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "妳有什麼難言之隱嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n有什麼虧心事之類的？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "\\n要是那樣，我可不能當作沒看到啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼事也沒有！",
    "voice": "vo_adv_1344003_015",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你們會給村裡的大家帶來困擾的，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n請別再繼續……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "妳是偶像吧。",
    "voice": "vo_adv_1344003_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "\\n要是說任性的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者3",
    "words": "粉絲也不會再追隨妳的喔？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "任、",
    "voice": "vo_adv_1344003_017",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "任性？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我嗎……？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_1344003_018",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n總、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總之，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你們離開！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "……千歌小姐。",
    "voice": "vo_adv_1344003_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "\\n等妳回到蘭德索爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "會好好讓我們採訪對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……是的，",
    "voice": "vo_adv_1344003_020",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我保證。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "我明白了。",
    "voice": "vo_adv_1344003_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "\\n喂，各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者1",
    "words": "走吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "啊～啊，",
    "voice": "vo_adv_1344003_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "記者2",
    "words": "明明都好不容易到這種地方來了啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………唉。",
    "voice": "vo_adv_1344003_023",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是的……",
    "voice": "vo_adv_1344003_024",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這次又是什麼？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}？",
    "voice": "vo_adv_1344003_025",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你為什麼會在這裡……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是、",
    "voice": "vo_adv_1344003_026",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "當然。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那點程度的事，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我已經習慣了。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……那個，",
    "voice": "vo_adv_1344003_027",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蘭法小姐呢？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣啊……",
    "voice": "vo_adv_1344003_028",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我",
    "voice": "vo_adv_1344003_029",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "剛才的態度不好呢……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "得向蘭法小姐道歉才行，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還有也要向{0}道歉。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是，",
    "voice": "vo_adv_1344003_030",
