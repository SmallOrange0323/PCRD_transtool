    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好好傳達心情……！？　",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那、",
    "voice": "vo_adv_1344003_036",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那種事我辦不到！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n肯定辦不到的吧！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呀啊啊！？",
    "voice": "vo_adv_1344003_037",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n魔力",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "從精靈那裡傳過來──",
