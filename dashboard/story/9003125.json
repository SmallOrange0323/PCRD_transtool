[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喔喔！",
    "voice": "vo_adv_9003125_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "居然在這裡發現晚餐！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "接招吧～！！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐就這樣唰地衝出去了。",
    "voice": "vo_adv_9003125_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過那確實為本次委託內容中，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在這附近作亂的山賊的真實身分吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "【公會管理協會】所委託的擊退山賊任務，",
    "voice": "vo_adv_9003125_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只要打倒那傢伙就能完成了吧。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔～嗯。",
    "voice": "vo_adv_9003125_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個獸人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總感覺和其他的有些不同。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不只是外觀，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺氣息也……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像是經歷過無數戰鬥的戰士一樣。",
    "voice": "vo_adv_9003125_004",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謹慎小心地對付牠吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喝呀！",
    "voice": null,
    "unit_id": 105911
  }
]
