  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你今天邀請我！",
    "voice": "vo_adv_4010256_000",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我一直很期待",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能跟你一起出來玩♪",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿，",
    "voice": "vo_adv_4010256_001",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "像這樣幫我慶生，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我真的很開心呢！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "畢竟我現在是自己一個人住，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還好沒有變成一個孤單的生日呢～",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過，",
    "voice": "vo_adv_4010256_002",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有點沒想到",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "只有我們兩個呢……？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "班上的大家還說什麼",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "「兩個人好好相處喔～」",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "之類的話。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是的，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明明不用那麼顧慮我的……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊，",
    "voice": "vo_adv_4010256_003",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剛才的話",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不用放在心上！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "今天打算去哪裡呢？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "冒險是指，",
    "voice": "vo_adv_4010256_004",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一起玩遊戲嗎？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不是的話，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是指在這邊的世界冒險？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來如此，",
    "voice": "vo_adv_4010256_005",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "與其說是出去玩，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "更像是",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一場小小的旅行？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不錯耶，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這個提議！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "感覺超有趣的♪",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然來到這邊之後，",
    "voice": "vo_adv_4010256_006",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "跟大家一起去了各種地方玩……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但還是有很多沒去過的地方呢。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n全新的冒險，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "光是想像就讓人興奮不已！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好～",
    "voice": "vo_adv_4010256_007",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就這麼決定了。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "禮物就是特別的冒險旅行！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "超棒的！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "目的地的話嘛，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想想……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯！",
    "voice": "vo_adv_4010256_008",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "聽起來",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "超棒的！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我最喜歡的景色……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是最好的生日禮物！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你！",
    "voice": "vo_adv_4010256_009",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那就",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "出發吧！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們一起去尋找",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能成為一生回憶的藍天吧！",
    "voice": null,
    "unit_id": 105731
  }
]
