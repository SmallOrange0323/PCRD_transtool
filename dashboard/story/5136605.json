[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "街道をぶらつきながら、ノウェムはオクトーに話しかける。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なあオクトー",
    "voice": "vo_adv_5110605_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n前から気になってたんだけどさ……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "結局オマエって",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "強いの？　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "弱いの？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "えー、",
    "voice": "vo_adv_5110605_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボク？　",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そりゃ弱いってことはないけど……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "普通くらいじゃない？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nそこらの連中は余裕だけど、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ノウェムよりはか弱いしさ～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "やっぱり、",
    "voice": "vo_adv_5110605_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシのことバカにしてるよな？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nどうせ働くの嫌だーとかで",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "本気だしてないだけだろ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ってことで、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちょっと調べてやろうと思ってさ～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "おう！　",
    "voice": "vo_adv_5110605_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "見つけたぜオマエら！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n俺と勝負しろ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "うわ、",
    "voice": "vo_adv_5110605_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いつのまにこんな近くに……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ノウェムさあ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "気付いてて黙ってたでしょ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "へへっ、",
    "voice": "vo_adv_5110605_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "さっきあっちから走って来るのが見えたからさ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nいいぜ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "受けてやる！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーがな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "え～、",
    "voice": "vo_adv_5110605_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "なんでボクがそんなことしなくちゃいけないのさ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nやだよ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "めんどくさい。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "こうでもしないと",
    "voice": "vo_adv_5110605_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエの本気が分かんないだろ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "構わないからやっちゃえ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "どっちが相手でも俺はいいぜ！",
    "voice": "vo_adv_5110605_008",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n二人がかりでも上等だけどな！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いやだってば。",
    "voice": "vo_adv_5110605_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nボクはここらでバイバイさせてもら……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "っ",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "てノウェム、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "逃げるの邪魔しないでよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いーや、",
    "voice": "vo_adv_5110605_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "逃がさないぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n今日こそオマエの本気、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "見せてもらうからな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "いい加減覚悟しろや！　",
    "voice": "vo_adv_5110605_011",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "オラァ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "うわっ！　",
    "voice": "vo_adv_5110605_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ちょ！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nボクは頭脳労働担当で",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "肉体労働は向いてないんだって！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いや！　",
    "voice": "vo_adv_5110605_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエは本当の力を隠してる！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nアタシにはわかるぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "だからー、",
    "voice": "vo_adv_5110605_014",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そんなのないってば。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nノウェムはさあ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "なんでそんなにボクに期待しちゃってるわけ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そりゃオマエ、",
    "voice": "vo_adv_5110605_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシの相棒なんだから強くないとな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "って、オクトー！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "前！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "前！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "俺様相手に油断してんじゃねえよ！",
    "voice": "vo_adv_5110605_016",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\nもらったあ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ぐ",
    "voice": "vo_adv_5110605_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "はっ！？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "よっしゃ！　",
    "voice": "vo_adv_5110605_018",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "いいの入っ……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "ぐえっ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おい！　",
    "voice": "vo_adv_5110605_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシの相棒になにすんだ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "なん……",
    "voice": "vo_adv_5110605_020",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "でだ……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "よ……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いたたた……",
    "voice": "vo_adv_5110605_021",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あ～……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n背後からかなりいいの入っちゃったねえ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あ、",
    "voice": "vo_adv_5110605_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "やば……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "つい……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nげっ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ダイゴのやつ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "気絶しちゃったぞ……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "どうしよう、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトー……？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "まあ、",
    "voice": "vo_adv_5110605_023",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "二人がかりでも、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "って言ってたし",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "油断してたのはダイゴのほうだしね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nボクらは悪くないんじゃない？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そ、",
    "voice": "vo_adv_5110605_024",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうだよな……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nとりあえず……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ここは……",
    "voice": "vo_adv_5110605_025",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "逃げちゃおう！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "倒れたままのダイゴを置いて逃げ出すノウェムとオクトーであった。",
    "voice": null,
    "unit_id": null
  }
]
