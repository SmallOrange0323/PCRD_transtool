  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您要去哪裡──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂──！",
    "voice": "vo_adv_1097006_063",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那邊的男生們──！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這個叫法好有青春酸甜感！",
    "voice": "vo_adv_1097006_064",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "剛才你們被救了之後，",
    "voice": "vo_adv_1097006_065",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有好好跟雷姆她們道謝了嗎～？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1097006_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有就好。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不只是今天而已，",
    "voice": "vo_adv_1097006_067",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雷姆與可蘿仔平常那麼照顧你們，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要記得好好感謝她們哦──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那是當然的啊，",
    "voice": "vo_adv_1097006_068",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我可是每分每秒",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "每個瞬間都在感謝雷姆呢。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "最近",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "確實表達得不太夠啊。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "雷姆──！",
    "voice": "vo_adv_1097006_069",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "一直以來謝謝妳。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n因為有雷姆妳在，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我才能活到今天！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昂……",
    "voice": "vo_adv_1097006_070",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": "vo_adv_1097006_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然在下只是在盡該盡的職責而已，",
    "voice": "vo_adv_1097006_072",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但能像這樣被親口感謝",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然還是很開心呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的……",
    "voice": "vo_adv_1097006_073",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n雷姆……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "現在心裡洋溢著",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "幸福的感覺。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且，",
    "voice": "vo_adv_1097006_074",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐為我們著想的心意，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也讓在下非常地感動。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_1097006_075",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才沒有在替妳們著想呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……只是，",
    "voice": "vo_adv_1097006_076",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明白了妳們兩個",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "氾濫到不行的愛情，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是像這個樣子",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在扶持著他們的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n感覺很了不起呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就只有一點點這種想法而已。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": "vo_adv_1097006_077",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真是過獎了。",
    "voice": "vo_adv_1097006_078",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好、",
    "voice": "vo_adv_1097006_079",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我還要看著行李。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們四個就相親相愛地，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "盡情玩耍吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆、可可蘿",
    "words": "……♪",
    "voice": "vo_adv_1097006_080",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "──",
    "voice": "vo_adv_1097006_081",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n有一點，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請讓雷姆訂正一下。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1097006_082",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有什麼事嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "剛才那個時候，",
    "voice": "vo_adv_1097006_083",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雖然擊退魔物的確實是雷姆我們。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真正了不起的人，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "並不是雷姆我們。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_1097006_084",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴他們也……",
    "voice": "vo_adv_1097006_085",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不對，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆覺得昴他們，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "才是真正了不起的人。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯？",
    "voice": "vo_adv_1097006_086",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "救了他們的",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是雷姆跟可蘿仔吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那兩人，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是站在那邊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被妳們救而已吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不，",
    "voice": "vo_adv_1097006_087",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "並不光是站著而已！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n明明有那麼多的魔物，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "卻還是抬頭挺胸地站著！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "如果昴他們那時驚慌失措的話，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "結果就不會是現在這樣了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真不愧",
    "voice": "vo_adv_1097006_088",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是昴。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那副英勇的模樣……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "實在深感佩服。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也跟",
    "voice": "vo_adv_1097006_089",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐想的一樣，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人聽到了「請別動」之後，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就乖乖地待在原地，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對於這樣的判斷能力，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下心中深感佩服。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……也、",
    "voice": "vo_adv_1097006_090",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比起幫助他們的自己，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n被幫助的那兩個人，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還要更了不起，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個意思嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆我們之所以可以順利地救到人，",
    "voice": "vo_adv_1097006_091",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n全都要歸功於讓我們順利出手相救的，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴他們的功勞。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉…………",
    "voice": "vo_adv_1097006_092",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然我早就知道，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔的愛有多重了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但沒想到連雷姆也……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳們兩個真的是超乎想像耶……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊──",
    "voice": "vo_adv_1097006_093",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突然間覺得好累啊……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我要先來",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃便當了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_1097006_094",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯？",
    "voice": "vo_adv_1097006_095",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": "vo_adv_1097006_096",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "巨大的包袱裡面，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全部都是便當……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的。",
    "voice": "vo_adv_1097006_097",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n雷姆與可可蘿小姐一起徹夜合力，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "製作而成的便當。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把主公大人與昴先生愛吃的東西全部放進去後，",
    "voice": "vo_adv_1097006_098",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n便當盒就變成十五層這麼高了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "十、",
    "voice": "vo_adv_1097006_099",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "五、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "層",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "高……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難怪……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會這麼",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "重啊～～～～～！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太重了！",
    "voice": "vo_adv_1097006_100",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太重了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳們的一切全都太沉重了～～～～！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在晴空萬里之下的普拉諾平原，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n凱留的叫聲輕盈地響徹著。",
    "voice": null,
    "unit_id": null
  }
]
