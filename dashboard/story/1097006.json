[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到普拉諾平原野餐的雷姆、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可可蘿、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n──以及",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩個男生。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "好寬闊！",
    "voice": "vo_adv_1097006_000",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "適度的高低差！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "而且還有瀑布！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n這景色真讓人興奮啊！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這比起野餐，",
    "voice": "vo_adv_1097006_001",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "更像是要展開冒險吧！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n天氣也很好，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "真是棒透了。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我的少年心久違地蠢蠢欲動啊。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "哦，",
    "voice": "vo_adv_1097006_002",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "馬上就要來賽跑了嗎？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n可別小看還滿認真的",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "前劍道社員的雙腿喔～！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哇！",
    "voice": "vo_adv_1097006_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很危險耶！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n又不是小孩子了別在那亂跑啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……真是的。",
    "voice": "vo_adv_1097006_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "他們興奮過頭了吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵呵。",
    "voice": "vo_adv_1097006_005",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人跟昴先生",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經變得這麼要好了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因為羅茲瓦爾大人的宅邸裡大多是女性。",
    "voice": "vo_adv_1097006_006",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n對昴來說，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "同年齡層的男性友人是很珍貴的。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我想",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "他一定覺得很高興。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然……",
    "voice": "vo_adv_1097006_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是這個樣子啊。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人也是一樣呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然認識的人很多，",
    "voice": "vo_adv_1097006_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但說到同性的友人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n除了昴先生以外",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就幾乎沒有了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "原來如此……",
    "voice": "vo_adv_1097006_009",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n這樣看來，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "他們對於彼此都是很寶貴的存在呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那麼……",
    "voice": "vo_adv_1097006_010",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆要再次，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請妳們今後",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也多多關照昴。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下才要請兩位多多指教。",
    "voice": "vo_adv_1097006_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n希望能與主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "長久地友好相處。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_1097006_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……欸、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸欸。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們這是什麼，",
    "voice": "vo_adv_1097006_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聽起來像媽媽友人間的對話。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我聽著聽著",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺身體都癢～起來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "媽媽……？",
    "voice": "vo_adv_1097006_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這怎麼敢當呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1097006_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "乃是服侍主公大人的隨從。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n像這樣的稱呼，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在太僭越了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆也跟可可蘿一樣。",
    "voice": "vo_adv_1097006_016",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "只要昴他能夠開心就好了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啊，",
    "voice": "vo_adv_1097006_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，",
    "voice": "vo_adv_1097006_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "差不多快到中午了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要來準備用餐了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天的便當",
    "voice": "vo_adv_1097006_019",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是特別精心製作的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是放入很多主公大人喜愛料理的得意之作。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然主公大人不管什麼料理",
    "voice": "vo_adv_1097006_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n都會好好吃完不挑食……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但如果有放入蝦子小香腸的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人會特別高興。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "除了之前教雷姆的那些以外",
    "voice": "vo_adv_1097006_021",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "居然還有這種形狀……！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這樣子……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "感覺昴應該也會很開心呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那個",
    "voice": "vo_adv_1097006_022",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "「蝦子小香腸」",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的作法，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n下次也能教教雷姆嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的，",
    "voice": "vo_adv_1097006_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然沒有問題。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣的話，不知道能否稱作交換，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請讓在下學習雷姆小姐的料理食譜──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說……",
    "voice": "vo_adv_1097006_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈囉哈囉？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "熱衷於媽媽友人間的對話，根本沒聽到我在叫她們……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是說，",
    "voice": "vo_adv_1097006_025",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "寵溺成這樣連看的人都覺得不好意思了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們兩個",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的是，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有夠像的……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雷姆、可可蘿",
    "words": "…………！",
    "voice": "vo_adv_1097006_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1097006_027",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳們兩個，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
