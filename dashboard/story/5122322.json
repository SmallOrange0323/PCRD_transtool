  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃她",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "朝我們這邊發動攻擊了……！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "優花梨，",
    "voice": "vo_adv_5122322_001",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請冷靜下來看仔細一點。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那是",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "島鯨給我們看的幻影，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是我的闇影喔！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那麼，",
    "voice": "vo_adv_5122322_002",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個則是我的闇影……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "至於那邊，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是似似花的闇影！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不是，",
    "voice": "vo_adv_5122322_003",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那是我的分身。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我、",
    "voice": "vo_adv_5122322_004",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我說似似花……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n現在場面很混亂，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可以請妳避免使用分身嗎……",
    "voice": null,
    "unit_id": 126711
  }
]
