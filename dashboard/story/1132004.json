  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "領取完海底城的獎品後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}等人悠閒地在海灘上度過──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然證明了我們下輩子也會在一起，這點很令人高興，",
    "voice": "vo_adv_1132004_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但卻沒有找到任何和前世有關的資訊，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "滿遺憾的……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說到底，",
    "voice": "vo_adv_1132004_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我原本是要調查前世情報的吧？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還以為可以有什麼收穫的說。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "事情果然沒有這麼順遂。",
    "voice": "vo_adv_1132004_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……唔，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然我早就知道沒這麼簡單。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "如果天啟可以",
    "voice": "vo_adv_1132004_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "恰巧從天而降就好了──",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那、",
    "voice": "vo_adv_1132004_004",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那道光芒",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是什麼！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吉格魯特，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特……！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "抱、",
    "voice": "vo_adv_1132004_005",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "抱歉！吉格魯特，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你等很久了嗎！？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這樣啊……",
    "voice": "vo_adv_1132004_006",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "其實我剛才",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "受到了「機關」的阻撓，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n再加上不熟悉這塊土地，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "所以花的時間",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "比想像中還長……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這、",
    "voice": "vo_adv_1132004_007",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這也是沒辦法的事呀！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n身為疾風之冥姬的我，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是很忙碌的！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我並不是迷路喔！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "絕對不是！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "因為你抽獎中獎了，",
    "voice": "vo_adv_1132004_008",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這次我才破例陪你來的。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "畢竟",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們是命運共同體嘛！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "接下來，",
    "voice": "vo_adv_1132004_009",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們先到海之家看看怎麼樣？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n吉格魯特，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你肚子也餓了吧？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "咦？",
    "voice": "vo_adv_1132004_010",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不去嗎？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那我們",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "在海灘上散散步吧！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "找幾隻寄居蟹來當跟班吧！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……你想去海裡玩？",
    "voice": "vo_adv_1132004_011",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這這、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "唔！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我突然覺得身體好痛！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是「機關」搞的鬼嗎……！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哎呀～！",
    "voice": "vo_adv_1132004_012",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "太遺憾了！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這樣我就不能下水了！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我就在海灘上看著，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你好好去玩吧！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "唔，",
    "voice": "vo_adv_1132004_013",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那倒也不是……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "再這麼瞞下去也不是辦法。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你說的沒錯。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我並不是不會游泳，",
    "voice": "vo_adv_1132004_014",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "只是……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n我今天帶來的",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是學校的泳衣……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我怎麼可能會有機會買那種時髦的泳衣呀？",
    "voice": "vo_adv_1132004_015",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我只有這種基礎裝備……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……去買一件就好了？",
    "voice": "vo_adv_1132004_016",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "笨蛋！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我就是做不到才會演變成這種局面啊！！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你",
    "voice": "vo_adv_1132004_017",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "看看那邊。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哇，",
    "voice": "vo_adv_1132004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "超可愛的耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "難不成",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是為了今天特地準備的……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "嗯！",
    "voice": "vo_adv_1132004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "畢竟是約會嘛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我想說穿新泳衣比較好♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "周圍都是穿著漂漂亮亮的泳衣",
    "voice": "vo_adv_1132004_020",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "玩得開心的女孩子……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n在這種環境裡穿學校的泳衣……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "一、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "一定很突兀的吧？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "其實，",
    "voice": "vo_adv_1132004_021",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我直接跟你說",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "沒辦法來就好了……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "但遲遲說不出口，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "就一路拖到了今天……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我肯定",
    "voice": "vo_adv_1132004_022",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "會讓吉格魯特你很沒面子的。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "所以我今天就不下水了──",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你那是",
    "voice": "vo_adv_1132004_023",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哪裡來的自信啊。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這話是什麼意思……？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "反正我先換泳衣就對了？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "唔，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "唔……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……好啦，",
    "voice": "vo_adv_1132004_024",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "到時候會變成什麼情況我可不管啊！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "still",
    "still_id": "113200401"
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "讓、",
    "voice": "vo_adv_1132004_025",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "讓你久等了……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "果然很醒目啊……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "什麼！",
    "voice": "vo_adv_1132004_026",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "吉格魯特",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你也帶了學校的泳衣嗎！？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n你應該有時間去買吧？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "為什麼──",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊，",
    "voice": "vo_adv_1132004_027",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你沒有勇氣去買啊？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "噗、",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們居然不約而同帶了同樣的泳衣，",
    "voice": "vo_adv_1132004_028",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n看來我和你的緣分",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "果然是不管走到哪也斷不了呢！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "吉格魯特，",
    "voice": "vo_adv_1132004_029",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你已經做好覺悟了吧。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們「",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "熾炎戰鬼煉獄血盟暗黑團」",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "將統治這片大海！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "先在海裡游個痛快，",
    "voice": "vo_adv_1132004_030",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "然後再吃刨冰！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n還有打西瓜……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "對了！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "還要玩沙灘排球！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "讓我們一起突破",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "沉睡在這片大海的所有考驗！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "只要和你在一起，",
    "voice": "vo_adv_1132004_031",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我就沒有什麼好擔心的！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n走吧，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "讓他們見識見識",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們之間的羈絆～！！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1132004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次的夢境如何呀？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還開心嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在意他人的目光而感到難為情，",
    "voice": "vo_adv_1132004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n杏奈也是個",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正值青春期的女孩子呢～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也因為",
    "voice": "vo_adv_1132004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "同樣穿著學生泳衣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n成功地幫杏奈圓場，做得不錯。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然平常做了一堆遲鈍男行為，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但在這一點還是可以誇獎你的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然杏奈在「這一側」和「那一側」都經常逞強亂來……",
    "voice": "vo_adv_1132004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但她總認為只要有你在就不必擔心，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這或許也是信賴的證明吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔、",
    "voice": "vo_adv_1132004_036",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我又",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "夢到前世了……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你也作了同樣的夢嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒錯，",
    "voice": "vo_adv_1132004_037",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是這個！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "想不到這件泳衣上",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "蘊藏著我們前世以來的連繫！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "七七香所說的傳說裝扮",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難道是這個意思嗎……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "將我們連繫在一起的羈絆",
    "voice": "vo_adv_1132004_038",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "比我想像的要深厚得多，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還是以壓倒性的堅韌連結在一起！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_1132004_039",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我絕對",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不會離開你的身邊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "所以，從今以後我們也繼續",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "共同對抗「機關」吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來，",
    "voice": "vo_adv_1132004_040",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對這個墜飾許下諾言。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們在前世，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "今世，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n直到來世都是同路人！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈哈哈哈！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後，修特帕魯將學生泳衣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n視為代表前世羈絆的服裝，令她感到驕傲無比。",
    "voice": null,
    "unit_id": null
  }
]
