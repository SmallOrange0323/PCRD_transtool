[
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──當{0}投身於和【憤怒‧軍團】的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n新的戰鬥中時，某個人物",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n則在另一個世界中展開了行動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "來，讓妳久等了，",
    "voice": "vo_adv_1068001_000",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "草莓可麗餅！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很好吃喔〜！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "大姐姐，",
    "voice": "vo_adv_1068001_001",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "謝謝妳〜！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "歡迎再來〜！",
    "voice": "vo_adv_1068001_002",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "做可麗餅果然很開心～！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1068001_003",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "拉基拉基！",
    "voice": "vo_adv_1068001_004",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "歡迎光臨～！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你要點什麼？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……說明現況。",
    "voice": "vo_adv_1068001_005",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "抱歉，",
    "voice": "vo_adv_1068001_006",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那個賣完了♪",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "正如你所見，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我這裡可是可麗餅店啊。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "要我把妳揍飛嗎？",
    "voice": "vo_adv_1068001_007",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "開玩笑的，我是開玩笑的！",
    "voice": "vo_adv_1068001_008",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你別生氣啦！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "別像那樣",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "馬上就要用上全接觸空手道的規則啊！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我原本人就沒好到",
    "voice": "vo_adv_1068001_009",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "能聽妳開玩笑了。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n麻煩妳別轉移話題。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真是的，",
    "voice": "vo_adv_1068001_010",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "難得好久不見，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你還是這麼冷淡耶……",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "在阿斯特朗",
    "voice": "vo_adv_1068001_011",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "開始營運後我就立刻陷入了昏睡狀態。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n現在可沒有多餘的閒功夫",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "去在意態度好不好。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "說的也是呢。",
    "voice": "vo_adv_1068001_012",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n不過既然這樣，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你為什麼沒有立刻來找我打聽？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "因為從醒來到現在的這段時間，",
    "voice": "vo_adv_1068001_013",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n我最優先做的是讓變差的體力恢復正常。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "而在那段時間裡",
    "voice": "vo_adv_1068001_014",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我也有一點一滴在收集情報，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "所以才得知了……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n晶，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "和真那他們不同，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "最近回到了「這一側」的只有妳。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我也有隱隱約約聽到消息囉。",
    "voice": "vo_adv_1068001_015",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n聽說拉基拉基在這一側也",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "開始行動了。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "那事情就好說了。",
    "voice": "vo_adv_1068001_016",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n我認為妳對那邊的情況瞭若指掌，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n一定能夠提供我想要的情報，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "因此才會來到這裡。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這樣啊，",
    "voice": "vo_adv_1068001_017",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "歡迎你遠道前來日本。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n所以呢？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你想知道什麼事？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……有關於這邊與那邊，",
    "voice": "vo_adv_1068001_018",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這兩個世界目前的現況。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "OK。",
    "voice": "vo_adv_1068001_019",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……今天就打烊吧。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我會邊收拾東西邊說話，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "沒關係吧？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "無所謂，",
    "voice": "vo_adv_1068001_020",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "只要不影響情報內容就好。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好～",
    "voice": "vo_adv_1068001_021",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "首先是",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這裡的世界",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "已經大致安定下來了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我回來的時候，有不少事情都還一團糟，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n但我全用WISDOM的權限想辦法處理了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就靠妳一個人？",
    "voice": "vo_adv_1068001_022",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "那想必讓妳耗費了不少心力吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就是啊！",
    "voice": "vo_adv_1068001_023",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我是真的很辛苦耶〜！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "從復職以後就一直沒休假，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n如果不是義體的話，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我現在",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "早就滿身瘡痍了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "義體……",
    "voice": "vo_adv_1068001_024",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是長老製造的機械肉體嗎？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "晶，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "等話談完之後，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "和我稍微比試一下……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我才不要！",
    "voice": "vo_adv_1068001_025",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "拉基拉基",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你不知道這副身體要花多少錢吧！？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n就算只是素體，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "也要花上大都市一整年左右的預算啊！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "正因如此才更讓人想破壞看看……",
    "voice": "vo_adv_1068001_026",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "現在就先作罷吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "才不只「現在」，",
    "voice": "vo_adv_1068001_027",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "以後也不行！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "總之，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在阿斯特朗中的人們的肉體都平安無事。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳說肉體……",
    "voice": "vo_adv_1068001_028",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這麼說的話，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "意識呢？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯……",
    "voice": "vo_adv_1068001_029",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大概沒辦法輕易恢復。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n比起真那實現野心的世界，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "情況又變得更加複雜了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在那裡的玩家，",
    "voice": "vo_adv_1068001_030",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n所有人都被迫認為阿斯特朗是現實，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n甚至連記憶都遭到竄改。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "嗯……",
    "voice": "vo_adv_1068001_031",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "不只是細節，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "連整體的意識資料都沒有和肉體同步嗎。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我是不清楚這是誰搞的鬼，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "但還真是被設了個麻煩的限制啊。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n這根本是",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "強制將活人拉進冥府的行為。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真～",
    "voice": "vo_adv_1068001_032",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不愧是拉基拉基！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就算大睡特睡一頓也依舊是七冠，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "理解得真快！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我姑且有採取對策嘗試從玩家方面進行同步，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但不曉得",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "能不能順利。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "原本只要打倒掌控阿斯特朗的真那，",
    "voice": "vo_adv_1068001_033",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這一切就應該能畫下句點……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但結果並非如此。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "而我目前",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "正在尋找導致這結果的原因。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "原來如此……",
    "voice": "vo_adv_1068001_034",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n那麼妳",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "暫時",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "會將心力專注在處理阿斯特朗的問題上？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是啊，",
    "voice": "vo_adv_1068001_035",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我也很擔心我的公主騎士。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "拉基拉基呢？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你打算怎麼辦？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "既然手邊沒有能夠操縱的帳號，",
    "voice": "vo_adv_1068001_036",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "那麼我考慮",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "在這邊的世界從WISDOM內部採取對策。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n畢竟我好歹",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "也是七冠之一啊。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這麼說也是啊。",
    "voice": "vo_adv_1068001_037",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我在那邊看到的拉基拉基，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那到底是什麼人啊？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n既不是本人，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "也不可能是那孩子……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "無論在操縱的人是誰，",
    "voice": "vo_adv_1068001_038",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "對我而言都不重要。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n等事情結束之後我會搶回來，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "僅此而已。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……我突然想到啊，",
    "voice": "vo_adv_1068001_039",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "拉基拉基你，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "該不會覺得\\n自己對這次的事情有責任吧！？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "明明你也沒做什麼壞事，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n只是一直在睡覺而已！？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "難道是我聽錯了嗎……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……晶。",
    "voice": "vo_adv_1068001_040",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "從剛才開始妳的行為舉止，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n只會讓人覺得妳是在主動討打呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "可是我真的很驚訝啊！",
    "voice": "vo_adv_1068001_041",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n畢竟你可是那個獨善其身的拉基拉基耶！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "關於那點我不否認。",
    "voice": "vo_adv_1068001_042",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "對吧？",
    "voice": "vo_adv_1068001_043",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這樣我就算覺得驚訝也很合情合理吧？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我",
    "voice": "vo_adv_1068001_044",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就身為參與開發阿斯特朗人員的立場，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n在道義上對此件事抱有責任感，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "有這麼令人不可思議嗎？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯，",
    "voice": "vo_adv_1068001_045",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很不可思議。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……回答得真直接。",
    "voice": "vo_adv_1068001_046",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就像是個在戰鬥前就敗退出場的人。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "所以，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n我只是不希望圍繞著米奈娃的鬥爭再繼續擴大。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哼嗯……",
    "voice": "vo_adv_1068001_047",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "所謂的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "戰士、",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "或該說是",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "格鬥家，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就是這樣的人嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "以在這邊的七冠來看，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我認為拉基拉基是最適任的，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n也沒什麼不好的吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "不過這也是為了揍毀米奈娃。",
    "voice": "vo_adv_1068001_048",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "撤、",
    "voice": "vo_adv_1068001_049",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "回、",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "前、",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "言！！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "呵……",
    "voice": "vo_adv_1068001_050",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是開玩笑的。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這是在回敬妳剛才的仇。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "騙人。",
    "voice": "vo_adv_1068001_051",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你肯定還是一心想要找那孩子反擊……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這種討人厭的地方也都沒變，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "能看到你這麼有精神真是太好了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳也是。",
    "voice": "vo_adv_1068001_052",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "像迷宮一樣蠱惑他人的性格，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "也還是都沒變呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是嗎？",
    "voice": "vo_adv_1068001_053",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "別看我這樣，我這還不是萬全的狀態喔。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n結果我也還沒回到原本的身體去……",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "收拾",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "完畢！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那麼，",
    "voice": "vo_adv_1068001_054",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我差不多要回阿斯特朗了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n之後就麻煩你了！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "等一下。",
    "voice": "vo_adv_1068001_055",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我雖然有說過要接手，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "但妳給我等一下。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "怎麼了？",
    "voice": "vo_adv_1068001_056",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你如果想觀測那邊的影像，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n有我使用過的螢幕和器材，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就隨便你用吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳是認真的嗎？",
    "voice": "vo_adv_1068001_057",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "一回去有可能會再也無法醒來啊。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不用擔心。",
    "voice": "vo_adv_1068001_058",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我雖然不是克莉絲，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但「絕對」會醒來的。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n況且那邊",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "也有值得信賴的人們在呢。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是似似花和克莉絲提娜嗎？",
    "voice": "vo_adv_1068001_059",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n還是",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "諾維姆和尾狗刀？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不是不是。",
    "voice": "vo_adv_1068001_060",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是我挑選為公主騎士的少年，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "和他的夥伴們。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n他們很可靠。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "似似花",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "現在也在幫助他們。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這樣啊。",
    "voice": "vo_adv_1068001_061",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "晶，",
    "voice": "vo_adv_1068001_062",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳從一開始",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就打算把我留在這裡……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這樣",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我們彼此就算互不相欠吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯〜？",
    "voice": "vo_adv_1068001_063",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你在說什麼〜？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我可是知道的。",
    "voice": "vo_adv_1068001_064",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n陷入昏睡狀態時替我保護肉體的人，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就是妳。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哎呀，",
    "voice": "vo_adv_1068001_065",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "被發現了啊。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我明明都說過要保密了！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……只要知道答案，",
    "voice": "vo_adv_1068001_066",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就沒什麼事比這更簡單了。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n受不了，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳真的還是老樣子，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "腦海裡",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "根本就是一座迷宮，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "晶。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "畢竟我可是",
    "voice": "vo_adv_1068001_067",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "迷宮女王啊。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n不用擔心，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我不是睡美人，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不用人親也會醒來啦！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "無論是否擔心",
    "voice": "vo_adv_1068001_068",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我也完全不會有",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "要親吻妳的想法。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n快點走吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嘖～",
    "voice": "vo_adv_1068001_069",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你還是老樣子開不起玩笑耶。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……那邊的事情",
    "voice": "vo_adv_1068001_070",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就拜託妳了。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……嗯，",
    "voice": "vo_adv_1068001_071",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "交給我吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……話說回來，晶。",
    "voice": "vo_adv_1068001_072",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳停在這的這輛車",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "要怎麼辦──",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "──潛入，阿斯特朗！",
    "voice": "vo_adv_1068001_073",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你們等我喔，",
    "voice": "vo_adv_1068001_074",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "少年、",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大家──！！　",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "晶！",
    "voice": "vo_adv_1068001_075",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "給我等一下，晶！",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……來不及阻止她。",
    "voice": "vo_adv_1068001_076",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n雖然我也沒資格說別人，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "但她還真是我行我素。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "七冠等人，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "都不是些正常的傢伙。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "接下來……",
    "voice": "vo_adv_1068001_077",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "說實話，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我是很想把這東西直接打壞，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n真是沒辦法。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "得把這個搬到某個地方去才行──",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "嗯，",
    "voice": "vo_adv_1068001_078",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這是……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "信嗎？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "呀呵～拉基拉基！",
    "voice": "vo_adv_1068001_079",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你好嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你生氣了嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就算生氣也別揍我喔！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我把地址寫在這，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "麻煩幫我把攤車",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "開到這個地方去喔！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n若是不知道地點的話，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就打開",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "放在那邊的平板裡的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "地圖App吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還有",
    "voice": "vo_adv_1068001_080",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "義體的管理，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我留下從長老那裡拿到的說明書了，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n把那個看一看吧！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那就再見囉〜！　",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……她從一開始就打算採取這麼獨斷的行動了嗎？",
    "voice": "vo_adv_1068001_081",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "算了，也罷。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這件事",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我也會算在人情裡有借有還的。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "願妳與妳的夥伴，",
    "voice": "vo_adv_1068001_082",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "獲得太陽與星星的祝福。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯……",
    "voice": "vo_adv_1068001_083",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯〜！",
    "voice": "vo_adv_1068001_084",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我回來了〜！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "璃乃和靜流都不在……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "先從",
    "voice": "vo_adv_1068001_085",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "收集情報開始著手吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還有大家，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你們等我喔！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再次來到另一個世界的拉比林斯達，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了與夥伴會合而開始展開了行動。",
    "voice": null,
    "unit_id": null
  }
]
