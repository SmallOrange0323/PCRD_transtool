    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n只是有點",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "睡眠不足。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過，",
    "voice": "vo_adv_1364004_003",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "看到騎士先生的臉，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n就覺得有精神了。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "想著昨晚的事，",
    "voice": "vo_adv_1364004_004",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n結果完全睡不著。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這叫我怎麼說得出口……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚嗚，",
