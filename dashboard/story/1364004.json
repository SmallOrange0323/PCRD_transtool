    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和優衣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n約在購物中心會合。",
