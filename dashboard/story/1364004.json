    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "感覺太陽",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也比平常耀眼……",
    "voice": null,
    "unit_id": 136412
