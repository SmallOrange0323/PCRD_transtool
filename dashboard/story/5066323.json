    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總覺得沒辦法坐視不管。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "看來及早處理會比較好呢。",
    "voice": "vo_adv_5066323_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嘉夜、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "趕緊讓它倒下吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "況且，它會像這樣陷入失控狀態，",
    "voice": "vo_adv_5066323_003",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們也有",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一部分的責任呢……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": "vo_adv_5066323_004",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也是多虧了它，我才能夠發現……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在的我，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經和過去的我不一樣了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說得好，",
    "voice": "vo_adv_5066323_005",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳們倆加油啊～☆",
    "voice": "vo_adv_5066323_006",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "正合我意！",
    "voice": "vo_adv_5066323_007",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大就在那邊好好見識一下！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n靠我們的力量來阻止這傢伙！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要上了唷，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好，",
    "voice": "vo_adv_5066323_008",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就由我們來為這一切劃下句點！！",
    "voice": null,
