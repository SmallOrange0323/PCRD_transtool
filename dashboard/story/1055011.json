[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在步未將護身符送給{0}後過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n做為當時的回禮，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與步未講好要一起去約會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這裡就是約好碰面的地方……",
    "voice": "vo_adv_1055011_000",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n{0}前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "似乎還沒有來。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幸好今天沒有遲到～",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒想到能再次跟{0}前輩約會，",
    "voice": "vo_adv_1055011_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n有努力做護身符真是太好了～",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n雖然是自己手工做的，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但我也有受到保佑呢～♪　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "要去什麼地方，",
    "voice": "vo_adv_1055011_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "又要聊些什麼話題好呢……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在遠處看著前輩時",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明妄想了很多事情，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一旦實際見面就會緊張起來，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "無法好好說話……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩……！",
    "voice": "vo_adv_1055011_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我真的沒有等很久，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還請放心！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "今天",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "非常感謝你願意陪我……♪",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊……",
    "voice": "vo_adv_1055011_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩今天",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也有把護身符繫在身上呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n你能那麼重視它，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我真的很開心……♪",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那麼，",
    "voice": "vo_adv_1055011_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "今天要去哪裡……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你是不是在發光……？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "之前好像也發生過一樣的事……",
    "voice": "vo_adv_1055011_006",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呀啊～！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我看看，",
    "voice": "vo_adv_1055011_007",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "制服跟書包已經下訂了……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n接下來去買教科書吧。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "通知書上寫說在商店街的書局就有賣……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總覺得",
    "voice": "vo_adv_1055011_008",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好沒有真實感……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n考試的當下",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還想說一定會落榜，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒想到",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "竟然考上了第一志願……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然過程很辛苦，",
    "voice": "vo_adv_1055011_009",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但有認真念書真是太好了～♪",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "然後，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也多虧有那位在我的腳受傷時……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "願意出手相助的人。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n要不是他騎腳踏車送我一程，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我甚至無法參加考試。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我好想",
    "voice": "vo_adv_1055011_010",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "再見他一面……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "他真的好帥……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我來不及問他的名字跟學校……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……算了，",
    "voice": "vo_adv_1055011_011",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這也沒辦法。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n除了教科書之外，還得買很多東西，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n早點把事情辦完吧。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……啊～！？",
    "voice": "vo_adv_1055011_012",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n是考試那天幫助我的大哥哥！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好久不見……！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這實在太巧了……！",
    "voice": "vo_adv_1055011_013",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "難道說，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想要見到他的心情傳達給神明了嗎……！　",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦，",
    "voice": "vo_adv_1055011_014",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你問我……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "考試的結果嗎？",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我有順利通過考試，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "進入椿丘高中就讀了！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這都是多虧有",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大哥哥你的幫忙……♪",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你說",
    "voice": "vo_adv_1055011_015",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣我就是學妹了……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大哥哥也是椿丘高中的學生嗎……！？",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣啊，",
    "voice": "vo_adv_1055011_016",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大哥哥是因為升班，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "來買新的教科書。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我也是因為相同的理由才來這裡。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "其他還有很多東西要買，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "挺辛苦的……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……你要幫忙……",
    "voice": "vo_adv_1055011_017",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這怎麼",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好意思呢……！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n考試那天就已經受到你的幫助了……！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幫助一次",
    "voice": "vo_adv_1055011_018",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "跟幫助兩次也差不了多少……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大哥哥，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你真的很溫柔呢。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我可能還是第一次",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "碰到如此親切的人……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯，",
    "voice": "vo_adv_1055011_019",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那麼，",
