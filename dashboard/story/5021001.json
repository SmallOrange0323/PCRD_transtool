  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要是這裡有苦瓜就更完美了～",
    "voice": "vo_adv_5021001_039",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就知道妳會這樣說，我事先放進便當裡了。",
    "voice": "vo_adv_5021001_040",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然只是炒了些像苦瓜的東西",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而已。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
