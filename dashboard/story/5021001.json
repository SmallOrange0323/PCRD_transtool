    "name": "真步",
    "words": "為什麼……",
    "voice": "vo_adv_5021001_044",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主？",
    "voice": "vo_adv_5021001_045",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　發生什麼事了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這是怎麼回事？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "遮陽傘也插在這裡，",
    "voice": "vo_adv_5021001_046",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們應該沒搞錯地方呀～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然剛才的確沒注意這邊，",
    "voice": "vo_adv_5021001_047",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但數量有那麼多耶？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但是到處都沒看到呢～",
    "voice": "vo_adv_5021001_048",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家……",
    "voice": "vo_adv_5021001_049",
    "unit_id": 110611
  },
