    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……雖然我也邊說邊覺得很恐怖……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但都走到這一步了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不能放棄啊！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是這股鬥志！",
    "voice": "vo_adv_5100308_002",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "綾音小姐！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n盡全力上吧。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "靠咱們的話",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "肯定沒問題！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不慌張、不躁動、",
    "voice": "vo_adv_5100308_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不大意……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呦。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n讓牠看看",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們的真本事！",
