  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然我得擦防曬乳，",
    "voice": "vo_adv_6019107_000",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但真是累死人了～",
