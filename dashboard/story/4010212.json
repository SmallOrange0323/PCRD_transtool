  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "歡迎回來～♪",
    "voice": "vo_adv_4010212_000",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今天去上學",
    "voice": "vo_adv_4010212_001",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "很辛苦吧♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "課堂上有沒有不懂的地方？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n之後和姐姐一起複習吧。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "？？？",
    "voice": "vo_adv_4010212_002",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為是理所當然",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "才在這裡啊？？？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "迎接弟弟回家的姐姐。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這不是再正常不過的情景嗎♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "話說回來弟弟♪",
    "voice": "vo_adv_4010212_003",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n現在是姐姐猜謎時間！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "──今天是",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼日子呢？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "噗噗──",
    "voice": "vo_adv_4010212_004",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "答錯了♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "答案是，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「被親愛的弟弟慶祝生日的姐姐，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n感動地抱住弟弟之後用膝枕好～好地寵愛弟弟的日子」",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "喔♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是這樣",
    "voice": "vo_adv_4010212_005",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要開始囉，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟與姐姐",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "命中注定的一天♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": "vo_adv_4010212_006",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝你♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明我來的有點強硬，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你卻連禮物都準備好了呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……弟弟真的是",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "很棒的弟弟呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼，",
    "voice": "vo_adv_4010212_007",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "接下來是抱抱時間！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "～行，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不要逃跑♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這種程度，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只是姐弟常有的肢體接觸喔？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……呵呵♪",
    "voice": "vo_adv_4010212_008",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好溫暖～♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "再來是膝枕喔？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n做好被姐姐寵愛的心理準備吧。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有弟弟在身邊的生日。",
    "voice": "vo_adv_4010212_009",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "非常幸福♪",
    "voice": null,
    "unit_id": 104931
  }
]
