  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "變身的時候",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "衣服整個消失，",
