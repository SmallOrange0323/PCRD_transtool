    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "………………看你的反應我都明白了。",
    "voice": "vo_adv_6033205_001",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "不、",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "不過，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "應該看不太清楚吧……？",
