    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "間抜けコンビが",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "結構やるじゃねえか……",
    "voice": null,
    "unit_id": 106511
