  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふっふっふ、",
    "voice": "vo_adv_5027702_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "もはや負け惜しみにしか聞こえねーですよ。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nよくやったです、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラちゃん！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nりっぱなしりとり戦士になったですね……",
    "voice": null,
    "unit_id": 106611
  },
