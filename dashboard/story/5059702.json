  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "それよりカヤちゃん、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "イノリちゃん",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "とられちゃったね～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "べつにそんなんじゃないだろ。",
    "voice": "vo_adv_5027702_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
