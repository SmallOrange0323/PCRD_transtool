    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "珍貴的本小姐",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "要的是真貨！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n只有華～麗的寶石才適合我──！！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "啊，",
    "voice": "vo_adv_5205062_010",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "那可以給我嗎～？",
