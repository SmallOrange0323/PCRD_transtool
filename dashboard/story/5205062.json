  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐的寶劍呢！？",
