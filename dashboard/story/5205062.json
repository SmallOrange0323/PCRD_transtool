    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不需要！",
    "voice": "vo_adv_5205062_009",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "你是在諷刺拿糖假稱寶石的那件事嗎！？",
