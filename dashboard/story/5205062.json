    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……這麼說來，",
    "voice": "vo_adv_5205062_013",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "之前錯過品嘗吉歐‧提格尼亞的糖的時嘰了……",
