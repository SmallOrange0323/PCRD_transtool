  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……不對，",
    "voice": "vo_adv_5205062_003",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "地下城的話應該會有寶物！",
