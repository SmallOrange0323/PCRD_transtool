  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐才不會因為",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一顆那樣的糖果而羨慕──！！",
