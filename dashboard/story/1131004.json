[
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "教訓完盜墓者的隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊……",
    "voice": "vo_adv_1131004_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "天終於亮了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哇啊啊啊啊！",
    "voice": "vo_adv_1131004_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託饒了我吧……！？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……喔，",
    "voice": "vo_adv_1131004_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來是你啊！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別突然",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟我搭話啦，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我還以為是什麼出現了……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一回想起昨天的事，",
    "voice": "vo_adv_1131004_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怕得要命……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要稍微有點聲響，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就會",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "驚醒。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "反倒是",
    "voice": "vo_adv_1131004_004",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "遇見那種事，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "居然還能這麼平靜啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你都不覺得",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "害怕嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "碰上真正的靈異事件，",
    "voice": "vo_adv_1131004_005",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的反應就這樣而已嗎……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺別人就會說",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的心臟是鐵打的呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔，",
    "voice": "vo_adv_1131004_006",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說的是沒錯啦……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但幽靈這種存在，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "本身就令人害怕不是嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉，",
    "voice": "vo_adv_1131004_007",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說是我想太多",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "確實也不無道理。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也覺得這樣的自己",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "滿丟人的……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只不過，",
    "voice": "vo_adv_1131004_008",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也不曉得",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "自己為什麼會這麼怕鬼。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也沒有",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的被惡靈纏身的經驗。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "算了，",
    "voice": "vo_adv_1131004_009",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "像現在是大白天，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也不會特別放在心上。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "光線不曉得為什麼特別強……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你怎麼在發光呀！？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這也該是",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一種靈異現象了吧！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼回事……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "background",
    "bg_id": "510292"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "抱歉啊，",
    "voice": "vo_adv_1131004_010",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "臨時約你出來。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你等很久了嗎？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒有啦，",
    "voice": "vo_adv_1131004_011",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是那麼嚴重的事。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我只是",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想和你一起",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "體驗一下夏日風情啊。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……怎麼了？",
    "voice": "vo_adv_1131004_012",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓你那麼意外嗎？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我也是會有",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想要玩樂的時候呀。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "長大之後",
    "voice": "vo_adv_1131004_013",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就沒有暑假了，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能像這樣子玩樂的機會也不多。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以呀……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你看，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "煙火組合包。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n商店街的人給我的。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然不是祭典的煙火，",
    "voice": "vo_adv_1131004_014",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但這種煙火也不賴吧？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我還提了水桶過來，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "兩個人一起",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "悠閒地玩一玩吧？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": "vo_adv_1131004_015",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在這附近玩煙火",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會被罵的。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們去",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "寬敞一點的公園吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "background",
    "bg_id": "510122"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在這附近應該就沒問題了。",
    "voice": "vo_adv_1131004_016",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那要從哪種煙火開始玩呢？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊，",
    "voice": "vo_adv_1131004_017",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這是會冒出長長一條的煙火吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就玩這個……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………",
    "voice": "vo_adv_1131004_018",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "奇怪？",
    "voice": "vo_adv_1131004_019",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這個煙火有這麼普通的嗎……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我記得小時候玩得滿開心的呢……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_1131004_020",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說到正統的煙火，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "果然還是這個吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那我先點火，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "然後再接給你……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……咦？",
    "voice": "vo_adv_1131004_021",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要一次拿那麼多嗎？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你說一口氣點燃",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "比較好玩啊……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也是可以啦……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哇啊啊啊！",
    "voice": "vo_adv_1131004_022",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "等等，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沖天炮！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n怎麼會有沖天炮混在裡面啦啊啊啊！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "最後",
    "voice": "vo_adv_1131004_023",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來玩線香煙火吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要來比賽",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看誰的煙火撐得比較久呀？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "輸家",
    "voice": "vo_adv_1131004_024",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要無條件聽從贏家的一個要求。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那要開始囉……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "開始！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "still",
    "still_id": "113100401"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦？",
    "voice": "vo_adv_1131004_025",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的煙火",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好像快掉下去了耶。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n看來輸贏已經",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "很明顯囉？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈，",
    "voice": "vo_adv_1131004_026",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你能撐到什麼時候呀。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就讓我見識一下",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的毅力吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……我啊，",
    "voice": "vo_adv_1131004_027",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然很怕鬼。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但夏天夜晚的氣氛，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "其實，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我還蠻喜歡的呢。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "微風吹拂，",
    "voice": "vo_adv_1131004_028",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "蟲鳴此起彼落……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n有種",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "「啊，夏天來了。」",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的感覺。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "然後，",
    "voice": "vo_adv_1131004_029",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就突然發現。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n明明是夏天，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "自己卻完全沒有",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好好享受過。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "擇日不如撞日，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就約了你。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "即便是這麼倉促的邀約，",
    "voice": "vo_adv_1131004_030",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你還願意陪我，真是太好了。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n託你的福，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓我好好體驗到夏日風情了呢。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "still",
    "still_id": "113100402"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會這麼想，",
    "voice": "vo_adv_1131004_031",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "或許……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就是因為有你在身邊吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "background",
    "bg_id": "510122"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦，",
    "voice": "vo_adv_1131004_032",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是我贏了！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那要",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓你答應我什麼要求好呢……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對了，",
    "voice": "vo_adv_1131004_033",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓你請我吃超商的冰淇淋吧。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我們可以",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "邊吃邊漫步回去。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1131004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你所看見的畫面是像夢境一樣的東西。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "玩得還開心嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "平時的流夏給人的印象是",
    "voice": "vo_adv_1131004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "堅毅而帥氣的大人。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也見到她",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不一樣的一面了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "偶爾流露出來的柔和神情",
    "voice": "vo_adv_1131004_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很有魅力呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n居然想要和你一起玩煙火，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "多麼可愛呀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "流夏不只堅強，",
    "voice": "vo_adv_1131004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "心思也很細膩。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n從今以後，你也要好好地成為她的助力喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔、",
    "voice": "vo_adv_1131004_038",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我睡著了嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n是因為",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我前一晚沒睡好嗎……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "睡著的時候，",
    "voice": "vo_adv_1131004_039",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我夢見和你在一起呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們兩個人",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在晚上",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "玩煙火……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……如果留下更多",
    "voice": "vo_adv_1131004_040",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "和你共度夜晚的",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "美好回憶，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是不是就能",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "稍微",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不那麼怕鬼了呢？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然如此，",
    "voice": "vo_adv_1131004_041",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "今天晚上",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就出去玩吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到時候我們一起玩看看",
