[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜的導覽大受好評，讓這門生意相當成功，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n工作接二連三地上門。然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊～好累～！",
    "voice": "vo_adv_1166003_000",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近每天都在導覽導覽導覽！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就因為這樣，我完全沒辦法打架。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我並不是討厭做導遊的工作。",
    "voice": "vo_adv_1166003_001",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n看到大家樂在其中，我也覺得很開心。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": "vo_adv_1166003_002",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我可是打手啊！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我想打一場會讓人熱血沸騰的架啊！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "妳心情挺差的啊，",
    "voice": "vo_adv_1166003_003",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "嘉夜。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1166003_004",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你知道的話就閉嘴吧。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我可不知道現在的自己會做出什麼事情喔？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "我是求之不得，",
    "voice": "vo_adv_1166003_005",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "但我也不想被老大盯上……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "事情就是這樣，有工作上門啦，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "是導遊的工作。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託饒了我吧……",
    "voice": "vo_adv_1166003_006",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "很遺憾，",
    "voice": "vo_adv_1166003_007",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "妳好像沒有拒絕的權利喔。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "這次的客人是",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "從外地來蘭德索爾旅行的貴族。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n這份工作就交給妳和平常那位小哥一起負責。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "老大好像本來就是為了和這種權威人士打好交情，",
    "voice": "vo_adv_1166003_008",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n才會開始這門生意的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "她就是為了這件事，",
    "voice": "vo_adv_1166003_009",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "才會讓妳紮實地累積工作的經驗吧。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "妳可不能搞砸這件工作啊，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "嘉夜。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我知道啦，",
    "voice": "vo_adv_1166003_010",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真受不了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "貴賓偏偏",
    "voice": "vo_adv_1166003_011",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在這種時候上門嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是提不起勁……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "希望對方至少是個正常的傢伙啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃～",
    "voice": "vo_adv_1166003_012",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是今天為你擔任導遊的嘉夜。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n請多指教。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼，",
    "voice": "vo_adv_1166003_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "因為對方特別向我推薦你們，我本來還在期待來的會是什麼樣的人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n沒想到導遊居然是你們這種小丫頭和年輕人啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "算了，",
    "voice": "vo_adv_1166003_014",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們可要讓我好好享受啊？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖，",
    "voice": "vo_adv_1166003_015",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在最糟糕的時機來了個最糟糕的客人……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不管怎麼樣，這時候也只能用和平常一樣的方式撐過去了啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼，",
    "voice": "vo_adv_1166003_016",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "所謂的蘭德索爾",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "也沒想像中那麼了不起嘛。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n沒想到高貴的我都到這裡來了，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "卻不能進入王宮。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1166003_017",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那邊並不在導覽路線內。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "就這點程度的小事，我希望你們能先打點好啊。",
    "voice": "vo_adv_1166003_018",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "妳自豪的那什麼導覽也只是吵鬧而已，一點都不有趣。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "會對這種程度的東西心存感謝的，",
    "voice": "vo_adv_1166003_019",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n大概是身分和格調都很低下的人吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "高貴的我實在是沒辦法理解啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個……",
    "voice": "vo_adv_1166003_020",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "傢伙……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哎呀哎呀？",
    "voice": "vo_adv_1166003_021",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我好像感覺到了一股反抗的氣氛啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們總不該",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "對客人擺出這種態度吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼，",
    "voice": "vo_adv_1166003_022",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你和那個小丫頭不一樣，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "既順從又機靈啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "不用再介紹城鎮了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "接下來請你們為我做城鎮外部的導覽吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我明、",
    "voice": "vo_adv_1166003_023",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "白了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我來為你帶路──",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "喂喂喂，",
    "voice": "vo_adv_1166003_024",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們是打算要高貴的我在外頭走動嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "喂，年輕人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你就來揹我吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "等等，",
    "voice": "vo_adv_1166003_025",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這再怎麼樣都太……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼，",
    "voice": "vo_adv_1166003_026",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "既然如此，你們只要能備好一台馬車就行了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "立刻準備好。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "怎麼？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們辦不到嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔，",
    "voice": "vo_adv_1166003_027",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "既然如此，就讓我來……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "不了，",
    "voice": "vo_adv_1166003_028",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我對妳實在是沒什麼好感啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "就這一點來說，這傢伙既順從又好使喚。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……抱歉，",
    "voice": "vo_adv_1166003_029",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都是因為我，才讓你承擔了所有的麻煩。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈哈哈！",
    "voice": "vo_adv_1166003_030",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "不錯不錯，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這樣挺舒適的！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你看起來寒酸，卻出人意料地結實嘛！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你覺得如何？",
    "voice": "vo_adv_1166003_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "要不要繼續當我的馬？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n我會讓你每天替我做牛做馬。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "世上沒有比這還要更加光榮的事情了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……啊，",
    "voice": "vo_adv_1166003_032",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我到底在做什麼啊？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "重要的死黨被這樣對待，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我卻只是在旁邊看著。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "工作當然很重要。",
    "voice": "vo_adv_1166003_033",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也很清楚這是必須忍耐的事情。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但就算是這樣，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是有極限的。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算讓我感受到這麼強烈的憤怒，",
    "voice": "vo_adv_1166003_034",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳還是想和這種傢伙打好關係嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老大……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "依據情況，我可能會毀掉這一切喔？　",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "喲，",
    "voice": "vo_adv_1166003_035",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "你玩得挺開心的嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "真不愧是貴族，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "連娛樂都很高尚啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "沒人跟你說過，在這種地方玩耍是很危險的嗎？",
    "voice": "vo_adv_1166003_036",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "那麼，接下來就和我們一起玩玩吧！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "什麼！？",
    "voice": "vo_adv_1166003_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這群無禮之徒是什麼人！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈，",
    "voice": "vo_adv_1166003_038",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大概是以打劫為目的的盜賊吧。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "你很清楚嘛，這位大姐。",
    "voice": "vo_adv_1166003_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "好了，這位貴族，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "請你把值錢的東西交出來吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "只要你乖乖聽話，",
    "voice": "vo_adv_1166003_040",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "\\n就不會嘗到苦頭囉。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我、",
    "voice": "vo_adv_1166003_041",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這樣如何？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n這是我手上所有的現金和貴重物品。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們滿意了嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這傢伙……",
    "voice": "vo_adv_1166003_042",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "剛剛的態度明明還那麼神氣，\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的是個見風轉舵的傢伙啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "這還真厲害啊！",
    "voice": "vo_adv_1166003_043",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "我們這不是中大獎了嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "好，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "既然把能搶的東西都搶到手了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "我們快開溜吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "不，等一下。",
    "voice": "vo_adv_1166003_044",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "這傢伙可是超乎我們想像的大人物啊。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "\\n好像能把他當成挺棒的搖錢樹，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "就帶他走吧。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這、",
    "voice": "vo_adv_1166003_045",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這跟你們剛才說的話不一樣啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "嘻嘻嘻，",
    "voice": "vo_adv_1166003_046",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "壞蛋怎麼可能會遵守約定啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n我們會好好壓榨你的。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "嗚……",
    "voice": "vo_adv_1166003_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我就買下你們吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "啊？",
    "voice": "vo_adv_1166003_048",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "你這傢伙在說什麼啊？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "為了見不得光的工作和骯髒事，",
    "voice": "vo_adv_1166003_049",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我養了私人的傭兵團。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n我會讓你們也加入那個傭兵團的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n這樣比繼續當低劣的盜賊好多了吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "天底下還有這麼不得了的貴族啊。",
    "voice": "vo_adv_1166003_050",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "這事聽起來的確很美，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n卻還不足以讓我們信任你啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "既然如此，這群傢伙也給你們。",
    "voice": "vo_adv_1166003_051",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n不管是要賣掉還是當成手下，都隨你們的意吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n所以你們要先保證我的生命安全無虞！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……唉。",
    "voice": "vo_adv_1166003_052",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "呀哈哈哈！",
    "voice": "vo_adv_1166003_053",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "這位貴族卑鄙到連壞蛋都會嚇一跳啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "不過這還真有趣，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "我跟了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "嘿嘿，",
    "voice": "vo_adv_1166003_054",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "那麼這位貴族，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "我們走",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "盜賊２",
    "words": "咕嘎噗！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "……啊？",
    "voice": "vo_adv_1166003_055",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們好像談好了啊。",
    "voice": "vo_adv_1166003_056",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我本來還覺得該救你的，就端看你的態度如何，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但我放心了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你是連這點價值都沒有的卑鄙渾蛋。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就能毫不猶豫地",
    "voice": "vo_adv_1166003_057",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "揍扁你了！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "妳、",
    "voice": "vo_adv_1166003_058",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "妳這小鬼！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "少在那裡囂",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊１",
    "words": "嘎喔──！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "給我閉嘴。",
    "voice": "vo_adv_1166003_059",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你、",
    "voice": "vo_adv_1166003_060",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你們這些傢伙！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "怎麼會被一個小丫頭搞成這樣！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n還不快站起來，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "站起來保護我啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒用的。",
    "voice": "vo_adv_1166003_061",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "來，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "接下來輪到你了，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "吸人血的垃圾。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "嗚咿！",
    "voice": "vo_adv_1166003_062",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "對、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "對了，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我就代替那個盜賊買下你們吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n我也會支付比其他人高好幾倍的酬勞，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這樣就沒問題了吧！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你以為這樣我就會接受了嗎？",
    "voice": "vo_adv_1166003_063",
    "unit_id": 116611
