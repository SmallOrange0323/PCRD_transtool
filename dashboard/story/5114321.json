[
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵喵喵！？",
    "voice": "vo_adv_5114321_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是一大群招財貓喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "以眼還眼，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "以牙還牙，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "以貓還貓喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就由我來當你們的對手喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔，",
    "voice": "vo_adv_5114321_001",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這些傢伙",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "異常堅硬！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "劍完全刺不進去……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這裡就使用魔法──",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵！？",
    "voice": "vo_adv_5114321_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這邊這隻黑色的，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "魔法對牠完全沒有效喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣該怎麼辦才好喵！？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……原來如此。",
    "voice": "vo_adv_5114321_003",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "看來牠們根據顏色會有不同的抗性。",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "此外，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "面對這麼一大群對手，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們在數量方面明顯不利呢……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "面對久違的強敵，我的手開始癢了呢。",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳怎麼好像有點開心啊喵！？",
    "voice": "vo_adv_5114321_004",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n總、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只要分別使用物理與魔法來打倒牠們就行了吧喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯，",
    "voice": "vo_adv_5114321_005",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "使用能夠影響群體的範圍攻擊",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會更好喔！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們上吧！",
    "voice": null,
    "unit_id": 125211
  }
