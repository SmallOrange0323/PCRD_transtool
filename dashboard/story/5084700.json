[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "回去蘭德索爾的方法，",
    "voice": "vo_adv_5084700_000",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "回去的方法～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是什麼食物呀，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請給我一份～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "回去的方法……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這飲料看起來好漂亮喔，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請給我一杯～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": "vo_adv_5084700_001",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對不起。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為心急地想著要回去，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "反而使我的肚子拼命咕嚕叫了……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你會不會也餓了呢？",
    "voice": "vo_adv_5084700_002",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n……咦？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "食慾？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這麼說起來，",
    "voice": "vo_adv_5084700_003",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你從剛才開始臉色就不太好耶？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的嘴裡感到又苦",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "又辣……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n再加上還有點甜甜的，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有種甜苦辣的感覺……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "身體還像是被雷給劈到一樣",
    "voice": "vo_adv_5084700_004",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "麻了起來……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且總覺得似乎",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "整個人在旋轉……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你身上……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "究竟發生了些什麼事呀～～～～！？",
    "voice": null,
    "unit_id": 105831
  }
]
