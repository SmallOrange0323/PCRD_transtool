    "type": "dialogue",
    "name": "智",
    "words": "所以，",
    "voice": "vo_adv_5213071_004",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那個……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我剛才",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為太沉迷於可愛甜點，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n發出奇怪聲音的這件事……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要是妳們能幫我保密，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會很感激",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "的……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯，",
    "voice": "vo_adv_5213071_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是啊。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我也有同感……♪",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所、",
    "voice": "vo_adv_5213071_006",
    "unit_id": 103712
  },
