  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "一直沒機會出遠門真的很可惜，",
    "voice": "vo_adv_6017202_000",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我認為蘭德索爾",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "一定有很多非常有特色的地方，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我很想知道。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那裡賣的食材和雜貨品項很豐富吧。",
    "voice": "vo_adv_6017202_001",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也想去那裡採買！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "身為一位女僕，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "必須完全掌握住家附近的市場才行。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "咦，",
    "voice": "vo_adv_6017202_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "學校嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你說自己因為不識字所以在學校唸書",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "啊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "學校有可能會倒閉是嗎。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "以這個角度來說",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的確相當有緊張感，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也確實是一個很有吸引力的地方。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你說了像姊姊一樣的話呢。",
    "voice": "vo_adv_6017202_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "和情同家人的夥伴",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "一起生活的空間，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的確是最棒的。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆也很想念宅邸，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真想馬上回去打掃。",
    "voice": null,
    "unit_id": 109711
  }
]
