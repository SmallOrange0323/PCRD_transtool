  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好了，",
    "voice": "vo_adv_4010188_000",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們到了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n在放學回家路上",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "跟閣下一起到懷舊點心店來，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n已經",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "變成每天的習慣了呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "每次都會聚在這裡小孩子們，",
    "voice": "vo_adv_4010188_001",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今天難得不在呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n只有我跟閣下兩個人。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯嗯，",
    "voice": "vo_adv_4010188_002",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這下麻煩了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n以往都是跟小孩子們一起，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n才能毫無顧慮地",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "吃著懷舊點心……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說……",
    "voice": "vo_adv_4010188_003",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼……！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下到底有什麼打算！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n居然做這種讓人羨慕，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不對，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這種奢侈的行為……！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難、",
    "voice": "vo_adv_4010188_004",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道說閣下，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是為了我才買了",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼多的懷舊點心……！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……沒想到你居然記得我的生日。",
    "voice": "vo_adv_4010188_005",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n明明就連我自己本身，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都沒特別去在意了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下送的禮物，",
    "voice": "vo_adv_4010188_006",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我確實收到了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然我，那個，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對懷舊點心，並沒有特別喜歡",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哦？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但還是心懷感激地",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "全部收下了！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為這可是",
    "voice": "vo_adv_4010188_007",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下送的禮物啊！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以我只好勉為其難，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "把這兩隻手抱滿滿的懷舊點心給吃掉囉！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呵呵、",
    "voice": "vo_adv_4010188_008",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呵呵呵……！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n簡直就像在做夢一樣……！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下……♪",
    "voice": null,
    "unit_id": 105331
  }
]
