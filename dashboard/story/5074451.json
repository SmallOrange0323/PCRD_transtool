  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "今天就是",
    "voice": "vo_adv_5074451_000",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在大江戶町的最後一天了呢。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我揭穿了院長的陰謀，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "戰勝了一場激戰！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀～",
    "voice": "vo_adv_5074451_001",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的名聲",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "又要再次轟動全大江戶啦。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗真是罪過呢♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……算了，",
    "voice": "vo_adv_5074451_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳要這麼想我是沒意見啦。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過只看妳這膽量的話，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也許真有資格稱得上是英雄吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我這次也付出了不少勞力呢，",
    "voice": "vo_adv_5074451_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就先悠哉休息一下吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳在說什麼啊？醫生。",
    "voice": "vo_adv_5074451_004",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們都",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一直在工作，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n根本沒機會好好聊天耶？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不如一邊辦慶功宴，",
    "voice": "vo_adv_5074451_005",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n一邊讓醫生",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "徹底了解一下",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美麗吧♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唉……",
    "voice": "vo_adv_5074451_006",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳真的很令人傷腦筋。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過說來也奇怪，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我竟然不覺得討厭。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這也是因為你的影響嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總之，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你也要奉陪到底喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "待在大江戶町的",
    "voice": "vo_adv_5074451_007",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "最後一天，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我們好好享受吧♪",
    "voice": null,
    "unit_id": 117511
  }
