  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七七香、深月、修特帕魯和克蘿茜同心協力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一同捕捉在大街上逃竄的魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "杏奈美眉──！",
    "voice": "vo_adv_9007004_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "魔物跑到妳那邊去囉──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼……！",
    "voice": "vo_adv_9007004_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "終於來了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "膽敢擋在我「疾風之冥姬」面前，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n看來你是不要命了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好，",
    "voice": "vo_adv_9007004_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n在我右眼中隱隱燃燒，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "猶如煉獄之炎的力量……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就展現給你看吧！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈啊啊啊……！",
    "voice": "vo_adv_9007004_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最終究極至上不滅天下無上極大超越慘烈──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5.5──！",
    "voice": "vo_adv_9007004_004",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……嗯？",
    "voice": "vo_adv_9007004_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哎呀？",
    "voice": "vo_adv_9007004_006",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n魔物就這樣",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "從杏奈身邊跑過去了耶？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "最終究極至上……",
    "voice": "vo_adv_9007004_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "後面我是忘記了啦，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過杏奈想放的招式",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "完全被魔物忽視掉了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "對方根本充耳不聞呢！",
