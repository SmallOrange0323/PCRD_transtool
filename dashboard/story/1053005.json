  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在散步的{0}，\\n偶然發現了莫妮卡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我還以為是誰呢，",
    "voice": "vo_adv_1053005_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來是閣下啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你想知道",
    "voice": "vo_adv_1053005_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我在做什麼嗎……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不是什麼大事。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我作為軍人為了要提升自己，",
    "voice": "vo_adv_1053005_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n所以正打算和朋友們去訓練。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下也一起來嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下似乎很感興趣啊。",
    "voice": "vo_adv_1053005_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就跟過來吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很好，",
    "voice": "vo_adv_1053005_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到啦。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n今天要在這裡訓練喔。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的朋友們，差不多也快來了吧……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "莫妮卡！",
    "voice": "vo_adv_1053005_005",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "久等了！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔。",
    "voice": "vo_adv_1053005_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說人人就到。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n他們正好來了呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "莫妮卡",
    "voice": "vo_adv_1053005_007",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "真早到耶。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是當然。",
    "voice": "vo_adv_1053005_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "作為軍人，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "自當要恪守時間啦。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來吧，",
    "voice": "vo_adv_1053005_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "開始今天的特訓！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n首先，列隊！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好──！",
    "voice": "vo_adv_1053005_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才不是遊戲！",
    "voice": "vo_adv_1053005_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是真正的訓練喔！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下……",
    "voice": "vo_adv_1053005_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是在取笑我嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我可不是來玩的喔！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是",
    "voice": "vo_adv_1053005_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "模擬在多人數狀況下的戰鬥訓練。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "孩子們身手很敏捷。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n也可以藉此鍛鍊我的腰腿──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "啊，",
    "voice": "vo_adv_1053005_014",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "是我爸爸！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "爸爸──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "這裡這裡──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "謝謝大家和我女兒一起玩。",
    "voice": "vo_adv_1053005_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "今天我也帶點心來了喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好耶──！",
    "voice": "vo_adv_1053005_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哼，",
    "voice": "vo_adv_1053005_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為有點心就這麼興奮……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n所以說你們還是孩子呀。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……但、",
    "voice": "vo_adv_1053005_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果就只有我不拿，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n會破壞團體秩序。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣不太好。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "莫妮卡",
    "voice": "vo_adv_1053005_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "也請拿吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯、",
    "voice": "vo_adv_1053005_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "每次都承蒙你關照了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………",
    "voice": "vo_adv_1053005_021",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎、",
    "voice": "vo_adv_1053005_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了，{0}？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n為什麼用疑惑的眼神看我？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下是想說我是為了拿點心",
    "voice": "vo_adv_1053005_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才會來這裡的嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才、才不是！ ",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼可能有那種事呢！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了點心，",
    "voice": "vo_adv_1053005_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才和小孩一起玩什麼的……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我身為一個光榮的軍人，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是不可能做這種事情的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我說的是實話喔！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "莫妮卡！",
    "voice": "vo_adv_1053005_025",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "快點繼續剛才的特訓吧──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊，",
    "voice": "vo_adv_1053005_026",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是啊！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我得去陪孩子們了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "先這樣啦，{0}！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "莫妮卡，",
    "voice": "vo_adv_1053005_027",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "這種點心好好吃喔。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "分妳一半。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可以嗎？",
    "voice": "vo_adv_1053005_028",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好吧，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那我的也分一半給妳。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}欣慰地看著和孩子們打成一片的莫妮卡。",
    "voice": null,
    "unit_id": null
  }
