  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當和平的蘭德索爾發生事件時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就會有位詠唱魔法咒語的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正義夥伴現身——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "迷霧，",
    "voice": "vo_adv_1122001_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "理論， ",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真實！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n魔法緞帶，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "螺旋！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "魔法偵探Misty★霞",
    "voice": "vo_adv_1122001_001",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "用魔法的力量開始搜查！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "什麼！？",
    "voice": "vo_adv_1122001_002",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n妳這傢伙",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "是怎樣啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "呵。",
    "voice": "vo_adv_1122001_003",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "就如同報上的名號一般，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "只是個微不足道的魔法偵探。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n在我面前引起事件",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "是你運氣太差了呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "給我乖乖地束手就擒吧！",
    "voice": "vo_adv_1122001_004",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "嘖！",
    "voice": "vo_adv_1122001_005",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "打扮成那種莫名其妙的樣子！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n什麼魔法偵探啊！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "給我滾開……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "受不了，",
    "voice": "vo_adv_1122001_006",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "真是不死心耶。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "給我後悔自己犯下的愚蠢行為吧……！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不論是什麼謎題都能一口氣解決！",
    "voice": "vo_adv_1122001_007",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "用愛的力量逮捕犯人☆",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "——迷霧纏束！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "still",
    "still_id": "112200101"
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "唔呃～！？",
    "voice": "vo_adv_1122001_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "見識到了吧。",
    "voice": "vo_adv_1122001_009",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n你是無法逃離",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "本魔法偵探的手掌心的。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "逮捕犯人，",
    "voice": "vo_adv_1122001_010",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這樣事件就圓滿解決了☆",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "可、",
    "voice": "vo_adv_1122001_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "惡……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "居然會被這種打扮莫名其妙的傢伙……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "……",
    "voice": "vo_adv_1122001_012",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "可以請你別一直提我的打扮嗎？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n就算再怎麼習慣，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "但我自己還是覺得很難為情啊！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "再說，",
    "voice": "vo_adv_1122001_013",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "什麼魔法偵探啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n這不是根本就沒有半點偵探的要素嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "……咦？",
    "voice": "vo_adv_1122001_014",
    "unit_id": 112211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "……助手先生。",
    "voice": "vo_adv_1122001_015",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n我希望你能老實回答我……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我現在",
    "voice": "vo_adv_1122001_016",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "該不會……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不像個偵探吧？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "也就是說，我不是偵探對吧……？",
    "voice": "vo_adv_1122001_017",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "算了，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "看你那反應就能察覺得出來了。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這、",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "真是個不會說謊的人呢，",
    "voice": "vo_adv_1122001_018",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "你呀。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "千萬可別小看我的觀察力喔。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "光是你剛才轉移視線，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我就能清楚了解你的想法了。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不好了。",
    "voice": "vo_adv_1122001_019",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這樣可不好啊……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我最近的確",
    "voice": "vo_adv_1122001_020",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n有太過依賴魔法少女的力量的傾向。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "只要我變身成魔法少女後再逮捕犯人，",
    "voice": "vo_adv_1122001_021",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n不曉得為什麼，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "犯人就會老老實實地自己招供呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這打扮很受犯人歡迎，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "應該這麼說嗎？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "而且，",
    "voice": "vo_adv_1122001_022",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這個身體能力。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "就連平常不擅長打鬥的我，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n也能用迷霧之彈反擊襲擊而來的敵人，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "逃走的犯人",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "則是可以用迷霧纏束拘捕。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "然後在事件都順利解決之後，",
    "voice": "vo_adv_1122001_023",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n再擺出招牌姿勢回應小孩子們的歡呼聲。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "粉絲福利可不能少呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這樣啊，",
    "voice": "vo_adv_1122001_024",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n我像這樣重新回顧之後，發現……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "——這樣根本就不是偵探啊！",
    "voice": "vo_adv_1122001_025",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "如果是給兒童看的娛樂作品的話，",
    "voice": "vo_adv_1122001_026",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "或許我還能接受有這種偵探。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "至少",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "現在這樣和我的目標，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "也就是用知識與邏輯來解決事件\\n的偵探",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "相差甚遠啊……！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "好，",
    "voice": "vo_adv_1122001_027",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我決定了！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我要將魔法少女",
    "voice": "vo_adv_1122001_028",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "封印起來！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "你、",
    "voice": "vo_adv_1122001_029",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "你別那麼露骨地露出那種悲傷的表情啊！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "雖然說是封印，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "但並不是我要放棄的意思。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "應該說是我",
    "voice": "vo_adv_1122001_030",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "想再重新審視一下自己的原點吧……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "再說！",
    "voice": "vo_adv_1122001_031",
    "unit_id": 112211
  },
