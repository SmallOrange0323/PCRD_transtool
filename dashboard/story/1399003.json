  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不過──",
    "voice": null,
    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "但踏上階梯後，",
    "voice": "vo_adv_1399003_060",
    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我就要一次跨過３階，一口氣",
