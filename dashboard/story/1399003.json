    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不好意思～！",
    "voice": null,
    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "現在這就是我能做到的極限了。",
