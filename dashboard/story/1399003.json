  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "全都是這個夏天重要的目標……",
    "voice": null,
    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n大人可能會說",
