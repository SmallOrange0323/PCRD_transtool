  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我果然無法放棄……！",
    "voice": null,
    "unit_id": 139912
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n因為我這個時間點的心動，",
