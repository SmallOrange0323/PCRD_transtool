  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "得到了福袋的日和與{0}，\\n一同討論起福袋裡頭裝了些什麼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還有，",
    "voice": "vo_adv_1087003_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個和這個……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "吧？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n選好啦～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個福袋，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然真的非常划算呢……！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剩下的東西再分送給別人吧。",
    "voice": "vo_adv_1087003_001",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要分給平常照顧我的街訪鄰居嘛～？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n還得要",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "分給優衣和怜！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當然騎士先生也有唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_1087003_002",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "買到了這個福袋的人，聽說幾乎大家都是這麼做的。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也有些是就算我拿著也用不到的東西嘛，",
    "voice": "vo_adv_1087003_003",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不如送給那些用得到的人比較好對吧？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "？",
    "voice": "vo_adv_1087003_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n是什麼事呢……？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "喂！",
    "voice": "vo_adv_1087003_005",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "讓開！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "\\n別給我在那晃來晃去的啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "我揍飛你喔！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個人，",
    "voice": "vo_adv_1087003_006",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是怎麼一回事呢……？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "啊啊，",
    "voice": "vo_adv_1087003_007",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳問那傢伙？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "是住在這附近的混混唷。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "因為春節期間的街道上警備森嚴，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n幹不了壞事所以顯得很煩躁的樣子呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "妳們也小心一點啊。",
    "voice": "vo_adv_1087003_008",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "可不要靠那傢伙太近了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好～",
    "voice": "vo_adv_1087003_009",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n……那個人，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就像是想主動找罪受的樣子呢。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "該不會有什麼煩惱的事情嗎……？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "媽媽～！",
    "voice": "vo_adv_1087003_010",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "妳在哪？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "啊，",
    "voice": "vo_adv_1087003_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "對不起，不小心撞到你……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "嘖，",
    "voice": "vo_adv_1087003_012",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "在有人的地方瞎逛亂竄的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "\\n很礙事啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "嗚嗚，",
    "voice": "vo_adv_1087003_013",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "嗚哇呀～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "好可怕呀～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "媽媽～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊啊，",
    "voice": "vo_adv_1087003_014",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哭了……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_1087003_015",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "嘖，",
    "voice": "vo_adv_1087003_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "竟給我大哭起來……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "吶，這位大哥！",
    "voice": "vo_adv_1087003_017",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果無聊到要找人麻煩的話，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不如一起來幫助這孩子吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以的吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "啥？",
    "voice": "vo_adv_1087003_018",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "突然說些什麼東西……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "快點快點！",
    "voice": "vo_adv_1087003_019",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那孩子越哭越大聲了呀！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "啊，",
    "voice": "vo_adv_1087003_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "喂，妳別拖著人走啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "搞什麼鬼啊妳們這些人！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "放開我！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "孩子，",
    "voice": "vo_adv_1087003_021",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你沒事吧？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你怎麼了呢？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是和媽媽走散了嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "那、",
    "voice": "vo_adv_1087003_022",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "那個……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "我……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "有話就快說啊！",
    "voice": "vo_adv_1087003_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "咿呀……",
    "voice": "vo_adv_1087003_024",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "好可怕！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的──！",
    "voice": "vo_adv_1087003_025",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你就不能溫柔點跟人家說話嗎～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "咕嗚……！",
    "voice": "vo_adv_1087003_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "這、",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "這傢伙，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "這什麼怪力……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "……喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "你、",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無禮男子",
    "words": "你怎麼了嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "嗚嗚，",
    "voice": "vo_adv_1087003_027",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "嗚咕……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "和媽媽，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "迷路的少年",
    "words": "不小心走散了。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來是這樣呀。",
    "voice": "vo_adv_1087003_028",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼就讓我們一起幫你來找……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "有了有了！",
    "voice": "vo_adv_1087003_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "喂～日和妹妹！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n現在有空嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是賣章魚燒的大叔！",
    "voice": "vo_adv_1087003_030",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "發生什麼事情了嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不好意思呀，",
    "voice": "vo_adv_1087003_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "材料有一些不夠用了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n不去買些東西來補充不行了呀。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這段期間，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "能幫我顧一下店嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以唷！",
    "voice": "vo_adv_1087003_032",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "做為交換能不能，",
    "voice": "vo_adv_1087003_033",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "把這孩子待在店裡的這件事，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n傳出去告訴更多的人呢？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊啊，",
    "voice": "vo_adv_1087003_034",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "當然沒問題唷。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "暫時就先拿在店後面已經做好",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n用魔法陣保溫的章魚燒來賣就可以了喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那我去去就回！",
    "voice": null,
    "unit_id": 1411
  },
  {
