[
  {
    "type": "background",
    "bg_id": "501430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "衝著{0}而來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "尾狗刀率領的大群魔物，\\n襲擊了獸人族之國‧珊托魯斯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了保護夥伴們，【哞哞自衛隊】與矛依未攔住了那些敵人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嘿、",
    "voice": "vo_adv_2110006_000",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咻──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "background",
    "bg_id": "501430"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗚！",
    "voice": "vo_adv_2110006_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n唔──！！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "快點快點。",
    "voice": "vo_adv_2110006_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n妳好不容易才撿起那把大劍，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不拿來用嗎～？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過～妳用不了吧，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "都露出一堆破綻了～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……可惡！",
    "voice": "vo_adv_2110006_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊～真是的，",
    "voice": "vo_adv_2110006_004",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "完全沒辦法攻進去！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我的動作習慣、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有招數，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "全都在被他看穿了……！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔……",
    "voice": "vo_adv_2110006_005",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……呵呵。",
    "voice": "vo_adv_2110006_006",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……呵呵呵。",
    "voice": "vo_adv_2110006_007",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊哈哈哈哈！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_2110006_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳為什麼發笑？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n真是個怪人～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈！",
    "voice": "vo_adv_2110006_009",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你問我為什麼發笑？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是因為很好笑啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不管你再怎麼裝作忘了我！",
    "voice": "vo_adv_2110006_010",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你還是",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對我",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "非常熟悉！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n像這樣一交手，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就讓我清楚地發現了這點！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "501430"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哎喲……！",
    "voice": "vo_adv_2110006_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看吧，你又閃開了，",
    "voice": "vo_adv_2110006_012",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且閃得如此輕鬆！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過也是啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為你對我的動作",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "了解得非常非──常透徹！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們可是曾並肩作戰，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "配合彼此的步調",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "奮戰過好多次啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "──……",
    "voice": "vo_adv_2110006_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "其實我",
    "voice": "vo_adv_2110006_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "老實說",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也不想跟你交手！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "比起心煩意亂地四處尋找你，",
    "voice": "vo_adv_2110006_015",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n像這樣直接衝突",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在心情上輕鬆多了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是個笨蛋嘛！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯──",
    "voice": "vo_adv_2110006_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這樣啊～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我就放棄",
    "voice": "vo_adv_2110006_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "直接衝突啦。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "大家",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "集合～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "香織、真琴、真步",
    "words": "！？",
    "voice": "vo_adv_2110006_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剩下的魔物",
    "voice": "vo_adv_2110006_019",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "突然集結……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "組成了陣形！？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不只這樣而已！",
    "voice": "vo_adv_2110006_020",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "行動也產生變化──",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "變得會互相合作了！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那位尾狗刀先生，",
    "voice": "vo_adv_2110006_021",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n居然沒用什麼魔力，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就如此",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "自在地",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "操縱著",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "魔物們……！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是啊。",
    "voice": "vo_adv_2110006_022",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為真正的你",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不是什麼王宮騎士，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而是魔物使。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "辦得到這點小事",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是理所當然的……！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "還沒完呢，",
    "voice": "vo_adv_2110006_023",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "才不只這點程度而已喔～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呀啊！",
    "voice": "vo_adv_2110006_024",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n他、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他們的目標是人家！？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那是當然的。",
    "voice": "vo_adv_2110006_025",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n針對治療者攻擊，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "是基礎中的基礎吧～？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主！",
    "voice": "vo_adv_2110006_026",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n請退到我們身後！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不好意思！",
    "voice": "vo_adv_2110006_027",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "包圍戰術與",
    "voice": "vo_adv_2110006_028",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "各個擊破！？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在這種人數差距下使出這些招式，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們光是防禦就很吃力了～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘖！",
    "voice": "vo_adv_2110006_029",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不愧是尾狗刀前輩，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "做事還真狡詐！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "討厭～",
    "voice": "vo_adv_2110006_030",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n要說就說我很聰明啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……應該說，",
    "voice": "vo_adv_2110006_031",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "因為你們來礙事，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n現在讓{0}給逃掉了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
