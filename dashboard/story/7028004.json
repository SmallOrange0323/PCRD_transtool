  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來調查塔的{0}一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n趁著調查告個段落時開始休息……然而。",
