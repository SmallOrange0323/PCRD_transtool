    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊……",
    "voice": "vo_adv_7028004_000",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那個，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "班比？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "已經爬了不少階層，",
    "voice": "vo_adv_7028004_001",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳會不會累？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "差不多來休息一下吧……？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔唔……",
    "voice": "vo_adv_7028004_002",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊、",
    "voice": "vo_adv_7028004_003",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我這是被討厭了嗎～？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀……",
    "voice": "vo_adv_7028004_004",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那是我不好。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "湧起的好奇心和",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對學問的探究心",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n一～直蠢蠢欲動……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對不起，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有在反省了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拉比林斯達，",
    "voice": "vo_adv_7028004_005",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "討厭……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔…………",
    "voice": "vo_adv_7028004_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n……僕從，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "再多用心摸摸班比。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊啊，",
    "voice": "vo_adv_7028004_007",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對不起嘛～！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要怎麼樣才能讓妳消氣呢？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……對了！",
    "voice": "vo_adv_7028004_008",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "等我一下喔！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n大姐姐我給妳準備點好東西！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……好東西？",
    "voice": "vo_adv_7028004_009",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_7028004_010",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "班比一定也會開心的……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "希望啦。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總之就先試試吧！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_7028004_011",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "物件變更！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n叫出指定預設清單……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n順便追加需要的這個跟那個……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "完成！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來，",
    "voice": "vo_adv_7028004_012",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "久等了！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n快閃可麗餅店特別開張囉！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為我跟班比約好，",
    "voice": "vo_adv_7028004_013",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要為她做喜歡的可麗餅啊。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來吧，",
    "voice": "vo_adv_7028004_014",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "班比。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "請點餐！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n作為一直逼問妳的賠禮，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不管什麼我都做給妳吃喔～！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "什麼都可以嗎？",
    "voice": "vo_adv_7028004_015",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當──然！",
    "voice": "vo_adv_7028004_016",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這是菜單，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不過也可以點上頭沒有的",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "特製口味喔！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年也點自己喜歡的口味吧！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇，",
    "voice": "vo_adv_7028004_017",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有好多口味……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要選哪個好呢──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": "vo_adv_7028004_018",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要選哪個才好？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_7028004_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個感覺好好吃──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比也要點一樣的──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也有這種可麗餅啊？",
    "voice": "vo_adv_7028004_020",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "比好像也想吃看看呢！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "魔物可麗餅……？",
    "voice": "vo_adv_7028004_021",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "會是什麼味道啊──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很在意的話，要不要試試？",
    "voice": "vo_adv_7028004_022",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有請少年協助我開發菜單，",
    "voice": "vo_adv_7028004_023",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n那品項意外受歡迎喔！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從有幫忙嗎？",
    "voice": "vo_adv_7028004_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比也吃吃看吧！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": "vo_adv_7028004_025",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓客人久等了！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n兩份特製可麗餅！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這就是可麗餅……",
    "voice": "vo_adv_7028004_026",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦。",
    "voice": "vo_adv_7028004_027",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳第一次吃可麗餅嗎？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那還真是我的光榮♪",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "敬請品嘗，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比開動了……",
    "voice": "vo_adv_7028004_028",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊嗯。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嚼嚼……",
    "voice": "vo_adv_7028004_029",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嚼…………",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如",
    "voice": "vo_adv_7028004_030",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "何？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你的意思是……",
    "voice": "vo_adv_7028004_031",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "超普通──",
    "voice": "vo_adv_7028004_032",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這～樣啊……",
    "voice": "vo_adv_7028004_033",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "豈止不問種族，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n竟然連真祖吸血鬼都這麼評價。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「普通」的牆壁，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好高好厚呢……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "遵守食譜的材料份量，",
    "voice": "vo_adv_7028004_034",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "遵守食譜的烹調時間……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我還用了很好的食材耶。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯──",
    "voice": null,
    "unit_id": 106815
  },
