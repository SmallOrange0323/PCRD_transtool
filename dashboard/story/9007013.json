    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "偉大工作耶！！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "身為哥哥最優秀的妹妹，",
    "voice": "vo_adv_9007013_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "璃乃我！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n一定要幫上哥哥的忙──！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵呵……",
    "voice": "vo_adv_9007013_004",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n璃乃真的處處替哥哥著想呢。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "同樣身為妹妹，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們也應該要向她看齊呢，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "依里。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呃、",
    "voice": "vo_adv_9007013_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啥！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我又沒有",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "把那個傢伙",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "當成是我的哥哥！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是這樣嗎？",
    "voice": "vo_adv_9007013_006",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "難不成……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "妳是把他當成一名異性……？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什麼！？",
    "voice": "vo_adv_9007013_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳那是",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什麼說法！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我明明不是那個意思！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_9007013_008",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n依里真是的……♪",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊嗚嗚嗚……！",
    "voice": "vo_adv_9007013_009",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不要露出一副「不坦率的模樣真可愛♪」的",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "表情啦！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳們兩個",
    "voice": "vo_adv_9007013_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在聊什麼啊──？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "快點快點──！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_9007013_011",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好！",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "現在馬上過去。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚、",
    "voice": "vo_adv_9007013_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚嗚……！",
