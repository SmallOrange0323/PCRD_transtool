  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有一天，璃乃、依里和可璃亞三人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n朝氣十足地走在充滿鄉村氣息的吉歐‧提格尼亞的平原上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "各位──！",
    "voice": "vo_adv_9007013_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "前進速度有點慢哦──！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來吧來吧，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再走得更有精神點──！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呼……",
    "voice": "vo_adv_9007013_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "璃乃",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還真是充滿幹勁呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們明明只是來捉魔物的……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼能說是",
    "voice": "vo_adv_9007013_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「只是」來捉魔物呢！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這可是哥哥指派給我們的",
