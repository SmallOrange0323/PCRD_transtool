    "voice": "vo_adv_9007013_015",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這山丘挺廣的呢。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這種地方會有魔物嗎？",
