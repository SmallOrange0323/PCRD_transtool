[
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "忙著善後【憤怒‧軍團】接二連三襲擊的貪吃佩可，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n會在公務空檔之際，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n到王宮附近偷偷地享受短暫的歇息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_1804001_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "沒有異常，",
    "voice": "vo_adv_1804001_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "嗯。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n回守衛所吧——",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……呼。",
    "voice": "vo_adv_1804001_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總算離開了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "守衛巡邏很嚴謹，",
    "voice": "vo_adv_1804001_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "身為王女應該要感到高興才對，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但是這麼森嚴的話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想躲開守衛耳目也是樁苦差事～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想趕快找個安靜的地方休息呀。",
    "voice": "vo_adv_1804001_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了讓自己合乎王女的舉止，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "整個肩膀都僵硬了呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好想盡情活動身體。",
    "voice": "vo_adv_1804001_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想要去捕獵魔物，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後做成料理，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最後再吃掉……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔！？",
    "voice": "vo_adv_1804001_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n又是守衛嗎！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？　{0}？",
    "voice": "vo_adv_1804001_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太好了～～…………",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你怎麼會出現在這裡！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "有人的聲音……？",
    "voice": "vo_adv_1804001_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "　那裡！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "　有誰在那裡嗎！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇！",
    "voice": "vo_adv_1804001_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　負責守衛的人回來了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快躲起來！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……",
    "voice": "vo_adv_1804001_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "阿囉哈～☆",
    "voice": "vo_adv_1804001_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n好久不見呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能看到你有精神的樣子，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是高興呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是，",
    "voice": "vo_adv_1804001_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你到底為什麼會出現在這裡呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "剛好是我發現你所以才沒事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n沒有許可就闖進王宮，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有可能會被逮捕的哦？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難不成，",
    "voice": "vo_adv_1804001_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你明知有危險但還是要來見我嗎……？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哎呀呀，",
    "voice": "vo_adv_1804001_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來你只是迷路呀……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種情況就算是說謊，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也要回覆「對呀」才可以喔？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過嘛，",
    "voice": "vo_adv_1804001_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "誠實也是很重要，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你果然還是這樣繼續保持下去吧♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣啊。",
    "voice": "vo_adv_1804001_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不知不覺……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這麼說。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那你絕對是迷路了吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……是錯覺嗎？",
    "voice": "vo_adv_1804001_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n等等回到守衛所，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "還是慎重一點請求加派人力吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，已經沒事了，可以出來了唷。",
    "voice": "vo_adv_1804001_018",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": "vo_adv_1804001_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖說沒事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但只要繼續待著，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺就會引起騷動，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然希望你趕快回去，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是要你自己回去應該有些困難吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿和小凱留",
    "voice": "vo_adv_1804001_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也不在附近的樣子……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對了！",
    "voice": "vo_adv_1804001_021",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　等我王女的工作結束後，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就送你回公會小屋吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在那之前可以答應我會機靈一點嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很棒的回答。",
    "voice": "vo_adv_1804001_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了不讓王宮的人發現你，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n去我的房間吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請保持安靜唷。",
    "voice": "vo_adv_1804001_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我有充分掌握巡邏時間",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以應該沒有問題，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但是剛剛守衛說要增派人力呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵，",
    "voice": "vo_adv_1804001_024",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看來有確實答應我要變得機靈呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然沒想到會變成這種情況，",
    "voice": "vo_adv_1804001_025",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不過真高興能見到你。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "獨自一人很寂寞呢。",
    "voice": "vo_adv_1804001_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為王宮的人會很緊張，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以沒辦法邀請大家過來。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不管是王女的工作",
    "voice": "vo_adv_1804001_027",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或是眾多的會議，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要是有益的事我都很樂意執行，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是不規律的吃飯時間讓我很受不了呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "王宮的料理雖然好吃，",
    "voice": "vo_adv_1804001_028",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是還要試毒和講求形式真的很麻煩。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真希望能和你們一起自由自在地",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "享用魔物料理～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開玩笑的，",
    "voice": "vo_adv_1804001_029",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不應該說這些呢。",
    "voice": null,
    "unit_id": 105812
  },
