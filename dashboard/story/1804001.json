    "words": "跟你撒嬌嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開玩笑的，",
    "voice": "vo_adv_1804001_056",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我這樣子可不被允許呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我必須要更加更加努力才行！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以繼續撒嬌也沒關係嗎？",
    "voice": "vo_adv_1804001_057",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼…………",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就稍微撒嬌一下。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "王女的工作固然很重要，",
    "voice": "vo_adv_1804001_058",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也很有做的意義……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是不能和你",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有【美食殿堂】的大家一起生活，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有點寂寞呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還想",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再和大家一起邊走邊吃……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………",
    "voice": "vo_adv_1804001_059",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的，",
    "voice": "vo_adv_1804001_060",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我結束撒嬌了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "若再繼續說喪氣話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是會被小凱留罵的！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果大家來幫忙我的話。",
    "voice": "vo_adv_1804001_061",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n各種事務好像都能很快解決呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且有時間的話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還可以盡情邊走邊吃！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你應該知道我的食慾很厲害吧。",
    "voice": "vo_adv_1804001_062",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果是為了食物，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可是會非常非常麻煩大家哦？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是……",
    "voice": "vo_adv_1804001_063",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不行。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我自己一個人可以做到的事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有很多呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "必須要把那些事一個一個地解決，",
    "voice": "vo_adv_1804001_064",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n直到我遇到無法獨自解決的問題時，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n到時候…………",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就會順從",
    "voice": "vo_adv_1804001_065",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的好意，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請大家幫很多很多的忙。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後，",
    "voice": "vo_adv_1804001_066",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們解決問題之後，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家再一起享用美味的魔物料理吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "失禮了。",
    "voice": "vo_adv_1804001_067",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "\\n我來幫您打掃了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "那個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "咦？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_1804001_068",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}快躲起來……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "………………",
    "voice": "vo_adv_1804001_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": "vo_adv_1804001_070",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "被發現了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}他\\n什麼壞事都沒有做唷，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以不要逮捕他……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "尤絲蒂亞娜大人。",
    "voice": "vo_adv_1804001_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "\\n我明白您正值花樣年華，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "\\n但身為王女，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "男女單獨二人共處一室，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "實在是不太好唷。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………咦？",
    "voice": "vo_adv_1804001_072",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "但向上面報告",
    "voice": "vo_adv_1804001_073",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "情況變得麻煩就不好了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "\\n我會當作什麼都沒看見，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "請兩位多聊一下吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "\\n但請不要過頭了唷。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非、",
    "voice": "vo_adv_1804001_074",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝妳……？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "那麼，",
    "voice": "vo_adv_1804001_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "僕人長",
    "words": "先去打掃其他地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "走掉了……",
    "voice": "vo_adv_1804001_076",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n沒、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒想到",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們會被那樣看待呢，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但看起來真的是那樣呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦，",
    "voice": "vo_adv_1804001_077",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n現在對你來說還有點太早了呢……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是，",
    "voice": "vo_adv_1804001_078",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們好像還可以多聊一下呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n能再多陪我一下嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們",
    "voice": "vo_adv_1804001_079",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再多聊一會兒",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再回去吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可表面雖維持平靜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但雙耳早已染得通紅。",
    "voice": null,
