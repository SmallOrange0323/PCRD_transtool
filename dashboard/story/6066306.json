[
  {
    "type": "background",
    "bg_id": "501060"
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "まさか",
    "voice": "vo_adv_6044306_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "彦星が女子に手を出しまくっているとはな……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "何か擁護できる点が",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "少しくらいはあると思っていたが",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "あまりにも酷すぎて",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "逆に驚いてしまったぞ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "うむ、",
    "voice": "vo_adv_6044306_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "あのスケベな視線を思い出すと",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "今でも寒気が……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "あの姿を見て確信した。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "彦星は懲らしめねばならん！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "なんとしても",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "我らで織姫を救い出すぞ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "よいなシグルド！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もし好きだと言い張るなら、",
    "voice": "vo_adv_6044306_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私には到底信じられんな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "本当に好きな相手が悲しんでいるのなら",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "気遣って当然であろう？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もし私が同じ立場なら、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "決してそんなことはしないぞ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "確かに、",
    "voice": "vo_adv_6044306_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドは女子の知り合いが多いな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドは彦星みたいに",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "変なことをしていないのだろう？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……うむ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "いい返事だ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もちろん初めから",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "信じていたがな。",
    "voice": null,
    "unit_id": 113211
  }
]
