  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人終於打倒了黑之王。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n將黑暗從這個世界驅逐出去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你們看！",
    "voice": "vo_adv_5042007_000",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n景色慢慢恢復原狀了！！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對、",
    "voice": "vo_adv_5042007_001",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對對對、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對呀！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我們",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "成功了……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是真的！",
    "voice": "vo_adv_5042007_002",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "拯救了這個世界！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對吧？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳說得沒錯。",
    "voice": "vo_adv_5042007_003",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n你們幾個，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "幹得漂亮。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼，",
    "voice": "vo_adv_5042007_004",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "本小姐出馬，這也是理所當然的！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_5042007_005",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大家都辛苦了～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n拉格也辛苦了♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "拉格",
    "words": "嘎喔♪",
    "voice": "vo_adv_5042007_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "接～",
    "voice": "vo_adv_5042007_007",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "下來，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們只要找到回去原來的世界的方法就好了！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對、",
    "voice": "vo_adv_5042007_008",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對耶！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "找起來",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "會很辛苦嗎……？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家一起找",
    "voice": "vo_adv_5042007_009",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就沒問題的啦～♪",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……沒有那個必要。",
    "voice": "vo_adv_5042007_010",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲……？",
    "voice": "vo_adv_5042007_011",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n哇！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這、",
    "voice": "vo_adv_5042007_012",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是怎麼回事！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n四、",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "四周突然開始發光了！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這個世界……",
    "voice": "vo_adv_5042007_013",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不對，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這本「書」，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n正在恢復成原來的模樣。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃等人",
    "words": "什麼……？",
    "voice": "vo_adv_5042007_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "在黑之王消失之後……",
    "voice": "vo_adv_5042007_015",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我總算明白這一切了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這個世界……",
    "voice": "vo_adv_5042007_016",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這本書裡",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n寄宿著讀者形形色色的情感。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "許許多多的情感積累下來，",
    "voice": "vo_adv_5042007_017",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "形成了酷似魔力的力量。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n而這股力量",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "在偶然間將你們拉進了這裡。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……不對，",
    "voice": "vo_adv_5042007_018",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這不是偶然。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我一定是……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我想向妳傳達一件事。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "一點點的勇氣",
    "voice": "vo_adv_5042007_019",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "就能夠改變世界。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "然後，妳的冒險",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "會永遠持續下去。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……不過，",
    "voice": "vo_adv_5042007_020",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這個世界裡的冒險",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "就到此結束了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你們不是故事裡的登場人物，",
    "voice": "vo_adv_5042007_021",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n所以會被彈出這個世界……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們要在這裡",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "暫時分別了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不過，",
    "voice": "vo_adv_5042007_022",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不需要因此難過。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "因為這是一個",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "圓滿的結局呀。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_5042007_023",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "怎麼了？",
    "voice": "vo_adv_5042007_024",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n妳又露出我們剛相遇時的",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那副鬱悶表情了喔？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………我不要。",
    "voice": "vo_adv_5042007_025",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "至少讓我……",
    "voice": "vo_adv_5042007_026",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "好好道個別吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我說不要，就是不要！",
    "voice": "vo_adv_5042007_027",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我絕對不會和愛麗絲妳道別的！",
    "voice": "vo_adv_5042007_028",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不是好朋友嗎！！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "無論發生什麼事，",
    "voice": "vo_adv_5042007_029",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我都不會離開愛麗絲的！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n只要妳不從我身上離開，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳就不會消失了，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對吧！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "still",
    "still_id": "504200701"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦…………",
    "voice": "vo_adv_5042007_030",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "真是的……",
    "voice": "vo_adv_5042007_031",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳怎麼講不聽呀。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我都說了只是「暫時分別」呀！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲，妳等一下！",
    "voice": "vo_adv_5042007_032",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我還有好多話想跟妳說！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n還有好多事想跟妳一起做……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還有好多……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好多……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳就一直待在我身邊嘛……",
    "voice": "vo_adv_5042007_033",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不是一心同體的嗎……？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……別擔心。",
    "voice": "vo_adv_5042007_034",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們很快就會再見面的。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "因為",
    "voice": "vo_adv_5042007_035",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我一直都在",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "書中的世界裡嘛。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳隨時都可以來見我喔？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
