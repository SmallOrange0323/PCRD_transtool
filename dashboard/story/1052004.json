[
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？\\n唷呼～♪",
    "voice": "vo_adv_1052004_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘻嘻，\\n歡迎來到【伊麗莎白牧場】♪",
    "voice": "vo_adv_1052004_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你又在做運送郵件的工作嗎？",
    "voice": "vo_adv_1052004_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊～\\n總是這麼努力工作，真了不起呢。",
    "voice": "vo_adv_1052004_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是個好孩子～♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然人家也想幫忙，\\n不過魔物討伐隊還在附近徘徊……",
    "voice": "vo_adv_1052004_004",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家都交代我\\n最近不能出去外頭。",
    "voice": "vo_adv_1052004_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過要像小鈴一樣二十四小時都窩在房裡，\\n人家",
    "voice": "vo_adv_1052004_006",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是會窒息的……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我偶爾會看準討伐隊的人們不在的時機\\n到外頭散散步。",
    "voice": "vo_adv_1052004_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過討伐隊的人們也不是很閒，\\n",
    "voice": "vo_adv_1052004_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "應該過幾天就會離開了吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在那之前只能好好忍耐，\\n",
    "voice": "vo_adv_1052004_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "乖乖躲著",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘻嘻。\\n靜待好事自然來。",
    "voice": "vo_adv_1052004_010",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這幾天應該就會平穩下來了～♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……嗯嗯？\\n你說對不起？",
    "voice": "vo_adv_1052004_011",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你為",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "什麼要道歉呢？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算和你同樣是人類的其他人做了過分的事，\\n也都不是你的錯哦？",
    "voice": "vo_adv_1052004_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒關係啦。\\n",
    "voice": "vo_adv_1052004_013",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我已經習慣",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這種事了。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "寄宿在牧場裡的這段期間\\n過得太平靜，所以就忘記了……",
    "voice": "vo_adv_1052004_014",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "從前總是被當成魔物對待，\\n被四處追趕是日常常見的光景。",
    "voice": "vo_adv_1052004_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只不過是稍微回到從前的樣子，\\n",
    "voice": "vo_adv_1052004_016",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "未來也還充滿希望和和平……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要還這麼相信著，我就沒事哦。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以請不要擺出那種表情唷♪",
    "voice": "vo_adv_1052004_017",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呀，好刺眼！",
    "voice": "vo_adv_1052004_018",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那是怎麼回事？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n有什麼在發光……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
