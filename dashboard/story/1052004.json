    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪、",
    "voice": "vo_adv_1052004_020",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪？",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（咦，難道說人家迷路了嗎？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪～，",
    "voice": "vo_adv_1052004_021",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪",
