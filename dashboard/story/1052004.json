    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "？",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（這裡是哪裡？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪！莉瑪莉瑪，莉瑪？",
    "voice": "vo_adv_1052004_022",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（啊！",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n在那裡走動的是？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪～！",
    "voice": "vo_adv_1052004_023",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（{0}～！）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪莉瑪？",
    "voice": "vo_adv_1052004_024",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（咦，為什麼要逃跑呢？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪～？\\n（你忘記人家了嗎～？）",
    "voice": "vo_adv_1052004_025",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，",
    "voice": "vo_adv_1052004_026",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪！莉瑪，莉瑪莉瑪",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "？",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（對對，就是我！",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是莉瑪，不可以忘記哦？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪……莉瑪莉瑪♪",
    "voice": "vo_adv_1052004_027",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（嗯，嘻嘻……你好♪）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，",
    "voice": "vo_adv_1052004_028",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪？莉瑪",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "？",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（你在這裡做什麼呢？散步？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，莉瑪莉瑪。",
    "voice": "vo_adv_1052004_029",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（我也在散步，",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不過迷路了。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，",
    "voice": "vo_adv_1052004_030",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪。",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（因為天氣很好，",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n走著走著太開心就迷路了。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪莉瑪～♪",
    "voice": "vo_adv_1052004_031",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（一回過神來，就到城鎮裡頭了～♪）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，莉瑪……",
    "voice": "vo_adv_1052004_032",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（不過要是不快點回家……）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪～。",
    "voice": "vo_adv_1052004_033",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（別人會以為我逃走了，",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n之後就不會再讓我外出了呢。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪莉瑪。",
    "voice": "vo_adv_1052004_034",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（所以想快點回去。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，",
    "voice": "vo_adv_1052004_035",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪～？",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（你知道我回家的路嗎？）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…………",
    "voice": "vo_adv_1052004_036",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪。莉瑪莉瑪～……",
    "voice": "vo_adv_1052004_037",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（嗚嗚。",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n好像聽不懂我的話，雖然這是理所當然的。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪。",
    "voice": "vo_adv_1052004_038",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪～",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（沒有辦法呢，",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n畢竟我們的種族不一樣。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了。",
    "voice": "vo_adv_1052004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1052004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想你醒來以後，很快就會忘記的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在城鎮裡突然與動物相遇～\\n這非常有夢的感覺呢……",
    "voice": "vo_adv_1052004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想你也\\n很快就會發現是夢了才對。\\n",
    "voice": "vo_adv_1052004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……應該不會吧♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正啊～",
    "voice": "vo_adv_1052004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想今後你也會做好幾次類似的夢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，\\n你要多和莉瑪說說話哦。",
    "voice": "vo_adv_1052004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就像你剛才夢到的場景……\\n那孩子在『那邊』，",
    "voice": "vo_adv_1052004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n基本上只能說出莉瑪莉瑪～之類的話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以你們無法對話",
    "voice": "vo_adv_1052004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "，\\n基本上只能單方面地說話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，在『這邊』卻辦得到。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們的相遇，\\n就像是繪本般的奇蹟……",
    "voice": "vo_adv_1052004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要好好珍惜、好好和睦相處哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然種族相異，\\n是非常難以跨越的藩籬。",
    "voice": "vo_adv_1052004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在歷史上，\\n也因此發生過幾次悲劇。",
    "voice": "vo_adv_1052004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正因為如此，\\n",
    "voice": "vo_adv_1052004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們才更要……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是這麼認為的哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果是引發許多奇蹟的你，\\n就能辦到。",
    "voice": "vo_adv_1052004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "替你加油的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，\\n這次我就先失陪了。",
    "voice": "vo_adv_1052004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n掰掰",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "～下次見囉♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}～……？",
    "voice": "vo_adv_1052004_053",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "怎麼了嗎？\\n突然就發起呆來？",
    "voice": "vo_adv_1052004_054",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然是工作過頭，\\n太累了是不是？",
    "voice": "vo_adv_1052004_055",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是沒有急事，\\n",
    "voice": "vo_adv_1052004_056",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就在【伊麗莎白牧場】好好休息吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家會好好款待你～♪",
    "voice": "vo_adv_1052004_057",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n會請你吃好多好多",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n點心還有茶。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯。\\n隨時都非常歡迎你來唷。",
    "voice": "vo_adv_1052004_058",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然牧場在山上，\\n來這裡會有些辛苦。",
    "voice": "vo_adv_1052004_059",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "偶爾不要為了工作，來這裡玩玩吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為，\\n有一陣子不能見到你……",
    "voice": "vo_adv_1052004_060",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n人家非常寂寞哦。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯？\\n咦，你說什麼？",
    "voice": "vo_adv_1052004_061",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n莉瑪莉瑪～……是？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是在叫我？\\n真陽她，",
    "voice": "vo_adv_1052004_062",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是會叫我莉瑪莉瑪啦……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等等，停下來啦？",
    "voice": "vo_adv_1052004_063",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不要連續莉瑪莉瑪～莉瑪莉瑪～地叫好嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然不懂怎麼回事，\\n不過讓人家非常不安……！",
    "voice": "vo_adv_1052004_064",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唔、",
    "voice": "vo_adv_1052004_065",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n謝謝",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你停下來。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你是怎麼了……\\n總感覺你像是睡迷糊了一樣？",
    "voice": "vo_adv_1052004_066",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "難道說，\\n你剛才也站著睡著了嗎？",
    "voice": "vo_adv_1052004_067",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唔，\\n好像夢見了不可思議的夢？",
    "voice": "vo_adv_1052004_068",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是什麼樣的夢？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？在夢裡見到我？",
    "voice": "vo_adv_1052004_069",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊、啊……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這麼在意人家，\\n在意到連在夢裡也會見到我是吧？",
    "voice": "vo_adv_1052004_070",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "總覺得很開心……",
    "voice": "vo_adv_1052004_071",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n嘻嘻♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我偶爾\\n也會做夢。",
    "voice": "vo_adv_1052004_072",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "早上起床，發現自己變成普通的人類女孩……",
    "voice": "vo_adv_1052004_073",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就像隨處可見的女孩一樣，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n歌頌著極為平凡的幸福日常。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，夢終究只是夢。",
    "voice": "vo_adv_1052004_074",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以夢醒了，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就會感到有點寂寞……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我就只能扮演好自己",
    "voice": "vo_adv_1052004_075",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "，\\n在這個現實裡好好活下去。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "偶爾做做夢，\\n也不錯對吧……♪",
    "voice": "vo_adv_1052004_076",
    "unit_id": 105211
  }
]
