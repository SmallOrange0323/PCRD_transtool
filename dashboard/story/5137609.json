  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "不思議な結晶に触れ、様々な思い出を感じたムイミ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "これで……",
    "voice": "vo_adv_5111609_000",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "全部か。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "思い出が次から次に浮かび上がってきて……",
    "voice": "vo_adv_5111609_001",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ははっ……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "すごく、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なつかしいな……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "きついこともあったけど……",
    "voice": "vo_adv_5111609_002",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "楽しかったな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nどれだけ思い返しても、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "楽しい気分になる。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でも……",
    "voice": "vo_adv_5111609_003",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "その思い出の中で、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n立ち止まってるわけにはいかないんだ。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "これからアタシを待つ未来がどんなものだって、",
    "voice": "vo_adv_5111609_004",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n逃げたりしない。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシは進むぞ。",
    "voice": "vo_adv_5111609_005",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nこの楽しかった思い出を超える未来を、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "作るために。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "さぁ、",
    "voice": "vo_adv_5111609_006",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "起きろアタシ！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nのんびり寝てたら、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オクトーに笑われちゃうぞ……！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "background",
    "bg_id": "501322"
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……ん……",
    "voice": "vo_adv_5111609_007",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ああ……",
    "voice": "vo_adv_5111609_008",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なんだ、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オマエか。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "心配してくれたのか？　",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "へへ、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ありがとな！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でも、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "全然大丈夫。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "──アタシは",
    "voice": "vo_adv_5111609_009",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "絶好調だ！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "未来で新しい思い出を作るという意思を携え、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nムイミは迷いなく進むのであった。",
    "voice": null,
    "unit_id": null
  }
]
