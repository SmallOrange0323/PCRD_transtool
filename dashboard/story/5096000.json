    "type": "dialogue",
    "name": "日和",
    "words": "小隊",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就用這個！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "幾位是破曉小隊呀。",
