    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "希望能抽中呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不好意思～！",
    "voice": "vo_adv_5096000_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n剛剛",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我在餐廳領到了抽獎券，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n請問這是抽什麼的？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "目前這裡正在進行的是，",
    "voice": "vo_adv_5096000_029",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n在南島舉辦的",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "「沙灘遊戲大賽」招待券抽獎！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和一行人",
    "words": "沙灘遊戲大賽？",
    "voice": "vo_adv_5096000_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "是的！",
    "voice": "vo_adv_5096000_031",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "比賽將由四人為一組的小隊，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n挑戰在沙灘上舉行的各種遊戲！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "中獎的人都可以",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "參加大賽！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "這場大賽固定於每年夏天舉辦，",
    "voice": "vo_adv_5096000_032",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "主辦單位將會",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "請參加者們到南島旅行，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n於比賽期間，住在島上的度假村裡！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "即使在大賽中沒拿下好成績，",
    "voice": "vo_adv_5096000_033",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "直到回去之前，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n都可以在島上享受度假樂趣喔！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "除了玩遊戲，",
    "voice": "vo_adv_5096000_034",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還附帶度假嗎！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請問遊戲內容",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是什麼呢？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "由於每年的內容不同，",
    "voice": "vo_adv_5096000_035",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n我也不清楚今年",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "會玩什麼遊戲，不過……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "以前辦過",
    "voice": "vo_adv_5096000_036",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "沙灘棒球全壘打比賽、",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "沙灘足球賽……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "另外，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n還舉行過在炎熱沙灘上互相鬥智的",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "沙灘益智問答挑戰等等。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "內容聽起來很有挑戰價值呢。",
    "voice": "vo_adv_5096000_037",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "如何呢，",
    "voice": "vo_adv_5096000_038",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n各位有興趣抽獎嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有有有──！",
    "voice": "vo_adv_5096000_039",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
