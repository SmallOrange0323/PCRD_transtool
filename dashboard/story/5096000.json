    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和一行人",
    "words": "喔？",
    "voice": "vo_adv_5096000_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "恭喜妳〜！！",
    "voice": "vo_adv_5096000_050",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n抽中了招待券～！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_5096000_051",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "…",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "…好耶──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我做到了，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣！",
