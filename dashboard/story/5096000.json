    "type": "dialogue",
    "name": "店員",
    "words": "請收下這張抽獎券。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n只要交給那位男性，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "就可以抽獎一次。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──要不要抽獎呢～？",
    "voice": "vo_adv_5096000_024",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只要有抽獎券，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "任何人都有機會！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只要轉動這台抽獎機就可以了～！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_5096000_025",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們拿去用了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抽獎內容是什麼呢？",
    "voice": "vo_adv_5096000_026",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抽中頭獎",
