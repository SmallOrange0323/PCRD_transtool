  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那一天，{0}受到【破曉之星】的三人邀請，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n去協助她們處理委託。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": "vo_adv_5096000_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你今天來幫忙！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "多虧了你，處理起來非常輕鬆呢～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "非常輕鬆……",
    "voice": "vo_adv_5096000_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是我的錯覺，那很抱歉，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但也發生了相當驚險的場面吧？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……有、",
    "voice": "vo_adv_5096000_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有嗎……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣。",
    "voice": "vo_adv_5096000_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n幫日和回想起當時的狀況吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想想，",
    "voice": "vo_adv_5096000_004",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當時",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "走在前面的日和，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n中了藤蔓陷阱",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "差點摔跤，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "然後……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗚哇啊啊啊～！",
    "voice": "vo_adv_5096000_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對不起──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我沒有忘記，所以饒了我吧～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "非常非常辛苦的──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的……",
    "voice": "vo_adv_5096000_006",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "脫離危機的過程",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確很輕鬆。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為有騎士先生",
    "voice": "vo_adv_5096000_007",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "強化日和，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我和怜",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只要對周圍保持警戒",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就行了。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對呀對呀！",
    "voice": "vo_adv_5096000_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n從那之後",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就一口氣",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "轟轟烈烈地",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "扭轉戰況了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "狀態萬全時的我們可不會輸。",
    "voice": "vo_adv_5096000_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是說呀！",
    "voice": "vo_adv_5096000_010",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n只要結局好",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就一切都好……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這麼說吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和。",
    "voice": "vo_adv_5096000_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果他不在場，情況就危險了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別認為事情總是會像那樣順利。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "懂了嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣嗎……",
    "voice": "vo_adv_5096000_012",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會小心的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為今天",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有騎士先生同行，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我總覺得很開心……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "意思是說妳當時開心過頭了是吧。",
    "voice": "vo_adv_5096000_013",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就沒辦法了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也不會再多說什麼了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎？",
    "voice": "vo_adv_5096000_014",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好耶～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜妳也……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為我也",
    "voice": "vo_adv_5096000_015",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒發現陷阱，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們當時似乎都一樣",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "開心過頭了呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生也是嗎？",
    "voice": "vo_adv_5096000_016",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來大家都是這樣……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很開心吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。",
    "voice": "vo_adv_5096000_017",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能夠再次像這樣冒險真好。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n下次",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我會在接到看起來不會遇到陷阱的委託時邀請你的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！？",
    "voice": "vo_adv_5096000_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳果然在生氣～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵呵。",
    "voice": "vo_adv_5096000_019",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n別捉弄日和了。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_5096000_020",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就到此為止吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們向管理協會報告完畢後，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n去吃午餐吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的～！",
    "voice": "vo_adv_5096000_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜好壞心眼～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你也說說她啊──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與前往管理協會報告委託結果的日和一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在鬧區愉快地用了餐──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝招待！",
    "voice": "vo_adv_5096000_022",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "下次請再度光臨。",
    "voice": "vo_adv_5096000_023",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "對了，客人，",
    "voice": null,
    "unit_id": null
  },
