    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對這種事情",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒什麼自信……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "拜託妳了，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這種事是看運氣的。",
    "voice": "vo_adv_5096000_045",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
