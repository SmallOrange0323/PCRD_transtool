    "words": "我有興趣──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "大家一起玩遊戲感覺也滿有意思的……",
    "voice": "vo_adv_5096000_040",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
