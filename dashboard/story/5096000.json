  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真不錯。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "那麼請派一位代表，",
    "voice": "vo_adv_5096000_042",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "轉動這台抽獎機。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n請注意，",
