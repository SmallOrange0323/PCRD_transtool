    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過既然這樣，",
    "voice": "vo_adv_1228004_079",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那哥哥就要乖乖聽禊的命令～！",
