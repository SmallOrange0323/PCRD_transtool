    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "其實啊，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的命令一開始就決定好了～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊呀，",
    "voice": "vo_adv_1228004_080",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "覺得今天跟哥哥玩一整天真的很開心！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "所以，禊希望不管是明年的夏天，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "還是以後的夏天，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥都可以一直陪禊玩～！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好耶──！",
    "voice": "vo_adv_1228004_081",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥要一直～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "當禊的哥哥喔！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "將今天與{0}一同度過的愉快回憶銘記於心，",
