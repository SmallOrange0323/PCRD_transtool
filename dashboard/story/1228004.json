    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊從途中就只盯著自己的仙女棒看，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n完全沒注意到。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥明明只要不講就贏了。",
    "voice": "vo_adv_1228004_078",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥你真的是很老實耶～",
