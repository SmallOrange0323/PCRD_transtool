    "type": "dialogue",
    "name": "禊",
    "words": "不可以強人所難！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那",
    "voice": "vo_adv_1228004_057",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們就聽口令一起點火喔。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "…………點火。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……點著了！",
    "voice": "vo_adv_1228004_058",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n好～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一定要贏！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你看你看，",
    "voice": "vo_adv_1228004_059",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的仙女棒，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n燒得很旺很帥吧～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1228004_060",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對喔！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那燒慢點～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n火啊，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "燒慢點～",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "…………",
    "voice": "vo_adv_1228004_061",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "很漂亮呢──",
    "voice": "vo_adv_1228004_062",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊原本",
    "voice": "vo_adv_1228004_063",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "喜歡又大又華麗的煙火，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n但現在也喜歡上仙女棒了。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "雖然很小，",
    "voice": "vo_adv_1228004_064",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但一點、",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一點地",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "燃燒發光，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不知不覺讓人想一直看下去～",
