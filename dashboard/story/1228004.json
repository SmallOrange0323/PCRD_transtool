    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……啊，",
    "voice": "vo_adv_1228004_065",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "大概只剩一半就要沒了。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……真希望仙女棒跟暑假，",
    "voice": "vo_adv_1228004_066",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "都永遠不會結束。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊想要一直放暑假！",
