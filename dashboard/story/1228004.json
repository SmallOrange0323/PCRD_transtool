    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一直跟哥哥玩了。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……一直，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一直玩下去。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥也想這樣吧？",
    "voice": "vo_adv_1228004_068",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦……",
    "voice": "vo_adv_1228004_069",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那可不行！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "因為禊",
    "voice": "vo_adv_1228004_070",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "長大之後要當探險家……！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "剛剛的當禊沒說～！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1228004_071",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "聊著聊著，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n已經仙女棒快熄了……！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……哇……",
    "voice": "vo_adv_1228004_072",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "…………",
    "voice": "vo_adv_1228004_073",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
