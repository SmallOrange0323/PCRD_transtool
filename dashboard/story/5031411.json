  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位，",
    "voice": "vo_adv_5031411_000",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "競速賽也快要到尾聲了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個競速賽大家賭上了各自的信念，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "十分的白熱化。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在有點令人依依不捨呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被逼著穿和服參加競速賽，",
    "voice": "vo_adv_5031411_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都快累死了……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一想到這個蠢比賽終於要結束了，感覺就很痛快。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是的，",
    "voice": "vo_adv_5031411_002",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳又說那麼壞心眼的話了～",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "拚命跑著的小凱留的表情，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有最後一起大喊的畫面，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我都會當成重要的回憶，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好好珍藏在心裡的！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵、",
    "voice": "vo_adv_5031411_003",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵死了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　把那種回憶給我扔了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_5031411_004",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼鈴莓小姐，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳身為競賽的主角，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請在最後向大家",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說句話吧。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸！",
    "voice": "vo_adv_5031411_005",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　我、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我嗎！？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　欸，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "各、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "各位！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　請到最後都不要掉以輕心，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一起好好享受競速散拔！？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚、嗚哇哇哇！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　我在最後的最後搞砸了！",
    "voice": null,
    "unit_id": 112111
  }
]
