    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n謝。",
    "voice": null,
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "另外兩人也是。",
    "voice": "vo_adv_5217323_002",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "最近的年輕人",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "可真不得了呢……",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "雖然我也不打算就此敗給妳們。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……畢竟在走到今天這一步以前，",
    "voice": "vo_adv_5217323_003",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也是經歷了許多事……",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這是飽經風霜",
