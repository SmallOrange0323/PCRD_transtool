  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "該說不愧是",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "阿澤爾德的女兒嗎。",
