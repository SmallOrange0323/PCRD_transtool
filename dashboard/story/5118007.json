    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]感覺放心多了！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]蘭德索爾啊……",
