[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]在鍊金術師的宅邸激戰的幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n[FFFFFFFF]{0}等人離開智慧森林，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n[FFFFFFFF]在蘭德索爾附近稍作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嗯～！",
    "voice": "vo_adv_5118007_000",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n[FFFFFFFF]來到這一帶，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]就有回到蘭德索爾的感覺呢～",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是這樣嗎？",
    "voice": "vo_adv_5118007_001",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我還無法區分呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]真想快點習慣這裡，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]體會跟妳同樣的感受啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]碧卡拉沒問題的！",
    "voice": "vo_adv_5118007_002",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]之後在蘭德索爾自在地生活，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]很快就會習慣喔！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哈哈！",
    "voice": "vo_adv_5118007_003",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n[FFFFFFFF]對這裡的所有人來說，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]蘭德索爾果然是烏～托邦呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]烏～托邦？",
    "voice": "vo_adv_5118007_004",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]大家，",
    "voice": "vo_adv_5118007_005",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]茶泡好了喔～",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]來，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]請喝。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]謝謝妳！",
    "voice": "vo_adv_5118007_006",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]茶很燙，請小心。",
    "voice": "vo_adv_5118007_007",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]話說，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]你們在聊什麼呢？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呼～",
    "voice": "vo_adv_5118007_008",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呼～",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呼～",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]啊，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我們在聊烏～托邦……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]唔，好燙！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]話說回來……",
    "voice": "vo_adv_5118007_009",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n[FFFFFFFF]吉塔，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]幸好劍有找回來呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那是妳愛用的劍吧？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嗯！",
    "voice": "vo_adv_5118007_010",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n[FFFFFFFF]有拿回來讓我鬆了一口氣。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]是、",
    "voice": "vo_adv_5118007_011",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]是嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嘿嘿嘿……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我是很高興，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]但我不能帶走那把法杖啊。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]畢竟那是莫夫收集的贓物之一呢。",
    "voice": "vo_adv_5118007_012",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]沒想到會在宅邸裡發現山積的贓物呢。",
    "voice": "vo_adv_5118007_013",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]也因此無法視而不見，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n[FFFFFFFF]結果害我們得來收拾殘局，不過……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]【王宮騎士團】正在相對較近的地區",
    "voice": "vo_adv_5118007_014",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]遠征，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n[FFFFFFFF]算是不幸中的大幸呢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]羈押工作交接也進行得很順利。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不只是因為幸運喔。",
    "voice": "vo_adv_5118007_015",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]要是沒有花凜在，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]肯定會花上更多時間呀。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]替莫夫急救的人也是花凜小姐呢。",
    "voice": "vo_adv_5118007_016",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n[FFFFFFFF]技術完美到",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]跟【王宮騎士團】一起來的醫生",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]都非常訝異……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]花凜果然是萬事通呢。",
    "voice": "vo_adv_5118007_017",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n[FFFFFFFF]真的很厲害喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]替人急救也是",
    "voice": "vo_adv_5118007_018",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]我的工作之一。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]更何況……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n[FFFFFFFF]莫夫的傷勢也很輕呀。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯，",
    "voice": "vo_adv_5118007_019",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]他真是有夠耐打呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]直接被那種威力的攻擊打到，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]竟然還能保有一命……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不對，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]厲害的是他的魔導具吧。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]不過，",
    "voice": "vo_adv_5118007_020",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]幸好他還活著。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]只要還活著，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]相信也有可能會改變想法。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]既然莫夫執著於知識，",
    "voice": "vo_adv_5118007_021",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]那就很有可能呢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]實際上，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]他鍊金術師的實力是貨真價實的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]畢竟他解讀過去的鍊金術師遺留的資料，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]理解了全部。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]只要沒走錯路，",
    "voice": "vo_adv_5118007_022",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]他或許就能對人類做出貢獻，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是嗎。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]總之，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]只能祈禱他從煩惱中獲得解放了呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]這麼說來……",
    "voice": "vo_adv_5118007_023",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n[FFFFFFFF]吉塔小姐，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]飛空艇的事已經釋懷了嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]啊哈哈，",
    "voice": "vo_adv_5118007_024",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]勉強啦。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n[FFFFFFFF]畢竟那是事件的證據，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我不能帶走啊。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]會被【王宮騎士團】的人罵的。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]而且……",
    "voice": "vo_adv_5118007_025",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n[FFFFFFFF]害飛空艇變成那樣子……",
    "voice": null,
    "unit_id": 105712
  },
  {
