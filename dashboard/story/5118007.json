    "words": "[FFFFFFFF]妳這女孩真是……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這種事還用問嗎！",
