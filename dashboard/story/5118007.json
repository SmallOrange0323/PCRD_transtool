    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這樣啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n[FFFFFFFF]那我就當作像是搭上大船放好幾百個心啦！",
