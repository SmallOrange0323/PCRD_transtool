    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]謝謝你們！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嘿嘿，",
