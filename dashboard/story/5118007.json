    "words": "[FFFFFFFF]──！",
    "voice": null,
    "unit_id": 9711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]我也很樂意！",
    "voice": "vo_adv_5118007_055",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]只要能提早聯絡，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "[FFFFFFFF]我會做好比這次更充足的準備喔。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]大家……",
