[
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "今回のアタシは、",
    "voice": "vo_adv_6044108_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "なんか先走っちまって",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "よくなかったね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アンナやナナカがいてくれて",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "本当に助かったよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "誰かに頼ったり任せることも、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "必要だって",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "忘れちまってたね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "はは、",
    "voice": "vo_adv_6044108_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さんには",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "いつも頼らせてもらってるよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そんな風に心配する必要は無いから",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "安心しとくれ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "……ありがとさん。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ああ、",
    "voice": "vo_adv_6044108_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そうだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "いつもバカなことばっかりしてると思ってたけど",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\nいざって時にはやってくれる仲間だってこと、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "頭から抜けてたよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "もうちょい普段からしっかりしてくれると",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "うれしいんだけどね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシは一人旅が長かったから、",
    "voice": "vo_adv_6044108_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "一人で動くのが癖になってたんだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n巻き込まれた形とはいえ、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ギルドの仲間ができたんだからね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "少しずつ癖が抜けるように、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "意識を変えていくつもりだよ。",
    "voice": null,
    "unit_id": 113111
  }
]
