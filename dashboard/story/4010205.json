  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～☆",
    "voice": "vo_adv_4010205_000",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好巧喔學長，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你在做什麼？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "今天去上英文會話課程了。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "現在剛結束，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "如果你堅持的話，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我也可以跟你一起回去──",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──啊！",
    "voice": "vo_adv_4010205_001",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "難道說！？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n其實你",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "知道今天是風間琪愛兒的超重要紀念日，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n所以學長才沒有預約就在這邊埋伏要給我驚喜！？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊……",
    "voice": "vo_adv_4010205_002",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我是開玩笑的，原來真的是驚喜啊，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好噁。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊沒事！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然有被嚇到一下，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但就忘記這個先謝謝你了！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還有，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你可以叫琪愛兒",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "「琪愛兒」就好喔？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過，",
    "voice": "vo_adv_4010205_003",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真虧學長能記得住",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學妹的生日。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒關係啦、沒關係啦。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "反正這之後，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我也打算傳訊息",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "委婉地恐嚇你說出「恭喜」。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_4010205_004",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過呢學長？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為是琪愛兒才會這樣毫無防備地接受，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對其他人還是不要用這種危險的慶祝方式比較好喔？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "一般來說被男生這樣埋伏的話，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "除非是特別喜歡的人──",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──啊，",
    "voice": "vo_adv_4010205_005",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不對，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我不是說這次是那個「特別」的意思。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是這樣，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是因為琪愛兒知道學長不是那種人。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "畢竟學長",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是喜歡替人慶祝的人嘛。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "才不會帶有男女之情那種心思……",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": "vo_adv_4010205_006",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還真是感謝你的用心……",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我知道這間店！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你特地去排隊了嗎！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還有你可以叫風間",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "「琪愛兒」就好喔！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唔哇～",
    "voice": "vo_adv_4010205_007",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好可愛！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我很喜歡",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這間的巧克力！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為什麼你會知道？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是去問花子學姐嗎？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊？",
    "voice": "vo_adv_4010205_008",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等一下等一下，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為什麼學長會看我直播啊好噁。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n客群面向女生的聊衣服美妝閒聊台，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你絕對沒興趣吧。",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯？",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "難道說這個人……",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其實是認真的愛上我了……",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好的～",
    "voice": "vo_adv_4010205_009",
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "掰切嚕～♪",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──不對，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦咦！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真的只是道賀完就跑喔那傢伙是怎樣！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等、",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等一下──！",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "至少一起去喝杯茶嘛，",
    "voice": null,
    "unit_id": 110931
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長──！",
    "voice": null,
    "unit_id": 110931
  }
]
