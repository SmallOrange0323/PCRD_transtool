[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在街上\\n發現了一位到處徘徊不安的女孩子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚……嗚……",
    "voice": "vo_adv_1020001_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚哇哇哇！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n禊――！鏡華――！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳們在哪―――――！？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚……",
    "voice": "vo_adv_1020001_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，你是誰？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n你是來幫忙美美的嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美不小心和朋友走散了……",
    "voice": "vo_adv_1020001_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n現在不知道該往哪裡走才好啦……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……哥哥問我會合地點在哪？",
    "voice": "vo_adv_1020001_003",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個，美美有地圖喔！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但是美美、已經不知道自己現在在哪裡了……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這是地圖……",
    "voice": "vo_adv_1020001_004",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥知道地點在哪嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……好、好像很難找。",
    "voice": "vo_adv_1020001_005",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n果然連看地圖也搞不清楚方向嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？失……去……記憶？",
    "voice": "vo_adv_1020001_006",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n原來哥哥是看不太懂字呀。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔～哥哥好可憐……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對了！",
    "voice": "vo_adv_1020001_007",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "下次，美美來教哥哥讀書！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？大概知道這個地點是哪裡了？",
    "voice": "vo_adv_1020001_008",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "告訴美美告訴美美～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……只要朝著這條路直走，就能到達會合地點了嗎？",
    "voice": "vo_adv_1020001_009",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇～這樣的話其實很簡單呢～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n即使是美美自己走，也不會走錯路了！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你，哥哥！",
    "voice": "vo_adv_1020001_010",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "拜拜～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "直走，直走――",
    "voice": "vo_adv_1020001_011",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "直走，直走――",
    "voice": "vo_adv_1020001_012",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！花小姐好～漂亮！蟲先生也在～。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！美美得去鏡華她們那邊不可了……",
    "voice": "vo_adv_1020001_013",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "直走直走……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？往哪邊啊？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥也要陪美美一起去嗎？",
    "voice": "vo_adv_1020001_014",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是往這邊走嗎～還是往那邊走呢～",
    "voice": "vo_adv_1020001_015",
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚哇！",
    "voice": "vo_adv_1020001_016",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美又迷路了啦～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，哥哥！",
    "voice": "vo_adv_1020001_017",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你願意陪美美一起去嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，等等～！哥哥別先走呀～！",
    "voice": "vo_adv_1020001_018",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，為了不讓我們走散，我們手牽著手走吧～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿，真開心呢♪",
    "voice": "vo_adv_1020001_019",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n花小姐與蟲先生，還有哥哥也是――",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n大家――都是好――朋友～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "禊是九歲，鏡華是八歲。",
    "voice": "vo_adv_1020001_020",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n她們兩人都非常的厲害――",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，美美是十歲喲～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――呱歐歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "魔、",
    "voice": "vo_adv_1020001_021",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "魔物！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎麼辦……美美……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n只用單手是拿不起劍的……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不要！",
    "voice": "vo_adv_1020001_022",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為哥哥的手很溫暖，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n又很大，讓美美很安心……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "所以美美才不要放開手呢！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇哇！哥哥要背美美嗎？",
    "voice": "vo_adv_1020001_023",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇――！哥哥跑好快！跑好快喔！",
    "voice": "vo_adv_1020001_024",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們離魔物越來越遠了～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太好了，我們似乎逃脫了呦！",
    "voice": "vo_adv_1020001_025",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥真厲害！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你，哥哥！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，這裡就是會合地點嗎？",
    "voice": "vo_adv_1020001_026",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太好了～到了呢～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n嚕啦啦、嚕啦啦～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "只要在這裡等的話，美美應該就能見到鏡華",
    "voice": "vo_adv_1020001_027",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "和禊了吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝哥哥！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "吶，哥哥，要再和美美一起玩呦！",
    "voice": "vo_adv_1020001_028",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們來打勾勾約定吧――！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "打勾勾約好了呦～♪",
    "voice": "vo_adv_1020001_029",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是{0}\\n笑著與美美打勾勾，\\n約好會再一起玩耍。",
    "voice": null,
    "unit_id": null
  }
]
