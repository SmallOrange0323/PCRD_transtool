  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n角をへし折って差し上げました。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "た、",
    "voice": "vo_adv_5142422_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "たとえ話じゃなくて",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "本気だったのかよ……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ちょっとやりすぎじゃねえかぁ？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "何を言うのです。",
    "voice": "vo_adv_5142422_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "このおかたに危害を加えようとした罰ですわ！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "本当に汚らわしいケダモノです！",
    "voice": "vo_adv_5142422_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "許せない、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "許せない、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "許せないっ……！！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あ、ああ～！　",
    "voice": "vo_adv_5142422_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "分かった！　",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "分かったから！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "倒した相手を何度も蹴とばすなってぇ～！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ったく……",
    "voice": "vo_adv_5142422_005",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
