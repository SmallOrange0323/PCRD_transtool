    "words": "{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聽聞鈴奈有事相求，便來到了鬧區赴約。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_1016009_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這裡這裡！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈嚕──！",
    "voice": "vo_adv_1016009_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "時間一分不差呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真不愧是秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉呀，",
    "voice": "vo_adv_1016009_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "突然把你約出來！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這件事無論如何都只能拜託秀才了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是呀，",
    "voice": "vo_adv_1016009_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和人家約會一天吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "你就是{0}嗎？\\n非常感謝你",
    "voice": "vo_adv_1016009_004",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "今天來協助我們拍攝。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我們雜誌這次策畫了",
    "voice": "vo_adv_1016009_005",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n一個特輯……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "叫做",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n「超級名模‧鈴奈的一日幻想約會」！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "而鈴奈表示",
    "voice": "vo_adv_1016009_006",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "無論如何都",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n不想找職業模特兒作為搭檔，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n指定要由{0}你擔任這個角色。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對對對！",
    "voice": "vo_adv_1016009_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是這麼一回事！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "提到約會，",
    "voice": "vo_adv_1016009_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不就需要一個男朋友嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那肯定非秀才莫屬呀。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n所以人家就想說",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "拜託你試試看！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們這麼合拍，",
    "voice": "vo_adv_1016009_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "約會起來肯定會超開心的，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這場拍攝一定會很成功的！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以今天一整天",
    "voice": "vo_adv_1016009_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你就陪人家約會吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "請多指教～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "不用顧慮我們幾個工作人員，",
    "voice": "vo_adv_1016009_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "兩位盡情享受就可以了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我們會拍下鈴奈最自然的模樣的。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "那我們就",
    "voice": "vo_adv_1016009_012",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "馬上開始拍攝吧！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_1016009_013",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "走吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家已經",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "規劃好約會行程了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀！",
    "voice": "vo_adv_1016009_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這條項鍊",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級可愛的！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，你也這麼覺得吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……奇怪？",
    "voice": "vo_adv_1016009_015",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家想試戴看看，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是這個項鍊扣頭解不開……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你，",
    "voice": "vo_adv_1016009_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那你可以",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "直接幫人家戴上項鍊嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈！",
    "voice": "vo_adv_1016009_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n很癢啦──！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……什麼？",
    "voice": "vo_adv_1016009_018",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "已經戴好了？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "適合人家嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才果然也這麼覺得嗎？",
    "voice": "vo_adv_1016009_019",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然你都這麼說了，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家不如就買下來吧。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就當作是和秀才約會的紀念！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈剛才的笑容",
    "voice": "vo_adv_1016009_020",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "有清楚拍下來嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "有，",
    "voice": "vo_adv_1016009_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "非常清楚喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我到現在幫鈴奈拍過很多次照了，",
    "voice": "vo_adv_1016009_022",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "但還是第一次看見她露出這麼自然的笑容。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "是呀。",
    "voice": "vo_adv_1016009_023",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "這就代表",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "她和{0}在一起的時候真的很開心呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "幸虧有答應鈴奈的要求。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "這個企劃",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "感覺行得通呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "……奇怪？",
    "voice": "vo_adv_1016009_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈他們呢？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "這麼說起來，沒看見人影呢……",
    "voice": "vo_adv_1016009_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "雖然我叫他們盡情享受，",
    "voice": "vo_adv_1016009_026",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "他們該不會忘了現在還在拍攝，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "自己移動到下個地點了吧！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "這就代表鈴奈興致很高昂吧！",
    "voice": "vo_adv_1016009_027",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n我們趕快追上去，千萬別錯過按快門的好時機！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個聖代",
    "voice": "vo_adv_1016009_028",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好好吃喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這在人家的模特兒朋友間討論度超高的，",
    "voice": "vo_adv_1016009_029",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "之前人家就一直很想吃看看了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_1016009_030",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家最近忙著拍攝，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還沒有機會來吃。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以人家就想說，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天約會的時候，一定要跟秀才一起來吃！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶，",
    "voice": "vo_adv_1016009_031",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才你的聖代",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是草莓口味的，對吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要不要跟人家的麝香葡萄口味",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "交換一口吃吃看呀？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來，",
    "voice": "vo_adv_1016009_032",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊──",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "開玩笑的啦！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家又不是小孩子了，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可以自己吃的啦。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": "vo_adv_1016009_033",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你認真！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊呣。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "天啊天啊，",
    "voice": "vo_adv_1016009_034",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級好吃！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家可能比較喜歡草莓口味！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶吶吶，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "再給人家吃一口！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "跟秀才一起來吃真是來對了。",
    "voice": "vo_adv_1016009_035",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果人家一個人來的話，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就只能吃到一種口味了。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "拜託秀才",
    "voice": "vo_adv_1016009_036",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來參與今天的拍攝，真是找對人了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n男朋友這個角色",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "，除了秀才以外，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒有其他人選了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "平時我們兩個人出去玩的時候，",
    "voice": "vo_adv_1016009_037",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n一被人家的粉絲發現，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不就得逃跑嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過，",
    "voice": "vo_adv_1016009_038",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天人家是來工作的，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和秀才在一起也沒關係。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可以比平時更放鬆，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "跟秀才好好地享受約會！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家還是第一次體驗到",
    "voice": "vo_adv_1016009_039",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這麼開心的約會！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈，",
    "voice": "vo_adv_1016009_040",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我們拍到了不少好照片！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "構圖也都非常完美，無可挑剔。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "那我們可以進入訪談環節了吧？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "糟糟糕！",
    "voice": "vo_adv_1016009_041",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "都這個時間了！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和秀才在一起就覺得時間過得飛快呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家還想和秀才再多享受一下約會……",
    "voice": "vo_adv_1016009_042",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶吶，",
    "voice": "vo_adv_1016009_043",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "訪談的時候，秀才也一起來嘛！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是你第一次看人家的訪談吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "那也滿有意思的。",
    "voice": "vo_adv_1016009_044",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "還可以聊聊",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n為什麼這次拍攝可以成功拍到鈴奈發自內心的笑容呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "……原來如此。",
    "voice": "vo_adv_1016009_045",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "在這次的拍攝中，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "鈴奈的搭檔",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "\\n不是職業模特兒，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "而是學校的朋友？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯。",
    "voice": "vo_adv_1016009_046",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他叫做秀才。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才他呀，",
    "voice": "vo_adv_1016009_047",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n是因為他真的很像秀才，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以人家才叫他秀才的。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在人家就讀的學校裡，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他可是秀才中的秀才喔。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "第一次遇見秀才，",
    "voice": "vo_adv_1016009_048",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n是他解救了當時傷透腦筋的人家，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n他真的很可靠，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "跟人家也合拍到電波嗶嗶嗶的感覺。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有呀，",
    "voice": "vo_adv_1016009_049",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家有出場的活動，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他總是會來替人家加油打氣。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會開始當模特兒，",
    "voice": "vo_adv_1016009_050",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n是在路上被星探發掘，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像很有意思就試試看了。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過認識秀才以後",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就開始覺得當模特兒滿好玩的。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才他呀，",
    "voice": "vo_adv_1016009_051",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n常常混在人家的粉絲裡，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "用超大嗓門從觀眾席替我加油打氣。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的超搞笑的吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一開始人家還嚇了一大跳，",
    "voice": "vo_adv_1016009_052",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但在舞台上找到秀才的位置",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "反而變成了現在最有樂趣的事也說不定！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為看著秀才很開心的樣子，",
    "voice": "vo_adv_1016009_053",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家就會覺得自己沒有走錯路",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_1016009_054",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "希望秀才未來也繼續注視著出席各種活動的人家，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家想讓秀才",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "玩得盡興呀！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "原來如此，",
    "voice": "vo_adv_1016009_055",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "很美妙的一段友誼呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "那麼，聽說這次的拍攝主題",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "可以看見最真實的鈴奈。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒錯！",
    "voice": "vo_adv_1016009_056",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也想快點看到今天的拍攝成果！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為對象是秀才，所以才能拍出這樣的照片吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_1016009_057",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "希望這個特輯",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也能讓粉絲看得開心！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
