  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "很奇怪！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "把教室的燈打開時，",
    "voice": "vo_adv_1223004_043",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你會擔心班比「會不會消失」……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "去烹飪教室時，",
    "voice": "vo_adv_1223004_044",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比一舔鹽巴，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你也很慌張吧？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "從屋頂往下看時，",
    "voice": "vo_adv_1223004_045",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你竟然還突然大叫，嚇了班比一跳！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一般來說，不會有人擔心幽靈的吧──？",
    "voice": "vo_adv_1223004_046",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過……",
    "voice": "vo_adv_1223004_047",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "能和班比一起，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "普通地聊天、",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "驚訝、",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "歡笑的人……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你是第一個！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以今天能一起散步，",
    "voice": "vo_adv_1223004_048",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比真的很開心！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而且而且！",
    "voice": "vo_adv_1223004_049",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n與班比說過這麼多話的，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "過去就只有貝斯而已……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1223004_050",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n貝斯",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是班比的朋友唷！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對了！",
    "voice": "vo_adv_1223004_051",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n下次再把貝斯介紹給你……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "………………",
    "voice": "vo_adv_1223004_052",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒事！",
    "voice": "vo_adv_1223004_053",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒什麼～！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呀～",
    "voice": "vo_adv_1223004_054",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真開心！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比很滿足！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為班比滿足了，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就放你走吧！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……咦？",
    "voice": "vo_adv_1223004_055",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是",
    "voice": "vo_adv_1223004_056",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說不定真的是幽靈唷？",
