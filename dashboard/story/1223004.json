    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說不定",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是更～嚇人的生物唷！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……跟你說。",
    "voice": "vo_adv_1223004_057",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還有沒能告訴你的事情。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你如果知道了，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說不定會害怕。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "………………",
    "voice": "vo_adv_1223004_058",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你",
    "voice": "vo_adv_1223004_059",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的很怪！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但是班比",
