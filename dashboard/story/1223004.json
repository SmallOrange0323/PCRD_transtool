    "voice": "vo_adv_1223004_061",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真正的班比唷！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這不能跟任何人說哦？",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽好囉？",
    "voice": "vo_adv_1223004_062",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是「契約」！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是兩人之間的",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "祕密唷♪",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼",
    "voice": "vo_adv_1223004_063",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "從今天起，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你就是班比的僕從了！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要再跟班比一起玩唷！",
    "voice": "vo_adv_1223004_064",
