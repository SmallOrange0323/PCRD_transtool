[
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【破曉之星】的三位成員",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以及{0}踏上了前往背面世界的路途。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "星星好漂亮呀……",
    "voice": "vo_adv_5137061_000",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯。",
    "voice": "vo_adv_5137061_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也很久沒有像這樣悠閒地仰望夜空了呢……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這也是冒險的樂趣呢！",
    "voice": "vo_adv_5137061_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒有選擇用魔法陣",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一口氣傳送到目的地是正確的呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就是說呢。",
    "voice": "vo_adv_5137061_003",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n必須靠著我們的雙腳",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一步步前進才行。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這片天空，",
    "voice": "vo_adv_5137061_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不曉得是否也和志那都",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她們的世界連在一起呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不知道呢……",
    "voice": "vo_adv_5137061_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果有連在一起就好了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生……",
    "voice": "vo_adv_5137061_006",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_5137061_007",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n一定是連在一起的呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。",
    "voice": "vo_adv_5137061_008",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "肯定是的……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與此同時。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在志那都管理的世界中……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5137061_009",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "離開時的紀錄已確認完畢。",
    "voice": "vo_adv_5137061_010",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n未發生「重置」。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……太好了。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……大家都在努力呢。",
    "voice": "vo_adv_5137061_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我也得",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "至少做到自己能做的事情。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "透過菲歐所窺見的",
    "voice": "vo_adv_5137061_012",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "「基礎世界」資訊……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "要是活用這些情報，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "或許也能為這個世界帶來變化。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就去嘗試所有能用的方法吧。",
    "voice": "vo_adv_5137061_013",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……埃拉她肯定也在嘗試。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在埃拉管理的世界中……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好～想喝赤麥酒喔……",
    "voice": "vo_adv_5137061_014",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……不過，",
    "voice": "vo_adv_5137061_015",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要是說這種話，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n感覺又會被志那都訓斥……！！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還是來認真工作吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都……",
    "voice": "vo_adv_5137061_016",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不曉得她過得好不好呢？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還有",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在「基礎世界」的大家也是。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然能待在那邊的時間很短暫，",
    "voice": "vo_adv_5137061_017",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但還真是發生了很多事呢……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 135512
  }
]
