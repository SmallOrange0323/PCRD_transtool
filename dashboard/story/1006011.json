[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "茜里非常介意{0}說過的「很不像平時的茜里」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了找回初衷，也為了變得更加可愛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茜里為此再次展開特訓，和{0}約定好要碰面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……很不像茜里、",
    "voice": "vo_adv_1006011_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這話到底是什麼意思呢……？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……茜里想成為世界上最可愛的人。",
    "voice": "vo_adv_1006011_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "「茜里的風格」",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就是可愛了吧……？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，",
    "voice": "vo_adv_1006011_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥說很不像平時的茜里，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就表示茜里變得不可愛了，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好不容易以為自己",
    "voice": "vo_adv_1006011_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n離變成世界最可愛的夢想更近一步了……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": "vo_adv_1006011_004",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n謝謝你答應過來。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "快點開始特訓……啊！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對、",
    "voice": "vo_adv_1006011_005",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對不起。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里沒站穩……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可能是因為",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "最近想了很多事情，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以沒怎麼睡好……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "說的……",
    "voice": "vo_adv_1006011_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也是。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n對不起，明明是茜里拜託哥哥的。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但是今天就先休息吧。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……其實",
    "voice": "vo_adv_1006011_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里很想要兩個人一起特訓，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但現在的茜里完全不了解自己，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n做了特訓",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也只會給哥哥添麻煩而已。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……特訓",
    "voice": "vo_adv_1006011_008",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n做特訓時的茜里，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就有「像茜里」了嗎？　",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里",
    "voice": "vo_adv_1006011_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "已經完全不知道該怎麼辦才好了……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "說到底，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "為什麼茜里不惜做特訓，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n也要成為世界上最可愛的人呢……？　",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是了解「茜里的風格」的哥哥，",
    "voice": "vo_adv_1006011_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n是不是就明白什麼了呢？　",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那個，",
    "voice": "vo_adv_1006011_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有件事想問……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你是不是在發光呀……？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這不是……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我的錯覺……？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": "vo_adv_1006011_012",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥～！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在這邊喔～♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "謝謝哥哥來聽茜里的演奏。",
    "voice": "vo_adv_1006011_013",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n多虧了哥哥的支持，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里今天才能",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "贏得個人組的優秀獎～♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿。",
    "voice": "vo_adv_1006011_014",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里認為這一切",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n要歸功於哥哥陪同下的許多練習♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……所以",
    "voice": "vo_adv_1006011_015",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里想好好向哥哥道謝♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在大庭廣眾下有些害臊……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "希望你可以到平時的那座公園來……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那裡人潮稀少，",
    "voice": "vo_adv_1006011_016",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "腹地寬廣，不用在意路人的目光，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥就可以",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "盡情聆聽茜里的薩克斯風演奏了♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太好了……",
    "voice": "vo_adv_1006011_017",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那我們",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "立刻出發吧♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿。",
    "voice": "vo_adv_1006011_018",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這裡果然讓人很放鬆呢。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里在這裡和哥哥一起",
    "voice": "vo_adv_1006011_019",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "做了好幾次這種事和那種事，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里才能把薩克斯風吹得越來越熟練呢。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里覺得",
    "voice": "vo_adv_1006011_020",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在這裡",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n最能向哥哥表達出自己的謝意，所以……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……所以，",
    "voice": "vo_adv_1006011_021",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我要開始演奏囉♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "still",
    "still_id": "100601101"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯……",
    "voice": "vo_adv_1006011_022",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呼……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "口頭表達謝意並不困難，",
    "voice": "vo_adv_1006011_023",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但茜里強烈的情感",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是無法用言語完整表達出來的……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "乘著和哥哥一起特訓出來的",
    "voice": "vo_adv_1006011_024",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "薩克斯風音色，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n表達出",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里滿滿的感謝之意……！　",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請你仔細聽了，",
    "voice": "vo_adv_1006011_025",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥……！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
