  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呼……！",
    "voice": "vo_adv_1006011_026",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你覺得怎麼樣？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": "vo_adv_1006011_027",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "被哥哥誇獎了♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "其實",
    "voice": "vo_adv_1006011_028",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里比發表會的時候還要緊張呢。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但是，看見哥哥很喜歡的樣子，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "更重要的是，茜里的心情好像充分表達出來了，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好開心喔♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……茜里",
    "voice": "vo_adv_1006011_029",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "現在覺得非常幸福。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "能被哥哥這麼誇獎。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在發表會上贏得優秀獎",
    "voice": "vo_adv_1006011_030",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "當然也很開心……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "能被哥哥誇獎的時候，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里更加地心跳不已、",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "更加地幸福。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": "vo_adv_1006011_031",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n那",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里跟哥哥就是一樣的心情了呢♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "從今以後，",
    "voice": "vo_adv_1006011_032",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥也要繼續陪茜里特訓，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n然後要好好地",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "誇獎茜里喔。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里就會覺得很幸福的♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": "vo_adv_1006011_033",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "約好了喔♪",
    "voice": null,
    "unit_id": 100631
  },
