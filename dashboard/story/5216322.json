[
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀──",
    "voice": "vo_adv_5216322_000",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "又動起來了啊。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n真是棘手。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "小心別被阻止行動了。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要是被迫停下來可是相當致命的。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "美穗",
    "words": "那個，",
    "voice": "vo_adv_5216322_001",
    "unit_id": 139211
  },
  {
    "type": "dialogue",
    "name": "美穗",
    "words": "如果有我們世界的",
    "voice": null,
    "unit_id": 139211
  },
  {
    "type": "dialogue",
    "name": "美穗",
    "words": "「戰車的因子」混在裡面……",
    "voice": null,
    "unit_id": 139211
  },
  {
    "type": "dialogue",
    "name": "美穗",
    "words": "\\n是不是可以刻意引發過熱啊？",
    "voice": null,
    "unit_id": 139211
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "刻意……",
    "voice": "vo_adv_5216322_002",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "引發過熱？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n是強制讓它無法動彈的意思嗎？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "確實。",
    "voice": "vo_adv_5216322_003",
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "\\n一開始戰鬥時，",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "它也有一段時間",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "變得無法行動。",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "\\n",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "就算只有很短的時間，",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "如果能引發那個狀態的話……",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "話是這麼說，",
    "voice": "vo_adv_5216322_004",
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "要怎麼做，",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "才能引發過熱呢？",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "從我們這邊",
    "voice": "vo_adv_5216322_005",
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "要人為提高車體溫度或負擔，",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "\\n是非常困難的喔。",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "尤其，",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "這是驅動方式與一般戰車不同的敵人──",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，",
    "voice": "vo_adv_5216322_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果是這樣，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那以熱能來造成傷害……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個方法如何呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "原來如此，",
    "voice": "vo_adv_5216322_007",
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "是個好方法呢。",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "\\n以熱能阻止其行動，",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "就取名叫",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "「焦香漢堡排」作戰吧！",
    "voice": null,
    "unit_id": 139411
  }
]
