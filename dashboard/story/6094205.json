    "words": "ショーグン、",
    "voice": "vo_adv_6076205_000",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "霊界って",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "どんなところなんでショウか？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nわたあめちゃんみたいな",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "かわいい妖魔以外にも、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "悪霊や",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "怖い妖魔もいっぱいいる",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "世にも",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "末恐ろしい場所デスか……？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "オオー！　",
    "voice": "vo_adv_6076205_001",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "極楽デスか！　",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "それは",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "楽しみデス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "とても気になりマスが、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "まずは",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "この世の天下統一が先デス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nあの世を満喫するためにも、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "生きている間に",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "人生を",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "全うしたいデス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ナ、",
    "voice": "vo_adv_6076205_002",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ナ、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ナントー！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "穏やかに過ごせるような世界では",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ないかもしれないんデスね……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "オニは",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "手強い相手デスが、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "のんびり暮らせるように",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "戦うしかありまセン！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "フム……",
    "voice": "vo_adv_6076205_003",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "やはり",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ワタシたちにとっては",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "未知の世界なんデスね……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nあの世には",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "何も持って渡れないといいマスが、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "忠誠心だけは別デス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ずっと",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ショーグンの家来でいるために、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "必ずや",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "持っていきマス！",
    "voice": null,
    "unit_id": 117811
  }
]
