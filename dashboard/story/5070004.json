    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "靜流。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "再這樣下去，暑假就要結束了……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是想做的事情卻接二連三冒出來……",
    "voice": "vo_adv_5070004_001",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就這樣讓跟{0}大人的幸福時光結束……",
