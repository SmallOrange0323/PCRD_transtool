  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在暑假快要結束前的某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n惠理子跟靜流正狠狠瞪著",
