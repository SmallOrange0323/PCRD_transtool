    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真琴果然也是女孩子呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n可愛的東西、",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "洋裝和舞會，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只要是女孩子都會很嚮往♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且，",
    "voice": "vo_adv_1159004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能夠好好地接納像這樣的真琴，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你今天很難得可以表現得那麼好！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了嘉獎你……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不如就由愛梅斯公主給王子殿下",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一個吻吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呵呵，",
    "voice": "vo_adv_1159004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是開玩笑～的♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了好了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也該回去了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真琴在等著你呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501250"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "──啥！？",
    "voice": "vo_adv_1159004_052",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是、",
    "voice": "vo_adv_1159004_053",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是夢嗎……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "感覺好恐怖的夢……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我做了一點也不像我的事，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "竟然還",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "穿上了洋裝……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嚇、",
    "voice": "vo_adv_1159004_054",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嚇了我一跳！？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你什麼時候來這裡的……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "等、",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "等等。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n你剛剛說了",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我覺得很適合妳穿，對吧？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "難道說……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你做了看到我穿著洋裝開心不已的夢？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": "vo_adv_1159004_055",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是這樣嗎。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n想不到有這麼奇妙的事～",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你現在馬上給我忘掉～～！！",
    "voice": "vo_adv_1159004_056",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說要揍了你才忘得掉！？",
    "voice": "vo_adv_1159004_057",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n現在不管什麼我都願意做，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n你敢跟我說該怎麼做才能忘的話，就給我試試看，混蛋！！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊～",
    "voice": "vo_adv_1159004_058",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼變成這樣……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n明明是我一直藏在心裡的祕密，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "偏偏是被這傢伙給……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……事情才沒這麼簡單！",
    "voice": "vo_adv_1159004_059",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n每個人都有自己的形象……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "再說，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這根本不是我的風格。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": "vo_adv_1159004_060",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是在這裡被發現的，或許也算是慶幸吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "接下來，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我就能毫無顧慮地欣賞了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n……欣賞我從小就十分嚮往的",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這種舞會。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……真的很棒。",
    "voice": "vo_adv_1159004_061",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n既優雅……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "又光彩奪目……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我所嚮往的光景就是這個。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
    "voice": "vo_adv_1159004_062",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說既然那麼嚮往，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就該親自去體驗一下？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我剛剛也說過了吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這根本不是我的風格……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂、",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂、",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你幹嘛拉著我的手……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你要帶我去哪裡啊～！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "大小姐１",
    "words": "──咦，",
    "voice": "vo_adv_1159004_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大小姐１",
    "words": "那不是真琴大人嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大小姐２",
    "words": "還有那個人是……",
    "voice": "vo_adv_1159004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，",
    "voice": "vo_adv_1159004_065",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這裡是舞會正中央耶！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好了，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在妨礙到他人之前趕快……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……唔！？",
    "voice": "vo_adv_1159004_066",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……這傢伙真的是，",
    "voice": "vo_adv_1159004_067",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n明明對戀愛很遲鈍，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也不懂得男女之間的距離感，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "竟然在這時候表現得那麼完美……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……嗯，",
    "voice": "vo_adv_1159004_068",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我很樂意！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在舞會的中心開始跳起舞的兩人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那樣子就好像是故事中的王子和公主在跳舞一般。",
    "voice": null,
    "unit_id": null
  }
]
