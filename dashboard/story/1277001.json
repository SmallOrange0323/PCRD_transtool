[
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萊拉耶爾公主的女僕",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "琳德，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天也跟烏爾姆一起",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "勤奮地做著城裡的工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "西側的燈保養完了。",
    "voice": "vo_adv_1277001_000",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n也聯絡好送食材的人了，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "接下來要洗完衣物，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "然後……",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生！",
    "voice": "vo_adv_1277001_001",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "你到吉歐‧提格尼亞來啦。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n辛苦了。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是，",
    "voice": "vo_adv_1277001_002",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這種程度的工作量很普通喔。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這是跟平常一樣的日常。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我們這邊女僕的人數不是很多，",
    "voice": "vo_adv_1277001_003",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n所以基本上",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不什麼都去做的話會忙不過來。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……不過，",
    "voice": "vo_adv_1277001_004",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊她除了平常的工作之外，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n還會自己跑去被別人拜託做事情就是了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "像是洗盤子",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "或是修剪路樹之類的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆妳才是老是在偷懶啊！",
    "voice": "vo_adv_1277001_005",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "而且，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "女僕不是只要做好被吩咐的工作就可以了啊。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要是有人感到困擾的話，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要去幫忙才行。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "咦！？",
    "voice": "vo_adv_1277001_006",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n那怎麼行，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生明明也很忙碌，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n怎麼能讓你來幫我……！",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沒關係吧，老姊。",
    "voice": "vo_adv_1277001_007",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n既然他有幹勁的話就交給他吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼，全體注意──",
    "voice": "vo_adv_1277001_008",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這邊的騎士先生，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "似乎不管拜託他什麼",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n他都會幫忙喔──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "喔，",
    "voice": "vo_adv_1277001_009",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "那就拜託你幫我洗碗吧！",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "\\n",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "我最近很忙，都沒空去洗……",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "\\n",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "還有，",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "今後如果要跟異世界交流的話，我想增加餐具……",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "我剛好想要人手啊～",
    "voice": "vo_adv_1277001_010",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "要從城裡的各個地方回收待洗衣物",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "也需要人手啊……",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "啊，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "負責洗衣的女性",
    "words": "就順便拜託你幫我洗好吧。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我的肩膀僵硬到不行啊，",
    "voice": "vo_adv_1277001_011",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "可以請你",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "幫我敲一下嗎？",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "等、",
    "voice": "vo_adv_1277001_012",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "等等啦，各位！？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "還有烏爾姆，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那些是我們的工作啊！",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "明明是那樣，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "卻把騎士先生捲進來──",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要交給你嗎！？",
    "voice": "vo_adv_1277001_013",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "唉……",
    "voice": "vo_adv_1277001_014",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "今天就拜託騎士先生也跟我們一起工作。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "請你不要勉強喔！",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "background",
    "bg_id": "501730"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "首先從洗碗開始吧。",
    "voice": "vo_adv_1277001_015",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不過，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "沒想到",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要洗的碗盤會堆積如山啊……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的。",
    "voice": "vo_adv_1277001_016",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n大家明明都是大人了，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "都太仰賴騎士先生的好意了啦！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "就算是那樣也還是要有限度的啊！",
    "voice": "vo_adv_1277001_017",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n應該說，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要是平常就有勤勞地在洗碗盤的話，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n是不會堆成這樣的喔？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "為什麼大家都不認真工作呢……",
    "voice": "vo_adv_1277001_018",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "明明一開始就認真工作絕對會比較好啊。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不拘小節……",
    "voice": "vo_adv_1277001_019",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我是",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也覺得那樣不壞啦。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那不是能不認真工作的理由吧？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那樣最後會傷腦筋的是自己啊！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "咦，",
    "voice": "vo_adv_1277001_020",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "很仰賴我？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……我、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我是不會被那種話騙的喔！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我並沒有感到高興！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……不對，",
    "voice": "vo_adv_1277001_021",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "現在不是能一直講話的時候呢。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "如果有不懂的地方的話，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n不用客氣盡管問我吧！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "還有烏爾姆不要在那偷吃東西！",
    "voice": "vo_adv_1277001_022",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n要好好擦盤子！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好好好，",
    "voice": "vo_adv_1277001_023",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我知道啦──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "今天的姊姊",
    "voice": "vo_adv_1277001_024",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "莫名的有幹勁呢……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "希望她不要努力過頭就好了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "打掃王座之廳",
    "voice": "vo_adv_1277001_025",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也是女僕工作的一環。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這裡只有被萊拉耶爾殿下信賴的人",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n才能負責打掃喔。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那麼，",
    "voice": "vo_adv_1277001_026",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我們就分頭進行吧。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "首要要從把裝飾品上的灰塵撢到地板上開始……",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可以嗎？",
    "voice": "vo_adv_1277001_027",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我要做的時候，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "都要站到凳子上去……",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n然後因為站不穩所以很辛苦。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "是的！",
    "voice": "vo_adv_1277001_028",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n那麼我們也",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "配合你，",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "開始擦東西",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "跟掃地了喔。",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "居然能這麼順利開始工作……！",
    "voice": "vo_adv_1277001_029",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "你難道很習慣打掃嗎？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真厲害……！　",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "能進行地這麼順利的話，",
    "voice": "vo_adv_1277001_030",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n今天的工作感覺能很早結束……",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n好──！　",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……嗯，",
    "voice": "vo_adv_1277001_031",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳在哪裡？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼。",
    "voice": "vo_adv_1277001_032",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我就去睡個覺……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏～",
    "voice": "vo_adv_1277001_033",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "爾～",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "姆～！？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "嘿咻……",
    "voice": "vo_adv_1277001_034",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "嗯，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "是這邊吧。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆～？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳有好好跟上來嗎？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不用妳說我也在這裡啦。",
    "voice": "vo_adv_1277001_035",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我會去晾洗好的衣物，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就拜託騎士先生準備繩子了喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "呼……",
    "voice": "vo_adv_1277001_036",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "終於晾完一半左右了吧。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這都是託騎士先生幫忙的福喔！",
    "voice": "vo_adv_1277001_037",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "平常要花更多時間的。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "今天天氣也很好，",
    "voice": "vo_adv_1277001_038",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "被陽光照著的泡泡非常漂亮喔！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n圓潤又發著光，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "像糖果一樣……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "嗯，",
    "voice": "vo_adv_1277001_039",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n為什麼會有泡泡在飛舞啊？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這附近明明就沒有使用洗衣精、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "的說……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………（呼──）",
    "voice": "vo_adv_1277001_040",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆！",
    "voice": "vo_adv_1277001_041",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要我說幾次妳才懂啊！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好好好，",
    "voice": "vo_adv_1277001_042",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我會去工作、我會去工作。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我只是稍微休息一下而已啦。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是那那樣沒關係嗎，",
    "voice": "vo_adv_1277001_043",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "姊姊？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳背後那邊，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "洗好的衣服被馬卡龍狗們當玩具玩耶。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "咦？",
    "voice": "vo_adv_1277001_044",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……啊！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不會吧，",
    "voice": "vo_adv_1277001_045",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "討厭啦！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我好不容易才洗好了說！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n不可以吃！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "住手啊～！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "唉……",
    "voice": "vo_adv_1277001_046",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "被口水弄得濕濕黏黏的了……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n被吃到的被單",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n只能回城裡重洗了呢……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是，",
    "voice": "vo_adv_1277001_047",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "難得騎士先生來幫我了啊。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "而且，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "在這之前明明都很順利的說……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生……",
    "voice": "vo_adv_1277001_048",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生",
    "voice": "vo_adv_1277001_049",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "果然很厲害啊……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n就連發生這種突發狀況也不慌張。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生在工作時動作也很俐落……",
    "voice": "vo_adv_1277001_050",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n明明是我說有不懂的地方可以問我，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我卻反而一直被幫助。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "相較之下，",
    "voice": "vo_adv_1277001_051",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………",
    "voice": "vo_adv_1277001_052",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我說，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "是的……",
    "voice": "vo_adv_1277001_053",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "嗯，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "奇怪？",
