    "words": "騎士先生的臉，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好近……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "比想像的還要令人害羞啊……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼、",
    "voice": "vo_adv_1364002_086",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼吸會吹到臉上……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n沒辦法好好看著，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是不看的話……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我、",
    "voice": "vo_adv_1364002_087",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我現在，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一定滿臉通紅吧……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會、",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會怎麼看待我呢……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "still",
    "still_id": "136400202"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "快點快點，優衣，",
    "voice": "vo_adv_1364002_088",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "動作太慢了哦～",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n妳要含著草莓",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "含多久呀～？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優、",
    "voice": "vo_adv_1364002_089",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "冷靜點！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n美空也不要在那邊煽動！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒事的，",
    "voice": "vo_adv_1364002_090",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這不是要接吻，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n只是遊戲而已……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "still",
    "still_id": "136400203"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可、",
    "voice": "vo_adv_1364002_091",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "感覺",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "頭有點暈暈的……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n要、",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要是真的親到了，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "still",
    "still_id": "136400204"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "優衣妳還好嗎？",
    "voice": "vo_adv_1364002_092",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n表情越來越有趣了，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n而且騎士先生正直直盯著看呢♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯唔唔唔，",
    "voice": "vo_adv_1364002_093",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "唔～！",
    "voice": null,
