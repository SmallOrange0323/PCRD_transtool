    "name": "優衣",
    "words": "有、",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有嗎？",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為，",
