  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到聖誕節當天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聚集在蘭德索爾市內租借空間的優衣等人，",
    "voice": null,
    "unit_id": null
  },
