  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪菲繼續思考送禮的事，同時在街上漫步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一、二、",
    "voice": "vo_adv_9005004_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一、二！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這個響亮的聲音……",
    "voice": "vo_adv_9005004_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "莫非是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌！",
    "voice": "vo_adv_9005004_002",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "注意站位！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳有點太後面了！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好的！",
    "voice": "vo_adv_9005004_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "紡希，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳的聲音有點飄。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n妳已經累了嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才沒有那種事！",
    "voice": "vo_adv_9005004_004",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我才不會輸給小望跟千歌呢……！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果然是",
    "voice": "vo_adv_9005004_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "慈樂之音的三位成員……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "正在舞台上練習啊。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "即使是練習，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "她們也好認真、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好美喔……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……嗯？",
    "voice": "vo_adv_9005004_006",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那是……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雪菲？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有什麼事嗎～？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊！？",
    "voice": "vo_adv_9005004_007",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "被發現了！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我不是故意要打擾妳們練習的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵，",
    "voice": "vo_adv_9005004_008",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒關係啦。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們只是簡單排練一下而已。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過小望還是一樣賣力就是了。",
    "voice": "vo_adv_9005004_009",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……對了雪菲，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳找我們",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我看妳剛才一臉嚴肅地看著我們。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": "vo_adv_9005004_010",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "送給那個人",
    "voice": "vo_adv_9005004_011",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "的禮物嗎……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這可是個難題呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生那個人啊，",
    "voice": "vo_adv_9005004_012",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "隨便給他個東西他都開心得要命，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n妳不必這麼認真思考吧？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "反正",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "送什麼他都",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的很開心。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "紡希……",
    "voice": "vo_adv_9005004_013",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "原來妳這麼常",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "送禮物給他啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──來場特別演唱會怎麼樣！",
    "voice": "vo_adv_9005004_014",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！？",
    "voice": "vo_adv_9005004_015",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n特別演唱會！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "專為他",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "開的……！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒錯！",
    "voice": "vo_adv_9005004_016",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓跟他有交情的人通通站上舞台！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家一起為他獻唱怎麼樣！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n訓練課程就交給我們♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──喔，",
    "voice": "vo_adv_9005004_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳們在討論有趣的話題啊？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "製作人！？",
    "voice": "vo_adv_9005004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳剛才說特別演唱會是吧？",
    "voice": "vo_adv_9005004_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n人氣如日中天的現役偶像團體，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "專為一個人開演唱會嗎。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我個人是完全不反對啦。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真、",
    "voice": "vo_adv_9005004_020",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯……",
    "voice": "vo_adv_9005004_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然啦。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們先來聊聊預算方面吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "4人",
    "words": "咦？",
    "voice": "vo_adv_9005004_022",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "必須準備舞台、",
    "voice": "vo_adv_9005004_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "器材、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "服裝、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "工作人員",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "等等……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要我這位能幹的製作人出馬，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "勢必也得付一筆委託費吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過既然是為了那小子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會算妳便宜點的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "抱、",
    "voice": "vo_adv_9005004_024",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "抱歉打擾了──────────！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聽到她提出的金額，雪菲立刻全速逃離現場。",
    "voice": null,
    "unit_id": null
  }
]
