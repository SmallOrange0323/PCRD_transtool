    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等等，",
    "voice": "vo_adv_5126001_064",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳要去哪裡啊──！？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "background",
    "bg_id": "502030"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………唉。",
    "voice": "vo_adv_5126001_065",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "從第一天就搞得一塌糊塗……",
    "voice": "vo_adv_5126001_066",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不該是這樣子的……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵，",
    "voice": "vo_adv_5126001_067",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "發生什麼事了呢？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我大概也能想像就是了。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "應該是受到了廢柴班的洗禮吧。",
    "voice": "vo_adv_5126001_068",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "凱留同學。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……妳是？",
    "voice": "vo_adv_5126001_069",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "我是升學班的委員長。",
    "voice": "vo_adv_5126001_070",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "妳應該嚇到了吧？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "因為廢柴班的程度低得驚人。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "但是",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "安魔學裡糟糕的就只有那一班而已，妳可不要誤會喔。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "呵呵，",
    "voice": "vo_adv_5126001_071",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "凱留同學，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "那個班級並不適合妳呢。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n妳願不願意轉來我們升學班？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然很高興受到邀請，",
    "voice": "vo_adv_5126001_072",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是好像沒辦法呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n似乎只剩廢柴班有多的名額。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "這種小事很好解決的。",
    "voice": "vo_adv_5126001_073",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "只要把我們班裡最無能的人",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "踢去廢柴班就好了♪",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……？",
    "voice": "vo_adv_5126001_074",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "對吧，",
    "voice": "vo_adv_5126001_075",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "這樣比較好啦凱留同學。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n我馬上就去拜託校長處理吧♪",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n只要我說一聲，馬上就……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": "vo_adv_5126001_076",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒關係啦，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我待在廢柴班就好。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "咦，",
    "voice": "vo_adv_5126001_077",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "事先也不曉得班上有沒有合拍的人，",
    "voice": "vo_adv_5126001_078",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就被隨機丟進教室所產生的不自由感，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這也是學園生活的樂趣吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那些傢伙，走著瞧吧……",
    "voice": "vo_adv_5126001_079",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我一定要讓他們刮目相看！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "等等！",
    "voice": "vo_adv_5126001_080",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "妳不用留在那種垃圾堆，和那群無能待在一起啊！",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "俗話說近朱者赤什麼的……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "這樣子妳也會變得無能喔！？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "和妳一起來的",
    "voice": "vo_adv_5126001_081",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "那個外表浮誇的無能女，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n和那個一直悠哉傻笑的無能男",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "倒是很適合那班啦！",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……無能？",
    "voice": "vo_adv_5126001_082",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳從剛才開始就一直在那邊說無能無能的，",
    "voice": "vo_adv_5126001_083",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是在",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "自我介紹嗎？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "……什麼？",
    "voice": "vo_adv_5126001_084",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n妳是什麼意思，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "凱留同學？",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所謂的無能，",
    "voice": "vo_adv_5126001_085",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是指無法達成目標的人不是嗎。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的目標，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是把我拉進升學班對吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳以為用剛才那種說法",
    "voice": "vo_adv_5126001_086",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有辦法達成這個目標嗎？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……對於我的朋友。",
    "voice": "vo_adv_5126001_087",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那樣嘲笑我朋友的傢伙所在的班級，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳難道覺得我會想進去嗎？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "……啊！",
    "voice": "vo_adv_5126001_088",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳再說一次鈴奈和那傢伙的壞話看看，",
    "voice": "vo_adv_5126001_089",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n到時候妳就等著瞧。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "嘖……",
    "voice": "vo_adv_5126001_090",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "真是得寸進尺……！！",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n我再也不會邀妳了！",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那真是太棒了呢。",
    "voice": "vo_adv_5126001_091",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "笨",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "蛋───",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶～～～～♪♪♪♪♪",
    "voice": "vo_adv_5126001_092",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！！",
    "voice": "vo_adv_5126001_093",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳為什麼會在這裡……！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼嘛～",
    "voice": "vo_adv_5126001_094",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳有好好",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "把我們當朋友嘛～！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好高興喔～～♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家也很喜歡凱留寶喔！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超喜歡！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喜歡到不行！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以說別抱上來啦……！！",
    "voice": "vo_adv_5126001_095",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好難呼吸……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "嗯，",
    "voice": "vo_adv_5126001_096",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "本來以為是個難相處的傢伙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n但凱留人還挺好的嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "凱留，",
    "voice": "vo_adv_5126001_097",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我剛才對妳的說話方式有點傷人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n真對不起……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "……哼！",
    "voice": "vo_adv_5126001_098",
    "unit_id": 814
