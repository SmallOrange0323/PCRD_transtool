[
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔，",
    "voice": "vo_adv_5072204_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好了……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "觀眾們的情緒越來越低落了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "他們如果感受到了這群陰沉魔物們所帶來的壓力，",
    "voice": "vo_adv_5072204_001",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這也是沒辦法的事。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然如此，",
    "voice": "vo_adv_5072204_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們只要帶來更多的歡樂就行了！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "接下來就輪到我出場囉！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我引以為傲的舞台服裝的華麗感！",
    "voice": "vo_adv_5072204_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n充分運用了夏日海洋的舞台呈現！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "用我努力的成果，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "來掃除觀眾們心中的不安吧！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_5072204_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這主意不錯！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那就拜託妳囉，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希！",
    "voice": null,
    "unit_id": 117211
  }
]
