[
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "被貧窮壓得喘不過氣的杏奈美眉為了求一份工作，",
    "voice": "vo_adv_5008206_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而前往了溪谷洞穴。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而那悽涼的背影，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "便是她的",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最後身影……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "完。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "七七香，",
    "voice": "vo_adv_5008206_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不要把話講得這麼可怕啊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然沒錢這事倒是真的……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真一如往常的熱鬧呢，",
    "voice": "vo_adv_5008206_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們幾個。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_5008206_003",
    "unit_id": 100911
  },
  {
