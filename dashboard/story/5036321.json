[
  {
    "type": "dialogue",
    "name": "未央",
    "words": "盆栽小花，",
    "voice": "vo_adv_5036321_000",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你冷靜一點啦～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……只靠這樣呼喊它的話，",
    "voice": "vo_adv_5036321_001",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好像沒用呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不過，",
    "voice": "vo_adv_5036321_002",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就算戰鬥越來越艱困，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我們也得阻止盆栽小花才行……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "說的對，",
    "voice": "vo_adv_5036321_003",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "島村村！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "畢竟我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "可是偶像嘛！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的！",
    "voice": "vo_adv_5036321_004",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就靠我們【new generations】三人的力量，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n再繼續加油吧！",
    "voice": null,
    "unit_id": 112411
  }
