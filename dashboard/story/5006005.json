[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一小時後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物A",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 713
  },
  {
    "type": "dialogue",
    "name": "魔物B",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝、",
    "voice": "vo_adv_5006005_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝！　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總算是趕上了！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我這樣不太能奔跑呢，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為鎧甲太重了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_5006005_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你也知道我必須遵守家訓……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是說少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你怎麼也跟過來了？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你還是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "趕緊避難為上喔？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔～……",
    "voice": "vo_adv_5006005_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖說能加強夥伴的能力這點很派得上用場。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但真的很危險，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請盡量離遠一點。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總之……",
    "voice": "vo_adv_5006005_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n已經無路可逃了喔，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快乖乖就範！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "【王宮騎士團（NIGHTMARE）】的全員，快包圍敵人！",
    "voice": "vo_adv_5006005_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n先擊倒削弱他們再進行綑綁！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n若是抵抗，即使砍斷手腳也在所不惜！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "敵人可是沒有肉身這樣不可思議的存在……",
    "voice": "vo_adv_5006005_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n恐怕是與寄宿著生命的鎧甲同類，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這種程度的攻擊是殺不死的！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也因此不會沾上敵人的血，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不需懷著罪惡感也能安心入睡！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光明正大地！",
    "voice": "vo_adv_5006005_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就像故事中正義的一方打倒敵人一般，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n華麗的擊退敵人吧！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_5006005_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我不太習慣大聲說話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但這還是必要的呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看到自己的冒牌貨到處施暴，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而【王宮騎士團】的成員們皆受到動搖。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若我表現的堅定一點，",
    "voice": "vo_adv_5006005_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "大家應該也能安心下來的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純！",
    "voice": "vo_adv_5006005_009",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這這這、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這是什麼情況！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茉、",
    "voice": "vo_adv_5006005_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茉莉？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼說來茉莉住在這附近嘛……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真的太危險了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身為新人的你應該快點去安全的地方避難。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不，",
    "voice": "vo_adv_5006005_011",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也要參加戰鬥！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為這可是我的城鎮！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而且戰力也不夠是吧，",
    "voice": "vo_adv_5006005_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "請讓我助你一臂之力。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智也是……",
    "voice": "vo_adv_5006005_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼你們兩個都在這邊呢？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只是剛好而已。",
    "voice": "vo_adv_5006005_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "剛跟茉莉吃完飯後，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n正要送他回家的途中，就遇到這怪事。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這些傢伙",
    "voice": "vo_adv_5006005_015",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在搞什麼？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n有兩個純……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是傳說中的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "『闇影』嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我覺得不同，",
    "voice": "vo_adv_5006005_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但也不是很清楚。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且也不清楚真實身分，也無法坐視不管……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這些傢伙模仿我們的模樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "並且為所欲為。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "絕對不可原諒！。",
    "voice": "vo_adv_5006005_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就是因為這些傢伙，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以才覺得被大家討厭吧，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "害我心理那麼煩躁。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊啊……",
    "voice": "vo_adv_5006005_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n原來如此，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這麼一來就說得過去了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒想到是冒牌貨呢……",
    "voice": "vo_adv_5006005_019",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我都沒想到，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n明明之前也有聽到關於『闇影』的目擊情報的說。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來我還是不夠成熟呢。",
    "voice": "vo_adv_5006005_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "被純的冒牌貨那樣對待，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我受的傷好像比自己想像的還要重。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我竟然都沒想到，",
    "voice": "vo_adv_5006005_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還懷疑你，真抱歉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也要反省……",
    "voice": "vo_adv_5006005_022",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "冒牌的英雄這種老套的劇情，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n為何我沒有立刻發現呢？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嘻嘻。",
    "voice": "vo_adv_5006005_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這也沒辦法吧，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為外觀一模一樣呀……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望我們關係越來越親，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n親到一眼就能分出本尊跟冒牌貨的差別。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了達成那目標。",
    "voice": "vo_adv_5006005_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n別為了互相懷疑的事而受傷，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了成為互相友愛的夥伴……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一起攜手解決，",
    "voice": "vo_adv_5006005_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這些可怕又不尋常的事件吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們兩個",
    "voice": "vo_adv_5006005_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都會幫我吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "當然！",
    "voice": "vo_adv_5006005_027",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "必須要向",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "爸爸跟媽媽，還有住在獸人居住區的大家證明……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n做壞事的是冒牌貨！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯。",
    "voice": "vo_adv_5006005_028",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n不僅打倒敵人，還能洗刷純的汙名，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是一石二鳥呢。",
