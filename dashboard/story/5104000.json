[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾市中心，獸人族的居住區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在這人聲鼎沸的熱鬧街上，傳出一道特別響亮的孩子聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所～以～說～！",
    "voice": "vo_adv_5104000_000",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n昨天",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "忘了要幫家裡的忙是我的錯！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是",
    "voice": "vo_adv_5104000_001",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我希望妳不要說【王宮騎士團】的工作，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n以及大家的壞話啦！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "真是的，",
    "voice": "vo_adv_5104000_002",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "這孩子又在說這種話……！",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "每天都看到女兒精疲力盡地回家，有那個父母會不擔心？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "妳昨天也是一回來",
    "voice": "vo_adv_5104000_003",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "就如同昏倒般睡著了！",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "難道是",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "大家都把工作推給妳……",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才沒有這種事！",
    "voice": "vo_adv_5104000_004",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n【王宮騎士團】的大家都是好人！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……不，",
    "voice": "vo_adv_5104000_005",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也是有克莉絲提娜阿姨之類的例外。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "整體來說，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大致上，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "幾乎都是好人！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "真的嗎……？",
    "voice": "vo_adv_5104000_006",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "怎麼說，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "媽媽很擔心啊。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n在妳突然說出要加入【王宮騎士團】時也很擔心。\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "另外……",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊～～～",
    "voice": "vo_adv_5104000_007",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好了啦！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不想聽媽媽說教！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要出門了，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這樣下去會遲到的！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "茉莉，",
    "voice": "vo_adv_5104000_008",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "妳今天也很有幹勁呢！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "這是今早剛採的蘋果，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "在工作前拿去吃吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇～",
    "voice": "vo_adv_5104000_009",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我就心懷感激地收下了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我出發了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "我家女兒真是抱歉……",
    "voice": "vo_adv_5104000_010",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "那個，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "請問多少錢呢？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "沒關係沒關係！",
    "voice": "vo_adv_5104000_011",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "茉莉",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "經常陪我兒子玩，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "\\n還會來幫忙顧生意，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "實在受了她不少照顧呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "不過，",
    "voice": "vo_adv_5104000_012",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "身為父母還是會擔心吧……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "明明是個好孩子，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "為何會喜歡去那種地方……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "是啊……",
    "voice": "vo_adv_5104000_013",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "不過因為是那孩子的期望，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n我是希望盡可能",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "讓她去做自己想做的事。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊────！！",
    "voice": "vo_adv_5104000_014",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n因為拿到蘋果害我完全忘了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n媽媽！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "今天的便當～～！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "但是看她這個樣子，",
    "voice": "vo_adv_5104000_015",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "實在讓人放心不下啊。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……真是丟臉。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "哈哈！",
    "voice": "vo_adv_5104000_016",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "有精神最重要啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "茉莉",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的獸人族",
    "words": "順便再拿一個去吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊，",
    "voice": "vo_adv_5104000_017",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳帶了蘋果來吃啊？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咬，",
    "voice": "vo_adv_5104000_018",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嚼嚼……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "吞下。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳已經來啦。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "【王宮騎士團】的全員召集，",
    "voice": "vo_adv_5104000_019",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這還真是稀奇，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也不知道詳細情況。",
    "voice": "vo_adv_5104000_020",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喔，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們的團長登場囉。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所有人，",
    "voice": "vo_adv_5104000_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "聽我說。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今天集合各位只為了一件事。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我想所有團員應該都已經知道了，",
    "voice": "vo_adv_5104000_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n最近獸人族的首領會議，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "將會在蘭德索爾舉辦。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個，",
    "voice": "vo_adv_5104000_023",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "首領會議是什麼？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是由統率各地區的",
    "voice": "vo_adv_5104000_024",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "獸人族首領所召開的會議喔。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "由於獸人族有各自的社會制度及受任命的代表權限等等，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n深入了解的話，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就會發現各族的不同之處……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "社會制度……？",
    "voice": "vo_adv_5104000_025",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "任命……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我記得好像有在【王宮騎士團】的",
