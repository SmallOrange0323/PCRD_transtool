    "type": "dialogue",
    "name": "智",
    "words": "啊～",
    "voice": "vo_adv_5104000_026",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是呢……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "用非常粗略的講法，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n就是獸人族的大人物們",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會集合來開會喔。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘿～",
    "voice": "vo_adv_5104000_027",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關於那場首領會議……",
    "voice": "vo_adv_5104000_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "根據陛下的期望，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了改善與獸人族的關係，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們【王宮騎士團】，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要派出大使進行和平協議。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這將會是",
    "voice": "vo_adv_5104000_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了打破獸人族及人族間厚重的隔閡，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所跨出的一大步。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "同時……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n一旦失敗，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也很可能會成為引發新災難的扳機。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然而，",
    "voice": "vo_adv_5104000_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果能為平民百姓帶來和平，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們的職責就是完成這項任務。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "獸人族跟人族",
    "voice": "vo_adv_5104000_031",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感情變好……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這種事情",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的辦得到嗎？　",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然大家都對我很好，",
    "voice": "vo_adv_5104000_032",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過那是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為我……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "隱瞞了自己",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "獸人族的身分。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在歷史上",
    "voice": "vo_adv_5104000_033",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "與獸人族敵對的【王宮騎士團】中，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n如果自己是獸人族的事實曝光，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "肯定",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會吃不完兜著走。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果只是被大家討厭，",
    "voice": "vo_adv_5104000_034",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
