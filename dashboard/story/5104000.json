    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "總是跟妳在一起的我",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可以保證這點。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正如小智所說喔。",
    "voice": "vo_adv_5104000_048",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這不只是我的個人想法，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也是【王宮騎士團】整體的意見。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說實話，",
    "voice": "vo_adv_5104000_049",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉妳確實還有需要擔心的地方……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但差不多",
    "voice": null,
    "unit_id": 103712
  },
