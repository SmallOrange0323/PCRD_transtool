[
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "テレフェスには模擬店もいっぱい出てましたね。",
    "voice": "vo_adv_5064604_000",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "「きよらか」側は不正の温床だったがな。",
    "voice": "vo_adv_5064604_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "結果として",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "来賓の覚えは高かったようだが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そりゃあそうだろうとしか言いようがない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いえいえ",
    "voice": "vo_adv_5064604_002",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "「しとやか」の模擬店だって、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n素人ながら負けちゃいませんでしたよ？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "クロエ先輩のツンデレメイドカフェとか！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": "vo_adv_5064604_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "他には？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "他には……",
    "voice": "vo_adv_5064604_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ま、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "とくに印象に残ってないですけども。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "やれやれ、",
    "voice": "vo_adv_5064604_005",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "来年はすべての店にクロエ君を派遣するか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いいですね！",
    "voice": "vo_adv_5064604_006",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "今年は半袖ミニスカのキュート全振りバージョンでしたけど、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n来年はシックでクラシカルな正統派メイド服を着せましょう！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なに勝手なこと言ってんだあいつら……",
    "voice": "vo_adv_5064604_007",
    "unit_id": 110813
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110813
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "とりま来年のテレフェスはバックレ確定だな。",
    "voice": null,
    "unit_id": 110813
  }
]
