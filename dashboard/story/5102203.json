[
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們應該",
    "voice": "vo_adv_5102203_000",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是打倒了才對，可是……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感覺好像沒有什麼真實感……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……剛剛那一戰，",
    "voice": "vo_adv_5102203_001",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我已經大致掌握你們的實力了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……她好像一點傷也沒有耶。",
    "voice": "vo_adv_5102203_002",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我明白了……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可見剛剛那一戰她並沒有拿出真本事。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因為我想為觀眾帶來一點刺激感。",
    "voice": "vo_adv_5102203_003",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n如果我輕鬆獲勝，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "看起來也會很無趣不是嗎？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "好了，",
    "voice": "vo_adv_5102203_004",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "現在這個階段",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "就吊吊粉絲們的胃口吧。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我要暫時",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "先撤退了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "等等！",
    "voice": "vo_adv_5102203_005",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……唔，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "被她逃掉了嗎！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……我懶得追上去──",
    "voice": "vo_adv_5102203_006",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "現在好像不適合這麼說呢。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "趕快讓這種事",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "劃下句點吧。",
    "voice": null,
    "unit_id": 123511
  }
]
