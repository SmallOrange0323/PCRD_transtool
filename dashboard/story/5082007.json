  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真期待",
    "voice": "vo_adv_5082007_044",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "新年會呢！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不曉得有什麼料理在等著我們！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "貪吃佩可小姐，",
    "voice": "vo_adv_5082007_045",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳口水已經流下來了……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也",
    "voice": "vo_adv_5082007_046",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常期待。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": "vo_adv_5082007_047",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳就在新年會上大吃特吃吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5082007_048",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_5082007_049",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還以為妳一定會阻止她……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然我們是受招待的那一方，",
    "voice": "vo_adv_5082007_050",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那當然是免費……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "更何況這是給那個該死的眼鏡女好看的機會！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳儘管大吃特吃",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓公會管理協會嚇破膽吧！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好！",
    "voice": "vo_adv_5082007_051",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會盡情享受的！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "凱留真是的……",
    "voice": "vo_adv_5082007_052",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "畢竟是難得的機會，得好好享受才行呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說得沒錯，",
    "voice": "vo_adv_5082007_053",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐。",
