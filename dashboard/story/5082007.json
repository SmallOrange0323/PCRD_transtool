  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "所有成員到齊並備好食材，當【美食殿堂】正順利地進行",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n年菜派對的準備時，那名人物出現了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "來了來了～",
    "voice": "vo_adv_5082007_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以麻煩妳去看是誰嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好啊。",
    "voice": "vo_adv_5082007_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n來了～請問是哪位……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您好，",
    "voice": "vo_adv_5082007_002",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我是公會管理協會的人員。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "剛才妳",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「呃」",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "地叫了一聲嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來客是花凜小姐。",
    "voice": "vo_adv_5082007_003",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "歡迎，",
    "voice": "vo_adv_5082007_004",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "花凜小姐。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n請問怎麼了？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼了？",
    "voice": "vo_adv_5082007_005",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該不會又是什麼麻煩事吧……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "才不是那麼一回事呢。",
    "voice": "vo_adv_5082007_006",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次我可是……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "帶了感謝狀",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要給【美食殿堂】的各位！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是給我們的嗎？",
    "voice": "vo_adv_5082007_007",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這真是太光榮了！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯，",
    "voice": "vo_adv_5082007_008",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_5082007_009",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是對什麼事的感謝狀？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是",
    "voice": "vo_adv_5082007_010",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你們前幾天解決獨占強奪吉祥物的事件！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們接獲了流夏小姐和伊莉亞小姐的報告。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是主人和雪菲小姐的功勞呢。",
    "voice": "vo_adv_5082007_011",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃，",
    "voice": "vo_adv_5082007_012",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "報告上說",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是【美食殿堂】所有人的協助……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳妳妳、",
    "voice": "vo_adv_5082007_013",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳在說什麼啊～？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是",
    "voice": "vo_adv_5082007_014",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說啊。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我不知道妳在說什麼耶。",
    "voice": "vo_adv_5082007_015",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "各位，",
    "voice": "vo_adv_5082007_016",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "妳們是怎麼了？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "請妳別在意……",
    "voice": "vo_adv_5082007_017",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這樣啊，",
    "voice": "vo_adv_5082007_018",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "然後，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "除了感謝狀之外，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次事件的受害者們，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n也給了你們非常多的謝禮。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那就不必了，",
    "voice": "vo_adv_5082007_019",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我們只是做了應當的事情。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就知道妳會這麼說，",
    "voice": "vo_adv_5082007_020",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n因此謝禮",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "現在由公會管理協會暫時代領了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們",
    "voice": "vo_adv_5082007_021",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這種部分",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很狡猾啊……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因此，",
    "voice": "vo_adv_5082007_022",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "公會管理協會將舉辦新年會兼表揚派對，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n並想招待",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "【美食殿堂】的各位以主賓的身分來參加！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們準備了謝禮與許多的料理，",
    "voice": "vo_adv_5082007_023",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n請你們務必來參加。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "派對嗎？",
    "voice": "vo_adv_5082007_024",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不錯耶！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這真是太棒了。",
    "voice": "vo_adv_5082007_025",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下。",
    "voice": "vo_adv_5082007_026",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我們目前正在準備的年菜派對要怎麼辦啦？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "既然如此，",
    "voice": "vo_adv_5082007_027",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就帶著我們的年菜",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "去和大家一起吃吧。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這主意",
    "voice": "vo_adv_5082007_028",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不錯耶！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真不愧是小雪菲！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是好主意。",
    "voice": "vo_adv_5082007_029",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好吧，",
    "voice": "vo_adv_5082007_030",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然你們都這麼說了……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣可以嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "花凜。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的，",
    "voice": "vo_adv_5082007_031",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我覺得這主意非常有【美食殿堂】的風格。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……！",
    "voice": "vo_adv_5082007_032",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她是這樣說的呢，",
    "voice": "vo_adv_5082007_033",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小雪菲。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是很有",
    "voice": "vo_adv_5082007_034",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐風格的好主意。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不錯嘛。",
    "voice": "vo_adv_5082007_035",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯……",
    "voice": "vo_adv_5082007_036",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "詳細的地點，會在近期內聯絡各位。",
    "voice": "vo_adv_5082007_037",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "在各位繁忙時打擾了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "祝各位",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有個好年。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也祝花凜小姐",
    "voice": "vo_adv_5082007_038",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有個好年。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "still",
    "still_id": "508200701"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼",
    "voice": "vo_adv_5082007_039",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然決定好了，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就來努力做料理吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}也要來幫忙喔。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一起來把新的一年",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也變成最棒的一年吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也會",
    "voice": "vo_adv_5082007_040",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "盡全力來照顧主人的。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之",
    "voice": "vo_adv_5082007_041",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就在別太勉強自己的範圍內努力吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過這些話",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算對你說也是白說吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一定沒問題的，",
    "voice": "vo_adv_5082007_042",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因為有大家在啊。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "謝謝你",
    "voice": "vo_adv_5082007_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "這一年的關照。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "\\n明年也",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "請你多多指教。",
    "voice": null,
    "unit_id": null
  },
