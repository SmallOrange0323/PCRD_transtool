[
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔……",
    "voice": "vo_adv_5110204_000",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不喜歡這地方……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n感覺很不舒服……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是說啊……",
    "voice": "vo_adv_5110204_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個魔物",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就在這裡，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且有好幾隻。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看來這裡應該就是",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "它們的巢穴了。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不僅如此，",
    "voice": "vo_adv_5110204_002",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "它們看起來比先前對戰過的傢伙們還強呢！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不會被嚇傻了吧？",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不要小看",
    "voice": "vo_adv_5110204_003",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶像的膽量哦。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然我不知道那個魔物是什麼，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但我絕不會放任不管的。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都來到這裡了，誰還會怕啊。",
    "voice": "vo_adv_5110204_004",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我都還沒好好地大打一架呢！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要打就來打吧！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很好，",
    "voice": "vo_adv_5110204_005",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "進入第二回合囉！",
    "voice": null,
    "unit_id": 125014
  }
]
