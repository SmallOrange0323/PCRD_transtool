[
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "吶，",
    "voice": "vo_adv_5106302_000",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那棵聖誕樹",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "又開始動了喔？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "復活得太快了吧～",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "到底還要再來幾次？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "已經動不了了……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果敵人會復活，不管幾次都要再戰，",
    "voice": "vo_adv_5106302_001",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這才是",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正義的天使吧？",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茜里！",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是沒錯……",
    "voice": "vo_adv_5106302_002",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n可是都已經激戰了一輪，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "用盡各種方法進攻了，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "為什麼它還不升天呢？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里又沒有鬆懈～",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然啊！",
    "voice": "vo_adv_5106302_003",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茜里不可能會鬆懈。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再撐一下，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也會幫妳一把，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一起讓那傢伙升天吧！",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "原來像純小姐這麼單純的人，",
    "voice": "vo_adv_5106302_004",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n甚至不會注意到茜里話中的毛病啊。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那我也加入吧。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "目標是讓它升天！",
    "voice": null,
    "unit_id": 124111
  }
]
