  {
    "type": "dialogue",
    "name": "安",
    "words": "……咦，",
    "voice": "vo_adv_1092003_058",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "什麼？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　要我看這個……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n釣到的魚？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不過",
    "voice": "vo_adv_1092003_059",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "這些怎麼了嗎……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "{0}……",
    "voice": "vo_adv_1092003_060",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……呵呵，",
    "voice": "vo_adv_1092003_061",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "努力過了呢！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "謝謝你，{0}！",
    "voice": "vo_adv_1092003_062",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我好像打起精神了。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "好！",
    "voice": "vo_adv_1092003_063",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n釣到這麼多條魚，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "差不多也該回去了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我要做超～多豐盛又美味的魚料理！",
    "voice": "vo_adv_1092003_064",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "希望古蕾婭和大家都能喜歡就好了～！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊，",
    "voice": "vo_adv_1092003_065",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對了。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "在料理完成之前，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "得禁止\\n古蕾婭進到育幼院才行！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "{0}，你幫到這就夠了！",
    "voice": "vo_adv_1092003_066",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我想要一個人努力做料理。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "因為我也想給你一個驚喜。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "恢復正常狀態的安，\\n在回去的路上，始終展露出無比燦爛的笑容。",
    "voice": null,
    "unit_id": null
  }
]
