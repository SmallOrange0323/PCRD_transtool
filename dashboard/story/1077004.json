  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那天晚上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "…………",
    "voice": "vo_adv_1077004_000",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……結果，",
    "voice": "vo_adv_1077004_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一個客人也沒來呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼呢？",
    "voice": "vo_adv_1077004_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然對我來說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能在客人沒來的時候，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n把工作方法之類的",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好好練習一輪，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以覺得得救了。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過對店裡來說，",
    "voice": "vo_adv_1077004_003",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "客人不來的話",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然很困擾吧……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就是呢……",
    "voice": "vo_adv_1077004_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這下子也許得認真思考全家同歸於盡了也說不定。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "別、",
    "voice": "vo_adv_1077004_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "別這麼灰心啊，店長！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不能這麼悲觀！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我也會一起加油的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請您打起精神來～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "謝謝……",
    "voice": "vo_adv_1077004_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過冷靜地思考後覺得，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n明明是來海邊玩的季節，卻沒有客人來",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "果然有點奇怪呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "今天太陽也下山了，",
    "voice": "vo_adv_1077004_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "雖然店也要打烊了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n明天……開店前，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我會稍微試著在城鎮調查各種情報還有宣傳之類的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我想一邊查明海邊空無一人的原因，",
    "voice": "vo_adv_1077004_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n一邊想辦法招攬客人。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就像你說的，",
    "voice": "vo_adv_1077004_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不能這麼悲觀……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n夏天才正要開始呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就、",
    "voice": "vo_adv_1077004_010",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就是這個志氣哦！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。",
    "voice": "vo_adv_1077004_011",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那麼也許明天開始",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "客人就會蜂湧過來，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n會變得很忙也說不定呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "既然要打烊的話，",
    "voice": "vo_adv_1077004_012",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我想今天就快點回去，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好好的休息。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯。",
    "voice": "vo_adv_1077004_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n鈴莓辛苦你，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "先給你今天工作的薪水。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊啊……",
    "voice": "vo_adv_1077004_014",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不對",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "今天",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒什麼客人，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "根本沒什麼工作！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "出勤工作一直到最後一天為止，",
    "voice": "vo_adv_1077004_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n再看營業額之類的",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "結算差不多的薪水給我就好了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這樣不行啦。",
    "voice": "vo_adv_1077004_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n而且打工招募的事項上面，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n也寫著每天會",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好好支付薪水呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不會不會，",
    "voice": "vo_adv_1077004_017",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒問題的啦。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n話說如果",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為我領薪水的關係，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n害得店長一家人要上吊自殺的話，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我晚上會睡不著覺的。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯嗯。",
    "voice": "vo_adv_1077004_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不好意思呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "明天開始我會好好地招攬客人產出營收，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n然後支付你薪水的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "拜託別拋下我，",
    "voice": "vo_adv_1077004_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "希望你明天也能來好好地工作。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n如果能順利的產出營收，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n再努力一點的話也許能付你獎金！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不～，",
    "voice": "vo_adv_1077004_020",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請別太勉強自己呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對我來說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "光是能讓我獲得這麼珍貴的經驗，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就已經非常的感激您了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼那麼，",
    "voice": "vo_adv_1077004_021",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我先回去囉～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明天見，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還請多多指教哦♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯嗯。",
    "voice": "vo_adv_1077004_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真是個好孩子……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n就算是為了鈴莓也好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "來努力地招攬客人吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉……",
    "voice": "vo_adv_1077004_023",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n天色完全變暗了呢，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "得快回去才行。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n如果太晚回去的話，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會讓大小姐他們擔心呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過這種感覺，",
    "voice": "vo_adv_1077004_024",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還滿新奇的呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可能因為以前",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總是在家裡，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n等著大小姐和其它人回來的關係）",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的，",
    "voice": "vo_adv_1077004_025",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "從店長那邊得到了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很珍貴的經驗呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……嗯？",
    "voice": "vo_adv_1077004_026",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦，{0}！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "晚安～，",
    "voice": "vo_adv_1077004_027",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還待在海邊呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不過太陽已經下山了有點涼，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n像這樣還穿著泳裝發呆的話",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會感冒的哦？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚啊！？",
    "voice": "vo_adv_1077004_028",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼突然發光了呢……！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉呀，",
    "voice": "vo_adv_1077004_029",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉呀呀？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嚇到的瞬間被沙子給絆倒了，要、要跌倒了……！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "background",
    "bg_id": "510190"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？",
    "voice": "vo_adv_1077004_030",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你好呀～、{0}♪",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。",
    "voice": "vo_adv_1077004_031",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}也來泳池玩嗎？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "畢竟最近",
    "voice": "vo_adv_1077004_032",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "每天都好熱呢～。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我們家",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為大小姐不太愛開冷氣之類的，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n夜晚變得悶熱的話，真的難以入睡。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為這樣，有點睡眠不足……",
    "voice": "vo_adv_1077004_033",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然身為女僕，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n必須在任何時候都做好能侍奉主人的萬全準備才行。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不不，這是理所當然的技能！",
    "voice": "vo_adv_1077004_034",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n而且雖然嘴上說得很了不起，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但能不能做到還很難說……♪",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的。",
    "voice": "vo_adv_1077004_035",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n今天純粹是來陪大家～，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有游泳的打算。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我原本就沒帶泳裝。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。",
    "voice": "vo_adv_1077004_036",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然這麼說有點晚。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為大小姐要和同學一起去泳池玩，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以才來陪他的。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "偶爾也會有",
    "voice": "vo_adv_1077004_037",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣的時候……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n雖然大小姐多半會說，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n鈴莓也一起來玩吧～",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像這樣邀請我。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但因為大小姐的同學，",
    "voice": "vo_adv_1077004_038",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "都是比我年長的高中生……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n與其說有點讓人害怕，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "比較像是讓人感到誠惶誠恐。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過如果有什麼狀況的話，",
    "voice": "vo_adv_1077004_039",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還是希望能在她身邊馬上幫她處理……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然很煩惱，",
    "voice": "vo_adv_1077004_040",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n像這樣保持微妙的距離，有種從遠方守護她的感覺。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "只是遠遠地眺望著，",
    "voice": "vo_adv_1077004_041",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好像玩得很開心的大小姐……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就很滿足了。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是什麼都無法取代的幸福短暫時光哦。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。難得來泳池，",
    "voice": "vo_adv_1077004_042",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n雖然不游泳的話好像很可惜。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是因為我很冒失，",
    "voice": "vo_adv_1077004_043",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不小心溺水的話好像會給你添麻煩……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀哇？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇，",
    "voice": "vo_adv_1077004_044",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n才剛說完就犯了冒失，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n在濕濕的泳池地板上腳滑……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要跌倒了！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "話說，",
    "voice": "vo_adv_1077004_045",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要掉到泳池了……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊啊啊！？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咕嚕咕嚕……",
    "voice": "vo_adv_1077004_046",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我又做了冒失的事！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　好、好難受！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n衣服纏繞著身體，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒辦法隨心所欲的動作！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如、",
    "voice": "vo_adv_1077004_047",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果知道會這樣，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也許早點穿著泳裝就好了？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n雖然這麼說，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "現在才感嘆也只能算馬後砲呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總之先認真的在溺水前，",
    "voice": "vo_adv_1077004_048",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n想辦法浮上水面……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇，",
    "voice": "vo_adv_1077004_049",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}突然跳進來了呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是打算",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來救我……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "的嗎？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊……？",
    "voice": "vo_adv_1077004_050",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}，\\n頭是不是",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "撞到泳池的底部了？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為氣勢十足地跳進來呢……！",
    "voice": "vo_adv_1077004_051",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嗚哇，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有沒有失去意識？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}～！\\n沒事的，",
    "voice": "vo_adv_1077004_052",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我現在就來救你哦！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾分鐘後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼、",
    "voice": "vo_adv_1077004_053",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你沒事吧，{0}？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊啊，",
    "voice": "vo_adv_1077004_054",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這下已經完全失去意識了呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n該怎麼辦才好啊，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這種時候……？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n回想起溺水事件時的緊急處理手冊吧！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "首先要確保呼吸道暢通，",
    "voice": "vo_adv_1077004_055",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "按摩心臟！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "喝啊喝啊，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "快復活～吧！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "still",
    "still_id": "107700401"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "然後",
    "voice": "vo_adv_1077004_056",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘴對嘴人工呼吸……！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "…………",
    "voice": "vo_adv_1077004_057",
    "unit_id": 102531
  },
  {
    "type": "still",
    "still_id": "107700402"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……嗚嗚，",
    "voice": "vo_adv_1077004_058",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我在猶豫什麼呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這個是神聖的，拯救生命啊！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這和親吻是不一樣的事情，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不需要覺得害羞",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "才對！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "抱歉了，",
    "voice": "vo_adv_1077004_059",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}！\\n雖然可能是你的第一次，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n對於要奪走你人生只有一次重要的那個我也感到很難過！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "still",
    "still_id": "107700403"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒辦法，",
    "voice": "vo_adv_1077004_060",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請原諒我！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就算之後責怪我也沒關係，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}的生命",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "比較重要！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "………！",
    "voice": "vo_adv_1077004_061",
    "unit_id": 102531
  },
  {
    "type": "background",
    "bg_id": "510190"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀哇！？",
    "voice": "vo_adv_1077004_062",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嚇了我一跳，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}恢復呼吸了呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "太好了～，",
    "voice": "vo_adv_1077004_063",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是千鈞一髮！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n剛剛真的很危險呢！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是的。",
    "voice": "vo_adv_1077004_064",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然全都是因為我的冒失，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好像也不太能對你說教……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不過救人的人竟然還溺水什麼的，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是難以想像的大失誤呢。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "給我好好反省！",
    "voice": "vo_adv_1077004_065",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過太好了，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}平安無事。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉呀……",
    "voice": "vo_adv_1077004_066",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n因為大小姐好像察覺到騷動就跑了過來，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我去解釋一下事情的原委哦。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}呢，",
    "voice": "vo_adv_1077004_067",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n總之先不要動",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "給我保持安靜。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "等一下，",
    "voice": "vo_adv_1077004_068",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會好好地和你道謝還有賠罪。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n……那麼，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就暫時先離開囉♪",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦你了。",
    "voice": "vo_adv_1077004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1077004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n醒來之後，就會全都忘光囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不是我要說，你真的是很常差點死掉呢……",
    "voice": "vo_adv_1077004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n難道是命中帶有劫難嗎，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你冒失的程度偶爾和鈴莓不相上下，還是說你犯的程度比他還厲害？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "小心一點哦～，",
    "voice": "vo_adv_1077004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只要生命還在就有無限可能呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n特別是『這邊』",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "相對『那邊』該說是氣氛比較肅殺嗎，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這邊的世界是血腥殘酷的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一不小心，真的就會突然死掉哦。",
    "voice": "vo_adv_1077004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過算了。",
    "voice": "vo_adv_1077004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在夜裡的海邊睡著的話，好像會被海浪捲走……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n快點給我醒來，{0}。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後，好好慰勞一下一直都很努力工作的女僕吧♪",
    "voice": "vo_adv_1077004_075",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼嚕、",
    "voice": "vo_adv_1077004_076",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……",
    "voice": "vo_adv_1077004_077",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哈嗚？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n奇怪，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我真是的，不小心睡著了嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唔……",
    "voice": "vo_adv_1077004_078",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在沙灘摔了一大跤，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好像就這樣",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "輕易地失去意識了呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "太丟臉了～，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我真是冒失啊♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊啊，",
    "voice": "vo_adv_1077004_079",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "女僕裝都沾滿沙子了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n回去之後得洗一洗才行。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸，",
    "voice": "vo_adv_1077004_080",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}就睡在我的正側方！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n為什麼呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為了掩護跌倒的我，",
    "voice": "vo_adv_1077004_081",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "滑倒掉進去……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n被倒下的我給撞倒的時候撞到了頭，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n然後就暈過去了嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然不是很懂……",
    "voice": "vo_adv_1077004_082",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}的臉也太近了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不小心就會親到嘴的距離啊～。",
    "voice": "vo_adv_1077004_083",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不行，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要等變成大人之後才行！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}！",
    "voice": "vo_adv_1077004_084",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n快醒來，{0}！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不醒來的話，",
    "voice": "vo_adv_1077004_085",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n難、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難道要人工呼吸嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸，",
    "voice": "vo_adv_1077004_086",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請不要突然坐起來，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "剛剛",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我說的話你都聽到了嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請把它忘記，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那是我一時混亂！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚……",
    "voice": "vo_adv_1077004_087",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總之因為夜已經深了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請注意著腳步朝著住宿地點前進吧。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這裡也算是城鎮外，",
    "voice": "vo_adv_1077004_088",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以可能會出現魔物之類的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請好好地戒備。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像這樣悠閒的睡懶覺是不行的哦？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哈哈。",
    "voice": "vo_adv_1077004_089",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n雖然你的心意我很開心，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過應該不用了。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你看，",
    "voice": "vo_adv_1077004_090",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看得到嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好像因為我晚歸的關係，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n大小姐擔心我",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就跑來迎接的樣子。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是的，",
    "voice": "vo_adv_1077004_091",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總是愛操心呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐～！",
    "voice": "vo_adv_1077004_092",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n鈴莓在這裡，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思讓您擔心了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請放心！",
    "voice": "vo_adv_1077004_093",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n無論發生什麼事，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會好好地回到大小姐的身邊！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。",
    "voice": "vo_adv_1077004_094",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就先告辭了哦……{0}。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【美食殿堂】的大家，旅行",
    "voice": "vo_adv_1077004_095",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "預計是四天三夜嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明天也能遇到呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n如果可以的話，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明天請再光顧海之家吧。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼那麼，",
    "voice": "vo_adv_1077004_096",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明天見囉……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在這個大海再次相見吧♪",
    "voice": null,
    "unit_id": 102511
  }
]
