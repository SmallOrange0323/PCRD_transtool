[
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "聖学祭の花形、",
    "voice": "vo_adv_5064605_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "全員参加の総合リレーか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いま目を閉じれば、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "嗚呼、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あのときの光景が目蓋によみがえる。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n風となって走るぼく、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "視界を流れてゆく景色、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "耳朶を打つ歓声……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "…………",
    "voice": "vo_adv_5064605_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "お、",
    "voice": "vo_adv_5064605_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おいクロエ君、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なぜツッコんでくれないんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ユニ先輩走ってないじゃん、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "と殺し屋のような目で言ってくれ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "このままでは、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まるでぼくの虚言癖ないし",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "妄想癖みたいじゃあないか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え……",
    "voice": "vo_adv_5064605_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あ、なんすか？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nぜんぜん聞いてなかった。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ちょっと今、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "目蓋にミフユねえさんの勇姿浮かんでたんで。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おいおいおい、",
    "voice": "vo_adv_5064605_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼかあ寂しいぞ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君はいつだって",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ユニ先輩ユニ先輩と懐いていたじゃあないか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "遠慮などいらん、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この小さな胸にとびこんでくるんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "さあ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おいで。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え……",
    "voice": "vo_adv_5064605_005",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あ、なんすか？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nぜんぜん聞いてなかった。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "クロエくぅ～ん……！",
    "voice": "vo_adv_5064605_006",
    "unit_id": 116411
  }
]
