[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有一天{0}收到一張滿是暗號的信，\\n原來是修特帕魯叫他出來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特呦，你終於來了！",
    "voice": "vo_adv_1009005_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我叫你來，只為了一件事……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "前幾天，我學了一個新的魔法！",
    "voice": "vo_adv_1009005_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我心一橫，買了一本價格昂貴的魔法書，",
    "voice": "vo_adv_1009005_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n那本書真不錯呀。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "託它的福我學到了強大的魔法呦！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呃……！",
    "voice": "vo_adv_1009005_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對、對呀！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我是無所不知的！我已學會全部的魔法！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n根本無需學習新的魔法！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個……是那個呀！",
    "voice": "vo_adv_1009005_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我在閱讀魔法書的時候，回想起前世的記憶了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "所以也想起了我曾經使用過的魔法呀！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我之前和你一起，對抗眾神的支配……",
    "voice": "vo_adv_1009005_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n在被稱為最後之戰的戰爭下，舊世界被消滅了。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我和你都化成了靈魂，失去了許多記憶和能力……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "比起那些事，我想立刻試試剛剛想起來的魔法！",
    "voice": "vo_adv_1009005_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你來幫我一起追捕通緝犯吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……那麼，根據情報來源說，",
    "voice": "vo_adv_1009005_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n有目擊者在這附近看見疑似通緝犯的人……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1009005_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喔！找到了……那傢伙就是通緝犯呀！",
    "voice": "vo_adv_1009005_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "跟通緝單上的人一模一樣。走吧，吉格魯特呦！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那裡的通緝犯！",
    "voice": "vo_adv_1009005_010",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你就乖乖束手就擒吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嘖，是賞金獵人啊！？",
    "voice": "vo_adv_1009005_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嚐嚐我的宇宙極新必殺技！",
    "voice": "vo_adv_1009005_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "天空深處傳出的怒吼呀，燃燒一切吧──！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n「天冥風哭雷陣掌」！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嗚哇！！這、這是什麼攻擊！",
    "voice": "vo_adv_1009005_013",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "想殺了我嗎！我死了的話你也拿不到獎金的！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……咦？沒有擊中？",
    "voice": "vo_adv_1009005_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對了！因為是剛學到的魔法，",
    "voice": "vo_adv_1009005_015",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "未能好好地控制……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那就多擊個幾發來補救吧！",
    "voice": "vo_adv_1009005_016",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看招！看招！看招吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "哈哈，你在瞄準哪裡啊！全部都沒打中耶！",
    "voice": "vo_adv_1009005_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "我就趁這機會逃走啦，再見了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊！等一下！",
    "voice": "vo_adv_1009005_018",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟糕……我沒有體力了……",
    "voice": "vo_adv_1009005_019",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n似、似乎是剛才消耗了過多的魔力……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n本來應該是能一擊必殺的魔法啊……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但這樣下去，那傢伙就會逃跑了……！",
    "voice": "vo_adv_1009005_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "抓不到的話，這個月的魔法書書費……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不行，不能這樣！",
    "voice": "vo_adv_1009005_021",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n書店還等著我付錢呢！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個月內付不了錢的話，那就麻煩了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你一個人去的話太危險了。",
    "voice": "vo_adv_1009005_022",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n因為你還沒完全想起前世的記憶啊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "出了什麼事就麻煩了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不管怎樣一定要快點追上去……",
    "voice": "vo_adv_1009005_023",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n但我的魔力見底，光站著就耗盡全力了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼辦……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": "vo_adv_1009005_024",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特呦！你背著我走吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我看那傢伙跑得應該不快。",
    "voice": "vo_adv_1009005_025",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n好險這裡沒有什麼遮蔽物……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就算你背著我跑，應該也能追上他的！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你願意背我嗎！那就拜託你了！",
    "voice": "vo_adv_1009005_026",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是……果然還是覺得害羞啊。",
    "voice": "vo_adv_1009005_027",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我是第一次被父親以外的男人背著……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特呦，出發吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯……！你跑得……還蠻快的呢！",
    "voice": "vo_adv_1009005_028",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且感覺還很舒服呢？不愧是吉格魯特！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "快跑吧，吉格魯特！如同魔狼地獄犬一般！",
    "voice": "vo_adv_1009005_029",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "追捕那傢伙應該比在地獄奔跑更容易啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嘖！竟然追上來了！？",
    "voice": "vo_adv_1009005_030",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "越來越接近那傢伙了！",
    "voice": "vo_adv_1009005_031",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "做得不錯！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接下來輪到我出手了。",
    "voice": "vo_adv_1009005_032",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吉格魯特背著我的時候，魔力回復到",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n可以使出一次攻擊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這次一定要擊中！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼哼……不用擔心！安心吧吉格魯特。",
    "voice": "vo_adv_1009005_033",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我的魔法百發百中！這次一定會成功！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "天空深處傳出的怒吼呀，燃燒一切吧──！",
    "voice": "vo_adv_1009005_034",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n「天冥風哭雷陣掌」──！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嗚哇哇哇！？",
    "voice": "vo_adv_1009005_035",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看到了嗎！？",
    "voice": "vo_adv_1009005_036",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n漂亮地擊中了――",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚哇！",
    "voice": "vo_adv_1009005_037",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！？你為什麼突然倒下了！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒事吧吉格魯特！",
    "voice": "vo_adv_1009005_038",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "快回答我呀！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "振作一點，我的盟友！",
    "voice": "vo_adv_1009005_039",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們和機關之間的戰鬥還未結束啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哦哦，太好了……",
    "voice": "vo_adv_1009005_040",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我很擔心呀！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n沒事就好了！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你還活著呀吉格魯特！你因為追他而耗盡體力了吧……",
    "voice": "vo_adv_1009005_041",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接下來只要把通緝犯抓回去就可以了。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你在這裡休息一會吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……咳、咳咳！",
    "voice": "vo_adv_1009005_042",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呃……在這之前……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個……{0}，",
    "voice": "vo_adv_1009005_043",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n今天……和我一起追捕通緝犯，謝謝你……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你幫了我大忙……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是第一次{0}\\n被她叫本名，而不是叫吉格魯特。",
    "voice": null,
    "unit_id": null
  }
]
