[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了幫助【咲戀育幼院】的生計，\\n鈴莓開始在海之家打工。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然原本還對不太習慣的工作感到煩惱，\\n但之後也漸漸變得有趣了起來，\\n鈴莓今日也滿心雀躍地出門工作了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼，",
    "voice": "vo_adv_5004002_000",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "今天我也去海之家打工了哦♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5004002_001",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "路上小心～……？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "路上小心！",
    "voice": "vo_adv_5004002_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n家裡的事情就不用操心了，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我們會把家事處理得妥妥當當的！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "工作加油哦，",
    "voice": "vo_adv_5004002_003",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "鈴莓姐……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_5004002_004",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n來送鈴莓出門吧，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……♪",
    "voice": "vo_adv_5004002_005",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "慢著慢著，",
    "voice": "vo_adv_5004002_006",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "用餐時離席是很沒禮貌的喔？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒錯～",
    "voice": "vo_adv_5004002_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要先把早餐的碗盤收拾乾淨喔。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳們用不著這麼盛大地為我送行啦，",
    "voice": "vo_adv_5004002_008",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n又不是",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這輩子都不會再見。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我出門囉♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好。",
    "voice": "vo_adv_5004002_009",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "路上小心喔",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "，鈴莓姐……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_5004002_010",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "的心情看上去不錯呢。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n海之家的工作，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有那麼開心嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "鈴莓姐",
    "voice": "vo_adv_5004002_011",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "最喜歡工作了嘛……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "最近又這麼悶熱，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n感覺待在海水浴場附近",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就能感受到涼爽舒適的空氣……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哼。",
    "voice": "vo_adv_5004002_012",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只有鈴莓可以去真狡猾～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們也想去海邊玩啊？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "跟可可蘿她們去買東西時，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n也難得幫我們買了泳裝了啊！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不行～只有妳們幾個孩子去太危險了。",
    "voice": "vo_adv_5004002_013",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要去的話等我這邊的工作有空檔再帶妳們去，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳們不可以擅自跑去，知道嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好吧……",
    "voice": "vo_adv_5004002_014",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽一直在工作，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n感覺根本沒有「有空檔」的一天啊……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就是說啊～",
    "voice": "vo_adv_5004002_015",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不能光等待哪天有空，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不自己騰出時間的話就永遠去不了海邊了。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "既然如此",
    "voice": "vo_adv_5004002_016",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們也在能力所及的範圍內，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "一起幫忙處理咲戀媽媽的工作吧……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為想要趕快跟大家一起去海邊，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n也好想看看鈴莓姐姐工作的樣子……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，我也想看！",
    "voice": "vo_adv_5004002_017",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓這麼冒失，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n真擔心她能不能好好的工作……♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不行～",
    "voice": "vo_adv_5004002_018",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們會打擾她工作的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊討厭，咲戀媽媽只會說「不行不行」的！",
    "voice": "vo_adv_5004002_019",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……",
    "voice": "vo_adv_5004002_020",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n咲戀媽媽的臉色怎麼有點不好，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n沒事吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "一定是因為鈴莓姐姐，",
    "voice": "vo_adv_5004002_021",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n不像以往一樣一直在身邊，所以感到寂寞了吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯～果然給人這種感覺嗎。",
    "voice": "vo_adv_5004002_022",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不知為何有一種鬱悶感……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看鈴莓一副相當開心的模樣，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n就會",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "讓我想很多。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然她是自願來這裡工作的……",
    "voice": "vo_adv_5004002_023",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但身為我的女僕為我工作，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n會不會其實有什麼不滿呢？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "她應該也有很多自己想做的事情吧。",
    "voice": "vo_adv_5004002_024",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n陪著我工作，讓她辛苦又很不自由。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n她明明",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還處於享受青春時光的年紀的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳居然在想這些啊，",
    "voice": "vo_adv_5004002_025",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咲戀媽媽？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真傻耶，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓有跟妳說過任何抱怨的話嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……",
    "voice": "vo_adv_5004002_026",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n別擔心，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n鈴莓姐姐",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "最喜歡咲戀媽媽了……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這一點我是相信的啦。",
    "voice": "vo_adv_5004002_027",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真討厭……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n感覺像最要好的姊妹",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要出嫁似的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我在意這種事",
    "voice": "vo_adv_5004002_028",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也真是太不成熟了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……嗯？",
    "voice": "vo_adv_5004002_029",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "？　怎麼了嗎，",
    "voice": "vo_adv_5004002_030",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咲戀媽媽？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……不好了。",
    "voice": "vo_adv_5004002_031",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我剛剛瞄到",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今早發行的報紙。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們看，",
    "voice": "vo_adv_5004002_032",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n上面寫說「瑪爾傑海岸發生異變！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "　奇妙的魔物出沒中！」……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我記得",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓打工的地點是瑪爾傑海岸沒錯吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這可不行，我得馬上去把鈴莓叫回來才行！",
    "voice": "vo_adv_5004002_033",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n她應該還沒走遠吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓～！",
    "voice": "vo_adv_5004002_034",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳可不能過去，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "現在海邊很危險啊……！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好，",
    "voice": "vo_adv_5004002_035",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "到了♪",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵。",
    "voice": "vo_adv_5004002_036",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "偶然共乘到了同方向的馬車，\\n真是幫了大忙。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一下子就到海邊來了～",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這世上還是有好人存在的。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在更衣室裡把泳裝換好，",
    "voice": "vo_adv_5004002_037",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "準備完畢。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n店長好像還沒到的樣子，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但事先把鑰匙交給我了……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那就在開店前，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我先把店裡打掃一下吧？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，",
    "voice": "vo_adv_5004002_038",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大概是因為還早，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n海邊一個人都沒有呢……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "昨天海之家也是一直門可羅雀，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒事做挺無聊的。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "除了剛好來海水浴場玩的【美食殿堂】",
    "voice": "vo_adv_5004002_039",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那些人之外，就沒有其他人了……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼會這樣呢，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明明是海水浴場的旺季啊？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然本來就不太想給陌生人看到自己穿泳裝的樣子，",
    "voice": "vo_adv_5004002_040",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這樣反倒是好事……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但都沒有客人光顧的話，",
    "voice": "vo_adv_5004002_041",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n什麼也沒做卻領工資，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "心裡也是會過意不去的。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "今天就",
    "voice": "vo_adv_5004002_042",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來努力招攬顧客上門吧。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n看看情況也要中午了，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "馬上到城鎮上去做個宣傳吧……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉呀？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……咦？",
    "voice": "vo_adv_5004002_043",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n奇怪，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "岸邊有什麼東西在動？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那、",
    "voice": "vo_adv_5004002_044",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　魔物？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個是……？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難道是，{0}？",
    "voice": "vo_adv_5004002_045",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你是{0}對吧……？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": "vo_adv_5004002_046",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然沒錯？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n{0}你全身溼答答的又有海藻披在身上，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n看起來很像是什麼",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謎之生物呢～？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊！？",
    "voice": "vo_adv_5004002_047",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　嚇、嚇死我了！",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請不要發出那種奇怪的聲音啦！",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，這個聲音確實是……{0}對吧？",
    "voice": "vo_adv_5004002_048",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你全身溼答答的，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在這種地方做什麼呢……？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……你沒事吧？",
    "voice": "vo_adv_5004002_049",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n為什麼會",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "倒在這種地方呢？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊啊，",
    "voice": "vo_adv_5004002_050",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "全身都是海水……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我有毛巾，幫你擦乾淨吧。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "擦擦♪",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "話說，",
    "voice": "vo_adv_5004002_051",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}受了不少傷呢……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n幫、",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "幫你施展恢復魔法吧？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿，",
    "voice": "vo_adv_5004002_052",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "打起精神來……☆",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有、",
    "voice": "vo_adv_5004002_053",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有效果嗎？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哪裡痛嗎？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不不，",
    "voice": "vo_adv_5004002_054",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請別客氣。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "話說回來，到底發生什麼事了……？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請你說明一下，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我來幫忙！",
    "voice": null,
    "unit_id": 107711
  }
]
