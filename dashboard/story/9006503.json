    "words": "\\n剛才返回索爾之塔時，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我向世界各地請求支援。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因此，趕來這裡集合的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是這群救兵♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，",
    "voice": "vo_adv_9006503_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當然不是只有她們兩位。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你到目前為止所遇見",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "並結識的人們，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n能夠聯繫上的，我都盡可能地把他們找來了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，在這之後，",
    "voice": "vo_adv_9006503_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n應該還會有其他的救兵趕過來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n呵呵♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怎樣？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是不是放心了不少啊？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是這麼一回事。",
    "voice": "vo_adv_9006503_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，你們要懷抱更多的希望！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n想要拯救世界的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n並不是只有你們而已喔……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦……？",
    "voice": "vo_adv_9006503_032",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "那傢伙說得沒錯……",
    "voice": "vo_adv_9006503_033",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "現今的世界",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "的確到處都充滿了絕望，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "但妾身至今",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "仍未失去希望。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "好不容易可以和羅伊德……",
    "voice": "vo_adv_9006503_034",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "心所思念的人",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "一起生活。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n多虧有你們，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "讓妾身的世界充滿了希望……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "所以，現在──",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "更不可能讓世界被摧毀！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳……！",
    "voice": "vo_adv_9006503_035",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "阻擾別人情路的傢伙，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我會一腳踹飛得老遠的♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我也絕不會",
    "voice": "vo_adv_9006503_036",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "讓自己陷入絕望。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n因為這個世界",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "有著拯救了我的世界的救世主……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n璃乃。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我絕不會讓妳所居住的世界",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "被摧毀的！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲……",
    "voice": "vo_adv_9006503_037",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在還不是害怕的時候。",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n希望仍然存在……！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就在我心中……！！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "對，",
    "voice": "vo_adv_9006503_038",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "就是要這樣♪",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們再次將希望灌注到妳的弓箭上，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "一掃那傢伙的黑暗吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我會以救世主之力來支援妳的！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好的！",
    "voice": "vo_adv_9006503_039",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要有愛麗絲在……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "簡直就是如貓添翼！！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "呃、",
    "voice": "vo_adv_9006503_040",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳這個人一點都沒變……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n完全帥氣不起來呢……",
    "voice": null,
    "unit_id": 4611
  }
]
