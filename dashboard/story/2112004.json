    "words": "那句話的時候。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下覺得拉比林斯達小姐",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有那麼一瞬間",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "猶豫不知該如何回答。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下在意的，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是您猶豫的理由……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉比林斯達小姐，",
    "voice": "vo_adv_2112004_069",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下猜測……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這是否是因為您和在下一樣，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有著相同的懷疑……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……什麼意思？",
    "voice": "vo_adv_2112004_070",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……在獸人族之國的時候，",
    "voice": "vo_adv_2112004_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "霞小姐她",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "曾經這麼說過……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "501440"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嫌犯──",
    "voice": "vo_adv_2112004_072",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "直接用這形容的話",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是不太好聽。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我認為在通風報信的嫌疑者，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "主要有三位。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "排在第一的，",
    "voice": "vo_adv_2112004_073",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是凱留。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我認為可能性是很低……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但畢竟她是有前科的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "搞不好，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她或許是容易被洗腦的體質也說不定。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "排在第二的，",
    "voice": "vo_adv_2112004_074",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是優衣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這部分當然是因為，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她和敵方首腦似乎使用了相同的角色。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就算存在什麼魔法上的連結，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也並不奇怪。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來，",
    "voice": "vo_adv_2112004_075",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "第三位。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我認為，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "目前可能性最高的人選是……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "501600"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……哎呀。",
    "voice": "vo_adv_2112004_076",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真厲害。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n霞的推理，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是正確答案。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_2112004_077",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這麼說來……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真的是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐她……",
    "voice": "vo_adv_2112004_078",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和敵方",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "互通……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這邊先說清楚好了。",
    "voice": "vo_adv_2112004_079",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n她並不是基於自己的意志",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在流出這邊的情報。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "大概是有什麼前提條件吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "例如她的精神",
    "voice": "vo_adv_2112004_080",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "變得像幼童一樣的時候。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或者是……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n平時休眠的厄莉絲",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "處於覺醒狀態的時候才行。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……雪菲她的功用，",
    "voice": "vo_adv_2112004_081",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就是厄莉絲的「終端」。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就像真那能夠將魔物及闇影",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當成自己的「眼」一樣……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這、",
    "voice": "vo_adv_2112004_082",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這麼說的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在的話，",
    "voice": "vo_adv_2112004_083",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總之可以放心。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n雪菲目前處於深層睡眠狀態。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……因為啊，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我對枕頭動了一點手腳。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……那麼，",
    "voice": "vo_adv_2112004_084",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和怜小姐所懷疑的一樣，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉比林斯達小姐之所以",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「在這個時間點」找上我們的原因是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯。",
    "voice": "vo_adv_2112004_085",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一部分是因為要等雪菲失去意識之後。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖說距離我被發現只是時間問題，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過目前我還不希望",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對方得知這邊的底牌。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這件事，",
    "voice": "vo_adv_2112004_086",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓雪菲小姐知道了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她想必會非常、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常的痛苦。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到時候，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人到底該如何是好……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……總之。",
    "voice": "vo_adv_2112004_087",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n目前這些討論",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就停留在",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我和可可蘿妳心裡吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我會盡量不著痕跡地",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓大家不討論這方面。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要說辦法的話，",
    "voice": "vo_adv_2112004_088",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "倒也不是不能",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "製造遮蔽魔力的結界，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "將雪菲整個人困在裡頭。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只是這個辦法……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這麼做的話，",
    "voice": "vo_adv_2112004_089",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就會和厄莉絲以及美空，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n想對優衣小姐做的事",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得一模一樣了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是啊。",
    "voice": "vo_adv_2112004_090",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這種方法，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就當成最後的手段吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以趁這機會，",
    "voice": "vo_adv_2112004_091",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我先將下一步的目的地，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n告訴共同享有這個祕密的可可蘿好了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2112004_092",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n麻煩您了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "索爾魔珠",
    "voice": "vo_adv_2112004_093",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "目前還剩下兩顆。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其中一顆已經失蹤，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過另外一顆",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的所在位置和",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "擁有者",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我都一清二楚。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…………",
    "voice": "vo_adv_2112004_094",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所在位置──",
    "voice": "vo_adv_2112004_095",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在妳的故鄉。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n精靈族的隱世村莊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而擁有者……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就是「嚮導老君」。",
    "voice": "vo_adv_2112004_096",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n作為我們七冠的長老──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "同時",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也是妳父親",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的角色。",
    "voice": null,
    "unit_id": 106812
  }
]
