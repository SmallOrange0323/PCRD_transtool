[
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──哦，",
    "voice": "vo_adv_9077156_000",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "好硬好硬。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "比外表看起來還要堅硬……",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "像金剛不動明王一樣威猛呢。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……",
    "voice": "vo_adv_9077156_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳才是。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n從小小的身體，根本沒辦法想像妳有這等怪力……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只能用「驚人」來形容了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……所以，",
    "voice": "vo_adv_9077156_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這兩個人還在打……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯！",
    "voice": "vo_adv_9077156_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n順帶一提，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那隻魔物被捲進戰鬥裡，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n早就被打飛了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_9077156_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們兩個──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給我消停一點吧？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我要去跟貪吃佩可還有薇歐莉特打小報告了喔？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔！？",
    "voice": "vo_adv_9077156_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n等等",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "凱留──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "別東張西望！",
    "voice": "vo_adv_9077156_006",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──啊啊！？",
    "voice": "vo_adv_9077156_007",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊！",
    "voice": "vo_adv_9077156_008",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n純的頭盔！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……嘖。",
    "voice": "vo_adv_9077156_009",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……！？",
    "voice": "vo_adv_9077156_010",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n剎鬼……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不繼續攻擊我？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看妳在戰場上露出破綻，",
    "voice": "vo_adv_9077156_011",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我忍不住給了妳一擊──",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是妳的面具掉下來的瞬間，",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "連鬥志都一起沒了。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就算打倒這種沒骨氣的傢伙，",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也沒什麼意思。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……還有，",
    "voice": "vo_adv_9077156_012",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n那東西很適合妳。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n既然適合就沒必要拿下來──",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "來，",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "拿去吧。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剎鬼……",
    "voice": "vo_adv_9077156_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n謝謝妳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳的面具，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也很適合妳喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哦哦……",
    "voice": "vo_adv_9077156_014",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這就是，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "透過面具結交的友情！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n兩個人終於找到，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只有同為戴面具的人才能理解的羈絆。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純的那個不是面具，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是頭盔啦。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種東西怎麼可能",
    "voice": "vo_adv_9077156_015",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會生出什麼羈絆啦……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了妳們兩位，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然結束了就快點回去──！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳在說什麼蠢話。",
    "voice": "vo_adv_9077156_016",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n怎麼可能在這種半調子的情況下結束。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──是吧，",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "團長啊！",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……！",
    "voice": "vo_adv_9077156_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n作為【王宮騎士團】的代表，我的能耐",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n要是被人以為只有這種程度就頭疼了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要上了喔，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剎鬼……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦──！？",
    "voice": "vo_adv_9077156_018",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n為什麼！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "為什麼還要打架啊！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n不是已經透過面具萌生出友情了嗎！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_9077156_019",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼喵──！",
    "voice": "vo_adv_9077156_020",
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦咦──！",
    "voice": "vo_adv_9077156_021",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n凱留妳的面具",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是從哪裡拿出來的啊！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算戴上面具也不會有什麼羈絆啦",
    "voice": "vo_adv_9077156_022",
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只會讓視野變狹窄而已吧",
    "voice": null,
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n說到底戴面具的傢伙根本都很亂來啊！",
    "voice": null,
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看我轟飛妳們，",
    "voice": null,
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "格林炸裂～！！",
    "voice": null,
    "unit_id": 106013
  },
  {
    "type": "dialogue",
    "name": "純、剎鬼",
    "words": "──啊啊啊！！？",
    "voice": "vo_adv_9077156_023",
    "unit_id": null
  }
]
