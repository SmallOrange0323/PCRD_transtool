  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊……",
    "voice": "vo_adv_4010191_000",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那個，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不好意思，雖然你都邀我了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "今天",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我不能太晚回家。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n如果要通宵的話，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "下週五晚上搞不好可以──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦……",
    "voice": "vo_adv_4010191_001",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "是說，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "原來你知道？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "是啊，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "今天",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "其實是我的生日。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我的家人好像",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "晚上要辦生日派對的樣子。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "很搞笑吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦咦？",
    "voice": "vo_adv_4010191_002",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不、",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不用啦，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你不用這麼費心──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗚哇，好大！",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n這是什麼，好大！",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這巨大的箱子",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "到底是什麼？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我有不好的預感。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n你要我打開看看？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "呃，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那麼，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我要把膠膜撕開了哦……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯？",
    "voice": "vo_adv_4010191_003",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這是什麼……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "地球",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "防衛……？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啥，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "五隻合體……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "哦～",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "還是DX啊，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "真厲害──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這不是玩具嗎。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "難道是在玩哏。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不對，這不是玩哏就能說得過去的體積。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦，",
    "voice": "vo_adv_4010191_004",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不是在玩哏嗎……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那個，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我是無所謂啦。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n雖然我無所謂，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "但如果你要送我以外的人禮物時，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n要再多考慮一下對方的喜好和年齡哦。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "說是這樣說，",
    "voice": "vo_adv_4010191_005",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不過，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這種玩具",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "弟弟他們應該會喜歡吧……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "男孩的喜好真的很難搞……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那些傢伙",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "很有自己的主張。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "之前買了花車促銷品的變身腰帶給他們，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "卻吵著說不是這個。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊？",
    "voice": "vo_adv_4010191_006",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "為什麼你會知道這──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "是嗎，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這是那個嗎。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "就是，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你之前來我家時，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "跟弟弟們在電視看的那個。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "原來我在處理便宜肉的肉筋時，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "男生們在聊這個話題啊。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "OK，我了解了，",
    "voice": "vo_adv_4010191_007",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "原來是這樣。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n不錯啊。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "NICE玩具。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你啊，將來應該能成為一個好爸爸。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "雖然我也不太清楚。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯……",
    "voice": "vo_adv_4010191_008",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "是啊。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "剛好最近",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我也沒怎麼陪那群孩子們玩。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n就讓花子姊姊我，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "用這個來讓全家人開心聚一下吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那麼，",
    "voice": "vo_adv_4010191_009",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n這場「扮家家酒」",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "當然你也會奉陪吧？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "很",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "好，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "跟我來吧──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "孩子們都在等你回家哦──",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "爸爸。",
    "voice": null,
    "unit_id": 110832
  }
]
