[
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "突、",
    "voice": "vo_adv_5054322_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "突然冷起來了……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "該不會",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是那傢伙搞的鬼吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "早知如此，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比起時髦性，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我就會穿更具功能性的服裝來了。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……而且，",
    "voice": "vo_adv_5054322_001",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "太過寒冷，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我甚至都有點眼花了。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在那一邊，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好像有幾個眼熟的身影……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃，",
    "voice": "vo_adv_5054322_002",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "振作一點！",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那是冒牌貨啦！！",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊啊！",
    "voice": "vo_adv_5054322_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就想說",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「為什麼各位都像",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n喝了酒的優花梨，走路搖搖晃晃的呢？」",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這下我的疑問",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "得到解答了呢！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什麼嘛秋乃！",
    "voice": "vo_adv_5054322_004",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我才不會喝到走路搖搖晃晃的呢！？",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我作為成熟的大人，",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在飲酒上，可是很有分寸的！",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那個……",
    "voice": "vo_adv_5054322_005",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……就、",
    "voice": "vo_adv_5054322_006",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是說啊。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那、",
    "voice": "vo_adv_5054322_007",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那是什麼微妙的反應啊……",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是的，",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你也幫我跟她們說說啦！",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好了好了，",
    "voice": "vo_adv_5054322_008",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那種事先放一邊！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要認真戰鬥囉！",
    "voice": "vo_adv_5054322_009",
    "unit_id": 114411
  }
]
