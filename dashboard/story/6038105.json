[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長！　",
    "voice": "vo_adv_6038105_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這到底是怎麼回事？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大家都知道克蘿依學姐個性冷淡，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可是她就只有在那個叫美冬的人面前，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n兩眼冒愛心害羞到不行！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "她到底是什麼人？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不管什麼事，都很重視效率……",
    "voice": "vo_adv_6038105_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒對於這種急性子的人很有\\n共鳴呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所謂的青春，就是從小孩長成大人之前的緩衝期。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這有限的\\n寶貴時間，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要一點都不浪費地好好享受！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "讓我們一起，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "享受緩衝期吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喔……",
    "voice": "vo_adv_6038105_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "從送貨到傭兵，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "什麼都能做的優秀打工族啊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這正是博而不精派的琪愛兒所憧憬的大人。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n比起專家更想成為什麼都會的人，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真不錯……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "心動",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是那個就是那個，",
    "voice": "vo_adv_6038105_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐一直興奮地說好酷的那個。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要是琪愛兒也有那種風格的綽號，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐會不會重新愛上我呢？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "以後可以請你改用桃色颱風或是",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "漂亮大魔神之類的稱呼來叫我嗎？",
    "voice": null,
    "unit_id": 110911
  }
]
