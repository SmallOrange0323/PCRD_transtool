[
  {
    "type": "background",
    "bg_id": "500582"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵。",
    "voice": "vo_adv_2009011_000",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我會進行掩護，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請大家進行戰鬥時多加小心。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "畢竟是首場的巡演呢，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果受傷了可會影響到後面的行程呢。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對我們來說可是難能可貴，",
    "voice": "vo_adv_2009011_001",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "且相當重要的巡演呢。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可不想留下了什麼令人後悔莫及的結果。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這我當然知道！",
    "voice": "vo_adv_2009011_002",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是嘛，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光這樣看起來感覺上是隻很強的魔物呢……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要毫髮無傷說不定有點難？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過至少嘛，",
    "voice": "vo_adv_2009011_003",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要拖延時間到粉絲們都避難完才行！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這才是偶像的真髓，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是身為偶像的驕傲……☆",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦咦？",
    "voice": "vo_adv_2009011_004",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n偶像呀，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我以為通常是不會戰鬥的耶！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呵呵。",
    "voice": "vo_adv_2009011_005",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們是會戰鬥的喔。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……而且不知道是福是禍，",
    "voice": "vo_adv_2009011_006",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "剛好騎士先生他也在場呢。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果能夠得到他的強化的話，",
    "voice": "vo_adv_2009011_007",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是這種貨色的魔物也才不會輸呢。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！",
    "voice": "vo_adv_2009011_008",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你還在附近對吧，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請到我們這邊來！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "今天呀，也得要借借你那力量了唷～♪",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哦，",
    "voice": "vo_adv_2009011_009",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你來了呢！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真不愧是你呢，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一眨眼就出現了！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……？",
    "voice": "vo_adv_2009011_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您那發光的棒子是為何物？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n究竟是何時買的呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯。",
    "voice": "vo_adv_2009011_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說在替偶像加油時，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一定會揮舞著此樣物品……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔，",
    "voice": "vo_adv_2009011_012",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可真是不可思議的傳統呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過既然主公大人您也樂在其中，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這點事也無傷大雅就是了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哦，",
    "voice": "vo_adv_2009011_013",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來了來了！　{0}！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也還買了螢光棒了呢～",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_2009011_014",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那是千歌和光之精靈締下了契約，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n讓沒什麼特別的棒子也能夠成功發光出來～",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是用上了相當高科技才做得出來的呢，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個加油道具♪",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}！\\n看到您願意到這來真是令人開心，",
    "voice": "vo_adv_2009011_015",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是否能拜託您替我們進行強化呢？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓所有人，",
    "voice": "vo_adv_2009011_016",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一塊齊心合力來打倒魔物吧。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……這是我們，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和大家都已經期待許久的演唱會。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n那將這件事搞得一團亂的魔物，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "絕對不能夠原諒。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哦哦，",
    "voice": "vo_adv_2009011_017",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌竟然生氣了！ ",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真難得！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然我的心情也和妳一樣就是了呢。",
    "voice": "vo_adv_2009011_018",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要全力來大鬧一場囉～♪",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒想到妳還挺好戰的呢，",
    "voice": "vo_adv_2009011_019",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望姐。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過嘛是因為平時得裝成乖寶寶的樣子，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所以遇到冒險或戰鬥時才反倒更起勁了嗎？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "各位！",
    "voice": "vo_adv_2009011_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳們能願意一同來戰鬥真是萬分感謝，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n再怎麼說只憑我一個人實在擋不住牠！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然實在不怎麼想要讓老百姓捲入了這種危險！",
    "voice": "vo_adv_2009011_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但在【王宮騎士團】的增援趕達這裡之前，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n如果能夠一同渡過這個難關就幫大忙了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "still",
    "still_id": "200901101"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "糟糕……！",
    "voice": "vo_adv_2009011_022",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳還好吧？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那邊的女孩子！",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…………",
    "voice": "vo_adv_2009011_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_2009011_024",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不妙，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "正巧砸到頭部害她昏過去了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有沒有人",
    "voice": "vo_adv_2009011_025",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "帶著治療藥？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n或是會使用恢復魔法的人在場的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那就更好了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500582"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓、",
    "voice": "vo_adv_2009011_026",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓我用唱喚術來……",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊糟了，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "頭開始流血了。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我立刻進行治療！",
    "voice": "vo_adv_2009011_027",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n大家，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這段時間內我將會沒辦法進行防禦，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n請暫時拉開與魔物的距離只採取牽制行動就好！",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "了解！",
    "voice": "vo_adv_2009011_028",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒事吧，那孩子？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n好像，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聽到很不妙的聲響耶……？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果有什麼外傷的話，",
    "voice": "vo_adv_2009011_029",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可以做個繃帶出來進行緊急處理唷？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不……",
    "voice": "vo_adv_2009011_030",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n幾乎沒有什麼外傷，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n大概是頭部遭受到了打擊才會因此導致她腦震盪了吧。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，{0}……",
    "voice": "vo_adv_2009011_031",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請對我再進行更多的強化。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我那身為唱喚士的能力若是增加越多，",
    "voice": "vo_adv_2009011_032",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n治療效果的比例也就會更加的提升。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "麻煩你了。",
    "voice": "vo_adv_2009011_033",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n……其他人也一樣，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還請多加小心。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就如同牠那外貌一樣……",
    "voice": "vo_adv_2009011_034",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n不，也許這敵人，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是比想像中更加危險的魔物。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，",
    "voice": "vo_adv_2009011_035",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是的……",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼會，發生這樣的事？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天可是對我們來說非常重要的，",
    "voice": "vo_adv_2009011_036",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "巡演的第一天…… ",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n應該會成為最棒的一天才是的呀，{0}。",
    "voice": null,
    "unit_id": 104212
  }
]
