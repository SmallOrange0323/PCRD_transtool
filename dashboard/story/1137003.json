    "voice": "vo_adv_1137003_005",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "輪到我們出場了！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "background",
