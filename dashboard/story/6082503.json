[
  {
    "type": "background",
    "bg_id": "501162"
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ノウェムは無鉄砲で、",
    "voice": "vo_adv_6056503_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "危ういところがあります。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "何か無茶をしでかさないように、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n貴方の方でも気にかけてあげてください。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ええ、",
    "voice": "vo_adv_6056503_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "そうしてもらえるとこちらとしても助かります。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nノウェムは貴方に気を許しているでしょうから、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n意見も素直に聞き入れるでしょう。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方も無茶はしないように。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……私にとって、",
    "voice": "vo_adv_6056503_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ノウェムは必要となる可能性が高いだけです。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "利用価値からの判断であって、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方が思うようなものでは……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "なんですか",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "その笑顔は。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "違うと言っているでしょう。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "断じて違います。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ええ、",
    "voice": "vo_adv_6056503_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "彼女も一人で何もできないほど弱くはありません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ですが、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "支えが必要な時もある。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "今回は気だるげな相棒がいないので、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n貴方にその役目を託したいのです。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "頼みましたよ。",
    "voice": null,
    "unit_id": 107011
  }
]
