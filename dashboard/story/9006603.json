    "voice": "vo_adv_9006603_001",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "了？",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還沒呢！",
    "voice": "vo_adv_9006603_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別大意了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……姊姊，",
    "voice": "vo_adv_9006603_003",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這樣已經……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請停手吧，",
    "voice": "vo_adv_9006603_004",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "倭小姐！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n別再繼續爭鬥了……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "雖然也很擔心妳們的身體……",
    "voice": "vo_adv_9006603_005",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但這根本不像是倭小姐妳們的作風！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n居然會對他人言聽計從，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不顧自身性命……！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘖！",
    "voice": "vo_adv_9006603_006",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n說得好像很懂我們似的，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真讓人火大……！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n說到底──",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們才不會",
    "voice": "vo_adv_9006603_007",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "因為這點程度就認輸！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_9006603_008",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n看不起人也要有個限度啊！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_9006603_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有這樣的力量……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或許",
    "voice": "vo_adv_9006603_010",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是憤怒變成了力量……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們是不會輸給那種力量的！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "還、",
    "voice": "vo_adv_9006603_011",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "還要打嗎？",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n果然……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這次──",
    "voice": "vo_adv_9006603_012",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n你就超越小雜碎哥哥，",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "變成小渣渣哥哥吧～！",
    "voice": null,
    "unit_id": 130213
  }
]
