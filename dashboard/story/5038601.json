    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為我完全喪失了那一部分的記憶，",
    "voice": null,
    "unit_id": 103411
  },
