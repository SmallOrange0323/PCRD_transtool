    "words": "弟弟……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不行……",
    "voice": "vo_adv_1365001_043",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "行不行！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不可以老想著負面的事！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n現在不是胡思亂想、",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "兀自悲傷的時候！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說不定弟弟現在也正在某個地方等著我，",
    "voice": "vo_adv_1365001_044",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n也或許",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "他正在哭泣……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n越是這種時候，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐就越是得振作才行！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳在",
    "voice": "vo_adv_1365001_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找什麼人嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這位姐姐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1365001_046",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是這樣沒錯……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳是誰？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我？",
    "voice": "vo_adv_1365001_047",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯～",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以說",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是為了組成探究世界謎團的公會，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而東奔西跑的大姐姐",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "吧？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我正在",
    "voice": "vo_adv_1365001_048",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "強力招募公會成員！",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n現在加入",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就請妳吃特製可麗餅！",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……就是這樣，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要不要加入",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的公會啊？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯……",
    "voice": "vo_adv_1365001_049",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然對那個叫世界謎團的東西",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有點興趣，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但還是先不了。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n因為我",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有非做不可的事。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那件事，",
    "voice": "vo_adv_1365001_050",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是找人嗎？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒錯。",
    "voice": "vo_adv_1365001_051",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我現在的目的，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不是探究世界謎團，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而是找到弟弟，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "保護他的安全，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "跟弟弟一起生活，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n全力寵愛弟弟！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那就再見──",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以再聽我",
    "voice": "vo_adv_1365001_052",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "多講一會嗎？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "拜託了，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "靜流。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1365001_053",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我應該",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒告訴妳我叫什麼名字吧？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_1365001_054",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我擅自調查了",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳的事呢。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n雖說我在招募公會成員，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但畢竟也不是找誰都可以。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我有一定要找妳的理由。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳想知道",
    "voice": "vo_adv_1365001_055",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「弟弟」在哪裡，對吧？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "…………",
    "voice": "vo_adv_1365001_056",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "等一下等一下等一下！",
    "voice": "vo_adv_1365001_057",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "別那麼警戒嘛！",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n雖然我知道他在哪裡，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我並沒有把他關起來之類的，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真的啦！",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我說了要組成探究世界謎團的公會對吧？",
    "voice": "vo_adv_1365001_058",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n妳在尋找的",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「弟弟」……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其實那個少年，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正是解開這個世界謎團的關鍵。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我怎麼可能會對這麼重要的存在予以加害呢？別開玩笑了。",
    "voice": "vo_adv_1365001_059",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我反倒",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還打算保護他。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……事情就是這樣，",
    "voice": "vo_adv_1365001_060",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如何？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的確",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可能會",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "有一點限制也說不定，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也可能會有點不方便。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但妳如果為了",
    "voice": "vo_adv_1365001_061",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那個少年著想，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我認為加入我的公會",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的選項值得考慮。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我會盡量配合妳的要求！",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "…………",
    "voice": "vo_adv_1365001_062",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果能",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只是先當作試用期看看的話。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有，",
    "voice": "vo_adv_1365001_063",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "視情況不同，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "比起公會的目的，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "某些狀況下我會以弟弟的事為優先。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那當然，",
    "voice": "vo_adv_1365001_064",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "靜流。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n正因為我明白對妳來說那個少年有多重要，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我才會勸說妳加入。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯～",
    "voice": "vo_adv_1365001_065",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好像有點……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "被妳玩弄在股掌中的感覺……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "既然是為弟弟著想，那也是不得已的吧。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "等等我喔，",
    "voice": "vo_adv_1365001_066",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐絕對會",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "把你找出來，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好好寵愛你的！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼，",
    "voice": "vo_adv_1365001_067",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我要怎麼",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "稱呼妳才好？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n……告訴我",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳的名字吧？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我叫作",
    "voice": "vo_adv_1365001_068",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "拉比林斯達。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n因為是「公會的會長」，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就叫我",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「公會長」好嗎？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "靜流。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……雖然，",
    "voice": "vo_adv_1365001_069",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "從那之後，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "直到找到弟弟之前，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n也發生了很多事就是了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "見不到弟弟的期間，",
    "voice": "vo_adv_1365001_070",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "非常非常非～～～常",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "寂寞喔！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "起初是被公會長交代",
    "voice": "vo_adv_1365001_071",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不能接近弟弟，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "以為終於能見面，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟卻喪失了記憶……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然知道弟弟平安無事讓我放下心來，",
    "voice": "vo_adv_1365001_072",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n但果然",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是有點寂寞啊……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過，",
    "voice": "vo_adv_1365001_073",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我現在非常幸福！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為無論何時都能見到弟弟，",
    "voice": "vo_adv_1365001_074",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "待在弟弟身旁，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n還能觸碰到弟弟嘛♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "甚至，",
    "voice": "vo_adv_1365001_075",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "待在東國的期間，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n還能跟弟弟享受恩愛的新婚生活♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐已經",
    "voice": "vo_adv_1365001_076",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不會再從弟弟身旁離開了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "從早安到晚安，",
    "voice": "vo_adv_1365001_077",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n從晚安到早安，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我都會徹底寵愛弟弟的喔♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n靜流已經迫不及待要和心愛的弟弟展開新婚生活了。",
    "voice": null,
    "unit_id": null
  }
]
