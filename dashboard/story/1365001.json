[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "年底，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靜流跟著拉比林斯達和璃乃等人\\n解決了在各地發生的異狀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她和{0}選擇在東國度過新年假期。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人前往東國的神社進行了新年參拜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "…………",
    "voice": "vo_adv_1365001_000",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "神主的聲音很有穿透力，",
    "voice": "vo_adv_1365001_001",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "直擊體內深處。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n明明音量不大，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "卻感覺傳遍了神社裡的每一處。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "莊嚴的氣氛、",
    "voice": "vo_adv_1365001_002",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "拂過肌膚的冷風……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n加上神主沉穩的聲音。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "東國的新年參拜…………",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "令人從新年就精神抖擻呢。",
    "voice": "vo_adv_1365001_003",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "去年實在沒想到",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "公會竟然會在年底解散，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n又在新年重新組成，不過……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "希望今後也能",
    "voice": "vo_adv_1365001_004",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "跟【拉比林斯】、",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "公會長、",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一起",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "繼續活動下去。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n也希望任務上",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能繼續保護弟弟。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……嗯，",
    "voice": "vo_adv_1365001_005",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "去年順利地和弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一起冒險了，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n是非常棒的一年。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "希望今年弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也能很有活力又快樂地，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n跟姐姐一起度過這一年！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有，",
    "voice": "vo_adv_1365001_006",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也希望我身為姐姐，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n能夠更加寵弟弟、",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "疼愛弟弟，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "讓他撒嬌，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……讓他過得幸福",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "希望姐姐跟弟弟",
    "voice": "vo_adv_1365001_007",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可以一直一～直，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n待在一起……♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……說笑的。",
    "voice": "vo_adv_1365001_008",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明是新年參拜，我好像太貪心了？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且，",
    "voice": "vo_adv_1365001_009",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還說出要一起過得幸福……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這種話，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這樣簡直",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像在婚禮上宣誓嘛……！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "話說回來，",
    "voice": "vo_adv_1365001_010",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這個狀況。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我穿著正式和服，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "坐在神主面前，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "身邊則有",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟在……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這根本，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就和婚禮一樣對吧。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "怎麼辦。",
    "voice": "vo_adv_1365001_011",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一旦注意到簡直就像在跟弟弟舉行神前婚禮一樣，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我滿腦子就只剩下這個念頭了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "從新年就是",
    "voice": "vo_adv_1365001_012",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不稱職的姐姐，對不起……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐會讓弟弟──",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "「──虔誠惶恐",
    "voice": "vo_adv_1365001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "謹稟神聽」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "\\n……祝各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "衷心",
    "voice": "vo_adv_1365001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "期盼各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "\\n今年也能",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "度過健康安穩的一年。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "\\n非常感謝各位",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "今日前來參拜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "非常謝謝您。",
    "voice": "vo_adv_1365001_015",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "請問，",
    "voice": "vo_adv_1365001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "您剛才的表情無比認真，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "\\n是不是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "有什麼想要實現的夢想？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "啊，",
    "voice": "vo_adv_1365001_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "不好意思，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "因為我有點在意……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是的，",
    "voice": "vo_adv_1365001_018",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "其實我今天跟最愛的弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一起來新年參拜了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明這麼認真地在參拜……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我途中卻忍不住覺得",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這怎麼看都像是在舉行神前婚禮。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "神、",
    "voice": "vo_adv_1365001_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "神前婚禮……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒錯。",
    "voice": "vo_adv_1365001_020",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想如果跟弟弟兩個人，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像這樣子",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "莊嚴地宣誓相愛，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一定會很美妙～",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以──",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "請讓我現在就在這裡宣誓！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我",
    "voice": "vo_adv_1365001_021",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "發誓，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會永遠……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "讓弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "幸福！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "……什麼？",
    "voice": "vo_adv_1365001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好嗎，",
    "voice": "vo_adv_1365001_023",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "那就……",
    "voice": "vo_adv_1365001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神主",
    "words": "祝你們幸福……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1365001_025",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n沒想到在東國休假的開端",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "變成了這麼美妙的神前婚禮♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這下子非得",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和弟弟開啟新婚生活才行了呢！",
    "voice": null,
    "unit_id": 136511
  },
