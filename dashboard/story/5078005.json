  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "這種",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "詭異的氣氛真是令人欲罷不能～",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "流口水………",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "對空花的妄想",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "大有幫助～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "弟弟，",
    "voice": "vo_adv_5078005_002",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "椅子坐起來舒服嗎？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n太硬的話",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "隨時都可以坐到姐姐膝蓋上哦？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "反正弟弟",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "是這座城堡的主人，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "想做什麼都儘管說沒關係哦♪",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那個～",
    "voice": "vo_adv_5078005_003",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "對了，",
    "voice": "vo_adv_5078005_004",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "要不要蓋一間圖書室啊。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n畢竟學生們也需要地方唸書嘛。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n裡頭還得放些酸酸甜甜的少女漫畫……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "圖、",
    "voice": "vo_adv_5078005_005",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "圖書室！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n裡面",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "擺什麼書都可以嗎？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "這樣的話那我，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花也",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "有書想放在裡頭……",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_5078005_006",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "當然很歡迎囉♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "唔，",
    "voice": "vo_adv_5078005_007",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我感覺到了不健全的氣息！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n空花，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "先讓姐姐看看",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "妳想擺進去的是什麼書籍吧？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n我要檢查看看",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "會不會對弟弟造成不好的影響。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "方便打擾一下嗎～？",
    "voice": "vo_adv_5078005_008",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "說、",
    "voice": "vo_adv_5078005_009",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "說什麼不健全啦，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "靜流妳誤會了～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "那是把少女漫畫的內容",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "表現得稍微大膽一些，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n閱讀起來",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "會讓身體變得火熱的",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "愛與希望與慾望的故事～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "有那種書啊？",
    "voice": "vo_adv_5078005_010",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那搞不好我也想讀讀看呢。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n閱讀起來會讓身體變得火熱，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那到底會是什麼樣的書呢。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "妳說呢，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "靜流？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "……",
    "voice": "vo_adv_5078005_011",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "弟弟，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n絕對不准看那邊的詭異老師和變態受虐狂喔！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n因為她們不健全！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "只有姐姐我",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "才是健全的！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "喂喂有聽見嗎？",
    "voice": "vo_adv_5078005_012",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳們聽得見",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我的聲音對吧？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "靜流",
    "voice": "vo_adv_5078005_013",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "是不是對我們抱有誤會……？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我說，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "你應該懂我們對吧？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n我們是",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "健全的對吧？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我就說吧？",
    "voice": "vo_adv_5078005_014",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這孩子分得很清楚的。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "靜流妳也",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "仔細看著我……♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n我很健全吧……♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "太近了太近了太近了！",
    "voice": "vo_adv_5078005_015",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n弟弟，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "這位老師靠得太近了啦！？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n這樣沒問題嗎！？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "應該很有問題吧！？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "妳看吧！",
    "voice": "vo_adv_5078005_016",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n弟弟他",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "雖然猶豫很久",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "但還是開口這麼說了！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那、",
    "voice": "vo_adv_5078005_017",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那是因為黑暗力量的關係……！",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "對了，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "平常的我",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "是很認真的老師對吧？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n不會魅惑人的對吧？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "被指名道姓了！？",
    "voice": "vo_adv_5078005_018",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n虐待狂先生",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "對空花指名道姓了是嗎！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "那麼，",
    "voice": "vo_adv_5078005_019",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "「空花嘛」……",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "的這句話之後",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "要接的是什麼？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n空花",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "真的非常在意～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "不管罵得有多難聽",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花都願意接受～♪",
