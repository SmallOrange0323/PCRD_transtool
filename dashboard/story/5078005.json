    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "我還得感謝各位！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n多虧這座基地聚集的黑暗力量，",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n我才能成長到如此地步──！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "難不成是躲在基地裡，",
    "voice": "vo_adv_5078005_072",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "將我們的力量……！？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "偷偷從空花一行人",
    "voice": "vo_adv_5078005_073",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "身上吸取了力量是嗎！？",
