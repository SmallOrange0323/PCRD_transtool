    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n妳們都太缺乏危機感了！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "之前那麼執著地攻擊我們的反逆獸，",
    "voice": "vo_adv_5078005_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n最近可是一直都沒現身哦？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n再這樣下去",
