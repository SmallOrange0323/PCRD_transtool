  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "彼此彼此。",
    "voice": "vo_adv_5078005_085",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n搶走我的可愛學生們這件事……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
