    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "讓大家醒過來！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "被虐狂光────束！",
