    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "不過住起來比想像中還舒適呢～♪",
    "voice": null,
    "unit_id": 101812
  },
  {
