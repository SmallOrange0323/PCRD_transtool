    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n還有許多協助我們的城內居民哦？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n你會不會太輕率啦？",
