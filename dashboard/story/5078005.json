    "voice": "vo_adv_5078005_086",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "好好教育你！",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "不管你變得多麼強大，",
