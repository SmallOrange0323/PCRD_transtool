    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "也沒什麼困擾的地方啊。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花反倒是",
    "voice": "vo_adv_5078005_031",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "比過去要來得更厲害了～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "保持這樣也很好不是？",
    "voice": "vo_adv_5078005_032",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n反正魔法少女們現在也不在啊。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "唔",
