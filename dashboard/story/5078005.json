    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n同樣的黑暗力量互相角力。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這場戰鬥的勝負關鍵，",
