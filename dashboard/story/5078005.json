    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "怎、",
    "voice": "vo_adv_5078005_063",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n一點反應都沒有～～～！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "那還用說！",
    "voice": "vo_adv_5078005_064",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n我的黑暗力量是完美的！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n給我張大眼睛看清楚吧！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "呀！？",
    "voice": "vo_adv_5078005_065",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "怎怎、",
    "voice": "vo_adv_5078005_066",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "這麼強大的壓力是～！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "整座基地",
    "voice": "vo_adv_5078005_067",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "都在搖晃……！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "大、",
    "voice": "vo_adv_5078005_068",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "大家小心點！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n這傢伙的黑暗力量……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "和過去完全不同！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n到底是怎麼得到這股力量的……！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "反逆獸 ",
    "words": "我只是從頭再做一次一樣的事罷了！",
    "voice": "vo_adv_5078005_069",
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸 ",
    "words": "\\n隱藏起來，",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸 ",
    "words": "蓄積黑暗力量！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸 ",
    "words": "\\n畢竟隱藏氣息是我的專長！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "就算如此，",
    "voice": "vo_adv_5078005_070",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這股高漲的力量是……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n你到底是",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "怎麼獲得這麼龐大的力量……！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "這方面",
