  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "真的忘記了！？",
    "voice": "vo_adv_5078005_026",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n明明反逆獸喊了那麼多次「給我記住」……？",
