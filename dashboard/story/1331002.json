    "type": "dialogue",
    "name": "格蕾斯",
    "words": "的樣子。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n雖然很不好意思，",
