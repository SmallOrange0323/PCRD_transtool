  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我能恢復記憶，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也想起生日是哪一天……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "到時候，",
    "voice": "vo_adv_1064009_095",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你也可以",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "烤蛋糕給我嗎？",
