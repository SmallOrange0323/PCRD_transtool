[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拉比林斯達讓凱留前往霸瞳皇帝的所在地，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n之後獨自來到了據點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我想應該差不多完成了，",
    "voice": "vo_adv_1212003_000",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但有趕上嗎……？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……喔喔！",
    "voice": "vo_adv_1212003_001",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "分析結束了！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我看看啊……？",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊～！",
    "voice": "vo_adv_1212003_002",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原來啊原來！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然是這樣啊！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒想到本該和靈魂聯繫在一起的公主騎士之力，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "居然會以這種形式造成影響……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "以少年的情況來說，",
    "voice": "vo_adv_1212003_003",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好像是因為靈魂和精神的連結尤其牢固，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n才會造成這麼嚴重的反應……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然這是我自己製造的東西，",
    "voice": "vo_adv_1212003_004",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但真虧這股力量能變得這麼莫名其妙呢。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總而言之，",
    "voice": "vo_adv_1212003_005",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣就大致理解打造出「路」的方法了。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然手段會很強硬，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但現在就來測試一下吧……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唔！",
    "voice": "vo_adv_1212003_006",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗚～！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不是燙，而是痛！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是因為這不是在重現肉體上發生的現象嗎？",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這股疼痛和竄改數據的痛楚很像啊……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就算我嘗試獨自干涉，",
    "voice": "vo_adv_1212003_007",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "別說是鎖定精神的所在位置了，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n根本無法造成什麼大變化……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的手段還不夠多啊……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": "vo_adv_1212003_008",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會長妳回來啦……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n妳那是怎麼回事啊！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳不覺得燙嗎！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐，水！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "快拿水來！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "水？",
    "voice": "vo_adv_1212003_009",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是怎麼……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呃，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會長燒起來了！？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "等一下喔，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我馬上拿水過來！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，這個嗎？",
    "voice": "vo_adv_1212003_010",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我沒事，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們別放在心上。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n畢竟這不是真的在燃燒。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1212003_011",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是的話就好……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但會長是那種",
    "voice": "vo_adv_1212003_012",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明有事，卻會說自己沒事的人，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我姑且還是未雨綢繆一下吧。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我這個人實在不被信任得恰到好處耶～！",
    "voice": "vo_adv_1212003_013",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真的沒事。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們別擔心。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不提這個了，",
    "voice": "vo_adv_1212003_014",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我希望妳們馬上去做一件事。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我想請你們去我指定的幾個地方，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n把在那裡的人們",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "集合到同一個地點。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我明白囉，會長！",
    "voice": "vo_adv_1212003_015",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說到這個，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們這麼做是為了什麼目的啊？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聽妳這麼一問，我們的確是不知道呢。",
    "voice": "vo_adv_1212003_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n因為這是會長",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "給我們的任務，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們就什麼都沒過問。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "簡單來說，就是……",
    "voice": "vo_adv_1212003_017",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流、璃乃",
    "words": "就是？",
    "voice": "vo_adv_1212003_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "為了少年！",
    "voice": "vo_adv_1212003_019",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我這次沒有說謊囉。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很抱歉沒跟妳們說，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其實少年他",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼嘛～",
    "voice": "vo_adv_1212003_020",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是為了弟弟啊～！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會長，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "快告訴我地點吧！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請讓我去比姐姐更多的地方！",
    "voice": "vo_adv_1212003_021",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我之後要讓哥哥誇獎我！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊～！",
    "voice": "vo_adv_1212003_022",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳好詐喔，璃乃！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……妳們不問詳情嗎？",
    "voice": "vo_adv_1212003_023",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為會長",
    "voice": "vo_adv_1212003_024",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說我們執行任務",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是為了弟弟時，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n從頭到尾都只會說真話啊。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以我覺得這次也是真的。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳說對吧？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不會在哥哥的事情上說謊",
    "voice": "vo_adv_1212003_025",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就是會長少數的優點之一！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果是為了哥哥，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n要我們努力去做什麼事情都沒問題！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們兩個……",
    "voice": "vo_adv_1212003_026",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "等所有事情結束後，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我會好好解釋的。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也還沒掌握到事情的全貌就是了。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果連會長都不清楚，",
    "voice": "vo_adv_1212003_027",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那我們現在多問也無濟於事，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想趕快為了弟弟採取行動！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哈哈，",
    "voice": "vo_adv_1212003_028",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們是很可靠的姐姐和妹妹呢。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那我就先造出一條路來吧！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後是地圖，地圖……",
    "voice": "vo_adv_1212003_029",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "找到了。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡跟這裡，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接下來是這裡，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後還有這裡嗎……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來，給妳們。",
    "voice": "vo_adv_1212003_030",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有個別寫上妳們兩人的目的了，",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就用我剛才造出的路",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "去把大家集合起來吧。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "拜託了！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "靜流、璃乃",
    "words": "我們出發了！",
    "voice": "vo_adv_1212003_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣就準備好一種手段了。",
    "voice": "vo_adv_1212003_032",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我接下來得去支援凱留才行。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊～好忙啊好忙……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "background",
    "bg_id": "500100"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似～似花，",
    "voice": "vo_adv_1212003_033",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哈囉～♪",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晶，",
    "voice": "vo_adv_1212003_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要進別人的城堡時，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "至少先敲個門吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這座城堡也不是妳家吧。",
    "voice": "vo_adv_1212003_035",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於少年他們的事情，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我想請妳幫一點──",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可以啊。",
    "voice": "vo_adv_1212003_036",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦？可以嗎？",
    "voice": "vo_adv_1212003_037",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且妳在聽我說明前就一口答應了？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n好可怕！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "之後妳應該不會跟我要求很誇張的回報吧？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_1212003_038",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算我對妳有所期待，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n難道妳之前有給過我任何回報嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯喵。",
    "voice": "vo_adv_1212003_039",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我不記得有給過！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我想也是。",
    "voice": "vo_adv_1212003_040",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以說，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳不用再嘮叨了，快告訴我要做什麼。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我知道了啦，似似花老師。",
    "voice": "vo_adv_1212003_041",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "呃，首先是……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "如此這般，得到似似花的協助後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉比林斯達自己也在王宮內部執行了物件變更，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成功讓凱留與霸瞳皇帝重逢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500100"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……我沒想到真那他，",
    "voice": "vo_adv_1212003_042",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n居然會做出那種事情。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晶，",
    "voice": "vo_adv_1212003_043",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我收回前言。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是我第一次收到",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳給我的回報啊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳讓我看到了奇觀。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也是喔。",
    "voice": "vo_adv_1212003_044",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "坦白說",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是在賭一把，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "幸好有成功。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總而言之，\\n這樣就準備好",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "兩種強力的手段了。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳會這麼說，",
    "voice": "vo_adv_1212003_045",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就代表並不是只有兩種手段而已吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是啊，",
    "voice": "vo_adv_1212003_046",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果目前得到的數據和我的預測",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "互相吻合，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只要接下來能鎖定座標，應該就會進行得很順利。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣啊。",
    "voice": "vo_adv_1212003_047",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那在妳離開前，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請妳做好善後工作啊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦？",
    "voice": "vo_adv_1212003_048",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳不打算再繼續幫忙了嗎？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然了。",
    "voice": "vo_adv_1212003_049",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "既然是妳自己選擇的騎士出了問題，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n那就請妳自己處理吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因為能夠扛起這份責任的人",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就只有妳而已。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……是啊。",
    "voice": "vo_adv_1212003_050",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n那我能扛多少",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就會扛多少的。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這份責任。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話又說回來，",
    "voice": "vo_adv_1212003_051",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真沒想到我們七冠竟然會有為了某個人，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而配合地互相幫助的這一天……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們這些人簡直像是",
    "voice": "vo_adv_1212003_052",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "帶著唯我獨尊這四個字誕生的，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n卻還是攜手合作了耶。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但要是我們能更早做到這件事就好了。",
    "voice": "vo_adv_1212003_053",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n明明每個人都是完整的，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "聚在一起後卻會變得不完整……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "連我自己都覺得",
    "voice": "vo_adv_1212003_054",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這群人實在是無可救藥啊。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過",
    "voice": "vo_adv_1212003_055",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們之所以能出現這樣的改變，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "毫無疑問地是你的功勞喔，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你們等等我啊，",
    "voice": "vo_adv_1212003_056",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "大家。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我們會",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "拯救你的！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "background",
    "bg_id": "500271"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我要接受從少年身上流過來的力量，",
    "voice": "vo_adv_1212003_057",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n並納為己有！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": "vo_adv_1212003_058",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "成功了！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接下來只要把思念化為「道路」",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並連結起來就好！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "回來吧，",
    "voice": "vo_adv_1212003_059",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你的世界，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就在這裡！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在此同時，",
    "voice": "vo_adv_1212003_060",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我要一口氣",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "完成事先為少年準備好的",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "除錯",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "與更新──！　",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還要同步處理空間穩定化，",
    "voice": "vo_adv_1212003_061",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "腦袋好像要燒壞了……！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我會成功的。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我會成功做到的！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為我是天才，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是七冠啊！　",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": "vo_adv_1212003_062",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "更新完畢──！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n剩下的，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就交給少年你囉！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，在{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和夥伴的合作下，\\n他們成功控制住了失控的力量。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉比林斯達為事情的經過見證到了最後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……你真厲害啊，",
    "voice": "vo_adv_1212003_063",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這才是",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的公主騎士──",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "background",
    "bg_id": "501500"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……",
    "voice": "vo_adv_1212003_064",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡是……",
    "voice": "vo_adv_1212003_065",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦？",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年？",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "大家",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "跑去哪裡了……？",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唔哇！？",
    "voice": "vo_adv_1212003_066",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……流淌進來的是",
    "voice": "vo_adv_1212003_067",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……少年的思念……",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這股珍惜所有人，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "熾熱到",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "使人眩目的心意……",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原來如此，",
    "voice": "vo_adv_1212003_068",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "能感受到這些的，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就只有我和少年嗎……",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "辛苦你了，",
    "voice": "vo_adv_1212003_069",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你經歷了不少辛勞啊。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……抱歉啊，",
    "voice": "vo_adv_1212003_070",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "歸根究柢起來，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這次會發生這種事情，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n其實是我託付給你的",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "公主騎士之力所導致的。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真的是不管再怎麼向你道歉",
    "voice": "vo_adv_1212003_071",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "都不夠啊……",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年……",
    "voice": "vo_adv_1212003_072",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你是這麼看待這件事的啊……",
    "voice": "vo_adv_1212003_073",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我很慶幸",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "自己選上的人是你。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……少年，",
    "voice": "vo_adv_1212003_074",
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "從今以後，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我也會繼續看著你，",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n以及你這份可能性的未來喔。",
    "voice": null,
    "unit_id": 121212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「我所選擇的騎士應該能讓我見證到吧」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n如此心想的拉比林斯達凝視著充滿未知可能性的未來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n同時露出了溫柔的微笑。",
    "voice": null,
    "unit_id": null
  }
]
