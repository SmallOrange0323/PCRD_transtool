    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳是怎樣，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難得的感人氣氛都被妳給破壞了♪",
