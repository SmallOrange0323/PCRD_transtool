    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": "vo_adv_4003016_018",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我又不是想營造出感人的氣氛……！？",
