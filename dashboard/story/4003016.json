    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_4003016_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就在回去的路上進行採買，順便思考要弄什麼吧！",
