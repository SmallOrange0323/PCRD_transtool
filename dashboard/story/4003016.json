    "type": "dialogue",
    "name": "凱留",
    "words": "那是個",
    "voice": "vo_adv_4003016_021",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好主意呢！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當然要弄魔物料理以外的喔！",
