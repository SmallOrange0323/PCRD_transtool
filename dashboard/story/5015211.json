[
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "你們根本就傷不了我的，",
    "voice": "vo_adv_5015211_000",
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n竟然能做到這個程度，",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "還真是令人吃驚啊！",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這就是",
    "voice": "vo_adv_5015211_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "得到了同伴之力的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不對，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是我們",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "【純白之翼 蘭德索爾分部】的力量！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來吧，",
    "voice": "vo_adv_5015211_002",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "惡代官！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n差不多是",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "惡報來臨的時候了！！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "呵……",
    "voice": "vo_adv_5015211_003",
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "這就是同伴之力啊。",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "我就教教你這股力量有多脆弱吧！",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n出來吧出來吧！！",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那、",
    "voice": "vo_adv_5015211_004",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那是……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花他們！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "還有我",
    "voice": "vo_adv_5015211_005",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "和莫妮卡也在！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "妳就和重要的同伴自相殘殺吧。",
    "voice": "vo_adv_5015211_006",
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n喂，你們！",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "　把那個野蠻的傢伙砍死！！",
    "voice": null,
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "別做無謂的事了。",
    "voice": "vo_adv_5015211_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我們是同伴，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼可能被冒牌貨給迷惑……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哪、",
    "voice": "vo_adv_5015211_008",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哪個才是真正的莫妮卡啊！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要是剛才有買點心的話，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n說不定就分得出來誰才是真的了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "只要同時",
    "voice": "vo_adv_5015211_009",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "攻擊兩邊的空花就……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊！？",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n結果只讓兩邊都很開心！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這、",
    "voice": "vo_adv_5015211_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣下去真的要開始自己人打自己人了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我就用",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "榮耀的軍人之劍",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n來證明誰才是本尊吧！",
    "voice": null,
    "unit_id": 105311
  }
]
