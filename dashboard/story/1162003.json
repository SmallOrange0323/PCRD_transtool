[
  {
    "type": "background",
    "bg_id": "500732"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當過了正中午，「聖學祭」進入午休時間後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500770"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在一般學生禁止進入的老舊校舍中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有一個小心緊戒著周遭、身穿白色制服的人影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那位女學生，拿出了藏在制服內側口袋的信封。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "很好，",
    "voice": "vo_adv_1162003_000",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這裡沒有人在……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "嘿嘿，",
    "voice": "vo_adv_1162003_001",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那就趕快來確認一下內容物──",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "咦咦～",
    "voice": "vo_adv_1162003_002",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "人物拍得好小！",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "而且還微妙地有一點糊！　",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "真是的……",
    "voice": "vo_adv_1162003_003",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n娜塔莉明明是書記，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n卻不太會用轉印魔法嗎……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但是……",
    "voice": "vo_adv_1162003_004",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n哈～",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "她穿這樣果然很適合呢……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n克蘿依的女僕裝",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我要按讚7兆次，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這是永久保存版……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "嗯喔喔喔喔！？",
    "voice": "vo_adv_1162003_005",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你、",
    "voice": "vo_adv_1162003_006",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你是……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n你是，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我想想，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那個……",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我忘了你叫什麼名字，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但你是從月光學院來的特別插班生……！",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "咳。",
    "voice": "vo_adv_1162003_007",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你來這種地方做什麼？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n這裡可是禁止進入的區域，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你有獲得許可嗎？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "啊？",
    "voice": "vo_adv_1162003_008",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我手上的這個東西，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "並沒有什麼特別的。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這是你不需要知道的東西，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n是本學生會最重要的機密，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不管是誰都不能知曉。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "請、",
    "voice": "vo_adv_1162003_009",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "請你不要光憑猜測就說出不確定的情報！",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "像那樣的東西──",
    "voice": "vo_adv_1162003_010",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你是想說我在聖學祭期間裡放著會長職責不管，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n在沒有人的地方偷偷欣賞那種東西嗎？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "並不是好嗎。",
    "voice": "vo_adv_1162003_011",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n你太冤枉我了，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "真不像話。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我有事要做，要先回聖學祭去，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "失陪了。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_012",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你……",
    "voice": "vo_adv_1162003_013",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你有什麼事嗎？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n為什麼要跟著我？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "什麼？",
    "voice": "vo_adv_1162003_014",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你迷路了？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "是嗎。",
    "voice": "vo_adv_1162003_015",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "在學校裡迷路了。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "雖然我很少聽說這種事，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n但看你那老實至極的表情，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "似乎不是在說謊呢。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "雖然我沒有義務幫助敵人，",
    "voice": "vo_adv_1162003_016",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但也沒有理由放著迷途羔羊不顧。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你如果想跟著我走，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "就自己跟上來吧。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不過我在趕時間，",
    "voice": "vo_adv_1162003_017",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我並不是你的嚮導，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "所以沒空管你──",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "──走那邊",
    "voice": "vo_adv_1162003_018",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "要小心一點。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n這棟建築物很老舊，",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "到處都有可能會崩塌。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n輕易地走到牆邊是很危險的。",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……",
    "voice": "vo_adv_1162003_019",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "瑪麗亞？",
    "voice": null,
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_020",
    "unit_id": 7111
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "叫得挺熟的嘛，",
    "voice": "vo_adv_1162003_021",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "月光學院的同學。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n雖然我和你是同年級生，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但我沒有理由被你這樣稱呼。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n請你稱呼我為學生會長。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "什麼？",
    "voice": "vo_adv_1162003_022",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這是因為──",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "因為……",
    "voice": "vo_adv_1162003_023",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我也沒辦法啊……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n要是看得清楚對方的臉，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我就說不出想說的話了……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "如果需要表現得嚴厲，",
    "voice": "vo_adv_1162003_024",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "看不清楚臉剛剛好……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "反正我",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "也不是沒戴眼鏡就走不了路的大近視眼……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "──這是我個人的私事，",
    "voice": "vo_adv_1162003_025",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n不需要你來干涉。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "而且我的意思是，",
    "voice": "vo_adv_1162003_026",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你這樣太裝熟了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我們學生會和好朋友社……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "自稱好朋友社的你們，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "目前處於交戰狀態。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n不需要我多說，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我們應該是敵人啊。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……你為什麼要歪頭，",
    "voice": "vo_adv_1162003_027",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我並沒有說什麼難懂的話。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "還有，",
    "voice": "vo_adv_1162003_028",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你為什麼要露出沉穩的微笑。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我並沒有說什麼有趣的話。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "咦，",
    "voice": "vo_adv_1162003_029",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這個人是怎樣……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n搞不清楚他在想什麼……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n好可怕，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "救命啊娜塔莉！　",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……我在趕路。",
    "voice": "vo_adv_1162003_030",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n請你不要輕易向我搭話。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "background",
    "bg_id": "500760"
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_031",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……",
    "voice": "vo_adv_1162003_032",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……你為什麼都不說話？",
    "voice": "vo_adv_1162003_033",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "雖然我說了不要輕易向我搭話，",
    "voice": "vo_adv_1162003_034",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n但你一直默默走在我背後，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "也會造成我的負擔。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我允許了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "月光學院來的插班生，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "適當地說說話吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_035",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這是最重要機密。",
    "voice": "vo_adv_1162003_036",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "換別的話題。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "朋……",
    "voice": "vo_adv_1162003_037",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "誰知道呢。",
    "voice": "vo_adv_1162003_038",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n這要看人如何定義這個詞吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "在這寬廣的世界中，",
    "voice": "vo_adv_1162003_039",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "也是會有人把僅在同間教室上課而已的關係，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "稱呼為朋友吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n如果以這種詮釋方法來看，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我和她就會算是朋友。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "順帶一提，",
    "voice": "vo_adv_1162003_040",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我們剛入學沒多久的時候，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我曾經有借給她看她忘了帶的教科書。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n也就是說",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我們兩人",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "並肩共享了同一本書。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "哎呀，",
    "voice": "vo_adv_1162003_041",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "聽起來會很像在炫耀嗎？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n我並不是故意的，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "失禮了，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那麼，",
    "voice": "vo_adv_1162003_042",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你又如何呢，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "月光學院的同學？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "她──",
    "voice": "vo_adv_1162003_043",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "二年級的克蘿依，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "本質上是一匹孤傲的狼。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n就算她會在名為學院的社會之中",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "姑且置身於人群裡，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但還是和會輕易對他人搖尾巴的家犬不一樣。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "她那高尚的精神，",
    "voice": "vo_adv_1162003_044",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n就算是敵人，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我也抱有一定的敬意。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……是喔。",
    "voice": "vo_adv_1162003_045",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "算了，",
    "voice": "vo_adv_1162003_046",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "畢竟這要看人怎麼定義嘛。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n既然你這麼自稱，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n那就代表在你的觀點看來是如此吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不過，",
    "voice": "vo_adv_1162003_047",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "究竟她又是怎麼想的呢？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "順帶一提，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我可是有跟她兩人並肩看過同一本書──",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我又不小心開始炫耀了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那麼，",
    "voice": "vo_adv_1162003_048",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你能夠具體舉出與她共渡的深刻回憶，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n來證明你的說法嗎？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "唔……",
    "voice": "vo_adv_1162003_049",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你說她幫助了迷路的你？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我好像有聽過這種情節呢。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n你這個人",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "是把迷路當作人生志業了嗎？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "總之，",
    "voice": "vo_adv_1162003_050",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "這作為人際關係的證明還太薄弱了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n要是幫助迷路的人友情就會成立的話，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n那不就代表",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我現在和你也算是朋友了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不，",
    "voice": "vo_adv_1162003_051",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你不需要那麼老實地感到開心，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n恕我拒絕。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "來吧，",
    "voice": "vo_adv_1162003_052",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "沒有其他例子了嗎？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我的意思是……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "就是，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那個，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "其他跟她有關的事件。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "殺手筆劍？",
    "voice": "vo_adv_1162003_053",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n是她當作禮物？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "送給你的東西？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "雖然我不太清楚，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "但她的品味真是獨特呢。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "其他的呢？",
    "voice": "vo_adv_1162003_054",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n例如",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "她對食物的喜好，或是常去的地方呢？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n她最近熱衷於什麼興趣？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "身高、體重、三圍呢？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……什麼？",
    "voice": "vo_adv_1162003_055",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "要是稱讚她的髮型，她就會一邊生氣一邊高興？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_056",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "呃，",
    "voice": "vo_adv_1162003_057",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你說什麼，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那樣不就單純只是個萌角色嗎？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n高尚的孤獨一匹狼，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "居然會有這麼平易近人的一面……？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "什麼？",
    "voice": "vo_adv_1162003_058",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你有被她邀請到家裡去過？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "哼，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "說什麼傻話……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那是你聽錯了吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "她不可能做出那種像毒婦般的行為。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "真受不了……",
    "voice": "vo_adv_1162003_059",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n看來你的情報",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "嚴重缺乏可信度呢。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "真是太浪費我的時間了，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "月光學院的同學。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不過幸好現在",
    "voice": "vo_adv_1162003_060",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "已經看得見出入口了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n只要走到外面去，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你應該就認得路了吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "午休時間就快結束了，",
    "voice": "vo_adv_1162003_061",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "聖學祭也將進入下半場。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "雖然說",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "已經看得出會是誰輸誰贏了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "接受破滅吧，",
    "voice": "vo_adv_1162003_062",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "好朋友社。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那麼，",
    "voice": "vo_adv_1162003_063",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "再會了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "…………",
    "voice": "vo_adv_1162003_064",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……你有什麼事？",
    "voice": "vo_adv_1162003_065",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n為什麼要繼續跟著我？",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "是嗎，",
    "voice": "vo_adv_1162003_066",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "你有預感還會再迷路是吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n唉……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "隨便你吧。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "background",
    "bg_id": "501280"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "奇怪。",
    "voice": "vo_adv_1162003_067",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n怎麼了，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你說要去上一下洗手間，人是跑哪去了？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好像莫名花了很多時間。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162003_068",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "和瑪麗亞嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼，怎麼回事？",
    "voice": "vo_adv_1162003_069",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那傢伙又來挑釁了嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n還好嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你要是有被她說一些冷言酸語就跟我說，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我會去幫你討公道的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是哦……",
    "voice": "vo_adv_1162003_070",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不知道是想怎樣。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n她常常在瞪著我──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "──啊，",
    "voice": "vo_adv_1162003_071",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她在那裡。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "來",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你看看，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她瞪著我們的表情嚴肅到很誇張對吧？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n她從以前就是這樣，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不知道為何我很受到她討厭。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "奇怪～",
    "voice": "vo_adv_1162003_072",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我到底是做了什麼啊？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n為什麼我得被那樣瞪著看？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "超級意義不明的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "啊啊，",
    "voice": "vo_adv_1162003_073",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "克蘿依就在那裡……！",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n雖然我沒戴眼鏡看不清楚……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "嗚",
    "voice": "vo_adv_1162003_074",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "模模糊糊的……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n看不清楚，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "可惡，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我要努力看見……",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "看見……！　",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了將克蘿依的身姿清楚烙印於近視的眼裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n瑪麗亞和平時一樣皺緊了眉頭，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她努力地嘗試使視線聚焦，就像是在瞪人一般。",
    "voice": null,
    "unit_id": null
  }
]
