[
  {
    "type": "background",
    "bg_id": "500380"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自從{0}們參加鬥技大會，\\n也經過了一段時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去吧！",
    "voice": "vo_adv_4002002_000",
    "unit_id": 106011
  },
  {
    "type": "background",
    "bg_id": "500380"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好欸，",
    "voice": "vo_adv_4002002_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次也贏了～！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們這一隊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "狀況還不錯呦。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還出乎意料之外的沉迷呢，",
    "voice": "vo_adv_4002002_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "本來就是喜歡分勝負的事情就是了～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我對於不能夠吃的對手，",
    "voice": "vo_adv_4002002_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還是感受不到太多戰鬥的意義。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當然",
    "voice": "vo_adv_4002002_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有意義了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在『戰鬥競技場』戰鬥就可以獲得獎勵，",
    "voice": "vo_adv_4002002_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也可以當作是實際作戰，累積經驗提升自己！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不都算是好事情嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}們，\\n也都是這樣想的吧？",
    "voice": "vo_adv_4002002_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_4002002_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐真是的……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n發現在下跟主公大人",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都沒有參與到對話之中，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都會顧慮到我們，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把話題丟給我們呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的，",
    "voice": "vo_adv_4002002_008",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是個好溫柔的人啊……♪",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才、",
    "voice": "vo_adv_4002002_009",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才不是呢？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一直跟貪吃佩可一對一的聊天，會變得越來越不正經，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n沒辦法，才會這樣子的！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_4002002_010",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就在下而言，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n參加鬥技大會，還是有其意義的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "報酬相當的不錯，",
    "voice": "vo_adv_4002002_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也可以做為家中支出的來源。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "跟平時工作相比，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也算是收入比較多的工作。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實際上，",
    "voice": "vo_adv_4002002_012",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "待遇算是不錯了……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過沒有什麼觀眾，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到底是從哪裡獲得利益的呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這部分根本是塊謎，",
    "voice": "vo_adv_4002002_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓人感到微妙的不安。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "它的錢從哪裡來的啊。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們的對手，",
    "voice": "vo_adv_4002002_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n也感覺有點怪怪的。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然有點像『闇影』，",
    "voice": "vo_adv_4002002_015",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但總感覺哪裡怪怪的……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有點像，又有點不像的感覺。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼。",
    "voice": "vo_adv_4002002_016",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如果有在意的事情，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全部都問那個叫做『米奈兵衛』不就好了嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是『米奈β』大人喔，",
    "voice": "vo_adv_4002002_017",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說話不可以太過於失禮。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那位大人，",
    "voice": "vo_adv_4002002_018",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n似乎跟神或是精靈一樣，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是一種超然的存在。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是這樣嗎？",
    "voice": "vo_adv_4002002_019",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "確實看起來有點神聖，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n或是不食煙火的感覺……？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_4002002_020",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下每一天都會進行祈禱時，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都會得到愛梅斯大人的天啟……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "米奈β大人，",
    "voice": "vo_adv_4002002_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n她是跟愛梅斯大人一樣是屬於超然的存在。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像我們這樣的人，",
    "voice": "vo_adv_4002002_022",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或許被她一瞪，就會消失也說不一定。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "呵呵。",
    "voice": "vo_adv_4002002_023",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "有點誇張了，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "我還沒有那麼強大的物理力量。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "你們各位，",
    "voice": "vo_adv_4002002_024",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "其實也算是特別的存在……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "而目前的我，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "也有許多的機能被限制起來。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哇，",
    "voice": "vo_adv_4002002_025",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "出現了。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，米奈β、",
    "voice": "vo_adv_4002002_026",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然聽您的話在『戰鬥競技場』進行戰鬥……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是這個事情，到底有什麼意義呢？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然是個華麗又快樂的活動……",
    "voice": "vo_adv_4002002_027",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但如果更加廣泛的做廣告來招募客人，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也將會成為一個大的商機。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是，每次除了對戰的對手以外，都沒有其他人，",
    "voice": "vo_adv_4002002_028",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得有點浪費。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "目前的狀況……",
    "voice": "vo_adv_4002002_029",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n一般的人們",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n是沒有辦法認知到這個鬥技場的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "所以這樣默默地進行，",
    "voice": "vo_adv_4002002_030",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n是認為最不會發生問題的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "但如果認為有觀眾會比較有幹勁，",
    "voice": "vo_adv_4002002_031",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n那也會再檢討看看開放給一般觀眾。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "比起這個。",
    "voice": "vo_adv_4002002_032",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "有件事情，必須通知給大家。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "多虧大家的表現，成果比預期中的還要好，",
    "voice": "vo_adv_4002002_033",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n所以好像可以擴展鬥技場的性能。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "比現在還要複雜，",
    "voice": "vo_adv_4002002_034",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n更高階的實……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "實戰場景給大家使用。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳給我等一下，",
    "voice": "vo_adv_4002002_035",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳剛剛是不是差點說出『實驗』？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不會是想藉由我們，",
    "voice": "vo_adv_4002002_036",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n打什麼壞主意呢！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "才不是。",
    "voice": "vo_adv_4002002_037",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n請相信我、",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "雖然只能一直重複說同樣的事情……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "但是，我",
    "voice": "vo_adv_4002002_038",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "基本上是站在各位那一方的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "話雖如此。",
    "voice": "vo_adv_4002002_039",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "聊天就先暫停一下，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "請先準備承受衝擊。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "或許會有一點點的暈眩，",
    "voice": "vo_adv_4002002_040",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "也請多多見諒。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": "vo_adv_4002002_041",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n等一下，還有很多想問的事情……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚呀！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "background",
    "bg_id": "500381"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……喔喔？",
    "voice": "vo_adv_4002002_042",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "鬥技場的樣子好像不一樣了呢～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像變比較豪華的樣子？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "事到如今，",
    "voice": "vo_adv_4002002_043",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n對於這個不可思議的空間發生什麼事情，也不會再吃驚了……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但還是不要突然來啊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "差點要咬到舌頭了。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該說。",
    "voice": "vo_adv_4002002_044",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這個東西，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是什麼啊？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "是的。",
    "voice": "vo_adv_4002002_045",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n這裡是將『戰鬥競技場』更加進化的",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n『公主競技場』。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "做為你們新的戰鬥舞台，",
    "voice": "vo_adv_4002002_046",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n更加進化的鬥技場。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "在這裡，有多數人參加的集體戰，",
    "voice": "vo_adv_4002002_047",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n或是參加難度更高的戰鬥。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "如果有參加的話，",
    "voice": "vo_adv_4002002_048",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n在這裡也當然會給予巨大的報酬。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "如同『戰鬥競技場』的鬥技大會一樣，",
    "voice": "vo_adv_4002002_049",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "這個地方也是想參加的時候過來就可以了。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "並不會強制大家。",
    "voice": "vo_adv_4002002_050",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "所有事情，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "都看各位的意願。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "由於會是多人數的戰鬥，",
    "voice": "vo_adv_4002002_051",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n邀約朋友們共同參加也是不錯的方法。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "隨著參加的人數增加，戰鬥也會更加的複雜，",
    "voice": "vo_adv_4002002_052",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "需要更仔細的去思考。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "運用各式各樣的計謀，",
    "voice": "vo_adv_4002002_053",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "鼓起勇氣與智慧戰鬥……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "能夠看到各位產生的許多故事，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n是我一直引頸期盼的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "編織許多",
    "voice": "vo_adv_4002002_054",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "像人類一樣交錯複雜的故事……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n讓我，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "見識更多、更多的故事。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "我衷心的",
    "voice": "vo_adv_4002002_055",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "這麼期盼著。",
    "voice": null,
    "unit_id": 191111
  }
]
