  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼～，",
    "voice": "vo_adv_7005004_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這附近的魔物都討伐的差不多了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "兩位辛苦了呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "順、",
    "voice": "vo_adv_7005004_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "順帶問一下……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n紡希是怎麼會跟他認識的呢？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦！？　",
    "voice": "vo_adv_7005004_002",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我、",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我店裡招募工讀生的時候。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是、",
    "voice": "vo_adv_7005004_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣呀……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，我沒有什麼特別的意思呀，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有特別的意思……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當、當然！",
    "voice": "vo_adv_7005004_004",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可是一心一意只對怜妳一人……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，騎士先生小心！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呀啊啊啊――！",
    "voice": "vo_adv_7005004_005",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "太好了，",
    "voice": "vo_adv_7005004_006",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "終於打倒了！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哎呀呀啊。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喂、喂、喂！",
    "voice": "vo_adv_7005004_007",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳為什麼緊緊抱著他！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "快、快點給我分開！！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊痛痛痛……",
    "voice": "vo_adv_7005004_008",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個，",
    "voice": "vo_adv_7005004_009",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我、我為什麼抱著騎士先生！？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "討厭――！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊哇！",
    "voice": "vo_adv_7005004_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喂，",
    "voice": "vo_adv_7005004_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n別把他推到我這邊來！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛剛摸了奇怪的地方吧！？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等，等等！",
    "voice": "vo_adv_7005004_012",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼你抱著怜呀騎士先生！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請快分開！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為出乎意料的事件被兩人愚弄著，\\n卻毫無反抗的{0}。",
    "voice": null,
    "unit_id": null
  }
