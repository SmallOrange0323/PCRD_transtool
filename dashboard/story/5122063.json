  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這的確是我的緊身衣……",
    "voice": "vo_adv_5122063_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "原來是祕密廢棄服務啊……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真對不起，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我並不曉得。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我以為是衣服的回收業者，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就稀鬆平常地拿去了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你說這件看起來",
    "voice": "vo_adv_5122063_001",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好像還能穿？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然是這樣沒錯……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但其實，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "胸部附近",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "穿起來",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "變得有一點點緊呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真～的只有一點點而已喔。",
    "voice": "vo_adv_5122063_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但是你想想看，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為是直接貼著身體的衣物，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n對於尺寸的感覺",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也會更敏感對吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "所以啊，",
    "voice": "vo_adv_5122063_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我就換了一件新的同款緊身衣。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你看，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "現在身上這件的",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有這裡。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "都很合身對吧♪",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "話說回來，",
    "voice": "vo_adv_5122063_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣啊～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n祕密廢棄服務……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯？",
    "voice": "vo_adv_5122063_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我跟你說喔。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n擁有祕密這件事，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在青少年的成長過程中",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是十分重要的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n如果你也有祕密的話，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "或許會是個很好的學習經驗～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我突然",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有了這樣的想法呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……對了，",
    "voice": "vo_adv_5122063_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我說，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不如這樣吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "關於我胸部稍微變大這件事，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n就當成",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是只有我跟你兩人才知道的祕密。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "如何？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那就這樣說好囉♪",
    "voice": "vo_adv_5122063_007",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這是唯獨",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你才知道、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我跟你之間的",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "兩、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "人、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "祕、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "密。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這可不是兒戲喔？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而是情感教育的一環。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在你擁有祕密後注意到什麼、",
