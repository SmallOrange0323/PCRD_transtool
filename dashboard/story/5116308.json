[
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐，",
    "voice": "vo_adv_5116308_000",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下突然想到一事……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那位大猿先生",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠應該可以",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n用生長在密林裡的植物來製作牙刷吧？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呃，",
    "voice": "vo_adv_5116308_001",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳是說",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要教大猿刷牙嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠是智力很高的魔物，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果好好教牠，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n或許有可能理解我們的意思……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "話雖如此，",
    "voice": "vo_adv_5116308_002",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這也要等到事情全都解決之後",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再來進行。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓我們以遊俠的身分，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "先奪回這片森林的平靜安穩吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了。",
    "voice": "vo_adv_5116308_003",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大猿先生，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n既然如此，我們會奉陪到底的。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請您快冷靜下來吧。",
    "voice": null,
    "unit_id": 125311
  }
]
