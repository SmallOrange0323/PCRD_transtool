    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "一起喊出聲來。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n要上囉，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "預備。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "「咦，要怎麼配合！？我什麼都沒聽說啊！」\\n「就送妳上路吧。」\\n「把妳痛扁一頓！」",
    "voice": "vo_adv_5215323_004",
