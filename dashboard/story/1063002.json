  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和亞里莎因為送信的打工，\\n而來到了精靈之森。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "呼！",
    "voice": "vo_adv_1063002_000",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n這樣就大約完成一半了呢！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……耶嘿嘿。",
    "voice": "vo_adv_1063002_001",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n真的很你謝謝呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我完全",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "忘了還有錢的問題要顧……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "有請你介紹工作真是太好了！",
    "voice": "vo_adv_1063002_002",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "除了能活動身體很開心以外，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n說不定也有機會因此找到蘿莎麗亞！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……沒有。　",
    "voice": "vo_adv_1063002_003",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n目前什麼都還沒……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "蘭德索爾很寬廣呢……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我有試著向各式各樣的人詢問等等，",
    "voice": "vo_adv_1063002_004",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n卻還是沒有什麼線索……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不過，沒問題的！",
    "voice": "vo_adv_1063002_005",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n總有一天一定會找到的！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n……絕對，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "會找到！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "在那之前我打算像這樣，",
    "voice": "vo_adv_1063002_006",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n一邊和你一起工作，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n一邊在蘭德索爾生活看看！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……耶嘿嘿，",
    "voice": "vo_adv_1063002_007",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n有{0}在的話，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n真的很令人放心呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "真、",
    "voice": "vo_adv_1063002_008",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "如果你願意幫我，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我會非常開心的……！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "好──！",
    "voice": "vo_adv_1063002_009",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n多虧了{0}，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我打起精神了！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n剩下的部分也加油吧！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "background",
    "bg_id": "500191"
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "這些應該就是全部……",
    "voice": "vo_adv_1063002_010",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "了吧。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "{0}，謝謝你！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n辛苦了！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……呼。",
    "voice": "vo_adv_1063002_011",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n流汗之後，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "吹著風很舒服呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n感覺",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "很涼快。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……",
    "voice": "vo_adv_1063002_012",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……啊，",
    "voice": "vo_adv_1063002_013",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "抱歉喔？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我剛剛想起了在村子的事。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "和蘭德索爾相比，",
    "voice": "vo_adv_1063002_014",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n雖然是非常小的村子……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不過，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "是個好地方哦。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "風和水都很乾淨，",
    "voice": "vo_adv_1063002_015",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "又充滿了綠意……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "也許和這裡有點像。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……我呢，",
    "voice": "vo_adv_1063002_016",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "最喜歡村子了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n無論是風還是水還是綠意，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "都最喜歡了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "所以……",
    "voice": "vo_adv_1063002_017",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我和蘿莎麗亞約好了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n要一起當上森林守衛。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "森林守衛呢，",
    "voice": "vo_adv_1063002_018",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "要從邪惡事物的手中保護村裡的人還有大自然！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n是非常重要的職責哦。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……結果蘿莎麗亞卻不見了。",
    "voice": "vo_adv_1063002_019",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n雖然我一個人，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n也可以接受",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "成為森林守衛的測驗……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "但是，",
    "voice": "vo_adv_1063002_020",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我不想要那樣。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "因為",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我和蘿莎麗亞約好要一起的。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……耶嘿嘿。",
    "voice": "vo_adv_1063002_021",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n開玩笑的，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我現在還不夠厲害呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n即使和蘿莎麗亞一起接受測驗，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "也可能只有我會失敗。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "是、",
    "voice": "vo_adv_1063002_022",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "是這樣嗎……？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……如果是這樣就好了呢！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "呀──！？",
    "voice": "vo_adv_1063002_023",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "怎、怎麼了！？",
    "voice": "vo_adv_1063002_024",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n是、是從那個方向傳來的呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我們去看看吧！",
    "voice": null,
    "unit_id": 106311
  },
