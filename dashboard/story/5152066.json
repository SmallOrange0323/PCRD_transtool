  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "初夢への願い事、",
    "voice": "vo_adv_5134066_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "か……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "望んだ夢が見られたからって、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n実現するかどうかは別問題なんでしょうけど。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "でも、",
    "voice": "vo_adv_5134066_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "こういうのって気持ちが大切よね？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "さて、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "問題は……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "結婚を願うべきか、",
    "voice": "vo_adv_5134066_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "研究の進展を願うべきか。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "まずは自問自答してみましょう……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406601"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "よく考えなさい、",
    "voice": "vo_adv_5134066_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "ミツキ。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n人は生きていく限り孤独なのよ。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "だから結婚なんて諦めて、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "科学研究に身を捧げるべきよ。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406602"
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "いいえミツキ、",
    "voice": "vo_adv_5134066_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "研究だけの人生なんてむなしいだけよ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "今からずっと年齢を重ねたときのことを考えなさい。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "食卓についているのが一人だけなんて、",
    "voice": "vo_adv_5134066_005",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\nきっと耐えられないわ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406603"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "惑わされないで。",
    "voice": "vo_adv_5134066_006",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "研究によって",
    "voice": "vo_adv_5134066_007",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "新たな医療技術を確立できれば、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "たくさんの命を救えるし、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "富と名声も得られるのよ？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406604"
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "でも、その喜びを分かち合うパートナーはいない。",
    "voice": "vo_adv_5134066_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "そもそも私は",
    "voice": "vo_adv_5134066_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "富や名声のために研究をしていたのではないはず。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "結婚できない現実に、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "言い訳をしているだけよ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406605"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "それは極めて自罰的",
    "voice": "vo_adv_5134066_010",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "かつ主観的な発想ではないかしら。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406606"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "まるで人生における幸福が、",
    "voice": "vo_adv_5134066_011",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "家庭を持つことだけに",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n依存しているような物言いは",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "多様性を否定しているわ。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406607"
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "でも結婚できるチャンスが",
    "voice": "vo_adv_5134066_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\nあったら",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "してたわよね？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406608"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "そういう正論は自分の心を",
    "voice": "vo_adv_5134066_013",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n引き裂くだけだと思わない？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406609"
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "自分で自分の心を引き裂かなくても、",
    "voice": "vo_adv_5134066_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\n定期的に届く知人からの結婚ハガキで",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "既に心はズタズタよ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "分かったら意地を張らずに、",
    "voice": "vo_adv_5134066_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派ミツキ",
    "words": "\\n素直に結婚を願って……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406610"
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "待ちなさい。",
    "voice": "vo_adv_5134066_016",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\nそれは結論を急ぎすぎているわ。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "ここはまず、",
    "voice": "vo_adv_5134066_017",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "幸福の本質を",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "\\n再定義するところから始めて、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "その上で",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派ミツキ",
    "words": "結婚か研究かの二択を……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406611"
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "結婚……",
    "voice": "vo_adv_5134066_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "研究……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "結婚……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "\\n研究……！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "結婚……！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "研究……！\\n結婚！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "研究！　結婚！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "脳内ミツキたち",
    "words": "研究！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "…………",
    "voice": "vo_adv_5134066_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "脳内会議をしていたら、",
    "voice": "vo_adv_5134066_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "一睡もできなかったわ……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n初夢を見るどころか、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ぐったりして全身がだるい……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "でも、",
    "voice": "vo_adv_5134066_021",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "この迷いこそが",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "答えってことね。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "研究も結婚も、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "同じくらい大切にしたいってことなのよ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "それが分かっただけでも、",
    "voice": "vo_adv_5134066_022",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "意味があったということにしましょう。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
