    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_1088004_008",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "難不成看到了這件和服所以嚇了一跳？",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這件和服，",
    "voice": "vo_adv_1088004_009",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和阿斯特朗裡頭的時裝是同個花樣的唷。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n遊戲有能夠掃描現實中和服的功能，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我就是掃描了這一件。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝、",
    "voice": "vo_adv_1088004_010",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈哈，",
    "voice": "vo_adv_1088004_011",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是怎麼回事呢，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真不好意思……",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦！？",
    "voice": "vo_adv_1088004_012",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝、",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我沒有想過竟然會被這樣稱讚，",
    "voice": "vo_adv_1088004_013",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以有點驚訝！",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_1088004_014",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "才剛過年就被{0}你這樣稱讚了，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n感覺今年也會是個好年呢！",
