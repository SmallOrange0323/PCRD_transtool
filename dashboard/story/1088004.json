  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我到底在做什麼呀，",
