    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "覺得非常開心。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是，",
    "voice": "vo_adv_1088004_057",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我不覺得自己有累到會立刻睡著的程度呀……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "畢竟直到剛剛都是我有事情要你陪我嘛，\\n接下來，就換我",
    "voice": "vo_adv_1088004_058",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "陪騎士先生去做你想做的事吧。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是要給可可蘿的，對吧。",
    "voice": "vo_adv_1088004_059",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那麼既然要去，",
