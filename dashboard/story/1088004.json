    "name": "優衣",
    "words": "要帶多少會比較好呢……",
    "voice": "vo_adv_1088004_060",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣夠嗎？",
