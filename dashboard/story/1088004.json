    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……{0}是，",
    "voice": "vo_adv_1088004_024",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n只要下定決心要去幫助誰，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
