    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好丟臉～！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的～",
    "voice": "vo_adv_1088004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n剛剛那是以你的記憶基礎所做出來的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真要說就是如同夢一般的情景唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "被{0}你出聲叫住時，優衣的那表情，",
    "voice": "vo_adv_1088004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n簡直就像是與命運之人相遇的公主一樣呢。",
