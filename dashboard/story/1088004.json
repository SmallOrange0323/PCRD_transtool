    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是的……",
    "voice": "vo_adv_1088004_039",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然說讓他幫了大忙，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但爸爸和媽媽他們倆，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n竟然就以為{0}是我的「男朋友」了！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而且，",
    "voice": "vo_adv_1088004_040",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還說什麼想要看看長相，所以要我把他帶來，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "絕對辦不到～！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "畢竟{0}他的事情，",
    "voice": "vo_adv_1088004_041",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n如果被意有所指地亂問，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我會很害羞呀……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是，",
    "voice": "vo_adv_1088004_042",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "爸媽硬塞給我折價券要我帶來學校，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不送給他也不行吧……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但如果他真的來了，事情絕對會變得複雜啊～！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什、",
    "voice": "vo_adv_1088004_043",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什什什、",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什麼事都沒有喔！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n那麼{0}，再見了喔！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……說什麼再見了，",
    "voice": "vo_adv_1088004_044",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
