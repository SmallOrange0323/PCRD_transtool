    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有，",
    "voice": "vo_adv_1088004_035",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就是呢，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想說做為謝禮，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "圍巾！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n雖然是手工製的，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但如果你不介意……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "戴戴看吧？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "然後，",
    "voice": "vo_adv_1088004_036",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有另外一個謝禮……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這、",
    "voice": "vo_adv_1088004_037",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是我們家店裡的折價券！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我家啊，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是開食堂的……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊啊，但是，",
    "voice": "vo_adv_1088004_038",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n還是等到你真的",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "很想來吃吃看時再來就好！",
