    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我弟弟他們的話不用擔心唷。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n現在他們已經都不哭了，",
