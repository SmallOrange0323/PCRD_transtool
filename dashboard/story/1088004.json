    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是個笨蛋～！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會不會被他以為我是個奇怪的人呀……？",
    "voice": "vo_adv_1088004_045",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚嗚嗚，",
