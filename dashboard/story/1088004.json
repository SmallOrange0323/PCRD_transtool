  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在神殿發生了那種事之後，優衣與{0}兩人\\n也不禁感到了疲倦，並且回到了公會小屋之中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我回來了……",
    "voice": "vo_adv_1088004_000",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然因為是在擁擠的人群之中移動……",
    "voice": "vo_adv_1088004_001",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不過還真是累垮了呢……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，",
    "voice": "vo_adv_1088004_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "小屋中怎麼會有亮光呢？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而且這道光……",
    "voice": "vo_adv_1088004_003",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好像在哪裡見過……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對了，",
    "voice": "vo_adv_1088004_004",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只要見到這道光……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不知道是為什麼，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "總是會、",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "變得好睏……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "still",
    "still_id": "108800401"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？{0}？你好。",
    "voice": "vo_adv_1088004_005",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "新年快樂！",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "今年也請多指教囉。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "{0}也是來買東西的？",
    "voice": "vo_adv_1088004_006",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……怎麼了？",
    "voice": "vo_adv_1088004_007",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有哪裡很奇怪嗎？",
