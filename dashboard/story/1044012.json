    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你以為妾身會放過在場的人，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "做出這種溫吞濫情的決策嗎？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你們就放心把身心都交給恐懼吧……",
