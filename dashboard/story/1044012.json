  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞再度取回曾經的模樣與魔力的幾天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好，",
    "voice": "vo_adv_1044012_000",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "差不多該開始認真準備征服世界了啊。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在那之前……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還必須完成沒做完的事呢……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "當時的後續……",
    "voice": "vo_adv_1044012_001",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跟那傢伙吃浪漫晚餐！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身已經很清楚那傢伙的心意了。",
    "voice": "vo_adv_1044012_002",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次一定要營造出好氣氛……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也必須傳達妾身的心意才行。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然都這麼決定了……",
    "voice": "vo_adv_1044012_003",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "使魔們",
    "words": "嘰──！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼？",
    "voice": "vo_adv_1044012_004",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了？眷屬們。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們也迫不及待要準備了嗎？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "使魔們",
    "words": "嘰──！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼？",
    "voice": "vo_adv_1044012_005",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們說",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有不速之客？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "在那裡嗎！？",
    "voice": "vo_adv_1044012_006",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "\\n唔，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "這股壓倒性的魔力是怎麼回事！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "不會錯的，",
    "voice": "vo_adv_1044012_007",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "這傢伙就是傳說的吸血鬼……！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": "vo_adv_1044012_008",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是怎樣？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然招呼不打便擅自踏進妾身的城堡，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好大的膽子啊。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "我們是吸血鬼獵人！",
    "voice": "vo_adv_1044012_009",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "\\n傳說的吸血鬼，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "我們是來消滅妳的！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身現在很忙啊。",
    "voice": "vo_adv_1044012_010",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在成就大事前，還有很多不能輕忽的小事，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n沒空對付像你們這樣的小人物。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在妾身就放過你們。",
    "voice": "vo_adv_1044012_011",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "趕緊消失吧。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "我們哪可能會",
    "voice": "vo_adv_1044012_012",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "點頭答應乖乖撤退啊！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "\\n我們也是花了大錢做準備的！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "\\n納命來！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "background",
    "bg_id": "501230"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦，",
    "voice": "vo_adv_1044012_013",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "結界嗎？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真有意思……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "吃我這招！",
    "voice": "vo_adv_1044012_014",
    "unit_id": 1011
  },
  {
    "type": "background",
    "bg_id": "501230"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼啊，",
    "voice": "vo_adv_1044012_015",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真慢。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身都想打呵欠了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "竟然被躲開了！？",
    "voice": "vo_adv_1044012_016",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是……",
    "voice": "vo_adv_1044012_017",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "銀彈和",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "白木樁嗎？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵呵，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有意思……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真有意思！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看來你們是認真想消滅妾身啊！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "我們從一開始就是這麼說的！",
    "voice": "vo_adv_1044012_018",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "\\n妳無路可逃了！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你說誰要逃？",
    "voice": "vo_adv_1044012_019",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身這傳說的吸血鬼──",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯坦，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n既不會逃也不會躲！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "background",
    "bg_id": "501230"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然妾身這麼說了……",
    "voice": "vo_adv_1044012_020",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但即便力量恢復，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他們還是很棘手啊……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這些傢伙的身手相當好……",
    "voice": "vo_adv_1044012_021",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "被襲擊的",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是公會成員所在的城堡，真是太好了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "可惡，",
    "voice": "vo_adv_1044012_022",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "都攻擊到這種地步了，竟然還無法解決她……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼……",
    "voice": "vo_adv_1044012_023",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若想打敗妾身，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就要帶比這還多幾十倍的人過來呢！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "妳這",
    "voice": "vo_adv_1044012_024",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "怪物……！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "喂，",
    "voice": "vo_adv_1044012_025",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "你們看，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "我剛剛在搜索其他房間時，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "找到了人類……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他說",
    "voice": "vo_adv_1044012_026",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "人類？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該不會……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "喂！",
    "voice": "vo_adv_1044012_027",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "我有說過不要抵抗吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！",
    "voice": "vo_adv_1044012_028",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你為什麼會在這裡！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "為什麼那傢伙會這麼傷痕累累的？",
    "voice": "vo_adv_1044012_029",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "該不會",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人2",
    "words": "是被這個吸血鬼弄傷的？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "不，",
    "voice": "vo_adv_1044012_030",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "不是。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "\\n我明明",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "說要保護這傢伙，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人3",
    "words": "但他卻大肆抵抗，所以我就不小心……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "原來如此……",
    "voice": "vo_adv_1044012_031",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "獵人1",
    "words": "看來他似乎被變成眷屬了啊……",
