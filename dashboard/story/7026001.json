  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人在露娜之塔中前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n現場的氣氛有些尷尬。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026001_000",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……沒問題。",
    "voice": "vo_adv_7026001_001",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦！？",
    "voice": "vo_adv_7026001_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還好！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒事！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如你所見，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我活蹦亂跳得蹦蹦跳──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026001_003",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………沒、",
    "voice": "vo_adv_7026001_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚……",
    "voice": "vo_adv_7026001_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "比起感到傻眼，沒反應更讓人難堪啊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我居然硬想炒熱氣氛，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是傲慢的想法……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "冷場還無法順勢救場的丟臉小丑，就是我……",
    "voice": "vo_adv_7026001_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好想就這樣被埋進塔的牆壁裡，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "變成無機物……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但這還只是開頭而已……",
    "voice": "vo_adv_7026001_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "應該還有機會可以和露娜變得更要好……！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "機會不是等來的，",
    "voice": "vo_adv_7026001_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而是爭取來的……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "書上",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有這麼寫著。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "透過共同的興趣",
    "voice": "vo_adv_7026001_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "讓對話順利進行的高級技巧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n想和露娜變得更要好的話，就只有這個方法了！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼看起來，",
    "voice": "vo_adv_7026001_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜也是出於某些原因而被歸類在邊緣人裡。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而她也擁有一個很重要的玩偶",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "作為精神支柱。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也就是說，我和露娜",
    "voice": "vo_adv_7026001_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只要好好聊過就能理解彼此！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的腦內模擬出來的情境是……",
    "voice": "vo_adv_7026001_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其實",
    "voice": "vo_adv_7026001_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒有朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我有一個玩偶朋友哦。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那就是",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個好朋友號！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……咦？",
    "voice": "vo_adv_7026001_014",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜也",
    "voice": "vo_adv_7026001_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和那個玩偶是朋友吧？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我很快就發現了",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們是一樣的呢！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_7026001_016",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "一樣的……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "這樣呀！",
    "voice": "vo_adv_7026001_017",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n露娜和大姐姐",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是一樣的呀！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是的！",
    "voice": "vo_adv_7026001_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是一樣的！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "啊哈！啊哈哈！\\n呵呵！呵呵呵！",
    "voice": "vo_adv_7026001_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣一來，我們兩個就可以一直感情要好地聊天……！",
    "voice": "vo_adv_7026001_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真感人！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只有這個辦法了！！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好",
    "voice": "vo_adv_7026001_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "朋友號，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "給我勇氣吧！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026001_022",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露、",
    "voice": "vo_adv_7026001_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……！",
    "voice": "vo_adv_7026001_024",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_7026001_025",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n…………什麼事？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露、",
    "voice": "vo_adv_7026001_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜妳的玩偶",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的好可愛呀……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我可以靠近一點看嗎……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026001_027",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
