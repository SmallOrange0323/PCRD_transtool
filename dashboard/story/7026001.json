  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "啊。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太、",
    "voice": "vo_adv_7026001_029",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太好了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "她回應我了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "首先，我先靠她近一點……！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
