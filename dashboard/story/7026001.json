  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有進展！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜好像也沒有不願意聊天的樣子……",
    "voice": "vo_adv_7026001_040",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這時候",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "除了進攻別無選擇吧！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其實",
    "voice": "vo_adv_7026001_041",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒有朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我有一個玩偶朋友哦！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那就是這個好朋友號！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……咦？",
    "voice": "vo_adv_7026001_042",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜也",
    "voice": "vo_adv_7026001_043",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和那個玩偶",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是朋友吧？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我很快就發現了",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是一樣的呢！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_7026001_044",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "一樣的……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好！",
    "voice": "vo_adv_7026001_045",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "目前為止都和剛才模擬的一樣！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n接下來，只要約她一起聊天──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不是哦。",
    "voice": "vo_adv_7026001_046",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？",
    "voice": "vo_adv_7026001_047",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜的玩偶",
    "voice": "vo_adv_7026001_048",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "跟露娜不是朋友哦。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "所以，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大姐姐和露娜──",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不一樣哦。",
    "voice": "vo_adv_7026001_049",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………咦？",
    "voice": "vo_adv_7026001_050",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……大姐姐，",
    "voice": "vo_adv_7026001_051",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "妳好奇怪喔。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大、",
    "voice": "vo_adv_7026001_052",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大受打擊──！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……大哥哥。",
    "voice": "vo_adv_7026001_053",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n那邊有樓梯哦。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "一起走吧。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………呵。",
    "voice": "vo_adv_7026001_054",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呵呵呵……",
    "voice": "vo_adv_7026001_055",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我還以為能跟露娜變得更要好呢……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……嗚嗚嗚！",
    "voice": "vo_adv_7026001_056",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現實",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對邊緣人太嚴苛了～！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對和美好理想截然不同的無情現實，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n碧在心裡如此吶喊著。",
    "voice": null,
    "unit_id": null
  }
