  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "播放著音樂，",
    "voice": "vo_adv_4010171_000",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "紅茶的溫柔香氣……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "感覺心靈自然地就平靜下來了。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真是待起來很舒服的店呢，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "平時",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人都會在放學後過來嗎？",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有幸來到兄長大人經常光顧的店家，",
    "voice": "vo_adv_4010171_001",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我感到榮耀至極……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "欣喜雀躍。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n不知道該如何回禮……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我的……？",
    "voice": "vo_adv_4010171_002",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n今天的確是我的生日……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "難道說，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這個是……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "傳聞中的",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "驚喜……？",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "如、",
    "voice": "vo_adv_4010171_003",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "如果是我來慶祝兄長大人的生日",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那還能理解……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n但您平時都這麼照顧我了，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "居然還幫我準備了這種驚喜……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "呀！？",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "蛋糕上面插著煙火，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我第一次",
    "voice": "vo_adv_4010171_004",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看到這種蛋糕……！",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "而且",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這個……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還有用巧克力寫的訊息！",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n色彩繽紛的",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這個",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是果凍嗎，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "鮮奶油的顏色也很鮮豔……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "沒想到會有",
    "voice": "vo_adv_4010171_005",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這麼華麗的蛋糕呢。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n因為在宅邸時",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "都是收到日式糕點居多。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "鮮艷又可愛，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "令人不禁看得入迷了。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個，",
    "voice": "vo_adv_4010171_006",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人？",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "如果不介意的話，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n可以和我一起享用嗎？",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這個蛋糕",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "對我來說有點太大了……",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "而且。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這短暫的時光，",
    "voice": "vo_adv_4010171_007",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我希望能和兄長大人",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一同品嚐蛋糕享受，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "肯定會如夢一般美味。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請先吃一口吧。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "恕我冒昧，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請讓我餵您吃。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是啊。",
    "voice": "vo_adv_4010171_008",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "即使是夢肯定也無妨。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n因為和兄長大人度過的每一刻，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我都",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "絕對不會忘記。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不管是溫熱的紅茶、",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "色彩鮮艷的蛋糕、",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還是兄長大人的臉龐。",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真是至高的幸福。",
    "voice": "vo_adv_4010171_009",
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n謝謝您，",
    "voice": null,
    "unit_id": 125831
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人……♪",
    "voice": null,
    "unit_id": 125831
  }
]
