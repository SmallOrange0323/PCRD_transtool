  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧從有些距離的地方",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遠望著露娜和玩偶遊玩的樣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……呵呵。",
    "voice": "vo_adv_7026004_000",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜和玩偶說話的時候，",
    "voice": "vo_adv_7026004_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n看起來非常開心呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我在幫好朋友號維修保養的時候",
    "voice": "vo_adv_7026004_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也會專注到忘了時間，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可以說我很了解這種心情吧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "或許形式不同，",
    "voice": "vo_adv_7026004_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但對露娜來說，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩偶果然是很特別的存在呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………啊。",
    "voice": "vo_adv_7026004_004",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……嗯？　",
    "voice": "vo_adv_7026004_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……這裡。",
    "voice": "vo_adv_7026004_006",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026004_007",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……雖然以前媽媽會修補，",
    "voice": "vo_adv_7026004_008",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n但對露娜來說太難了……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥",
    "voice": "vo_adv_7026004_009",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "會修補嗎？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026004_010",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_7026004_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不介意的話，",
    "voice": "vo_adv_7026004_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n可以讓我來縫補露娜的玩偶嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為好朋友號",
    "voice": "vo_adv_7026004_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "從以前就很常",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "彈飛到各種地方，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n每次斗篷都會變得破破爛爛的呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以",
    "voice": "vo_adv_7026004_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我身上也隨時帶著維修用的裁縫組……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只要露娜不介意的話……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……可以嗎？",
    "voice": "vo_adv_7026004_015",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "當、",
    "voice": "vo_adv_7026004_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "當然可以……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我稍微跟妳借一下玩偶喔……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "哇……",
    "voice": "vo_adv_7026004_017",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "你看！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n好像魔法一樣耶！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "欸嘿嘿……！",
    "voice": "vo_adv_7026004_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這麼說可能有些太自吹自擂，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不過我算是個手巧的人啦……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以，",
    "voice": "vo_adv_7026004_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼一點小事我就算閉著眼也能──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊嗚！？",
    "voice": "vo_adv_7026004_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "！？",
    "voice": "vo_adv_7026004_021",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……感覺",
    "voice": "vo_adv_7026004_022",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "手指很痛。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": "vo_adv_7026004_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我太得意忘形了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……要不要",
    "voice": "vo_adv_7026004_024",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "用露娜的手帕？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不用不用……！",
    "voice": "vo_adv_7026004_025",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這點小傷不要緊……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我這次會確實睜開眼縫補的……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026004_026",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呼……",
    "voice": "vo_adv_7026004_027",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "完成了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n以我而言，縫得還挺不錯的！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜，",
    "voice": "vo_adv_7026004_028",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "來，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請收下！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……啊。",
    "voice": "vo_adv_7026004_029",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嗯……",
    "voice": "vo_adv_7026004_030",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大姐姐，",
    "voice": "vo_adv_7026004_031",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……謝謝妳。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "她、",
    "voice": "vo_adv_7026004_032",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "她看著我的眼睛對我笑了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我有學會裁縫技術",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是太好了……！　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我才是……！",
    "voice": "vo_adv_7026004_033",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n要謝謝妳……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……那個，",
    "voice": "vo_adv_7026004_034",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n露娜想說的",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "並不只有謝謝……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什麼？",
    "voice": "vo_adv_7026004_035",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……該、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "該不會我沒確實縫補好！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不是的……",
    "voice": "vo_adv_7026004_036",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大姐姐，",
    "voice": "vo_adv_7026004_037",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "雖然妳很怪。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……雖然妳很怪。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不過，",
    "voice": "vo_adv_7026004_038",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜不討厭妳喔。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……可以稍微",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "和妳玩一下喔。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚、",
    "voice": "vo_adv_7026004_039",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚哇啊啊啊～！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真的嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": "vo_adv_7026004_040",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我好高興！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不嫌棄的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請務必讓我陪妳玩！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……呵呵，",
    "voice": "vo_adv_7026004_041",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n妳果然很怪，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "好有趣。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧和露娜透過玩偶稍微拉近了距離，",
    "voice": null,
    "unit_id": null
  },
  {
