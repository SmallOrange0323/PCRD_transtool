    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "想不到來到宅邸，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "竟然還得接受戰鬥訓練。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我已經累垮了！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是、",
    "voice": "vo_adv_6061105_001",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我課已經上到渾然忘我，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "自己也不是很清楚……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "以往所鍛鍊出來的力氣",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "的確幫了大忙。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "多虧了平常的勞力工作呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真令人感激。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的耶！",
    "voice": "vo_adv_6061105_002",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是之前的變身蘋果",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我肯定已經動不了了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為了報答似似花，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我一定要參加舞會！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣說",
    "voice": "vo_adv_6061105_003",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也太誇張了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我沒辦法像",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "【哞哞自衛隊】那樣守護鎮上的大家。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要擁有能夠守護重要夥伴",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "的力量",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那就足夠了。",
    "voice": null,
    "unit_id": 115812
  }
