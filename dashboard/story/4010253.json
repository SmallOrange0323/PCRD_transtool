    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你還好吧？",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "慢慢來就好，",
    "voice": "vo_adv_4010253_001",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小心不要滑倒啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搞笑藝人可是嚴禁",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "滑鐵盧的～♪",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "話說回來，",
    "voice": "vo_adv_4010253_002",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝你今天陪我來。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒想到",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這邊居然可以爬山的啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n雖然在故鄉的話，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "想爬多少山都可以的說。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯～",
    "voice": "vo_adv_4010253_003",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "又老了一歲吧。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也是許願",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "自己一定要實現",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "成為搞笑藝人的夢想啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在山頂上",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大聲喊出",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "「我的目標是成為頂尖的搞笑藝人」。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "讓老哥陪我一起來",
    "voice": "vo_adv_4010253_004",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是希望",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你能見證這一刻啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嘿嘿。",
    "voice": "vo_adv_4010253_005",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n那是當然的啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "background",
    "bg_id": "510270"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊～",
    "voice": "vo_adv_4010253_006",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好美的景色，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "讓我想起故鄉了。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n能平安順利登頂，真是太好了啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果是自己一個人來的話，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大概就沒有這樣的成就感了吧。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這一切都是",
    "voice": "vo_adv_4010253_007",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為有老哥啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我沒有放棄成為搞笑藝人，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也是因為",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有你這個可靠的搭檔在我身邊。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嘿嘿、",
    "voice": "vo_adv_4010253_008",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝你啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你還準備了禮物嗎！？",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "明明會增加負擔，",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還是一路為我背到這裡嗎……",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": "vo_adv_4010253_009",
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "超開心的啦。",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我一定會成為搞笑藝人給你看的！",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個……",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "請你",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一直在我身邊",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看著",
    "voice": null,
    "unit_id": 103333
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我吧……♪",
    "voice": null,
    "unit_id": 103333
  }
