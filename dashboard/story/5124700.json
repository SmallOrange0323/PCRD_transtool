[
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "クリスマススイーツコンテストのあと……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nこの日もミヤコと{0}は、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nおばあさんのお店を訪れていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "おばあちゃん～！",
    "voice": "vo_adv_5080700_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nミヤコにプリン作ってなの～！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "お腹ぺこぺこなの～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "ごめんねミヤコちゃん。",
    "voice": "vo_adv_5080700_001",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "\\nおばあちゃん、",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "これから買い出しに行かなきゃいけなくて。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "帰ってきたら作ってあげるからね。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "う～……",
    "voice": "vo_adv_5080700_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "わかったの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n待ってるから早く帰ってくるの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "ふふ、",
    "voice": "vo_adv_5080700_003",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "わかったわ。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "おばあさん",
    "words": "お利口にして待っててちょうだいね。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "……遅いの。",
    "voice": "vo_adv_5080700_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコが遅いって言ったら遅いの！",
    "voice": "vo_adv_5080700_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコお腹が空いて死にそうなの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "お腹空いたの～！　",
    "voice": "vo_adv_5080700_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "プリンが食べたいの～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "そうだ！　",
    "voice": "vo_adv_5080700_007",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "オマエ、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコのためにプリンを作るの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "材料はあるはずなの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "下手くそなの！",
    "voice": "vo_adv_5080700_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nおばあちゃんはそんな風にやってなかったの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "むぅ……",
    "voice": "vo_adv_5080700_009",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコのほうがうまくできる気がするの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ちょっと貸すの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "できたの！　",
    "voice": "vo_adv_5080700_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "たくさん作ったの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nさすがミヤコなの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "全部おいしくいただきますなの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "…………しょっぱいの。",
    "voice": "vo_adv_5080700_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n砂糖と塩を間違っちゃったみたいなの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nこんなのプリンじゃないの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "あっ！　",
    "voice": "vo_adv_5080700_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコより先に食べるなんて何考えてるの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "何言ってるの？　",
    "voice": "vo_adv_5080700_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "プリンが辛いわけないの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "そのプリンには",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "きれいな赤い粉を入れたからおいしいはずなの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "え～～っと……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "あ。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "とうがらしって書いてあるの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "危ないところだったの。",
    "voice": "vo_adv_5080700_014",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nオマエが先に食べてくれて助かったの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "うぅ～～",
    "voice": "vo_adv_5080700_015",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "プリン作りは難しいの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nおいしいプリンが食べられなくて",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ボ～っとしてきたの……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "いつもオマエにプリンもらってるから、",
    "voice": "vo_adv_5080700_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nだんだんオマエの顔がプリンに見えてきたの……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "オマエ、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "プリン……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "あっ！　",
    "voice": "vo_adv_5080700_017",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "いいこと思いついたの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nさすがはミヤコなの！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "天才なの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ちょっと待ってるの！",
    "voice": "vo_adv_5080700_018",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "──やったの！　",
    "voice": "vo_adv_5080700_019",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "うまくいったの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ほらほら見てなの！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "オマエの顔をしたプリンなの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nおもしろいの～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "オマエの顔、",
    "voice": "vo_adv_5080700_020",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "プリンになってもマヌケなかんじなの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nでも香りは悪くないの。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "いただきますなの～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "もぐもぐ。",
    "voice": "vo_adv_5080700_021",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "んむむ……？　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "こ、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "これは……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "びっくりなの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nこのプリン、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "マヌケな顔してけっこーイケるの！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "そのへんにあった適当な材料で作ったのに、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "過去最高の出来なの～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "もしかして",
    "voice": "vo_adv_5080700_022",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "誰かの顔を真似っこすれば、",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nおいしい究極のプリンができるの……？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "わかったのっ！",
    "voice": "vo_adv_5080700_023",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nこうなったら…………",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "みんなをプリンにしてやるの～～～っ！",
    "voice": null,
    "unit_id": 100711
  }
]
