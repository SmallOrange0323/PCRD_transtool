    "words": "等一下。",
    "voice": "vo_adv_1157001_067",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然我不是女朋友……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但只要這樣回答，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n他會不會就輕易地把事情告訴我呢……？　",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那、",
    "voice": "vo_adv_1157001_068",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不瞞你說，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我就是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他的女、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "女朋──",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──友！？",
    "voice": "vo_adv_1157001_069",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "友──",
    "voice": "vo_adv_1157001_070",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有什麼事嗎助手先生！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你什麼",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "時候來的！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不對，比起這個，",
    "voice": "vo_adv_1157001_071",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你沒聽見吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你什麼都沒有聽見對吧！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "小哥，",
    "voice": "vo_adv_1157001_072",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "你今天也要去那裡嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n那就快點把東西",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "搬上車吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等等！",
    "voice": "vo_adv_1157001_073",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我們現在就把事情弄清楚吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": "vo_adv_1157001_074",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你究竟在做些什麼？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n雖然我知道你有在做送貨的打工，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但卻突然就不來找我了……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個，",
    "voice": "vo_adv_1157001_075",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你可是我的助手，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n至少可以告訴我，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你在做什麼事吧……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦！？",
    "voice": "vo_adv_1157001_076",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "嗯，",
    "voice": "vo_adv_1157001_077",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "我準備好了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n那麼就出發吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1157001_078",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "祕密……",
    "voice": "vo_adv_1157001_079",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "居然說是祕密？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "面對我這位名偵探，",
    "voice": "vo_adv_1157001_080",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n竟然敢堂堂正正地說出祕密這兩個字……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_1157001_081",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好吧，助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我就把你這句話",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當成是對我的挑戰了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就由我名偵探霞，",
    "voice": "vo_adv_1157001_082",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n來揭穿助手先生",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "想要隱藏的真相吧！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霞燃起了身為偵探的探求心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她抱著這份熱情，開始追查{0}。",
