[
  {
    "type": "background",
    "bg_id": "500041"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花和{0}忘卻了時間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n沉浸於撲克牌的樂趣中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀，",
    "voice": "vo_adv_1150004_000",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "已經過掉不少時間了呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n一不小心我竟像個孩子一樣沉迷於打牌。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好啊，",
    "voice": "vo_adv_1150004_001",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我正好有點渴了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n請把那邊的玻璃杯拿給……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼回事？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "玻璃杯發出了奇異的光芒……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不明的",
    "voice": "vo_adv_1150004_002",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "發光現象……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這還……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "讓人──",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "恭賀新喜，",
    "voice": "vo_adv_1150004_003",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我是來家庭訪問的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "快點開門。",
    "voice": "vo_adv_1150004_004",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n外面十分寒冷呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "戒心",
    "voice": "vo_adv_1150004_005",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還真重啊。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這說明你有一定程度的危機意識，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我反倒安心了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大過年的，",
    "voice": "vo_adv_1150004_006",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也不打算和你做無謂的鬥爭。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只是來拜個年，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "然後，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "簡單地做個家庭訪問而已。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了你著想，",
    "voice": "vo_adv_1150004_007",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是別廢話快點把門打開吧？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只要我動動手，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不要說這道門鎖，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要把你家所有東西全打開都不是什麼難事。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "still",
    "still_id": "115000401"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呼，",
    "voice": "vo_adv_1150004_008",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真暖和……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n室內真是舒服多了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "啊，",
    "voice": "vo_adv_1150004_009",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不需要招待我。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我已經事先確認過",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你父母都不在家了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我的到訪讓你很驚訝吧。",
    "voice": "vo_adv_1150004_010",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你真的把我說的",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n「在現實見面將會是第一次也是最後一次」",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當真了？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "竟然輕易相信敵人的說詞，",
    "voice": "vo_adv_1150004_011",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你真是善良過頭了呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n那之後",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在阿斯特朗的戰鬥",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也沒能分出勝負。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以那次頂多算平手哦、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "平手。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……你現在心裡應該在想，",
    "voice": "vo_adv_1150004_012",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我為什麼",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會來這裡吧？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是愚蠢的問題。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我說過了吧，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只是來做家庭訪問的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150004_013",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "快去把考試卷和成績單拿來。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n七冠的時間",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可是非常寶貴的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "still",
    "still_id": "115000402"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……嗯，",
    "voice": "vo_adv_1150004_014",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "比我想像中的還差呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所有成績都是中等的中、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "優良的中。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你都快變成「中等」的化身了呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而且，",
    "voice": "vo_adv_1150004_015",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你最近的考試成績也不太理想……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是沉迷在阿斯特朗的世界裡，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "疏於學習了吧？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是誰的錯呢？",
    "voice": "vo_adv_1150004_016",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不會是我的錯吧？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你不是",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也忙著與克莉絲和拉基拉基交手嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "竟然對一個學生這麼過分……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在這種時代還禁止他人玩遊戲",
    "voice": "vo_adv_1150004_017",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就太愚蠢了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但請你注意分寸。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再這樣下去，",
    "voice": "vo_adv_1150004_018",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你能去的大學就所剩無幾了喔。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你有考慮過",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "升學的事嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來是沒考慮過呢。",
    "voice": "vo_adv_1150004_019",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這麼重要的事，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你需要謹慎思考才行，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但剩下的時間已經不多了吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "打算繼續升學的話，",
    "voice": "vo_adv_1150004_020",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在就應該馬上開始備考了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n打算就讀職業學校、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或是想直接就職，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也需要與父母和班導師商量，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再選擇適合自己的路。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這關乎到你今後的人生，",
    "voice": "vo_adv_1150004_021",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是非常重要的決定。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還請你別太草率對待。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "才不是「真像」，",
    "voice": "vo_adv_1150004_022",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我本來就是老師。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "升學的事",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就說到這裡吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你在現實生活中，",
    "voice": "vo_adv_1150004_023",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有任何不安或是煩惱嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n放眼未來固然重要，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但現下也",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "同樣馬虎不得喔。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "若校園生活或健康狀況出現了任何問題，",
    "voice": "vo_adv_1150004_024",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n都可能影響你的未來。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在我看來……",
    "voice": "vo_adv_1150004_025",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你有點",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "遊戲成癮了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "除了遊戲以外，",
    "voice": "vo_adv_1150004_026",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你在學校裡有朋友嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你是學生，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還是多試著",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "融入校園生活會比較好。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我能理解以遊戲為中心的社交圈很有趣。",
    "voice": "vo_adv_1150004_027",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但高中生活，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是只有現在才能體驗的珍貴時光。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你若不好好享受，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "等長大時後悔也來不及了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "接下來，",
    "voice": "vo_adv_1150004_028",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對了，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是關於健康方面……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在畢竟是寒假期間，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有些不健康的生活作息我就先不追究了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "若是懶得在寒冷的冬天運動，",
    "voice": "vo_adv_1150004_029",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n至少要好好吃三餐。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你吃過年菜了嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那就好，",
    "voice": "vo_adv_1150004_030",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "每道年菜",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "都飽含著各自的寓意。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在吃下它們的同時理解其背後的故事，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也不失為一種學習手段。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150004_031",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你有打算吃七草粥嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這可不好啊。",
    "voice": "vo_adv_1150004_032",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "確實，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在充斥著美味食物的現代，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n七草粥或許不算是吸引人的食物。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": "vo_adv_1150004_033",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "據說七草有避邪的功效，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還富含營養價值。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "像你這種年輕人，",
    "voice": "vo_adv_1150004_034",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "本來就時常飲食不均衡。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不趁這個機會",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好好補充營養，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n可無法成長茁壯喔？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_1150004_035",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你剛才說的話我就當作沒聽見。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n可不會有第二次機會喔？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "下次再說出這種話，",
    "voice": "vo_adv_1150004_036",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我會捏造關於你的負面傳聞，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n散播至世界各地，讓你徹底失去在社會上的立足之地。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼有氣無力的？",
    "voice": "vo_adv_1150004_037",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那就再重來一次……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……很好。",
    "voice": "vo_adv_1150004_038",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請你今後",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "多加注意。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……話說回來，",
    "voice": "vo_adv_1150004_039",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你能分別說出「春七草」有哪些嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你在說什麼？",
    "voice": "vo_adv_1150004_040",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我什麼也沒聽──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……唉，",
    "voice": "vo_adv_1150004_041",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算是七冠，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也奈何不了",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "肉體的生理現象呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們來吃飯吧。",
    "voice": "vo_adv_1150004_042",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n廚房",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "稍微借我用一下。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "感到榮幸吧，",
    "voice": "vo_adv_1150004_043",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天就特別",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n讓你嚐嚐我親手做的料理。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "still",
    "still_id": "115000403"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……久等了。",
    "voice": "vo_adv_1150004_044",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是七草粥。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還很燙，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請小心慢用。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你的母親",
    "voice": "vo_adv_1150004_045",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在網路上訂購了年菜，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n卻唯獨沒有買七草呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以今年",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就由我來做給你吃。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "做菜這種事，",
    "voice": "vo_adv_1150004_046",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只要具備正確的知識與食譜，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n誰都能辦得到。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再怎麼誤會，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也別把我和晶混為一談。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "比起這個，味道如何？",
    "voice": "vo_adv_1150004_047",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好吃嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是嗎……",
    "voice": "vo_adv_1150004_048",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "話說回來，",
    "voice": "vo_adv_1150004_049",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「七」這個數字",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不僅在日本，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "連在西洋也具有特別的意義。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在你的身邊，",
    "voice": "vo_adv_1150004_050",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "應該也存在不少被冠以「七」的事物吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n七曜、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "七福神、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "北斗七星、",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "七種工具……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以說，",
    "voice": "vo_adv_1150004_051",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "被七冠招待七草粥，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是相當特別的體驗喔。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "感到光榮吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……呵，",
    "voice": "vo_adv_1150004_052",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然不是。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你覺得我有可能為了講這麼無聊的笑話，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n大費周章地做料理嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你吃了我精心準備的粥，",
    "voice": "vo_adv_1150004_053",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以在敗給我之前，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "都請無病無災喔。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀，",
    "voice": "vo_adv_1150004_054",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你這副表情，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是懷疑我在食物裡動了手腳嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "別開玩笑了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "難得的新年，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就算是我",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也想好好放鬆一下呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過……",
    "voice": "vo_adv_1150004_055",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "倒也不能說沒有動過",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n想抓住你的胃，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n再把你變成我私有物的念頭。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150004_056",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我現在要詢問你在校外的交友關係。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我有點在意",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你的女性交友狀況……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好啦好啦，新年快樂。",
    "voice": "vo_adv_1150004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還有辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要不是正處於這個時期，",
    "voice": "vo_adv_1150004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和似似花可是碰不到面的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n機會難得，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我稍微瀏覽了一下情報喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒想到剛過新年就碰上七冠在家門口埋伏，",
    "voice": "vo_adv_1150004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我都替你捏了把冷汗呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": "vo_adv_1150004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "似似花到底在盤算著什麼？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n竟然對敵人做出這種雪中送炭的行為……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不太可能是真心當你的老師吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "千萬不能大意，",
    "voice": "vo_adv_1150004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也不能全盤相信她，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但至少以現階段來說，她似乎還沒有害人之心……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許她背地裡有著什麼陰謀，",
    "voice": "vo_adv_1150004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但至少和你在一起時\\n的開心模樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看起來不似作假呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然不知道似似花的企圖，",
    "voice": "vo_adv_1150004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但和她接觸",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也能讓你有所成長。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "把握住這個機會變強，",
    "voice": "vo_adv_1150004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓她大吃一驚吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今年也繼續多多指教啦──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500041"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……剛剛到底",
    "voice": "vo_adv_1150004_065",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "發生了什麼事？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我竟然如此輕易地",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "喪失了行動能力。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你有看到吧？",
    "voice": "vo_adv_1150004_066",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "麻煩和我說明情況。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "是。",
    "voice": "vo_adv_1150004_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有備份才能防患未然。",
    "voice": "vo_adv_1150004_068",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是理所當然的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在我們睡著的期間，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有遭受到任何的攻擊、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n或是",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有任何人前來交涉嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "沒有，",
    "voice": "vo_adv_1150004_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "在我的監控範圍中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n沒有出現任何類似的異狀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣啊。",
    "voice": "vo_adv_1150004_070",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只是單純讓我們睡著而已。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真令人費解……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不對，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果說對方的真實目的不是讓我們睡著，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n而是讓我們做夢呢？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "根據我夢中的情報……",
    "voice": "vo_adv_1150004_071",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我突然出現在你家門口，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "煮了頓飯給你吃。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……什麼啊，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是個意義不明的夢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你也是嗎？",
    "voice": "vo_adv_1150004_072",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "和他人做相同的夢……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很有意思呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這應該和我們的突然昏睡",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有些關聯。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我還是猜不透讓我們做那個夢的目的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這件事明顯缺乏情報，",
    "voice": "vo_adv_1150004_073",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n再繼續推測下去",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也得不到結論。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "話說回來，",
    "voice": "vo_adv_1150004_074",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在夢中，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們吃了某種開運食物呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "把這個夢當作啟示，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n晚餐去吃些吉利的食物吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "恐怕",
    "voice": "vo_adv_1150004_075",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你今年也將面臨殘酷命運，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "絕不可能無病無災吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": "vo_adv_1150004_076",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你也不能因此停止祈願喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "心願",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有時也能顛覆命運。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150004_077",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n去祈求度過一個無災無難的一年。",
    "voice": null,
    "unit_id": 115011
  },
