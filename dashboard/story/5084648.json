[
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}一直沒有醒來呢。",
    "voice": "vo_adv_5084648_000",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n大家都很擔心啊。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的有很多、",
    "voice": "vo_adv_5084648_001",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很多女孩子在擔心你。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都讓人家有點嫉妒了……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "亂說的，當然沒這回事啦。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為大家都跟你一樣是很溫柔的好人。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就像跟你在一起時一樣，心情會變得很溫暖。",
    "voice": "vo_adv_5084648_002",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但相對地……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你不在的話，就又不禁讓人感到寂寞了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我想大家一定都是跟我一樣的心情。",
    "voice": "vo_adv_5084648_003",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要快點醒來喔。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n讓人感到寂寞可不像你啊。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我相信我們還能再一起歡笑著。",
    "voice": "vo_adv_5084648_004",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我會滿心期待地等著那一刻的喔。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為我相信如果是你，一定會沒事的。",
    "voice": null,
    "unit_id": 105213
  }
]
