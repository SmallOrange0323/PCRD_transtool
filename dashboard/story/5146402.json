  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんとかオレたち、",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "飛空艇に乗りこんでここまで戻ってきたけれど、",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nトミヱ先輩のやつ、",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "何度倒しても",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "起き上がってくるんだもんな。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "クロエ君、",
    "voice": "vo_adv_5140402_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "主人公風に状況説明をしている場合ではない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ようやく障害を乗り越えたのだ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "急ぎプランを進めよう。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そうですね。",
    "voice": "vo_adv_5140402_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n流石にここまで来れば、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nトミヱ先輩も緑の監視員さんもいないですし。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "はー、",
    "voice": "vo_adv_5140402_003",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "邪魔が入らないって最高だわ。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そんじゃ、まぁ、",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "鬼のいぬ間に有終の美ぃ飾っとくかァー！",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "めでたしめでたし！　",
    "voice": "vo_adv_5140402_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ちぇる～ん☆",
    "voice": null,
    "unit_id": 110911
  }
