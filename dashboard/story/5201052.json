[
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，",
    "voice": "vo_adv_5201052_000",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "今天要做什麼樣的可麗餅",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "才好呢？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不論在什麼情況下都要創作新口味的可麗餅，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我這個人啊，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還真是可麗餅攤商的典範呢～！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……奇怪？",
    "voice": "vo_adv_5201052_001",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n車裡好像有什麼東西……",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是錄音筆？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是因為前陣子的汽車追逐戰而掉出來的嗎？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "裡面錄了什麼來著……",
    "voice": "vo_adv_5201052_002",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "引發危險的可能性～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "看來沒有。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就來播放吧。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是誰？",
    "voice": "vo_adv_5201052_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在我做的角色模型上加了裝飾品。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n顯而易見地增加太多了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣看起來豈不是很突兀？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "比起那種事，",
    "voice": "vo_adv_5201052_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有誰能陪我在測試用場景裡進行模擬戰鬥？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我想實際確認一下戰鬥數據。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我來陪妳吧，",
    "voice": "vo_adv_5201052_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "克莉絲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n另外，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "傳送門實裝完畢了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "麻煩妳確認一下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n因為妳即使被卡在牆壁裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "也不會有問題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊～",
    "voice": "vo_adv_5201052_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "糟糕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n好像有東西對場景造成負荷了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n是哪個物件啊～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "都是因為妳太講究多餘的細節了。",
    "voice": "vo_adv_5201052_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n讓我看看程式碼……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是這個和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "那個互相干涉了吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n拜託妳別害我多花力氣做這種事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "各位，",
    "voice": "vo_adv_5201052_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "可別忘了寫進度報告。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n……不過在場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "沒一個會乖乖聽話的人吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "…………",
    "voice": "vo_adv_5201052_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這是……",
    "voice": "vo_adv_5201052_010",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "以前的……",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……真令人懷念。",
    "voice": "vo_adv_5201052_011",
    "unit_id": 106832
  },
  {
    "type": "still",
    "still_id": "520105201"
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "下回，",
    "voice": "vo_adv_5201052_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "「潛入‧阿斯特朗　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "七個願望與創世之殘響」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你是否擁有呢──",
    "voice": "vo_adv_5201052_013",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "太陽與星星的祝福。",
    "voice": null,
    "unit_id": 106831
  }
]
