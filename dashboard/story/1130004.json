    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩……",
    "voice": "vo_adv_1130004_005",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那麼，",
