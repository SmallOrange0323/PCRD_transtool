[
  {
    "type": "background",
    "bg_id": "500123"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃～",
    "voice": "vo_adv_2003004_000",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n吶、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n對不起，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還醒著嗎……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚耶……",
    "voice": "vo_adv_2003004_001",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎麼了嗎，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯……",
    "voice": "vo_adv_2003004_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n妳有沒有，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "聽到什麼奇怪的聲音……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "聲音……？",
    "voice": "vo_adv_2003004_003",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "還是，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n可能是咲戀媽媽她們還醒著吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "現在，幾點……？",
    "voice": "vo_adv_2003004_004",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "唔唔，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "今天晚睡了，好睏唷‥‥？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_2003004_005",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n對不起，把妳吵醒了。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒關係……",
    "voice": "vo_adv_2003004_006",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有時候我做惡夢之類的時候，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n綾音妳也會擔心我，陪我一起睡……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以這次換我來幫妳，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "應該說，我想報恩……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音，不如一起睡覺吧……？",
    "voice": "vo_adv_2003004_007",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "和我一起的話會安心吧，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一定會睡得很甜的……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯～一個人睡不著真像個小寶寶呢。",
    "voice": "vo_adv_2003004_008",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我，比起胡桃應該是姐姐吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過，算了。",
    "voice": "vo_adv_2003004_009",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這次就看在胡桃的份上，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n陪妳一起睡吧……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "…………",
    "voice": "vo_adv_2003004_010",
    "unit_id": 102111
  },
  {
    "type": "still",
    "still_id": "200300401"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘎，嘎啊啊啊啊啊！？",
    "voice": "vo_adv_2003004_011",
    "unit_id": 102311
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500122"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": "vo_adv_2003004_012",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請醒來，主人。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "早安。",
    "voice": "vo_adv_2003004_013",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "夜深時分，在下自知失禮。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抱歉打擾主人休息了。",
    "voice": "vo_adv_2003004_014",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可以稍微聽聽在下說話嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呃，那個。",
    "voice": "vo_adv_2003004_015",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下，並不是因為覺得一個人睡果然還是很寂寞才過來的……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在鈴莓小姐殷切地告誡之下，",
    "voice": "vo_adv_2003004_016",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n雖然不大情願，但在下還是接受了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "至少，她還是讓在下睡在離主人寢室最近的房間，",
    "voice": "vo_adv_2003004_017",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也做好了準備，如果有異狀可以馬上過來支援。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此夜裡如果有任何動靜⋯⋯",
    "voice": "vo_adv_2003004_018",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請任意大聲呼喚讓在下知道。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下在幾秒內就能趕來。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咳咳。",
    "voice": "vo_adv_2003004_019",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "言歸正傳，您剛剛有聽到慘叫聲嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_2003004_020",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n好像是女孩子的聲音，聽起來很尖銳……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "希望只是在下幻聽了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。白天時，已經多次處於生死關頭呢……",
    "voice": "vo_adv_2003004_021",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最好還是保持警戒。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n最壞的情況，有可能再遇到襲擊。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "遇到緊急狀況時，就可以馬上行動。",
    "voice": "vo_adv_2003004_022",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下，一直在守夜。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然有點半夢半醒的。",
    "voice": "vo_adv_2003004_023",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然後就聽到了慘叫聲。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為保險起見，在下就前來查看主人有沒有事。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_2003004_024",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看到主人四平八穩地睡著，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就放心了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人沒事，真是太好了……",
    "voice": "vo_adv_2003004_025",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓主人一個人睡，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n使在下擔心得不得了啊。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，主人。",
    "voice": "vo_adv_2003004_026",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下最重要、最重要的主人……♪",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘎啊啊啊！？",
    "voice": "vo_adv_2003004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，又聽到慘叫了！",
    "voice": "vo_adv_2003004_028",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這果然不是在下的錯覺吧？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯。",
    "voice": "vo_adv_2003004_029",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n慘叫聲好像是從育幼院的……大廳傳來的。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下先去看看情況。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人請先在這裡等候。",
    "voice": "vo_adv_2003004_030",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不對……這裡也不一定安全，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請與在下一起去。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是襲擊的話……",
    "voice": "vo_adv_2003004_031",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下也一定會想辦法讓主人逃走的。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "穿著睡衣好像不太好，",
    "voice": "vo_adv_2003004_032",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請披上披風。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再來只要拿劍就可以了吧。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "走吧，",
    "voice": "vo_adv_2003004_033",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請務必多加留意。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也請不要太遠離在下。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "background",
    "bg_id": "500112"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚啊啊啊！",
    "voice": "vo_adv_2003004_034",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n討厭啦啊啊！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "still",
    "still_id": "200300402"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好恐怖好恐怖，好恐怖！",
    "voice": "vo_adv_2003004_035",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我，我在那裡！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我，站在窗外面呀！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒有說謊哦，要相信我！",
    "voice": "vo_adv_2003004_036",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我都不會說謊的喔，我是好孩子！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "果然，是這樣呀！",
    "voice": "vo_adv_2003004_037",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n和爸爸媽媽一樣，我不是『真』的！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "站在窗外面的人，才是『真正的我』呀！",
    "voice": "vo_adv_2003004_038",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n所以，所以……嗚啊啊啊！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "background",
    "bg_id": "500112"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇，冷靜一點，小綾音！",
    "voice": "vo_adv_2003004_039",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒關係的，不要哭了～",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打擾了。",
    "voice": "vo_adv_2003004_040",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不好意思，請問為何騷動呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，可可蘿，還有{0}也……",
    "voice": "vo_adv_2003004_041",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思，吵醒你們了呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯。我也是聽到尖叫才剛驚醒，",
    "voice": "vo_adv_2003004_042",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還不太清楚狀況……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好像是小綾音做惡夢了？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那、",
    "voice": "vo_adv_2003004_043",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那不是夢！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我真的看到了，我就在那裡！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡、胡桃妳願意相信我吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……",
    "voice": "vo_adv_2003004_044",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不知道呀……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "still",
    "still_id": "200300403"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音，明明和我一起睡覺的……",
    "voice": "vo_adv_2003004_045",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n但窗外面，竟然有另一個綾音……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯，怎麼一回事？",
    "voice": "vo_adv_2003004_046",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "小胡桃也看到了那個什麼……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n『另一個小綾音』了嗎？\"",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "兩個人都不像是會說謊的孩子……",
    "voice": "vo_adv_2003004_047",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會不會只是窗戶玻璃倒映出小綾音的臉呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你們看到倒影，",
    "voice": "vo_adv_2003004_048",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n覺得不應該出現在窗外的小綾音竟然在那裡……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因此才受到驚嚇之類的吧？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是哦，雖然站在窗外面的人是我但不是真的我呀！",
    "voice": "vo_adv_2003004_049",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n那雙眼睛發亮，和我的眼睛的顏色都不一樣！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還一邊看著我一邊笑著說了些什麼呢！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500112"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯、嗯。",
    "voice": "vo_adv_2003004_050",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n雖然不太明白，該怎麼辦……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我到外頭去看看情況吧。",
    "voice": "vo_adv_2003004_051",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n若是可疑人物或是魔物的話就不好了，以防萬一。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯。",
    "voice": "vo_adv_2003004_052",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果是魔物的話，一個人去會很危險吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而且鈴莓小姐看起來似乎也不擅長戰鬥。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不……",
    "voice": "vo_adv_2003004_053",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n沒關係的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我只是去看看情況而已。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可可蘿你們，",
    "voice": "vo_adv_2003004_054",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就待在小綾音她們身邊吧。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "若是覺得不對勁的話，我會大聲呼叫的，",
    "voice": "vo_adv_2003004_055",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n到時候請帶著大家去避難。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會試著爭取讓大家逃走的時間。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐去參加會議，所以不在……",
    "voice": "vo_adv_2003004_056",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n因此，守護【咲戀育幼院】的大家就是我現在的責任。",
    "voice": null,
    "unit_id": 102511
  }
]
