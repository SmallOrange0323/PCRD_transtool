    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "把它好好修好，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "讓它能繼續使用到長長久久吧。",
