    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咖啡廳",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "「Naschkatze」的身分！",
