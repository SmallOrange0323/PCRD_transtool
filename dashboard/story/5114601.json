    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這棟建築物",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "本來根本不該壞掉喔。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "話是這樣說沒錯喵～",
    "voice": "vo_adv_5114601_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但既然壞了也沒辦法喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只要修好後，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "再珍惜地使用就好喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這棟建築物一定也是",
    "voice": "vo_adv_5114601_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從以前就這樣子",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "被珍惜地使用到現在喵。",
