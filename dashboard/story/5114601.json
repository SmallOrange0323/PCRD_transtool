    "voice": "vo_adv_5114601_005",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "招財貓，",
    "voice": "vo_adv_5114601_006",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你也是這麼想的對吧？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵～",
    "voice": "vo_adv_5114601_007",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_5114601_008",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們現在",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真的是夥伴了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一起",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "攜手前進吧。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……話說回來，",
    "voice": null,
    "unit_id": 125212
  },
