    "words": "{0}也來這邊，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一起睡午覺吧喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "畢竟你今天也很早起",
    "voice": "vo_adv_5114601_038",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就來修理店面了哪……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_5114601_039",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
