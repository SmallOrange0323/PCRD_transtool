    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是和我們戰鬥過的關係嗎？",
    "voice": "vo_adv_5114601_010",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我來把你弄乾淨吧！",
