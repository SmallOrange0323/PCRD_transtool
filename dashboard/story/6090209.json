  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "パレードといっても",
    "voice": "vo_adv_6050209_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "歩くだけだと思っていたけど、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "意外とやることがあったんだね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あの子たちはきちんとできていてすごかったな。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "そう言ってもらえるとうれしいよ。",
    "voice": "vo_adv_6050209_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "でもあのときは、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "むしろあの子たちに助けられたかな。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ふふっ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "本当に最初の頃とは大違いだったよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ああ。",
    "voice": "vo_adv_6050209_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あの子たちを見ていると",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "自然とね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "本当に立派なお化けだったよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "たとえ怖くなくたってね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "次はもっと上手にできるといいな。",
    "voice": "vo_adv_6050209_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "なんて言うと",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ツムギが張り切りそうだから、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n少し内緒にしておこうか。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "サプライズにとっておきたいし。",
    "voice": null,
    "unit_id": 114011
  }
]
