  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鏘～！　",
    "voice": "vo_adv_1083002_034",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如何如何？",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n是不是有種魔性之女的感覺！？",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呵呵……",
    "voice": "vo_adv_1083002_035",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可以拜倒在我的裙下唷！",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "小姑娘，妳好可愛唷～。",
    "voice": "vo_adv_1083002_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "簡直就像是魔法少女一樣。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我不是魔法少女，",
    "voice": "vo_adv_1083002_037",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是魔女！　",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "魔女啦！",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哎呀，",
    "voice": "vo_adv_1083002_038",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那真是失禮了！　",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "把我當成小孩子！",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也、",
    "voice": "vo_adv_1083002_039",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也是呢！　",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "看來{0}也很懂嘛！",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對吧～！　",
    "voice": "vo_adv_1083002_040",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也是這麼想的呢～♪",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一口氣就讓我",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "衝上了大人的階梯！",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然你也那麼喜歡的話，",
    "voice": "vo_adv_1083002_041",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n是不是把這套",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "給買下來呢……",
