  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "扮裝還頗貴的呢……",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n早知道這樣，",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就多存一些零用錢了……",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？　",
    "voice": "vo_adv_1083002_043",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說要稍微幫我出一些嗎？",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當作是教你何謂萬聖節樂趣的謝禮……",
    "voice": "vo_adv_1083002_044",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既、",
    "voice": "vo_adv_1083002_045",
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然你都這麼說了，",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那我就不客氣接受你的好意！",
