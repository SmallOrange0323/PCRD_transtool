    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過這樣還是不夠……",
    "voice": null,
    "unit_id": 108311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "明明你都幫忙出了一些說……",
