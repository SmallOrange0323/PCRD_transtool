    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "錢不太夠嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這也是沒辦法的事呢～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那我只好算你們便宜啦！　",
