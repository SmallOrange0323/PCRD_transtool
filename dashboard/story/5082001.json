[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "盛裝打扮的【美食殿堂】成員，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在蘭德索爾的街上偶然遇見了流夏和伊莉亞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n幾人站在一起讓四周的氣氛變得華麗起來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來流夏小姐與伊莉亞小姐",
    "voice": "vo_adv_5082001_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "交情很好呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身還是頭一次",
    "voice": "vo_adv_5082001_001",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "與她如此對話！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身是從依里那",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聽說有個很了解新年的人。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我則是從七七香那聽說",
    "voice": "vo_adv_5082001_002",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有想要了解新年的人，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n所以才來的。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "的確，",
    "voice": "vo_adv_5082001_003",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "流夏看起來對這種習俗很了解呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "穿新年和服盛裝慶祝",
    "voice": "vo_adv_5082001_004",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是東國的習俗。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "東國出身的我",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當然會曉得。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們也穿新年和服……",
    "voice": "vo_adv_5082001_005",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該不會……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們和妾身同樣",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也想稱霸新年？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哼哼哼，",
    "voice": "vo_adv_5082001_006",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實就是那樣！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！",
    "voice": "vo_adv_5082001_007",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們竟敢",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "攔阻在妾身面前？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就算對手是【美食殿堂】",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也不會放水的！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不，",
    "voice": "vo_adv_5082001_008",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是的。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們正要",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去蒐集年菜的材料。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這就是「【美食殿堂】",
    "voice": "vo_adv_5082001_009",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "回憶的年菜作戰」！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼嘛，",
    "voice": "vo_adv_5082001_010",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是那樣就好……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "話說，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "年菜是什麼啊？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽說是有新年氣氛的",
    "voice": "vo_adv_5082001_011",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "祝賀料理。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯。",
    "voice": "vo_adv_5082001_012",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那原本是",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為了祈願長壽和繁榮而做的料理集合。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "貪吃佩可小姐說過",
    "voice": "vo_adv_5082001_013",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那是吉祥物",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對吧？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我記得",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "年菜原本也是東國的文化。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吉祥物",
    "voice": "vo_adv_5082001_014",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗎……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是指",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有特別力量的料理，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是這個意思嗎？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的。",
    "voice": "vo_adv_5082001_015",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那就是在新年大家一起吃的特別料理！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也就是說",
    "voice": "vo_adv_5082001_016",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吃了那個之後說不定就能取回失去的力量……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有趣！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們的旅行，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也要參加！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好耶！",
    "voice": "vo_adv_5082001_017",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這就是「出外靠旅伴，處世靠人情」！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_5082001_018",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳知道不錯的俗語嘛。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們打算去哪一帶旅行？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人打算",
    "voice": "vo_adv_5082001_019",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "去目前為止到過的地方。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為追求每塊土地不同的美味",
    "voice": "vo_adv_5082001_020",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "上山下海、踏遍原野……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們去過相當多地方了呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魚果然還是大間那邊的好！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大間",
    "voice": "vo_adv_5082001_021",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是那個以海產聞名的",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大間嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳知道嗎？",
    "voice": "vo_adv_5082001_022",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當然。",
    "voice": "vo_adv_5082001_023",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n大間就像是",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "海釣的聖地一樣。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們之前",
    "voice": "vo_adv_5082001_024",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "曾經在大間釣過金槍鮪喲！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦……",
    "voice": "vo_adv_5082001_025",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真讓人羨繤。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也想釣一次看看。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此",
    "voice": "vo_adv_5082001_026",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "流夏也一起來如何？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也一起去嗎？",
    "voice": "vo_adv_5082001_027",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有個不只是年菜，",
    "voice": "vo_adv_5082001_028",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "連東國文化都一清二楚的顧問在，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我會很開心的。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟也不太放心全部交給貪吃佩可。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……她一副動不動就會提議用魔物料理當年菜的樣子。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "確實，",
    "voice": "vo_adv_5082001_029",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "流夏小姐能來的話",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很令人安心呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魔物年菜明明也很好吃的說……",
    "voice": "vo_adv_5082001_030",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只要有發源地的知識",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就可以吃到好吃的年菜了♪",
