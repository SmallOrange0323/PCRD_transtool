  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n那位大人解題的速度",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "越來越快了……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "居然能在這麼近的地方看見弟弟的成長……",
    "voice": "vo_adv_5070308_001",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "世上沒有比這還要幸福的事情了……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真想一直專注凝視那位大人啊……",
    "voice": "vo_adv_5070308_002",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我非常能夠體會",
    "voice": "vo_adv_5070308_003",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳的心情。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們還有自己該做的事情，",
    "voice": "vo_adv_5070308_004",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "對吧？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "走吧，",
    "voice": "vo_adv_5070308_005",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "惠理子！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n在弟弟的戰鬥結束之前，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們的戰鬥是不會結束的！",
    "voice": null,
