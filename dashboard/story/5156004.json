[
  {
    "type": "background",
    "bg_id": "502390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "車輛終於完成，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了襲擊蘭德索爾",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當天的早上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "天就快亮了。",
    "voice": "vo_adv_5156004_000",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n動作快！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真討厭～",
    "voice": "vo_adv_5156004_001",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n雜碎哥哥真是的～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "也太雜碎了吧～♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雖然我早就知道了♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "值得關注的財寶能裝就盡量裝，",
    "voice": "vo_adv_5156004_002",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n結果變成這麼多的量……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "拿走這麼多，沒問題嗎？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "還問「沒問題嗎？」",
    "voice": "vo_adv_5156004_003",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "說什麼啊！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "妳也裝太多了！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n又不是市場特價",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "讓妳一袋蔬菜裝到滿……",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "的說！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊哇哇！",
    "voice": "vo_adv_5156004_004",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n別坐在袋子上呀～！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "別吵，",
    "voice": "vo_adv_5156004_005",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n會吵醒那些傢伙！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們要借的，",
    "voice": "vo_adv_5156004_006",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是那台車。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n快把財寶放上去！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機、若菜",
    "words": "……好～",
    "voice": "vo_adv_5156004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……可是",
    "voice": "vo_adv_5156004_008",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n格羅哥團的團員竟然",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "各自都有弱點。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯，",
    "voice": "vo_adv_5156004_009",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "準沒錯。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "宴會那天晚上，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我在瘋狂喬的房間看到的團員名單上",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n寫著所有人的弱點。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "說到頭來，這些住在吉歐‧格黑納，被稱為「妖魔人」的傢伙，",
    "voice": "vo_adv_5156004_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n以生物來說特長似乎很刁鑽……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "有點難懂的事先不提。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "可是，",
    "voice": "vo_adv_5156004_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "可以「利用」的事實是──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "瘋狂喬這傢伙雖然拳頭大頭腦也好，",
    "voice": "vo_adv_5156004_012",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但腳程卻極慢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那隻三流青蛙的眼睛",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "則非常怕光。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "其他團員們也是，",
    "voice": "vo_adv_5156004_013",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就算有腕力或體力，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n也是耳朵不好",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "或重度近視，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "總之有各式各樣的狀況。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "正因如此，",
    "voice": "vo_adv_5156004_014",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "他們才會一人分配一台車，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n希望能透過仔細客製化的戰鬥車",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n完善補強各自的弱點。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……這樣一說，喬先生",
    "voice": "vo_adv_5156004_015",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在提到新型車輛的話題時，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n首先就說想加快速度……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯，",
    "voice": "vo_adv_5156004_016",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對他來說，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n提升機動力是必備條件吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對那些傢伙而言，",
    "voice": "vo_adv_5156004_017",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "車子不僅是武器，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n更是隱瞞弱點的障眼法。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "意思是，",
    "voice": "vo_adv_5156004_018",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "只要針對弱點……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……不。",
    "voice": "vo_adv_5156004_019",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n畢竟有100人呢，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "一個一個應付的話，情況只會越來越糟。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "倒不如──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真正該下手的，",
    "voice": "vo_adv_5156004_020",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n他們的致命傷是",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "會「陶醉在借用來的力量上」這一點。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "他們沒有靠肉身戰鬥的能耐。",
    "voice": "vo_adv_5156004_021",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "偏偏又陶醉在",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "補強自己弱點的車輛性能之中。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "如果重要關頭車子不見，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "他們應該就沒辦法作戰了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "原、",
    "voice": "vo_adv_5156004_022",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "原來如此！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "就算不交戰，應該也可行……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "給我",
    "voice": "vo_adv_5156004_023",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "聽好了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "首先我們要跟他們一起",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "從這裡出發去襲擊蘭德索爾。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "然後一看到通往蘭德索爾的門，",
    "voice": "vo_adv_5156004_024",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就用布武機的裝置",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "讓他們的引擎熄火。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "同時一口氣加速唯一還能動的我們的車，",
    "voice": "vo_adv_5156004_025",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "載著財寶，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "直衝進門。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "然後，",
    "voice": "vo_adv_5156004_026",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "一口氣成功脫逃到蘭德索爾……！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "成功……",
    "voice": "vo_adv_5156004_027",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "脫逃……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是啊，",
    "voice": "vo_adv_5156004_028",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "成功脫逃！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這次一定──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "會是【蠻賊三姊妹】的勝利計畫。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳們",
    "voice": "vo_adv_5156004_029",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再怎樣也不准搞砸囉！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "喵哈好～♡",
    "voice": "vo_adv_5156004_030",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……好、",
    "voice": "vo_adv_5156004_031",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好的！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "…………",
    "voice": "vo_adv_5156004_032",
