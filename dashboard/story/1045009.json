  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某日午後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在散步的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n發現空花一臉愉悅地走在路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻～♪",
    "voice": "vo_adv_1045009_000",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n好興奮～♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是的～♪",
    "voice": "vo_adv_1045009_001",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花得到了一個令人熱血沸騰的情報……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦，",
    "voice": "vo_adv_1045009_002",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n你是什麼時候出現在空花身邊的！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！？",
    "voice": "vo_adv_1045009_003",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "莫非虐待狂先生",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一直都在空花的身邊！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "「我時時刻刻",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "都在注視著妳」",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n怎麼這樣……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花的一切",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "都被你看光光了是吧！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……",
    "voice": "vo_adv_1045009_004",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "只是碰巧經過？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "喔，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "有點遺憾……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呃，",
    "voice": "vo_adv_1045009_005",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你問空花",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "為什麼會一臉興奮地扭個不停嗎？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "因為",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "之前空花",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在酒館跳舞時……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n聽到了稀有飾品的傳聞。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "聽說那好像",
    "voice": "vo_adv_1045009_006",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是個充滿刺激性的東西。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "或許你會感到意外，",
    "voice": "vo_adv_1045009_007",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但空花，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "其實對那種飾品很有興趣。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗯？",
    "voice": "vo_adv_1045009_008",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你怎麼",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這麼肯定地點頭……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後呢，",
    "voice": "vo_adv_1045009_009",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花現在",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "正想去試著把那個稀有飾品",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "給拿到手。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "其實空花",
    "voice": "vo_adv_1045009_010",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "本來是想找公會的夥伴",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一起來幫忙的，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但大家都不在，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "只剩空花一個人……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過，",
    "voice": "vo_adv_1045009_011",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "熱血沸騰的空花，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n已經壓抑不住心中的渴望了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖然那好像是個有點危險的地下迷宮，",
    "voice": "vo_adv_1045009_012",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但空花",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "現在就要去挑戰了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦？",
    "voice": "vo_adv_1045009_013",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也要跟空花一起去……？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "難、",
    "voice": "vo_adv_1045009_014",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "難不成，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是想遠遠看著掉進陷阱裡",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "無法抵抗的空花，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n藉此獲得快感……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……",
    "voice": "vo_adv_1045009_015",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生願意同行，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花心裡會感覺更踏實。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n請你",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "務必要一起來……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_1045009_016",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一片青翠的茂盛草原……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n真是個冒險的好日子……♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "話說回來，",
    "voice": "vo_adv_1045009_017",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "只有虐待狂先生跟空花兩個人的冒險……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "感覺已經好久沒有這樣了呢……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花想起與虐待狂先生初次相遇的時候……♪",
    "voice": "vo_adv_1045009_018",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生藉口想要一起討伐魔物，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "把空花叫去四下無人的地方，\\n對空花那樣那樣、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣這樣……♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "噫──！？",
    "voice": "vo_adv_1045009_019",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你都聽到了嗎！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這要空花怎麼說得出口嘛……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生那些人格異常的變態行為，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花實在羞於啟齒～！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過，",
    "voice": "vo_adv_1045009_020",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不曉得怎麼搞的，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n光是虐待狂先生陪在身邊，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就覺得很放心……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！？",
    "voice": "vo_adv_1045009_021",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "難不成，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這是虐待狂先生為了將空花的身心都馴服",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "而設下的陷阱……！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "太可怕了……",
    "voice": "vo_adv_1045009_022",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這場冒險",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花能否撐到最後呢……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "background",
    "bg_id": "500253"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這裡就是",
    "voice": "vo_adv_1045009_023",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "傳聞中的",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "地下迷宮……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "既昏暗",
    "voice": "vo_adv_1045009_024",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "又閃爍著詭異的迷濛亮光……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在這種地方",
    "voice": "vo_adv_1045009_025",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "跟虐待狂先生兩個人獨處……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "搞不好",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會發生什麼不得了的事情喔……！？",
