  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "結果我來這個村子還是一直在冒失搞砸……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n明明我自己",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也有多留意了。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像這樣一直讓人幫忙，",
    "voice": "vo_adv_6144104_001",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n感覺好難為情……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚嗚……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": "vo_adv_6144104_002",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謝謝你～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的心情",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有稍微輕鬆一點了……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是，",
    "voice": "vo_adv_6144104_003",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然還是不該一直單方面依賴別人。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為了減少冒失，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會多加努力的！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿嘿……",
    "voice": "vo_adv_6144104_004",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說的也是呢，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不能一直哭哭啼啼的，",
