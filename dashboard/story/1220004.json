[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在解決幽靈船秘寶騷動的幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n忍和{0}來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天非常安靜呢。",
    "voice": "vo_adv_1220004_000",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n讓人覺得前陣子的騷動",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就像是謊言一樣。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為這陣子都在忙，",
    "voice": "vo_adv_1220004_001",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以今天我想好好休息，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "放鬆一下。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "話說回來，",
    "voice": "vo_adv_1220004_002",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "天氣真好呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n陽光還有些刺眼。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還有……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我覺得好睏……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}，",
    "voice": "vo_adv_1220004_003",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n竟然在這裡碰面，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是巧呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你是要去哪裡嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………？",
    "voice": "vo_adv_1220004_004",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1220004_005",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你是在意這把鏟子嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我接了某個尋物委託，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "正準備出去呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你一臉感到不可思議的表情呢。",
    "voice": "vo_adv_1220004_006",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你有興趣嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想想……",
    "voice": "vo_adv_1220004_007",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "兩個人感覺會比較有效率呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你有空願意幫忙的話，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會很感激的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_1220004_008",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你好像很高興呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那我們就出發吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我今天是要",
    "voice": "vo_adv_1220004_009",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來這裡找東西。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這並不是工作……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我",
    "voice": "vo_adv_1220004_010",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "利用占卜兼職的空檔，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n聽幽靈他們的請求，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n從旁協助他們，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓他們能順利成佛。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "至於這次的委託……",
    "voice": "vo_adv_1220004_011",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對方拜託我",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來這裡確認",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "古代埋藏的寶藏……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是否真的存在。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對，",
    "voice": "vo_adv_1220004_012",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "埋藏的寶藏。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n就是常常被電視節目",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "視為傳說的",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那種。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "根據那個幽靈表示，",
    "voice": "vo_adv_1220004_013",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他生前似乎透過某種管道，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n取得了疑似",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "埋有傳說寶藏的地圖和鑰匙。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "從那之後，",
    "voice": "vo_adv_1220004_014",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n他腦中無時無刻",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "都在想著傳說是否屬實……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "以至於在他過世之後，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不小心成了幽靈。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，",
    "voice": "vo_adv_1220004_015",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我才會代替無法親自尋找的幽靈",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "前來調查。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我就",
    "voice": "vo_adv_1220004_016",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "把這些交給你了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "調",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "查所需的地圖，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還有……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來這裡的路上，",
    "voice": "vo_adv_1220004_017",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我買了給你用的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我們",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就從重點區域開始找起吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我在事前根據委託幽靈的情報，",
    "voice": "vo_adv_1220004_018",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n透過占卜篩選出可疑的地段了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "首先",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就從那裡開始吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我的探測術顯示",
    "voice": "vo_adv_1220004_019",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要再稍微往右……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是那邊。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請挖看看那裡，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也來幫忙。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1220004_020",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沙子裡",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有東西出現了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是……",
    "voice": "vo_adv_1220004_021",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "別人遺失的錢包嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n等一下拿去派出所吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接著是……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來是在那邊呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這次是戒指呢。",
    "voice": "vo_adv_1220004_022",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個等一下",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也跟錢包一起拿過去。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嘿咻……",
    "voice": "vo_adv_1220004_023",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好了，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n把我們挖的洞",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "填回去吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要是絆倒別人會很危險的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": "vo_adv_1220004_024",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好熱……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這工作比我想的",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還要辛苦呢……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": "vo_adv_1220004_025",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不，",
    "voice": "vo_adv_1220004_026",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們連一半都還沒找完，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以要再趕一下進度……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀！",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……對不起，",
    "voice": "vo_adv_1220004_027",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我好像絆到腳了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是你救了我呢。",
    "voice": "vo_adv_1220004_028",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以說，",
    "voice": "vo_adv_1220004_029",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我已經不要緊了，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n一直被這樣抱著……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓人有些",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "難為情……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1220004_030",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請你別一直道歉，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "畢竟這本來",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是我的一個不小心才造成的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……對不起，",
    "voice": "vo_adv_1220004_031",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n看來我似乎",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太勉強自己了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就到那邊的陰涼處",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "休息一下吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我買冰涼的飲料過來了。",
    "voice": "vo_adv_1220004_032",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你也請喝吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1220004_033",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然我父親的頭抖得很厲害，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不過你不必在意。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他從剛才",
    "voice": "vo_adv_1220004_034",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你救了我的時候開始，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n就一直用各式各樣的話語",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "唸出帶著恨意的話，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但是那不會讓人遭逢詛咒之類的危害。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我問你……",
    "voice": "vo_adv_1220004_035",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}也有",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "即使變成幽靈……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也想實現的夢想嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": "vo_adv_1220004_036",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我只是想聽聽看而已。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為聽了幽靈他們的請求後，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n讓我偶爾會這麼想。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "即使變成幽靈也想實現的夢……",
    "voice": "vo_adv_1220004_037",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有那樣的夢想",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "到底會是怎樣的",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "心情呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算死了",
    "voice": "vo_adv_1220004_038",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "仍流連在人世……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n有著那樣全心投入的夢想",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真好呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有著即使死了也想實現的夢想和憧憬，",
    "voice": "vo_adv_1220004_039",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n讓人感到有些……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "羨慕。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對不起，",
    "voice": "vo_adv_1220004_040",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我長篇大論了起來。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "繼續回去挖地吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "background",
    "bg_id": "510251"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……？",
    "voice": "vo_adv_1220004_041",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我好像敲到了什麼。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺體積很大呢……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "把它挖出來吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好大的一個木箱……",
    "voice": "vo_adv_1220004_042",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "上頭用了鐵製零件裝飾，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺非常牢固。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n似乎還上了鎖呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請等一下，",
    "voice": "vo_adv_1220004_043",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我記得",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他有交給我鑰匙……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果委託人說的沒錯，",
    "voice": "vo_adv_1220004_044",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該可以用這把鑰匙打開……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……",
    "voice": "vo_adv_1220004_045",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "打開了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "裡面放的是……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "骨董嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "破掉的陶器，",
    "voice": "vo_adv_1220004_046",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還有泡水變得皺巴巴的書籍……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "全都受損得很嚴重呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "假如裡面的物品沒有受損，",
    "voice": "vo_adv_1220004_047",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n或許是有一定的價值……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但說真的，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我覺得並不是特別值得期待的高價物品。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也就是說，",
    "voice": "vo_adv_1220004_048",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "委託者所說埋藏的寶藏……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n看來果然是不存在呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，",
    "voice": "vo_adv_1220004_049",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或許這樣就好了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "委託幽靈所留戀的是，",
    "voice": "vo_adv_1220004_050",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n傳說中埋藏的寶藏是否存在，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他想確認這個真相。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因此……",
    "voice": "vo_adv_1220004_051",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算沒有埋藏他期盼的寶藏，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該也能化解",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一直將他困在人世的留戀之心。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣就算是",
    "voice": "vo_adv_1220004_052",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "完成委託了呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}，你也辛苦了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "現在只剩回去……",
    "voice": "vo_adv_1220004_053",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就大功告成了，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過都跑來了，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要不要",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在回去之前欣賞一下大海呢？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "background",
    "bg_id": "510251"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……好美呢。",
    "voice": "vo_adv_1220004_054",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如烈焰燃燒的夕陽沉入地平線下，",
    "voice": "vo_adv_1220004_055",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n天空漸漸變黑……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n即使如此，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太陽仍綻放著耀眼的光芒直到最後一刻。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "假設夢想",
    "voice": "vo_adv_1220004_056",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就像那顆太陽……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n感覺光是懷有夢想，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就能從胸口深處",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "湧現力量。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "still",
    "still_id": "122000401"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……剛才，",
    "voice": "vo_adv_1220004_057",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會說很羨慕幽靈他們，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n是因為我想像不到",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "自己有像他們一樣的",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "夢想和憧憬。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "做占卜的兼職，",
    "voice": "vo_adv_1220004_058",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也讓我替許多人",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "占卜過他們的夢想，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n實際上",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也有人真的實現了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然而，",
    "voice": "vo_adv_1220004_059",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "換成了自己卻看不清自己的夢想，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這真是奇怪呢……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但是，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "應該就是因為這樣吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看到幽靈他們，",
    "voice": "vo_adv_1220004_060",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n懷有寧願不成佛也不放棄的熱情和願望……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n有時讓我覺得",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非常耀眼。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我……",
    "voice": "vo_adv_1220004_061",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或許是透過幫助大家，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n好讓自己分心不去想吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或許我沒有……",
    "voice": "vo_adv_1220004_062",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那麼耀眼又溫暖，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "會打從心底湧現的力量吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n……一想到這裡，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就讓我好害怕。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也有……？",
    "voice": "vo_adv_1220004_063",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那是指……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n……你說實現幽靈他們的願望，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這件事嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "的確，",
    "voice": "vo_adv_1220004_064",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "實現幽靈他們的請求，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n並不是",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "工作的一環……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想幫助別人……",
    "voice": "vo_adv_1220004_065",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這也可以作為夢想嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊…………",
    "voice": "vo_adv_1220004_066",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒事，",
    "voice": "vo_adv_1220004_067",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我只是覺得……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "原來",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也有所謂的夢想",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n一放下心來……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就讓我胸口深處",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "湧現一股暖意。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "still",
    "still_id": "122000402"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這……",
    "voice": "vo_adv_1220004_068",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這股暖意……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……謝謝你。",
    "voice": "vo_adv_1220004_069",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n總覺得稍微拓展了",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我一直沒看清的那條路。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我還不清楚",
    "voice": "vo_adv_1220004_070",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個答案是否正確，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但是，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「相信這個答案」這點……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想我一定可以做到的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "122000401"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說得也是……",
    "voice": "vo_adv_1220004_071",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n還得把撿到的東西",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "拿去派出所呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "………………",
    "voice": "vo_adv_1220004_072",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1220004_073",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想還是……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n能不能再稍微待一下呢？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}不介意的話……",
    "voice": "vo_adv_1220004_074",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想再眺望",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這片大海",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一下子。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "122000402"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想把今天",
    "voice": "vo_adv_1220004_075",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你告訴我的事情……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n還有胸口深處的暖意，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "跟這片景色",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一起記下來。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1220004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你還滿享受",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "跟忍一起尋寶呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n完全不管沙灘上周遭人的視線順利完成任務。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "周遭的遊客也從途中開始覺得",
    "voice": "vo_adv_1220004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們在沙灘上到處亂挖很理所當然，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而照常做起自己的事了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過",
    "voice": "vo_adv_1220004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在豔陽四射的沙灘上穿全黑的衣服……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "忍她是相當會忍耐的人嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然她是會為了別人",
    "voice": "vo_adv_1220004_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而努力的貼心孩子……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但因為她太貼心了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n或許才反而看不清自身的事吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她不太會把心情寫在臉上，",
    "voice": "vo_adv_1220004_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以你可要好好盯著她，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "別讓她過於勉強自己哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然一路看著你，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是不太擔心這點啦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就這樣囉，",
    "voice": "vo_adv_1220004_081",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501032"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1220004_082",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請你快起來。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n會感冒的哦。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1220004_083",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你醒了呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "早安。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你似乎看著海",
    "voice": "vo_adv_1220004_084",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看到睡著了呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……你還很睏嗎？",
    "voice": "vo_adv_1220004_085",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想睡的話，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我的大腿借你躺吧？",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這次你幫了我大忙，",
    "voice": "vo_adv_1220004_086",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n雖然不知道這樣",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "能否稱得上是答謝……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請吧。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……看來真的是很累了呢。",
    "voice": "vo_adv_1220004_087",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n一下子就睡著了。",
    "voice": null,
    "unit_id": 122012
  },
