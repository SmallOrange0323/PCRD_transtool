    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n阿賀斗紫布菜のシャドウもいるでしょう。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "あ。",
    "voice": "vo_adv_5206322_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
