    "words": "シェフィも。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n【アルターメイデン】。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "かにゅう。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ね？",
    "voice": null,
