    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不過克蘿依學姐她只要帶著嚴肅地表情站在暗處就會――",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不、",
    "voice": "vo_adv_5023005_074",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是的……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 110711
  },
