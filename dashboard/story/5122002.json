[
  {
    "type": "background",
    "bg_id": "502010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "得知異變的原因後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人移動到大間的海岸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而對於秋乃所宣告的「把海水全部抽乾」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大家仍舊一臉困惑──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃……",
    "voice": "vo_adv_5122002_000",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳說要把海水全部抽乾？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是要抽乾、",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這片大海的、",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "水？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哦～呵呵呵！",
    "voice": "vo_adv_5122002_001",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n除此之外還有哪片海嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不、",
    "voice": "vo_adv_5122002_002",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不不不不不，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "等等等等！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n妳以為",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "大海究竟是什麼啊？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這已經超過不知世事，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "完全是異想天開了。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "對吧，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "漁協協會長閣下。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "謝謝……",
    "voice": "vo_adv_5122002_003",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "太謝謝了……！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "咦？",
    "voice": "vo_adv_5122002_004",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "如果能幫幫我們，",
    "voice": "vo_adv_5122002_005",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "那我真的是太感激了。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "就趁這個機會",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "徹底結束祕密廢棄服務……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "所以……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "拜託了，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "請淨化這片大海吧……！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好的。",
    "voice": "vo_adv_5122002_006",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "交給我們吧！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不，",
    "voice": "vo_adv_5122002_007",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "請等一下──",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……請問一下。",
    "voice": "vo_adv_5122002_008",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "萬一",
    "voice": "vo_adv_5122002_009",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真的成功抽乾所有海水……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳是打算將沉在海底的大量祕密魔物",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n一個一個",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "擊退嗎？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒錯，",
    "voice": "vo_adv_5122002_010",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我是這麼打算的。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只要大家同心協力，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就不可能會做不到。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而且公主騎士大人",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也在啊♪",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5122002_011",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "漁協協會長。",
    "voice": "vo_adv_5122002_012",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n從海底浮上來的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那些小氣泡是什麼呢？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我從剛剛開始，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就覺得能聽見某種細微的聲音。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不是海浪聲，",
    "voice": "vo_adv_5122002_013",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也不是少數觀光客對話的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "某種聲音。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "啊啊，",
    "voice": "vo_adv_5122002_014",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "那是祕密魔物的",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "「輕聲低語」。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "似乎",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "是各個魔物在呢喃著自己的「祕密」。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦……",
    "voice": "vo_adv_5122002_015",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在呢喃祕密！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_5122002_016",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在進行回收的當下，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就會讓祕密曝光",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "啊啊，",
    "voice": "vo_adv_5122002_017",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "不過怎麼說，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "那恐怕是非常小聲的碎唸。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "如果不伸長耳朵貼著它、",
    "voice": "vo_adv_5122002_018",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "拚命地仔細聆聽，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n應該是無法聽到各個魔物所說的祕密吧。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "那個音量就是這麼地小。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那、",
    "voice": "vo_adv_5122002_019",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那麼應該是沒問題吧。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──啊，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就算不小心聽見了，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n也不會知道",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "究竟是誰的祕密",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "啊啊，",
    "voice": "vo_adv_5122002_020",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "關於這點，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n祕密魔物的身體上，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "也是會浮現出",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "非常淺，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "淺到如果不把眼睛瞇到極限是看不見的，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "寫有物主的",
    "voice": "vo_adv_5122002_021",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "名字、",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "地址、",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "以及聯絡方法，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n的文字。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "聽說。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "聽海上的傳聞是這麼說的。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這、",
    "voice": "vo_adv_5122002_022",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣不行吧！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這樣會讓祕密的內容跟主人曝光啊！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "…………確實、",
    "voice": "vo_adv_5122002_023",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "是呢……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……我覺得這樣風險太高了。",
    "voice": "vo_adv_5122002_024",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "風險？",
    "voice": "vo_adv_5122002_025",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "祕密",
    "voice": "vo_adv_5122002_026",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是人人都想隱藏、廢棄的東西。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不該把那種東西，",
    "voice": null,
