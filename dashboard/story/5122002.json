  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5122002_061",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "────！！！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "嗚喔！？",
    "voice": "vo_adv_5122002_062",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "怎、",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "水管突然開始暴衝──",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "────！\\n────！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "這、",
    "voice": "vo_adv_5122002_063",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "這難道是……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n水管堵住了嗎！？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你說什麼……！？",
    "voice": "vo_adv_5122002_064",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "漁夫們",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_5122002_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "快看！",
    "voice": "vo_adv_5122002_066",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "吸水側的水管正在大暴衝啊！？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "這簡直……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "就像是其名字一樣的",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "巨大章魚──",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "大大大大小姐，",
    "voice": "vo_adv_5122002_067",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不好了！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "啊，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "我",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "是隸屬紫藤工程股份有限公司，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n擔任本次排水企畫現場負責人的",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "山田。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "山田，",
    "voice": "vo_adv_5122002_068",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "立刻報告！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n到底發生什麼事了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "危險章魚",
    "voice": "vo_adv_5122002_069",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "出乎意料地過於危險，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "導致無法控制吸水側的水管……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "自稱「危險」，",
    "voice": "vo_adv_5122002_070",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "卻又說出乎意料過於危險……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "漁夫們",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_5122002_071",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不論是海裡、海面還是海灘上，",
    "voice": "vo_adv_5122002_072",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n它把各式各樣的東西都吸進去後，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "現在已經失控了！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "水管也因此",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "被異物給塞住了……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "吸水濾網呢？",
    "voice": "vo_adv_5122002_073",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n難道沒有裝嗎！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "是的……",
    "voice": "vo_adv_5122002_074",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "雖然很難以啟齒，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不過危險章魚",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n雖然名字裡有「危險」，但它原本是用於蓄水池的規格。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "由於非常非常突然地，",
    "voice": "vo_adv_5122002_075",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n收到了「現在立刻升級成海洋用規格」",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "這個緊急最優先指令……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "為了讓吸水效率達到最高極限，",
    "voice": "vo_adv_5122002_076",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "於是做出了「不裝設濾網」這個現場判斷。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "遵從上頭突如其來下達的指令，",
    "voice": "vo_adv_5122002_077",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n結果就是造成「偏離企畫原本的意圖」",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n這種大企業常見的犯蠢現象呢，是的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你說……",
    "voice": "vo_adv_5122002_078",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "什麼……？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "雖然這種話不是我該說的，",
    "voice": "vo_adv_5122002_079",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n但是海洋用規格的排水機器什麼的，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不管怎麼想都太超乎常理了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "這種狀況下要是不裝設濾網，",
    "voice": "vo_adv_5122002_080",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n正如您所見，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "這已經稱得上",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "是兵器了呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "這道理就連章魚都懂呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "…………原來如此。",
    "voice": "vo_adv_5122002_081",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "為了不讓您成為專橫獨斷的大小姐，",
    "voice": "vo_adv_5122002_082",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n向您說出現場真相的忠誠部下正是我，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "山田，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "是山田我。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "在下次的人事調動，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "請務必讓我跳等升職。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "山田，",
    "voice": "vo_adv_5122002_083",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好的，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我記下來了。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "完全不負責任，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "只報告現狀的職員，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "山田。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "看來你無論是",
    "voice": "vo_adv_5122002_084",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在商家工作的自覺和技能都有所不足呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就讓你去參加我跟爸爸舉辦的",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「熱血商人集訓」吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我會把你加入名單當中。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "……噫！？",
    "voice": "vo_adv_5122002_085",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n熱血商人集訓……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "是在職員當中被稱為地獄的那個……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "不是的……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "我接下來",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "才要負起責任──",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼你",
    "voice": "vo_adv_5122002_086",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "現在就立刻……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "把濾網裝上去！！",
    "voice": "vo_adv_5122002_087",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "遵、",
    "voice": "vo_adv_5122002_088",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "遵命──！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "我現在、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "馬上、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場負責人山田",
    "words": "立刻就去！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……真是受不了。",
    "voice": "vo_adv_5122002_089",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "看來",
    "voice": "vo_adv_5122002_090",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "水管阻塞",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n得由我們",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "來想辦法處理才行呢。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "不過看這暴衝的程度……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "會很棘手喔。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "……哈、",
    "voice": "vo_adv_5122002_091",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "哈哈。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "似似花大人，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "事情進行得不太順利呢。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不，",
    "voice": "vo_adv_5122002_092",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這也是當然的吧。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這種事情，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我打從一開始就覺得是辦不到的。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n看來不用擔心似似花大人的祕密曝光──",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不。",
    "voice": "vo_adv_5122002_093",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "……？",
    "voice": "vo_adv_5122002_094",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "憑藉秋乃的力量，",
    "voice": "vo_adv_5122002_095",
