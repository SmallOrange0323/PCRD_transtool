    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可惡！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一直讓我疲於奔命啊……！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "這樣一個勁地來回跑是沒有用的。",
    "voice": "vo_adv_1283003_053",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n只要無法揭開那個絕技的祕密，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "妳就不會有勝算。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！？",
    "voice": "vo_adv_1283003_054",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那個眼神……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來你就快要識破老太婆的祕密了吧……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我會試著撐到那個時候的！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "沒用的！",
    "voice": "vo_adv_1283003_055",
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n怎麼可能會讓你發現我們的祕密！",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "就這樣迷失在這場幻境之中",
    "voice": "vo_adv_1283003_056",
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "吧～？",
    "voice": null,
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "因為我們可是無敵的呢。",
    "voice": "vo_adv_1283003_057",
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "就是說啊。",
    "voice": "vo_adv_1283003_058",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "如果不是這樣，我們也分不出來……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "啊，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "糟糕……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "沒那回事，",
    "voice": "vo_adv_1283003_059",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "長得一樣呀。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "畢竟要不是因為說話的方式不一樣，我們也分不出來嘛。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "噓！",
    "voice": "vo_adv_1283003_060",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "不行啦！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "不經意的一句話都會變成提示的！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！？",
    "voice": "vo_adv_1283003_061",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你知道了嗎！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快點想點辦法來對付這個分身術吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "哦……？",
    "voice": "vo_adv_1283003_062",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n不是分身術的話那是什麼？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_1283003_063",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼啊啊啊啊？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在說什麼蠢話啊！",
    "voice": "vo_adv_1283003_064",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我真是太傻了，竟然把希望放在你身上！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說什麼三胞胎，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種愚蠢到家的把戲……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "哎呀～",
    "voice": "vo_adv_1283003_065",
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "你發現了呢～",
    "voice": null,
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": "vo_adv_1283003_066",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "不過我們跟祈梨認識了這麼久，",
    "voice": "vo_adv_1283003_067",
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n其實更希望由她自己來發現呢。",
    "voice": null,
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是",
    "voice": "vo_adv_1283003_068",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "騙人的吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳們真的是三胞胎嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦咦？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是從什麼時候開始的……？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "打從一開始就是了喔。",
    "voice": "vo_adv_1283003_069",
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n星期一、三是我，二、四是姊姊，",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "五六日則是妹妹。",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "不過，",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "新年期間因為很忙，所以是大家一起顧店呢。",
    "voice": null,
    "unit_id": 1515
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "不會吧～",
    "voice": "vo_adv_1283003_070",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "妳真的都沒有發現嗎？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "我覺得正常來說都會發現吧……",
    "voice": "vo_adv_1283003_071",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為、",
    "voice": "vo_adv_1283003_072",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼啊？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n從來都沒有人跟我說過啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "因為那在這一帶是人人都知道的常識啊。",
    "voice": "vo_adv_1283003_073",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "所以沒有人會特地提起吧。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎、",
    "voice": "vo_adv_1283003_074",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我覺得這件事給我的打擊更大呀！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "哎呀～",
    "voice": "vo_adv_1283003_075",
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "對不起喔～",
    "voice": null,
    "unit_id": 1516
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但話說回來，",
    "voice": "vo_adv_1283003_076",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣不就是單純的三對一而已嗎！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n耍詐也要有個限度吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "妳不是說過「管你是三個人還是多少人，",
    "voice": "vo_adv_1283003_077",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "\\n儘管放馬過來！」嗎？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "的確有說過呢。",
    "voice": "vo_adv_1283003_078",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "有說過有說過。",
    "voice": "vo_adv_1283003_079",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那是指比陀螺啊！",
    "voice": "vo_adv_1283003_080",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n板羽球的遊戲性質跟那個不一樣！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "呵呵呵……",
    "voice": "vo_adv_1283003_081",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "真虧你能識破！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "不過，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "光是這樣也改變不了這個困境喔。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n妳打算怎麼辦呀？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼……",
    "voice": "vo_adv_1283003_082",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這還用問嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然不是分身術的話，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我也就不用客氣了。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就跟比陀螺的時候一樣！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "答得好！",
    "voice": "vo_adv_1283003_083",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來吧，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓大家見識見識",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你跟我經過特訓，力量提升後的實力！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也是會觀察氣氛的好嗎！",
    "voice": "vo_adv_1283003_084",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n總之你快點過來啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n再這樣下去就危險了！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "原來如此，",
    "voice": "vo_adv_1283003_085",
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "要搬救兵是嗎？",
    "voice": null,
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
