    "name": "禊",
    "words": "這座森林",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "平常明明很寧靜呀。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "那是……",
    "voice": "vo_adv_1004012_075",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我們的錯。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "是、",
    "voice": "vo_adv_1004012_076",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "是啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n我們找魔石時驚動了魔物巢穴，結果給你們添了大麻煩……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "而且我們竟然拋下了像妳這麼小的孩子逃跑。",
    "voice": "vo_adv_1004012_077",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "因為實在太羞愧，所以我們又折返回來了，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "你們沒事真是太好了。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "造成你們的困擾，",
    "voice": "vo_adv_1004012_078",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "真的很抱歉……！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦，",
    "voice": "vo_adv_1004012_079",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呃～～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這種時候禊該怎麼辦才好呢？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊一直都是被教訓的那一方，",
    "voice": "vo_adv_1004012_080",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "所以根本不知道怎麼教訓人呀～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n因為大家都平安無事，禊認為這件事到此為止就好了哦～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "小妹妹……",
    "voice": "vo_adv_1004012_081",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004012_082",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過如果你們又做了一樣的事，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n到時",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊可會對你們惡作劇哦！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "啊、",
    "voice": "vo_adv_1004012_083",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "只是惡作劇的話，不管幾次都……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呃……",
    "voice": "vo_adv_1004012_084",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那些魔物",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "全部都是這孩子打倒的哦？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性１・男性２",
    "words": "……咦？",
    "voice": "vo_adv_1004012_085",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1004012_086",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "很厲害吧！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性１・男性２",
    "words": "我們不會再犯了！",
    "voice": "vo_adv_1004012_087",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇、",
    "voice": "vo_adv_1004012_088",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為什麼要這麼害怕啊？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦～？",
    "voice": "vo_adv_1004012_089",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊才沒有教訓他們呢～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "既然能讓他們反省的話，那就算了吧～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004012_090",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不論什麼時候都要陪禊一起惡作劇哦！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "從今以後也要一～直陪禊玩哦！",
    "voice": "vo_adv_1004012_091",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "禊如此說道，並對著\\n{0}露出了天真無邪的笑容。",
