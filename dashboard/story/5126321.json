[
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇哇哇！",
    "voice": "vo_adv_5126321_000",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是什麼魔法！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n難道阿爾杰什寶",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n其實是那種超不妙的魔物！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有火、雷，",
    "voice": "vo_adv_5126321_001",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有冰跟風……！？",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是什麼亂七八糟的魔力啊！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n難怪能在傳說當中留名呢……！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈，",
    "voice": "vo_adv_5126321_002",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "小心那傢伙放出的魔法球！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要是被打中可就不妙了！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，",
    "voice": "vo_adv_5126321_003",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "知道了凱留寶！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "總之",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就算沒想好怎麼辦，還是先衝上去──！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不，妳根本就沒有聽懂嘛！！",
    "voice": "vo_adv_5126321_004",
    "unit_id": 127211
  }
]
