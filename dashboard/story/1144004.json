    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n幫請假的員工代班……？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……我能理解{0}大人的溫柔",
