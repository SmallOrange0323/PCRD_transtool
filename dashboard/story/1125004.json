[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與【new generations】一起停留在村子裡的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n早上醒來，正在散步的時候——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦？",
    "voice": "vo_adv_1125004_000",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "你已經起來啦。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "早安。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n一大早難道有什麼事情嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……這樣啊，",
    "voice": "vo_adv_1125004_001",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "只是比較早醒來而已。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我是打算",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "在練習前先去跑步暖個身。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "晨光照起來很舒服，感覺正好……",
    "voice": "vo_adv_1125004_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不覺得太耀眼了嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……不對，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這不是太陽光，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "為什麼你在發光啊！？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n你那是什麼體質！？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "呀啊啊！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天的假日",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}為了買東西而前往商店街時——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算你這麼說，我也很傷腦筋啊……",
    "voice": "vo_adv_1125004_003",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "務必請妳幫個忙！　",
    "voice": "vo_adv_1125004_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "至少收下名片也好！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不是，",
    "voice": "vo_adv_1125004_005",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "現在和名片沒有關係吧。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我是也很想幫你啦，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "唔～嗯……",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦？　",
    "voice": "vo_adv_1125004_006",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……啊啊，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "你也來買東西啊。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "你來得正好。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "可以幫我",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "說服這個人嗎？",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "所以，",
    "voice": "vo_adv_1125004_007",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "我從剛才不就一直在說了嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n為了讓這次的活動成功，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "絕對需要妳的力量啊～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……",
    "voice": "vo_adv_1125004_008",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好像是",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "商店街今天要辦活動的樣子。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "只是，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好像原本預定要參加那個活動的偶像",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "沒辦法來了。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "聽說那孩子",
    "voice": "vo_adv_1125004_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "突然發高燒倒下了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n因為突然生病導致工作開天窗這無可奈何，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "但問題是沒人可以替代啊！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "一般來說，",
    "voice": "vo_adv_1125004_010",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "事務所要是有人休息時，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我想都會從同事務所",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "派替代的人過來才對……",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "沒有嗎？",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "關於這個，",
    "voice": "vo_adv_1125004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "聽說年齡相近的人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "全都已經有安排工作了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n我們是有稍微放寬條件",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "請他們介紹其他候補的人……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "但根本不符合「料理偶像☆小樁」",
    "voice": "vo_adv_1125004_012",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "的形象啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n能夠立刻應對的人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "可是職業摔角類型的偶像耶！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算是這樣，跑來找我也太莫名其妙了吧……",
    "voice": "vo_adv_1125004_013",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "才沒這回事！",
    "voice": "vo_adv_1125004_014",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "我在看到妳的瞬間腦中就",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "「叮！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "地感受到了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n應該說是有偶像的氣場嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "總之我感受到了妳潛藏的才能！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "所以拜託妳了！　",
    "voice": "vo_adv_1125004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "請妳參加活動吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n這可是讓樁丘商店街原創角色紅起來的機會啊～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯——",
    "voice": "vo_adv_1125004_016",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "要我幫忙是可以，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但有些部分讓我在意呢。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……對了，",
    "voice": "vo_adv_1125004_017",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "可以請你配合我的說法嗎？",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我會把你",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "說成是我的「經紀人」來跟他談，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就麻煩你囉。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "大叔，",
    "voice": "vo_adv_1125004_018",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "要我代替演出主持活動是可以，但我有個條件。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "已經有所屬的事務所，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "而且已經出道了。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "咦！？　",
    "voice": "vo_adv_1125004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "意思是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "妳其實是真正的偶像嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n真、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "真是失禮了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "沒關係，",
    "voice": "vo_adv_1125004_020",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我才剛開始活動而已，請別在意。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n這個人是我的經紀人。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我今天",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "休假。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "然後，",
    "voice": "vo_adv_1125004_021",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "因為我已經有所屬的事務所了，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n所以要是留下",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "照片或影像等等的紀錄，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "會變得很麻煩。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "而且我也會被事務所罵……",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "所以，",
    "voice": "vo_adv_1125004_022",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果能完全禁止拍攝之類的行為，我就可以幫你。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我的經紀人",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "也說那樣的話就OK喔。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "若是只需要那些條件的話，",
    "voice": "vo_adv_1125004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "完全沒問題！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n再兩個小時後就要正式演出了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "我帶你們去準備室！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "來和小樁",
    "voice": "vo_adv_1125004_024",
    "unit_id": 112531
  },
  {
