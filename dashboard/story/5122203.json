[
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "島鯨沉下去了！",
    "voice": "vo_adv_5122203_000",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我們打倒牠了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "太好了──！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請等一下。",
    "voice": "vo_adv_5122203_001",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那傢伙的策略，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就是會假裝沉下去，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "再從某個地方浮上來……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "上一次珠希他們",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是完全著了牠的道。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "……………………嗯！",
    "voice": "vo_adv_5122203_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊！",
    "voice": "vo_adv_5122203_003",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "出現了！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在那邊！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n為了不讓人發現悄悄地浮上來了！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "牠打算發動奇襲呢。",
    "voice": "vo_adv_5122203_004",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "明明身軀龐大，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "耍的卻是些小手段……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那我們走吧！",
    "voice": "vo_adv_5122203_005",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就跟牠戰鬥到底！",
    "voice": null,
    "unit_id": 126711
  }
]
