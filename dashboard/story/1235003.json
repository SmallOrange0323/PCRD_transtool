    "type": "dialogue",
    "name": "鈴",
    "words": "但現在完全情況不同啊～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我現在是希望你待在我身邊！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "理解一下我這個心情啦～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "殭屍",
    "words": "嗚啊啊啊啊啊啊啊啊啊啊啊啊～！！",
