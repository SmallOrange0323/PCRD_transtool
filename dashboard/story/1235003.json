    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "各式各樣無法言喻的景象都出現了！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這對我來說刺激太強了啦～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n何止一個月，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我簡直要做三個月的惡夢了啦！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哪有什麼厲不厲害的，",
    "voice": "vo_adv_1235003_034",
