  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "做這個遊戲的人",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "努力過頭了啦！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所有東西都太逼真了吧～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不管是畫面還是聲音還是悲鳴，",
