    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要從哪裡開始呢？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n似乎可以在這棟洋房裡自由探索的樣子，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n照這個順序前進就可以了吧？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那就隨意地，",
    "voice": "vo_adv_1235003_025",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "從這扇門開始吧……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "still",
    "still_id": "123500301"
  },
  {
    "type": "dialogue",
    "name": "殭屍",
    "words": "哇啊啊啊啊啊啊啊啊啊啊啊啊～！！",
