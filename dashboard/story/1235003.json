  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "揮拳～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼回事，",
    "voice": "vo_adv_1235003_028",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼沒辦法攻擊啊～！？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "蛤？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這是沒有裝備武器就不能攻擊的那種系統？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這有寫在說明書上嗎？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要先說啊～！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "武器，",
    "voice": "vo_adv_1235003_029",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "武器……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒有！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼武器都沒有！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所以說一開始開這扇門就是錯的嗎！？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣的也太不講理了～！！",
