    "type": "dialogue",
    "name": "鈴",
    "words": "但看到製作名單",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "會感到這麼安心的遊戲，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這還是第一個……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……你說",
    "voice": "vo_adv_1235003_042",
    "unit_id": 123511
  },
