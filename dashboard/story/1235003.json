    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要是一直玩這種遊戲的話……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我會變得沒辦法一個人睡覺的啦～",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "dialogue",
    "name": "遊戲畫面",
    "words": "「就這樣，",
    "voice": "vo_adv_1235003_039",
