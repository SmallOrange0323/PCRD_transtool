  },
  {
    "type": "dialogue",
    "name": "遊戲畫面",
    "words": "你打倒了身為所有事件幕後黑手的惡靈，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊戲畫面",
    "words": "\\n順利地從洋房脫逃。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼啊……",
    "voice": "vo_adv_1235003_040",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然我……",
    "voice": "vo_adv_1235003_041",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "至今玩了這麼多遊戲……",
