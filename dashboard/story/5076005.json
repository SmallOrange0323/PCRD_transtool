    "name": "鈴奈",
    "words": "問你喔，",
    "voice": "vo_adv_5076005_109",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "應該說，那個地獄犬，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n要怎麼樣才能恢復成本來那個",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "毛茸茸的可愛小棉花糖呢？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就像之前那樣。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "只要牠變成這樣，",
    "voice": "vo_adv_5076005_110",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我們不管怎麼做都沒辦法控制牠！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n將這個世界的一切都吞噬殆盡之前，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "牠的怒氣是不會平息的！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_5076005_111",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖變不回來，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就代表我們……？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "對，",
    "voice": "vo_adv_5076005_112",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我們都會成為地獄犬的盤中飧……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n在萬聖節來臨之前，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "現實世界應該就變成一片虛無了吧……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的假的……？",
    "voice": "vo_adv_5076005_113",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級不妙耶……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "嘎嚕嚕嚕嚕……",
    "voice": "vo_adv_5076005_114",
    "unit_id": 15211
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪──！！",
    "voice": null,
    "unit_id": 15211
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "糟了是也！",
    "voice": "vo_adv_5076005_115",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "牠跑到街上去了！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "一旦牠變成那樣，",
    "voice": "vo_adv_5076005_116",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我們就束手無策了……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我已經知道小棉花糖是",
    "voice": "vo_adv_5076005_117",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很危險的妖魔了……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "過，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "繼續在這裡討論也不是辦法──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒錯是也！",
    "voice": "vo_adv_5076005_118",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這可能就是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "博士說的大災難！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n如果是這樣，就只能由我們來阻止了是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說得對！",
    "voice": "vo_adv_5076005_119",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說起來，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是我們抓到牠的，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們就得負起責任到最後！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "走吧，",
    "voice": "vo_adv_5076005_120",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "萬聖節拯救隊要大顯神威了～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "大家發現小棉花糖，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正是靈界的超特級妖魔，地獄犬。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了阻止世界被地獄犬吞噬殆盡，\\n挺身而出。",
    "voice": null,
    "unit_id": null
  }
]
