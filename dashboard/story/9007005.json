    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們不能先在精神上認輸。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "再努力一次吧……！",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "要捉到。",
