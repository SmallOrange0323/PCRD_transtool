    "voice": "vo_adv_9007005_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要捉魔物是無所謂啦……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但為什麼我們要跟魔物比大聲呢……？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "茉莉小姐和莫妮卡小姐曾經說過，",
    "voice": "vo_adv_9007005_008",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "勝敗的關鍵在我們的心。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "也就是說只要我們的氣勢能夠壓過對手，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n無論是什麼樣的敵人都能贏……！",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9007005_009",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n氣勢。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳又接受那些亂七八糟的訓練了……",
    "voice": "vo_adv_9007005_010",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
