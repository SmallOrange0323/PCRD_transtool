    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "沒錯！",
    "voice": "vo_adv_9007005_005",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n兄長大人都已經拜託我們了，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們一定要捉到這隻魔物！",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "5.5──！！",
    "voice": "vo_adv_9007005_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "恭喜──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
