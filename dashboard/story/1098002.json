[
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那是發生在某天的午後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098002_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "已經這個時間了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆差不多也要買完東西回來了吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "打掃和洗衣服也都做得很好，",
    "voice": "vo_adv_1098002_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n真不愧是拉姆的妹妹，得好好地誇獎她才行呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "呼，",
    "voice": "vo_adv_1098002_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "好忙碌好忙碌。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過，",
    "voice": "vo_adv_1098002_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "被誇獎就害羞的雷姆也好可愛。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n光是想像她那個樣子，就讓人湧出了力量，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是個",
    "voice": "vo_adv_1098002_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "讓姊姊感到無上幸福的孩子……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098002_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――真是的，",
    "voice": "vo_adv_1098002_006",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳不要再管我了啦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098002_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "吵吵鬧鬧的是怎麼了？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――我最討厭姊姊了！",
    "voice": "vo_adv_1098002_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……看起來",
    "voice": "vo_adv_1098002_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n是相當激烈的爭執呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "姊姊真是壞心眼！",
    "voice": "vo_adv_1098002_010",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "\\n我明明也在",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "拼命努力啊！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "我、",
    "voice": "vo_adv_1098002_011",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "我只是想幫妳忙……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "那個就叫多管閒事！",
    "voice": "vo_adv_1098002_012",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "什麼都能像那個樣子……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "什麼都做得到的姊姊，",
    "voice": "vo_adv_1098002_013",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "\\n才不會懂我的心情啦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "……！",
    "voice": "vo_adv_1098002_014",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "啊……",
    "voice": "vo_adv_1098002_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "……哼、",
    "voice": "vo_adv_1098002_016",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "哼！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098002_017",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是隨她高興想說什麼就說什麼了呢。",
    "voice": "vo_adv_1098002_018",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你看到了啊，",
    "voice": "vo_adv_1098002_019",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這興趣真糟。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那兩個人",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "明明一直都很要好的啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "姊姊才不會",
    "voice": "vo_adv_1098002_020",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "懂我的心情……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這句話讓人感同深受。",
    "voice": "vo_adv_1098002_021",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n都快讓拉姆的小鳥心臟爆炸了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "什麼？",
    "voice": "vo_adv_1098002_022",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你說小鳥是指很小的鳥兒？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你在瞧不起拉姆嗎？",
    "voice": "vo_adv_1098002_023",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那點事，拉姆當然知道啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "比起那種事……",
    "voice": "vo_adv_1098002_024",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那邊的妳，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "快說給拉姆聽聽吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "咦？",
    "voice": "vo_adv_1098002_025",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "拉姆姐姐……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳們大吵了一架呢。",
    "voice": "vo_adv_1098002_026",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是第一次和妹妹吵架嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "妳怎麼會知道……？",
    "voice": "vo_adv_1098002_027",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "很簡單。",
    "voice": "vo_adv_1098002_028",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "第一次被雷姆拒絕的時候，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "也被像那樣子的說過。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "被妹妹討厭很令人害怕對吧。",
    "voice": "vo_adv_1098002_029",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "簡直就像是",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "全身要被撕裂的感覺。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "……",
    "voice": "vo_adv_1098002_030",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "嗯。",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "我，",
    "voice": "vo_adv_1098002_031",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "\\n想幫忙那孩子。",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "可是，",
    "voice": "vo_adv_1098002_032",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "我是不是幫倒忙了……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不是這樣的。",
    "voice": "vo_adv_1098002_033",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n只是，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "兩人不可能會總是都牽著手。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只是偶爾會想放開牽起的手，",
    "voice": "vo_adv_1098002_034",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "一個人邁出步伐而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果妳有心想和好，",
    "voice": "vo_adv_1098002_035",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n儘管會感到不安，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "也請妳暫時等待。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆去幫妳和她聊聊。",
    "voice": "vo_adv_1098002_036",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "拉姆姐姐嗎？",
    "voice": "vo_adv_1098002_037",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "為什麼要這麼幫我？",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那還用說。",
    "voice": "vo_adv_1098002_038",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "因為拉姆",
    "voice": "vo_adv_1098002_039",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是可愛雷姆最棒的姊姊啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098002_040",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "來，",
    "voice": "vo_adv_1098002_041",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你還站在那裡做什麼？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n別發呆了，快跟上來。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那孩子房間在哪，",
    "voice": "vo_adv_1098002_042",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆可不知道啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "……",
    "voice": "vo_adv_1098002_043",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "進去囉。",
    "voice": "vo_adv_1098002_044",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "哇！？",
    "voice": "vo_adv_1098002_045",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "咦，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "拉姆姐姐！？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯，",
    "voice": "vo_adv_1098002_046",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是拉姆喔。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n不只是拉姆，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還有其他人就是了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "話說回來，",
    "voice": "vo_adv_1098002_047",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n有關於剛才的爭吵……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "唔唔……",
    "voice": "vo_adv_1098002_048",
    "unit_id": 211
  },
  {
