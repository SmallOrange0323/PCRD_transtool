  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳是對",
    "voice": "vo_adv_1098002_053",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n什麼事都做的比自己好的姊姊感到忌妒嗎？",
