    "name": "拉姆",
    "words": "看來妳很後悔呢。",
    "voice": "vo_adv_1098002_049",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n畢竟說了與心相違背的重話啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "與心相違背……",
    "voice": "vo_adv_1098002_050",
    "unit_id": 211
  },
