    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]因為太仰賴他的好意，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]導致我變得懶懶散散……",
