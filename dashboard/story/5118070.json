    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]就會害人不小心變成廢柴啦～～～！！",
    "voice": null,
