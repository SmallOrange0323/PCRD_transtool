    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n都是因為他啦，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]害我都快變成廢柴了～！",
