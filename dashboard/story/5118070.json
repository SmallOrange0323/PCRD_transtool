  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]某天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n{0}和碧卡拉在蘭德索爾街上逛完後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n找了張長椅坐下歇息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]今、",
    "voice": "vo_adv_5118070_000",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]今天也很謝謝你帶人家逛……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]多虧有你，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]人家感覺自己也總算開始弄明白蘭德索爾了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]啊，",
    "voice": "vo_adv_5118070_001",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不，人家肯定還是會迷路啦，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]絕對會……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n剛才的意思是和之前比起來，更明白了這地方一點……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那個，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]要是你覺得人家太得意忘形，我先道歉……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]當、",
    "voice": "vo_adv_5118070_002",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]當然有幫上我很多忙……！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n真的是",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]各種大小事都受你關照……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n神明保佑……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]呀喝～～～～！！",
    "voice": "vo_adv_5118070_003",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]\\n風吹得好舒服喔～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]喝完冰涼透頂的麥酒後來乘涼！",
    "voice": "vo_adv_5118070_004",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n最適合體溫升高的身體啦！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n這樣搭配起來太棒了～♪",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]嗯～？",
    "voice": "vo_adv_5118070_005",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]哎呀～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]這不是{0}嗎～！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n好巧喔～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]啊哈哈哈～♪",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]原、",
    "voice": "vo_adv_5118070_006",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]原來那位好心情的大姐姐是你認識的人呀……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]果然，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]你八成跟全蘭德索爾的人都是朋友吧……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]奇怪惹～？",
    "voice": "vo_adv_5118070_007",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n欸欸，我說你啊，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]怎～麼又跟我沒看過的女孩子在一起呀～！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n還真的是大意不得耶～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]真是的！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]欸……",
    "voice": "vo_adv_5118070_008",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]那邊的女生！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n妳叫什麼名字？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]啊……",
    "voice": "vo_adv_5118070_009",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n人家叫做",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]碧卡拉……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]碧卡拉……",
    "voice": "vo_adv_5118070_010",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]嗯",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]碧卡拉對吧！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]我記住了！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n然後，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]大姐姐我呀～？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]叫做優花梨！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n請多指教囉～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]呵呵呵♪",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]請、",
    "voice": "vo_adv_5118070_011",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]請多指教……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]別說好心情，這根本心情嗨翻天了吧……",
    "voice": "vo_adv_5118070_012",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n{0}先生的朋友圈到底是怎麼一回事呀……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]大家對像我這樣的人也都很親切……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]都沒有什麼警戒心嗎……？　",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]對了……",
    "voice": "vo_adv_5118070_013",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]啊～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]碧卡拉！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n我要告訴妳一個好情報！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n……妳要多多留心{0}喔～？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呃、",
    "voice": "vo_adv_5118070_014",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]啊哈哈哈哈，",
    "voice": "vo_adv_5118070_015",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]不是因為他是什麼危險的人啦？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n他真的……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]是個好孩子！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]這點是不會錯的！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n大姐姐我掛保證！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]啊，",
    "voice": "vo_adv_5118070_016",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]提到掛保證～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]要注意可不能隨便當別人的保證人喔？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n碰到金錢方面的事時，可要謹慎小心！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]否則下場可是會很慘的！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n明白了嗎～？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]要好～～好遵守大姐姐說的話喔？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呃、",
    "voice": "vo_adv_5118070_017",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]好……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]啊，",
    "voice": "vo_adv_5118070_018",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這位大姐姐在金錢方面還是有警戒心的……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]還有啊，",
    "voice": "vo_adv_5118070_019",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]呃……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]怪了？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n我剛才在聊什麼？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]噢～",
    "voice": "vo_adv_5118070_020",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]對啦！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "[FFFFFFFF]我說你啊，",
