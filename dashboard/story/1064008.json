    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}攙扶著腳步不穩的少女，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n讓她在附近的長椅上坐下。",
    "voice": null,
    "unit_id": null
