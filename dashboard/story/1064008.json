    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "不、",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "不用啦。",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "接我的人",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "應該快到了。",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "…………",
    "voice": null,
    "unit_id": 106431
  },
