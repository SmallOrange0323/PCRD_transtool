[
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束善後工作的{0}等人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n步向了東國的大街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這樣",
    "voice": "vo_adv_5212007_000",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "全部都處理完了呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "大家辛苦了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "最後的避難所，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒想到真的是在東國呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是啊！",
    "voice": "vo_adv_5212007_001",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然加上移動花了許多時間，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但終於能夠鬆一口氣了～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n也謝謝",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥的幫忙。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "話說回來，",
    "voice": "vo_adv_5212007_002",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "東國的大街還真是熱鬧啊。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "大家看起來都好開心。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n而且還有很多店鋪……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒想到在這種地方也會有避難所，",
    "voice": "vo_adv_5212007_003",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n公會長真是神出鬼沒呢。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "封印大家的記憶之後，",
    "voice": "vo_adv_5212007_004",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不知不覺間",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "人就",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "突然消失了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "或許又在",
    "voice": "vo_adv_5212007_005",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "世界各地到處奔走了吧。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這次的事件也不是以組成公會的形式處理，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們只是幫忙而已。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "公會果然",
    "voice": "vo_adv_5212007_006",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還是維持解散狀態呢。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "明明還說著",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「【拉比林斯】的實力～」什麼的。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是啊。",
    "voice": "vo_adv_5212007_007",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然感覺有點不可思議……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那時候還想著，",
    "voice": "vo_adv_5212007_008",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "又能大家一起行動了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "果然已經是定局了，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃。",
    "voice": "vo_adv_5212007_009",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "表情別那麼黯淡啦。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這種時候就是要吃點甜食，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "打起精神來！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難得來東國，",
    "voice": "vo_adv_5212007_010",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一起去吃",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "平常吃不到的有名糰子吧♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今天",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐請客。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……呵呵，",
    "voice": "vo_adv_5212007_011",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我最喜歡",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐的這一點了！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5212007_012",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "發現糰子店了！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們快點過去吧♪",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐、",
    "voice": "vo_adv_5212007_013",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這裡喔～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "唉，",
    "voice": "vo_adv_5212007_014",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還真是現實呢～？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "走",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "吧，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "店員，",
    "voice": "vo_adv_5212007_015",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請給我",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個新春糰子組合！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n茶的話要煎茶！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那我也一樣的。",
    "voice": "vo_adv_5212007_016",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "茶就點抹茶好了？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟也點一樣的嗎？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "抹茶，",
    "voice": "vo_adv_5212007_017",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感覺好大人的口味！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5212007_018",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為我是姐姐啊♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～",
    "voice": "vo_adv_5212007_019",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好好喝。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n東國的茶別有一番風味呢……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的呢。",
    "voice": "vo_adv_5212007_020",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "更重要的是，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "身邊有弟弟和璃乃在。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能這樣悠閒享用的茶",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是太棒了♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……感謝招待！",
    "voice": "vo_adv_5212007_021",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐、",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n機會難得，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要不要稍微散步一下？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "movie",
    "movie_id": "521200701"
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然一時衝動就說要幫忙了！",
    "voice": "vo_adv_5212007_022",
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過就算這樣，",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n至少過年",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也該讓人休息一下吧！？",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "公會長",
    "voice": "vo_adv_5212007_023",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的是很會使喚人呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n偶爾也想要一點獎勵啊～？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且看起來公會長在不知不覺間還訂做了一件感覺很不錯的和服？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，",
    "voice": "vo_adv_5212007_024",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個？",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這是東國限定",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "附有特殊效果的稀有裝備喔。",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我想說不只外觀好看，",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "順便還可以提升戰鬥效率♪",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真不愧是公會長，",
    "voice": "vo_adv_5212007_025",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "準備萬全！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那樣的話～",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果也可以幫我們安排一下，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
