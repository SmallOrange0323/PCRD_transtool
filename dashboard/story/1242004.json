[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "手上拿著從女性那裡獲得的優待券，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n純與{0}來到了那間超級熱門的餐廳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊，",
    "voice": "vo_adv_1242004_000",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真幸福。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們竟然能夠坐在這間很難預約得到的餐廳裡，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且還是在聖誕節時期過來用餐呢。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實我之前就一直很關注這間餐廳。",
    "voice": "vo_adv_1242004_001",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，光是預約就要等上一年，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再加上我一身鎧甲也不符合穿著規定，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n肯定會吃上閉門羹。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我原以為自己是跟這間餐廳無緣了，",
    "voice": "vo_adv_1242004_002",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在能夠坐在這裡真是幸福。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，少年，你也盡量多吃……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦……",
    "voice": "vo_adv_1242004_003",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這道光是怎麼回事？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若是聖誕節的演出，未免也太刺眼了……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚哇！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊……",
    "voice": "vo_adv_1242004_004",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，是你啊。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242004_005",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你說我看起來很沒精神？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實我碰到了很不得了的事……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我待會要去參加",
    "voice": "vo_adv_1242004_006",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在購物中心舉辦的一場演出。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n當然，我是很高興有這樣的機會……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可以請你看一下這張傳單嗎？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": "vo_adv_1242004_007",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我原以為是一般的戰隊英雄秀，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒想到竟然是少女動畫的真人演出。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且，我所要演出的角色",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是主角Pure Pure Lip……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242004_008",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是這樣沒錯啦……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你看看傳單上所畫的",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "Pure Pure Lip。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……臉",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會完全露出來，對吧。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，你真敏銳。",
    "voice": "vo_adv_1242004_009",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是這樣……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你看看傳單上所畫的",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "Pure Pure Lip。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n臉整個都露出來了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我事前已明確告知，",
    "voice": "vo_adv_1242004_010",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不接露臉的演出。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他們似乎是誤以為我不接以素顏見人的演出。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我平時就戴著面具，還以為他們會懂我的意思……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "結果並沒有懂。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然，",
    "voice": "vo_adv_1242004_011",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接下通告時，沒有仔細確認，這的確是我的疏失。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n身為專業人士，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如今也沒辦法開口回絕。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n然而，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一想到要在一大群觀眾面前露臉……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唉。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……我說少年啊，",
    "voice": "vo_adv_1242004_012",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你有沒有想到什麼好點子？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來如此……",
    "voice": "vo_adv_1242004_013",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我去詢問主辦單位看看！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他們認為我在開玩笑，當場就被拒絕了……",
    "voice": "vo_adv_1242004_014",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來如此……",
    "voice": "vo_adv_1242004_015",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果是扮演魔物，就會穿布偶裝。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我去問問看能不能讓我換角色！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "扮演魔物的熟男大叔反過來問我，",
    "voice": "vo_adv_1242004_016",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n難道要由我去扮演美少女戰士嗎？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我被反駁得無話可說。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不行了，",
    "voice": "vo_adv_1242004_017",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真的是束手無策了……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我就要在購物中心",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "公開露臉了……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n呵呵……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1242004_018",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "除了面具外？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……唔！！",
    "voice": "vo_adv_1242004_019",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那張傳單",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以給我看一下嗎？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這美少女戰士的畫風……",
    "voice": "vo_adv_1242004_020",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為是少女動畫，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以髮型很醒目豔麗，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嘴唇豐滿彈嫩，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "眼睛也閃閃發亮。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只要仿照這般畫風，",
    "voice": "vo_adv_1242004_021",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "善用妝容及假髮來打扮……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就能達到",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等同戴著面具的效果……！？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，這真是個好點子！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，我要順便拜託你一件事……",
    "voice": "vo_adv_1242004_022",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請你幫我上妝！！",
    "voice": "vo_adv_1242004_023",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_1242004_024",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別擔心。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我比你更沒有自信。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我平時",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都戴著面具，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n對妝容或髮型完全一竅不通。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也不想拜託其他人，",
    "voice": "vo_adv_1242004_025",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為這樣會被他們看到我的真面目。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n至於你，早已見過我的真面目了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再說……",
    "voice": "vo_adv_1242004_026",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果是你，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就算沒把我的妝畫好，我也不會介意。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以，萬事拜託了，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你。",
    "voice": "vo_adv_1242004_027",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我就知道你會幫我這個忙。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，我們就趕緊到準備室去吧。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "still",
    "still_id": "124200401"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……純真小淑女的美少女戰士，",
    "voice": "vo_adv_1242004_028",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "Pure Pure Lip登場。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你那混濁黑暗的心，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就由我來抹上正義的唇彩吧……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………偷瞄。",
    "voice": "vo_adv_1242004_029",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不行，",
    "voice": "vo_adv_1242004_030",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我完全記不住台詞。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖說剛剛很衝動地請少年幫我上妝……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但現在冷靜想想，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年正輕觸著我的臉。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "頭髮……",
    "voice": "vo_adv_1242004_031",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "臉頰……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嘴、",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嘴唇……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不行，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我覺得好熱……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1242004_032",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是這樣。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這紅暈不是化妝的關係……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先、",
    "voice": "vo_adv_1242004_033",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先不說這個了。少年，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想不到你那麼會化妝。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然自己這樣說有點難為情，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我變得完全不像自己……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真可愛。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣一來，想必就不會有人知道",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的真面目了。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可……！？",
    "voice": "vo_adv_1242004_034",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不要捉弄大人……！",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "打擾了。",
    "voice": "vo_adv_1242004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n再過10分鐘，演出就要開始囉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n請問已經準備……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "哇啊……",
    "voice": "vo_adv_1242004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "真可愛！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊，",
    "voice": "vo_adv_1242004_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這對演員來說太失禮了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "抱歉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n不、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這妝容真的很讚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "從小就是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\nPure Pure Lip的粉絲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "妳簡直就跟她一模一樣……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別、",
    "voice": "vo_adv_1242004_038",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別這麼說……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會很害臊。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但也",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝妳的讚美。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有少年，",
    "voice": "vo_adv_1242004_039",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……也謝謝你",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幫我打扮得這麼可愛。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好啦，",
    "voice": "vo_adv_1242004_040",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妝容很完美，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接下來就只剩換上戲服。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，就請你出去一下。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "換裝我一個人來就行了。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1242004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次的夢",
    "voice": "vo_adv_1242004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "超稀有的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n想不到竟然能見到純的那般模樣♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "果然只要人長得好看，化妝的效果也會很讚。",
    "voice": "vo_adv_1242004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說實話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也很想看到純穿上美少女戰士戲服的模樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": "vo_adv_1242004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也意外發現到自己的才華了吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想不到你的化妝技術那麼好……",
    "voice": "vo_adv_1242004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟再怎麼說，你也見過不少美少女了嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次也請你幫我上妝好了。",
    "voice": "vo_adv_1242004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n到時就拜託你囉～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1242004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": "vo_adv_1242004_048",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼會在這種地方睡著？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……被你看到不得體的一面了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是讓人害臊。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_1242004_049",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "料理送來了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哇啊，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光是聞到香味就讓人口水直流……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們快點開動吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這道肉類料理",
    "voice": "vo_adv_1242004_050",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "堪稱一絕，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一下子就吃光了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這的確是值得預約等候一年的美味。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不如再續點一份好了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我知道，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也會替你續點一份。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這幾天，",
    "voice": "vo_adv_1242004_051",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n託你的福，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我體驗到片刻的聖誕節期氛圍。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……不過，",
    "voice": "vo_adv_1242004_052",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n眼看聖誕節就快要到了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是這樣的。",
    "voice": "vo_adv_1242004_053",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我只是在想，",
    "voice": "vo_adv_1242004_054",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再多維持一下這般被施了魔法的狀態，感覺也挺不錯的。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呵呵，",
    "voice": "vo_adv_1242004_055",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我說了很奇怪的話吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好啦，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快吃吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖女的活躍表現之下，蘭德索爾迎來平靜安詳的聖誕夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了幾天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n城鎮解除被施加的聖誕節魔法的那一刻終於到來──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那個，",
    "voice": "vo_adv_1242004_056",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我有事想問。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n我想要見聖女大人，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "明年還遇得到她嗎？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "告訴我，",
    "voice": "vo_adv_1242004_057",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "穿著鎧甲的姐姐！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "聖女大人嗎……",
    "voice": "vo_adv_1242004_058",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我想想……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只要妳當個乖孩子，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想她會出現的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": "vo_adv_1242004_059",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳能答應我嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n要用這雙手",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "守護妳重要的人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯……！",
    "voice": "vo_adv_1242004_060",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我會的……！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不過，姐姐，",
    "voice": "vo_adv_1242004_061",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳握住我的手的這雙手，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "很不可思議呢。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "雖然套著鎧甲，",
    "voice": "vo_adv_1242004_062",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "卻很溫暖呢！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_1242004_063",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節的魔法解除後，純又恢復成平時的黑鐵之姿。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過，在她內心深處，確實存在著聖女的溫暖。",
    "voice": null,
    "unit_id": null
  }
]
