    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "之前我都是靠一股熱血關關難過關關過，",
    "voice": "vo_adv_5052004_032",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不過我很疑惑，這樣下去真的沒問題嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "之所以會做那個惡夢，",
    "voice": "vo_adv_5052004_033",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n說不定也是因為我感覺到自己能力不足。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我必須變得更強……！",
    "voice": null,
    "unit_id": 105311
