  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我真的，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "能成為提督嗎……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就算我成功了，",
    "voice": null,
    "unit_id": 105311
  },
