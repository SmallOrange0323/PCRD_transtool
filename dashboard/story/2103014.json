  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "什麼！？",
    "voice": "vo_adv_2103014_016",
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n已經恢復了嗎！？",
