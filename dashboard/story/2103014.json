    "name": "卡里莎",
    "words": "嘖！",
    "voice": "vo_adv_2103014_014",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n伊諾利斯！？",
    "voice": null,
    "unit_id": 191611
  },
  {
