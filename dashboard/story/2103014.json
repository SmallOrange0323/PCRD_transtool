  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【憤怒‧軍團】對【咲戀育幼院】展開了襲擊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在千鈞一髮之際，{0}終於甦醒——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而怜與日和",
    "voice": null,
