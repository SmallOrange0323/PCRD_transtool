  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "妳的朋友似乎陷入了苦戰呢，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n妳不去拔刀相助也無妨嗎？",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "此刻，",
    "voice": "vo_adv_2103014_022",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我豈能將背對你暴露出弱點……",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n況且若將你擊敗，",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那礙事的恢復魔法也會解除才是！",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "合情合理。",
    "voice": "vo_adv_2103014_023",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n看來妳不只劍藝，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "思緒也相當鋒銳呢。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "然而妳是否能辦到，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "那又另當別論了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我必定會擊敗你！",
    "voice": "vo_adv_2103014_024",
    "unit_id": 180311
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "收到了凱留傳來的通訊魔法的貪吃佩可，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與率領著【王宮騎士團】的純一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正一同趕往【咲戀育幼院】。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家",
    "voice": "vo_adv_2103014_025",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快點快點～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "請您慢一些呀，",
    "voice": "vo_adv_2103014_026",
