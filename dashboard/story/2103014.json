  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "嘿嘿！",
    "voice": "vo_adv_2103014_018",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n玩夠了沒，",
    "voice": null,
    "unit_id": 191611
  },
