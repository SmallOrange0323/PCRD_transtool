  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "把那隻煩人貓的鬍鬚還有尾巴，",
    "voice": null,
    "unit_id": 191611
  },
