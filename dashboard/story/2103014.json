  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "差點忘了！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n這是阿澤爾德的「即時再生」嘛！",
