    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚～",
    "voice": "vo_adv_2103014_033",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "【王宮騎士團】的人們\\n願意提供協助，我是很開心沒錯啦。",
    "voice": null,
    "unit_id": 105811
  },
