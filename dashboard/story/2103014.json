    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "給我再跑快點！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n穿著一身輕裝鎧甲，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別在那叫苦連天！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "真、",
    "voice": "vo_adv_2103014_028",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "真是抱歉，團長！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士3",
