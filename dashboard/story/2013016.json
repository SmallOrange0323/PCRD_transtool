  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個！　",
    "voice": "vo_adv_2013016_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好久不見了，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "優衣！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我有一個同伴她一直都沒辦法醒過來，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳能不能用恢復魔法",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想想辦法呢……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？　",
    "voice": "vo_adv_2013016_001",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是貪吃佩可……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n當時，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的非常感謝妳",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從魔物的手中救了我！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為了報恩，",
    "voice": "vo_adv_2013016_002",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然還有點搞不清楚狀況……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但這一次，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "輪到我來幫助妳們了唷。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個。",
    "voice": "vo_adv_2013016_003",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以妳說醒不過來的人，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是哪位呢？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "或許用我的魔法",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "能有什麼辦法可以解決也說不定，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n總之請先讓我來檢查看看吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好喔，",
    "voice": "vo_adv_2013016_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是那孩子唷！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是小可蘿非常努力地背在身上的",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那孩子！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……。",
    "voice": "vo_adv_2013016_005",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇，",
    "voice": "vo_adv_2013016_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "又是這個人！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼好像",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "每次看到她都是暈過去的呢……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵。",
    "voice": "vo_adv_2013016_007",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對優衣來說的確是有那種印象才是呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這孩子的名字叫做小凱留，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是我非常重要的朋友。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得已經是非常、",
    "voice": "vo_adv_2013016_008",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常久以前的事情了。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但從那時候……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從第一次見面以來，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n她就幾乎每天都和我們聚在同一個餐桌前，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "與我們和睦的相處著。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是這樣呀……",
    "voice": "vo_adv_2013016_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那麼絕對要",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "幫助她才行呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想想喔。",
    "voice": "vo_adv_2013016_010",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n簡單看過以後的感覺，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "她單純只是睡得很熟而已……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我應該可以想點辦法。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我知道可以用來",
    "voice": "vo_adv_2013016_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "抵銷魔物使人睡著的咒文的方法，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以只要稍微做些應用應該就……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呣～呣呣呣！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯、",
    "voice": "vo_adv_2013016_012",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……？",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_2013016_013",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "醒來了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的非常謝謝妳優衣，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳好厲害呢！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_2013016_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我總是和夥伴們一起，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n在謎一般的地城中",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "進行冒險嘛。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為了不管遇上什麼狀況都可以應付，",
    "voice": "vo_adv_2013016_015",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以學習了很多的魔法並且記在腦中了呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯……",
    "voice": "vo_adv_2013016_016",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "奇怪了？",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我……？",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留～☆",
    "voice": "vo_adv_2013016_017",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喵哇！？",
    "voice": "vo_adv_2013016_018",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳別給人家用全力抱上來呀，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要斷了要斷了",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "骨頭要斷了啦！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別這麼搞啦貪吃佩可，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的蠻力不是開玩笑的耶！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_2013016_019",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對不起嘛小凱留……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抱抱♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳真是的……",
    "voice": "vo_adv_2013016_020",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不知道我該用什麼表情面對妳們才好。",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": "vo_adv_2013016_021",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有{0}……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真的是",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對不起，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有謝謝。",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_2013016_022",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這種時候，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
