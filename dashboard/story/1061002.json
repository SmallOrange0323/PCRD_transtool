[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "受到凱留等人襲擊而逃亡的\\n{0}一行人移動到了其他的據點，\\n為了對抗王宮而舉行了作戰會議。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "差不多該休息了吧。",
    "voice": "vo_adv_1061002_000",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "吃飯囉，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "吃飯！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n肚子餓了也會沒力氣喔！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦，",
    "voice": "vo_adv_1061002_001",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}呢？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "矛依未小姐。",
    "voice": "vo_adv_1061002_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果要找主公大人的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他現在出去外面了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "外面？",
    "voice": "vo_adv_1061002_003",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我去稍微看看。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可可蘿。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可以拜託妳和靜流她們一起",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "幫忙準備一下飯菜嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了。",
    "voice": "vo_adv_1061002_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……矛依未小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下準備料理的時候，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人就拜託您關照了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "事到如今還說些什麼。",
    "voice": "vo_adv_1061002_005",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我早就在關照他了吧？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來去找那傢伙吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……喔！",
    "voice": "vo_adv_1061002_006",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有了有了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唷！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在看星星嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我叫諾維姆啦！",
    "voice": "vo_adv_1061002_007",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "用那個名字叫我也沒差啦，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "現在的話。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼了？",
    "voice": "vo_adv_1061002_008",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "個頭啦！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我聽說你一個人不知跑去哪裡，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我才跑來找你的！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可可蘿好像很擔心你喔。",
    "voice": "vo_adv_1061002_009",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好好振作點啊，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "主人！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然你可能還無法馬上就振作起來，",
    "voice": "vo_adv_1061002_010",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但可可蘿也是吧？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是啊……",
    "voice": "vo_adv_1061002_011",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總是在一起的同伴，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "突然變成敵人還分開，\\n又要相互戰鬥，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你跟她現在可能還是很難受……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是從很久以前就已經習慣了啦！",
    "voice": "vo_adv_1061002_012",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我和尾狗刀他們一起",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "背叛了七冠，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也曾在敵人手下臥底過！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有當時面對可能成為同夥的你們，",
    "voice": "vo_adv_1061002_013",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n其實是想成為夥伴的，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但卻仍是以敵對的身份戰鬥著！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以你別擔心！",
    "voice": "vo_adv_1061002_014",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然我這麼說，但你啊，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n其實早就決定好想怎麼做了吧？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "剛剛也說過了吧？",
    "voice": "vo_adv_1061002_015",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n如果被通緝的話，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一回王都就會立刻被捕喔？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且你們打算",
    "voice": "vo_adv_1061002_016",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼幫助貪吃佩可呢？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n王宮的警備非常森嚴喔？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且你說兩人……",
    "voice": "vo_adv_1061002_017",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你果然",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也想救那個叫凱留的女孩子啊。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說在前頭，",
    "voice": "vo_adv_1061002_018",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們可沒有餘力再救她喔。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要做的話打倒真那才是優先的事。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "打倒真那，",
    "voice": "vo_adv_1061002_019",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "把奇怪的世界恢復原狀。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這才是我們現在該做的事。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是我",
    "voice": "vo_adv_1061002_020",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "希望能幫助你和可可蘿。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "特別是",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不想把你那公主騎士的力量放著不管。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你可能會覺得我很任性，",
    "voice": "vo_adv_1061002_021",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但我會把心裡所想的全說出來。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在變得無法說出口之前。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝啊！",
    "voice": "vo_adv_1061002_022",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也想幫助貪吃佩可。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但事情能否順利進行，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "現在都還是未知數……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果連你也被抓起來的話就糟了，",
    "voice": "vo_adv_1061002_023",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以其實不太想要分頭行動的呢～……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_1061002_024",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抓好時機就好了吧……？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……快想想辦法啊。",
    "voice": "vo_adv_1061002_025",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就像曾是敵人的他和尾狗刀一樣，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只要不斷思考，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一定會知道該做的事！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我和他都",
    "voice": "vo_adv_1061002_026",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有事要去王宮。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們攻擊和他們潛入的時間",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n得在同日、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "同時開始才有意義……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……只要確保聯絡方式",
    "voice": "vo_adv_1061002_027",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該就沒問題了吧。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我說啊，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們能用通訊魔法之外的聯絡方式嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為若是使用魔法可能會被察覺，",
    "voice": "vo_adv_1061002_028",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n若有其他方法的話，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我想應該就沒問題了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "動物嗎！",
    "voice": "vo_adv_1061002_029",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也就是說既不用魔力也不用魔法囉！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如此一來就不會有被察覺的問題了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可可蘿好樣的！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "still",
    "still_id": "106100201"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就這麼決定囉！",
    "voice": "vo_adv_1061002_030",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你和可可蘿，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "從明天開始和我們分頭行動！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們先回王都，",
    "voice": "vo_adv_1061002_031",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "探查一下其中的情況！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們在那段期間裡",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會做好各種準備！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我還會準備其他的聯絡方式，",
    "voice": "vo_adv_1061002_032",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n安心的去王都吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也許我們和你們，",
    "voice": "vo_adv_1061002_033",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n都不知道對方在做什麼反而剛剛好！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果做出難以搞懂的行動，",
    "voice": "vo_adv_1061002_034",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n敵人應該也無法解讀我們的行動！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯！",
    "voice": "vo_adv_1061002_035",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是那樣！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且啊……",
    "voice": "vo_adv_1061002_036",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "之前你讓我打起了精神，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這次換我來讓你恢復精神了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "夥伴不在身旁的難受與寂寞，",
    "voice": "vo_adv_1061002_037",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我非常懂……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我不希望讓你這麼樣的好人，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也嘗到那種痛苦滋味。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別擔心！",
    "voice": "vo_adv_1061002_038",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有我們啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n可可蘿、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "拉基拉基、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大吾、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真軌、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "克莉絲提娜、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "璃乃、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "靜流！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這個世界上的大家，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都是你的夥伴！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然我也沒立場這麼說，",
    "voice": "vo_adv_1061002_039",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但失敗這種事",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就別多想了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那種事情，",
    "voice": "vo_adv_1061002_040",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "等真的失敗後再想就好了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "現在只要",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "做想做的事就好。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且",
    "voice": "vo_adv_1061002_041",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們都一樣，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算遇到失敗，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也一定會學到些什麼吧？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "連以為不會再見的你都再次遇到了……",
    "voice": "vo_adv_1061002_042",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n沒有什麼事情",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是不可能的！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也會加油的！",
    "voice": "vo_adv_1061002_043",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也要加油啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n主角！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不用加小！",
    "voice": "vo_adv_1061002_044",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我叫諾維姆！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n都決定好了，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就和可可蘿他們一起討論吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "走吧！",
    "voice": "vo_adv_1061002_045",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――矛依未伸拳碰了一下{0}的胸口，\\n拉著他的手腕一起回到據點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
