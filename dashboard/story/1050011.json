  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對{0}說出帶著告白感覺的話後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美咲衝出宅邸一路逃進了小巷子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚嗚……",
    "voice": "vo_adv_1050011_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "太糟糕了……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我說了那種話……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一定會被誤會的……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n從明天起，我要用什麼樣的表情和那傢伙見面才好……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "──咿！？",
    "voice": "vo_adv_1050011_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "他",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "他他、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "他為什麼追過來了！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不行不行不行，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我現在沒辦法跟那傢伙說話！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然想逃走，",
    "voice": "vo_adv_1050011_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但鞋子磨腳沒辦法好好跑步……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還是假裝沒聽到，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "趕快溜回家……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………啊啊，真是的！",
    "voice": "vo_adv_1050011_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "煩人！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "別跟過來！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦，",
    "voice": "vo_adv_1050011_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你的背後！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n那是什麼光啊～～～！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "510102"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚嗚……",
    "voice": "vo_adv_1050011_005",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "想著想著天都黑了……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n說真的，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我該怎麼辦才好……？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你、",
    "voice": "vo_adv_1050011_006",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你為什麼在這裡！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話說在前頭，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "今天我沒空理你……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……你問我為什麼不在門禁時間前回家……？",
    "voice": "vo_adv_1050011_007",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那種事",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "與你無關吧！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n不如說，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為什麼你會知道啊！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "難道說……",
    "voice": "vo_adv_1050011_008",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是媽媽拜託你的對吧！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "她希望你來接我吧！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………哼。",
    "voice": "vo_adv_1050011_009",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好啊。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就陪你一下下。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "background",
    "bg_id": "510122"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "然後呢？",
    "voice": "vo_adv_1050011_010",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你帶我來公園這種地方打算做什麼？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那是什麼？",
    "voice": "vo_adv_1050011_011",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "熱可可？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟的淑女才不會喝這種",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "孩子氣的飲料！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1050011_012",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說可可多酚對肌膚很好？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然是這樣……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……",
    "voice": "vo_adv_1050011_013",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊～",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真好喝♪",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然在沮喪的時候",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就要吃甜食呢♪",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你在偷笑什麼啦。",
    "voice": "vo_adv_1050011_014",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n……看到我心情好，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "讓你這麼高興嗎？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哼……",
    "voice": "vo_adv_1050011_015",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話說在前頭，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我可不會道謝。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過作為報答……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我可以",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "稍微告訴你一點。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……我並沒有",
    "voice": "vo_adv_1050011_016",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "離家出走。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我去姊姊家玩，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "本來打算在拜訪結束後回家的……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了，",
    "voice": "vo_adv_1050011_017",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你還沒見過",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我姊姊對吧。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我的姊姊",
    "voice": "vo_adv_1050011_018",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "長得很漂亮，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n打扮時髦，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "性格溫柔……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "而且",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "非常博學。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "男人見到她全～都為她著迷喔。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也",
    "voice": "vo_adv_1050011_019",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "非常尊敬她。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n將來",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想成為像姊姊那樣的成熟的淑女。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以我想請姊姊",
    "voice": "vo_adv_1050011_020",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "教我化妝和穿搭等等的",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "各種事情，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "經常去找她玩……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是今天……",
    "voice": "vo_adv_1050011_021",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我吃了閉門羹。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我明明有跟她約好的……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "而且姊姊",
    "voice": "vo_adv_1050011_022",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "完全不肯露面，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我擔心她會不會是感冒了。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以我說",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "「在妳告訴我理由之前，我不會回去」，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "結果……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "姊姊",
    "voice": "vo_adv_1050011_023",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就生氣了！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對著我發火！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣的姊姊……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才不是成熟的淑女！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "姊姊那種人……",
    "voice": "vo_adv_1050011_024",
