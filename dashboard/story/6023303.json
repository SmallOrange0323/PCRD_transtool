[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依嗎？　",
    "voice": "vo_adv_6023303_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她說今天要打工，已經回去囉。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她有點工作狂的傾向，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "說擔心也是蠻擔心的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你對克蘿依的印象如何呢？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_6023303_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她的身心都極其強韌。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "究竟是為什麼呢？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她對於自己的私事",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "都不怎麼多提，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不過一定是有什麼原因讓她變成這樣的吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可能也是身為長女的關係，",
    "voice": "vo_adv_6023303_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "別看她那樣，她很會照顧人呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n她家裡面歲數差很多的年幼弟弟們",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好像有三個。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想她大概把你",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當成她第四個弟弟了吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "正是。",
    "voice": "vo_adv_6023303_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她就像是進食後的肉食動物。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對我們的玩笑話，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她平時就像是用尾巴趕蒼蠅那樣，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過要是真的惹她生氣的話……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔哇哇哇哇太可怕了……",
    "voice": null,
    "unit_id": 111011
  }
]
