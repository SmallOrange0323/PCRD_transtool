  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "準備逃了！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "邊躲在遮蔽物後面邊跑！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜的複製品",
    "words": "………………你追我跑就到此為止了嗎？",
    "voice": "vo_adv_1339003_058",
    "unit_id": 107112
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼，",
    "voice": "vo_adv_1339003_059",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還玩得不夠盡興啊？",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我是想說差不多該換個遊戲了。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "能夠跟到這邊來，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就誇獎一下吧☆",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "相比起來小子真是沒毅力啊……",
    "voice": "vo_adv_1339003_060",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你要多鍛鍊體力了！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種程度的險惡道路，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一邊哼歌一邊小跳步跑過也是理所當然的吧☆",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "回去之後會幫你設計肌力訓練的項目，",
    "voice": "vo_adv_1339003_061",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n好好期待吧♪",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼……",
    "voice": "vo_adv_1339003_062",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要繼續演出這場撤退戰拖著她們跑，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n再一一解決也是可以……",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但我差不多覺得膩了。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在小子受傷前收拾掉吧！",
    "voice": "vo_adv_1339003_063",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──幫我強化！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就來蹂躪妳們吧☆",
    "voice": "vo_adv_1339003_064",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n──虛數魔境！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呼……",
    "voice": "vo_adv_1339003_065",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣就一掃而空了呢。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "從作為遮蔽物的樹木後面",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "發動大火力的掃蕩攻擊，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n即便用絕對防禦也無法擋下吧。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "物件越多細節，演算就需要花越多時間。",
    "voice": "vo_adv_1339003_066",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在充滿細小物件的森林中，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雙方都會增加不確定因素。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果是同樣不穩定的狀況下──",
    "voice": "vo_adv_1339003_067",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n攻擊強的那一方更有利。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是這麼簡單……♪",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "辛苦了，",
    "voice": "vo_adv_1339003_068",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "多虧了小子讓我這次玩得很開心。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然之前也和冒牌的自己戰鬥過，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但數量這麼多的還是第一次呢。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要是稍微搞錯撤退戰的路線，",
    "voice": "vo_adv_1339003_069",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算死掉也不奇怪。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "久違地感受到了刺激的生命危險呢♪",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_1339003_070",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很棒的刺激，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感覺可能會有點上癮。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n像這樣賭上性命的惡作劇可不常見啊……",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……你那是什麼表情，",
    "voice": "vo_adv_1339003_071",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對明明有生命危險，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n卻看起來很愉快的我感到不可思議嗎？",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我還以為",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子可以理解我呢。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": "vo_adv_1339003_072",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是圓滑的回覆，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n平時的話可能會給你打個及格分……",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但最後，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再回答我一個問題。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": "vo_adv_1339003_073",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我總是表現得很愉快的原因，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你知道是什麼嗎？",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼嗯，",
    "voice": "vo_adv_1339003_074",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然直接告訴你答案很簡單……",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但那樣就太無趣了☆",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們回去村子吧，",
    "voice": "vo_adv_1339003_075",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n答案就在那之後再公布☆",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}沒能得到克莉絲提娜出的謎題答案，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n只好跟在她的身後。",
    "voice": null,
    "unit_id": null
  }
