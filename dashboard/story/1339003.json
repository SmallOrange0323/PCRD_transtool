  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和克莉絲提娜兩人，\\n行走在被破壞的蘭德索爾的街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是被大肆破壞了呢。",
    "voice": "vo_adv_1339003_000",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這裡也算是跨越過無數次危機的地方了。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該說是鉅細靡遺，",
    "voice": "vo_adv_1339003_001",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "又或者是",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "細心縝密。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個嘛，",
    "voice": "vo_adv_1339003_002",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n稍微回想起",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "幾天前發生的事了。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然最後",
    "voice": "vo_adv_1339003_003",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "阻止了還原。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但世界卻被破壞得",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不堪入目☆",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不愧是",
    "voice": "vo_adv_1339003_004",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以七冠為原型的複製體。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "竟然這麼執著地徹底破壞，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來是巧妙地利用了我們的資料，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就算是敵人，這點還是值得稱讚呢。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到處都變成這副模樣，",
    "voice": "vo_adv_1339003_005",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n曾以美麗街景為傲的蘭德索爾也變得慘不忍睹。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "乾脆就在這裡",
    "voice": "vo_adv_1339003_006",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "建立新的城市……",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我覺得",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個想法",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也不錯呢。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是吧，小子？",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈，",
    "voice": "vo_adv_1339003_007",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是率直的感想☆",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你的這種個性，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我打從心底覺得喜歡。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我？",
    "voice": "vo_adv_1339003_008",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我嗎……",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這個嘛，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在小子的眼裡看起來如何？",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔，",
    "voice": "vo_adv_1339003_009",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你是這麼認為的啊。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感想稍顯平凡，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但也不錯，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n算你及格吧☆",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "引頸期盼、",
    "voice": "vo_adv_1339003_010",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "夢寐以求的非日常",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n突然就在眼前實現了，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼可能會不愉快？",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一開始了解事情始末後，",
    "voice": "vo_adv_1339003_011",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n別說是興奮了，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我甚至可以說是深受感動。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……與此同時，",
    "voice": "vo_adv_1339003_012",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "卻也感到很不滿。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……沒想到我的情緒，",
    "voice": "vo_adv_1339003_013",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "居然會如此動搖。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……好，",
    "voice": "vo_adv_1339003_014",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我決定了。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們現在要離開這裡，",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "跟我來。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "玩完以後，",
    "voice": "vo_adv_1339003_015",
    "unit_id": 133912
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "得要好好收拾善後才行呢。",
    "voice": null,
    "unit_id": 133912
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克莉絲提娜帶著{0}前往的地方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n是在蘭德索爾郊外的某座村莊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……是",
    "voice": "vo_adv_1339003_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "被那些假七冠破壞的村莊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "即使離王都中心這麼遠，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "損害也相當嚴重呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來沒有其他人。",
    "voice": "vo_adv_1339003_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣子正好，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以毫無顧忌地大鬧一場了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為什麼要來這裡，",
    "voice": "vo_adv_1339003_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你看起來很好奇呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "馬上就能知道了……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "本來想這樣說的，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但我就直接告訴你答案吧☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "明明一切都結束了──",
    "voice": "vo_adv_1339003_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "卻還有",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不知道祭典已經落幕的蠢蛋們，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n繼續開著派對，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以我來搞破壞了♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……這怎麼看，",
    "voice": "vo_adv_1339003_020",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都是最適合我的工作吧☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼──",
    "voice": "vo_adv_1339003_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "情況如何。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔，",
    "voice": "vo_adv_1339003_022",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子的直覺也很敏銳呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n明明空無一人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "卻飄散著詭異的緊張感。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "究竟有什麼東西潛藏著呢……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔！",
    "voice": "vo_adv_1339003_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n──快躲開！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "等等再說，",
    "voice": "vo_adv_1339003_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "先撤退。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……快點。",
    "voice": "vo_adv_1339003_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……看來是一群沒耐心的傢伙們，",
    "voice": "vo_adv_1339003_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
