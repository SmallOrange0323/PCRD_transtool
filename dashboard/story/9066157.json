    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "怎麼樣怎麼樣，",
    "voice": null,
    "unit_id": 130211
