  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還一個人跑過來……！",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "一個人～？",
