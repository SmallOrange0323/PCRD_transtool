    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "──我按♡",
    "voice": "vo_adv_9066157_011",
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "凱留",
