    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我看起來像一個人而已～？",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "答錯了～♡",
    "voice": "vo_adv_9066157_005",
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我今天雖然是一個人來，",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n但不只是我一個人喔～♡",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "出擊囉，",
    "voice": "vo_adv_9066157_006",
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "「飛天狂鼬」～♡",
    "voice": null,
    "unit_id": 130211
  },
  {
