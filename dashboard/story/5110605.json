[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在街上閒晃時，諾維姆向尾狗刀開口搭話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂，尾狗刀。",
    "voice": "vo_adv_5110605_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我從以前就一直很在意……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你的實力",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "到底是算強？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "還是算弱啊？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦，",
    "voice": "vo_adv_5110605_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "應該不算是弱……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就普普通通吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "可以輕鬆應付一些雜兵，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n不過，和諾維姆比起來，我就算是很嬌弱了～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你果然",
    "voice": "vo_adv_5110605_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是在敷衍我吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n你只是因為嫌工作麻煩",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "才沒有拿出真本事對不對？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就讓我稍微驗證一下吧～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喂！",
    "voice": "vo_adv_5110605_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "總算找到你們了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n來和我一決勝負吧！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哇啊，",
    "voice": "vo_adv_5110605_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "他是什麼時候來的……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳早就注意到，卻故意不說的吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嘿嘿，",
    "voice": "vo_adv_5110605_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我剛剛就看到他朝我們衝來了。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n好喔，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我們接受挑戰！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀，由你上吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦～",
    "voice": "vo_adv_5110605_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "為何我非得要聽話接受他的挑戰啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n才不要，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "太麻煩了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果不這麼做，",
    "voice": "vo_adv_5110605_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我就沒辦法知道你的真本事了嘛！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "別介意，你就上吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你們不管是誰要上，我都沒差！",
    "voice": "vo_adv_5110605_008",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n最好是你們兩個聯手攻過來！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就說我才不要。",
    "voice": "vo_adv_5110605_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我要先走一步了……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唔，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳別阻擾我開溜。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不，",
    "voice": "vo_adv_5110605_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我不會讓你溜走的！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我今天一定要見識一下",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你的真本事！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "你認命點接招吧！",
    "voice": "vo_adv_5110605_011",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "吃我一拳！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哇啊！",
    "voice": "vo_adv_5110605_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "等等！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n就說我是負責動腦筋的，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不適合做體力活啊！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不！",
    "voice": "vo_adv_5110605_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是你隱藏了真正的實力！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n這我很清楚！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以我說～",
    "voice": "vo_adv_5110605_014",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "根本沒這回事。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n諾維姆，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳為何對我抱有這樣的期望啊？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "因為你",
    "voice": "vo_adv_5110605_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是我的搭檔，一定要很強才行啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啊，尾狗刀！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "看前面！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "看前面！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "當本大爺的對手可不能大意啊！",
    "voice": "vo_adv_5110605_016",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n得手了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唔",
    "voice": "vo_adv_5110605_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊！？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "很好！",
    "voice": "vo_adv_5110605_018",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這拳打得響亮……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "唔呃！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂！",
    "voice": "vo_adv_5110605_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你對我的搭檔做什麼啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這是……",
    "voice": "vo_adv_5110605_020",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "為什……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "麼啊……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好痛好痛……",
    "voice": "vo_adv_5110605_021",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n他從背後成功地突襲了我呢。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啊，",
    "voice": "vo_adv_5110605_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "糟了……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我不小心就……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n呃、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "大吾這傢伙",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "昏死過去了……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "怎麼辦……？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_5110605_023",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "大吾剛才說了，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們兩人聯手也沒關係，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以是他自己太大意了呢。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n並不是我們的錯吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就、",
    "voice": "vo_adv_5110605_024",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就是說啊……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n總之……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們趕緊……",
    "voice": "vo_adv_5110605_025",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "逃離這裡吧！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆與尾狗刀丟下昏過去的大吾，一溜煙地逃離了現場。",
    "voice": null,
    "unit_id": null
  }
]
