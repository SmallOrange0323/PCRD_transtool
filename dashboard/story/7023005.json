    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": "vo_adv_7023005_065",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我已經是英雄了嗎！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以……",
    "voice": "vo_adv_7023005_066",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
