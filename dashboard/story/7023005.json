    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以先當朋友嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "下次碰到需要幫助的人，我們可以一起去幫忙。",
