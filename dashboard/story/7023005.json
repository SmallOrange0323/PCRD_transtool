    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你們都還好嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "剛剛",
    "voice": "vo_adv_7023005_060",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那是……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "夢嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n感覺好像和記憶有關聯……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼了？",
    "voice": "vo_adv_7023005_061",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "剛才的夢",
    "voice": "vo_adv_7023005_062",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "讓我……",
