    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "察覺到了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "日和，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳已經沒必要努力當上英雄了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯嗯，",
    "voice": "vo_adv_7023005_063",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我繼續做自己就行了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對啊！",
    "voice": "vo_adv_7023005_064",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "繼續做自己就好！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n幫助大家、為大家打氣，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也算是一個英雄該做的事。",
