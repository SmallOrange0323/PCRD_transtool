[
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和倭一起離開魔物的賭場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n外面",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "已經看不到追兵的身影了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "怎麼了小子，",
    "voice": "vo_adv_1300003_000",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "表情看起來很暢快呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "爆冷門中獎就這麼讓你開心嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……啊？",
    "voice": "vo_adv_1300003_001",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不是？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n追兵已經不在了可以回去了？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n──你啊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "怎麼還沒睡就在說夢話。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你看。",
    "voice": "vo_adv_1300003_002",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n多虧了你我的荷包滿滿的呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "在它變成隔夜錢之前，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "都拿去花掉吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "花掉了再去賺回來就好啦♪",
    "voice": "vo_adv_1300003_003",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──決定了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "好了走吧！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被倭拉著手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到的地方是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n夜晚的熱鬧酒館。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──",
    "voice": "vo_adv_1300003_004",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呼哈。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "果然別有一番風味呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n用義弟賺的錢喝的葡萄酒。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是啊，",
    "voice": "vo_adv_1300003_005",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這種時候就要豪爽一點吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子也大口喝下吧！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……怎麼了，",
    "voice": "vo_adv_1300003_006",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你怕了嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "別擔心，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你的杯子裡裝的，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n是小孩子也能喝的能量果汁。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來，",
    "voice": "vo_adv_1300003_007",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你稍微舔看看。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對吧？",
    "voice": "vo_adv_1300003_008",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我就覺得很適合你。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n想喝多少就喝多少。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哼哼♪",
    "voice": "vo_adv_1300003_009",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "欸小子，",
    "voice": "vo_adv_1300003_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不覺得只是一直喝太無趣了嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n餘興節目……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "雖然是沒到這麼盛大……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來拼酒吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你跟我一起。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "別擔心，",
    "voice": "vo_adv_1300003_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我喝葡萄酒，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子喝果汁。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰比較有利一目瞭然吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "規則很簡單。",
    "voice": "vo_adv_1300003_012",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喝了多少杯，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就能問對方多少問題。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "被提問的人，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不管是什麼問題都得回答。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喝得越多真實的自己就越會展露出來，",
    "voice": "vo_adv_1300003_013",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n是可以了解對方的方法。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你應該",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不會拒絕挑戰……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那麼，",
    "voice": "vo_adv_1300003_014",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就馬上開始……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──你",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "已經喝完第一杯了！？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈，",
    "voice": "vo_adv_1300003_015",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真不錯。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我不討厭喝得快的男人。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "沒有禁忌。",
    "voice": "vo_adv_1300003_016",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不管多大膽的問題我都會回答。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想問什麼就問吧！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喜歡的食物是……",
    "voice": "vo_adv_1300003_017",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "葡萄酒、",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "香露，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "和八鹽折。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你說那是飲品？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對我來說這些是我的汽油啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就像是主食一樣的東西。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "因為固態食物的能量太少了。",
    "voice": "vo_adv_1300003_018",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "若菜的咖哩？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "美中不足的是一個禮拜會出現好幾次。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──嗯，",
    "voice": "vo_adv_1300003_019",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不過那個啊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "跟喜歡還是討厭沒有關係啦。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "雖然盜賊也沒分什麼假日……",
    "voice": "vo_adv_1300003_020",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我想想，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喝個酒睡個午覺……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再看看天空吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……雲朵的形狀，",
    "voice": "vo_adv_1300003_021",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "意外的很有趣喔。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n沒辦法預測接下來會變成什麼形狀不是嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是有來搭訕的傢伙啦……",
    "voice": "vo_adv_1300003_022",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但每個都是，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不超過三天就放棄了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "只有剛開始的時候很有氣勢──",
    "voice": "vo_adv_1300003_023",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "打從一開始就不可能跟得上我的節奏。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "為什麼男人，",
    "voice": "vo_adv_1300003_024",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "都莫名的喜歡較勁呢？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……所以像你這樣的人，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "才反而讓我感到新鮮吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈哈哈！",
    "voice": "vo_adv_1300003_025",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那就換我了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這次輪到我來發問囉。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "聽好了小子。",
    "voice": "vo_adv_1300003_026",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n看著我的眼睛回答。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "老實說……",
    "voice": "vo_adv_1300003_027",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "若菜和布武機，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哪一個是你的菜？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "原來如此。",
