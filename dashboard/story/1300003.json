    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不過……",
    "voice": "vo_adv_1300003_030",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "倒是專情到無可救藥。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n是只要牽起一次的手，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "直到地獄的盡頭都不會放開的類型。",
