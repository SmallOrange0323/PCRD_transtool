    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "話說在前頭，",
    "voice": "vo_adv_1300003_029",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "可沒有比若菜更麻煩的女人了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "身為姊姊的我這麼說的話可是不會錯的。",
