    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……不過，",
    "voice": "vo_adv_1300003_032",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那傢伙看起來那樣但其實也有冷漠的一面。",
