  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "如果你喜歡這種類型的話，",
