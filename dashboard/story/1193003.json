    "words": "似乎都能迎接一個美好的聖誕節，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n真是太好了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啥！？",
    "voice": "vo_adv_1193003_058",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥現在向我道謝，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n待會就很難把禮物送出去了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "話雖這麼說！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃，",
    "voice": "vo_adv_1193003_059",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是要送給你的聖誕禮物，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有手套、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "圍巾、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "毛帽、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "肚圍、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "襪子……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n然後還有……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我編織了很多件喔！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "與其說我編織了很多件……",
    "voice": "vo_adv_1193003_060",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不如說當我一回過神，就發現完成品已經堆成一座小山了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_1193003_061",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為有確實量過尺寸後才開始編織，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我想應該會很合身。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你不用擔心！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果可以的話，",
    "voice": "vo_adv_1193003_062",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "希望你能試穿看看。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n雖說我在編織時就認為會很適合你，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我還是想看看",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你實際穿戴起來的樣子。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "尺寸",
    "voice": "vo_adv_1193003_063",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "合身嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太好了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "無論是顏色還是花樣，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都很適合你呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我這做妹妹的很會挑選吧。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "連我自己都覺得自己做得很好！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "老實說，",
    "voice": "vo_adv_1193003_064",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我真的很想",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一直和哥哥在一起……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但這並不容易。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我才會想說為你編織這些服飾，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n讓你穿在身上，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "代替我陪伴在你身邊！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我編織的服飾不只這些，",
    "voice": "vo_adv_1193003_065",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你全部都要收下喔，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n打工時",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "若能穿得暖和點，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣肯定",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就不會感冒了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還有……",
    "voice": "vo_adv_1193003_066",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你在打工時，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n若能不經意地",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "想到我，那就更好了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……你願意",
    "voice": "vo_adv_1193003_067",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "穿戴這些嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好的！",
    "voice": "vo_adv_1193003_068",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "明年我會替你",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "編織更多件的！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……呃，",
    "voice": "vo_adv_1193003_069",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我好像操之過急了吧？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "俗話有說，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如意算盤不要打稻草嘛……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "明年",
    "voice": "vo_adv_1193003_070",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真想來",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "挑戰一下兩人的同款服飾……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣我就得再好好專研一下編織了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哇啊，",
    "voice": "vo_adv_1193003_071",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你在做什麼啊，哥哥……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "突然摸了我的頭。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "先前暫時保留的獎勵吧？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "除了那個之外，",
    "voice": "vo_adv_1193003_072",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還有我送禮物給那孩子的事也……？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以，你的手不知不覺地就動了起來。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這都是因為有哥哥的協助……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我能夠為她編織那麼多件禮物，",
    "voice": "vo_adv_1193003_073",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是、",
    "voice": "vo_adv_1193003_074",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "被你這麼稱攢，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總覺得怪不好意思的。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，我很高興你這麼做！",
    "voice": "vo_adv_1193003_075",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你的手不想停下來也沒有關係！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我反倒非常歡迎呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是的，",
    "voice": "vo_adv_1193003_076",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請盡情摸我的頭吧，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥♪",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能夠",
    "voice": "vo_adv_1193003_077",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這棵聖誕樹下，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "把禮物送給哥哥，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我真的非常開心。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "和哥哥一起找到、",
    "voice": "vo_adv_1193003_078",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起裝飾的這棵聖誕樹，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "看起來特別漂亮呢！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果可以像這樣",
    "voice": "vo_adv_1193003_079",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一直和哥哥待在一起就好了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n至少",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在這時候就好好享受一下兩人時光，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
