  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣就來得及送禮物了！",
