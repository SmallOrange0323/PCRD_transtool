    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "一再重新來過，最後順利完成編織，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "\\n都是因為有璃乃姐姐和",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "大哥哥的鼓勵！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你們這麼說也對。",
    "voice": "vo_adv_1193003_006",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，我認為最重要的是，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n大家都有著",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一份想送禮給某人的真誠心意！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為某人準備禮物，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是件很棒的事！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好了，",
    "voice": "vo_adv_1193003_007",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再來就只要把禮物包裝好",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "送出去囉。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n俗話說結果好，沒事就好。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們就在這裡解散！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "各位，",
    "voice": "vo_adv_1193003_008",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一定要確實地把禮物送出去喔──！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "璃乃老師，",
    "voice": "vo_adv_1193003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "非常謝謝妳！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不客氣──！",
    "voice": "vo_adv_1193003_010",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n回家的路上也請多小心！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………咦？",
    "voice": "vo_adv_1193003_011",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我不是說解散了嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n大家不回去嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "嗯！",
    "voice": "vo_adv_1193003_012",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "那個，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "因為大家",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "想要回個禮",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
