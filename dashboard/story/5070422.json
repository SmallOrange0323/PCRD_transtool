  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您終於完成了啊……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和暑假第一天相比，",
    "voice": "vo_adv_5070422_002",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟的神色簡直判若兩人……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "雖然我無法理解為什麼要有作業這種東西，",
    "voice": "vo_adv_5070422_003",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但出人意料地還不錯呢……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要能為弟弟帶來幫助，",
    "voice": "vo_adv_5070422_004",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就沒有什麼東西是不好的！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然都順利寫完作業了……",
    "voice": "vo_adv_5070422_005",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "接下來就",
    "voice": "vo_adv_5070422_006",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "盡情地寵溺弟弟吧！",
    "voice": null,
    "unit_id": 117111
