[
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "看來又是那隻可恨的魔物在作亂呢，",
    "voice": "vo_adv_5142204_000",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們該做的就是再次打倒牠。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "無論幾次、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "幾次、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "又幾次……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來吧真琴，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們趕快去找出那傢伙吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "交給我吧！",
    "voice": "vo_adv_5142204_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n只要有獸人族的嗅覺，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "像那種大體型的魔物，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n一～下就能找到了！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5142204_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是太棒了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我一直很希望",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "能有獸人族的嗅覺，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "要是有那種能力，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "採集藥草時應該也會更有效率的……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_5142204_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這麼說來",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在想要的藥草剛好也在這附近，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然來了就順便處理。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真琴，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請妳稍微來這邊一下……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我、",
    "voice": "vo_adv_5142204_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我是可以幫忙啦……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但現在應該要先打倒魔物吧──？",
    "voice": null,
    "unit_id": 129811
  }
]
