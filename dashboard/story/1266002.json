[
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在豔陽高照的夏日午後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n似似花跟{0}來到位於大間海邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n十分有名的店家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "總算到了呢。",
    "voice": "vo_adv_1266002_000",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這間",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是默默在美食家之間成為話題的店家啊。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "享受美食",
    "voice": "vo_adv_1266002_001",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也算是",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很棒的夏日回憶。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n對於隸屬【美食殿堂】的你而言，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就更不用說了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我剛剛",
    "voice": "vo_adv_1266002_002",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "才吃過金槍鮪，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以就不點餐了……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但你正處在發育期，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "應該還吃得下吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以說，",
    "voice": "vo_adv_1266002_003",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這一餐由我請客，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你可以盡量點喜歡的東西。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……不過我也很好奇味道如何，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就分我嘗一口吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "歡迎光臨。",
    "voice": "vo_adv_1266002_004",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我們的料理每一道都很好吃，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n但我最推薦的",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是烤玉米跟章魚燒。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "客人只要點自己喜歡的就好……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "咦，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳是……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這位粉色頭髮的大姐！",
    "voice": "vo_adv_1266002_005",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳就是傳聞中，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那位願意聽任何祕密的人……！？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……如果我說是，",
    "voice": "vo_adv_1266002_006",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那又怎麼樣？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "其實，",
    "voice": "vo_adv_1266002_007",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我有一個想吐露的祕密……！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……唉。",
    "voice": "vo_adv_1266002_008",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我要到何時才能好好享受假期呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……不過",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "算了，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你就說來聽聽吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那個……",
    "voice": "vo_adv_1266002_009",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "雖然有點難以啟齒……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n但我的哥哥",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是大間黑手黨的成員……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……大間黑手黨，",
    "voice": "vo_adv_1266002_010",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "簡單來說，",
    "voice": "vo_adv_1266002_011",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是主要在大間近海一帶，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n靠非法捕魚來賺錢的一群人。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是的，",
    "voice": "vo_adv_1266002_012",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳說的沒錯……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "自從數年前哥哥加入黑手黨後，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n就一直在幫他們非法捕魚。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我一直想阻止哥哥繼續做這種事，",
    "voice": "vo_adv_1266002_013",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但卻無法找任何人商量……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我到底",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "該怎麼做才好……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……真是的，",
    "voice": "vo_adv_1266002_014",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我就知道你會這麼說。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "既然如此，那也不能放著不管呢。",
    "voice": "vo_adv_1266002_015",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真拿你沒轍，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就由我們來想辦法吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真、",
    "voice": "vo_adv_1266002_016",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "謝謝你們！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "background",
    "bg_id": "502010"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1266002_017",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛才提到的大間黑手黨應該就在這附近……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……啊啊，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來就是對面那位男性呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "嘿嘿，",
    "voice": "vo_adv_1266002_018",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "大豐收、大豐收",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "呀……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "要是能把這些鮑魚賣到蘭德索爾，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "就可以大賺一筆了說……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──飽和之光。",
    "voice": "vo_adv_1266002_019",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "嗚喔喔",
    "voice": "vo_adv_1266002_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "喔喔喔！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是的，",
    "voice": "vo_adv_1266002_021",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再弱也該有個限度。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來或許根本不需要我親自出手。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……不過，",
    "voice": "vo_adv_1266002_022",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大間黑手黨還真是學不乖呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "明明我已經",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "把走私到蘭德索爾的管道給徹底封鎖了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "……妳、",
    "voice": "vo_adv_1266002_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "妳封鎖了走私管道……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "難不成，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "那位貴族大叔被逮捕的原因……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是啊，",
    "voice": "vo_adv_1266002_024",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是你想的那樣。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我參與了那起事件的幕後工作。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "之前，",
    "voice": "vo_adv_1266002_025",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在蘭德索爾的市場上，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n流通著大量來自大間的非法漁獲。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "其中有一位貴族，",
    "voice": "vo_adv_1266002_026",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "涉入了非法漁獲的交易。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他收下賄賂，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "下令放過非法漁獲的走私。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而我揭穿了這個祕密……",
    "voice": "vo_adv_1266002_027",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就是",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那位貴族的貪污行為。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "最終，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他被追究罪責，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "並進了大牢裡。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "因為這個緣故，",
    "voice": "vo_adv_1266002_028",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我們無法再走私非法漁獲到蘭德索爾……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "導致大間黑手黨的收入大減……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "遭受嚴重打擊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "如今夥伴也變少了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "真的有夠慘。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "所以，",
    "voice": "vo_adv_1266002_029",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我們決定要報仇！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……要報仇",
    "voice": "vo_adv_1266002_030",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "是啊，",
    "voice": "vo_adv_1266002_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "……喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "妳知道對我們黑手黨而言，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "最重要的是什麼嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──是面子，",
    "voice": "vo_adv_1266002_032",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "正是如此！",
    "voice": "vo_adv_1266002_033",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "要是就這樣忍氣吞聲，那還算什麼黑手黨。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我也看不慣至今為止享受著走私漁獲好處的蘭德索爾人，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n擺出一副完全事不關己的樣子。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "要問錢從哪來？",
    "voice": "vo_adv_1266002_034",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我們從你們身上賺了大把的錢，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "現在還剩很多呢！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我的夥伴",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "現在，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "正用那筆錢包下一台飛空艇。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "……看來你們猜不到",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我們打算做什麼呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "我想也是呢！",
    "voice": "vo_adv_1266002_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "不過我就特別告訴你們吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n我們要使用飛空艇，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "從蘭德索爾的上方空投魔物跟詛咒道具！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "從空中進攻的話，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "【王宮騎士團】也無法阻擋！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……要是放著不管，",
    "voice": "vo_adv_1266002_036",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "肯定會造成巨大的損害呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……你們打算在什麼時候",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "執行這項襲擊計畫？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "馬上就要執行了，",
    "voice": "vo_adv_1266002_037",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "所以我才會跟你們說。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n因為不管你們怎麼做，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "都不可能阻止這項計畫！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……他是這樣說的。",
    "voice": "vo_adv_1266002_038",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你打算怎麼做？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……原來如此，",
    "voice": "vo_adv_1266002_039",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這就是你的決定嗎。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼我就助你一臂之力吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "哈，",
    "voice": "vo_adv_1266002_040",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "你們想做什麼都是沒用的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n想想這裡離蘭德索爾有多遠吧，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "你們絕對趕不上的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這可未必。",
    "voice": "vo_adv_1266002_041",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "希望你不要太小看我呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒錯，",
    "voice": "vo_adv_1266002_042",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好比說，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只要讓我的分身像這樣子變化──",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "什、",
    "voice": "vo_adv_1266002_043",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "人類",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "變成了飛空艇……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "\\n怎麼可能有這種蠢事……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只要坐上這個，",
    "voice": "vo_adv_1266002_044",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或許就來得及阻止你們襲擊蘭德索爾。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們就早點解決那愚蠢的計畫，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在那之後就來好好享受假期吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──啊啊，",
    "voice": "vo_adv_1266002_045",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對了對了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "姑且還是跟你說一下。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你的弟弟他說，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "希望你不要再繼續非法捕魚了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他似乎每天都很擔心你。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過，",
    "voice": "vo_adv_1266002_046",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他也不需要再擔心了呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "既然我出手了，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你們的組織就會在今天瓦解。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你也就無法繼續從事非法捕魚了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "妳、",
    "voice": "vo_adv_1266002_047",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大間黑手黨",
    "words": "妳這個怪物……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我就當作你在稱讚我吧。",
    "voice": "vo_adv_1266002_048",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與其在這邊繼續嘴上逞強，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還不如趕快準備去找新的工作。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1266002_049",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就出發吧，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "去拯救蘭德索爾。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "background",
    "bg_id": "501150"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "雖然是很小型的飛空艇，",
    "voice": "vo_adv_1266002_050",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但搭乘起來還蠻舒服的吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在追上黑手黨之前，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你就好好享受這趟天空之旅吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……雖然我很想這麼說，",
    "voice": "vo_adv_1266002_051",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但碰上了一點問題。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在風勢不夠，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "導致飛行速度不如預期。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣下去有可能無法趕上襲擊計畫。",
    "voice": "vo_adv_1266002_052",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "到時候",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就會變成單純的空中遊覽呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也不介意就是。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……風勢變強了呢。",
    "voice": "vo_adv_1266002_053",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你用公主騎士的力量，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "強化了在大氣中掌管風的精靈嗎。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在的速度不錯，",
    "voice": "vo_adv_1266002_054",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這樣應該可以追上大間黑手黨。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n看來你已經能夠活用自己的能力了，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "值得讚賞。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……可以看見黑手黨的飛空艇了。",
    "voice": "vo_adv_1266002_055",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n雖然蘭德索爾已經近在眼前，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但總算是勉強趕上了呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1266002_056",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "雖然光靠我一個人就綽綽有餘了，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但為了能夠瞬間解決對方，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是準備幫手吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒錯──",
    "voice": "vo_adv_1266002_057",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是我……",
    "voice": "vo_adv_1266002_058",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還有我。",
    "voice": "vo_adv_1266002_059",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒有比我更可靠的幫手了吧？",
    "voice": "vo_adv_1266002_060",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……已經追上對方的飛空艇，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要跳過去了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "黑手黨1",
    "words": "嗚哇，",
    "voice": "vo_adv_1266002_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨1",
    "words": "你們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨1",
    "words": "是誰啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨1",
    "words": "\\n難道不知道我們是大間黑手黨嗎……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "閉上嘴。",
    "voice": "vo_adv_1266002_062",
    "unit_id": 126611
  },
  {
    "type": "background",
    "bg_id": "501150"
  },
  {
    "type": "dialogue",
    "name": "黑手黨1",
    "words": "哇啊啊啊！？",
    "voice": "vo_adv_1266002_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨2",
    "words": "可惡，",
    "voice": "vo_adv_1266002_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨2",
    "words": "兄弟們！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨2",
    "words": "快點給我打趴他們！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑手黨2",
    "words": "\\n就算叫出魔物也無所謂！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真受不了……",
    "voice": "vo_adv_1266002_065",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "希望至少能稍微取悅我呢。",
    "voice": "vo_adv_1266002_066",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，請幫我們強化吧。",
    "voice": "vo_adv_1266002_067",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……就讓你們體會一下，",
    "voice": "vo_adv_1266002_068",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n七冠的恐怖之處吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而後似似花與分身協力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在轉眼之間便壓制了大間黑手黨的飛空艇。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "──感謝你們",
    "voice": "vo_adv_1266002_069",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "協助逮捕大間黑手黨。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n要是他們的計畫真的執行了，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "蘭德索爾不知道會變成什麼樣子。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "我們已經著手處理",
    "voice": "vo_adv_1266002_070",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "魔物跟詛咒道具，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "還請你們放心。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "請容我先行告辭。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "多虧了我才能拯救蘭德索爾呢。",
    "voice": "vo_adv_1266002_071",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過對方比想像的還弱，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "讓我有點掃興就是了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……總之，",
    "voice": "vo_adv_1266002_072",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "終於能好好享受假期──",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──",
    "voice": "vo_adv_1266002_073",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗚……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──感覺，",
    "voice": "vo_adv_1266002_074",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有點頭暈……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……回想起來，",
    "voice": "vo_adv_1266002_075",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n原本是為了消除繁忙工作的疲勞，才規劃了這次假期……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "結果別說休息了，",
    "voice": "vo_adv_1266002_076",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "除了島鯨，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再加上這次的事件，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我一直都在忙著處理事情呢……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以現在……",
    "voice": "vo_adv_1266002_077",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "才會覺得累了……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花突然倒下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}為了幫助似似花，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便以公主抱的方式將她抱起，急忙送到醫院去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": " ",
    "voice": null,
    "unit_id": null
  }
]
