[
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜和祈梨正在帕菲之城的城前廣場上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與5.5周年的魔物對峙中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊！",
    "voice": "vo_adv_9007009_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5.5～！",
    "voice": "vo_adv_9007009_001",
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈哈！",
    "voice": "vo_adv_9007009_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "太窩囊了啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拿出更多鬥志來──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5",
    "voice": "vo_adv_9007009_003",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": ".",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呀、",
    "voice": "vo_adv_9007009_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呀啊啊……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n魔物都陷進牆壁裡了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n嘉夜夜",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "完全進入打手模式了～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_9007009_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒那回事啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我只是讓它變得安分點而已。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳看！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "確實抓到它了啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟這隻魔物的精力莫名地旺盛，",
    "voice": "vo_adv_9007009_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "能抓到它是很好。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是嘉夜夜，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳不會也點太過鬥志高昂了嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯～",
    "voice": "vo_adv_9007009_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "聽妳這麼一點，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像真的有？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n可能是因為好久沒打得這麼爽快了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟最近都沒打架啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說得也是……",
    "voice": "vo_adv_9007009_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟自從來到這個世界後，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就沒遇到什麼好事情啊。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "尤其是前陣子那件事！",
    "voice": "vo_adv_9007009_009",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n沒想到會被龍人族的同族給抓住，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n還被迫穿上超變態的女僕裝來打掃！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那件事我們也有錯啊……",
    "voice": "vo_adv_9007009_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳已經清楚知道那並不是超變態女僕裝了吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過……",
    "voice": "vo_adv_9007009_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也不想",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n再做那種難為情的打扮了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜也一樣覺得很難為情不是嗎──！",
    "voice": "vo_adv_9007009_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那果然是超變態女僕裝！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是的。",
    "voice": "vo_adv_9007009_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n麻煩妳們別再胡言亂語了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸？",
    "voice": "vo_adv_9007009_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個聲音是……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我可不允許妳們侮辱",
    "voice": "vo_adv_9007009_015",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n萊拉耶爾殿下準備的女僕裝。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊！",
    "voice": "vo_adv_9007009_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我記得妳是……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "烏爾姆？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我是琳德。",
    "voice": "vo_adv_9007009_017",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "雖說是雙胞胎，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n但居然把我和那個儀容不整的妹妹認錯，太讓人傷心了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳們好，",
    "voice": "vo_adv_9007009_018",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我是儀容不整的妹妹。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈……",
    "voice": "vo_adv_9007009_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳們還是老樣子呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天怎麼了？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳們也來捕捉魔物的嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……唔。",
    "voice": "vo_adv_9007009_020",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那",
    "voice": "vo_adv_9007009_021",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "個……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯？",
    "voice": "vo_adv_9007009_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳們是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n琳德好像心情不太好……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎",
    "voice": "vo_adv_9007009_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎怎、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎樣！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳們該不會",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "又對我們有什麼意見吧～！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "被妳說對了，",
    "voice": "vo_adv_9007009_024",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳們看，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那邊的城牆。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "城牆～？",
    "voice": "vo_adv_9007009_025",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "剛才嘉夜夜把魔物打飛，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n把牆壁撞破了一個洞，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那有怎樣了──",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "啊啊！？",
    "voice": "vo_adv_9007009_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "總算察覺到了？",
    "voice": "vo_adv_9007009_027",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n如果多了一個這麼大的入口，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "感覺會讓守衛的工作倍增呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的……！",
    "voice": "vo_adv_9007009_028",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳們光是把城內搞得亂七八糟還不夠，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "竟然還學不會教訓嗎！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_9007009_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這不是故意的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n是嘉夜夜打架打得太開心，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有～點鬧過頭了而已！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔、",
    "voice": "vo_adv_9007009_030",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "藉口太爛了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n完全沒有可以辯解的餘地……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的很抱歉！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……她們是這樣說的，姊姊。",
    "voice": "vo_adv_9007009_031",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "她們也沒有惡意吧？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "就算如此，",
    "voice": "vo_adv_9007009_032",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也不能輕易原諒妳們。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
