[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ほらチエルって",
    "voice": "vo_adv_6023209_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "可愛いアイドルちゃんすこすこじゃないですかぁ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nもう最近はプロデューサー目線の妄想ごっこが",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "捗るんですよねぇ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "先輩がうちのギルドをデビューさせるとしたら",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "センターは誰にします？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "でしょうね。",
    "voice": "vo_adv_6023209_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ええまあ１０人に聞いたら９人はそう答えますよね。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そっかー、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "先輩は残り１人の感性持ちだと思ったんだけどなぁ……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ま、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "べつに推すのは自由ですよ？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ガチ恋だけ勘弁してもらえれば。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "愛想悪い系センターか……",
    "voice": "vo_adv_6023209_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "世界観持ってる風でわりと良きかも。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nあの人運動神経いいから、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "パフォーマンスはキレキレだろうし。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "問題は当人の意思だけど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そこはまあ札束で引っぱたきましょう。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "それな。",
    "voice": "vo_adv_6023209_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ミニマムっ娘を軸にするパティーン。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あると思います。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "チエルとクロエ先輩が身長同じぐらいだから、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "並びが綺麗ですよね。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "問題はユニ先輩の体力面か……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "え、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あの子、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ダンスとか出来ます？",
    "voice": null,
    "unit_id": 110911
  }
]
