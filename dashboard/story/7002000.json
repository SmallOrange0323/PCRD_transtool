  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇啊啊，",
    "voice": "vo_adv_7002000_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好大啊——♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還是第一次見到……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "露娜之塔嗎……",
    "voice": "vo_adv_7002000_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還真是來到了一個不得了的地方了呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以，",
    "voice": "vo_adv_7002000_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你的記憶關鍵就在那裡了是嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？　",
    "voice": "vo_adv_7002000_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許？　",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不清不楚的……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哎，",
    "voice": "vo_adv_7002000_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不是這樣啊！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這時候應該說",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就交給我們來吧才對啊—！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是的，",
    "voice": "vo_adv_7002000_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我真傻……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這裡可是有找回他喪失記憶的線索呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n一直以來",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "如此照顧這麼怕生的我，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "必需要好好報答才是！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "唔唔。",
    "voice": "vo_adv_7002000_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可是，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "完全沒有把心意好好傳達給他……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "…………",
    "voice": "vo_adv_7002000_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": "vo_adv_7002000_008",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺得到妳幹勁十足呢♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "希望這次的冒險，",
    "voice": "vo_adv_7002000_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊能夠好好地",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n把一直以來",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感謝的心意",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "傳達給哥哥知道！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好——",
    "voice": "vo_adv_7002000_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一起加油吧，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還有姊姊！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要是能有一場驚險萬分的冒險",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就太好了呢♪",
    "voice": null,
    "unit_id": 100611
  }
