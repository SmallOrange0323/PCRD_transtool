    "words": "不久之前，",
    "voice": "vo_adv_1807001_054",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也才剛有人對我說過，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n「妳身體不好，不可以太亂來」這類的話……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天我也得",
    "voice": "vo_adv_1807001_055",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好好留意身體的狀況，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不能給姊姊他們添麻煩。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我說，",
    "voice": "vo_adv_1807001_056",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}啊。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你覺得如何？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喜歡",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們的祕密湖泊嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今天很謝謝你陪我們一起來！",
    "voice": "vo_adv_1807001_057",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為看到小栞沒精神的樣子，我很擔心，",
    "voice": "vo_adv_1807001_058",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要是今天的野餐行可以讓她打起精神來，那就太好了～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "話說回來，",
    "voice": "vo_adv_1807001_059",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我自己也很久沒有過來這裡了。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這裡可是因體弱多病而長期臥床的小栞，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n第一次表示自己想要親自來一趟，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "很重要很重要的地方呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，",
    "voice": "vo_adv_1807001_060",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是說啊！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這裡是世界第一的好地方",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呢！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對吧，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哎呀！",
    "voice": "vo_adv_1807001_061",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不、",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不要突然從後面抱住人啦……！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚇了我一跳……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈，",
    "voice": "vo_adv_1807001_062",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嚇到妳了嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真是的，",
    "voice": "vo_adv_1807001_063",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣對心臟很不好呢，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉抱歉。",
    "voice": "vo_adv_1807001_064",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "誰叫小栞一個人站著發呆嘛～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我只是想起了以前的事。",
    "voice": "vo_adv_1807001_065",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n今天的景色，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也像那時候一樣……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很漂亮呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是啊！",
    "voice": "vo_adv_1807001_066",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好了，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今天是難得的野餐行！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我們來編花環吧，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就像那時候一樣！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "姊姊我",
    "voice": "vo_adv_1807001_067",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "會幫小栞編一副",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "最適合小栞的漂亮花環喔～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……姊姊，",
    "voice": "vo_adv_1807001_068",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那時候的花環，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是我編給妳的喔。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈～！",
    "voice": "vo_adv_1807001_069",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊雖然有心想要自己編，",
    "voice": "vo_adv_1807001_070",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "最後卻「果然還是太難了～！」",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "地喊著，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "結果，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "把採來的花朵",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "撒成花瓣雨了不是嗎？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n……那也",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很漂亮呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真不愧是小栞，",
    "voice": "vo_adv_1807001_071",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "記性真好。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我都快沒了姊姊的威嚴啦！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞不就成了姊姊了……！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過小栞當姊姊……",
    "voice": "vo_adv_1807001_072",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "感覺好像也不能說是不好不是嗎……！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳在說什麼啊……",
    "voice": "vo_adv_1807001_073",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我的姊姊",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就只有初音姊姊一個人",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而已。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喔～",
    "voice": "vo_adv_1807001_074",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這真是令人開心的發言呢，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我的好妹妹……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我的寶貝妹妹",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也只有",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞一個人喔～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "等一下，",
    "voice": "vo_adv_1807001_075",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊……！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n妳這樣一直摸我的頭，頭髮會亂掉的……！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈，",
    "voice": "vo_adv_1807001_076",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉抱歉！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝你！",
    "voice": "vo_adv_1807001_077",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n難得來到這裡，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就讓我們好好享受一場快樂的野餐吧♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好啦，",
    "voice": "vo_adv_1807001_078",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞也是，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "笑一個笑一個！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯……！",
    "voice": "vo_adv_1807001_079",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在一如既往的美麗景色之中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人就這樣開開心心地享受著野餐的樂趣。",
    "voice": null,
    "unit_id": null
  }
]
