    "type": "dialogue",
    "name": "栞",
    "words": "竟然帶了那麼多東西……！",
    "voice": "vo_adv_1807001_008",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "幫我們背了這麼重的行李。",
