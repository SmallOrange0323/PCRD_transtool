[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在街上偶遇的茜里與{0}，\\n被突如其來的光芒包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呀！",
    "voice": "vo_adv_1006008_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這、這是什麼！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": "vo_adv_1006008_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里覺得怪怪的……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n已、已經……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不行了――！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……呼。",
    "voice": "vo_adv_1006008_002",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "完全不行……",
    "voice": "vo_adv_1006008_003",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這樣下去的話，我就糟糕了……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，哥哥！",
    "voice": "vo_adv_1006008_004",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你好，真是巧呢。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為見到哥哥了，茜里終於有精神了呢 ♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸！？",
    "voice": "vo_adv_1006008_005",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……嘻嘻，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n任何事都會被哥哥看透呢。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "其實……這次因為社團活動",
    "voice": "vo_adv_1006008_006",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里要參加遊樂園的儀隊演奏……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以我一直在練習，",
    "voice": "vo_adv_1006008_007",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是怎麼樣都吹不好……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有了！",
    "voice": "vo_adv_1006008_008",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里現在來試吹一曲，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥要告訴我感想喔！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇！謝謝哥哥！",
    "voice": "vo_adv_1006008_009",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不愧是哥哥！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "只要告訴我感想就好了。",
    "voice": "vo_adv_1006008_010",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為茜里一直都是自己一個人在練習，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n自己也不知道吹得好不好……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒有哥哥就搞不定。",
    "voice": "vo_adv_1006008_011",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯？拜託啦。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，茜里馬上吹囉？",
    "voice": "vo_adv_1006008_012",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "怎、怎麼樣……？",
    "voice": "vo_adv_1006008_013",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我吹得好嗎……？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真的嗎？",
    "voice": "vo_adv_1006008_014",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太好了！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……嘿嘿。",
    "voice": "vo_adv_1006008_015",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里只要想到是為了哥哥吹的，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就能比平時更加輕鬆地演奏。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "正、正式演奏時是在大庭廣眾面前……",
    "voice": "vo_adv_1006008_016",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里只要一想到被很多不同的人看，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就會開始心跳加速……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "然後茜里就會因為太過緊張，",
    "voice": "vo_adv_1006008_017",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n無法順利演奏。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是，因為被哥哥誇獎了，所以整個都有自信了！",
    "voice": "vo_adv_1006008_018",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里在正式演奏時也會加油喔！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里在正式演奏時也會好好加油的，",
    "voice": "vo_adv_1006008_019",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以哥哥也一定要來聽喔！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "約好囉！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "background",
    "bg_id": "510320"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇～好厲害……人好多……",
    "voice": "vo_adv_1006008_020",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里真的要在這麼多人面前演奏嗎……？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "怎麼辦。差不多要正式演奏了，茜里卻開始緊張起來……",
    "voice": "vo_adv_1006008_021",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n已經跟哥哥講好要加油的說……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊！",
    "voice": "vo_adv_1006008_022",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n那個是……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥——哥！",
    "voice": "vo_adv_1006008_023",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥按照約定來了呢。",
    "voice": "vo_adv_1006008_024",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里好高興……！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥要盡情享受喔？",
    "voice": "vo_adv_1006008_025",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也會遵守約定好好加油的！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，差不多要開始了……",
    "voice": "vo_adv_1006008_026",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不趕快去不行。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，哥哥，等會見！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "still",
    "still_id": "100600801"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "開、開始了……",
    "voice": "vo_adv_1006008_027",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": " 怎麼辦……茜里還是會緊張呢！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗚……人這麼多……",
    "voice": "vo_adv_1006008_028",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n如果在這種地方演奏的話，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里覺得怪怪的啊～",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……啊！這附近，剛剛的……",
    "voice": "vo_adv_1006008_029",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n也就是說……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "果然！是哥哥！",
    "voice": "vo_adv_1006008_030",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有好好地在看我呢～♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦？身體突然不僵硬了……？",
    "voice": "vo_adv_1006008_031",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n緊張感也不見了。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510321"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥！",
    "voice": "vo_adv_1006008_032",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里做到了呦！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "謝謝哥哥 ♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那個……",
    "voice": "vo_adv_1006008_033",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里到了正式演出時",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n果然還是很緊張……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是茜里一看到哥哥，",
    "voice": "vo_adv_1006008_034",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就覺得非常非常放心！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以茜里能順利演奏",
    "voice": "vo_adv_1006008_035",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n都是多虧了哥哥喔！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真的非常謝謝哥哥！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！你做了個好「夢」嗎？",
    "voice": "vo_adv_1006008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照你跟茜里以前的記憶\\n創造出來的「夢」，",
    "voice": "vo_adv_1006008_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "原來現在的你會採取這樣的行動啊。",
    "voice": null,
    "unit_id": 190011
  },
