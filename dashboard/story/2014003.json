  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "希望她不要太逞強了就好。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯，",
    "voice": "vo_adv_2014003_040",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有啥事呢？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳是！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "日安，真陽。",
    "voice": "vo_adv_2014003_041",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "總是承蒙妳的關照了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈。",
    "voice": "vo_adv_2014003_042",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鄭重的問候就讓我們先放一旁吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難民一個接一個聚集到這，我們已經快處理不過來了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n希望妳能稍微幫一下手呀。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好的。",
    "voice": "vo_adv_2014003_043",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我本來就是為了這件事來提案的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n僅管狀況很艱困，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但還是讓我們同心協力，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "度過這個難關吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好咧來吧！",
    "voice": "vo_adv_2014003_044",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "畢竟太陽下山以後就什麼都不好辦了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n在那之前就讓我們盡量把問題都整理好吧，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "各位！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好～。",
    "voice": "vo_adv_2014003_045",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是我，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不躲起來沒關係嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n大家都是被魔物追著才逃到這邊來的對吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我不會嚇到他們嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯。",
    "voice": "vo_adv_2014003_046",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然我也希望可以沒問題，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但如果真造成騷動了的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "對雙方來講都不怎麼愉快嘛。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然有點抱歉，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但能不能麻煩莉瑪莉瑪妳負責可以在屋內做的工作呢？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯。",
    "voice": "vo_adv_2014003_047",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "包在我身上，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要是我能夠做到的，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我一定會盡全力幫忙的！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算是我，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也想幫上大家的忙嘛♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說啊，",
    "voice": "vo_adv_2014003_048",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果人手不夠的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要不然也讓我們幫點忙嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也要幫……",
    "voice": "vo_adv_2014003_049",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈啾！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈～啾！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈啊～啾！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……我說呀。",
    "voice": "vo_adv_2014003_050",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n比起這個，那孩子，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n一直噴嚏連發喔？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感冒了？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可不要傳染給大家了唷？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊。",
    "voice": "vo_adv_2014003_051",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "感冒的話，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我這裡有藥唷……♪",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈嗚，",
    "voice": "vo_adv_2014003_052",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "幫大忙了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我的噴嚏一直停不下來……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是嗎……",
    "voice": "vo_adv_2014003_053",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也和妳一樣。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有著這樣的體質，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n在緊急的時候，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都會拖累到大家，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後非常不好意思呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "體質？　",
    "voice": "vo_adv_2014003_054",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是喔！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我只是今天，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n剛好一直打噴嚏打個不停而已～……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈～啾！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是因為急急忙忙爬上山，",
    "voice": "vo_adv_2014003_055",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以累壞了嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天妳就先找個睡袋鑽進去，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好好休息一下比較好喔？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊嗚嗚……",
    "voice": "vo_adv_2014003_056",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可是嘉夜夜要幫大家的忙對吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我也要一起幫忙唷。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n明明嘉夜夜還忙著做事情，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就只有我一個人在睡覺，我可不要。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔喔～",
    "voice": "vo_adv_2014003_057",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果能幫忙的話這邊可是太歡迎了唷！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "俗話說日行一善",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好人有好報嘛～♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "――哇啊啊～～！！",
    "voice": "vo_adv_2014003_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大、",
    "voice": "vo_adv_2014003_059",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐大小姐大小姐～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n糟糟糟糟糟糟糕了呀～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓！",
    "voice": "vo_adv_2014003_060",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難不成有魔物出沒嗎！？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不、",
    "voice": "vo_adv_2014003_061",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不對，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然也對就是了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總而言之那個！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請看看那個呀～！",
    "voice": null,
    "unit_id": 102511
