    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳一個人逃到這裡的嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不是喔。",
    "voice": "vo_adv_2014003_022",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個呀，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "原本正在祭典上的攤販幫忙……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n然後魔物先生們，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "突然開始到處搗亂。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美就和一起幫忙的茉莉，",
    "voice": "vo_adv_2014003_023",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n還有真陽姊姊她們一起……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一起加油跑了起來。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "注意到的時候，美美",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "就已經在這裡了。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "為什麼",
    "voice": "vo_adv_2014003_024",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "會變成這樣子呢？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "明明就是開開心心的祭典日呀～？",
