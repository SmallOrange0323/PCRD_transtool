  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在{0}等人，在王都蘭德索爾\\n和霸瞳皇帝揭開了決戰的序幕時，另一方面……",
    "voice": null,
    "unit_id": null
  },
