  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看得到嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n只要能走那裡，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該就安全了才對。",
