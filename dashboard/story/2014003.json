    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這些孩子們都沒有受傷，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "該說是不幸中的大幸了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……城裡，",
    "voice": "vo_adv_2014003_015",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒問題吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他們幾個人，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n沒有被捲進",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
