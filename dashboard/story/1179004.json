    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要不要拍張照片？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們兩人的合照♪",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難得一起過萬聖節嘛！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來！",
    "voice": "vo_adv_1179004_063",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "再靠近一點啦！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "離那麼遠",
