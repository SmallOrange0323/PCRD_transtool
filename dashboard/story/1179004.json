    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "緊張嘛～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好了嗎？",
    "voice": "vo_adv_1179004_066",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要拍囉～？",
