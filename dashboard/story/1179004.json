    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然要拍合照，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n還是貼在一起會比較好看啦♪",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈！",
    "voice": "vo_adv_1179004_065",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才臉都紅了，好好笑～♪",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你幹嘛這麼",
