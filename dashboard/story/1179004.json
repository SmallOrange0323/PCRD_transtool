    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會自己得出答案的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在那之前，",
    "voice": "vo_adv_1179004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就好好陪在她身邊幫助她吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "秀才♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "505032"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯嗯……",
