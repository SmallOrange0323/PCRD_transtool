[
  {
    "type": "background",
    "bg_id": "500740"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "存知のとおり、",
    "voice": "vo_adv_6023307_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくは外出というものを好まない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n反して、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君は意欲的に",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "方々へ出向いているらしいじゃないか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この引きこもりの知的好奇心を",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "くすぐるスポットはないものかね。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "海水浴場か……",
    "voice": "vo_adv_6023307_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "率直に言ってまるで惹かれないが、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "山育ちの身ゆえ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "後学のためにも一度ぐらいは",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "訪れておくべきか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "しかし、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あの水着とかいう破廉恥な衣装は……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "うぬぬぬ……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おお、",
    "voice": "vo_adv_6023307_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "聞いたことがある。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "トーゴク情緒あふれる粋な街らしいな。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "しかし",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "極東の文化というのはどうなのだ……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "腐った大豆や魚の死骸、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n何にでもびちゃびちゃソイソースをかけて食すと言うぞ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ううむ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "象牙の塔？　",
    "voice": "vo_adv_6023307_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あの、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "希少な古文書がわんさか眠っているという？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nよし行こう……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "って、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ソレここの図書館棟ー！　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "じゃないんだよ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n知的なぼくに",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "生涯初のノリツッコミをさせるんじゃあないよ。",
    "voice": null,
    "unit_id": 111011
  }
]
