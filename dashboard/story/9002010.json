  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "手裡拿著神祕書本、來到【哞哞自衛隊】公會小屋的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴，",
    "voice": "vo_adv_9002010_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "接下來",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "穿這件。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "放過我吧公主。",
    "voice": "vo_adv_9002010_001",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不是說好只穿一件嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_9002010_002",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家有說",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那種話嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說不定是因為真琴",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "太可愛了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n所以人家才忘記了呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "再說就算不是我也沒關係吧，",
    "voice": "vo_adv_9002010_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那邊不也剛好有個人在嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "給我等一下。",
    "voice": "vo_adv_9002010_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是在說我嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說的也是呢。",
    "voice": "vo_adv_9002010_005",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n霞要不要也",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "偶爾試穿看看",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可愛的洋裝呀？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可愛的洋裝我已經穿得太多了呢。",
    "voice": "vo_adv_9002010_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這次就容我婉拒了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
    "voice": "vo_adv_9002010_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我倒是沒見妳穿過",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "像是公主一樣輕飄飄的衣服呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦！？",
    "voice": "vo_adv_9002010_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不是，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "糟了，",
    "voice": "vo_adv_9002010_009",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "腦中立刻浮現出魔法少女的裝扮了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒錯！",
    "voice": "vo_adv_9002010_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "說的好呢助手先生！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n因為我覺得日常的服裝是最可愛的唷！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……嗯、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "什麼時候來的？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "糟糕了！",
    "voice": "vo_adv_9002010_011",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說起來",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天是",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生來的日子呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "慘了，",
    "voice": "vo_adv_9002010_012",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "完全忘記了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "已經準備完成了吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是啊，",
    "voice": "vo_adv_9002010_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現在大概在香織的房間。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我去看一下吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "手忙腳亂的",
    "voice": "vo_adv_9002010_014",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真不好意思呢，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "再",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "稍等一下唷。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗨──呵！",
    "voice": "vo_adv_9002010_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我拿過來了唷，",
    "voice": "vo_adv_9002010_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "公會長。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝妳們",
    "voice": "vo_adv_9002010_017",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "兩位。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請將你手上的那本書",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "借給人家。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "把這個這樣～",
    "voice": "vo_adv_9002010_018",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可愛的書本完成了呀。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "下一個收件人也已經記錄好了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一路小心。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可不要繞去奇怪的地方啊。",
    "voice": "vo_adv_9002010_019",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "請小心",
    "voice": "vo_adv_9002010_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不要迷路了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "加油嘿──！",
    "voice": "vo_adv_9002010_021",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【哞哞自衛隊】目送中離去的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n邁步出發前往下一個目的地。",
    "voice": null,
    "unit_id": null
  }
]
