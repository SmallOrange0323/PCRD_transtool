    "type": "dialogue",
    "name": "智",
    "words": "那就……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "像這樣",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "緊緊抱著……",
    "voice": null,
    "unit_id": 103711
  },
  {
