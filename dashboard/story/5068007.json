[
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧一行人回收了失去行動能力的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n玩具王與「大家的玩具好朋友」後，再次回到了工廠。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "──如此這般，",
    "voice": "vo_adv_5068007_000",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n玩具好朋友們也在",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "用盡了能量後四散開來，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n恢復成原來的模樣了。",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只是身上多了點傷……",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "嗯嗯。",
    "voice": "vo_adv_5068007_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "那1000隻的「玩具王二世」",
    "voice": "vo_adv_5068007_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "也是這樣啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "真是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "辛苦大家了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王在最後一刻說，",
    "voice": "vo_adv_5068007_003",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "它終於回想起什麼是真正的友情了……",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "應該不會再次暴走了。",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "玩具王……",
    "voice": "vo_adv_5068007_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "真是對不起啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n要是我有在你被送來時",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "就馬上修理你……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "你現在",
    "voice": "vo_adv_5068007_005",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "本該比任何玩具都還善良純粹的……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n在你因為孤獨",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "而產生意識之前，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n就已經擁有一顆",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "愛著孩子們的心了吧……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我接收到",
    "voice": "vo_adv_5068007_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "你的心願囉。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我們會比過去",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "更加賣力地，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "為了孩子們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "也為了玩具們努力……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "…………",
    "voice": "vo_adv_5068007_007",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "玩具王……",
    "voice": "vo_adv_5068007_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "儘管",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "兜兜轉轉了這麼一大圈……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n我們會依照你主人的意願，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "將你捐贈至孤兒院等機構。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "回收下來的1000隻二世們，",
    "voice": "vo_adv_5068007_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n也會等修理完畢後",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "再送回購買的孩子們手中。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "碧，",
    "voice": "vo_adv_5068007_010",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "工廠就如妳所見平安無事喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在馬上就能開始修理玩具王們喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當然，",
    "voice": "vo_adv_5068007_011",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "「大家的玩具好朋友」們也是喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n它們的小主人們都",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "等著它們回去呢喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝、",
    "voice": "vo_adv_5068007_012",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝謝妳……！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "那麼，",
    "voice": "vo_adv_5068007_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "馬上就來開始修理吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "……我",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "是很想這麼說，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "但碧小妹的打工期限已經沒剩下幾天了吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "剩下的幾天時間應該沒辦法全部修完，",
    "voice": "vo_adv_5068007_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "但還是拜託妳啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "妳離開之後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我們會負起責任",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "把剩餘的玩具通通修好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "妳就放心吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_5068007_015",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n關於這件事……",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請讓我也一起參與到最後！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "咦？",
    "voice": "vo_adv_5068007_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "可、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "可是……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "妳的打工期限就快……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "既然如此，",
    "voice": "vo_adv_5068007_017",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能不能夠延長期限呢……？",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果不行的話，",
    "voice": "vo_adv_5068007_018",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我願意無償工作，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想負責到最後一刻！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我已經",
    "voice": "vo_adv_5068007_019",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和玩具王和好了，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要是現在就回森林去，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對我而言就像是背叛了它。",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那將會是",
    "voice": "vo_adv_5068007_020",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "最讓玩具王難過的事。",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我不想讓他",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "再次承受這種悲傷……",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且，",
    "voice": "vo_adv_5068007_021",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「大家的玩具好朋友」們，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也是我重要的……",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以拜託你了！",
    "voice": "vo_adv_5068007_022",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請讓我做完修理的工作吧！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n如果無償工作也不行的話，",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就算是要我倒貼錢也沒問題……！",
    "voice": null,
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "嗯嗯！",
    "voice": "vo_adv_5068007_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "就幫妳延長期限吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n當然，我一樣會付妳薪水！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "而且會提高時薪！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "哎呀～",
    "voice": "vo_adv_5068007_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "有碧小妹這樣的員工真是太好了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "那",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "就再多拜託妳",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "一段時間囉！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好的！",
    "voice": "vo_adv_5068007_025",
    "unit_id": 116712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可靠的人手能留下來，真是幫大忙了。",
    "voice": "vo_adv_5068007_026",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "畢竟，",
    "voice": "vo_adv_5068007_027",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們得一口氣修理一堆玩具嘛。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "少了小碧，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們的效率會大幅下降呢。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希，",
    "voice": "vo_adv_5068007_028",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那妳打算怎麼樣呢？",
    "voice": null,
    "unit_id": 116911
