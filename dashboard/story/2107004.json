  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "跟鏡華道別後的雪菲和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又繼續採購了好一陣子……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯……",
    "voice": "vo_adv_2107004_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n{0}",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "到底跑到哪裡去了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……真是的。",
    "voice": "vo_adv_2107004_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "他只要在街道上稍微逛一下，就很容易被捲入麻煩，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n要不就是會有女孩子喊住他。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖說他應該不會走遠，",
    "voice": "vo_adv_2107004_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還是有可能會遭到敵人的襲擊，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我得趕緊跟他會合才行──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯～～！",
    "voice": "vo_adv_2107004_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我回來囉，蘭德索爾！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n感覺好像很久沒回來了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好啦。",
    "voice": "vo_adv_2107004_004",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然還有東西要送，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那就先來",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "找【破曉之星】那些人吧……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "之後也要去",
    "voice": "vo_adv_2107004_005",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "【王宮騎士團】露個面！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "搞不好尾狗刀已經回來了呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n好──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──呀啊！",
    "voice": "vo_adv_2107004_006",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊，",
    "voice": "vo_adv_2107004_007",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對不起！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我沒有注意看路……！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗚、",
    "voice": "vo_adv_2107004_008",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳",
    "voice": "vo_adv_2107004_009",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒事吧！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像撞到了頭……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚嗚……",
    "voice": "vo_adv_2107004_010",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚、",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚……",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啥！？",
    "voice": "vo_adv_2107004_011",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n喂、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "剛剛撞那一下，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有痛到想哭的程度嗎……？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──嗚啊啊～！！！",
    "voice": "vo_adv_2107004_012",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "葛～～格～～！！",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔哇哇啊！？！？",
    "voice": "vo_adv_2107004_013",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n妳、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳到底怎麼了？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n竟然哭得像小嬰兒一樣──！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "難道是",
    "voice": "vo_adv_2107004_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "腦袋被撞壞了！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n話說回來，葛格是誰啊──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我聽到了哭聲和",
    "voice": "vo_adv_2107004_015",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "深感困擾的聲音！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請等等，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我馬上就過去──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔……",
    "voice": "vo_adv_2107004_016",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哎呀！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳是……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊！",
    "voice": "vo_adv_2107004_017",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是妳！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳是",
    "voice": "vo_adv_2107004_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "矛依未……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼雪菲也在啊！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚啊啊～！",
    "voice": "vo_adv_2107004_019",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "日和～！",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔哇！",
    "voice": "vo_adv_2107004_020",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雪菲又變成小嬰兒了──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "日和，",
    "voice": "vo_adv_2107004_021",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳認識這傢伙！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "太好了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "拜託妳幫幫我吧──！！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……原來如此，",
    "voice": "vo_adv_2107004_022",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "矛依未妳",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在找尾狗刀啊。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們也沒看到他……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真抱歉。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯，",
    "voice": "vo_adv_2107004_023",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然還是沒有線索啊──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……話說回來……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "涅比──♪♪",
    "voice": "vo_adv_2107004_024",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呀啊啊───！！",
    "voice": "vo_adv_2107004_025",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n妳別過來啊，笨蛋────！！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……那個，",
    "voice": "vo_adv_2107004_026",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放著她不管好嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊哈哈……",
    "voice": "vo_adv_2107004_027",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n雪菲好像",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為撞到頭的衝擊，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "又變成小嬰兒了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n其實她是個既聰明又溫柔的女孩子喔。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總之，",
    "voice": "vo_adv_2107004_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一段時間後她就會恢復了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生和可可蘿他們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也會回來，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請放心吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想不到【美食殿堂】有了新成員加入，",
    "voice": "vo_adv_2107004_029",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n而且還是這樣的傢伙啊──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊，",
    "voice": "vo_adv_2107004_030",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對了對了。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們有跟",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "克莉絲提娜進行交易對吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是啊。",
    "voice": "vo_adv_2107004_031",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n矛依未",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼會知道？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為我有跟她碰到面。",
    "voice": "vo_adv_2107004_032",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "她託我幫忙送東西過來。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要我把這個交給你們。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_2107004_033",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是索爾魔珠！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來啊，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "克莉絲小姐這麼快就找到了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n矛依未也謝謝妳喔──",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……嗯……",
    "voice": "vo_adv_2107004_034",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n嗯嗯～～～～～",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_2107004_035",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "矛依未妳是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "帶這個來給我們的吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃、",
    "voice": "vo_adv_2107004_036",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是這樣沒錯啦。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不知怎麼搞的，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "到了最後一刻卻很難爽快地交出來。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……因為這是以前，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "跟妳們相互爭奪到那般地步的索爾魔珠呢……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃，",
    "voice": "vo_adv_2107004_037",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "矛依未……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊……",
    "voice": "vo_adv_2107004_038",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我從剛剛",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就很想跟妳說了。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可以的話，不要叫我矛依未……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "能改叫我諾維姆的話，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會很高興的。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為我喜歡聽到",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家叫我這個名字。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": "vo_adv_2107004_039",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n說得、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也是……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n真抱歉，諾維姆！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿，",
    "voice": "vo_adv_2107004_040",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n雖然我也已經很習慣被叫錯了……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但聽到妳叫我「矛依未」，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就覺得渾身不自在。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆、",
    "voice": "vo_adv_2107004_041",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺用這個名字叫妳更貼切呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "另外……",
    "voice": "vo_adv_2107004_042",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳剛剛",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像有提到說，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n妳跟我們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有互相爭奪過索爾魔珠，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "什麼意思啊……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……呃……",
    "voice": "vo_adv_2107004_043",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我接下來可能會問些奇怪的問題，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳不要笑我喔。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "still",
    "still_id": "210700401"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我說妳啊，",
    "voice": "vo_adv_2107004_044",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "該不會……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n已經有找回一些",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那邊世界的記憶了……？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……！",
    "voice": "vo_adv_2107004_045",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "難不成",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳知道些什麼嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也一直很在意某件事……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什、",
    "voice": "vo_adv_2107004_046",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼事啊！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃、",
    "voice": "vo_adv_2107004_047",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這事說來有點奇怪，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n希望妳別笑我……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那就是──所謂的「現實」",
    "voice": "vo_adv_2107004_048",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個世界，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是否真的存在呢……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "still",
    "still_id": "210700402"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔喔！",
    "voice": "vo_adv_2107004_049",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n日和，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳已經恢復記憶了嗎……！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_2107004_050",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我並沒有完全想起來！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像是菲歐",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓我們在夢裡看到了另一個世界，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n用這種方式告訴我們的……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "菲歐！",
    "voice": "vo_adv_2107004_051",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n原來如此，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那傢伙也還活著啊……！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我還以為她可能已經消失不見了呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦！？",
    "voice": "vo_adv_2107004_052",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n可能已經消失了，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這是什麼意思……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯，",
    "voice": "vo_adv_2107004_053",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這件事",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "說來話長……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個世界原本是由",
    "voice": "vo_adv_2107004_054",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶他們七冠所創造出來的",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "虛擬世界。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n而且跟「現實」的世界是連結在一起的。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_2107004_055",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "先前發生了「事件」，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "導致這個連結被切斷。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個時候，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "世界又重新被創造了一次。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦、",
    "voice": "vo_adv_2107004_056",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦咦……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "世界是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以被這樣",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "創造來又創造去的嗎……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊──嗯，",
    "voice": "vo_adv_2107004_057",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算我現在告訴妳有關網路或遊戲的話題，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n大概也摸不著頭緒……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總之，希望妳能先接受這說法。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n真對不起，我不太會解釋。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "關於這些事，妳再去請教晶或似似花吧。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "接著，",
    "voice": "vo_adv_2107004_058",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在「重新創造前的世界」中，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們【破曉之星】和{0}，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n為了阻止真那……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "霸瞳皇帝的野心而與之對抗。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而在戰鬥的最後一刻，",
    "voice": "vo_adv_2107004_059",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n菲歐她應該是",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "犧牲自己……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "救了你們吧。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳說，",
    "voice": "vo_adv_2107004_060",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "應該？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_2107004_061",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "老實說，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我當時並沒有在現場。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為晶設法想駭進去救你們……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只是",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在附近看到的。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也只知道片段而已。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是、",
    "voice": "vo_adv_2107004_062",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是這樣啊……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_2107004_063",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為這樣，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我就對草野優衣……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n對優衣",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "起了疑心。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "明明像她那麼溫柔的人，",
    "voice": "vo_adv_2107004_064",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該不可能……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會做這樣的事。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n切斷阿斯特朗世界和「現實」的連結，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "把大家都囚禁在虛擬世界……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那個優衣，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不可能做得出這種事吧……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣……",
    "voice": "vo_adv_2107004_065",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n啊……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "菲歐也對",
    "voice": "vo_adv_2107004_066",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣的事非常在意喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是，怜和我",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都完全不了解",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "她為何會那麼在意。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……而且菲歐她，",
    "voice": "vo_adv_2107004_067",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "已經不再是我們所認識的那個菲歐了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n雖然很想再跟她問一些事，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但她卻好像已經消失了……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆，",
    "voice": "vo_adv_2107004_068",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "拜託妳了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n希望妳能告訴我",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳所知道的事。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣她到底發生了什麼事？",
    "voice": "vo_adv_2107004_069",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "究竟該怎麼做才好？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不管是「以前的世界」",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是「現實」……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我都想",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "把事情弄清楚！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……嗯……",
    "voice": "vo_adv_2107004_070",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我剛才也說過，",
    "voice": "vo_adv_2107004_071",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我並不知道全部的真相。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_2107004_072",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這是很重要的事。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果妳信得過我，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "希望妳能聽進去。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這是我的請求。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "…………但是……",
    "voice": "vo_adv_2107004_073",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是？",
    "voice": "vo_adv_2107004_074",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我想，",
    "voice": "vo_adv_2107004_075",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這件事……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n對妳和怜來說，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很可能……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也是件很痛苦的事。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……即便如此，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳還是願意聽嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "…………",
    "voice": "vo_adv_2107004_076",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……嗯。",
    "voice": "vo_adv_2107004_077",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆既然都這麼說了，",
    "voice": "vo_adv_2107004_078",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我想這肯定",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是一件很痛苦的事。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但正因為這樣，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我更不想逃避，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "而是想好好去面對！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……呵呵。",
    "voice": "vo_adv_2107004_079",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n妳真的",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一點都沒變呢。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不管遇到什麼事，總是鼓足勇氣，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "以樂觀積極的態度來面對……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯。",
    "voice": "vo_adv_2107004_080",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我就告訴妳吧。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "把我所知道的事，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "全都說出來──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "…………",
    "voice": "vo_adv_2107004_081",
    "unit_id": 106412
  }
]
