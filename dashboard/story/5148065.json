    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這很不妙吧？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "蘭法小姐雖然嚇到了，",
    "voice": "vo_adv_5148065_001",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "美空小姐卻在笑呢……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n該說您真的很厲害嗎，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "十分臨危不亂呢。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "還好啦～",
    "voice": "vo_adv_5148065_002",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "難得有機會遇到，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我還想是不是應該把它射下來比較好啊～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不過我被蘭法姐阻止了就是。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那樣",
    "voice": "vo_adv_5148065_003",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我們應該能獲得",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n新的科技之類的？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "雖然我不是很喜歡實驗，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是我有好奇心啊。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小美空，",
    "voice": "vo_adv_5148065_004",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "妳過激的地方跑出來了喔～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n要是發展成跟UFO的戰鬥，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就不妙了啊～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n要叫姐姐來，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "用不妙對抗不妙才行啊～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那可能會是危及蘭德索爾存亡的危機呢。",
    "voice": "vo_adv_5148065_005",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n有蘭法小姐在",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真是太好了……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是說，",
    "voice": "vo_adv_5148065_006",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "飄浮在空中的……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是小優花梨吧？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n她好像被UFO吸走了～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是的……",
    "voice": "vo_adv_5148065_007",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我很在意她之後的狀況。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n優花梨小姐",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有平安回來嗎……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "她看起來很有精神喔★",
    "voice": "vo_adv_5148065_008",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "她說她覺得輕飄飄的呢～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n臉也有點紅，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "講話也口齒不清。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊～",
    "voice": "vo_adv_5148065_009",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n那完全就是被改造了啊～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個，",
    "voice": "vo_adv_5148065_010",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個的原因應該是麥酒吧？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看來是平常的優花梨小姐，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "讓我放心了。",
    "voice": null,
    "unit_id": 131611
  },
