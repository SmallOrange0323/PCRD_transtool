  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒什麼啦！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "應該說～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "剛好那個時候口很渴，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "又是空腹的狀態下",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n一口氣乾杯才會",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "變成那樣……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那種事情我怎麼可能辦得到！？",
    "voice": "vo_adv_7014003_022",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n真的讓人很在意呀，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "優花梨小姐",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "實際上究竟是一個什麼樣的大人。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "剛剛那個罐頭也是，",
    "voice": "vo_adv_7014003_023",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n應該就是優花梨小姐妳平常在吃的食物吧？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呃、",
    "voice": "vo_adv_7014003_024",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那是、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………",
    "voice": "vo_adv_7014003_025",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "…………",
    "voice": "vo_adv_7014003_026",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也就是說",
    "voice": "vo_adv_7014003_027",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "優花梨小姐妳並不是我理想中的成熟淑女",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n而是行為亂七八糟會說奇怪的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n還會沒有規矩隨處睡著的那種人嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我、",
    "voice": "vo_adv_7014003_028",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我並不是每次都這樣！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n只是偶爾有時候會變成那個樣子而已……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的嗎？",
    "voice": "vo_adv_7014003_029",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……對不起。",
    "voice": "vo_adv_7014003_030",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "其實我每次到最後都會變成那樣……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唉……",
    "voice": "vo_adv_7014003_031",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "糟透了。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n本來還以為自己終於遇到了一位了不起的淑女……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是夠了！　",
    "voice": "vo_adv_7014003_032",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這個塔、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就由我這個成熟淑女",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n獨自登頂好了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你們就在這裡等著吧！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那我就先走囉！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "拜拜！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "美、",
    "voice": "vo_adv_7014003_033",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "美咲！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n妳等一下～！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美咲就這樣不顧優花梨的呼喊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一個人小跑步不斷地往前跑去。",
    "voice": null,
    "unit_id": null
  }
]
