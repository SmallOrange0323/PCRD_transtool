    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這也、",
    "voice": null,
    "unit_id": 105811
