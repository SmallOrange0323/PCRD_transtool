    "name": "禰羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "僅能循著因緣，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "將意念傳達。",
    "voice": null,
    "unit_id": 129731
  },
  {
