    "name": "禰羅",
    "words": "不。",
    "voice": "vo_adv_1233011_063",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n現正處於如此危難之中，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n可無暇嬉鬧──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "間隔世界之牆變得薄弱",
    "voice": "vo_adv_1233011_064",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "的報告，",
    "voice": null,
    "unit_id": 129731
