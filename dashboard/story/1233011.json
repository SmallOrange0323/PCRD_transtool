    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "乃再再構築所產生異常，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n則於夢中徘徊之際，",
    "voice": null,
    "unit_id": 129731
  },
