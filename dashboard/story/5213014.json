[
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "…………",
    "voice": "vo_adv_5213014_000",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n……",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "嗯……",
    "voice": "vo_adv_5213014_001",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "嗯。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "梅莉莎大人……",
    "voice": "vo_adv_5213014_002",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "一直在沉睡著……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n真希望她能醒過來哈尼……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "騎士大人！",
    "voice": "vo_adv_5213014_003",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "你、",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "你是來做什麼的？",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "咦……？",
    "voice": "vo_adv_5213014_004",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "飯糰……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "哈尼？",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "…",
    "voice": "vo_adv_5213014_005",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "…嗚嗚。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n竟然連我們這樣的人，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "你都願意送來慰勞品……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n騎士大人，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "真的很對不起哈尼……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "還有……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "謝謝你們讓梅莉莎大人活了下來。",
    "voice": "vo_adv_5213014_006",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "很感謝你們哈尼。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "那個啊……",
    "voice": "vo_adv_5213014_007",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "雖然你可能不會相信。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n真正的梅莉莎",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "其實沒有這麼誇張哈尼。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "啊……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "不過她本來也是有點誇張啦哈尼……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "但是，",
    "voice": "vo_adv_5213014_008",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "她其實也有溫柔的一面，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n是個很重視朋友的女孩……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "她曾經是我",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "最喜歡的朋友。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "她總是說，",
    "voice": "vo_adv_5213014_009",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "必須成為出色的女王蜂。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n一直都很努力。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "就在那個時候……",
    "voice": "vo_adv_5213014_010",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "從天空傳來聲音。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "大概……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n是從非常遙遠的地方傳來的。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "我們，",
    "voice": "vo_adv_5213014_011",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "聽見了那個聲音。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "然後呢，",
    "voice": "vo_adv_5213014_012",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "從聽到那個聲音的隔天開始，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "我和梅莉莎大人，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n好像莫名其妙得到了亂七八糟的力量……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "梅莉莎大人想著，",
    "voice": "vo_adv_5213014_013",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "甚至能夠取得超越吉歐‧格黑納，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n不同世界的一切力量哈尼。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n她想建立一個更加龐大的蜂群……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "總之……",
    "voice": "vo_adv_5213014_014",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "獲得那股力量之後的梅莉莎大人，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n認為自己必須變得冷酷無情才能統治國家。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "但是呢，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "她卻始終無法真正變得無情。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "所以梅莉莎大人，",
    "voice": "vo_adv_5213014_015",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n自己喝下了「蜜糖陷阱」哈尼。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "嗯，",
    "voice": "vo_adv_5213014_016",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "一直都是哈尼。",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n只是用毒來欺騙自己，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "假裝成一個可怕的自己……",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "其實她本質上是非常溫柔的，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "是我唯一的朋──",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "朋──",
    "voice": "vo_adv_5213014_017",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "什麼？",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "哇呀啊！！",
    "voice": "vo_adv_5213014_018",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n對不起梅莉莎大人，",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "我要接受懲罰哈尼！",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "請踩我！",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "拜託踩我～！",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "唉……",
    "voice": "vo_adv_5213014_019",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "別相信這傢伙說的話。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "話說你這人，",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "到底是來做什麼的？",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "是來看我狼狽的樣子，特地跑來嘲笑我的嗎？",
    "voice": "vo_adv_5213014_020",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "呀哈哈，",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "品味真差～",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "……",
    "voice": "vo_adv_5213014_021",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n沒什麼，",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咕嚕嚕嚕嚕……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "……唔！？",
    "voice": "vo_adv_5213014_022",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "剛、",
    "voice": "vo_adv_5213014_023",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "剛剛那個",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "才不是我呢。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "哈尼哈尼。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "是、",
    "voice": "vo_adv_5213014_024",
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "是啊哈尼！",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "\\n",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "哈尼哈尼",
    "words": "剛剛那是我肚子叫了哈尼！",
    "voice": null,
    "unit_id": 20111
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "……咦。",
    "voice": "vo_adv_5213014_025",
    "unit_id": 20011
  },
  {
    "type": "still",
    "still_id": "521301401"
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "這……",
    "voice": "vo_adv_5213014_026",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "這是什麼啊。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n看起來真寒酸。",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "我……",
    "voice": "vo_adv_5213014_027",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "我才不需要呢──",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "我早上是吐司派的。",
    "voice": "vo_adv_5213014_028",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n米飯這種東西，跟蜂蜜也不搭啦──",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "而且……",
    "voice": "vo_adv_5213014_029",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "要是被下了毒，",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n那可不是開玩笑的──",
    "voice": null,
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "你、",
    "voice": "vo_adv_5213014_030",
    "unit_id": 20011
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "你很囉嗦耶。",
    "voice": null,
