[
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5108301_000",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跑到旅館外面了……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n帆稀、",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "深月，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "得攔住神明大人才行……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊，",
    "voice": "vo_adv_5108301_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "否則連大江戶町也會出大事的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……而且，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這間旅館",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還沒能滿足祂呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵呵♪",
    "voice": "vo_adv_5108301_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n那麼兩位，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "現在是款待的時間囉。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "用我們飽含真心的款待",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "來滿足溫泉之神吧～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不能讓祂將罪惡與汙穢帶到明年。",
    "voice": "vo_adv_5108301_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我們來清洗乾淨吧……！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵♪",
    "voice": "vo_adv_5108301_004",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n帆稀和深月",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都已經對旅館的工作得心應手了呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我也會",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "以誠心誠意接待客人的♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "陽卵旅館的各位！",
    "voice": "vo_adv_5108301_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n以小老闆娘",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "帆稀之名……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──大家一起",
    "voice": "vo_adv_5108301_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "迎接愉快的新年吧～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "遵命！",
    "voice": "vo_adv_5108301_007",
    "unit_id": null
  }
]
