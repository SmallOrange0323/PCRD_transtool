    "type": "dialogue",
    "name": "真琴",
    "words": "你！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然現在說已經遲了……",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但是你絕對",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不要跟優衣說今天的事喔！！",
