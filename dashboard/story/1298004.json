    "name": "真琴",
    "words": "……嗯？",
    "voice": "vo_adv_1298004_025",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你好像把餅乾搗好了呢。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這樣的話，",
