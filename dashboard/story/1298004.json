[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真琴和{0}結束與魔物們的激戰，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到了蘭德索爾。而後真琴似乎很難為情地，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n提及了剛剛安博等人所說的約會一事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊──",
    "voice": "vo_adv_1298004_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n剛剛",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓你配合新人們的奇怪興致，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱歉了啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的……",
    "voice": "vo_adv_1298004_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "佐藤她們喜歡談戀愛話題這點讓人很困擾啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我跟你明明就",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不可能……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "去約會什麼的啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……算了，",
    "voice": "vo_adv_1298004_002",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不說那個了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "必須",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "感謝你幫我擊退魔物才行呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "等一下你要是有空，",
    "voice": "vo_adv_1298004_003",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就順便",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "來我家一趟吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我會做你想吃的東西給你♪",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……你說很期待我的料理？",
    "voice": "vo_adv_1298004_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可以好好期待喔？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n因為我已經大致知道你偏好的調味了！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……嗯？",
    "voice": "vo_adv_1298004_005",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你是",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼回事？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總覺得你在發光耶……？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你果然",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓人搞不懂……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說有事找我商量……",
    "voice": "vo_adv_1298004_006",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到底是什麼啊？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我想你八成是找錯商量的對象",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "了喔。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……你說作為平日的謝禮，",
    "voice": "vo_adv_1298004_007",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n要送點心給優衣當禮物！？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "說的好！",
    "voice": "vo_adv_1298004_008",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我對你",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "刮目相看了喔！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n想送禮物就代表",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你在意優衣對吧！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "夥伴……",
    "voice": "vo_adv_1298004_009",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "算了，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不管怎樣都好。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這下似乎總算能前進一步了啊……！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "既然要送點心，",
    "voice": "vo_adv_1298004_010",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就必須是特別的東西才行呢。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要做出符合優衣喜好的點心喔！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那種事",
    "voice": "vo_adv_1298004_011",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是理所當然的吧！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n做出滿懷心意的點心交給她吧！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "作法那些全部都由我來教你！",
    "voice": "vo_adv_1298004_012",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n放學後",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就到你家進行特訓吧！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你可別逃跑喔！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好，",
    "voice": "vo_adv_1298004_013",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "買了很多的食材，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都準備好了。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "多虧有我才省下一筆錢，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要感謝我喔？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那種事是常識吧？",
    "voice": "vo_adv_1298004_014",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖說不論是飯還是點心，好吃都是最重要的，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但也不能無視價格啊。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……喔。",
    "voice": "vo_adv_1298004_015",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "比起那種事",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們趕快開始做點心吧。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "still",
    "still_id": "129800401"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": "vo_adv_1298004_016",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "圍裙穿好了呢。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "從現在開始，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就把我當成魔鬼教官吧！！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在你能做出配得上優衣的點心之前，",
    "voice": "vo_adv_1298004_017",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我會徹底地反覆訓練你的！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "給我做好心理準備！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦，",
    "voice": "vo_adv_1298004_018",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很有幹勁嘛。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "值得好好讚許♪",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不必太擔心。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我不會刁難你。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這次",
    "voice": "vo_adv_1298004_019",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要讓你做起司蛋糕。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n難度沒有那麼高，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就算是初學者也很難失敗。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以說，",
    "voice": "vo_adv_1298004_020",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你不要太緊張了啊。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就立刻開始做吧。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "首先，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "從把餅乾搗碎",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "做出基底的部分開始。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊啊，",
    "voice": "vo_adv_1298004_021",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "搗成稍粗一點的碎片就可以了喔。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……話說回來，",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我可以",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "稍微問一下嗎？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你",
    "voice": "vo_adv_1298004_022",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個……",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "跟優衣",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是什麼樣的感覺？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這樣啊這樣啊，",
    "voice": "vo_adv_1298004_023",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯……！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n氣氛感覺相當不賴呢！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼啦！",
    "voice": "vo_adv_1298004_024",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也一起去的話不就白費了嗎！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
