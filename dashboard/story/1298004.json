  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "得要感謝給了你契機的魔鬼教官喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n今後也努力製作點心吧。",
