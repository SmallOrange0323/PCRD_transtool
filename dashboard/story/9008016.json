    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "關於這點我也不是很明白……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "貪吃佩可小姐知道些什麼嗎？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": "vo_adv_9008016_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "完全不知道☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但這樣不是也很好嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n節目最後",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "以一個歡樂的話題收尾了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_9008016_011",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這麼說也是呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "起初聽到這企劃時還不曉得會如何，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "結果現在很有成就感呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。",
    "voice": "vo_adv_9008016_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "擔任廣播節目主播也不壞哪。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且也聽到了許多關於大家的事。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然期間很短暫，",
    "voice": "vo_adv_9008016_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但也留下了很多美好回憶呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "各位聽眾，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一直以來……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝你們的收聽！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500366"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "國營廣播的實驗性節目……",
    "voice": "vo_adv_9008016_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "通稱「蘭德索爾時光」！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "順利落幕囉～～～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "大家辛苦了──♪",
    "voice": "vo_adv_9008016_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "直播都已經結束了，",
    "voice": "vo_adv_9008016_016",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳也可以不用繼續待在「那一邊」了吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──花凜導播？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "──呵呵。",
    "voice": "vo_adv_9008016_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "那麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "就恕我打擾了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
