  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "厄莉絲的修復有了進展，在她甦醒過來的某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}帶著她到城堡外面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_1290002_000",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "………不小心，",
    "voice": "vo_adv_1290002_001",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就忘記了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但城堡外面，",
    "voice": "vo_adv_1290002_002",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是長這樣的呢。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "非常地寬廣……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "明亮。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……騎士先生？",
    "voice": "vo_adv_1290002_003",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n怎麼了嗎，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "突然蹲下來……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "雪……？",
    "voice": "vo_adv_1290002_004",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊……",
    "voice": "vo_adv_1290002_005",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……嗯。",
    "voice": "vo_adv_1290002_006",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n好冰。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……仔細想想。",
    "voice": "vo_adv_1290002_007",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我觸碰「這個世界」物體的次數，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "似乎是屈指可數。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "被幽禁在索爾之塔的時候自是不用說。",
    "voice": "vo_adv_1290002_008",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就連在黑薔薇的城堡中，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我大部分也都在夢中度過。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "外出時，",
    "voice": "vo_adv_1290002_009",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都是以排除礙眼的障礙為目的……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有能夠在意其他事物的從容。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就連──",
    "voice": "vo_adv_1290002_010",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "雪是冰冷的，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣的常識。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我也都沒能親身體會到。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……從容，",
    "voice": "vo_adv_1290002_011",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗎……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要說這是因失去理想鄉而獲得的事物……",
    "voice": "vo_adv_1290002_012",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n還真是不划算呢。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……咦……？",
    "voice": "vo_adv_1290002_013",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "怎、",
    "voice": "vo_adv_1290002_014",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "怎麼",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "回事，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "突然感覺癢癢的──",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "哈啾。",
    "voice": "vo_adv_1290002_015",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_1290002_016",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n剛剛的，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "打噴嚏……",
    "voice": "vo_adv_1290002_017",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………！",
    "voice": "vo_adv_1290002_018",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你、",
    "voice": "vo_adv_1290002_019",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你沒有看到……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我的表情，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對吧？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為，",
    "voice": "vo_adv_1290002_020",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我沒有打過噴嚏……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我想一定，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "露出了奇怪的表情。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所以……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不想要，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "被騎士先生看到……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真的嗎？",
    "voice": "vo_adv_1290002_021",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "既然騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這麼說了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我就相信你。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……啊啊……",
    "voice": "vo_adv_1290002_022",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "被看到了呢……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過……",
    "voice": "vo_adv_1290002_023",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不會奇怪，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "的話……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n那就好……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "了嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "怎麼說，",
    "voice": "vo_adv_1290002_024",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都穿得太少了呢。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n因為一直以來，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都是用魔法來無視冷熱，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n所以不曾在意過氣溫……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "如果有積雪，",
    "voice": "vo_adv_1290002_025",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就表示氣溫也會是低的。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那樣的常識……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我明明就知道才對。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……真是沒必要呢。",
    "voice": "vo_adv_1290002_026",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這種因為寒冷而全身顫抖的從容。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……騎士先生？",
    "voice": "vo_adv_1290002_027",
    "unit_id": 129011
  },
  {
    "type": "still",
    "still_id": "129000201"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……咦……",
    "voice": "vo_adv_1290002_028",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可以嗎……？",
    "voice": "vo_adv_1290002_029",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……謝謝。",
    "voice": "vo_adv_1290002_030",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我就先借用了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "129000202"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不，",
    "voice": "vo_adv_1290002_031",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n……我希望，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "能再這樣待一下。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n多虧了騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我現在也不冷了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……呵呵。",
    "voice": "vo_adv_1290002_032",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "好溫暖。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……外面的世界，",
    "voice": "vo_adv_1290002_033",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真辛苦呢。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n還需要配合天氣和地區去做準備。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不過……",
    "voice": "vo_adv_1290002_034",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n騎士先生你，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "已經習慣這些事了吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n在出發去冒險之前",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都會先採購東西……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗯……",
    "voice": "vo_adv_1290002_035",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我透過記錄，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "看到了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "努力地想做好萬全準備的事，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我都知道喔。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "剛失憶的那時候，",
    "voice": "vo_adv_1290002_036",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "又不一樣就是了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……呵呵，",
