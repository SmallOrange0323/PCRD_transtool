  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n為了實現願望，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我連一秒的時間都無法浪費。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你是說，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我現在能有這樣做的從容了？　",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不對。",
    "voice": "vo_adv_1290002_066",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n與其說是從容，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不如說這是……",
