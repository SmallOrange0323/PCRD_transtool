    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "實在是多到令人煩惱……",
    "voice": "vo_adv_1290002_043",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我會試著，",
