    "name": "大吾",
    "words": "是大吾！！",
    "voice": "vo_adv_5136063_033",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n妳們這倆傢伙不要合唱啊！！！",
