  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我怎麼感覺",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉的臉上常常沾著食物醬汁之類東西……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好痛痛痛！",
    "voice": "vo_adv_5136063_030",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n其實這也是痛處之一啊……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "……啊──",
    "voice": "vo_adv_5136063_031",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我差不多該走了。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n妳們好好相處啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉、日和",
    "words": "等一下啦大門！！",
