[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "人們在蘭德索爾的街道上穿梭不止。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而大吾的身影也在人群之中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "嘖……",
    "voice": "vo_adv_5136063_000",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這一帶",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "也比想像中要來得平靜啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "如果再更亂一點，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "就不缺打架對象了。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "看來是騎士團還是誰把這邊控管得很好啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不過，",
    "voice": "vo_adv_5136063_001",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "找不到打發時間的對手也沒辦法。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n那就沒理由再繼續待在──",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "喂──",
    "voice": "vo_adv_5136063_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大骨～！！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是大吾！！",
    "voice": "vo_adv_5136063_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我還以為是誰，結果是妳啊！",
    "voice": "vo_adv_5136063_004",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n妳在這種地方做啥？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我正在跟人介紹蘭德索爾的街道哦──！",
    "voice": "vo_adv_5136063_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "哦，",
    "voice": "vo_adv_5136063_006",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "還是老樣子在幫助人啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n雖然不知道妳是在跟誰做介紹──",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀呀，",
    "voice": "vo_adv_5136063_007",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n要好好地叫出人家的名字才行哦～？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這個人不叫大骨，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是大酷才對吧♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "都說了我叫大吾啊──！！",
    "voice": "vo_adv_5136063_008",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉抱歉！！",
    "voice": "vo_adv_5136063_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n照著平時對話的感覺就不小心這麼說了♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n啊哈哈哈哈！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣啊，",
    "voice": "vo_adv_5136063_010",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉果然也認識啊？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "認識太吾。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "算是啦♪",
    "voice": "vo_adv_5136063_011",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "為什麼麻煩的傢伙變多了啊……！！",
    "voice": "vo_adv_5136063_012",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "聽好了！！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n本大爺的名字叫大吾，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "大",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "吾！！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不對，",
    "voice": "vo_adv_5136063_013",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "那種事一點都不重要。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "……妳是何方神聖？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n我一看就知道了。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳很強對吧。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯──還滿強的？",
    "voice": "vo_adv_5136063_014",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "如果想知道我的真實身分……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n就等比出個高下之後",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "再說吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "正合我意。",
    "voice": "vo_adv_5136063_015",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n雖然我對妳的真實身分沒什麼興趣……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n不過有架可打",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "那就行了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我想想～",
    "voice": "vo_adv_5136063_016",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我的真實身分說來話長，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n首先要從世界的構成開始……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "結果還是要說啊！",
    "voice": "vo_adv_5136063_017",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這個我行我素的女人是怎麼回事！！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "來自「複製品世界」的另一個自己，",
    "voice": "vo_adv_5136063_018",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "老實說聽起來超級可疑的……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎──一時之間很難以相信對吧？",
    "voice": "vo_adv_5136063_019",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "畢竟我",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "感覺比日和更像大姐姐嘛？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "才沒有咧。",
    "voice": "vo_adv_5136063_020",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這樣一看就能明白了。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "即使乍看之下不一樣，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "但是在氛圍之類的",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n本質部分有種相似感啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5136063_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是說啊！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我一開始也嚇了一跳……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n但是很快就和她變得要好了♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我們很意氣相投嘛──♪",
    "voice": "vo_adv_5136063_022",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "當然囉？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我是比較成熟的姐姐呢～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦～",
    "voice": "vo_adv_5136063_023",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉也表現得很興奮耶？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就像剛才，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳整個人都黏在了攤販前面！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不不，",
    "voice": "vo_adv_5136063_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "到處吃美食是旅行的醍醐味吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n不去在意熱量和預算那些，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n稍～微放縱一下……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是這點，",
    "voice": "vo_adv_5136063_025",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這種寬以待己的地方！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個樣子",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺不成熟，反倒很孩子氣哦？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好痛痛痛！",
    "voice": "vo_adv_5136063_026",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這句話狠狠地戳到了姐姐我的痛處……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "……所以說",
    "voice": "vo_adv_5136063_027",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳們到底是來幹嘛的啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不是找我有事嗎……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和，",
    "voice": "vo_adv_5136063_028",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳聽好囉？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "能夠寬以待己，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n也是大人的特點哦？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這個",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是千真萬確的！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦──",
