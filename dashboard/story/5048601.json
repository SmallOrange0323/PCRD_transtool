[
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": "vo_adv_5048601_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲她",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有好好記得我們的事呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n好高興喔♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還有呀，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "她說自己的成績比平均分數還高呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲好厲害喔！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是呀。",
    "voice": "vo_adv_5048601_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "看來她也有在好好努力，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那我就放心了。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我和姊姊還靈魂互換過呢。",
    "voice": "vo_adv_5048601_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "現在回想起來，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還真是不可思議。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且，",
    "voice": "vo_adv_5048601_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不光是我們，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還把鎮上的人們都捲進來了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是幸虧",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這件事能順利解決呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": "vo_adv_5048601_004",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也多虧了拉菲，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我們才能變得這麼幸福。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是呀。",
    "voice": "vo_adv_5048601_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "拉菲",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是名副其實的幸福天使。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她居然問「妳們有沒有認真在當天使呀？」……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是的，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們又沒有跟她約定過一定會做。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲她心裡很明白的啦。",
    "voice": "vo_adv_5048601_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊肯定會願意當天使的。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "而且，",
    "voice": "vo_adv_5048601_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "其實我也滿喜歡天使的活動的。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就算我們沒有拉菲那樣的力量，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們一樣擁有一顆身為天使的心呀！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……妳說得對。",
    "voice": "vo_adv_5048601_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我也得好好努力，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n免得和她重逢的時候，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "讓她見笑。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯嗯！",
    "voice": "vo_adv_5048601_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那我們",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一起來吃",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n拉菲寄來的糖果吧？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……慢著，茜里！",
    "voice": "vo_adv_5048601_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我想起來了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是「大天使的眼淚」！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "「大天使的眼淚」……？",
    "voice": "vo_adv_5048601_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "之前",
    "voice": "vo_adv_5048601_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "在找有什麼道具能恢復伊莉亞的魔力時，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我在書上看過這個東西。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是一種會被高價收購的",
    "voice": "vo_adv_5048601_013",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "夢幻道具……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "居然輕易地把這麼珍貴的東西送給我們……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n看來她果然是",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真正的天使啊。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "唔……",
    "voice": "vo_adv_5048601_014",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是那麼珍貴的東西，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們也不好意思吃掉呀。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "怎麼辦，姊姊，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要是賣掉了，我們就可以一夜致富呢。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……不了，",
    "voice": "vo_adv_5048601_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們還是留著吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這畢竟是拉菲成長的證明，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "會想讓人好好珍惜嘛。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我就知道姊姊妳會這麼說。",
    "voice": "vo_adv_5048601_016",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那我們",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "去吃點甜食吧，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就當作是代替糖果♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n也算是",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "為了拉菲慶祝一下吧。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是的，",
    "voice": "vo_adv_5048601_017",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里就妳這張嘴特別會說。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天就破例一次吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "希望我們的幸福",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "也能傳達給拉菲就好了。",
    "voice": null,
    "unit_id": 102211
  }
]
