  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "快看快看！",
    "voice": "vo_adv_7026005_032",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n這個娃娃屋裡的玩偶！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "說是「舞會組」的禮服喔！",
    "voice": "vo_adv_7026005_033",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是不是以花朵為靈感的呢！？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
