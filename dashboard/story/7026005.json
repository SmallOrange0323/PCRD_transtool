    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「森林樂園組」也很厲害嗎！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n家具等用品雖然小小的，但看起來跟真的一樣耶！？",
    "voice": null,
    "unit_id": 104033
  },
  {
