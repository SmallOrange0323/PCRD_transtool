    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "來，",
    "voice": "vo_adv_7026005_028",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大姐姐也一起去嘛！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n進去可以看到",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "更多各式各樣的玩偶喔！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………咦？",
    "voice": "vo_adv_7026005_029",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
