  {
    "type": "dialogue",
    "name": "旁白",
    "words": "打倒了擋住去路的魔物之後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n露娜突然在原地彎下身，撿起了某樣東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……閃閃發亮的。",
    "voice": "vo_adv_7026005_000",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n這個",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "會是什麼啊？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "似乎是從剛才的魔物身上掉落的……",
    "voice": "vo_adv_7026005_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n團長",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你知道這是什麼嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "鑰匙？",
    "voice": "vo_adv_7026005_002",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……！？",
    "voice": "vo_adv_7026005_003",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n在發光喔！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且",
    "voice": "vo_adv_7026005_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "發出的光芒還越來越強烈……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這該怎麼辦……！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "該怎麼辦────！？",
    "voice": "vo_adv_7026005_005",
    "unit_id": 104011
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？",
    "voice": "vo_adv_7026005_006",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個櫥窗裡展示的是……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇！",
    "voice": "vo_adv_7026005_007",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是一群迷你模型玩偶！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我都不知道這種地方有玩偶專賣店！",
    "voice": "vo_adv_7026005_008",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我好像有點明白",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "繞路閒晃的好處了！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那邊是一群在開茶會的玩偶，",
    "voice": "vo_adv_7026005_009",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這邊的是在開時裝秀？　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "感覺玩具的世界好像還挺好玩的……",
    "voice": "vo_adv_7026005_010",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我能不能也成為它們的同伴呢……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說笑的啦。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "即便有在從事BB團的活動，",
    "voice": "vo_adv_7026005_011",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但我到現在依然沒交到朋友。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我明白這是在逃避現實，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但還是……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "真好啊……",
    "voice": "vo_adv_7026005_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……咦！？",
    "voice": "vo_adv_7026005_013",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "欸嘿嘿！",
    "voice": "vo_adv_7026005_014",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "說了同一句話呢！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大姐姐也",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "喜歡玩偶嗎？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃……！",
    "voice": "vo_adv_7026005_015",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我是……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……哇！？",
    "voice": "vo_adv_7026005_016",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n團長！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "啊！",
    "voice": "vo_adv_7026005_017",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n大哥哥！！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦！？",
    "voice": "vo_adv_7026005_018",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n大哥哥！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嗯！",
    "voice": "vo_adv_7026005_019",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n是和露娜感情很好的大哥哥喔！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原、",
    "voice": "vo_adv_7026005_020",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來是這樣啊……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不只碰見團長，",
    "voice": "vo_adv_7026005_021",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還碰巧遇到團長的熟人，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這是邊緣人史上首見的奇蹟……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是我",
    "voice": "vo_adv_7026005_022",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "等於零的朋友運引導他們過來的嗎……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……怎、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎麼可能，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我身上是不可能發生那種事的！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是迷你模型玩偶喔！",
    "voice": "vo_adv_7026005_023",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "欸，大哥哥！",
    "voice": "vo_adv_7026005_024",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n和露娜一起進去看看嘛！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜的邀請方式",
    "voice": "vo_adv_7026005_025",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是機靈……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n值得參考……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "希望",
    "voice": "vo_adv_7026005_026",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我有天也能像那樣邀請別人……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哎呀……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也得機靈退場才行，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "免得打擾他們兩位……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_7026005_027",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那我就先離開了，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
