  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在玩依里帶來的\\n各種遊戲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸！無效化！？騙人！？",
