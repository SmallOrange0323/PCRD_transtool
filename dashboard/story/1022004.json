    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但那是很大膽的話吧……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我竟然說什麼……男女在一起熬夜……",
    "voice": "vo_adv_1022004_027",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚……！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、不行～～～！一起玩遊戲，不行～～～！",
