    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚～～～輸、輸了～～～～～～",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你啊，明明沒有記憶，卻這麼會玩遊戲。",
    "voice": "vo_adv_1022004_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不管是棋盤遊戲，還是卡片遊戲都很強……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過多虧有你我才能一起玩遊戲，我也很開心啦。",
    "voice": "vo_adv_1022004_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……啊，不、不對！剛剛說的不算！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我也沒那麼開心，就只有一點點開心而已！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而、而且，現在還是我贏的比較多喔。",
    "voice": "vo_adv_1022004_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "下一個要玩什麼遊戲？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……咦？",
    "voice": "vo_adv_1022004_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、這個光是什麼！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你做了什麼嗎！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦……",
    "voice": "vo_adv_1022004_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊啊啊啊！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天是遊戲展的開幕紀念特賣！",
    "voice": "vo_adv_1022004_006",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "遊戲軟體、電腦周邊設備和攻略本……",
    "voice": "vo_adv_1022004_007",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n雖然很累，但也買到了很多好東西！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "讓你幫忙拿東西，真不好意思啊。",
    "voice": "vo_adv_1022004_008",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "想買的東西太多了，我一個人拿不動……",
    "voice": "vo_adv_1022004_009",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你有空真是幫了大忙。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸……該怎麼說呢……",
    "voice": "vo_adv_1022004_010",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、那個，總之謝謝你了！我有謝謝你囉！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那你覺得如何呢？",
    "voice": "vo_adv_1022004_011",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天來買東西開心嗎？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不，那個……",
    "voice": "vo_adv_1022004_012",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n因為讓你一直陪我買東西，",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n覺得有點過意不去……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……你買到了想買的東西？",
    "voice": "vo_adv_1022004_013",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "太好了。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你買了什麼呀？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……美、美少女遊戲！？",
    "voice": "vo_adv_1022004_014",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你喜歡那種遊戲！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "給、",
    "voice": "vo_adv_1022004_015",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "給我看看！欸……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "「和女僕、護士、巫女、小魔女的後宮生活」！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼、哼嗯～",
    "voice": "vo_adv_1022004_016",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你喜歡這種類型的女孩子啊？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……因為包裝很大盒卻超便宜所以就買了？",
    "voice": "vo_adv_1022004_017",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、",
    "voice": "vo_adv_1022004_018",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣啊！太好了～",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、你的喜好是什麼，我才一點都不在意就是了！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我也有那本書耶！",
    "voice": "vo_adv_1022004_019",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你說一聲的話，我就借你了……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "話說回來，這本書是和你爭論之後，",
    "voice": "vo_adv_1022004_020",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n還向你借錢買的……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚……又回想起丟臉的回憶了……",
