    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過呢，我原本鎖定的目標也",
    "voice": "vo_adv_1022004_021",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n全都買到了，非常滿意。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "得趕快回家玩遊戲才行呢！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊～好期待～！",
    "voice": "vo_adv_1022004_022",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n今晚要熬夜徹底地破關！",
