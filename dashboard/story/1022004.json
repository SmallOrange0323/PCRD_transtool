  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我剛剛該不會是睡著了吧……？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "竟然在玩卡片遊戲時睡著……",
    "voice": "vo_adv_1022004_038",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n而且還作了奇怪的夢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "話說回來，夢裡面好像也講到遊戲……",
    "voice": "vo_adv_1022004_039",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但是那個遊戲是什麼呀……？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸……？你也做了一樣的夢？",
    "voice": "vo_adv_1022004_040",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有這麼巧的事情啊……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，現在不是討論夢境，",
    "voice": "vo_adv_1022004_041",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n也不是睡覺的時候了。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你看，",
    "voice": "vo_adv_1022004_042",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還有那麼多想玩的遊戲，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天你要陪我玩到早上喔。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……咦？",
    "voice": "vo_adv_1022004_043",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n總覺得我在夢裡頭，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n好像也說了類似的話……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、",
    "voice": "vo_adv_1022004_044",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、不是那樣的喔！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n雖然我說陪我到早上，但絕對沒有奇怪的意思喔！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不要想歪成那種不知羞恥的事！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……好、",
    "voice": "vo_adv_1022004_045",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好啦！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n趕快繼續玩遊戲了！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和用生氣掩飾害羞的依里，\\n又重新開始玩遊戲了。",
    "voice": null,
    "unit_id": null
  }
]
