    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，欸……那個……",
    "voice": "vo_adv_1022004_030",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我、我還是要好好向你說一聲。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個……今天，你來陪我……",
    "voice": "vo_adv_1022004_031",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n真的很謝……謝……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！",
    "voice": "vo_adv_1022004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你做了個好「夢」嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和依里的「記憶碎片」",
