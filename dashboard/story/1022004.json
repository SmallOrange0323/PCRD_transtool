    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n比起一個人玩的RPG，",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n兩個人對戰的遊戲還比較多……",
