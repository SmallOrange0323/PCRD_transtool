  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好",
    "voice": "vo_adv_1002005_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "了……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是謝謝了呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員１",
    "words": "如果又有不錯的魔法書進貨了的話會再通知妳喔～。",
    "voice": "vo_adv_1002005_001",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好像，有點重呢……",
    "voice": "vo_adv_1002005_002",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n才剛逛第一間店而已就好像買太多了呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（但是最近，必須使用魔法的機會比起以前有所增加，",
    "voice": "vo_adv_1002005_003",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以我得努力學習，讓自己能使用各式各樣的魔法才行呢……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！",
    "voice": "vo_adv_1002005_004",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "請妳不用在意。雖然有點重，但我一個人也能搬得動的。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……謝謝你。",
    "voice": "vo_adv_1002005_005",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那個，我可以再去逛一間書店嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我還想再買一些魔法書呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（騎士先生果然是個溫柔的人……",
    "voice": "vo_adv_1002005_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在夢境中，也是幫助過我好幾次了呢……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（能和騎士先生兩人一同逛街購物，就好像約會一樣呢……）",
    "voice": "vo_adv_1002005_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（約會……",
    "voice": "vo_adv_1002005_008",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一這麼想，就似乎感到心跳加速了呢……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我得保持冷靜才行呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "吸氣～，吐氣～……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……完全冷靜不下來呀！）",
    "voice": "vo_adv_1002005_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊！這裡就是剛才所說的另一間書店呢！",
    "voice": "vo_adv_1002005_010",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "差點就走過頭了呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "打擾了！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（咦……？這間書店是……）",
    "voice": "vo_adv_1002005_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "歡迎光臨～。",
    "voice": "vo_adv_1002005_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "上次妳問有沒有進貨的那本新書，已經到貨囉！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（弄，弄錯了～！",
    "voice": "vo_adv_1002005_013",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這裡不是販賣魔法書的書店……！）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呃……",
    "voice": "vo_adv_1002005_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想應該沒有這回事的……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "是嗎？那把它賣給其他人也沒問題囉？",
    "voice": "vo_adv_1002005_015",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "這一期的月刊戀愛指南！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（不要把書名唸出來呀～！",
    "voice": "vo_adv_1002005_016",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚嗚嗚……真是害羞到讓人想趕快逃離這裡呢……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇",
    "voice": "vo_adv_1002005_017",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇哇哇哇……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n才、才不是呢！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "今天我是來……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（雖然我的確有預約這本書，但不太想被騎士先生知道我有買這樣內容的書……）",
    "voice": "vo_adv_1002005_018",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（可是這本書，一進貨沒過多久就會賣完，",
    "voice": "vo_adv_1002005_019",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果找到的時候沒有立刻買下的話就沒機會再拿到手了……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我改變心意了，請給我1本吧。",
    "voice": "vo_adv_1002005_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "謝謝惠顧。因為妳今天和男朋友一起來就給妳打折吧。",
    "voice": "vo_adv_1002005_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "男、",
    "voice": "vo_adv_1002005_022",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "男、男、男朋友！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎、騎士先生和我才不是……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "是我誤會啦？",
    "voice": "vo_adv_1002005_023",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "今天在這一帶的店，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "\\n情侶檔購物的話會打折喔。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "哎呀～，因為他好像有幫妳拿東西，",
    "voice": "vo_adv_1002005_024",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "\\n我還以為是妳的男朋友陪妳來逛街買東西的說……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（雖然今天買了太多書想節省一下，",
    "voice": "vo_adv_1002005_025",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但說謊又好像不太好呢……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（此外，我也還沒對騎士先生告白，",
    "voice": "vo_adv_1002005_026",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n沒有資格得到優惠呀……）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起。其實……",
    "voice": "vo_adv_1002005_027",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……！？",
    "voice": "vo_adv_1002005_028",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎、騎士先生！？為為為為為、為什麼……！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "好的～。那就算折扣價囉。",
    "voice": "vo_adv_1002005_029",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "這是妳的書。這裡是找零。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇哇哇哇哇……！",
    "voice": "vo_adv_1002005_030",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝、謝謝了……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "店員２",
    "words": "謝謝惠顧。要和男朋友好好相處啊～",
    "voice": "vo_adv_1002005_031",
    "unit_id": 1211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……騎、騎士先生。剛才那件事……謝、謝謝！",
    "voice": "vo_adv_1002005_032",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯、嗯！",
    "voice": "vo_adv_1002005_033",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說的沒錯呢！啊哈哈……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（難道……就算在剛才那位店員以外的其他路人眼裡，",
    "voice": "vo_adv_1002005_034",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我們兩人，也像是一對情侶嗎……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（這是表示我們的情誼已經如此融洽的意思嗎！？",
    "voice": "vo_adv_1002005_035",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我喜歡……騎士先生。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但騎士先生對我，又是抱著怎麼樣的想法呢……？）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……騎、",
    "voice": "vo_adv_1002005_036",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎騎、騎士先生！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……我、你對我的看法是……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……沒、沒事的什麼都沒有！",
    "voice": "vo_adv_1002005_037",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是不好意思！剛才的事請忘記吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……嗚嗚……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，剛才買的書就請你幫忙拿回公會之家可以嗎？",
    "voice": "vo_adv_1002005_038",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對、對了！就請你喝我上次買到的美味好茶來當作謝禮吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（不行呀～……",
    "voice": "vo_adv_1002005_039",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "緊張到想說的話都說不出口～！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "誰來救救我呀～！真琴～……！）",
    "voice": null,
    "unit_id": 100211
  }
]
