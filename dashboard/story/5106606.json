  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與純在艾米的帶領下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n走在充滿聖誕氛圍的蘭德索爾街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "願望的氣息是從這邊傳來的呢。",
    "voice": "vo_adv_5106606_000",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": "vo_adv_5106606_001",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個是……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊～！",
    "voice": "vo_adv_5106606_002",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好忙好忙的啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥和……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這是哪位呀？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5106606_003",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我是【王宮騎士團】的純。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔，",
    "voice": "vo_adv_5106606_004",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是純小姐啊～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……什麼，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "純小姐！？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n妳怎麼了，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼穿成這樣啦！？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我現在在幫這幾位天使的忙。",
    "voice": "vo_adv_5106606_005",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是特別準備的服裝……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔～",
    "voice": "vo_adv_5106606_006",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是不是叫Cosplay啊？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n之前鈴鈴也做過一樣的事啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呃，",
    "voice": "vo_adv_5106606_007",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以這麼說吧……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "比起這個！",
    "voice": "vo_adv_5106606_008",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "妳是不是在傷腦筋呀？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "儘管向我",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "這位天使艾米說說看吧。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這一位是扮成了天使嗎？",
    "voice": "vo_adv_5106606_009",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好可愛的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "唔～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也不算是傷腦筋吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牧場的牛奶最近銷量很好。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我正忙著配送啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "該說是甜蜜的負荷嗎……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我期待的就是這種願望！",
    "voice": "vo_adv_5106606_010",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n用天使的力量就可以解決了！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那不太好吧……",
    "voice": "vo_adv_5106606_011",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牧場的事情得牧場自己解決啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "用願望的力量迅速俐落地配送也沒關係吧。",
    "voice": "vo_adv_5106606_012",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "來，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "妳快在心裡希望工作快點結束吧。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等等，",
    "voice": "vo_adv_5106606_013",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "艾米。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n擅自斷定別人的願望是不好的。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n先別先入為主，",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "問問人家心中真正的幸福怎麼樣？",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……有道理，",
    "voice": "vo_adv_5106606_014",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我的做法有點粗暴了。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "那麼，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "如果有想要的東西或想見的人，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "就在腦海裡想像一下吧。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我沒有",
    "voice": "vo_adv_5106606_015",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "想要的東西，不過……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n想見的人的話，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "倒不是沒有啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "很好。",
    "voice": "vo_adv_5106606_016",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "那請妳在腦海裡一直想像著那個人！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n要開始囉！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n天使之箭！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "什、",
    "voice": "vo_adv_5106606_017",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我的確",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是覺得有莉瑪莉瑪在會更放心啦……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "奇怪？",
    "voice": "vo_adv_5106606_018",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦咦咦？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我怎麼",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會在這裡？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n怎麼連你也……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n因為蘋果用完了，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我今天本來是在看家的……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "唔……",
    "voice": "vo_adv_5106606_019",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "妳是想找動物來嗎？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "妳是想要一些療癒嗎……？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿，",
    "voice": "vo_adv_5106606_020",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我才不是動物！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是失禮。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼辦呀……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果被街上的人誤認成魔物的話，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n也會給真陽添麻煩的。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個……",
    "voice": "vo_adv_5106606_021",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天應該沒關係吧？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哇！",
    "voice": "vo_adv_5106606_022",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "是聖誕姐姐和",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "白色的馴鹿！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_5106606_023",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不是馴鹿耶……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過只要不會嚇到街上的人",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就好了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我看家也看膩了，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就來幫真陽的忙吧！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真不愧是莉瑪莉瑪！",
    "voice": "vo_adv_5106606_024",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "幫了大忙的啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那我們就",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "出發前進啦～！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_5106606_025",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像這樣和夥伴一起努力工作……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這也算是一種幸福吧。",
    "voice": null,
    "unit_id": 124214
