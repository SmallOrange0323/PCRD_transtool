    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n剛成立不久的重要時期……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就算是我，只要活著也許還能派上用場。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我要活著拼命工作來負責。",
