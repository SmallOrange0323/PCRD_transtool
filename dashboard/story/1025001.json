  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "現現現、",
    "voice": "vo_adv_1025001_031",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "現在可不是冷靜下來的時候啊！",
