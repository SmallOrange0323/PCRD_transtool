    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這才是最重要的。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "並不是因為您是我命中注定的人，",
    "voice": "vo_adv_1027007_039",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
