  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您不必感謝我。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n除去膽敢傷害{0}大人的東西，",
