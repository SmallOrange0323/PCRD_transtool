  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "瑪莉絲黛菈要回到故鄉城鎮的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "前一天晚上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聽說了此事的【暮光流星群】成員，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n造訪阿爾克絲鍊金堂舉行了送別會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "謝謝妳們啊，",
    "voice": "vo_adv_5204061_000",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "還為我辦這種送別會。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總覺得時間轉眼就過了呢。",
    "voice": "vo_adv_5204061_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟瑪莉絲黛菈小姐也",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有種從以前就認識了的感覺喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好──！",
    "voice": "vo_adv_5204061_002",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽就來點餘興節目！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "來嘛來嘛，露易啊～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "再靠近點♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n很好、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "很好♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "放過我吧，大人……",
    "voice": "vo_adv_5204061_003",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "哎～呀～！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳這是讓我演什麼啦！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_5204061_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們平時就都在做這種事嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n怪不得彩羽是演技派啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那演技也幫了我就是了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻，",
    "voice": "vo_adv_5204061_005",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "都是多虧了某人傷風敗俗的書。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n妳究竟還藏著多少書呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳、",
    "voice": "vo_adv_5204061_006",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳在說什麼！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "喂，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "可以別亂翻別人的床底嗎！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好了好了，大家冷靜下來。",
    "voice": "vo_adv_5204061_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來吃飯吧～？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n唔哈～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好好吃♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n苑氏做的飯，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "每一道都是３星啊～♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是吧，",
    "voice": "vo_adv_5204061_008",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "因為我可沒白當姑姑。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "追加的肉烤好了喔。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "杏奈有在吃嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……嗯。",
    "voice": "vo_adv_5204061_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯？",
    "voice": "vo_adv_5204061_010",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "杏奈怎麼了？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n肚子已經飽了嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不……",
    "voice": "vo_adv_5204061_011",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真要說是哪邊的話，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是心中充滿了感慨。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "因為能與大家這樣歡笑，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哪怕只是短暫的一刻，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也遇見了能",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n一同",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "出生入死的夥伴啊……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不知為何，我不覺得",
    "voice": "vo_adv_5204061_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "跟在這裡的大家是不久前才相遇的。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "簡直就像",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "從很久以前──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "從前世",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就彼此相繫著一樣。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "什麼是前世──？",
    "voice": "vo_adv_5204061_013",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯嗯，",
    "voice": "vo_adv_5204061_014",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "很難說明呢。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "算是",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "跟現在的我們不一樣的",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "其他人生的感覺……？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "定義那種事沒意義喔，",
    "voice": "vo_adv_5204061_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為什麼前世的，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都是不存在、不科學的東西。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_5204061_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……不過，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我總覺得奇怪。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "跟瑪莉絲黛菈相遇的10年前的",
    "voice": "vo_adv_5204061_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "暴風雨之夜的記憶，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我到現在也記得很清楚……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n除了那之外的記憶卻……？　",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……不對勁，",
    "voice": "vo_adv_5204061_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "想不起來……？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "比起忘記了……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "更像是籠罩在一層霧靄之中的感覺。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……簡直就像……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就像前世的記憶一樣……",
    "voice": "vo_adv_5204061_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": "vo_adv_5204061_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒什麼……！",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "……呵呵，",
    "voice": "vo_adv_5204061_021",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "那要來窺視看看嗎？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "大家的前世。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "「基創鍊成」！",
    "voice": "vo_adv_5204061_022",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "好，完成。",
    "voice": "vo_adv_5204061_023",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n這是「能夠再體驗前世的祕藥」喔。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「能夠再體驗前世的祕藥」……？",
    "voice": "vo_adv_5204061_024",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "是連我也不曉得的鍊金術啊。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "等一下啊，",
    "voice": "vo_adv_5204061_025",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "瑪莉絲黛菈小姐，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳是說前世",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種東西真的存在嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "呵呵，",
    "voice": "vo_adv_5204061_026",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "並不是那麼了不起的東西喔。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "這就只是「可能也有這樣的",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "世界存在」，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n如同輕鬆的玩樂一樣而已。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過",
    "voice": "vo_adv_5204061_027",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就算是那樣也沒關係。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不管是夢境也好，玩樂也罷，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我會找出我和",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那位大人",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n即便是在前世也在一起的證據的，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽也想試試看──！",
    "voice": "vo_adv_5204061_028",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "大家一起試試看吧！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我也要、",
    "voice": "vo_adv_5204061_029",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我也要！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這個發展我等很久啦，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "前、前、前世！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n欸，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可以吧？深月。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……我不會做出掃興的行為喔。",
    "voice": "vo_adv_5204061_030",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果能保證安全性，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我沒理由反對。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "太棒了──！",
    "voice": "vo_adv_5204061_031",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那彩羽要第一個！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑和露易也一起試試看吧！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊？",
    "voice": "vo_adv_5204061_032",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我也要？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "沒問題啦，苑。",
    "voice": "vo_adv_5204061_033",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n因為祖母的鍊金術",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "是絕對不會失敗的。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "倒是有可能過於成功是吧？",
    "voice": "vo_adv_5204061_034",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "算了，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我就試試看吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "呵呵，",
    "voice": "vo_adv_5204061_035",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "那首先是",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "鍊金堂的三人吧。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n來～啦！噴射～！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「唔唔……！」\\n「唔……！」\\n「哇啊！？」",
    "voice": "vo_adv_5204061_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，三人嘗試了「能夠再體驗前世的祕藥」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不久後，睡意悄然降臨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著醒過來時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n三人看見的是──",
    "voice": null,
    "unit_id": null
  }
]
