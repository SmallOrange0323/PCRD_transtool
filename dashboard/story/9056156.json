  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "出發之前，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下順道去了一趟公會管理協會，當時聽到了一件事。",
