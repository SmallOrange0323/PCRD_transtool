  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼短時間內做出這麼多精緻的衣服，",
    "voice": "vo_adv_6050201_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希真的很厲害呢。",
