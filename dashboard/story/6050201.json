    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過我稍微想了一下……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這些該不會",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原本全都是想讓我穿的衣服吧……",
    "voice": null,
    "unit_id": 114011
