  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了蒐集神秘男的相關資訊，\\n七七香和{0}去了常去的魔法道具店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗨嗨店長！",
    "voice": "vo_adv_1013005_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然很突然，但我最近在找個人！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n是關於一個拿著奇妙的魔導書到處分發的神秘男，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你知道些什麼嘛？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嗯，",
    "voice": "vo_adv_1013005_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "真抱歉，但我不知道呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "比起這件事，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "店裡進了很多",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "七七香可能會喜歡的東西呦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼！？",
    "voice": "vo_adv_1013005_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這不是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和已經決定要做成動畫作品",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "聯名的魔術道具嘛！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": "vo_adv_1013005_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊啊，你不知道動畫？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n是最近發明的",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "超神技術！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是一種快速播放多張畫，",
    "voice": "vo_adv_1013005_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就能使畫中的人物好像動起來一般的技術喔！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後再用魔法播出！",
    "voice": "vo_adv_1013005_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣懂嘛？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "二次元會",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "動起來呦！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對我們御宅族來說簡直是到了天堂一般！",
    "voice": "vo_adv_1013005_006",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "因為角色在眼前活生生地動了起來！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼喔！？",
    "voice": "vo_adv_1013005_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這是只販售短短三天的，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n夢幻超稀有魔術卡！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且還附上畫家的簽名！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇──！",
    "voice": "vo_adv_1013005_008",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "受不了啦──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "唉呀，",
    "voice": "vo_adv_1013005_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "但我還真沒想到七七香會帶男朋友來呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": "vo_adv_1013005_010",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我不太懂你在說什麼。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嗯？",
    "voice": "vo_adv_1013005_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "旁邊這位小兄弟，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不是妳的男朋友嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……",
    "voice": "vo_adv_1013005_012",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不不不，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是不是不是不是不是！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "把我這種土氣的御宅族當成他的女朋友，",
    "voice": "vo_adv_1013005_013",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對{0}太失禮了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔！",
    "voice": "vo_adv_1013005_014",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可、可可可可可愛！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "欸！？",
    "voice": "vo_adv_1013005_015",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "美美美美美女──！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔啊啊……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太不習慣了身體產生排斥反應～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你你你",
    "voice": "vo_adv_1013005_016",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你知道你在說些什麼嗎！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n那些話對七七香來說簡直像毀滅的咒語！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再、",
    "voice": "vo_adv_1013005_017",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再留在這裡勢必會很危險！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n七七香，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "緊急撤離！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再會了──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "啊！",
    "voice": "vo_adv_1013005_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂──七七香！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼……",
    "voice": "vo_adv_1013005_019",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼{0}是男朋友，\\n是哪來的想法呀！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可能是、",
    "voice": "vo_adv_1013005_020",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最近我們太常一起行動，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但那是因為他是夥伴呀！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……客、",
    "voice": "vo_adv_1013005_021",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "客觀的角度來看，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就像是在約會一般嗎。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "定、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "定期巡迴也是……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_1013005_022",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "該不會我現在",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是個十足的現充……？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不不不快清醒！",
    "voice": "vo_adv_1013005_023",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "弄清自己的身分！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我是魔法少女兼重度御宅族！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n最喜歡漫畫了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最喜歡美少女了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒錯，",
    "voice": "vo_adv_1013005_024",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現充什麼的……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我才不是現充……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不如說……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現充都給我爆炸啦──！",
    "voice": "vo_adv_1013005_025",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我正在重新審視自己，",
    "voice": "vo_adv_1013005_026",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後在想是不是要毀滅現充……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦、",
    "voice": "vo_adv_1013005_027",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚啊啊啊啊！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "{0}！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不、",
    "voice": "vo_adv_1013005_028",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是啦！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我才不是因為覺得難為情而逃跑喔？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n真的喔？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天的七七香也是在絕佳狀態喔！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "比、",
    "voice": "vo_adv_1013005_029",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "比起那個！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "關於那個神秘男呀！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一般的商人如果不知道的話……",
    "voice": "vo_adv_1013005_030",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "問問檯面下的人怎麼樣呢……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "因為所屬的公會的關係，",
    "voice": "vo_adv_1013005_031",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我認識黑市裡的人。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果是黑市的魔法道具商人的話，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不定會知道些什麼！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果在這邊等的話，就會……",
    "voice": "vo_adv_1013005_032",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來了來了那個男人！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "唉呀唉呀，「收藏家」。",
    "voice": "vo_adv_1013005_033",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "今天要找些什麼呢？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呀齁呀齁！",
    "voice": "vo_adv_1013005_034",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天呀，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我是有個問題想問一下你。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "嗯……",
    "voice": "vo_adv_1013005_035",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "但我這裡可不是蒐集情報的店呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不過，",
    "voice": "vo_adv_1013005_036",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "如果被妳的公會視為敵人，那可是件麻煩事。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n只有這次喔？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯嗯！",
    "voice": "vo_adv_1013005_037",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只有這次只有這次！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可真是幫了大忙！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那個啊──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "原來如此。",
    "voice": "vo_adv_1013005_038",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "直接從結論來說，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我知道那個男人。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚哇出現了！",
    "voice": "vo_adv_1013005_039",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n詳情！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "詳情希望！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那個人一邊在大陸中旅遊，",
    "voice": "vo_adv_1013005_040",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "一邊蒐集所有見到的魔導書和魔法道具，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n然後再免費將那些東西交給自己相中的人。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦……",
    "voice": "vo_adv_1013005_041",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為什麼這麼做呢？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "這個嘛，",
    "voice": "vo_adv_1013005_042",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "理由就……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不過，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "他也跟我交易了不少次喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我們商人之間，",
    "voice": "vo_adv_1013005_043",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "都稱那個男人為「黑暗收藏家」。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯。",
    "voice": "vo_adv_1013005_044",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果是我，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n絕不可能免費將稀有的魔導書送給別人喔。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……我說，",
    "voice": "vo_adv_1013005_045",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要怎麼做才能和那個男人見到面呢？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "這個嘛……",
    "voice": "vo_adv_1013005_046",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "實際和我交易的人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "是那男人的徒弟們呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n因為沒和本人碰上面，所以連他的所在地都不知道。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唉呀，",
    "voice": "vo_adv_1013005_047",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是這樣啊？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那可真可惜",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還以為終於可以見面了呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "……在傳聞中，",
    "voice": "vo_adv_1013005_048",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那個男人在找一樣東西。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n為此在招募夥伴中呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我知道的就這麼多了。",
    "voice": "vo_adv_1013005_049",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n其他麻煩的事就請放過我吧，我先告辭了呦。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好呦──！",
    "voice": "vo_adv_1013005_050",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "謝謝啦！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "……我們也有點交情，",
    "voice": "vo_adv_1013005_051",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "所以想給妳個忠告。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "聽說那個男人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "似乎是個相當厲害的魔法師。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "恐怕……",
    "voice": "vo_adv_1013005_052",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "比妳強悍很多呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n好奇心往往會帶來悲劇……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "請萬萬小心。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……嗯呼呼──",
    "voice": "vo_adv_1013005_053",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "又是一個熱血的展開呢──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那樣的忠告反而點燃我魔法少女的鬥志！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "君子不履險的話，",
    "voice": "vo_adv_1013005_054",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是無法成為主角的吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然只是預測，",
    "voice": "vo_adv_1013005_055",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "個人覺得那男人在找的東西，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "應該正是傳說中的魔導書吧──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "首先，",
    "voice": "vo_adv_1013005_056",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為了找到男人，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "先找到他的徒弟吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇──！",
    "voice": "vo_adv_1013005_057",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "事情要變得有趣囉──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等著吧神秘男！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我絕對不會將傳說中的魔導書交給你的！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七七香因為這符合魔法少女劇情的情節，\\n熱血沸騰了起來。",
    "voice": null,
    "unit_id": null
  }
]
