  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊～好了好了！",
    "voice": "vo_adv_1104002_008",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我知道你想說什麼，但是請你先冷靜下來！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "難得可以來到海邊喔？",
    "voice": "vo_adv_1104002_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n別讓周遭其他人也變得不開心嘛。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔，",
    "voice": "vo_adv_1104002_010",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "謝啦，{0}。",
