    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "如果是平常，我早就賞他個一拳解決了……",
