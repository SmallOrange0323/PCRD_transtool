[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再次稍作休息的一行人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這個時候，雪翻找著寄放在{0}那裡的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "魔導具。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我看看。",
    "voice": "vo_adv_7017004_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個是幫助肌膚保濕的秘境的靈草，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能夠魅惑魔物的香水……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是費了我好多心力。",
    "voice": "vo_adv_7017004_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了讓我更加美麗，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不做到這種程度不行呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這層樓好像",
    "voice": "vo_adv_7017004_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也有掉落幾個魔導具的樣子，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n得先",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "整理好行李才行。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還真是",
    "voice": "vo_adv_7017004_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "辛苦妳了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n虧妳能蒐集到這麼五花八門的東西。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就認可妳那份對於美麗的執著吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔……",
    "voice": "vo_adv_7017004_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是鏡子？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n沒特別感覺到魔力的氣息啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_7017004_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等一下。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那面鏡子是……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔，",
    "voice": "vo_adv_7017004_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼回事……！？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "突然發光……！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "早安啊，",
    "voice": "vo_adv_7017004_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "各位☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "睡得可好？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯～",
    "voice": "vo_adv_7017004_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "增加了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n克莉絲提娜小姐變成兩個了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦，",
    "voice": "vo_adv_7017004_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "幻影嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "竟然模仿我，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是有趣……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "沒錯，",
    "voice": "vo_adv_7017004_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "你好啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "我☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如你所見，",
    "voice": "vo_adv_7017004_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這面鏡子會製造出所照之人的分身。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "世上最可愛的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是變成兩人的話",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很棒吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "之前，",
    "voice": "vo_adv_7017004_012",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我有一面同樣的鏡子，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "卻不小心摔碎了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "找替代品找了好久呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "確實外觀上和我一模一樣……",
    "voice": "vo_adv_7017004_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "希望不是虛有其表而已。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "還在閒話家常什麼啊。",
    "voice": "vo_adv_7017004_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n最好不要繼續讓我無聊喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "一閒下來的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "不就會害我想跟你們玩玩了嗎……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": "vo_adv_7017004_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以我的鏡中倒影來說還挺好戰的嘛？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這麼血氣方剛",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "究竟是像到誰呀……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但這些話，感覺就是克莉絲提娜小姐會說的呢。",
    "voice": "vo_adv_7017004_016",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不如說",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "應該有講過吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈，",
    "voice": "vo_adv_7017004_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小姑娘",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳真幽默。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n有膽就在我的劍前",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再講一遍，我會好好誇獎妳的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要滿足",
    "voice": "vo_adv_7017004_018",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "本尊的願望，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n分身自然就會消失了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯～",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "兩人並排站的話根本分不出來啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "上次我做出分身的時候，",
    "voice": "vo_adv_7017004_019",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "互相稱讚",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n對方的美麗之後就消失了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "三天三夜裡",
    "voice": "vo_adv_7017004_020",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "談論著至高無上的美麗，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如此美妙的時光……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真想再次",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "體驗",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那樣的幸福呢……♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼，",
    "voice": "vo_adv_7017004_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "分不出哪個是本尊？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種小事，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "根本不需要煩惱。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很簡單──",
    "voice": "vo_adv_7017004_022",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要拔劍較量就知道了！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為真正的我，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是不會輸給區區冒牌貨的！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "啊哈哈哈哈☆",
    "voice": "vo_adv_7017004_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n不愧是我……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "就是得這樣！！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "啊啊，",
    "voice": "vo_adv_7017004_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "真是愉悅！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n全神貫注、不放過一絲破綻，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "只為取我性命的那股殺氣！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n遊走在生死邊緣的劍光、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "刀刃碰撞時",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "迸裂的火花！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "自心臟奔騰而出的血液，",
    "voice": "vo_adv_7017004_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "使我的背脊不禁顫抖！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n這是我、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "我們翹首以盼的爭鬥！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n來吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "讓我們耽溺在賭上性命的剎那歡愉吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "怎麼",
    "voice": "vo_adv_7017004_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "不說話了？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "要不要讓我猜猜妳現在在想什麼啊？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不了，",
    "voice": "vo_adv_7017004_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無需妳的好意。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要交談，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們以劍相談足矣。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "沒錯！",
    "voice": "vo_adv_7017004_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "正是如此！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我最先出的招，已經是完全瞄準空隙的全力一擊……",
    "voice": "vo_adv_7017004_029",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也就是說，我的能力無法通用於自身嗎。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要一不注意，",
    "voice": "vo_adv_7017004_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的人頭就會輕易落地吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是得這樣才對！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "與太過強悍的我相襯的強敵──",
    "voice": "vo_adv_7017004_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n果然只會是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我自己！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": "vo_adv_7017004_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼會如此愉悅……！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n果然賭上性命的戰鬥，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "才能讓人有活著的感受。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n若是能夠",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "與這個強敵永遠鬥爭下去……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "太慢了！",
    "voice": "vo_adv_7017004_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "妳的首級，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "我收下了！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這一擊……",
    "voice": "vo_adv_7017004_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要躲已經來不及了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嘖，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該說真不愧是我嗎。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在這種棘手到讓人著迷的時間點出招！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在這個亂數聖域相互抵銷的狀況下，",
    "voice": "vo_adv_7017004_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n決定勝負的關鍵還是我與那傢伙原本的實力──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是要撤退、",
    "voice": "vo_adv_7017004_036",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還是防守……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "或者背水一戰、捨身搏命。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的身體告訴我。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "假如在這裡退怯，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "連一線生機都會失去！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "踏進去！",
    "voice": "vo_adv_7017004_037",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只差半步……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "半步就好。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在那傢伙的劍光未至之前，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要這隻腳能夠搶先踏進去的話──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是──",
    "voice": "vo_adv_7017004_038",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子的力量嗎！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒有時間迷惘了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在我就",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "心甘情願地借取這份力量吧！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈啊啊啊啊啊！",
    "voice": "vo_adv_7017004_039",
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "──",
    "voice": "vo_adv_7017004_040",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "沒想到",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "居然被反擊了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "分身克莉絲提娜",
    "words": "我還以為至少不會輸給我自己呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "勝負不到最後無法揭曉。",
    "voice": "vo_adv_7017004_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無論是什麼狀況、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "利用什麼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n最後獲勝的人才是贏家。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "結果是",
    "voice": "vo_adv_7017004_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我贏了，妳輸了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該說不愧是我嗎……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我承認，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳是個強敵。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是像做夢一般",
    "voice": "vo_adv_7017004_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "愉快的戰鬥。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再會了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_7017004_044",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "碎掉了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吶，",
    "voice": "vo_adv_7017004_045",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我一直有個疑問。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "剛才分身說的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「爭鬥」是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n克莉絲提娜小姐的願望……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼妳",
    "voice": "vo_adv_7017004_046",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這麼渴求戰鬥呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是我的話，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只會覺得很麻煩。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n妳居然",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還願意為此賭上性命。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誰知道呢。",
    "voice": "vo_adv_7017004_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這對我來說太過理所當然，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我也不知道緣故。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要簡單說明的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也許，",
    "voice": "vo_adv_7017004_048",
    "unit_id": 107111
  },
