[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩名來自異國的少女",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到了蘭德索爾的房屋仲介處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……咦咦！？",
    "voice": "vo_adv_3022001_000",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n你說房子不能租給我們，這是什麼意思！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "簽約金、押金、禮金。",
    "voice": "vo_adv_3022001_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "還有第一筆房租我們都付得出來喔。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我們還算有一些存款的，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然接下來的生活就必須省到極點了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "是啊……",
    "voice": "vo_adv_3022001_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "而且",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我們也會好好賺錢的。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不要看我這樣，我可是天才鍊金術師，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "賺錢的方法要多少有多少……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "還順便自誇了一番。",
    "voice": "vo_adv_3022001_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "鍊金術師……？",
    "voice": "vo_adv_3022001_004",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "聽起來好可疑。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "\\n說到底，租賃契約這東西",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "本來就不能讓小孩子自己簽。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "\\n妳們至少要帶大人過來才行。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "咦？",
    "voice": "vo_adv_3022001_005",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不對吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n要大人的話，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你眼前不就有一位──",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……啊。",
    "voice": "vo_adv_3022001_006",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "糟糕。",
    "voice": "vo_adv_3022001_007",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n現在的我，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "根本是小孩子的身體……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可惡。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "喂，",
    "voice": "vo_adv_3022001_008",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "苑妳在說什麼啊……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊、",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "抱歉打擾了～",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "房屋仲介",
    "words": "……小孩子的身體？",
    "voice": "vo_adv_3022001_009",
    "unit_id": 2511
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……等等，",
    "voice": "vo_adv_3022001_010",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "苑！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n不是說好要隱瞞妳跟彩羽交換身體的祕密了嗎！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n要是被發現了，會有很多麻煩的……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真是抱歉……",
    "voice": "vo_adv_3022001_011",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我們該怎麼辦？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "老實說租不到房子實在太慘了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不曉得有沒有什麼解決方法……？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……跟彩羽交換身體已經差不多一年了。",
    "voice": "vo_adv_3022001_012",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我既不會腰痛，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "也不會肩膀重、",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "手腳冰冷，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "或者莫名其妙偏頭痛。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "早上也不再低血壓，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真的是神一般的身體，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "但遇到這種情況就很困擾啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……啊，",
    "voice": "vo_adv_3022001_013",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "對了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我們還有彩羽啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "既然那孩子有大人的身體，",
    "voice": "vo_adv_3022001_014",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n那就讓她來處理吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……可是，",
    "voice": "vo_adv_3022001_015",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彩羽本質上根本還是個孩子喔！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n她有辦法處理租賃契約嗎……？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……對了，露易，",
    "voice": "vo_adv_3022001_016",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那鍊金術呢？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n能不能用鍊金術幫上什麼忙？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "對喔，",
    "voice": "vo_adv_3022001_017",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "還有這一招啊！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "交給我這個天才鍊金術師吧♪",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "現身吧！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "攜帶式鍊金釜！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "接下來～",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「基創鍊成」！",
    "voice": "vo_adv_3022001_018",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "好，完成了！",
    "voice": "vo_adv_3022001_019",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「手鍊型麻醉祕藥」和",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「蝴蝶結型變聲祕藥」！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我們用這個讓彩羽睡著，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "然後苑妳就變個聲音說話！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": "vo_adv_3022001_020",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "還是別用這招吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說，",
    "voice": "vo_adv_3022001_021",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽人呢？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "她嫌大人談事情很無聊，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n應該在這附近吃冰淇淋才對啊……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……苑，我沒看到人耶？",
    "voice": "vo_adv_3022001_022",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "等等……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "難道是走失了！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n該不會",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "被捲入了什麼事件之類的……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不、",
    "voice": "vo_adv_3022001_023",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不要說了啦，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好不吉利……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n唯獨彩羽她絕對不會──",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "男性們",
    "words": "呃啊啊啊啊啊啊～～～！！",
    "voice": "vo_adv_3022001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊哈哈──♪",
    "voice": "vo_adv_3022001_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑‧露易絲瑪莉",
    "words": "「彩羽！？」\\n「彩羽！？」",
    "voice": "vo_adv_3022001_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……露易。",
    "voice": "vo_adv_3022001_027",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我有種要命的不祥預感耶？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我也是！",
    "voice": "vo_adv_3022001_028",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n走吧，苑！！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊哈哈！",
    "voice": "vo_adv_3022001_029",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n各位大哥哥，",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
