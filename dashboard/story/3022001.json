    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那麼，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我就聽聽妳的說詞吧。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "看來在露易的心裡，",
    "voice": "vo_adv_3022001_063",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "審判長是很了不起的身分啊……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……真是受不了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好吧，彩羽，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那妳說說看吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯，",
    "voice": "vo_adv_3022001_064",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就是啊！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽原本坐在長椅上喔！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n然後就聽到遠方傳來了劍的聲音！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽過去一看啊！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n就看到很多穿著鎧甲的大哥哥",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "在練劍呢！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽就混進去，",
    "voice": "vo_adv_3022001_065",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "然後把所有人都打倒了！！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "宣判！",
    "voice": "vo_adv_3022001_066",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "一",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "百比零，是彩羽的錯！！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘖──！",
    "voice": "vo_adv_3022001_067",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "為什麼啊，不過就是小孩子的可愛胡鬧嘛。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n既然是大人，就該有大量啊～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不是……",
    "voice": "vo_adv_3022001_068",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彩羽妳的外表是大人啊。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n所以妳那不是小孩子的可愛胡鬧，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "而是豐滿劍士的失控舉動了。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "豐滿劍士的失控舉動？",
    "voice": "vo_adv_3022001_069",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "哇～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "這好像露易喜歡的那種，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n傷風敗俗小本本會有的標題～♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "什麼！！？",
    "voice": "vo_adv_3022001_070",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳妳、",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳在說什麼呢！？！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n我對那種傷風敗俗的書，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "可是一點興趣都沒有喔！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……唉，",
    "voice": "vo_adv_3022001_071",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "一切都結束了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n本來還對新生活感到興奮，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒想到竟然被打入大牢。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "期望與現實落差太大，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "耳鳴都要發作了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不過精靈耳不會耳鳴就是了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "原來精靈的耳朵",
    "voice": "vo_adv_3022001_072",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不會耳鳴啊～？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒事，我隨便說說的。",
    "voice": "vo_adv_3022001_073",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "總、",
    "voice": "vo_adv_3022001_074",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "總之，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我們要先好好說明清楚，解開誤會！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n至少必須讓他們明白我們並沒有惡意……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "要是被問東問西的會很麻煩，",
    "voice": "vo_adv_3022001_075",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "所以我是希望盡量隱瞞就好……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "但是這樣下去事情只會越來越糟糕不是嗎？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n所以只能說清楚了。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "告訴他們彩羽和苑的身心",
    "voice": "vo_adv_3022001_076",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彼此互換了，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n所以雖然彩羽的外表是大人，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "但實際上只是一個10歲的小女孩。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦……",
    "voice": "vo_adv_3022001_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那是因為",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "鍊金術的藥",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "造成的嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……是啊。",
    "voice": "vo_adv_3022001_078",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那是能夠讓身心互換的",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「禁忌祕藥」。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n其實那種藥就算讓身體互換，幾十分鐘後就會換回來……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n但彩羽和苑",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "卻已經互換了快一年──",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呃，妳是誰啊！？",
    "voice": "vo_adv_3022001_079",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_3022001_080",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不好意思。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我並不是有意偷聽的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "抱歉自我介紹晚了。",
    "voice": "vo_adv_3022001_081",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "公會管理協會的花凜。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "公會管理協會……？",
    "voice": "vo_adv_3022001_082",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "哇……",
    "voice": "vo_adv_3022001_083",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "這位綠色頭髮的大姐姐，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n感覺實力就跟惡魔一樣強喔……？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵，",
    "voice": "vo_adv_3022001_084",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不用對我那麼防備。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我是站在各位這邊的喔♪",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "露易絲瑪莉、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "彩羽",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "還有苑，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n三人才剛來到蘭德索爾就被關入大牢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她們多災多難的蘭德索爾生活就此展開。",
    "voice": null,
    "unit_id": null
  }
]
