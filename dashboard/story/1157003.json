  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霞跟{0}在海邊盡情玩耍後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再一次試著打聽出事件的情報。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼～",
    "voice": "vo_adv_1157003_000",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "吃得好飽。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生的豬排蓋飯",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "味道又如何呢？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼……",
    "voice": "vo_adv_1157003_001",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就開始偵訊吧。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你也差不多該說出口了吧？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你在搬運的貨物……",
    "voice": "vo_adv_1157003_002",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "究竟是什麼？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1157003_003",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就連對我也不能說嗎？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我不是想造成你的困擾。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1157003_004",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你是想說",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "保密義務嗎？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你也懂一些很艱深的詞呢。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等等，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這應該是我教你的……？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……唔。",
    "voice": "vo_adv_1157003_005",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n雖然作為偵探的助手，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "堅決守護委託人祕密的想法",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是非常正確的……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但是我很擔心啊。",
    "voice": "vo_adv_1157003_006",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n想說助手先生會不會",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n跟危險的事情扯上關係……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你是個很純真的人，",
    "voice": "vo_adv_1157003_007",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就算有人想利用你這單純的個性也不奇怪。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒問題，",
    "voice": "vo_adv_1157003_008",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔……",
    "voice": "vo_adv_1157003_009",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再繼續問下去也不是辦法。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我並非不相信助手先生……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但果然",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還是會擔心。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣的話，只能著手調查",
    "voice": "vo_adv_1157003_010",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n身為交易對象的那群男人──",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1157003_011",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "嗨，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "小哥。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔！？",
    "voice": "vo_adv_1157003_012",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "你還在這附近閒晃啊。",
    "voice": "vo_adv_1157003_013",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "嘻嘻嘻……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是剛才的男人們……！　",
    "voice": "vo_adv_1157003_014",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "這下正好。",
    "voice": "vo_adv_1157003_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n我們又有事情要拜託你了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "可以聽一下嗎……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "放心，",
    "voice": "vo_adv_1157003_016",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "只是件簡單的工作。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "\\n這是最後一次了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "拜託啦……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等、",
    "voice": "vo_adv_1157003_017",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等一下！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這可不行！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "啊？",
    "voice": "vo_adv_1157003_018",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n小姑娘有什麼事嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是一位偵探。",
    "voice": "vo_adv_1157003_019",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是活躍於蘭德索爾的……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "優秀偵探。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "妳說是偵探……！？",
    "voice": "vo_adv_1157003_020",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然表明身分會有危險，",
    "voice": "vo_adv_1157003_021",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但只要能讓他們因此不對助手先生出手的話……！　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "哦，",
    "voice": "vo_adv_1157003_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "原來是偵探啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n這下正好！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "我說小哥，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "你能不能跟這位偵探小姑娘",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n一起幫我找個東西？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "什麼！",
    "voice": "vo_adv_1157003_023",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不可以，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這樣太危險了！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "妳說危險～？",
    "voice": "vo_adv_1157003_024",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "或許是",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "這樣沒錯啦。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "對啊，",
    "voice": "vo_adv_1157003_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "雖然有點危險……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n但這位偵探不是很厲害嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "那應該很輕鬆吧……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這兩個男人難不成……",
    "voice": "vo_adv_1157003_026",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n打算把已經沒用且礙事的助手先生，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n還有打聽太多事情的我給解決掉嗎……！？　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……助手先生打算接下這份委託。",
    "voice": "vo_adv_1157003_027",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我不能放著不管……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我知道了，",
    "voice": "vo_adv_1157003_028",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就這麼辦吧。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也會一起去。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "答應我這是你們最後一次利用助手先生了。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "沒問題，",
    "voice": "vo_adv_1157003_029",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "我答應妳……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "\\n這就是最後了……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只要肯聽話就沒有其他用處了，",
    "voice": "vo_adv_1157003_030",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是這個意思嗎……！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n真是狡猾……！　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好、",
    "voice": "vo_adv_1157003_031",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好的。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我一定會保護你……！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "拜託你們囉，",
    "voice": "vo_adv_1157003_032",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "欸嘿嘿……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "兩個人要同心協力……",
    "voice": "vo_adv_1157003_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "嘻嘻嘻……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "霞",
