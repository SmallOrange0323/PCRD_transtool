    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "地圖。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大概在這附近……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "有很多魔物，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是很危險的地方……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒事的，",
    "voice": "vo_adv_1329002_016",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡我也去過。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n也有和你一起去過對吧。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那裡的話，",
