    "type": "dialogue",
    "name": "伊緒",
    "words": "交給我們吧！",
    "voice": "vo_adv_1329002_017",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我們一定會把他們帶回來！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……為了",
    "voice": "vo_adv_1329002_018",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓他安心而說了大話，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但一直找不到呢……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n明明是熟悉的森林，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "現在卻感覺寬廣很多。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯，",
    "voice": "vo_adv_1329002_019",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "去公會管理協會詢問線索的時候，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n應該要請多一點人來幫忙才對嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也想避免大家去搜索反而自己也遇難的情況……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "等一下，",
    "voice": "vo_adv_1329002_020",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n仔細看……",
    "voice": null,
    "unit_id": 132912
  },
