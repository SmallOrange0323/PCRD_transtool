[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，在蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n步未今天也仔細地「觀察」著{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩，",
    "voice": "vo_adv_1055009_000",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "今天也好帥……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然這麼說，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但最近我們變得比較不常一起打工呢～",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我們除了去約會，",
    "voice": "vo_adv_1055009_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還一起打倒了魔物。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明發生了許多可以跟{0}前輩增進感情的事件，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "結果到頭來",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還是只能遠遠看著他……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "最後一次",
    "voice": "vo_adv_1055009_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "跟前輩好好說話是什麼時候啊？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我本來就很不起眼，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒什麼存在感了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n再這樣下去，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "他說不定會把我忘掉……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "要是我跟其他人一樣",
    "voice": "vo_adv_1055009_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有個性，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "或是開朗一點，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n是不是就能跟{0}前輩更要好了？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "如果想把自己變成那樣，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "又該怎麼做才好呢……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "……然後啊，",
    "voice": "vo_adv_1055009_004",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n因為他",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "喜歡開朗又引人注目的女生，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我就參考了鈴奈的說話方式，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "嘗試營造出這種感覺～",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那位模特兒鈴奈，",
    "voice": "vo_adv_1055009_005",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "明明跟妳一點也不像耶。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "不過，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "能靠這種方式成功跟喜歡的人交往，或許很厲害呢……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "畢竟她是大家憧憬的對象呀～♪",
    "voice": "vo_adv_1055009_006",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n只要模仿有名的人，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "自己也會受到大家喜愛！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n這真是個好主意，對吧～？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……感覺聽到了一個好主意。",
    "voice": "vo_adv_1055009_007",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只要調查{0}前輩喜歡的類型，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n再模仿那個人就好了……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總之，",
    "voice": "vo_adv_1055009_008",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "先繼續觀察{0}前輩，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n看他跟哪種女孩子講話時，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "會感到很開心好了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然調查過程可能會很辛苦，",
    "voice": "vo_adv_1055009_009",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也不曉得會不會有效果……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但必須從自己做得到的事情",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "開始才行……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "已經跟著{0}前輩走了一段時間……",
    "voice": "vo_adv_1055009_010",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "他應該是出來購買公會需要的食材吧？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……啊，",
    "voice": "vo_adv_1055009_011",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是【美食殿堂】的貪吃佩可小姐！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n她好像跟{0}前輩聊得很開心。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "得仔細聽聽他們都在聊些什麼話題！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "讓我聽聽看……",
    "voice": "vo_adv_1055009_012",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦……？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n怎麼好像",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一直在聊今天的晚餐，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n還有貪吃佩可小姐餓到肚子咕嚕咕嚕叫而已……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過{0}前輩看起來很開心……",
    "voice": "vo_adv_1055009_013",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n說不定",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "他喜歡",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總是餓著肚子，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n並說著食物話題的女孩子！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我算不上是",
    "voice": "vo_adv_1055009_014",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "很能吃的類型啊……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不對，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "正因如此才要參考前輩跟貪吃佩可小姐的對話，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n並好好模仿才行……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "得把肚子為什麼咕嚕咕嚕叫的原因",
    "voice": "vo_adv_1055009_015",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也都記錄下來。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我寫我寫……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "貪吃佩可小姐走掉後，",
    "voice": "vo_adv_1055009_016",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n只剩下{0}前輩一個人了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "看他還留在市場，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是有其他想買的東西嗎？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": "vo_adv_1055009_017",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有人接近{0}前輩了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦！？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個人難不成是",
    "voice": "vo_adv_1055009_018",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "空花！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n兩人似乎聊起來了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n不曉得",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是怎麼看待空花的呢？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "乍看之下……",
    "voice": "vo_adv_1055009_019",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "兩人好像",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "都很開心……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n得移動到",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可以聽見對話的位置才行……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "到這邊就沒問題了吧？",
    "voice": "vo_adv_1055009_020",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩露出非常安穩，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "彷彿看破世間的表情附和著，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n究竟在聊",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "什麼話題呢……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯嗯……",
    "voice": "vo_adv_1055009_021",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦……！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n空花她在妄想",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
