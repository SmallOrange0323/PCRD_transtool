    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n好像是……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "惡魔之類的？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
