    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看見他的表情了嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我不用動刀",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就成功讓他短命了！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "background",
    "bg_id": "500790"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "……就算在這裡，這也是只有幹部等級才知道這個情報喔。",
