    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n聽說那個人，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "似乎不是人類呢。",
