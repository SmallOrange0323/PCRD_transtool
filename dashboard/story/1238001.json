[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【王宮騎士團】結束了與獸人族的和平活動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茉莉進行了一場超級英雄秀，幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n身穿兔子族鎧甲的克莉絲提娜出現在{0}面前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊，",
    "voice": "vo_adv_1238001_000",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "找到了找到了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，終於找到你了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我突然想起來還沒有問你的感想呢。",
    "voice": "vo_adv_1238001_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n所以特地穿成這樣來找你。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "心懷感激吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧，小子，告訴我。",
    "voice": "vo_adv_1238001_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你覺得",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我穿這身鎧甲",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼了，",
    "voice": "vo_adv_1238001_003",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "其他人的反應都像晴天霹靂一樣，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n嘴巴上倒是讚不絕口哦？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不用見外，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你也坦率地",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "表達內心的感受吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦♪",
    "voice": "vo_adv_1238001_004",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想也是。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哪裡適合我？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你覺得哪個地方特別適合我？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不用見外，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "仔仔細細地、",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "鉅細靡遺地",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說出來吧☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嘿，小姐。",
    "voice": "vo_adv_1238001_005",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n那邊那位可愛的",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "小姐。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦？",
    "voice": "vo_adv_1238001_006",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳",
    "voice": "vo_adv_1238001_007",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "滿可愛的嘛～",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n要不要跟我去",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喝杯麥酒呀？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喲喲？",
    "voice": "vo_adv_1238001_008",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你這傢伙難道是",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在搭訕我嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嗯，",
    "voice": "vo_adv_1238001_009",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "是啊。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦。",
    "voice": "vo_adv_1238001_010",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，你看不出來嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我現在身邊",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可是有男伴呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你打算強取豪奪嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嗯，",
    "voice": "vo_adv_1238001_011",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳確實是帶著男伴。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n但妳看起來是",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "軟綿綿的可愛類型呀？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n感覺妳是那種積極主動一點就有機會的女孩嘛～",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "積極主動一點、",
    "voice": "vo_adv_1238001_012",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就有機會的、",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "女孩",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你說我嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這傢伙",
    "voice": "vo_adv_1238001_013",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該不會……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我問你一個問題。",
    "voice": "vo_adv_1238001_014",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你知道「克莉絲提娜」",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這號人物嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "克莉絲提娜？",
    "voice": "vo_adv_1238001_015",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n當然知道啊～",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "她超有名的耶。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不過，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "比起她那種類型的，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳這種軟綿綿的更對我的胃口啦～♪",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "果然是這樣……！",
    "voice": "vo_adv_1238001_016",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我的穿著打扮跟平時判若兩人，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這傢伙",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "根本沒認出我是誰……！　",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來如此？",
    "voice": "vo_adv_1238001_017",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯……",
    "voice": "vo_adv_1238001_018",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可有意思了♪",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──走吧，小子！",
    "voice": "vo_adv_1238001_019",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想到了有趣至極的消遣方式☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "咦，",
    "voice": "vo_adv_1238001_020",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳就這樣走了！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n那我呢？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂──！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_1238001_021",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來問問大家",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "關於克莉絲提娜的看法。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來只要穿上了這個，",
    "voice": "vo_adv_1238001_022",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "周圍的人就認不出來是我了呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我穿上這個隱藏真實身分，",
    "voice": "vo_adv_1238001_023",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "假借採訪的名義，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n向民眾打聽一下自己的風評，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是這樣的玩法。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼樣，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聽起來很有意思吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "畢竟",
    "voice": "vo_adv_1238001_024",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "平時不會有人來跟我講他的意見呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我覺得偶爾聽聽民眾的心聲",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也是一種樂趣呀♪",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯？",
    "voice": "vo_adv_1238001_025",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼了，小子，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你在擔心什麼？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "萬一有難聽的批評，",
    "voice": "vo_adv_1238001_026",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會很受傷？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈☆",
    "voice": "vo_adv_1238001_027",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n根本是杞人憂天，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也不想想我是誰！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──走了，小子！",
    "voice": "vo_adv_1238001_028",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我當主要採訪員，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你來當副手。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "對克莉絲提娜這個人有什麼看法？",
    "voice": "vo_adv_1238001_029",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n雜誌要做關於她的專題報導嗎，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "唔……簡單來說，",
    "voice": "vo_adv_1238001_030",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "就是生人勿近",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "的感覺吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n該說是「敬鬼神而遠之」嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "就各方面來說，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那個人都算是危險人物吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦，",
    "voice": "vo_adv_1238001_031",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼個危險法呀？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "唔……",
    "voice": "vo_adv_1238001_032",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不是有個",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "傳聞嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n一站在她身後，小命就不保了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "偷偷跟你們說，",
    "voice": "vo_adv_1238001_033",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我認識隔壁鎮的一個人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "聽說他叔公的",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n雙胞胎孫子裡的弟弟，好像認識那個站在克莉絲提娜身後，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n下場很悽慘的人呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "怎麼想",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "都很危險吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦，",
    "voice": "vo_adv_1238001_034",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "克莉絲提娜？",
    "voice": "vo_adv_1238001_035",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "哎呀，該怎麼說呢……",
    "voice": "vo_adv_1238001_036",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n那個女人偶爾會出現在",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我的夢裡呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "沒有，",
    "voice": "vo_adv_1238001_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我們不認識呀？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我只聽過傳聞，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "從沒見過本人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "但她還是出現在我夢裡了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "多麼厚臉皮的人啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我往懸崖下面一看，",
    "voice": "vo_adv_1238001_038",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "那個女人就在那裡，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "嘴巴張得大大的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我心裡想著，會被吃掉，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "千萬不能過去……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "越想越覺得",
    "voice": "vo_adv_1238001_039",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "自己要被那響亮的笑聲",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "給拽下懸崖。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n就是那樣一場惡夢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "該死，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "我們明明素昧平生啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "抱歉，我失態了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "那應該是",
    "voice": "vo_adv_1238001_040",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "「瘋狂」吧……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n寫作瘋狂，唸作克莉絲提娜……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1238001_041",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "她最近給人的印象是為和平做出貢獻，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n或是為了民眾表現很活躍吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "喔！",
    "voice": "vo_adv_1238001_042",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "妳說之前獸人族那件事嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "大家都議論紛紛的呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "很驚訝那個克莉絲提娜會做出那些事。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_1238001_043",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那就是因為和平活動",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "大大改善了人們的印象囉──",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "不不不，",
    "voice": "vo_adv_1238001_044",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "怎麼可能會改善啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "那個戰鬥狂",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "不可能會協助維持和平的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "大部分的人都覺得她很可疑啊。",
    "voice": "vo_adv_1238001_045",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n說這一切都是為了推翻國家所佈下的局。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "唉……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "感覺又要出現在我的夢裡了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦。",
    "voice": "vo_adv_1238001_046",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你是指什麼？",
    "voice": "vo_adv_1238001_047",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n……你問我",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還要不要繼續？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然要啊，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有什麼不繼續下去的理由嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼？",
    "voice": "vo_adv_1238001_048",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "實際一打聽，發現盡是一些不中聽的風評，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你擔心我是不是受傷了？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1238001_049",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈☆",
    "voice": "vo_adv_1238001_050",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你又在擔心這種無關緊要的事嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我都說了，你這是杞人憂天。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "輿論是好是壞都無所謂。",
    "voice": "vo_adv_1238001_051",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n比被蟲咬還要不痛不癢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……最重要的",
    "voice": "vo_adv_1238001_052",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都不是這些。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你也看見了吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那些貶低我的人，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那副生氣勃勃的表情。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當面貶低對方……",
    "voice": "vo_adv_1238001_053",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當面被貶低……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這簡直就是",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "刀劍相向的",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "愛意交歡啊☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n太令人激動了……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "太熱血沸騰了！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那",
    "voice": "vo_adv_1238001_054",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1238001_055",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……當然。",
    "voice": "vo_adv_1238001_056",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦，是的，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我才不是那種會因為負面評價而受傷的人。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的心情反而很愉悅呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……但這是怎麼回事呢？",
    "voice": "vo_adv_1238001_057",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看見這小子滿心關切又沉重的表情，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "心裡居然",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有些內疚……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該不會──",
    "voice": "vo_adv_1238001_058",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓小子陪我這麼嬉鬧，",
    "voice": "vo_adv_1238001_059",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n反而給他帶來不必要的心痛，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n難道我是為此感到自責嗎！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會有這種感受……？　",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1238001_060",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……呵呵。",
    "voice": "vo_adv_1238001_061",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，真不愧是你啊。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你是第一個讓克莉絲提娜我",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感到內疚的人呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你可是第一個男人啊☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好吧！",
    "voice": "vo_adv_1238001_062",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看在這項創舉",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "的份上，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我就來徹徹底底地消除你的擔憂吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你沒聽明白嗎？",
    "voice": "vo_adv_1238001_063",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也就是說，我會讓你看到厭煩為止，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看我發自內心享受採訪的模樣。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓你沒有多餘的閒情逸致",
    "voice": "vo_adv_1238001_064",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感到擔憂！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "要我聊聊對克莉絲提娜的看法？",
    "voice": "vo_adv_1238001_065",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n咦～",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "絕對不要讓我露臉喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "要幫我打馬賽克喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "……",
    "voice": "vo_adv_1238001_066",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "那是在她",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "還是副團長的時候的事了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n有些任務是要在這裡過夜的。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n據說那時有人看見了",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "她的「睡臉」。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦，",
    "voice": "vo_adv_1238001_067",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有意思。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後呢？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "聽說啊，",
    "voice": "vo_adv_1238001_068",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "她眼睛",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "都不會閉上耶。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n就這樣睜著眼一整晚，還睡得很死。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "很恐怖吧？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "傳聞說只要跟她對到眼，",
    "voice": "vo_adv_1238001_069",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "靈魂就會被奪走耶。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n我從來不敢靠近那個人的值班室半步。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "只是謠傳而已啦。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "但聽起來有夠真實的。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "哇～",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "恐怖恐怖。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔～",
    "voice": "vo_adv_1238001_070",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難怪我可以睡得那麼安穩。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "謝謝你們的體貼啊。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，士兵。",
    "voice": "vo_adv_1238001_071",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你可真是",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有眼無珠啊！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好好看清楚了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我正是克莉絲提娜本人。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "噫",
    "voice": "vo_adv_1238001_072",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "噫噫噫噫噫噫！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n噫！？",
