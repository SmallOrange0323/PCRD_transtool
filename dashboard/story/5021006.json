  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你們看！",
    "voice": "vo_adv_5021006_042",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n奄美魔物們一個個地離開玩偶們體內了！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為再也無法控制了，",
    "voice": "vo_adv_5021006_043",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "逼不得已只好被迫離開了呢～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這下子",
    "voice": "vo_adv_5021006_044",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "終於……！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不，",
    "voice": "vo_adv_5021006_045",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還沒結束。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "奄美魔物全都聚集起來了～！？",
    "voice": "vo_adv_5021006_046",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "奄美魔物",
    "words": "――咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 11911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂，",
    "voice": "vo_adv_5021006_047",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "它們聚集……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n成了一個超巨大的怪物啦！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "感覺到一股強大的力量～！",
    "voice": "vo_adv_5021006_048",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "光是待在附近，",
    "voice": "vo_adv_5021006_049",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "全身的力量似乎就要消失了……！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "難不成",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "它打算恣意地奪走我們的靈魂！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那種事",
    "voice": "vo_adv_5021006_050",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是不會發生的。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主？",
    "voice": "vo_adv_5021006_051",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真步……",
    "voice": "vo_adv_5021006_052",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真的生氣了～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然敢隨便玩弄人家重要的夥伴們，",
    "voice": "vo_adv_5021006_053",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這份回禮……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不回不行呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "難得的機會，",
    "voice": "vo_adv_5021006_054",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就讓你盛大地",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n幫我們製造一些夏日的美好回憶吧。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家，",
    "voice": "vo_adv_5021006_055",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要上了！",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "喔！",
    "voice": "vo_adv_5021006_056",
    "unit_id": null
  },
