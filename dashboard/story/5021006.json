  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們只會更加劣勢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n得想辦法解決現狀了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家想讓大家度假",
    "voice": "vo_adv_5021006_020",
    "unit_id": 110611
