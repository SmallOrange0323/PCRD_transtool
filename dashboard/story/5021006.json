  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對方數量太多了，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一隻一隻嚇下去，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們遲早會被解決掉的！",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "乾脆直接攻擊它們――",
    "voice": "vo_adv_5021006_006",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那可不行！",
    "voice": "vo_adv_5021006_007",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我做不到～！",
    "voice": "vo_adv_5021006_008",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為我每天都看著公主細心地呵護它們！",
    "voice": "vo_adv_5021006_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以救出它們時，一定要讓它們保持完美的狀態～♪",
    "voice": "vo_adv_5021006_010",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……大家真是",
    "voice": "vo_adv_5021006_011",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好孩子呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也得去幫忙才行。",
    "voice": "vo_adv_5021006_012",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "亞瑟它們能夠拜託您照顧嗎。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您。",
    "voice": "vo_adv_5021006_013",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真步！",
    "voice": "vo_adv_5021006_014",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　往妳那裡去了～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_5021006_015",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "危險！",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……剛才的行動，",
    "voice": "vo_adv_5021006_016",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好像有點奇怪？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然突然往王子先生那裡衝去……？",
    "voice": null,
    "unit_id": 110611
  },
