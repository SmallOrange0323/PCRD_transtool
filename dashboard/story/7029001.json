    "voice": "vo_adv_7029001_032",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "祈梨她呀，",
    "voice": "vo_adv_7029001_033",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要我態度一放軟，就會被她爬到頭上呢～",
