[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天{0}\\n也到珠希賣鯛魚燒的攤位來幫忙了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，一直以來都謝謝你了喵～♪",
    "voice": "vo_adv_1079003_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我特別",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "把鯛魚燒這香脆的薄片部分留給你呢喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "來來，",
    "voice": "vo_adv_1079003_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你別客氣，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "把嘴張開啊……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鯛魚燒的姐姐～！",
    "voice": "vo_adv_1079003_002",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_1079003_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是之前我送過妳貝殼的小女孩啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是來買鯛魚燒的喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯，",
    "voice": "vo_adv_1079003_004",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不過還有一件事，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳看這個！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯？",
    "voice": "vo_adv_1079003_005",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這張紙是做什麼的喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1079003_006",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "是張藏寶圖哦～♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "藏、",
    "voice": "vo_adv_1079003_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "藏寶圖！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是貨真價實的藏寶圖喵！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯，",
    "voice": "vo_adv_1079003_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "這是當作謝禮送給妳的哦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "快和那位哥哥",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "一起去找找看吧！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": "vo_adv_1079003_009",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是為何啊喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "因為",
    "voice": "vo_adv_1079003_010",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "你們兩人",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不是一對情侶嗎？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "姐姐",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "一定要讓哥哥好好跟著才行哦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我我我、",
    "voice": "vo_adv_1079003_011",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "才不是什麼情侶呀喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": "vo_adv_1079003_012",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們看起來像喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還真是有點害羞呢喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "很危險的，",
    "voice": "vo_adv_1079003_013",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "你們一定要兩個人一起去找才可以哦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那麼再見囉～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、",
    "voice": "vo_adv_1079003_014",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "店門一關我們就出發去探險尋寶吧喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": "vo_adv_1079003_015",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然現在是挺暗的，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過地圖上寫著是夜晚才能找到的寶物，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們去找找看吧喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯～",
    "voice": "vo_adv_1079003_016",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還只限定夜晚，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "或許是真的有什麼東西也喵不定……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過那孩子不像是會為了惡作劇這麼投注心力啊喵～",
    "voice": "vo_adv_1079003_017",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之我們就過去看看嘛喵！",
    "voice": "vo_adv_1079003_018",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "搞不好",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "會是個很厲害的寶藏也說不定呢喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我看看，",
    "voice": "vo_adv_1079003_019",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "首先朝東方前進吧喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n按照標記所示的位置……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "寶藏似乎是在海邊的樣子呢喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯……",
    "voice": "vo_adv_1079003_020",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我在海邊這裡並沒有看見什麼類似的東西呀喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n難道是藏在沙灘下面了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沿著海岸走過去",
    "voice": "vo_adv_1079003_021",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "或許可以發現什麼也說不定喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們繼續前進看看喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然在海岸附近這邊發現了洞窟……",
    "voice": "vo_adv_1079003_022",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n真是不該走進洞裡啊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "應該說，",
    "voice": "vo_adv_1079003_023",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們是不是迷路了喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而且，",
    "voice": "vo_adv_1079003_024",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說起來這地圖也看不出洞窟中的路線喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這這這、",
    "voice": "vo_adv_1079003_025",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這該怎麼辦喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要是不擺脫這困境的話……！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而且這裡，",
    "voice": "vo_adv_1079003_026",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼暗岩石坑坑窪窪的……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這地方感覺一整個毛骨悚然喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你快看那邊！",
    "voice": "vo_adv_1079003_027",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那座岩洞怎麼看起來像一張臉呀喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵～開玩笑的……",
    "voice": "vo_adv_1079003_028",
    "unit_id": 107911
  },
  {
    "type": "still",
    "still_id": "107900301"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵啊！？",
    "voice": "vo_adv_1079003_029",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "別因為害怕就抓著我的尾巴喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n剛才只是開了點玩笑喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "still",
    "still_id": "107900302"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦欸！",
    "voice": "vo_adv_1079003_030",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "剛才，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你有沒有聽見女人在哭泣的聲音喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而且我腳底下似乎有什麼東西呀喵！",
    "voice": "vo_adv_1079003_031",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我好像踩到什麼了喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "話說，",
    "voice": "vo_adv_1079003_032",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你幹嘛趁亂抱住人家啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": "vo_adv_1079003_033",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抱上去的人是我啊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n真是抱歉了喵，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "感覺有點",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "可怕啊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "still",
    "still_id": "107900303"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哇啊！",
    "voice": "vo_adv_1079003_034",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我好像被絆倒了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是詛咒啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是洞窟的詛咒啊喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為了防止人接近寶藏，",
    "voice": "vo_adv_1079003_035",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n謎之力量在阻礙著我們喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵……",
    "voice": "vo_adv_1079003_036",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "突然覺得好累啊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯？",
    "voice": "vo_adv_1079003_037",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那就是",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "洞窟出口了嗎！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "快點！",
    "voice": "vo_adv_1079003_038",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們快離開這裡喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": "vo_adv_1079003_039",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這裡是，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "瑪爾傑海岸……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒想到居然會和這種地方相通呢喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯？",
    "voice": "vo_adv_1079003_040",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼了喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你怎麼指著天空……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "510272"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵……",
    "voice": "vo_adv_1079003_041",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "多麼美麗的星空啊喵……！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我還是第一次見到這麼大顆的星星啊喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "感覺星星就要落下了一般呢喵……",
    "voice": "vo_adv_1079003_042",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵！？",
    "voice": "vo_adv_1079003_043",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好大的流星啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然我知道其實距離還很遠，",
    "voice": "vo_adv_1079003_044",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n但看起來就像是要落在這附近一樣呢喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以，",
    "voice": "vo_adv_1079003_045",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對了，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就像那塊大岩石一樣……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那，",
    "voice": "vo_adv_1079003_046",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那塊大岩石！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "和地圖所標記的大岩石長的一模一樣呀喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們去那塊岩石下挖挖看吧喵！",
    "voice": "vo_adv_1079003_047",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯？",
    "voice": "vo_adv_1079003_048",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這難道就是……！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "太棒了！",
    "voice": "vo_adv_1079003_049",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是寶箱呢喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "終於找到了喵—！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "箱子裡面是……",
    "voice": "vo_adv_1079003_050",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是貝殼，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還有一封信？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_1079003_051",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這些貝殼、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "全部都是貓的形狀呢喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "信上寫著……",
    "voice": "vo_adv_1079003_052",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "「這是這片海岸最美麗的地方哦。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要和哥哥永遠幸福快樂呦！」",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這麼一段話呢喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這些貝殼，",
    "voice": "vo_adv_1079003_053",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一定是",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那位小女孩為我們收集過來的喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是我們女生之間的祕密喵～",
    "voice": "vo_adv_1079003_054",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": "vo_adv_1079003_055",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這裡",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有寶藏呢喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "珠希向{0}展現笑容\\n並且為能一起來尋寶而道謝。",
    "voice": null,
    "unit_id": null
  }
