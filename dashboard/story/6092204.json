  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そういえば君、",
    "voice": "vo_adv_6044204_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "泳げないんだよね？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "だったら",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "この天才魔法少女ナナカちゃんにお任せあれ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n新開発の魔法で",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "君も渚のスイマーだー！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そんじゃ、",
    "voice": "vo_adv_6044204_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "コイツを喰らえーっ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "どうどう？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "こうやって腰から下を魚にすれば、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "絶対泳げるっしょ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "え？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "戻してほしい？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "なんでさ！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "えっとねー、",
    "voice": "vo_adv_6044204_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "いくつかあるんだけど、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "この体が金属になる魔法とかどう？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "これなら",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "海の底を悠々と歩けるって寸法ですぞ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "いやっふーって感じで！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "……うん？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "泳げるようになってない？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "こりゃ一本取られましたにゃ～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "問答無用じゃーい！　",
    "voice": "vo_adv_6044204_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "喰らえ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "足が止まらなくなる魔法！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nこれにかかれば",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "泳げなくても足が勝手にバタ足し続けるのだー！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "あっ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "避けた！？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "やりおるのう……！",
    "voice": null,
    "unit_id": 113311
  }
]
