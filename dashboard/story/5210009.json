  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}將關係人聚集在宴會會場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n向真正的凶手這麼說道──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "什麼！？",
    "voice": "vo_adv_5210009_000",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為為為、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為什麼是我！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不對，難道是我嗎！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "騙，",
    "voice": "vo_adv_5210009_001",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "騙人的吧，小騎士。",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小鳳不可能做這種事的！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n對吧？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "……不會對吧？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "對啊對啊對啊！",
    "voice": "vo_adv_5210009_002",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "說到底",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我也差點遇害了不是嗎！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n你說我到底犯了什麼罪呀！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "！！！！！！！",
    "voice": "vo_adv_5210009_003",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "！！！！！！！",
    "voice": "vo_adv_5210009_004",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "！！！！！！！",
    "voice": "vo_adv_5210009_005",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "！！！！！！！",
    "voice": "vo_adv_5210009_006",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不不不！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "雖然我順勢驚嚇了一下！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n但你這句話是什麼意思啊！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "原來如此，",
    "voice": "vo_adv_5210009_007",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小鳳的確",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "是個美女……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是、",
    "voice": "vo_adv_5210009_008",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是啊，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "有一種神聖的優雅……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不，",
    "voice": "vo_adv_5210009_009",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "沒有啦，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "這………………",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嗯，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "畢竟我是非常偉大的",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "神明嘛？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "美麗又華麗？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "的確是事實？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "要是達到鳳凰大人一般的境界，",
    "voice": "vo_adv_5210009_010",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n光是存在",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "就足以魅惑一切……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "的確",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "可說是罪孽深重的存在呢。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "鳳凰就是美之傳說！",
    "voice": "vo_adv_5210009_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "小鳳傳說由此展開！！",
    "voice": "vo_adv_5210009_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "怎麼淨說這些真話……",
    "voice": "vo_adv_5210009_013",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……嘿、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嘿嘿嘿嘿……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我有那麼美麗嗎？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嗯……",
    "voice": "vo_adv_5210009_014",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好吧，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "既然你們說到這個份上，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那就沒辦法了！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我就爽快一點",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "承認自己的罪刑吧！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "民眾",
    "words": "唔哦哦哦哦哦────────！",
    "voice": "vo_adv_5210009_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嘿嘿嘿嘿……",
    "voice": "vo_adv_5210009_016",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咦、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我們原本",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "到底在討論什麼呢？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我說騎士先生？",
    "voice": "vo_adv_5210009_017",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "這副手銬是怎麼回事？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "很失禮喔！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "別這樣別這樣別這樣！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n奇──────怪──",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "────！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鳳凰就這樣認罪並接受審判，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被判處要用拔下的羽毛製作和服之刑──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不……",
    "voice": "vo_adv_5210009_018",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小鳳的確是很可愛沒錯……",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但這麼對她會不會太過分了？",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過",
    "voice": "vo_adv_5210009_019",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能打破「差點遇害的人不會是凶手」",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這先入為主的觀念，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你真厲害呢。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以此為前提，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再推理一次看看吧。",
    "voice": null,
    "unit_id": 137412
  }
]
