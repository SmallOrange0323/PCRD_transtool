[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美美、禊與鏡華三個人和平常一樣，\\n在蘭德索爾一起遊玩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "妳們看妳們看～我畫了兔子先生～很可愛吧～♪",
    "voice": "vo_adv_3013002_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，是很可愛……",
    "voice": "vo_adv_3013002_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過加上角比較酷呦！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不、不可以啦～禊～！",
    "voice": "vo_adv_3013002_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n因為這幅畫是要給哥哥看的～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥？",
    "voice": "vo_adv_3013002_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n美美有哥哥嗎？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～是祕密呦～♪",
    "voice": "vo_adv_3013002_004",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唔－－－－！",
    "voice": "vo_adv_3013002_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "美美小氣鬼－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n沒關係！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊也不告訴美美哥哥的事！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳們兩個都在說哥哥、哥哥的，",
    "voice": "vo_adv_3013002_006",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n不知道妳們在說什麼……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要更認真集中精神在公會活動上！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是～雖然說是公會活動，",
    "voice": "vo_adv_3013002_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n今天不就只是在畫圖嘛！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為今天美美猜拳贏了，所以就做美美想做的事。",
    "voice": "vo_adv_3013002_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n才會三個人一起畫圖呦。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣就是公會活動～？好無－趣！",
    "voice": "vo_adv_3013002_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊以為公會就是要做些更帥氣的事－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊如果猜拳贏了，",
    "voice": "vo_adv_3013002_010",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n也會一起做禊想做的事呦。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是，如果太奇怪的事是不會准許的～",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "噗－－－！",
    "voice": "vo_adv_3013002_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n鏡華這個認真鬼－－－！優等生－－－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊，妳那樣說，",
    "voice": "vo_adv_3013002_012",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n到底是在罵人，還是稱讚人",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我搞不懂呦。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～可愛的兔子先生～♪",
    "voice": "vo_adv_3013002_013",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n把這幅畫給哥哥～……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎麼了，美美？",
    "voice": "vo_adv_3013002_014",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美今天有事呢！",
    "voice": "vo_adv_3013002_015",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不快點走不行了！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼今天的公會活動就到此為止吧。",
    "voice": "vo_adv_3013002_016",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "贊－成！",
    "voice": "vo_adv_3013002_017",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，禊接下來做什麼好呢～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對了！想起一件好玩的事了！",
    "voice": "vo_adv_3013002_018",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也要回家了－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "禊拜～拜！",
    "voice": "vo_adv_3013002_019",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華也是～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊，美美再見。",
    "voice": "vo_adv_3013002_020",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……呼～我該做些什麼好呢。",
    "voice": "vo_adv_3013002_021",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "回精靈之森還太早，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但在蘭德索爾也只有他們兩個玩伴……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……啊！之前遇到的那個人，不知道還在不在？",
    "voice": "vo_adv_3013002_022",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總覺得是個奇怪的人，不過稍微找尋一下他吧……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，找到了！",
    "voice": "vo_adv_3013002_023",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "今天也是到處東張西望呢！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n還是老樣子，像個可疑份子。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "午安。",
    "voice": "vo_adv_3013002_024",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你東張西望的在做什麼呢？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？迷路了嗎？",
    "voice": "vo_adv_3013002_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唉……你到底要到何時",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n才會熟悉這個城鎮的道路呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真拿你沒辦法，我來替你帶路。",
    "voice": "vo_adv_3013002_026",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "有地圖或是筆記之類的東西嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是筆記嗎。咦……",
    "voice": "vo_adv_3013002_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n難道說你是和別人有約嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n約定的時間似乎快到了呦？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不快一點的話會來不及的！",
    "voice": "vo_adv_3013002_028",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n用跑的吧！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哈、哈、哈……",
    "voice": "vo_adv_3013002_029",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那個去目的地最短的路線就是轉過這條巷子……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "痛痛痛……",
    "voice": "vo_adv_3013002_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什麼，這是……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "陷阱？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好、好痛！",
    "voice": "vo_adv_3013002_031",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請讓開！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n為什麼走在前面的我掉下去了之後，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你也跟著就這樣掉下來了！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀哈哈哈！中計了中計了－！",
    "voice": "vo_adv_3013002_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "奇怪？這個笑聲是……？",
    "voice": "vo_adv_3013002_033",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哥哥，不要緊吧－！？",
    "voice": "vo_adv_3013002_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我現在就把繩子放下去，所以爬上來吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥不多注意一下周圍是不行的呦！",
    "voice": "vo_adv_3013002_035",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊不是說過很多次，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要小心陷阱～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊！",
    "voice": "vo_adv_3013002_036",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這個陷阱是禊挖的嗎！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？鏡華？",
    "voice": "vo_adv_3013002_037",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為什麼妳和哥哥在一起？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我正在替這個人帶路。",
    "voice": "vo_adv_3013002_038",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊妳為什麼也會認識這個人？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊是哥哥的教官～",
    "voice": "vo_adv_3013002_039",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為了讓遲鈍的哥哥不要掉進陷阱",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n正在特訓！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好像是個很適合的人選，又好像錯得很離譜……",
    "voice": "vo_adv_3013002_040",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊！不好了！",
    "voice": "vo_adv_3013002_041",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n約定時間已經過了喔！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們快點走吧！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的特訓很嚴格呦～對吧，哥哥……",
    "voice": "vo_adv_3013002_042",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？鏡華、哥哥，你們要去哪？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "等等我－！！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哈、哈、哈……",
    "voice": "vo_adv_3013002_043",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "馬，馬上就到會合地點了！",
    "voice": "vo_adv_3013002_044",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n在那家店前面……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！",
    "voice": "vo_adv_3013002_045",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥～！我在這裡呦～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "美、美美！？",
    "voice": "vo_adv_3013002_046",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n連美美都認識這個人嗎！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華？禊？",
    "voice": "vo_adv_3013002_047",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "為什麼妳們兩個人會與和哥哥在一起～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥？",
    "voice": "vo_adv_3013002_048",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "美美的哥哥是指哥哥嘛～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美呢～正在教哥哥繪畫和寫字喔～",
    "voice": "vo_adv_3013002_049",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "讓，讓美美教嗎……明明是個大人……",
    "voice": "vo_adv_3013002_050",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是個讓人放不下心的人呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這、這種說法",
    "voice": "vo_adv_3013002_051",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "聽起來好像就只有我是壞人呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "明、明明是大人……",
    "voice": "vo_adv_3013002_052",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過你都失去記憶了，這也是沒辦法的事。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我知道了。",
    "voice": "vo_adv_3013002_053",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我也來幫忙教這個人學習。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒關係的，鏡華。",
    "voice": "vo_adv_3013002_054",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為，美美要一個人教～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦！？可、",
    "voice": "vo_adv_3013002_055",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是兩人一起教",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這個人也能吸收快一點吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美一個人沒問題的呦～",
    "voice": "vo_adv_3013002_056",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對吧？哥哥～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "只有美美太奸－詐了！",
    "voice": "vo_adv_3013002_057",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們三人是一個公會，也讓禊參加嘛－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "可是，禊功課又不好……",
    "voice": "vo_adv_3013002_058",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊可以教運動！",
    "voice": "vo_adv_3013002_059",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "美、美美也好，禊也罷……都太信任這個人了！",
    "voice": "vo_adv_3013002_060",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個人可是變態可疑分子呦！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦～才沒有這麼一回事～",
    "voice": "vo_adv_3013002_061",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是嘛－，",
    "voice": "vo_adv_3013002_062",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣的話鏡華就離哥哥遠一點！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、我是擔心妳們兩個，所以才在監視這個人！",
    "voice": "vo_adv_3013002_063",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "懂了吧！",
    "voice": "vo_adv_3013002_064",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n如果你對這兩個人做出奇怪的事，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我就會讓這顆防御魔石發出警示聲！",
    "voice": null,
    "unit_id": 103611
  },
  {
