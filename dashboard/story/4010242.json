  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的……",
    "voice": "vo_adv_4010242_000",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n突然說要我來幫忙整理房間，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你到底在想什麼啊？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你這個人每次約好了時間都會遲到，",
    "voice": "vo_adv_4010242_001",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "作業也老是丟著不寫，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n真的很會讓人操心耶……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "照這樣看來，",
    "voice": "vo_adv_4010242_002",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "他不記得今天是什麼日子吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……害我還有",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一點點期待的說……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊～！？",
    "voice": "vo_adv_4010242_003",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你幹嘛！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嚇、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嚇我一大跳！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "害我都不小心大聲尖叫了啦！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_4010242_004",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "原來你",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "記得我的生日嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你叫我來是……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝……！",
    "voice": "vo_adv_4010242_005",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n嘿嘿……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真的有",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "被驚喜到了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可、",
    "voice": "vo_adv_4010242_006",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你還是嚇到我了！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n嚇人是不好的行為，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請你反省！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你看看，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我都被你嚇到腿軟，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "動彈不得了啦！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀",
    "voice": "vo_adv_4010242_007",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是幹嘛？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說是動彈不得，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但也不至於……！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "變、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "變態──",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……不對。",
    "voice": "vo_adv_4010242_008",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這是公主抱，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "他就像王子一樣──",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "──但這種舉動",
    "voice": "vo_adv_4010242_009",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "果然還是太過刺激了，不行！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "變態可疑分子────────！",
    "voice": "vo_adv_4010242_010",
    "unit_id": 103631
  },
  {
    "type": "movie",
    "movie_id": "401016401"
  },
  {
    "type": "background",
    "bg_id": "509015"
  },
  {
    "type": "background",
    "bg_id": "510201"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喔，",
    "voice": "vo_adv_4010242_011",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "死黨公。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n突然叫我出來",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是怎麼了嗎？",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "景色？",
    "voice": "vo_adv_4010242_012",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "聽你這麼一說，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這高處的視野",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還真不錯啊。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然冷風陣陣，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但應該就快要停了。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "倒不至於讓人待不住。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……啊。",
    "voice": "vo_adv_4010242_013",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "去冥府的醫院報到那段時期",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "好像也是這樣的季節。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n用那雙比現在還短的腿",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "一步一步費力地走著……",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……算了，",
    "voice": "vo_adv_4010242_014",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "當我沒說。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "都是過去的事了。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "忘了吧。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "話說回來，",
    "voice": "vo_adv_4010242_015",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n你今天",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "到底是在搞什麼鬼啊？",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊啊，",
    "voice": "vo_adv_4010242_016",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "確實是到了那個時期……",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……等等，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我有跟你透露過我的生日嗎？",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也罷。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "倒也不必",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "糟蹋你的一番好意。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "再說，",
    "voice": "vo_adv_4010242_017",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這景色",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我也挺喜歡的。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "跟那些有形之物不同，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "死後應該也能帶著上路吧。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "謝啦，",
    "voice": "vo_adv_4010242_018",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "{0}。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "生日這東西，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "對我而言只是個充滿陰霾的壞日子……",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不過多虧你為我帶來了一陣風，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "讓我覺得心裡",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "稍稍",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "舒坦了點。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂喂喂。",
    "voice": "vo_adv_4010242_019",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n再繼續這樣欠你人情下去的話，",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n到時我恐怕就連付給三途川擺渡人的六文錢都湊不齊了啊。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "算了……",
    "voice": "vo_adv_4010242_020",
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有道是",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "好人做到底嘛。",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n{0}，既然你這麼閒",
    "voice": null,
    "unit_id": 135931
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就陪我去掃墓吧──",
    "voice": null,
    "unit_id": 135931
  }
]
