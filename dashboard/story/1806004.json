[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與凱留\\n為了報告已討伐了巨大魔物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而走在前往王宮的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": "vo_adv_1806004_000",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "累了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n趕快解決煩人的報告就回去吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且我的肚子已經餓到不行了……",
    "voice": "vo_adv_1806004_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也不可能在那個村子要吃的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還要留意不能讓肚子叫出聲來。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊──真是的，",
    "voice": "vo_adv_1806004_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "肚子餓到眼前一片白……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是真的在發光啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是怎麼一回事────！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "510351"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………",
    "voice": "vo_adv_1806004_003",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………",
    "voice": "vo_adv_1806004_004",
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "510201"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唉……",
    "voice": "vo_adv_1806004_005",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n為什麼我會這麼悲慘啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼「沒有必要去畢業旅行」啊。",
    "voice": "vo_adv_1806004_006",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n明明都在一些沒意義的事情上花錢，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n為什麼對小孩的花費就就這麼小氣啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "既然妳要把錢都花在那些無聊的地方，",
    "voice": "vo_adv_1806004_007",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我就自己去打工賺那筆錢了啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊──那也不可能是嗎。",
    "voice": "vo_adv_1806004_008",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "反正肯定會說我是在幹壞事，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n然後叫我把打工辭掉吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我的人生，",
    "voice": "vo_adv_1806004_009",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "還真的是一塌糊塗呢……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我也想要去畢業旅行……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n跟大家一起開心度過，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "吃好吃的東西……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "到底是",
    "voice": "vo_adv_1806004_010",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "為什麼，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "連這樣理所當然的事情都……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什、",
    "voice": "vo_adv_1806004_011",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是你！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "為什麼你會在這種地方！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊！？",
    "voice": "vo_adv_1806004_012",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "為什麼要做這麼噁心的事情啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你是我的跟蹤狂嗎！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……你說一直跟著我，",
    "voice": "vo_adv_1806004_013",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n也就是說，我剛剛的自言自語都被你聽到了對吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是啊，",
    "voice": "vo_adv_1806004_014",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是這麼無可救藥的不幸，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n所以才會一個人沉浸在不幸裡。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n如果不這樣做就沒辦法繼續活下去呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你笑啊。",
    "voice": "vo_adv_1806004_015",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不只是媽媽，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你也是。\\n就讓我這樣悽慘下去就好。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "反正我的人生都已經沒救了。",
    "voice": "vo_adv_1806004_016",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "對啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "乾脆就這樣讓人嘲笑著活下去吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真是充滿笑容的美好人生呢！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你那是什麼臉啊，",
    "voice": "vo_adv_1806004_017",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是在可憐我嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "別了吧，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那種事情可是一點用都沒有呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "對了，",
    "voice": "vo_adv_1806004_018",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "要像之前那樣把錢包丟過來嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那樣的話我會很高興喔。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "說的是呢，",
    "voice": "vo_adv_1806004_019",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那樣也好。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你也不要跟我扯上關係比較好。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "在學校也是，",
    "voice": "vo_adv_1806004_020",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我媽媽很糟糕這件事",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n也在私底下傳開了呢……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "以往會跟我說話的人也開始漸漸疏遠了……",
    "voice": "vo_adv_1806004_021",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就算可以參加畢業旅行……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "也只會……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你！！",
    "voice": "vo_adv_1806004_022",
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "180600401"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你說我是哪裡沒問題啊！",
    "voice": "vo_adv_1806004_023",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n有個無可救藥的媽媽，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n身為小孩的我也束手無策！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "又見不到真那大人！",
    "voice": "vo_adv_1806004_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n結果在我身邊的，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n就只有像你這種莫名其妙的傢伙！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你到底是什麼意思啊！",
    "voice": "vo_adv_1806004_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n放著不要管我不就好了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我可是會在這種地方，自己一個人說個不停的危險人物喔！",
    "voice": "vo_adv_1806004_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你就跟班上的同學一樣離開就好！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～啊。",
    "voice": "vo_adv_1806004_027",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你是個天賦異稟，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n還有一堆錢的人嘛。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "既然如此你別待在這裡，",
    "voice": "vo_adv_1806004_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n隨便去個地方都能獲得幸福吧！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你這人……",
    "voice": "vo_adv_1806004_029",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你這人……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "510201"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………哈哈。",
    "voice": "vo_adv_1806004_030",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果依靠你的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我也就到此為止了吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就跟把一切都賭在我身上的媽媽毫無區別嘛。",
    "voice": "vo_adv_1806004_031",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n笨蛋中的笨蛋，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "大笨蛋。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真的是，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "無藥可救。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1806004_032",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你想說我是好孩子所以沒問題嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這個世界才沒有這麼天真……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你、",
    "voice": "vo_adv_1806004_033",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你突然說什麼啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "請不要這麼光明正大地，說些跟蹤狂的發言好嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我打算怎麼做……？",
    "voice": "vo_adv_1806004_034",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……",
    "voice": "vo_adv_1806004_035",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……這樣啊。",
    "voice": "vo_adv_1806004_036",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "的確，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是這樣呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n跟媽媽才沒有關係。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "跟班上的同學也是，",
    "voice": "vo_adv_1806004_037",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n他們要怎麼看我",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就怎麼看吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我跟媽媽才不一樣，",
    "voice": "vo_adv_1806004_038",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這點我可以很有自信地說。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只要像以往一樣、好好地過日子，",
    "voice": "vo_adv_1806004_039",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n讓班上的人看到我……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不能參加畢業旅行雖然很遺憾，",
    "voice": "vo_adv_1806004_040",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但是，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n旅行的話我自己也可以去對吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "等我長大之後，",
    "voice": "vo_adv_1806004_041",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就可以靠我自己的能力去到更好的地方。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不過……",
    "voice": "vo_adv_1806004_042",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "果然還是想去海邊呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n都特地去挑泳衣了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼？",
    "voice": "vo_adv_1806004_043",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "所以就說我不能去畢業旅行……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "等等，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n想去海邊的話，直接去就好了對吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好啊，",
    "voice": "vo_adv_1806004_044",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "走吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "既然是你提的，那你會負責出交通費吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……啊啊，",
    "voice": "vo_adv_1806004_045",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "所以你剛剛才沒把錢包拿出來啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不過，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就算有帶那時候你也不會拿出來吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯，",
    "voice": "vo_adv_1806004_046",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "算了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "一步一步慢慢地，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n靠著自己的力量來實現也不錯呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我們走路過去海邊吧，",
    "voice": "vo_adv_1806004_047",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我可不准你說不要喔！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1806004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們在那之後還真的走路到海邊了呢。",
    "voice": "vo_adv_1806004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n花了不少時間啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到了的時候天色暗到什麼都看不見，",
    "voice": "vo_adv_1806004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n凱留還發了一堆牢騷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "即便如此，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她的表情卻出乎意外地爽朗呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "凱留的遭遇雖然真的很辛苦，",
    "voice": "vo_adv_1806004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但是她本性不壞，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只要有願意好好看著她的人，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就沒問題了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為有你好好地看著她……",
    "voice": "vo_adv_1806004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以我沒有太擔心，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不過如果能有更多像你這樣的人就好了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就成為她與人們之間的那座橋梁吧。",
    "voice": "vo_adv_1806004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼下次再見了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦、",
    "voice": "vo_adv_1806004_054",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難道我……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "剛剛睡著了嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "累積太多疲勞真的是沒好事呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且我好像還夢到了什麼很奇怪的夢……",
    "voice": "vo_adv_1806004_055",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你！？",
    "voice": "vo_adv_1806004_056",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突然說什麼啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且被你這樣說，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總覺得有種很奇怪的感覺啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的！",
    "voice": "vo_adv_1806004_057",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，趕快去報告吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一步一步慢慢地，",
    "voice": "vo_adv_1806004_058",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總有一天，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也會成為像你這樣的人喔。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這樣說著的同時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留邁著輕盈的步伐，\\n朝向通往王宮的道路前進。",
    "voice": null,
    "unit_id": null
  }
]
