[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}在早上散步時，\\n遇見正在送報紙的美冬。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼、呼、呼……",
    "voice": "vo_adv_1048008_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀，早安。",
    "voice": "vo_adv_1048008_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你在散步嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我從早上開始就在打工喔。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "必須送的報紙還有這麼多呢……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀？ 這是什麼，從報紙縫隙中透出了光……",
    "voice": "vo_adv_1048008_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1048008_003",
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你！ 謝謝你今天過來！",
    "voice": "vo_adv_1048008_004",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好期待採草莓呀！",
    "voice": "vo_adv_1048008_005",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n情侶參加的話入場費只要半價，機會難得呢！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為採草莓有時間限制，我們有效率地採吧！",
    "voice": "vo_adv_1048008_006",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "外帶的份也要喔！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "still",
    "still_id": "104800801"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯――，在有限的時間內，",
    "voice": "vo_adv_1048008_007",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要怎麼做才能有效地採草莓呢……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "草莓似乎未必大顆就一定好呢。",
    "voice": "vo_adv_1048008_008",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "必須綜合性地判斷甜度、顏色、光澤，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n查出草莓的「品質」才行……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你從那邊開始判斷草莓的「品質」，",
    "voice": "vo_adv_1048008_009",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n然後放進外帶盒裡。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "加油！ 你一定做得到！！",
    "voice": "vo_adv_1048008_010",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "話說回來，這個盒子也太小了吧……",
    "voice": "vo_adv_1048008_011",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了。",
    "voice": "vo_adv_1048008_012",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n將草莓塞在腋下或兩胸之間帶回去如何？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你不能放在褲子裡嗎？",
    "voice": "vo_adv_1048008_013",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，果然還是太過違反規定啊……",
    "voice": "vo_adv_1048008_014",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "算了，沒關係，只要有外帶盒的草莓就好。",
    "voice": "vo_adv_1048008_015",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……我想帶弟弟妹妹們的份回去啊。",
    "voice": "vo_adv_1048008_016",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為我們家有很多食慾旺盛的孩子嘛。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原本我會總是在打工，過著節儉的生活，",
    "voice": "vo_adv_1048008_017",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是因為我想讓家人過著舒適的生活。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，對。剛剛坦白的那些事情，你是第一個知道的喔？",
    "voice": "vo_adv_1048008_018",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n不要……告訴別人喔？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？ 你說如果有什麼幫得上忙的，你也會幫忙？",
    "voice": "vo_adv_1048008_019",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵呵，謝謝。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣的話，乾脆……你要不要也成為我的家人？",
    "voice": "vo_adv_1048008_020",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n當作我家的支柱……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵呵，我開玩笑的。嗯，摘不了這麼多草莓呢。",
    "voice": "vo_adv_1048008_021",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n來，嘴巴張開，啊――。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好吃嗎？ 呵呵，太好了。",
    "voice": "vo_adv_1048008_022",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管美冬有意無意地岔開話題，但仍\\n一邊細細品嘗草莓的酸甜，一邊在心中\\n想著：今天真是美好的一天阿。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？ 這是我給你的禮物！ 你做了個好『夢』嗎？",
    "voice": "vo_adv_1048008_023",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照你跟美冬以前的記憶創造出來的『夢』，",
    "voice": "vo_adv_1048008_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n原來現在的你會採取這樣的行動呀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且還是採草莓，真羨慕啊～。",
    "voice": "vo_adv_1048008_025",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也好想去呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～♪",
    "voice": "vo_adv_1048008_026",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊！ 這裡是……",
    "voice": "vo_adv_1048008_027",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "剛剛的是夢？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦，你也做了一樣的夢啊……",
    "voice": "vo_adv_1048008_028",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，我努力賺錢是為了弟弟妹妹們的事，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n被你知道了呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "又被你知道",
    "voice": "vo_adv_1048008_029",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我新的一面了啊……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但、但我也不討厭這樣……啦。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是說，我送報紙的工作遲到了！",
    "voice": "vo_adv_1048008_030",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再見……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦，你也要幫忙？",
    "voice": "vo_adv_1048008_031",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好――，那就有效率地邊慢跑邊送報紙",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n來鍛鍊體力喔！ 跟著我！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬和{0}今天也度過了\\n有效率且愉快的一天……",
    "voice": null,
    "unit_id": null
  }
]
