    "name": "鈴莓",
    "words": "呀啊啊啊！？",
    "voice": "vo_adv_1098006_066",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "身高根本碰不到為什麼能把燈給弄掉……？",
    "voice": "vo_adv_1098006_067",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…………",
    "voice": "vo_adv_1098006_068",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊嗚嗚……",
    "voice": "vo_adv_1098006_069",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明明就已經請人幫忙了，",
