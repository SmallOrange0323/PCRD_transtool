[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在拉姆們暫時居住的咲戀育幼院裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "身為育幼院女僕的鈴莓，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n似乎正在拜託拉姆一些事情。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "女僕指導……",
    "voice": "vo_adv_1098006_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為什麼拉姆得去做這種事呢？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的……",
    "voice": "vo_adv_1098006_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳或許隱約有察覺到……",
    "voice": "vo_adv_1098006_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n其實我，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很冒失。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這件事大家都知道。",
    "voice": "vo_adv_1098006_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是，",
    "voice": "vo_adv_1098006_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這跟要拉姆做女僕指導有什麼關聯嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個，",
    "voice": "vo_adv_1098006_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為雷姆小姐她總是在說。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n姊姊是自己的理想，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有比姊姊更棒的女僕了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "既然那麼厲害的女僕雷姆小姐都那麼說了，",
    "voice": "vo_adv_1098006_006",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那我想拉姆小姐肯定是",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "女僕的頂點。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "女僕界的傳奇！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以說，",
    "voice": "vo_adv_1098006_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拉姆小姐……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不對，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拉姆師傅！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請對我，",
    "voice": "vo_adv_1098006_008",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "進行不再冒失的女僕指導吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拜託了～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……事情我了解了。",
    "voice": "vo_adv_1098006_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "確實就如雷姆所說的。",
    "voice": "vo_adv_1098006_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆是個超級優秀的女僕。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是很遺憾。",
    "voice": "vo_adv_1098006_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆現在非常地忙碌。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "實在是沒空照顧鈴莓妳。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是、",
    "voice": "vo_adv_1098006_012",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是這樣嗎……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "本來還以為大小姐帶著小孩子們出去的這個時候！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是個好機會的說……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是啊。",
    "voice": "vo_adv_1098006_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……雖然妳這麼說，",
    "voice": "vo_adv_1098006_014",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但卻是穩穩地坐在椅子上，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n悠閒地喝著……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "紅茶，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "鈴莓，",
    "voice": "vo_adv_1098006_015",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "休息也是重要的工作之一。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果不好好休息，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在關鍵時刻會派不上用場。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "隨時準備應對緊急狀況是女僕的職責。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "啊啊，真是忙碌。",
    "voice": "vo_adv_1098006_016",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚嗚……",
    "voice": "vo_adv_1098006_017",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拉姆小姐～～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "求求妳了～～！",
    "voice": "vo_adv_1098006_018",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "再這樣下去會失去當一個女僕的資格！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n今天早上煎荷包蛋時",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還把油給打翻了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "剛才我的頭，",
    "voice": "vo_adv_1098006_019",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "去撞到了餐具櫃的角落，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "幸好只是腫一個包而已，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還打破了小孩子們的馬克杯，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "然後明明幫大小姐泡的是紅茶",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但卻有咖啡的味道～～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到底怎麼做才會發生那種事。",
    "voice": "vo_adv_1098006_020",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆實在難以理解。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也不知道啊……",
    "voice": "vo_adv_1098006_021",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n明明我都有按部就班地，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "照著步驟來做。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一回過神來",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就會發生爆炸",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "或是損壞。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我到底該怎麼辦才好……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "──因為你站著完全不說話，拉姆還以為你睡著了，",
    "voice": "vo_adv_1098006_022",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n原來只是在發呆啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你希望拉姆幫一下鈴莓？",
    "voice": "vo_adv_1098006_023",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你以為你是誰啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "停止那種哀求的眼神吧。",
    "voice": "vo_adv_1098006_024",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你以為拉姆會屈服在這種威脅之下嗎……",
    "voice": "vo_adv_1098006_025",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……真是的。",
    "voice": "vo_adv_1098006_026",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "茶都變難喝了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果不管如何都希望拉姆指導的話也不是不可以。",
    "voice": "vo_adv_1098006_027",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆可是很嚴格的哦。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n無論妳身陷什麼狀況拉姆都絕對不會幫忙。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真、",
    "voice": "vo_adv_1098006_028",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的可以嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果這樣妳能接受的話就做好心理準備吧。",
    "voice": "vo_adv_1098006_029",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "非、",
    "voice": "vo_adv_1098006_030",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "非常感謝妳～～～～！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼，",
    "voice": "vo_adv_1098006_031",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我從現在開始來打掃房間！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果有什麼在意的事，",
    "voice": "vo_adv_1098006_032",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請盡量跟我說吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拉姆師傅，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拜託妳了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿咻……",
    "voice": "vo_adv_1098006_033",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵，",
    "voice": "vo_adv_1098006_034",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然是很平常的打掃，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但只要一想到師傅正在看著，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就會特別有幹勁呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總覺得，",
    "voice": "vo_adv_1098006_035",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能做得比往常還要更好。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很好，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要加油囉～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "──呀啊啊啊啊啊啊！",
    "voice": "vo_adv_1098006_036",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對對對、",
    "voice": "vo_adv_1098006_037",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對不起～～！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "衝得太有幹勁結果沒注意看前面，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就撞到櫃子了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳在開玩笑嗎？",
    "voice": "vo_adv_1098006_038",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒在開玩笑！",
    "voice": "vo_adv_1098006_039",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我只是在認真打掃而已～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "重新振作起來，",
    "voice": "vo_adv_1098006_040",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n接著是，洗盤子！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "今天要注意不能打破盤子！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "育幼院的盤子已經所剩不多了。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……妳至今為止打破幾片盤子了？",
    "voice": "vo_adv_1098006_041",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我一開始還會去數，",
    "voice": "vo_adv_1098006_042",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是後來大小姐",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她跟我說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不需要數了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以我也不清楚……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "即使這樣，",
    "voice": "vo_adv_1098006_043",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也是很謹慎在工作的……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果、",
    "voice": "vo_adv_1098006_044",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然不可以太悠哉。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "洗盤子就是要俐落一點──",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哈哇哇哇──！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_1098006_045",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這已經不是女僕職業技術上的問題了……",
    "voice": "vo_adv_1098006_046",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊嗚嗚……",
    "voice": "vo_adv_1098006_047",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明明我是在打掃，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但房間卻變得越來越糟糕……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": "vo_adv_1098006_048",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "再這樣下去總有一天，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我搞不好會把重要的育幼院給破壞掉也說不定……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是……",
    "voice": "vo_adv_1098006_049",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這個咲戀育幼院裡的女僕是我。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我必須要做好它才行。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我到底該怎麼辦才好……",
    "voice": "vo_adv_1098006_050",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098006_051",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
