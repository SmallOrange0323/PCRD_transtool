    "voice": "vo_adv_1098006_053",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "別對自己的實力太有自信。",
    "voice": "vo_adv_1098006_054",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n如果自己做不到。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但又必須去工作。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n這時候妳覺得該怎麼辦才好？",
