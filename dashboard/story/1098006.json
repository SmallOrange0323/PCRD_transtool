    "words": "看我的──！！",
    "voice": "vo_adv_1098006_072",
    "unit_id": 102511
  },
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這、",
    "voice": "vo_adv_1098006_073",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳說要恢復原狀。",
    "voice": "vo_adv_1098006_074",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那為什麼會變成這樣？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚……",
    "voice": "vo_adv_1098006_075",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然我也不太清楚",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但房間變得像是在祭典狂歡一樣……",
