    "name": "旁白",
    "words": "雖然{0}開始幫忙",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n打掃房間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_1098006_062",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "窗簾破掉了呢。",
    "voice": "vo_adv_1098006_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_1098006_064",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "明明就沒用火為什麼會發生爆炸。",
    "voice": "vo_adv_1098006_065",
    "unit_id": 109811
  },
  {
