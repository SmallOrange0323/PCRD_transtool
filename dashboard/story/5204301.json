[
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呼哈……",
    "voice": "vo_adv_5204301_000",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "竟然能創造出這種不妙的生物，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n果然足以被叫做傳說中的鍊金術師呢……",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "哼，",
    "voice": "vo_adv_5204301_001",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "那是理所當然的啦！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我是天才鍊金術師瑪莉絲黛菈！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "這種程度的鍊金術，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "對我來說小菜一碟啦！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "哇──",
    "voice": "vo_adv_5204301_002",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好厲害！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽也想要鍊成生物～！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不可以喔，彩羽。",
    "voice": "vo_adv_5204301_003",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "人工生命體是禁忌的鍊金術……",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n居然連這種東西都染指……！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "果然要由我來阻止妳。",
    "voice": "vo_adv_5204301_004",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n做好覺悟了吧……",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "祖母！！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "所以就說",
    "voice": "vo_adv_5204301_005",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "誰是祖母啊！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我差不多",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "要氣炸了！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n荷姆荷姆，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "上吧！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "要來了喔！！",
    "voice": "vo_adv_5204301_006",
    "unit_id": 132311
  }
]
