  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "像這樣一同度過的和樂時光，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我想要",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "它永遠持續下去。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯，",
    "voice": "vo_adv_9004013_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也是這麼想的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……話說，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "從剛才開始，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我就聞到",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一股讓人餓扁的香氣呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇──",
    "voice": "vo_adv_9004013_015",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "味道好香！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那是因為我正在烤餅乾呀。",
    "voice": "vo_adv_9004013_016",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我想",
