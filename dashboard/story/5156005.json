[
  {
    "type": "background",
    "bg_id": "502390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "第二天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在格羅哥團的據點──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "布武機被要求修理因她而故障的車輛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "喝啊，",
    "voice": "vo_adv_5156005_000",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "快點修好！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n這個小屁孩！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好痛喔！",
    "voice": "vo_adv_5156005_001",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚嗚～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不要用鐮刀戳人家的屁股啦～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "吵死了！",
    "voice": "vo_adv_5156005_002",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n被你們背叛的老大的心",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "才痛百倍呢。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n讓你們活著",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "就要懂得感恩了！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "討厭。",
    "voice": "vo_adv_5156005_003",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n不要一直戳人家啦～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "搞清楚啊？",
    "voice": "vo_adv_5156005_004",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "在把妳弄壞的我們的腳，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n把所有車輛修好前，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "妳可沒飯吃喔！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "聽懂了沒？",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "這個",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "雜碎小屁孩！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚～",
    "voice": "vo_adv_5156005_005",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好苦喔～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n好餓喔～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機……！",
    "voice": "vo_adv_5156005_006",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n那根本是被當作奴隸呀……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……對不起，都是因為我……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對……",
    "voice": "vo_adv_5156005_007",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n因為我們",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不像布武機有利用價值……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "唔、",
    "voice": "vo_adv_5156005_008",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對不起。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "把你跟我相提並論。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "而且，",
    "voice": "vo_adv_5156005_009",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "竟然像這樣兩個人被關在牢裡，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n你一定覺得很擁擠吧。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對不起對不起……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……",
    "voice": "vo_adv_5156005_010",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我不能、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不道歉……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在那之後，",
    "voice": "vo_adv_5156005_011",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "被格羅哥團逮到……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n布武機被當作奴隸……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我們被關在牢裡……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊後來也下落不明。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可是，就算是姊姊，",
    "voice": "vo_adv_5156005_012",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n也難以想像",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "有辦法在那種情況下成功逃跑……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然我不想去想……",
    "voice": "vo_adv_5156005_013",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "都是我、",
    "voice": "vo_adv_5156005_014",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n毀了【蠻賊三姊妹】……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "…………",
    "voice": "vo_adv_5156005_015",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……你……",
    "voice": "vo_adv_5156005_016",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n不怪我呢。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不會責怪、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "失敗的我。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "…………",
    "voice": "vo_adv_5156005_017",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "要跟、",
    "voice": "vo_adv_5156005_018",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "你說……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗎……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真正的情形。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n就一點點。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "still",
    "still_id": "515600501"
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "…………",
    "voice": "vo_adv_5156005_019",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……姊姊她呢，",
    "voice": "vo_adv_5156005_020",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n如果不管她，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "就會一直做壞事。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "「我只能這樣生活」",
    "voice": "vo_adv_5156005_021",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "或者是",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "「正義和法律又為我做了什麼」",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n之類的……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "都是姊姊的口頭禪。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n只要是為了她想做的事，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "她才不管什麼規則。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "吵架早已是",
    "voice": "vo_adv_5156005_022",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "家常便飯──",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n驚動警察",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也是常有的事。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可是……",
    "voice": "vo_adv_5156005_023",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "即使像這樣肆意胡鬧，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n姊姊本身看來總還是",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "因為少了什麼，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "而感到焦躁。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "會不會有一天……",
    "voice": "vo_adv_5156005_024",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "有一天……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n在姊姊內心不斷沸騰的東西終於爆發，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n發生不可挽回的事，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我常這樣擔心……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那樣的話，",
    "voice": "vo_adv_5156005_025",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n姊姊會不會",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n從我和布武機的身邊",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "離開……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我",
    "voice": "vo_adv_5156005_026",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "一直都",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好害怕…………！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……所以，",
    "voice": "vo_adv_5156005_027",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我才把姊姊帶來「這個地方」。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n為了讓她",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在這裡紓壓。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對。",
    "voice": "vo_adv_5156005_028",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n──《阿斯特朗傳奇》。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呵呵，",
    "voice": "vo_adv_5156005_029",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可是",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "結果，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n在這裡",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也開始組起盜賊這樣危險的公會。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "一開始，",
    "voice": "vo_adv_5156005_030",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我想說是虛擬的世界，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n只要姊姊看起來很開心，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那就好了。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可是，",
    "voice": "vo_adv_5156005_031",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "慢慢地，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n在和你們戰鬥、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n欣賞相同景色的過程中……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": "vo_adv_5156005_032",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不可以帶給這些人困擾，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n壞事",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在哪個世界都是壞事……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我開始會這樣想……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "所以……",
    "voice": "vo_adv_5156005_033",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n一直……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "一直……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……唔！",
    "voice": "vo_adv_5156005_034",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我是故意……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "失敗的。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對……",
    "voice": "vo_adv_5156005_035",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "每當【蠻賊三姊妹】要做壞事時，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我就會故意開錯車……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "裝迷糊",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "搞破壞……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我總認為，",
    "voice": "vo_adv_5156005_036",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我得成為姊姊的剎車才行……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "…………",
    "voice": "vo_adv_5156005_037",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我原本以為，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "偷來的財寶只會用來重建我們家。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這次是",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "最後一次竊盜，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "為了幸福地生活下去",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "而做的。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……可是，",
    "voice": "vo_adv_5156005_038",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我錯了。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n姊姊說，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "她打算增強裝備，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好用於下一次的壞事……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "所以……",
    "voice": "vo_adv_5156005_039",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n失敗了，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "一如往常。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……但是，",
    "voice": "vo_adv_5156005_040",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n要讓暴衝的車輛急煞下來，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "會發生事故也是理所當然的。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我心裡也暗自明白，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "總有一天會出大事……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "所以，",
    "voice": "vo_adv_5156005_041",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "都是我的錯，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n毀壞了【蠻賊三姊妹】。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "都是因為我，",
    "voice": "vo_adv_5156005_042",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n只會耍故意失敗這種",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "卑鄙的小手段……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對不起",
    "voice": "vo_adv_5156005_043",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對不起……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我好想也跟姊姊這麼說……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "但已經……說不出口了……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚嗚……",
    "voice": "vo_adv_5156005_044",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "background",
    "bg_id": "502390"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "卑鄙呀……",
    "voice": "vo_adv_5156005_045",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳還挺有自知之明的嘛。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "──！？",
    "voice": "vo_adv_5156005_046",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊、",
    "voice": "vo_adv_5156005_047",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊……？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呀啊啊！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳、妳是幽靈嗎？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哇哈哈，",
    "voice": "vo_adv_5156005_048",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰知道呢。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳就用妳的眼睛……",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "確認吧！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n──怎樣……",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喝！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "background",
    "bg_id": "502390"
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "嗚呀！？",
    "voice": "vo_adv_5156005_049",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n噫噫噫噫！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "我的鐮刀……！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "竟然敢這樣招待我們家的布武機啊。",
    "voice": "vo_adv_5156005_050",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "要是不想頭被砍爛，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就把布武機交過來！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "嗚、",
    "voice": "vo_adv_5156005_051",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "唔…………",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n可惡……！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚嗚～",
    "voice": "vo_adv_5156005_052",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "倭姊～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n超可怕的～！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "倭，",
    "voice": "vo_adv_5156005_053",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "妳這傢伙……！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "抱歉啊，我可沒時間陪三流小混混玩。",
    "voice": "vo_adv_5156005_054",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我只是來回收失物，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "馬上就要閃人了。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "妳說什麼？",
    "voice": "vo_adv_5156005_055",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n而且妳背上背的，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "不正是我們的財寶嗎！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "瞧不起誰啊……！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "連要特地說出口都讓人不爽，",
    "voice": "vo_adv_5156005_056",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "但那些可是格羅哥團的戰利品！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n妳竟敢大搖大擺地扛回來，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n看來是不要命了吧！？",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼，",
    "voice": "vo_adv_5156005_057",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你還真敢說。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "明明是你們這些傢伙",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "讓扛著這玩意兒的我一個人大搖大擺地溜走。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "唔嗚嗚",
    "voice": "vo_adv_5156005_058",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "嗚……！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "\\n老大，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "團員１",
    "words": "老大啊啊啊！",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哼。",
    "voice": "vo_adv_5156005_059",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
