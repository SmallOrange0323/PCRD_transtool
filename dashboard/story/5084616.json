  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀～",
    "voice": "vo_adv_5084616_000",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n雖然常說能睡的孩子長得快，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但你有點賴床過頭囉……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是不是因為你總是太努力了，",
    "voice": "vo_adv_5084616_001",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n所以累積了一些疲憊呢……？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我想一定是那樣的，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但老師還是很擔心呢……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_5084616_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為你是乖孩子，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以會快快好起來的吧……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我會相信你、",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我會等著你的……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "拜託了……",
    "voice": null,
    "unit_id": 101512
  }
]
