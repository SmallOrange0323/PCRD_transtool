  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這件事啊～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家剛剛得知詳情後，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也很訝異……",
