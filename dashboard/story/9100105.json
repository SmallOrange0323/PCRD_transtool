    "type": "dialogue",
    "name": "半藏",
    "words": "成了無所適從的叛忍。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "\\n背負著不忠之徒的汙名。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "當然……",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "我們也",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "無處可去。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "然而，",
    "voice": "vo_adv_9100105_027",
