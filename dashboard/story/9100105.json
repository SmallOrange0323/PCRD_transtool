    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "這份恩情，",
    "voice": "vo_adv_9100105_028",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "我們必定會傾力報答。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "\\n所以，我們絕不能讓世界被摧毀。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "\\n走吧……",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "眾忍者們！",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "下忍們",
    "words": "是！",
    "voice": "vo_adv_9100105_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "呵呵呵……",
    "voice": "vo_adv_9100105_030",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "如果只聽信傳言……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "只看表面，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "根本沒有什麼是可以信賴的。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n若不是這樣，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "也只不過是一介魔物。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "半藏這傢伙……",
    "voice": "vo_adv_9100105_031",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這次找到一個好主人了呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "既然這樣，那也沒辦法了～！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你先前想徵收牧場的那件事，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就當作沒發生過吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦～？",
    "voice": "vo_adv_9100105_032",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我可是還感到耿耿於懷喔～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好啦好啦，",
    "voice": "vo_adv_9100105_033",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣也不錯啊♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n他們願意一起作戰，就讓我們信心大增了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "嗯，",
    "voice": "vo_adv_9100105_034",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n多虧大家的協助，我們聚集到了不少希望！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n有了這些希望，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "應該多少能削弱黑之王的力量……！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔喔！？",
    "voice": "vo_adv_9100105_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣我們就能打倒牠了吧！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就讓我狠狠地痛扁牠一頓吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n趕快把牠趕回",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "繪本的世界！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "繪本的……",
    "voice": "vo_adv_9100105_036",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n……那個，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲。",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n如果打倒黑之王，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳也得回去對吧？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "因為我只是趁亂跟過來的～",
    "voice": "vo_adv_9100105_037",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "當事情告一段落，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "黑之王就會回到繪本的世界。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n這樣一來，我也一樣",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "得回到繪本裡去。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣啊……",
    "voice": "vo_adv_9100105_038",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n難得我們又見到面，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是可惜……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳幹嘛那麼垂頭喪氣。",
    "voice": "vo_adv_9100105_039",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n說是離別……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "其實我們一直都在一起喔。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "無論",
    "voice": "vo_adv_9100105_040",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "什麼時候，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我都是妳的好夥伴。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "就這一點，妳一定要永遠記著……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲……",
    "voice": "vo_adv_9100105_041",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "的！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n那麼，我們走吧……！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n將所有的希望",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "統統都灌注在這弓箭上──",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "上吧──！！",
    "voice": "vo_adv_9100105_042",
    "unit_id": 112911
  }
]
