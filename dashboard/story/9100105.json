    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "吾等的公主。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "公……",
    "voice": "vo_adv_9100105_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "公主～！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "……那是襲擊了妳們的牧場後所發生的事。",
    "voice": "vo_adv_9100105_026",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "\\n我們捨棄原先的主人，",
    "voice": null,
    "unit_id": 13311
