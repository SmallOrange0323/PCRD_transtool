  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以像討伐魔物或是護衛等等，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n如果有這類工作希望你能介紹給我……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "老闆有知道的嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我想想……",
    "voice": "vo_adv_5137062_037",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n討伐魔物",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗎……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "哎呀～嚇死我了～！",
    "voice": "vo_adv_5137062_038",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "你們大家看到了沒？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n天空變得一片紅通通的呀！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "天空？",
    "voice": "vo_adv_5137062_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n……咦，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "難不成已經快要天亮了？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "不是那樣的啦。",
    "voice": "vo_adv_5137062_040",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n你們幾個是從幾點開始泡在這裡的啊……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊，來得正好。",
    "voice": "vo_adv_5137062_041",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "公所的大姐，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我問一下。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n之前那個被懸賞的魔物，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "應該",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "還沒有被打倒吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "是啊，",
    "voice": "vo_adv_5137062_042",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "還沒有呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "都是因為那魔物在這附近亂晃的關係，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n害得現在想去蘭德索爾都要費一番工夫……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "真讓人困擾啊。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "讓人困擾……",
    "voice": "vo_adv_5137062_043",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "如何啊，",
    "voice": "vo_adv_5137062_044",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這位客人。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n既然您對戰鬥本領有自信，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "要不要去試試看打倒那個魔物？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137062_045",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好主意！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我就去",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "打倒那個魔物吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這樣也可以獲得懸賞金，",
