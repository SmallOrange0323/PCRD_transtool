    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "話說……",
    "voice": "vo_adv_5137062_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這地方怎麼整個都紅紅的？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這難道是基礎世界",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "的預設外觀？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……嗯？",
    "voice": "vo_adv_5137062_004",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n怎麼回事？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "紅霧精靈",
    "words": "──嘎喔喔喔喔喔！",
