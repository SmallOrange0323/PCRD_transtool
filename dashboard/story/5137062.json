  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "看來花的那些時間和工夫也值得了。",
    "voice": "vo_adv_5137062_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n說真的，",
