    "unit_id": 10712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嘿咻。",
    "voice": "vo_adv_5137062_005",
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "500178"
  },
  {
    "type": "dialogue",
    "name": "紅霧精靈",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 10712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "唔嗯～",
    "voice": "vo_adv_5137062_006",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真不平靜。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "看來這邊的魔物感覺也挺多的呢。",
