  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那就麻煩你囉！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……你說你不會生火？　",
    "voice": "vo_adv_1082003_036",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "辦不到的話要早點說啦！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家還以為你會用那種魔法呢！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你、",
    "voice": "vo_adv_1082003_037",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你突然說那什麼話！？　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "腦漿都結凍了嗎！？",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……從書上看來的？　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嚇了我一大跳……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還以為你變成變態來的。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔唔，",
    "voice": "vo_adv_1082003_038",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果是跟{0}的話……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚嗚嗚嗚。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "果、果然還是會很害羞！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "絕對不行！　拒絕來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "除此之外的方法……",
    "voice": "vo_adv_1082003_039",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，看到了！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n裡面有動物的皮草來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這個洞窟",
    "voice": "vo_adv_1082003_040",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好像是獵人的休息室。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "有皮草在這邊，真是幫了個大忙～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我要把你跟我捲在一起。",
    "voice": "vo_adv_1082003_041",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要是你再昏過去，我可受不了。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "呼……",
    "voice": "vo_adv_1082003_042",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "跟剛才比起來舒服多了～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "像這樣跟你貼在一起很讓人安心呢～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}熱呼呼的，很溫暖來的！",
    "voice": "vo_adv_1082003_043",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子因為死了的關係所以身體冷冷的，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "反而覺得這樣更加暖和～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯……",
    "voice": "vo_adv_1082003_044",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子感覺",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好像有點想睡覺了……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n布丁冰棒……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好想吃……來……的……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嘶……嘶……",
    "voice": "vo_adv_1082003_045",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……啊，",
    "voice": "vo_adv_1082003_046",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子睡著了嗎！？　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "剛才好危險來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n如果我還沒死的話，就會死掉呢！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，你一直貼在我身上嗎？",
    "voice": "vo_adv_1082003_047",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "或許就是因為這樣吧。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為很放心才睡著來的。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "多虧了這皮草，",
    "voice": "vo_adv_1082003_048",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你的臉色也變好了一點。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我覺得氣溫也比剛才要來得溫暖一點呢。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "background",
    "bg_id": "500541"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "果然風雪已經停了～！",
    "voice": "vo_adv_1082003_049",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n我們順利活下來了～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這麼一來，終於可以吃到布丁冰棒了！",
    "voice": "vo_adv_1082003_050",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那個，我記得是在這附近……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好棒喔～！　",
    "voice": "vo_adv_1082003_051",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "變得硬梆梆來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n趕快來吃吧～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……嗯～♪　",
    "voice": "vo_adv_1082003_052",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "有種冰冰涼涼的口感，好好吃來的～♪",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一開始很像是雪酪來的……",
    "voice": "vo_adv_1082003_053",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不過放到嘴巴後，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n平常吃的布丁味道就一口氣在嘴裡擴散開來……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這的確是非常像布丁又不像布丁！　",
    "voice": "vo_adv_1082003_054",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "超革命性來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……哈啾！　",
    "voice": "vo_adv_1082003_055",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "雖然風雪停了，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n但果然在雪山吃冰冰的東西，還是會覺得冷呢……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……嘿！",
    "voice": "vo_adv_1082003_056",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嘿嘿嘿♪　",
    "voice": "vo_adv_1082003_057",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "只要這樣貼在一起的話，就會跟剛剛一樣溫暖了。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這麼一來，就可以吃很多布丁冰棒囉～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "謝謝你陪我過來呢！　{0}！",
    "voice": "vo_adv_1082003_058",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "緊靠在{0}身上，\\n宮子滿足地吃著期待已久的布丁冰棒。\\n此時她臉上露出的表情，比在店裡吃的時候還要來得更加幸福。",
    "voice": null,
    "unit_id": null
  }
]
