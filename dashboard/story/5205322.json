  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然很不願意，但是華音，",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們暫時休戰吧。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不願意可是我想說的台詞呢……",
    "voice": "vo_adv_5205322_001",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n就讓本小姐助妳一臂之力吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "來吧紡希，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "卯足幹勁，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一起放聲大喊──",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──喝啊啊啊啊啊啊啊啊啊啊啊啊啊！",
    "voice": "vo_adv_5205322_002",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": "vo_adv_5205322_003",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也要喊才可以嗎！？",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "──喝、",
    "voice": "vo_adv_5205322_004",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊啊啊……",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
