  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "地板上清晰地留下的若菜臀部痕跡，簡直就像「桃子」一樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在捕捉到那臀部的瞬間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬的墨鏡閃過一道銳利的光芒──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼……",
    "voice": "vo_adv_5214001_000",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "若菜小姐。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我已經完全恢復了。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "或許是那瓶飲料發揮效果了……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "太好了～！",
    "voice": "vo_adv_5214001_001",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這個「蜂蜜莎」，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好像",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "超級爆紅呢？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然是上週才剛上市，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "但大家好像都在喝，說是可以提振精神。",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n布武機的發明竟然能幫上別人，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "感覺還挺少見的呢。",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "欸，",
    "voice": "vo_adv_5214001_002",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那邊那位！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……沒錯，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是妳！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那位屁股像蜜桃一樣",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "的可愛女孩！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咿！？",
    "voice": "vo_adv_5214001_003",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呀、",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呀啊～！！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "為什麼突然摸人家的屁股啊！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳、",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳是誰啊！！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……這種多汁的手感……",
    "voice": "vo_adv_5214001_004",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果然我的眼光沒有錯。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我是",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "【墨丘利財團】的美冬。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我是來挖角妳參加「蜜桃碰撞淘汰賽」的。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜、栞",
    "words": "蜜桃碰撞",
    "voice": "vo_adv_5214001_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "若菜、栞",
    "words": "淘汰賽？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒錯──",
    "voice": "vo_adv_5214001_006",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那是決定世界上最強又最美臀部的戰場。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "簡略地來說，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是墨利村屁股相撲之類的東西吧。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "太、",
    "voice": "vo_adv_5214001_007",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "太簡略了吧……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個～",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "為什麼是我去參加那種比賽呢？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "確實最近，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "體重好像增加了一點點……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "但還不到能當相撲選手的程度啦……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳的屁股，",
    "voice": "vo_adv_5214001_008",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是被稱為百萬人之中才有一人的「蜜桃臀」。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "具備成為超一流臀士，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "傳說中的「桃鬥者」的素質！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是絕對有機會奪冠的逸材，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是逸臀才對！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……怎麼辦……",
    "voice": "vo_adv_5214001_009",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "她在說什麼我完全聽不懂……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "要在大家面前把屁股翹起來也太羞恥了……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "總、",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "總之先拒絕好了……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個……",
    "voice": "vo_adv_5214001_010",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "美冬小姐，",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個淘汰賽，",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也可以參加嗎？",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "欸！？",
    "voice": "vo_adv_5214001_011",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "栞、",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "栞小姐！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳應該是……",
    "voice": "vo_adv_5214001_012",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "初音的妹妹吧？",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是【伊麗莎白牧場】的栞",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我記得栞好像",
    "voice": "vo_adv_5214001_013",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "身體不太好，聽說比較虛弱。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看起來也是纖細又柔弱的類型，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n在嚴苛的「屁股世界」裡，真的能存活下來嗎……？",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯……？",
    "voice": "vo_adv_5214001_014",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "栞……",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "栞……",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "栞……",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n──────────",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "和尻的發音很接近──！？！？　",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵……",
    "voice": "vo_adv_5214001_015",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看來這裡也還",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "藏著一位呢。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能成為傳說「桃鬥者」的",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "器量的少女……！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": "vo_adv_5214001_016",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "已經出現第二個人了……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n與其說是傳說，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "更像是廉價拋售……？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然我的特訓很有效率，",
    "voice": "vo_adv_5214001_017",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但相對的也很嚴苛。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n完全不會手下留情。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我會把妳鍛鍊到屁股都變紅為止。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳跟得上嗎？",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "！！",
    "voice": "vo_adv_5214001_018",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……正、",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "正合我意！",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我會全力",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "加油的！",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
