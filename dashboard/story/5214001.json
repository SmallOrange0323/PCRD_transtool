  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在那時────",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501542"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──也就是說，",
    "voice": "vo_adv_5214001_059",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那群笨蛋正沉迷在用屁股互相碰撞的鬧劇裡，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "現在正是好機會，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對吧？",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳會協助我的吧？",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "同志倭小姐。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──",
    "voice": "vo_adv_5214001_060",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這提議不錯。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那個【墨丘利財團】可不是隨便就會露出破綻的……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就趁這場混亂的鬧劇，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "讓事情一步步推進下去吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵呵……",
    "voice": "vo_adv_5214001_061",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "明白了。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只要我和妳聯手，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那種財團根本不算什麼……",
    "voice": null,
    "unit_id": 2514
  }
