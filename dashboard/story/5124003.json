    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]小伙子！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這全是你的錯！！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "[FFFFFFFF]咦，",
    "voice": "vo_adv_5124003_076",
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "[FFFFFFFF]那、",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "[FFFFFFFF]那個，",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "[FFFFFFFF]呃……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]你、",
    "voice": "vo_adv_5124003_077",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]你們兩位，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這是怎麼回事！？",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那個……",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]你們不是死了嗎？",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]嗯～",
    "voice": "vo_adv_5124003_078",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這個嘛～",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]好像是死了，",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]又好像沒有死……",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]快點好好說明，",
    "voice": "vo_adv_5124003_079",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸！！",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]噫！",
    "voice": "vo_adv_5124003_080",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]忍好可怕！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]我說我說！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我會說明！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我全部都會說的～～～！！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]本來以為死了，卻突然復活的空花和骷髏老爸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n[FFFFFFFF]兩人身上究竟是發生了什麼事？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]要說明這件事，需要將時間稍稍往前回溯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n[FFFFFFFF]回到除靈第一天，「通靈術」失敗後，",
    "voice": null,
    "unit_id": null
  },
