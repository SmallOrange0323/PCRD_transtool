  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]虐待狂先生",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]要用什麼來玩呢？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]嗯……",
    "voice": "vo_adv_6124304_001",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]把異物塞入口中，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n[FFFFFFFF]隨心所欲地玩弄空花的口腔……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]流口水……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]虐待狂先生",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]真不愧是虐待狂……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]將空花的身體壓上吊床，",
    "voice": "vo_adv_6124304_002",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]看著明顯的繩子勒痕，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]滿足地微笑的虐待狂先生……？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]真棒……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]光是想像",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]就快要升天了……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124304_003",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]什麼……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]要讓其他人看見全身滑溜溜的空花，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]讓空花的羞恥心被逼至極限嗎！？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]意想不到的殘酷無情！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]這才是",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]虐待狂先生啊～！！",
    "voice": null,
    "unit_id": 127011
  }
