    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n還談什麼",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "信賴、",
