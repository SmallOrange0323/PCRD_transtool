    "type": "dialogue",
    "name": "告白者5",
    "words": "結果店裡賣的就變成紅色的青椒了～！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "都是我害的，對不起～！",
    "voice": null,
    "unit_id": 415
  },
  {
