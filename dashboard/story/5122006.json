    "type": "dialogue",
    "name": "優花梨",
    "words": "但怎麼就妳一個人",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "很有活力的樣子……？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "──！",
    "voice": "vo_adv_5122006_039",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n聽妳這麼一說……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "為什麼！？",
    "voice": "vo_adv_5122006_040",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n為什麼只有妳沒受到傷害！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這只是我的猜測。",
    "voice": "vo_adv_5122006_041",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就像我跟秋乃你們說過的一樣，",
    "voice": "vo_adv_5122006_042",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我是所有人公認的祕密主義者。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "無論是公開自己的隱私，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是去探聽別人的隱私，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這些",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我全都沒有興趣。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所謂的沒有興趣，",
    "voice": "vo_adv_5122006_043",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就是不管耳裡聽到了什麼，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也會像陣風一樣",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「咻──」",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "地，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n吹過去。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "恐怕",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "連罪惡感也隨之而去了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "原、",
    "voice": "vo_adv_5122006_044",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "原來如此……？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來我有著",
    "voice": "vo_adv_5122006_045",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "常人難及的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「祕密抵抗力」呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也是第一次知道這件事。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "祕密",
    "voice": "vo_adv_5122006_046",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "抵抗力……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣……",
    "voice": "vo_adv_5122006_047",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也就是說……？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "也就是說……？",
    "voice": "vo_adv_5122006_048",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "和正、漁協協會長",
    "words": "也就是說！？",
    "voice": "vo_adv_5122006_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122006_050",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是拿你們沒辦法呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "僅限這次喔。",
    "voice": "vo_adv_5122006_051",
    "unit_id": 126611
  },
  {
    "type": "still",
    "still_id": "512200601"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好了，",
    "voice": "vo_adv_5122006_052",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "下一位。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "告白者1",
    "words": "我、",
    "voice": "vo_adv_5122006_053",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "告白者1",
    "words": "我要告解……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "那個小房間裡，",
    "voice": "vo_adv_5122006_054",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "到底",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "在進行什麼事……？",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大家在對似似花",
    "voice": "vo_adv_5122006_055",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "告解祕密。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "告解？",
    "voice": "vo_adv_5122006_056",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "每個人都向她告解心中埋藏的祕密，",
    "voice": "vo_adv_5122006_057",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以得到她的赦免。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是在淨化祕密魔物。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "告白者1",
    "words": "我失業了，",
    "voice": "vo_adv_5122006_058",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "告白者1",
    "words": "而且是在一年前。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "告白者1",
    "words": "\\n可是我對家人說不出口……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……哼嗯。",
    "voice": "vo_adv_5122006_059",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "告白者2",
    "words": "男朋友送我５萬盧幣的戒指，",
    "voice": "vo_adv_5122006_060",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "告白者2",
    "words": "被我弄丟了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "告白者2",
    "words": "\\n我現在普通地戴著的，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "告白者2",
    "words": "其實是在100盧幣商店買的戒指……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……哦。",
    "voice": "vo_adv_5122006_061",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "感覺會破壞我的公眾形象，",
    "voice": "vo_adv_5122006_062",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "所以我無法公然說出來……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "我跟這傢伙",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "根本就沒有多要好。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "我們已經在一起這麼久了，",
    "voice": "vo_adv_5122006_063",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "牠卻連眼睛都不肯跟我對上。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "\\n對這傢伙來說，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "告白者3",
    "words": "我搞不好只是牠的棲木……！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……下一位。",
    "voice": "vo_adv_5122006_064",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不管是什麼樣的祕密",
    "voice": "vo_adv_5122006_065",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "都能極為冷淡地當作耳邊風，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n所以似似花不會受到傷害。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但是",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "能說出祕密，會讓告解者的心獲得解放。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以這就是共享祕密的最佳形式囉……！",
    "voice": "vo_adv_5122006_066",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "雖然我聽不太懂，",
    "voice": "vo_adv_5122006_067",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "但是好厲害啊……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "background",
    "bg_id": "502014"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "可、",
    "voice": "vo_adv_5122006_068",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "可是，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "祕密魔物的數量很龐大。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "全都要靠她",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "像這樣一個一個淨化嗎……？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我按照似似花能分身的數量，",
    "voice": "vo_adv_5122006_069",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "做出了同等數量的",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "告解室。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "哦、",
    "voice": "vo_adv_5122006_070",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "哦哦哦，真的耶！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n整整一排，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "太厲害了，什麼時候做出來的！？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "是說，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "現在驚訝也太晚了……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有這麼多間告解室在運作，",
    "voice": "vo_adv_5122006_071",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不管島鯨噴出多少祕密魔物，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "淨化速度應該都會比牠更快才對。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "既然如此，",
    "voice": "vo_adv_5122006_072",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "剩下的……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就只要",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "等島鯨的能量用盡而已了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "still",
    "still_id": "512200601"
  },
  {
    "type": "dialogue",
    "name": "告白者4",
    "words": "我、",
    "voice": "vo_adv_5122006_073",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "告白者4",
    "words": "我在職場上的性格",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "告白者4",
    "words": "是裝出來的……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……知道了。",
    "voice": "vo_adv_5122006_074",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "我很討厭",
    "voice": "vo_adv_5122006_075",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "青椒……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "所以我就祈禱，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "告白者5",
    "words": "希望青椒從這個世界上消失……",
