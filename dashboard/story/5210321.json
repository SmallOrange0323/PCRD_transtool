[
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "魔物を召喚した……！？",
    "voice": "vo_adv_5206321_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "このままじゃ、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "シャドウに攻撃が届かない……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "それだけではないわ。",
    "voice": "vo_adv_5206321_001",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nあの魔物たち、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "統率が取れている。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "動きから察するに、",
    "voice": "vo_adv_5206321_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一点突破が狙いか……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "恐らく、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "最も火力が高い者へ",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "集中攻撃を浴びせてくるはず。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nこちらも連携しなければ、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "苦戦を強いられるでしょう。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "まもの。",
    "voice": "vo_adv_5206321_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nおいしそう……",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "（ぐぅ～）",
    "voice": "vo_adv_5206321_004",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ごめん。",
    "voice": "vo_adv_5206321_005",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ちから。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "はいらない。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "もしかして、",
    "voice": "vo_adv_5206321_006",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "空腹なの……？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nこの状況で……？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "だ、",
    "voice": "vo_adv_5206321_007",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "大丈夫。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ピンチは、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "チャンスです！",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\nプレシアちゃんが、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "魔物を食べれば解決だわ！",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "阿賀斗紫布菜、",
    "voice": "vo_adv_5206321_008",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "落ち着きなさい。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "何もチャンスじゃないわ。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "とにかく、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一体ずつ相手にしていては埒が明かない。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "全体的に攻撃をしかけて、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一網打尽にしましょう。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗶呀啊啊啊！",
    "voice": "vo_adv_5210321_000",
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n好多像蟬的殼一樣的東西喔──！？",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "……感覺有點噁心耶……",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是將吸乾力量後的同族",
    "voice": "vo_adv_5210321_001",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再次進行利用嗎！",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個審判長，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "人不可貌相",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還挺環保的呢。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "怎、",
    "voice": "vo_adv_5210321_002",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "絲線纏過來了，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我們的行動……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一隻一隻，",
    "voice": "vo_adv_5210321_003",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "謹慎迅速地打倒，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "徹底貫徹戰鬥的基礎吧。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像腳踏實地的查訪和埋伏，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "正是搜查的鐵則那樣。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "不愧是名偵探小霞！",
    "voice": "vo_adv_5210321_004",
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n拿娜也會配著紅豆麵包和牛奶加油的──！",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊啊、",
    "voice": "vo_adv_5210321_005",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那是刑警不是偵探就是了……",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這場戰鬥結束後，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我請妳吃紅豆麵包吧！",
    "voice": null,
    "unit_id": 137411
  }
]
