[
  {
    "type": "dialogue",
    "name": "禊",
    "words": "太好了……！",
    "voice": "vo_adv_5098203_000",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n總算在門關閉之前，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n把小繆送回去了。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯。",
    "voice": "vo_adv_5098203_001",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n……小繆，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要保重喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "繆～？",
    "voice": "vo_adv_5098203_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？",
    "voice": "vo_adv_5098203_003",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是不是有聽到小繆的聲音？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊好像也……",
    "voice": "vo_adv_5098203_004",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "聽到了？",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一定是錯覺吧。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆繆～！",
    "voice": "vo_adv_5098203_005",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "咦咦──！",
    "voice": "vo_adv_5098203_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "\\n小繆！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為、",
    "voice": "vo_adv_5098203_007",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有確實地送走牠了吧？",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "難道……",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有什麼地方做錯了？",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "呀！？",
    "voice": "vo_adv_5098203_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "妳們",
    "voice": "vo_adv_5098203_009",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "看！",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n那邊",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "又出現一道大門耶。",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "剛才那道門",
    "voice": "vo_adv_5098203_010",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還到不了另一邊的世界嗎……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "小繆、",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊、",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "美美！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們再挑戰一次吧！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆～！",
    "voice": "vo_adv_5098203_011",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要去其他世界果然很難呀──",
    "voice": "vo_adv_5098203_012",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "讓我們努力到最後吧！",
    "voice": null,
    "unit_id": 122811
  }
]
