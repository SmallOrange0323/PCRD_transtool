[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一小時後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼、",
    "voice": "vo_adv_1078004_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼……♪",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯嗯。",
    "voice": "vo_adv_1078004_001",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我睡著了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "糟糕了～",
    "voice": "vo_adv_1078004_002",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且也沒塗防曬油。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全身都被太陽給曬傷，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來要沒辦法洗熱水澡了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過……",
    "voice": "vo_adv_1078004_003",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n曬傷就和輕微的燙傷差不多，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n最糟用回復魔法也能治癒吧。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼啊……",
    "voice": "vo_adv_1078004_004",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過可能是在奇怪的時間睡著了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "頭感覺好沉重。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我到底睡了多久呢……？",
    "voice": "vo_adv_1078004_005",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難得有開心的海水浴，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如果睡掉就太浪費了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_1078004_006",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比想像中的還要更耗費體力和魔力呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟為了參加這個「迷人的南國旅行」，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我可是削減了睡眠時間努力工作啊。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但也因此睡眠不足，",
    "voice": "vo_adv_1078004_007",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "似乎讓我熟睡了一番。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真像個笨蛋一樣，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又不是太期待遠足，而晚上睡不著覺的小鬼。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1078004_008",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊，{0}，早安。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你在做什麼啊？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一個人待在那種浪邊……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n其他兩個人，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可和可蘿仔呢？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到海灣去了？",
    "voice": "vo_adv_1078004_009",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼嗯，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可要教可蘿仔怎麼游泳啊？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n海灣是深度適中的淺灘，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也不會有浪沖進去，很適合練習游泳？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來如此……",
    "voice": "vo_adv_1078004_010",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你不和她們一起去沒關係嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你也因為記憶喪失，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "忘記怎麼游泳了吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啊啊。",
    "voice": "vo_adv_1078004_011",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我睡著了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n才覺得不應該把我一個人丟在這裡離開是吧。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才會只有{0}留下保護我？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟睡著的時候毫無防備呀～",
    "voice": "vo_adv_1078004_012",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然海邊不曉得為何沒什麼人，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但這並不表示就不會出現可疑人士或是魔物。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_1078004_013",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我應該感謝你呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過啊～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得～要坦率道謝也挺難為情的。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1078004_014",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊、啊啊……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你去幫我買了",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "礦泉水嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幫大忙了。",
    "voice": "vo_adv_1078004_015",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "光只是睡覺就會流汗了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "更何況還是這種大太陽底下……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我好像流失了不少水份，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "口都乾了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "挺貼心的嘛，{0}。",
    "voice": "vo_adv_1078004_016",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很好很好，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "值得讚賞。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才、不對啦……",
    "voice": "vo_adv_1078004_017",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我得",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好好和人家道謝才行。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}。呃……",
    "voice": "vo_adv_1078004_018",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個啊～？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n很多事情，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "謝……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊！？",
    "voice": "vo_adv_1078004_019",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n嚇死我了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你為什麼會突然發光啦！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好刺眼……",
    "voice": "vo_adv_1078004_020",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是怎樣啦，討厭！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "人家難得要坦率地表達感謝了耶！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不要無緣無故突然發光啦，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真莫名其妙！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哼哼哼～♪",
    "voice": "vo_adv_1078004_021",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n要、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "選、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哪、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "一、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "個、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "才、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "呢～……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯～",
    "voice": "vo_adv_1078004_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "果然還是這個？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "有點太大膽了？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……欸，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這個要這麼貴？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不曉得錢夠嗎。",
    "voice": "vo_adv_1078004_023",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "手頭的錢，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "有多少啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "一、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "二、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "三……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唔～嗯，真微妙？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果在這裡把錢用掉了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就本末倒置了啊～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可是，",
    "voice": "vo_adv_1078004_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "穿學校指定的泳裝，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n會被周圍的人給嘲笑的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯～",
    "voice": "vo_adv_1078004_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n是不是該忍痛降低商店的水準，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n到價格更便宜的量販店去比較好呢……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真是的。",
    "voice": "vo_adv_1078004_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n如果媽媽願意給我錢，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我就不需要這麼煩惱了說！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……嗯？",
    "voice": "vo_adv_1078004_027",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那個是……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "喂～！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n喂～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那邊那個傻瓜！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你是叫{0}吧？\\n為什麼你這種人，",
    "voice": "vo_adv_1078004_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "會走在這種時尚的地方啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "也太格格不入了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嘿～",
    "voice": "vo_adv_1078004_029",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你住在這附近啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那是椿丘高校的制服吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "算了，",
    "voice": "vo_adv_1078004_030",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你這種人怎樣都無所謂……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "比起那個啊～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你來得正好。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我說你，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可以借我錢嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "因為我這次",
    "voice": "vo_adv_1078004_031",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "國中的畢業旅行……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "要去沖繩。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我就是為了這個，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "跑來買泳裝的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "畢業旅行的服裝",
    "voice": "vo_adv_1078004_032",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "包含泳裝在內，可以自由穿著……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n不是會讓人想穿的時髦點嘛？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "其他人好像都會特別用心準備，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我也不能輸給她們。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可是，",
    "voice": "vo_adv_1078004_033",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我手頭的錢不夠，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n因為價格的關係，讓我的選擇變得超級少的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我想選最棒的東西耶～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是這樣，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你可以借我錢嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我之後會還你，",
    "voice": "vo_adv_1078004_034",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是真的是真的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……不行？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我想也是。",
    "voice": "vo_adv_1078004_035",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我們又不是朋友，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "怎麼可能會借錢給不太熟的中學生小鬼呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就算你",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是個爛好人也一樣呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒有關係，",
    "voice": "vo_adv_1078004_036",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我只是想說說看而已。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嘖～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "才不會有這麼好的事情啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "算了沒關係。",
    "voice": "vo_adv_1078004_037",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我說你，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "現在有時間嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n如果可以的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "能陪我一起挑泳裝嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你看看周圍……",
    "voice": "vo_adv_1078004_038",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這家店，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "到處都是情侶，我一個人在這裡就覺得非常尷尬。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "還有，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "泳裝挑得太長時間後，開始不曉得該選什麼才好了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可以吧，",
    "voice": "vo_adv_1078004_039",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這點事你就陪我啦。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n如果你有其他急事，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那我是不強迫你喔？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哦，",
    "voice": "vo_adv_1078004_040",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "感覺有點高姿態呢……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "也沒關係就是了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "107800401"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那我問你。",
    "voice": "vo_adv_1078004_041",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這附近有的泳裝，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你覺得哪一件最適合我？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "107800402"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦，",
    "voice": "vo_adv_1078004_042",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這個？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唔～嗯……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是很可愛沒錯，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但不覺得有點太幼稚了？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "話說，",
    "voice": "vo_adv_1078004_043",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是給小孩子穿的吧，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這件泳裝。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "連大人穿的和小孩子穿的都不會分嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "還是說……",
    "voice": "vo_adv_1078004_044",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你就是",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "想說我看起來像小孩子嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "107800403"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦，",
    "voice": "vo_adv_1078004_045",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你這話是認真的？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1078004_046",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你是笨蛋嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這種腦袋有問題的款式……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "話說，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這件泳裝",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "重要的地方幾乎都沒遮起來吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "誰會穿這種東西啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你認真點考慮啦，",
    "voice": "vo_adv_1078004_047",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我可是很認真在煩惱的耶！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一小時後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唔……",
    "voice": "vo_adv_1078004_048",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n不是那個，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "也不是這個……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唔～？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不行了，",
    "voice": "vo_adv_1078004_049",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "看這樣子是決定不了了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你真沒品味耶～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我猜你是沒女朋友吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "畢竟你看起來就不怎麼受歡迎，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊哈哈☆",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1078004_050",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "別喊得這麼親暱啦！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我們是朋友嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不是吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……我也，",
    "voice": "vo_adv_1078004_051",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯，雖然沒有男朋友。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但該說喜歡嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我有憧憬的對象在。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯。",
    "voice": "vo_adv_1078004_052",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我之前說不定也說過了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是千里真那大人……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我對他不是戀愛的感情，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "而且他年紀也大了我一輪，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n對方說不定連我是誰都不知道吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～啊……",
    "voice": "vo_adv_1078004_053",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n如果不是和你這種人，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n而是和真那大人一起挑泳裝就好了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……說笑的。",
    "voice": "vo_adv_1078004_054",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "難得你都親切地來陪我了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我還說這種話是不行的呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "抱歉抱歉，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我的性格真壞，真傷腦筋。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1078004_055",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n是什麼理由，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "讓你這麼想的？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我如你所見，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是個被大家嫌棄的不良少女！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……糟糕，",
    "voice": "vo_adv_1078004_056",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我該去上補習班了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "先走囉。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "泳衣就之後……",
    "voice": "vo_adv_1078004_057",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "去和父母商量，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n想辦法和他們要到錢，買件高級的泳衣。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我姑且",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "也會參考今天問你的意見來挑選的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就這樣。",
    "voice": "vo_adv_1078004_058",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……今天那個，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "呃……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊啊，可惡！",
    "voice": "vo_adv_1078004_059",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我真的很不擅長和人道謝！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n所以才會說我",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "性格很糟啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "來，辛苦了。",
    "voice": "vo_adv_1078004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你現在看到的，就是和夢差不多的東西。",
    "voice": "vo_adv_1078004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n醒來後，就會全部都忘了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可是呢，",
    "voice": "vo_adv_1078004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次的希留耶心情還挺好的呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "平時，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只要見面你就會遭受漫罵對吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看來她很期待畢業旅行，",
    "voice": "vo_adv_1078004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以挺興奮的呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺～和她那年紀的小孩子很相仿，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓人會心一笑。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過。",
    "voice": "vo_adv_1078004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是知道的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n結果希留耶似乎還是無法參加畢業旅行。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那孩子的父母，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "似乎不願意為她出畢業旅行的錢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她為了請父母拿出買泳裝的錢，",
    "voice": "vo_adv_1078004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而去找他們商量後，得知了這個事實……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "希留耶，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "之後變得非常叛逆喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，這種事情……",
    "voice": "vo_adv_1078004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算對你說了也於事無補吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "吶，{0}。",
    "voice": "vo_adv_1078004_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "希留耶，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的很興奮期待地挑選著泳裝呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想「這邊」的……",
    "voice": "vo_adv_1078004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "凱留，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次一定也做了一樣的事情喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "抱著期待，",
    "voice": "vo_adv_1078004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "興奮地挑選泳裝……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後和「那邊」的畢業旅行不一樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她在「這邊」可以好好和氣味相投的夥伴們一起旅行。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該說是不幸中的大幸嗎，",
    "voice": "vo_adv_1078004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這是世界變貌的結果，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所產生的奇蹟。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "請珍惜這份幸運，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓那個孩子玩得開心喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就這樣。",
    "voice": "vo_adv_1078004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n繼續長篇大論也沒用呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今天就先這樣，我要告辭了。",
