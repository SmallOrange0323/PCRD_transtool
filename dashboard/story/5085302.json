[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺到了比剛才還強的力量……！",
    "voice": "vo_adv_5085302_000",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不只那樣，",
    "voice": "vo_adv_5085302_001",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們的力量",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也是……！",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "成長與進化的可能性。",
    "voice": "vo_adv_5085302_002",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n想必",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「那一側的少年」",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "會無止境地變強下去。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要阻止那個……",
    "voice": "vo_adv_5085302_003",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只有靠「現在的少年」壓制它，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並且表明自己的意志。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……你的表情，",
    "voice": "vo_adv_5085302_004",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是在說「我知道」吧。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "非常好。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n那就是過去我曾相信過",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並寄託願望的……",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不。",
    "voice": "vo_adv_5085302_005",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "與那時候比起來，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「現在的少年」肯定更帥氣。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿♪",
    "voice": "vo_adv_5085302_006",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得沒錯！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你一天比一天更強壯、",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "更帥氣喔☆",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎～？",
    "voice": "vo_adv_5085302_007",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們會不會誇過頭啦～？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這傢伙",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到現在吃飯時還讓可蘿仔幫他擦嘴巴，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一有機會就啊～地張嘴",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被別人餵飯喔？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不、",
    "voice": "vo_adv_5085302_008",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n偶爾……",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的是偶爾，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "他也不是沒有帥氣的時候，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這我也不是不能認同……",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且現在也是……",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看你都讓我說了什麼！",
    "voice": "vo_adv_5085302_009",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好啦，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是要戰鬥了嗎！",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕快上吧！",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "藉此",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓我們瞧瞧吧。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──帥氣的你！",
    "voice": "vo_adv_5085302_010",
    "unit_id": 121111
  }
]
