[
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……某天下午。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n咲戀與流夏在討論關於今天晚上的菜單。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "絕對應該做漢堡排！",
    "voice": "vo_adv_5128092_000",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這傢伙明天要去進行漫長的冒險，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n應該準備能夠好好填飽肚子的東西！",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不對，",
    "voice": "vo_adv_5128092_001",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "應該做鹽烤魚和味噌湯！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "吃漢堡排感覺會消化不良啊，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "做清淡點的東西才比較安心吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我的漢堡排",
    "voice": "vo_adv_5128092_002",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是在育幼院也有很多人愛吃的",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n豆腐漢堡排，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不需要擔心會消化不良。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n流夏的料理",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對於年輕男生來說反而會吃不飽吧？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔……",
    "voice": "vo_adv_5128092_003",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來這招啊……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就把鹽烤改成照燒！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這是我在食堂賺旅費時，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "學會的祕藏料理！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看來妳不打算退讓呢。",
    "voice": "vo_adv_5128092_004",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就由你來決定好了。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你今晚想吃誰的料理？",
    "voice": "vo_adv_5128092_005",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n大家願賭服輸，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你不需要有所顧慮。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "照、",
    "voice": "vo_adv_5128092_006",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "照燒豆腐漢堡排……？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我可沒有做過什麼照燒醬啊……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我雖然會做照燒醬，",
    "voice": "vo_adv_5128092_007",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是我沒有用豆腐做過漢堡排……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀、流夏",
    "words": "……啊。",
    "voice": "vo_adv_5128092_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來是這麼回事啊。",
    "voice": "vo_adv_5128092_009",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "提出這道料理也是挺機靈的嘛。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "流夏。",
    "voice": "vo_adv_5128092_010",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n如果不介意，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可以請妳教我做照燒醬嗎？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咲戀妳",
    "voice": "vo_adv_5128092_011",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也教我怎麼做",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "豆腐漢堡排吧。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們互相教對方的話，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺在想菜單時也會比較輕鬆呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，咲戀和流夏同心協力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n完成了好吃的照燒豆腐漢堡排。",
    "voice": null,
    "unit_id": null
  }
]
