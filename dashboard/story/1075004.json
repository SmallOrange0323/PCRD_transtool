    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好像也有一樣的感覺呢。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯？",
    "voice": "vo_adv_1075004_067",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝我，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "什麼？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼這麼突然，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說那是我的台詞才對啦！",
