[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天禊把{0}叫了出來後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當她正在挖特製的陷阱地洞時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哼哼哼！",
    "voice": "vo_adv_1004010_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "感覺今天的陷阱地洞設置得特別完美呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥",
    "voice": "vo_adv_1004010_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "到底會上鉤幾次呢～？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這次禊挖了很多洞，還真是令人期待呢～♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找到了！",
    "voice": "vo_adv_1004010_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是如同通報所說的可疑傢伙！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": "vo_adv_1004010_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "什麼什麼？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "我們是【王宮騎士團】！\\n不准動！",
    "voice": "vo_adv_1004010_004",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "給我安分點！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n……呃，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "是小孩子？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你說的可疑傢伙是指禊嗎！？",
    "voice": "vo_adv_1004010_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "做了什麼壞事嗎……？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "總而言之，",
    "voice": "vo_adv_1004010_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "妳快把身上的東西全都交出來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": "vo_adv_1004010_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你來的正好！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "嗯？",
    "voice": "vo_adv_1004010_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "你是誰啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "是她的同夥嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你聽禊說，",
    "voice": "vo_adv_1004010_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這些人",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "竟然說禊很可疑！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "妳都挖了這麼多的地洞，還敢惡人先告狀！",
    "voice": "vo_adv_1004010_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是說啊！",
    "voice": "vo_adv_1004010_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為什麼禊非得被抓起來不可啊？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "最近常有盜賊出沒，",
    "voice": "vo_adv_1004010_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n他們會先讓人掉入陷阱地洞，再假裝要幫助受害者，趁機搶奪財物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "然後我們接到了通報，",
    "voice": "vo_adv_1004010_013",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "說是有人正在這裡挖掘大洞。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n在趕來查看之後，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "就發現了這個孩子在這裡。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊才不會做那種事呢！",
    "voice": "vo_adv_1004010_014",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個陷阱地洞",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也只是為了哥哥才挖的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "別說是藉口了，聽起來根本就像是招供啊！",
    "voice": "vo_adv_1004010_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n這個男人也是一夥的吧！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "你也讓我們檢查一下！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為什麼！？",
    "voice": "vo_adv_1004010_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥他什麼都沒做啊！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "意外地聽話嘛。",
    "voice": "vo_adv_1004010_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "那就讓我來確認……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "嗯？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "怎麼了？",
    "voice": "vo_adv_1004010_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "他身上有什麼可疑的東西嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "不，",
    "voice": "vo_adv_1004010_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "正好相反，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "這傢伙……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "身上什麼都沒有。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "什麼？",
    "voice": "vo_adv_1004010_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "謝禮？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "來這裡的途中掉進陷阱地洞，",
    "voice": "vo_adv_1004010_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n為了答謝救你的人，所以把身上東西全交出去了……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "你是",
    "voice": "vo_adv_1004010_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "被騙了啦！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n從手法來看的話，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "那些傢伙肯定就是我們在找的盜賊！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n他們跑去哪了？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "往對面那裡去了？",
    "voice": "vo_adv_1004010_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "好，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "我們趕緊去追！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n你們的嫌疑已經洗清了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "懷疑你們真是不好意思。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……走掉了。",
    "voice": "vo_adv_1004010_024",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一點都不好！",
    "voice": "vo_adv_1004010_025",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥身上的錢之類的東西，全部都被偷走了啊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這都是",
    "voice": "vo_adv_1004010_026",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的錯吧。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n要是禊沒有叫哥哥出來，你就不會過來了，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n你會掉進陷阱地洞，也是因為把那個洞當成是禊挖的洞了吧？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊",
    "voice": "vo_adv_1004010_027",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要把哥哥被偷走的東西拿回來！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "交給剛才那些人就行了？",
    "voice": "vo_adv_1004010_028",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說得也是呢～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊～啊，",
    "voice": "vo_adv_1004010_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "難得要跟哥哥好好玩一場的說，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n結果今天的行程都泡湯了。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊要回家囉，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥回去時也要小心哦。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼再見囉，",
    "voice": "vo_adv_1004010_030",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "根據哥哥說的，",
    "voice": "vo_adv_1004010_031",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "應該就在這附近吧。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "如果是禊的話……",
    "voice": "vo_adv_1004010_032",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "會在那一帶設下陷阱地洞！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "接下來就只要躲在這裡，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "等壞人們過來……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": "vo_adv_1004010_033",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為什麼你會在這裡？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "難道說",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "壞人的真實身分就是哥哥……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是不可能的吧。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唉～",
    "voice": "vo_adv_1004010_034",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "明明會掉進禊的陷阱，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n卻能看穿禊在想什麼啊～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "雖然哥哥阻止過禊，",
    "voice": "vo_adv_1004010_035",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
