    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "可惡，",
    "voice": "vo_adv_1004010_079",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "竟然給我四處亂竄！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n一下往這跑、一下往那跑，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "還真是個靈巧的傢伙！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥好厲害！",
    "voice": "vo_adv_1004010_080",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "很順利地引誘他們上鉤了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n照這樣子的話……！",
