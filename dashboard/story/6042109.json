[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "せんぷぁ～い……",
    "voice": "vo_adv_6038109_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "メルクリちゃんの資金援助、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "もらい損ねました……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "企画自体は良かったはずなんですけど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "プレゼンって難しいですねえ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ちょっと先輩もやってみてください。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "自分の長所をＰＲするんです。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "強い……",
    "voice": "vo_adv_6038109_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "でしたっけ？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あ、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "精神的にってことです？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "それならまあ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nうちら着替えよっかーみたいな流れになっても、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ぼけーっとして\\n教室から一向に出て行く気配ないトコとか",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "「強っ！」て思いますけど。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あー、",
    "voice": "vo_adv_6038109_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いいですよね「優しい」。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "強いとか賢いとか何々が得意とかは、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n努力だったり才能だったりが必要ですけど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "優しいだけは何も要らない、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n誰でも自称した瞬間に獲得できる、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "実質ただの「無」ですもんね！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "大謙虚！　",
    "voice": "vo_adv_6038109_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "その奥ゆかしさは確かに先輩の長所かもです。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いますもんね、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "世間の評価４０～５０点なのに何故か８５点ぐらいの\\n目線からモノ申してくる人。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "自己肯定感は先輩ぐらいが丁度よきですね。",
    "voice": null,
    "unit_id": 110911
  }
]
