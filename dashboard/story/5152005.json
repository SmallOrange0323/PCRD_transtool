    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "找到了找到了，",
    "voice": "vo_adv_5152005_038",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那塊大冰塊果然是你們施放的啊。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哼。",
    "voice": "vo_adv_5152005_039",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n妳還真是慢悠悠的呢，凱留。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這也沒有辦法，",
    "voice": "vo_adv_5152005_040",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們可是很忙的啊。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n直到剛剛為止都還在海上拼命奮戰。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為事發突然，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "連信號都沒辦法發出來呢？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "拼命奮戰……？",
    "voice": "vo_adv_5152005_041",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "信號……？",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_5152005_042",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還沒有恢復原樣嗎？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛剛在下等人──",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "──",
    "voice": "vo_adv_5152005_043",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對了，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "貪吃佩可妳聽我說！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那隻白島鯨",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "被我們打倒了喔。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "美食殿堂",
    "words": "咦？",
    "voice": "vo_adv_5152005_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──白島鯨的話，",
    "voice": "vo_adv_5152005_045",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們已經打倒了耶……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "拉姆、愛蜜莉雅、雷姆",
    "words": "咦？",
    "voice": "vo_adv_5152005_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "咦？",
    "voice": "vo_adv_5152005_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個～",
    "voice": "vo_adv_5152005_048",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們也在剛剛",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "打倒了白島鯨是嗎？",
