    "name": "雷姆",
    "words": "姊姊，妳看！",
    "voice": "vo_adv_5152005_033",
    "unit_id": 132113
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n白島鯨漸漸消失了……！",
