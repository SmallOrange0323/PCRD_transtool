    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的，",
    "voice": "vo_adv_5152005_049",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "沒有錯。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n確實是由愛蜜莉雅大人",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "一擊消滅了白島鯨。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人也確認過，",
    "voice": "vo_adv_5152005_050",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在貪吃佩可小姐火力全開之下",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n擊倒了白島鯨。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": "vo_adv_5152005_051",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是怎麼一回事呢。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道說，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是從一開始就有兩隻嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "白島鯨這種魔物有那麼多隻嗎？",
    "voice": "vo_adv_5152005_052",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": "vo_adv_5152005_053",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "照理來說，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "應該是沒有這種事──",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這個聲音……！",
    "voice": "vo_adv_5152005_054",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不會有錯，",
    "voice": "vo_adv_5152005_055",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是白島鯨！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼會……！？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼了嗎，",
    "voice": "vo_adv_5152005_056",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您好像在指著什麼東西……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有什麼東西，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "漂浮在空中……？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又白、",
    "voice": "vo_adv_5152005_057",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又大的……",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鯨、魚……？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有鯨魚──",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "美食殿堂",
    "words": "在天上飛────────！？",
    "voice": "vo_adv_5152005_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": "vo_adv_5152005_059",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一隻、",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "二隻、",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "三隻……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "增加了呢。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n花凜小姐……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們沒有收到這樣的資訊啊……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這是……",
    "voice": "vo_adv_5152005_060",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "嗯。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你這毛茸茸的傢伙為什麼這麼冷靜啊！",
    "voice": "vo_adv_5152005_061",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有鯨魚在天上飛耶！？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "啊啊，抱歉抱歉。",
    "voice": "vo_adv_5152005_062",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不過，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我對這情景有印象呢。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這該不會是",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "白島鯨",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "受到了我們的影響……？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說有印象，",
    "voice": "vo_adv_5152005_063",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "意思是在你們的世界裡，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鯨魚會飛是正常的嗎！？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n異世界也太可怕了吧！？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊……",
    "voice": "vo_adv_5152005_064",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n長在白島鯨上的那支角，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "該不會是魔獸的……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "有種不妙的感覺。",
    "voice": "vo_adv_5152005_065",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n得考慮撤退呢。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n我們應該",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "要以愛蜜莉雅大人的安全為優先──",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不行。",
    "voice": "vo_adv_5152005_066",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴有說過。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "他說海邊",
    "voice": "vo_adv_5152005_067",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是讓大家露出笑容的地方。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要是放著那隻白島鯨不管，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n愉快的海邊就會毀於一旦。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "而且，",
    "voice": "vo_adv_5152005_068",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也是為了讓這孩子恢復原樣，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們可不能在這裡放走白島鯨。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這孩子",
    "voice": "vo_adv_5152005_069",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "和大家的「夏日佳期」，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "都要守護才行！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛蜜莉雅……",
    "voice": "vo_adv_5152005_070",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "坦白說，",
    "voice": "vo_adv_5152005_071",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這情況已經不是在下等人所能應對的了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能有您們幫忙，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實屬萬幸。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們真的",
    "voice": "vo_adv_5152005_072",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都是好人呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆要怎麼做。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只要是愛蜜莉雅大人決定的事，拉姆就沒有異議。",
    "voice": "vo_adv_5152005_073",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "記得想好討伐白島鯨後要跟拉姆",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n道謝的話喔，",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆也要戰鬥！",
    "voice": "vo_adv_5152005_074",
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n我還沒有和昴享受海邊！",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "要是讓白島鯨在這裡搗亂，",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "把海邊給破壞掉，可就傷腦筋了。",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐，",
    "voice": "vo_adv_5152005_075",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要不要試試看",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和昴先生在海中漫步呢？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n氣氛非常地好喔。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n等討伐白島鯨後，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下再告訴您詳細。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我也得稍微鼓起幹勁才行呢。",
    "voice": "vo_adv_5152005_076",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "要注意千萬別亂來喔。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_5152005_077",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_5152005_078",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛蜜莉雅。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們走吧，",
    "voice": "vo_adv_5152005_079",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "貪吃佩可！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "白島鯨身上發生了不應該有的變化。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了守護能讓人露出笑容的夏日海邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可她們和愛蜜莉雅一行人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拿起武器，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同心協力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "投身於激戰之中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502340"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那是什麼呀！？",
    "voice": "vo_adv_5152005_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n增殖？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那巨大的身軀？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我沒見過那種魔物……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不對，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不可能有這麼破壞平衡的東西存在……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那跟棲息在這個世界裡的白島鯨不同，",
    "voice": "vo_adv_5152005_081",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n反應明顯異常……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是怎麼一回事啊……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那是……",
    "voice": "vo_adv_5152005_082",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來似乎混雜進去了呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "艾姬多娜……",
    "voice": "vo_adv_5152005_083",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳知道些什麼嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我沒有辦法對異世界的未知事件下定論，",
    "voice": "vo_adv_5152005_084",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但是可以推測出眼前所發生的現象。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "知道的話就告訴我。",
    "voice": "vo_adv_5152005_085",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那到底是什麼？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以我說，",
    "voice": "vo_adv_5152005_086",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有東西混雜其中。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n那隻被稱為白島鯨的魔物",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "會奪取記憶對吧？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "牠把東西吸收進去了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那東西……",
    "voice": "vo_adv_5152005_087",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就是菜月昴他所擁有的",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "異世界的因子。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為接收到異世界這個原本不存在的資訊，",
    "voice": "vo_adv_5152005_088",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n導致白島鯨",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "產生了bug嗎……？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "相當有趣的現象呢。",
    "voice": "vo_adv_5152005_089",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n身懷這邊世界的因子的魔物，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n如今",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "居然",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "會有著和那個「暴食」所孕育出的魔獸類似的性質──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那麼，",
    "voice": "vo_adv_5152005_090",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "他們會選擇怎麼樣的結局呢──",
    "voice": null,
    "unit_id": 132012
  }
]
