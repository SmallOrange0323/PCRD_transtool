    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "一定也正在努力呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們也要加油才行！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅是認真的人呢。",
    "voice": "vo_adv_5152005_005",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n成長成這麼乖巧的孩子，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "爸爸我很高興啊。",
    "voice": null,
    "unit_id": 2612
