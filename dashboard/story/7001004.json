    "words": "儘管如此，",
    "voice": "vo_adv_7001004_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "反正我也不想妨礙他們的關係發展……",
    "voice": null,
