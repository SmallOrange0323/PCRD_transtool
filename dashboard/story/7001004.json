    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": "vo_adv_7001004_002",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真琴是我童年時就結識的，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "相當重要的摯友。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對阿。",
    "voice": "vo_adv_7001004_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為有優衣在，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我才知道",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "即使我的種族有所不同",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我們依然可以好好相處……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真的是，非常重要的好友呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "多麼美妙的友情啊，",
    "voice": "vo_adv_7001004_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我都開始羡慕起來了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼，",
    "voice": "vo_adv_7001004_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "和助手先生又是什麼關係呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸！？　",
    "voice": "vo_adv_7001004_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊唔。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}他啊，",
    "voice": "vo_adv_7001004_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可是優衣的大恩人喔。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "恩人？",
    "voice": "vo_adv_7001004_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊。",
    "voice": "vo_adv_7001004_009",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且呢",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣真的",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真的是",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n非常地感謝{0}哦。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我說的沒錯吧？",
    "voice": null,
    "unit_id": 104311
