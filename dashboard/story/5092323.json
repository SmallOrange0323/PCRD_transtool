  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "唔！",
    "voice": "vo_adv_5092323_000",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "守護者的力量正在不斷增強。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來到剛剛為止",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "它的力量都有受到限制呢。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唉，",
    "voice": "vo_adv_5092323_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都費了這麼多功夫",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "結果它還有所保留啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這下有點吃力呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是啊，",
    "voice": "vo_adv_5092323_002",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過好久沒有遇到",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "如此強大的敵人了。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可是，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不可思議的是",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我一點都不覺得害怕或緊張。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真巧啊，",
    "voice": "vo_adv_5092323_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "杏奈。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "其實我也是呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對了，忍，",
    "voice": "vo_adv_5092323_004",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳可以占卜看看",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們會不會贏嗎？",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "抱歉，",
    "voice": "vo_adv_5092323_005",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "容我拒絕。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "既然大家都曉得結果，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "占卜也沒有意義。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵，",
    "voice": "vo_adv_5092323_006",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那妳占卜看看",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "財寶要怎麼有效利用吧。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳們兩個，",
    "voice": "vo_adv_5092323_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "閒話就到此為止。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "又要上工囉。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然是極度危險的最終局面，",
    "voice": "vo_adv_5092323_008",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "和大家一起的話絕對能贏！",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "寶藏守護者，",
    "voice": "vo_adv_5092323_009",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你就再次陷入長眠吧！",
    "voice": null,
