[
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "嘖。",
    "voice": "vo_adv_5209321_000",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那個蠢貨。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n居然把其他魔物",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也帶了過來。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "啊，",
    "voice": "vo_adv_5209321_001",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "也有看起來很熱的孩子呢……",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "可沒時間陪小嘍囉玩。",
    "voice": "vo_adv_5209321_002",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "迅速解決掉吧！",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯、",
    "voice": "vo_adv_5209321_003",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯……！",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "魔物を召喚した……！？",
    "voice": "vo_adv_5206321_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "このままじゃ、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "シャドウに攻撃が届かない……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "それだけではないわ。",
    "voice": "vo_adv_5206321_001",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nあの魔物たち、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "統率が取れている。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "動きから察するに、",
    "voice": "vo_adv_5206321_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一点突破が狙いか……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "恐らく、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "最も火力が高い者へ",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "集中攻撃を浴びせてくるはず。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nこちらも連携しなければ、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "苦戦を強いられるでしょう。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "まもの。",
    "voice": "vo_adv_5206321_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nおいしそう……",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "（ぐぅ～）",
    "voice": "vo_adv_5206321_004",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ごめん。",
    "voice": "vo_adv_5206321_005",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ちから。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "はいらない。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "もしかして、",
    "voice": "vo_adv_5206321_006",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "空腹なの……？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nこの状況で……？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "だ、",
    "voice": "vo_adv_5206321_007",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "大丈夫。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ピンチは、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "チャンスです！",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\nプレシアちゃんが、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "魔物を食べれば解決だわ！",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "阿賀斗紫布菜、",
    "voice": "vo_adv_5206321_008",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "落ち着きなさい。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "何もチャンスじゃないわ。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "とにかく、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一体ずつ相手にしていては埒が明かない。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "全体的に攻撃をしかけて、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一網打尽にしましょう。",
    "voice": null,
    "unit_id": 135011
  }
]
