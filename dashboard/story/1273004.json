    "type": "dialogue",
    "name": "鈴奈",
    "words": "超亮的耶！？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才的魔法嗎！？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好好笑～",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "background",
