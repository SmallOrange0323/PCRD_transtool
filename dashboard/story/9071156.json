[
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個混帳──！",
    "voice": "vo_adv_9071156_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看招────！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": "vo_adv_9071156_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "打、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "打贏了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我打贏了────！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呼。",
    "voice": "vo_adv_9071156_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還挺厲害的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很久沒打得這麼痛快了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好了，",
    "voice": "vo_adv_9071156_003",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "辛苦囉～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "兩人都有所成長的樣子，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "了不起了不起。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只是，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對手好像太弱了點？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不，",
    "voice": "vo_adv_9071156_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "其實有點勉強……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要能覺醒的話",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這種對手根本不算什麼！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我可不是辦不到哦？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只是沒這個必要而已！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": "vo_adv_9071156_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要是能那麼簡單就覺醒的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就不用這麼辛苦了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "比起這個，",
    "voice": "vo_adv_9071156_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大妳那邊如何？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n看妳擺出一副高高在上的樣子，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但妳才是身手退步的那邊吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯～",
    "voice": "vo_adv_9071156_007",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n跟長老他們借來的力量",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "似乎不能使用了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n真的有點退步了呢……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那也就是說……",
    "voice": "vo_adv_9071156_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在正是大好機會！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈──哈哈！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那些時候的怨恨，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該來發洩一下了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳這個劣化的混帳老太婆老大，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "納命來……！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊、喂，",
    "voice": "vo_adv_9071156_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳後面！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫、",
    "voice": "vo_adv_9071156_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫啊啊啊！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n剛才的魔物！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對，",
    "voice": "vo_adv_9071156_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是不同的傢伙！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看起來比剛才那隻更大更強？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咕嗚嗚……",
    "voice": "vo_adv_9071156_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我在剛才的戰鬥中",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經把力量用完了……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喂～",
    "voice": "vo_adv_9071156_013",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "別來打擾我們說話呀。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_9071156_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一擊擊倒……？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂……",
    "voice": "vo_adv_9071156_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這哪裡有退步了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還沒覺醒就有這種威力……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是說啊～",
    "voice": "vo_adv_9071156_016",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳們兩人",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是不是太依賴覺醒了呢？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n雖然，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "覺醒的確能單純地提升能力，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但它真正的優點並不在這裡。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "覺醒時的感覺……",
    "voice": "vo_adv_9071156_017",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要能好好掌握住力量的流動，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這點程度",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "即使沒有覺醒也能辦到哦。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就算這樣妳也未免太怪物了吧……",
    "voice": "vo_adv_9071156_018",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "太久沒見到妳讓我差點都忘了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哦……",
    "voice": "vo_adv_9071156_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是有趣。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還能再繼續往上精進",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "的意思對吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是這樣♪",
    "voice": "vo_adv_9071156_020",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是說祈梨，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我剛剛沒有聽得很清楚……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳說要把那些時候的怨恨，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "怎麼樣啊？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳覺得如果是現在的我，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "即使妳已經用盡了力量，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也還是能贏嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫？",
    "voice": "vo_adv_9071156_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是啦那個……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈，",
    "voice": "vo_adv_9071156_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒錯沒錯就是這個，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這種感覺。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哎呀──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真讓人懷念。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "來吧～",
    "voice": "vo_adv_9071156_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我不在時妳成長了多少……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
