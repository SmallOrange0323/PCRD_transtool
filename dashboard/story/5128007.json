[
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "沙漠之國的騷動告一段落後，又過了一段時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在{0}等人返回蘭德索爾的日期將近之時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們收到了國王的傳喚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀、流夏",
    "words": "打算將魔法神燈封印起來……！？",
    "voice": "vo_adv_5128007_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "嗯……",
    "voice": "vo_adv_5128007_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "這次發生這場騷動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "\\n導致國家陷入混亂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "責任都要歸咎於老夫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "為了讓人民幸福，",
    "voice": "vo_adv_5128007_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "老夫選擇了幫大家實現願望，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "\\n這種隨便的做法……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "輕信每個人都能克制自己的慾望。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "\\n結果，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "就造成了讓盜賊們為所欲為的慘況。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "為了不再重蹈覆轍，",
    "voice": "vo_adv_5128007_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "\\n我們在商量過後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "得出了這個結論。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我……",
    "voice": "vo_adv_5128007_004",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "仔細思考了",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "哥哥對我說的那番話。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "如果有不想實現的願望",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就不用去實現。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "究竟什麼願望可以實現，",
    "voice": "vo_adv_5128007_005",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "什麼願望不該實現。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "在我明白這些之前，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我想這是最好的解決辦法。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……可是，",
    "voice": "vo_adv_5128007_006",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就算是這樣。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "那個，",
    "voice": "vo_adv_5128007_007",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這只是將我的本體，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n也就是將神燈安置在地下保管……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我本身並不會在地下長眠唷。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "雖然沒辦法使用神燈本體的魔力，",
    "voice": "vo_adv_5128007_008",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n我的魔法",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就會變得非常弱，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "但你們看，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我還是能像這樣出來外面。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呼……",
    "voice": "vo_adv_5128007_009",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n太好了……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可是，",
    "voice": "vo_adv_5128007_010",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原本不就是因為封印神燈的事情，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n導致這個國家",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一分為二，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "長年爭吵不休嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這方面",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這點我想是沒問題的。",
    "voice": "vo_adv_5128007_011",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n就算……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不靠我的魔法也一定能順利解決。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "對了，",
    "voice": "vo_adv_5128007_012",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "原本說好要帶你們遊覽這個國家的對吧。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n雖然還在重建中，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "但是要不要一起去到處看看呀？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n我想你們親眼看過之後，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就會相信我所說的了。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "background",
    "bg_id": "502060"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂～",
    "voice": "vo_adv_5128007_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "把那邊的石頭抬上來～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是驚人……",
    "voice": "vo_adv_5128007_014",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n城牆竟然已經",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "修復到這個程度了啊。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這裡原本",
    "voice": "vo_adv_5128007_015",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就是因採礦而繁榮的國家。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n石頭的加工技術",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "可是非常厲害的。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這點從我在的時候起",
    "voice": "vo_adv_5128007_016",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就不曾變過……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "當時的國王",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "遵守了和我之間的約定呢。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀，",
    "voice": "vo_adv_5128007_017",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "各位。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "已經要出發了嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "各位，",
    "voice": "vo_adv_5128007_018",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你們好。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "兩位",
    "voice": "vo_adv_5128007_019",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來替我們送行了啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n美冬應該還要打工吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是啊。",
    "voice": "vo_adv_5128007_020",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如你們所見，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我在幫忙修理城牆和建築物。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個魔像造成的損害很大，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n現在似乎到處都缺人手呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只要有需求的地方就會有我的身影",
    "voice": "vo_adv_5128007_021",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唷♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n千歌也暫時",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還會留在這裡對吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，",
    "voice": "vo_adv_5128007_022",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這個國家",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有許多我沒見過的樂器\\n和耐人尋味的傳說……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想在有空的時間裡，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "去調查看看。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且，",
    "voice": "vo_adv_5128007_023",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大家這麼努力地在重建城鎮，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n或許有什麼",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我可以幫上忙的也說不定。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵，",
    "voice": "vo_adv_5128007_024",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就要在這分道揚鑣了呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯。",
    "voice": "vo_adv_5128007_025",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "回到蘭德索爾之後，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們再一起喝個茶吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500660"
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "哎呀，",
    "voice": "vo_adv_5128007_026",
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "你們已經要離開了嗎？",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "\\n",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "總覺得有些寂寞呢……",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "託各位的福，",
    "voice": "vo_adv_5128007_027",
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "我才能夠擁有像這樣幸福的日子。",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "\\n",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "真的是",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "感激不盡。",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看你們過得好像很幸福是不錯啦……",
    "voice": "vo_adv_5128007_028",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你為什麼要拿著鋤頭耕田呢？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "這是法莉達的提案。",
    "voice": "vo_adv_5128007_029",
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "\\n",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "不僅要拉近國家的兩個派系，",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "\\n",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "也要拉近和人民間的距離，",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "為此希望能和大家站在相同的角度。",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "兩派想要走到徹底和解的那天，",
    "voice": "vo_adv_5128007_030",
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "\\n想必會花上很長一段時間……",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "但是沒有問題。",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "\\n你們為我們帶來了改變，",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "薩依德",
    "words": "我一定會守護好這個國家的。",
    "voice": null,
    "unit_id": 1012
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "大家也請",
    "voice": "vo_adv_5128007_031",
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "務必再過來玩。",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "\\n",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "在那之前，",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "我們一定會讓這個國家變得更棒的。",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "\\n",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "我們會和陛下、",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "還有每位國民，",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "法莉達",
    "words": "一同努力。",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "background",
    "bg_id": "502060"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "明明歷經了那麼大的騷動，",
    "voice": "vo_adv_5128007_032",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n大家卻看起來生氣勃勃的呢。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我似乎能夠明白",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你會說沒問題的理由了。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "呵呵呵，",
    "voice": "vo_adv_5128007_033",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我沒說錯吧。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n很高興你們能相信我說的。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "那麼，",
    "voice": "vo_adv_5128007_034",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這下",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就真的要說再見了。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……",
    "voice": "vo_adv_5128007_035",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你要保重喔。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要注意",
    "voice": "vo_adv_5128007_036",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可別感冒囉。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "嘿嘿……",
    "voice": "vo_adv_5128007_037",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我是精靈，所以不會感冒的。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不過，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "啊，",
    "voice": "vo_adv_5128007_038",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "往東方去的馬車要出發囉。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "那麼各位……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "請多多",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "保重！",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好的，",
    "voice": "vo_adv_5128007_039",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "改天有緣再相見了！",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然這段期間充滿波瀾，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是我非常開心哦。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "……",
    "voice": "vo_adv_5128007_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "這樣真的好嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "國王",
    "words": "\\n你如果想跟著那些人一起走也沒關係吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不了，",
    "voice": "vo_adv_5128007_041",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "因為我還有很多不了解的事情。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我還想要更了解這個國家的事物。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "是咲戀姐姐、",
    "voice": "vo_adv_5128007_042",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "流夏姐姐……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "是大家教會了我。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我有了想做的事……",
    "voice": "vo_adv_5128007_043",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n我現在",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "想去了解這個國家的每個人。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我想知道我不在",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "的這段",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "非常長久的日子裡的事情！",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "所以",
    "voice": "vo_adv_5128007_044",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "國王陛下，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "關於我不在的這段期間的大小事。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n請通通告訴我吧。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "宮殿和城牆……",
    "voice": "vo_adv_5128007_045",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n都已經",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "變得那麼小了。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "旅途的結束",
    "voice": "vo_adv_5128007_046",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總是這樣呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果會感到不捨，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就代表這是一趟很好的旅行。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……是啊。",
    "voice": "vo_adv_5128007_047",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳說的沒錯。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這對我來說，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "確實是一趟……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難以忘懷的超棒旅行。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說起來，",
    "voice": "vo_adv_5128007_048",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這次",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為我的關係，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n把流夏也捲進來了呢。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳不必在意。",
    "voice": "vo_adv_5128007_049",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我自己",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也得到了不少收穫。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不知道我之前有沒有跟妳提過……",
    "voice": "vo_adv_5128007_050",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們公會",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "正在尋找「暮光之都」。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "流夏的公會……",
    "voice": "vo_adv_5128007_051",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是【暮光流星群】嗎？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊。",
    "voice": "vo_adv_5128007_052",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是說",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個國家在過去……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n製造了許多",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "強大的魔導具嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然多數",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都已經失傳了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": "vo_adv_5128007_053",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就試著在城鎮調查了一下。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "結果妳猜怎麼樣？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒想到那個沙漠之國，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n過去也被稱作是「日落之國」。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "由蘭德索爾望去，",
    "voice": "vo_adv_5128007_054",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "正好坐落於太陽西沉處的沙漠之國……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被封印在那都城的",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是這次的魔法神燈……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要說是偶然的話，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不覺得未免也太剛好了嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這",
    "voice": "vo_adv_5128007_055",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那個國家",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "和流夏在尋找的",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "「暮光之都」",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有所關聯嗎？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "──我只是想說，",
    "voice": "vo_adv_5128007_056",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是有就好了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也無法保證這個推測是正確的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟我到現在都還沒有找到真正有關聯",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的線索過。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不想要太過期待，結果到頭來只是一場空，",
    "voice": "vo_adv_5128007_057",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n所以回去之後",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會耐心地繼續調查的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣啊。",
    "voice": "vo_adv_5128007_058",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "流夏也有所收穫真是太好了。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要是單方面讓妳吃虧，",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我會過意不去的。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我說，",
    "voice": "vo_adv_5128007_059",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是很好的一家人對吧？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……是啊，",
    "voice": "vo_adv_5128007_060",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然是宛如海市蜃樓般的時光。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但作為一晚的美夢",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "倒是還不賴。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯？",
    "voice": "vo_adv_5128007_061",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拿著的那包是什麼？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是有禮貌的孩子呢。",
    "voice": "vo_adv_5128007_062",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n明明不用那麼費心也沒關係的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀，",
    "voice": "vo_adv_5128007_063",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "除了伴手禮之外……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有一封信？",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n好像是那孩子",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "寫給我和流夏的。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我看看，上面寫了……",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……咲戀？",
    "voice": "vo_adv_5128007_064",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "信裡寫了什麼？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n妳不唸出來我們可不知道啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……拿去。",
    "voice": "vo_adv_5128007_065",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳看了就知道了。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我實在沒有勇氣把這個",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唸出來。",
    "voice": null,
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……啊啊，",
    "voice": "vo_adv_5128007_066",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真不曉得該說他貼心還是怎樣……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "果然",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是一位幫人實現願望的精靈呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "什麼！你、你不准看啦！？",
    "voice": "vo_adv_5128007_067",
    "unit_id": 127512
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對啊，",
    "voice": "vo_adv_5128007_068",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這可是給我和咲戀的信，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你不准看──",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "給咲戀姐姐",
    "voice": "vo_adv_5128007_069",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "和流夏姐姐。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "哪天有機會，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "請再和{0}哥哥\\n一起",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "過來旅行哦。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "為了",
    "voice": "vo_adv_5128007_070",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "在那天到來之前，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "可以好好地擔任嚮導，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n我會努力學習關於這個國家的知識。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "──希望下次",
    "voice": "vo_adv_5128007_071",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "會是你們",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "真正的新婚旅行。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n到時候，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "為了讓你們玩得盡興，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我也會幫忙的。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以一張飄落的信紙為開端，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n駛向蘭德索爾的馬車內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又掀起了一場小小的騷動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "512800701"
  }
]
