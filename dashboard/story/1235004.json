    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不適合做這種打扮。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……很適合？",
    "voice": "vo_adv_1235004_048",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很可愛？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算了，",
