    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "反正也只有",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}你會看到，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n要是你滿意的話那就沒差了。",
