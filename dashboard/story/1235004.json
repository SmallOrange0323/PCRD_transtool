  },
  {
    "type": "still",
    "still_id": "123500401"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我還在想你買了什麼衣服呢～",
    "voice": "vo_adv_1235004_046",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n原來是超正宗",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "經典魔女感的衣服啊。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "而且，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "尺寸也不對，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "手都被袖子蓋住了啦～",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦，",
    "voice": "vo_adv_1235004_047",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你跟店員說是要給高中生年紀左右的女生穿的？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不用特別講這種事嘛……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我的心白白受到傷害了啦。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n再說了，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我也覺得",
