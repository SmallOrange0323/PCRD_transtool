[
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "續‧",
    "voice": "vo_adv_1164001_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "研究報告",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「源於與世界相連的更高次元見聞」。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "又名",
    "voice": "vo_adv_1164001_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「我這絕對不是在偷懶的小優妮說詞」。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "前略，",
    "voice": "vo_adv_1164001_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "聖德蕾莎女子學院學務處負責人閣下。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n筆者在不久前，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "經由教務主任修女希爾達轉達，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n接獲了學院提出的下列要求。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "請優妮博士在將於幾天後舉辦的動靜兼備祭典",
    "voice": "vo_adv_1164001_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「聖學祭」中，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n發表平日學習的成果──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要點如上。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "無須贅述，",
    "voice": "vo_adv_1164001_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在本學院最盛大的年度活動「聖學祭」上，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n出席的並不僅限於學生的家長與當地居民，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n也囊括了許多的教育相關人士、贊助者和",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "支持者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個要求就是想向這些權威人士，",
    "voice": "vo_adv_1164001_005",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n展現本聖德蕾莎女子學院身為教育機構，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n培育出了多少傑出的學生吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_1164001_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是本學院的愛慕虛榮。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n睥睨筆者的教務主任──修女希爾達藏在眼鏡後方的眼神，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n暗示著「妳偶爾也該派上點用場吧，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個米蟲不良資優生」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對此，",
    "voice": "vo_adv_1164001_007",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "筆者立刻脫口而出的回答是：",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n「呃辦不到」四個字，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但修女並沒有因此輕易地放過筆者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳之前沒來上課，",
    "voice": "vo_adv_1164001_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一直窩在圖書館裡，到底都在做什麼？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n該不會要說自己日復一日",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "都在呼呼大睡吧？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n──她那有如蘭德索爾藏狐的眼神是這麼說的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因此，",
    "voice": "vo_adv_1164001_009",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "為了洗刷加諸於筆者身上的嫌疑，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n以下將記述筆者至今的活動紀錄，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "並附帶筆者的陳情之詞。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「盤據在這世界上的根源性虛構」。",
    "voice": "vo_adv_1164001_010",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是筆者過去鑽研的研究課題，",
    "voice": "vo_adv_1164001_011",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n向學會提出後，卻遭到了大肆嘲諷。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而筆者本人，",
    "voice": "vo_adv_1164001_012",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n也被批判為誤解學術層面假說與誇大妄想的蠢材，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n該研究徹頭徹尾地被當成了「沒有存在過的東西」──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "──似乎是如此。",
    "voice": "vo_adv_1164001_013",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "坦白說，筆者記不太清楚了。",
    "voice": "vo_adv_1164001_014",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們的大腦",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "似乎擁有防衛機制，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n會適當地遺忘",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可能造成精神層面傷害的可憎記憶，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這大概就是原因。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是說，",
    "voice": "vo_adv_1164001_015",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "老實說原因無關緊要。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "想言語化筆者的遭遇並非易事。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "早晨輕撫眼皮的陽光，",
    "voice": "vo_adv_1164001_016",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n夜裡令血液沸騰的亢奮，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n世界上的各種物事與現象，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "都在平靜地妨礙筆者進行思考。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_1164001_017",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是筆者開始嫌動腦這件事很麻煩。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "若要質問這難道並非肇因於筆者天生的特質，",
    "voice": "vo_adv_1164001_018",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n筆者也只能以「啊，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "畢竟筆者本來就有這一面啊？」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n曖昧地含糊帶過，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就連筆者都對此感到相當遺憾。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "照理來說，",
    "voice": "vo_adv_1164001_019",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n旁人應該會認為筆者的認知遭受到了某些妨礙，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但該說不出所料嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "本國的學者對此說法不屑一顧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "倘若有一名真正的有識之人，能不受停止思考的誘惑所困，",
    "voice": "vo_adv_1164001_020",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n筆者的研究或許將能迎來不同於當今的結果。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然而，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但是，事情並沒有如此發展。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "無所謂。",
    "voice": "vo_adv_1164001_021",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n反正沒有任何人",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會認真聽我這種人說的話。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500960"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在本學院的圖書館──",
    "voice": "vo_adv_1164001_022",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "通稱為「象牙之塔」中，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n有著無數具備頂尖歷史資料價值的文獻與古文書。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是一座寶山。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但不可思議的是，",
    "voice": "vo_adv_1164001_023",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不論是什麼樣的學者和有識之人，\\n都對此不感興趣。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "簡直就像感興趣這件事本身就受到禁止一般。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "回歸正題。",
    "voice": "vo_adv_1164001_024",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在那些書籍當中，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n也包含了荒誕無稽，無從判斷是神話還是童話的故事。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "舉例來說，",
    "voice": "vo_adv_1164001_025",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n那之中有一份自其他境界造訪此地的異界人們留下的活動紀錄。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n或者，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那其實是那些異界人與彼此通信的紀錄。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "至此，筆者就像個蠢材，",
    "voice": "vo_adv_1164001_026",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "試著建構了一個愚蠢的假設。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n倘若這些荒誕無稽的冒險故事是「真理」──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個世界，",
    "voice": "vo_adv_1164001_027",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n是由所在境界與我們相異的高次元存在所創造，\\n有如某種沙盒的世界──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而在此呼吸的我們，",
    "voice": "vo_adv_1164001_028",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n也同樣屬於與那些高次元存在相連的系譜──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "換言之，",
    "voice": "vo_adv_1164001_029",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果要直接換個說法，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們是──",
    "voice": "vo_adv_1164001_030",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我本來要講什麼？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊算了。",
    "voice": "vo_adv_1164001_031",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真麻煩。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "筆者正是世人所謂的筆記狂人。",
    "voice": "vo_adv_1164001_032",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n會不分大小而無謂地紀錄",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在日常生活中獲得的學問與發現。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而在相當於本人外部記憶的筆記本中，",
    "voice": "vo_adv_1164001_033",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n有數個被撕掉的項目，底下是這麼記述的──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「貪婪於睡眠　",
    "voice": "vo_adv_1164001_034",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "享受餘生吧」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「和解業已成立　",
    "voice": "vo_adv_1164001_035",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "吾正是贏家」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那道筆跡毫無疑問",
    "voice": "vo_adv_1164001_036",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是出自於筆者的手筆。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不得要領的筆致",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "宛如逃避檢閱制度的暗號。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那一定是某個時刻的我",
    "voice": "vo_adv_1164001_037",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "留給自己",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "博識的脅迫──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n抑或是搏命的祈求。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那也沒辦法了。",
    "voice": "vo_adv_1164001_038",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "既然筆者已經勝利，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n剩餘的日子就只是無關於勝負的比賽。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那麼筆者就遵從這些遺言，",
    "voice": "vo_adv_1164001_039",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "仿效愚蠢的眾生，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在這個孕育了欺瞞的世界中",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "盡情地輕鬆享受餘生吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在這個封閉的沙盒中，",
    "voice": "vo_adv_1164001_040",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n早一步捏痛自己臉頰的我很幸福。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n因為這讓我發現到夢中的夢仍然是夢。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好啊，世界，",
    "voice": "vo_adv_1164001_041",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我跟你妥協。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我往其他方面學習。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你就儘管讓我在這個悠靜的清醒夢中",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "愉快地自由行動吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以你愛怎麼封閉就怎麼封閉吧。",
    "voice": "vo_adv_1164001_042",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我會擅自在你的手掌心上，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n繼續體驗過去夢寐以求的青春劇場。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這樣你沒意見了吧？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個混帳世界。",
    "voice": "vo_adv_1164001_043",
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500730"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "──前略，",
    "voice": "vo_adv_1164001_044",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學院閣下，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n基於上述的理由，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n筆者決定徹底推辭為「聖學祭」的",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學術展覽",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "提出論文一事。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "反正就算我高聲疾呼，",
    "voice": "vo_adv_1164001_045",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也傳達不到任何人耳裡。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "still",
    "still_id": "506400201"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "追記。",
    "voice": "vo_adv_1164001_046",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n當然了，出於設籍於貴學院的義務，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n筆者將以其他形式參加該展覽，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "敬請放心。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "敬請期待新銳藝術家‧",
    "voice": "vo_adv_1164001_047",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優妮博士的自信之作。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "謹此。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "OK羅塞塔，",
    "voice": "vo_adv_1164001_048",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "世界今天也是封閉的嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在這片天空的遙遠另一端，",
    "voice": "vo_adv_1164001_049",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "有著什麼樣的事物？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我獲得的學問，",
    "voice": "vo_adv_1164001_050",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "到底有沒有意義呢？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我問你，羅塞塔，",
    "voice": "vo_adv_1164001_051",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我的聲音有傳達到嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！",
    "voice": "vo_adv_1164001_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n無法為妳的問題找到解答！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n請對假想人格提出清晰的指令！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔，",
    "voice": "vo_adv_1164001_053",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "剛才說的話有點太詩意了嗎……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好吧，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那我換個問題。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\nOK羅塞塔，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那些人還在稱我為笨蛋嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "自我搜尋",
    "voice": "vo_adv_1164001_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "可能會損害精神健康！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n請小心不要過量攝取輿論！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真相未必保證會帶來幸福──",
    "voice": "vo_adv_1164001_055",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這就叫無知便是福嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但我說你啊，",
    "voice": "vo_adv_1164001_056",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "面對主人時再慎選一下言詞吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "簡單來說，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我是想知道自己的選擇是否正確。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！",
    "voice": "vo_adv_1164001_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n「正確」的定義十分模糊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n優妮博士以前說過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "正義與正當性全憑主觀認定！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就愛跟我唱反調，",
    "voice": "vo_adv_1164001_058",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我養的石頭真叛逆。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n受不了，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這到底是像到誰了？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "OK羅塞塔，",
    "voice": "vo_adv_1164001_059",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你不要把一切都想得黑白分明。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n那種二元論",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可是會讓靈魂墮入理科的喔。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "重點在於漸層。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "愛上留白處吧，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "世界可以是曖昧不清的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_1164001_060",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是再多寵溺我一點吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "那麼，",
    "voice": "vo_adv_1164001_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "我就開啟模糊功能來回答！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n最近的優妮博士",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "每天看起來都很開心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "所以應該沒問題！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "乖孩子，",
    "voice": "vo_adv_1164001_062",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就是在等你講這種話。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "OK羅塞塔。",
    "voice": "vo_adv_1164001_063",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n剛才的玩笑話",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當然不可能呈給學院。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就不留痕跡地捨棄吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……咦？",
    "voice": "vo_adv_1164001_064",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n說到這個，沒問題是指什麼？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n世人到底是怎麼談論我小優妮的？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哎呀，",
    "voice": "vo_adv_1164001_065",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好像有人來了唷，羅塞塔。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！",
    "voice": "vo_adv_1164001_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n日安，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "「同志」先生！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊，",
    "voice": "vo_adv_1164001_067",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是{0}啊。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n歡迎來到休憩的小睡處，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "很抱歉嚇到你了。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一如你所知，",
    "voice": "vo_adv_1164001_068",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我是象牙之塔的優妮。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這邊則是試著把會說話的石頭羅塞塔",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "搭載在人型身體上的個體。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為目前還在實驗階段，",
    "voice": "vo_adv_1164001_069",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒辦法讓它做出複雜的動作，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但我在它的身體上投射了與我很像的幻影。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如何？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在旁人看來，簡直就像是對美女雙胞胎姊妹吧？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是、",
    "voice": "vo_adv_1164001_070",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一模一樣啊……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雖然這話是我自己講出來的，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但你的眼睛",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是不是不太好啊……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "「像」的定義全憑主觀認定！",
    "voice": "vo_adv_1164001_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n不必認真看待個人的感想",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "也沒關係！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1164001_072",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為要再等幾年才會實際運用人型羅塞塔，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我有為仿生體預先設置一點成長空間。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要是相似到連自己人都分不出來，",
    "voice": "vo_adv_1164001_073",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n只會被克蘿依或琪愛兒她們以各種方式濫用啊。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我的目標是似像非像",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但又有點像的絕妙界線。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "「絕妙」的定義全憑主觀認定！",
    "voice": "vo_adv_1164001_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "先講先贏！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500970"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……好了，",
    "voice": "vo_adv_1164001_075",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "名為休息的逃避現實到此為止。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n羅塞塔，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "慢慢來開始調整自動運動迴路吧。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？",
    "voice": "vo_adv_1164001_076",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "同志，你怎麼了？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看你一臉驚訝的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你該不會以為我逃離克蘿依的瘋狂特訓，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就只是來找我養的石頭，耽溺於在它的大腿上睡覺吧？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "答對了！",
    "voice": "vo_adv_1164001_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "這是無從逃避的真相！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "別說傻話了。",
    "voice": "vo_adv_1164001_078",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n表面上看來或許是這樣，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但內情是我沉浸在調整迴路的思考實驗中。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔，",
    "voice": "vo_adv_1164001_079",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你還不懂嗎？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我打算讓羅塞塔在聖學祭上扮演我的替身。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你問為什麼？",
    "voice": "vo_adv_1164001_080",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你也有聽學生會長說過了吧，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n即將來臨的「聖學祭」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "攸關我們優妮們的命運。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "是啊！",
    "voice": "vo_adv_1164001_081",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n事關我們好朋友社的命運呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因此，",
    "voice": "vo_adv_1164001_082",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那是一場不能輸的戰鬥。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以被評為比上陸的海豚還要慢的優妮博士，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可不能厚著臉皮，踰矩地參加激烈的運動競賽。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優妮們就由我來守護！",
    "voice": "vo_adv_1164001_083",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不管要耍什麼手段，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我都不會讓這如夢似幻的青春劇場結束的！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "消極中的積極！",
    "voice": "vo_adv_1164001_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n博士",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "好帥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "別說了，",
    "voice": "vo_adv_1164001_085",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我會害羞的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好了，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我要請你一起來幫忙，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "共同研究者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？",
    "voice": "vo_adv_1164001_086",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "喂，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "{0}學弟，你怎麼了？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你在那邊東張西望又左顧右盼個什麼？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我不是拜託其他人，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "正是要請你來幫忙啊，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "共同研究者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我明白。",
    "voice": "vo_adv_1164001_087",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但那有什麼問題？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我有求於你的並非知識，也不是技術。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我以前",
    "voice": "vo_adv_1164001_088",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "應該有說過啊。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你只要在旁邊",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "聽我說話就夠了。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我的學問",
    "voice": "vo_adv_1164001_089",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是只為我存在的東西。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n本來就沒有要讓別人知道的企圖和野心。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……但是呢。",
    "voice": "vo_adv_1164001_090",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只有一個人也好，",
    "voice": "vo_adv_1164001_091",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果有個願意傾聽的人站在我這邊──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "光是如此，",
    "voice": "vo_adv_1164001_092",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就覺得自己的學問是有所回報的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我很感謝你。",
    "voice": "vo_adv_1164001_093",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n謝謝你平日的關照。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}不太明白",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優妮在說些什麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻知道優妮好像很高興，便跟著一起露出了微笑。",
    "voice": null,
    "unit_id": null
  }
]
