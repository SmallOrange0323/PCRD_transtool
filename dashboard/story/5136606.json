[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "晶のことが気になっているノウェムは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n同じ七冠である誓約女君に、どんな人物か尋ねてみることにした。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そういえば、",
    "voice": "vo_adv_5110606_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "前々から気になってたんだけど……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n晶って、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "本当はどんなヤツなんだ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "なんだ、",
    "voice": "vo_adv_5110606_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "その曖昧な質問は。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nどんなヤツも何も、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "見たままだろう？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ワタシたちの野望を阻もうとする敵だ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そういうことじゃなくてさ～、",
    "voice": "vo_adv_5110606_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "現実でも会ったことあるんだろ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アイツ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いつもあんな感じだから、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "人柄とか分かんないんだよ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "その辺、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "クリスティーナだったら",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "知ってるんじゃないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ものすごく正義感が強いとか、",
    "voice": "vo_adv_5110606_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "逆に現実だとすごく悪いヤツだとかさ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "他にもぬいぐるみを抱いて寝てるとか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おやつはマカロンとか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nそういう感じの情報でもいいぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "おかしな想像をさせるな！",
    "voice": "vo_adv_5110606_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n断じて、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "そんなフワフワキラキラした趣味などヤツにはない……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "と思う。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "しかしクレープ屋とかもやっていたな、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "もしや裏では……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そ、",
    "voice": "vo_adv_5110606_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そこまで真剣に悩まなくていいぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "プライベートなことが分からないなら、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "職場での話でもいいし。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nなにか思いついたりしないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "開発現場でも、",
    "voice": "vo_adv_5110606_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ずっとあの調子だったな。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "言われたことはそつなくこなすが、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "気に入らないことには",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nはっきり気に入らないと言い放つ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "それでいて",
    "voice": "vo_adv_5110606_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "普段は率先して周りを手助けしていたから、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nプロジェクトメンバーからの人望は厚かった。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我々とは",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "袂を分かつことになったがな。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "わ、",
    "voice": "vo_adv_5110606_008",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "分かったような分からないような……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんていうか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いいヤツそうだっていうのは分かったけど、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "イマイチこう……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "掴みどころがない",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "って感じだぞ……？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "実際、",
    "voice": "vo_adv_5110606_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "そういう女だ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nいつもヘラヘラして、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "心の奥底に抱え込んでいるものは、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n決して他人に見せようとしない。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "それなりに付き合いはあったはずなのだが……",
    "voice": "vo_adv_5110606_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ワタシは晶の本心というものを、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "心から確信できた覚えがない。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そっか。",
    "voice": "vo_adv_5110606_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "じゃあクリスティーナにとって、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n晶はそんなに大事な友達だったんだな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "人の話を聞いていたのか？",
    "voice": "vo_adv_5110606_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nワタシは今、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ヤツの心が分からないと言ったんだ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "なぜ、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "大事な友達ということになる？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "大切って思ってないヤツのことで、",
    "voice": "vo_adv_5110606_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nそんな真剣に考え込むことないだろ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシも、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "どうでもいいことはすぐ忘れるしな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "子どものくせに、",
    "voice": "vo_adv_5110606_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ませたことを言う。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "だが……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "そうだな、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "認めよう。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n間違いなく、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "数少ない友人のうちの一人だとは思う。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "やっぱりそうか！",
    "voice": "vo_adv_5110606_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nでも、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "クリスティーナがそこまで認めるなんてな。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nもしかして",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アストルムの強さでも",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "向こうが上なのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "断じて違う！",
    "voice": "vo_adv_5110606_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "うわぁ！？",
    "voice": "vo_adv_5110606_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nな、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんだよ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "急に大声を出すな！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "びっくりするだろ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "キサマがふざけたことを言うからだ！",
    "voice": "vo_adv_5110606_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nこのワタシが",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "晶より弱いなどということはありえん！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nレジェンドオブアストルムに限らずだ！！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "レースゲームでは87戦44勝で勝ち越しているし、",
    "voice": "vo_adv_5110606_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n格闘ゲームでは123戦61勝で……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "む、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "これは負け越しているな。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "他には腕相撲なんかだと……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "わ、",
    "voice": "vo_adv_5110606_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "分かった！　",
