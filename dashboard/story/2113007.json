  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "父親大人……！",
    "voice": "vo_adv_2113007_000",
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "抱歉，",
    "voice": "vo_adv_2113007_001",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "可可蘿……",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀……！",
    "voice": "vo_adv_2113007_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n竟然抓受傷的人",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "作為人質……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不可以做出",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這種事情哦，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不乖喔！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不乖喔！",
    "voice": "vo_adv_2113007_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就算妳這樣說我──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我也是有",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "很多苦衷的啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "苦、",
    "voice": "vo_adv_2113007_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "苦、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "苦衷……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "對。",
    "voice": "vo_adv_2113007_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我剛才也有說過吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我的目的",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就是索爾魔珠。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "在我造成無謂的傷害之前，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "希望你們能快點老實交出來呢──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的意思是，",
    "voice": "vo_adv_2113007_006",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要我們用索爾魔珠交換小可蘿的父親嗎？",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真沒想到你和彌勒",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都用這麼卑鄙的手段……！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "噁。",
    "voice": "vo_adv_2113007_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n什麼，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "意思是他也幹了類似的事嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊──討厭討厭，",
    "voice": "vo_adv_2113007_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "光是要綑綁男人就很討厭了，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這明明不是我的興趣啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "still",
    "still_id": "211300701"
  },
  {
    "type": "background",
    "bg_id": "501204"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然討厭，一開始就別做啊！",
    "voice": "vo_adv_2113007_009",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n變態！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "露肚臍男！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "歪理一堆的妹妹頭！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊，好過分──",
    "voice": "vo_adv_2113007_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "有必要說到這種地步嗎──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……我想想，",
    "voice": "vo_adv_2113007_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n該怎麼辦呢？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "若你們肯先解除那個可怕的強化，我會很高興的──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "…………",
    "voice": "vo_adv_2113007_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不愧是",
    "voice": "vo_adv_2113007_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "正義的夥伴，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這麼識相真是幫了大忙。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這個角色作為人質的價值",
    "voice": "vo_adv_2113007_014",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "比我想的還要高呢。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "假如你們無視要求攻擊過來，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我馬上就會開溜了說。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就算被稱為「長老」，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這終究",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "仍只是個空殼啊──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要對父親大人見死不救，",
    "voice": "vo_adv_2113007_015",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這種事",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下辦不到……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_2113007_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就是說啊♪",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那就照這樣子，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "把那東西交出來吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "最後的索爾魔珠",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就在妳身上對吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔……",
    "voice": "vo_adv_2113007_017",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……彌勒就不用提了。",
    "voice": "vo_adv_2113007_018",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要是把魔珠交給尾狗刀，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可不知道",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他會拿去做什麼壞事。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……但是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若不交給彌勒，",
    "voice": "vo_adv_2113007_019",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛梅斯大人會有危險，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若不交給尾狗刀，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "父親大人會有危險。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有，",
    "voice": "vo_adv_2113007_020",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若湊不齊索爾魔珠，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n將會失去拉比林斯達小姐犧牲自己",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所指示的，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n「返回現實的方法」……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊啊。",
    "voice": "vo_adv_2113007_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "該如何是好……！　",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "……別管我，",
    "voice": "vo_adv_2113007_022",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "可可蘿。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！？",
    "voice": "vo_adv_2113007_023",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "那顆魔珠",
    "voice": "vo_adv_2113007_024",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "對妳來說──",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "不，",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n若那是引導妳主人的必要之物，",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "千萬不可以交出去。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n妳就當作",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "我已經死了便是。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可、",
    "voice": "vo_adv_2113007_025",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n父親大人……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊，",
    "voice": "vo_adv_2113007_026",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是夠了──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這NPC話也太多了吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n可以請你",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "別多嘴嗎──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "……唔……",
    "voice": "vo_adv_2113007_027",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……！",
    "voice": "vo_adv_2113007_028",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "……可可蘿，",
    "voice": "vo_adv_2113007_029",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "妳聽好了。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n妳要",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "與妳的主人一同，",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "朝你們的路前進。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n不可以賴著我這種老骨頭不放，",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "耽誤了未來。",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "……更何況，",
    "voice": "vo_adv_2113007_030",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n要是就如這男人所言……",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n我並不是妳真正的父親，",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "那就更不用說了……",
    "voice": null,
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎、",
    "voice": "vo_adv_2113007_031",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼這樣……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……可蘿仔……",
    "voice": "vo_adv_2113007_032",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……小碧、",
    "voice": "vo_adv_2113007_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "美里老師……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n可以請妳們引開露肚臍男的注意力嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？",
    "voice": "vo_adv_2113007_034",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n什麼！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……！",
    "voice": "vo_adv_2113007_035",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "初音……！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好～",
    "voice": "vo_adv_2113007_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那就──",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那邊的男孩，",
    "voice": "vo_adv_2113007_037",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你叫作尾狗刀",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "求求你，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望你能稍微",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "聽我說幾句話。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦──？",
    "voice": "vo_adv_2113007_038",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n只能稍微聽一下哦──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你♪",
    "voice": "vo_adv_2113007_039",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那就……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為什麼你要做這種事呢？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n可以請你",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "告訴老師嗎？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那當然是……",
    "voice": "vo_adv_2113007_040",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "因為我是「壞蛋」啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這是壞蛋會做的事，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以挾持人質",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "和欺負弱小是無法避免的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀……",
    "voice": "vo_adv_2113007_041",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n別說什麼",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是「無法避免」的話。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒有人天生就是個「壞蛋」的。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯──",
    "voice": "vo_adv_2113007_042",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "可是，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "出生環境和才能是早就註定好了的吧──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以我覺得也是會有",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不扭曲個性就會渾身不自在的小孩呢──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幹、",
    "voice": "vo_adv_2113007_043",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幹嘛啦……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別看我，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我宰了你哦……！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……確實……",
    "voice": "vo_adv_2113007_044",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "孩子無法選擇父母。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但是，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "正因為這樣，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師才會──",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我才會",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "想把愛平等地分給所有孩子。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只要",
    "voice": "vo_adv_2113007_045",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "教導他們何謂愛……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我相信，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "即使他們",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跑去做了壞事，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n也能重新來過的。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當然",
    "voice": "vo_adv_2113007_046",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你也一樣哦，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n尾狗刀。",
    "voice": null,
    "unit_id": 101511
  },
