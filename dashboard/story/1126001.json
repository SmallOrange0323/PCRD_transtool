    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "妳才老是嘮叨一些雞毛蒜皮的小事！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "還不是你在那邊拖拖拉拉的，",
    "voice": "vo_adv_1126001_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "特價品才會賣完不是嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n結婚之後每次都是這樣……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "明明是妳什麼都沒說不是嗎！",
    "voice": "vo_adv_1126001_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n妳才是每次都當事後諸葛——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "等等，",
    "voice": "vo_adv_1126001_028",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "Stop Stop～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "兩位，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不要這麼火爆——！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "夫婦",
    "words": "小未央！？",
    "voice": "vo_adv_1126001_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "在別人店門口吵架的話，",
    "voice": "vo_adv_1126001_030",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "可是會妨礙到生意的對吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "稍微冷靜一下，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "……妳聽我說，",
    "voice": "vo_adv_1126001_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "小未央。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n不只是因為特價品，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "是這個人老是——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "沒辦法，",
    "voice": "vo_adv_1126001_032",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我買到的特價品就讓給妳吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嘿欸，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "乾脆3人份全部送妳",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "拿去拿去——！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "哎呀，",
    "voice": "vo_adv_1126001_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "可是——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好了，",
    "voice": "vo_adv_1126001_034",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣就解決了。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不可以吵架囉！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你們兩個",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一定要好好相處喔？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼就，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "掰掰——☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "怎麼行，我們不能收……",
    "voice": "vo_adv_1126001_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "啊啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "跑掉了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "你們真幸運呢，",
    "voice": "vo_adv_1126001_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "遇見小未央那樣的好孩子。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "那孩子不來阻止你們吵架的話",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "可不知道會怎樣呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "哎呀……",
    "voice": "vo_adv_1126001_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "居然讓那麼年輕的孩子替我們著想，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n還真是做了件丟人現眼的事呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "果然拿小未央沒辦法呢。",
    "voice": "vo_adv_1126001_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n那孩子總是讓大家活力十足，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "就像商店街的看板娘一樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "哈哈，",
    "voice": "vo_adv_1126001_039",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "這種說法太老派啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "\\n現在不說看板娘了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "應該要說「偶像」才對吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "喔喔～",
    "voice": "vo_adv_1126001_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "這麼一說的確是呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n如果小未央成為了真的偶像，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "肯定每天都充滿樂趣吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊啊啊啊啊～",
    "voice": "vo_adv_1126001_041",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "搞砸了！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "乘著勢頭就把肉送出去了，",
    "voice": "vo_adv_1126001_042",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "晚餐要怎麼辦！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "沒有主菜，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "只準備青菜和湯嗎？　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一點也不豪華啊！　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "到別間店重新買肉嗎？",
    "voice": "vo_adv_1126001_043",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……不，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這可不行！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n這個月已經很吃緊了沒辦法再有意外的花費了啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "有沒有…",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "有沒有什麼好方法——",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "――啊！　",
    "voice": "vo_adv_1126001_044",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我想到了――！！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "still",
    "still_id": "112600101"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "來吧～",
    "voice": "vo_adv_1126001_045",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "妳們兩位，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "肯定餓了吧？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n小未央的特製晚餐，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "請盡情享用吧☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……吶，",
    "voice": "vo_adv_1126001_046",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n這肉看起來是紫色的，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是錯覺嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊……",
    "voice": "vo_adv_1126001_047",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那個……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對、",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是香辛料！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是香辛料的顏色啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n不小心一口氣放了太多就變成這樣了，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "小未央真是迷糊啊☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "另外這塊肉，",
    "voice": "vo_adv_1126001_048",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不覺得軟得有點詭異嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n感覺不像是動物，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "反而像是史萊姆之類的……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是、",
    "voice": "vo_adv_1126001_049",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是錯覺是錯覺！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n大概",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "只是因為食材新鮮才會看起來像那樣啦～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真是的～",
    "voice": "vo_adv_1126001_050",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "兩位怎麼了呢？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n我都好好試吃過了，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "味道可是掛保證的喔？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不，",
    "voice": "vo_adv_1126001_051",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不是味道的問題……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n這些肉，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是從店裡買回來的嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "still",
    "still_id": "112600102"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "呃！",
    "voice": "vo_adv_1126001_052",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我從來沒看過",
    "voice": "vo_adv_1126001_053",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "有商店賣這種肉品呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n妳去的是平常的那間店對吧？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就是說啊。",
    "voice": "vo_adv_1126001_054",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n明明蔬菜和水果都很普通，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "為什麼只有肉……？",
    "voice": null,
    "unit_id": 112411
  },
  {
