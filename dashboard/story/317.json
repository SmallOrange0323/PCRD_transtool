[
  {
    "type": "dialogue",
    "name": "凜、卯月、未央",
    "words": "到了～！！",
    "voice": "vo_adv_0000317_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "呼、",
    "voice": "vo_adv_0000317_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "呼……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "終於到頂端了呀～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n真厲害呢～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "哇……",
    "voice": "vo_adv_0000317_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "快看，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "大家。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n外面的",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "景色好美。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真不賴呢，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "站在天際上。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "真的呢。",
    "voice": "vo_adv_0000317_003",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n這樣的景色，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "以前從來就沒有看過……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然我們有很多以前的事想不起來。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "吶，",
    "voice": "vo_adv_0000317_004",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "雖然這只是我猜的……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "但盆栽小花",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是不是",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "想要讓我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n看看這樣的景色呀？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳說盆栽小花嗎？",
    "voice": "vo_adv_0000317_005",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯。",
    "voice": "vo_adv_0000317_006",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "朝著目標的那片天加油吧～！　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n雖然我也不知道該怎麼解釋。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……原來如此。",
    "voice": "vo_adv_0000317_007",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "以最高處為目標的試煉，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "似乎也不壞呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "如果是這樣的話，我們",
    "voice": "vo_adv_0000317_008",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "或許在這趟冒險中又朝著頂尖偶像",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n邁進一步了也說不定！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……\\n嗯，",
    "voice": "vo_adv_0000317_009",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "果然妳們三個人啊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的是偶像呢。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留？",
    "voice": "vo_adv_0000317_010",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也不是什麼大不了的事啦。",
    "voice": "vo_adv_0000317_011",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是看著妳們像這樣不顧一切地、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n樂觀正面地",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "朝著嚮往的天際向前邁進……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就覺得這或許是成為偶像必要的條件吧～",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯～",
    "voice": "vo_adv_0000317_012",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣算是在誇獎我們嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我想大概是誇獎吧。",
    "voice": "vo_adv_0000317_013",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "謝謝妳的誇獎，",
    "voice": "vo_adv_0000317_014",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_0000317_015",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才沒有在誇獎妳們咧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳們不要擅作主張地誤會好不好！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呀哈哈♪",
    "voice": "vo_adv_0000317_016",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "害羞的小凱留，真可愛呢！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "簡直就是偶像等級的可愛！　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇咿哇咿～♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_0000317_017",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對在下等人來說，是永遠的偶像。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別、",
    "voice": "vo_adv_0000317_018",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別講那些聽不懂的鬼話啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "小心我真的宰了妳們喔！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈哈！",
    "voice": "vo_adv_0000317_019",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n凱留凱留真可愛呢～♪",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不過說到頭來，",
    "voice": "vo_adv_0000317_020",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我們也和【美食殿堂】的各位創造了一段美好回憶，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真是一趟很棒的冒險。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯！",
    "voice": "vo_adv_0000317_021",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "也再次整理好心情",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "能朝成為偶像這個目標邁進！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "今後也要為了成為一個優秀的偶像，",
    "voice": "vo_adv_0000317_022",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "再繼續加油了呢！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月、凜、未央",
    "words": "喔──♪",
    "voice": "vo_adv_0000317_023",
    "unit_id": null
  }
]
