  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對初夢許的願望啊。",
    "voice": "vo_adv_5134063_000",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然是要許願",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能以名偵探",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "的身分，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n解決更加困難的事件。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然，",
    "voice": "vo_adv_5134063_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生也會跟我一起。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n名偵探需要有優秀的助手……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且搞不好還會因為解決事件，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓我們的羈絆也加深呢！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼",
    "voice": "vo_adv_5134063_002",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明天也要早起，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就先睡覺吧。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……呼",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……呼……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406301"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔……",
    "voice": "vo_adv_5134063_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_5134063_004",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生抱歉啊。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為跟蹤了很久，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以我的注意力好像開始有點渙散了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "畢竟這次跟蹤的目標，",
    "voice": "vo_adv_5134063_005",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是以小心謹慎而出名的呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為此我們也需要慎重行事，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以防被發現。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以我們現在",
    "voice": "vo_adv_5134063_006",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "才會像這樣處於目標的斜後方，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n裝成情侶",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "融入在群眾當中跟蹤。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如何？",
    "voice": "vo_adv_5134063_007",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣絕對不會被發現對吧。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這種腳踏實地的調查，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "正是展現偵探實力的地方。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且為了推理，",
    "voice": "vo_adv_5134063_008",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "線索也是越多越好……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": "vo_adv_5134063_009",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n糟、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "糟了，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "光顧著聊天就沒有注意到……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想想，",
    "voice": "vo_adv_5134063_010",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "請、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "請抱緊我，助手先生！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我們就假裝是在親熱的情侶來蒙混過去吧！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406302"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對、",
    "voice": "vo_adv_5134063_011",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對啊！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n像這樣整個人抱上來，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n緊緊抱住的話，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還能遮住我們的臉……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但是",
    "voice": "vo_adv_5134063_012",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好像有點呼吸困難……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不是抱的方式不好……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "應該說",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是各方面都太刺激了嗎……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406303"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦，",
    "voice": "vo_adv_5134063_013",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為什麼你要貼得更緊呢！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n要是再更激烈的話，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "反而會引起注目……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不行，",
    "voice": "vo_adv_5134063_014",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這裡可是人來人往的地方啊！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不能做這種不知羞恥的……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊啊……！",
    "voice": null,
    "unit_id": 128511
  },
