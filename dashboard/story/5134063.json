    "voice": "vo_adv_5134063_018",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "算了，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "世界上有一個無解之謎也沒關係嘛！",
    "voice": null,
    "unit_id": 128511
  },
