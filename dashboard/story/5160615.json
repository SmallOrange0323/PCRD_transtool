    "voice": "vo_adv_5160615_000",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "招待我來。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是伴手禮的果汁。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "謝謝妳，",
    "voice": "vo_adv_5160615_001",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "莫妮卡。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "咲戀！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "莫妮卡來了喔。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我也整理好房間裡的行李了……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "歡迎妳來，莫妮卡。",
    "voice": "vo_adv_5160615_002",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們兩個，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "來，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "穿上這個。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "這是，",
    "voice": "vo_adv_5160615_003",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "圍裙？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "為什麼要給我們這個……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "莫妮卡去幫忙準備料理。",
    "voice": "vo_adv_5160615_004",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "梅杜莎，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就拜託妳跟小孩子們一起去端菜吧。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "什、",
    "voice": "vo_adv_5160615_005",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "什麼啊啊！？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我要幫忙嗎──！？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我是聽說",
    "voice": "vo_adv_5160615_006",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "今天是我的歡迎派對才對啊？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊。",
    "voice": "vo_adv_5160615_007",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在育幼院",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就算是派對的主角也要工作。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "天下沒有白吃的午餐喔。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為我們這邊人數很多，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以去幫忙是理所當然的喔。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_5160615_008",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳教育得很好呢。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只要努力準備的話，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就能早點吃到飯，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在工作後吃的飯",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會變得更好吃喔。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "俗話說",
    "voice": "vo_adv_5160615_009",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "入鄉隨俗啊。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就拜託",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們兩個了喔。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我會去幫鈴莓的。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "唉，",
    "voice": "vo_adv_5160615_010",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "為什麼我要做這種事情……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "因為我平常沒有照顧人過，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "所以很麻煩啊……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "咲戀媽媽！",
    "voice": "vo_adv_5160615_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "我擦完桌子了喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我排好盤子了！",
    "voice": "vo_adv_5160615_012",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們兩個",
    "voice": "vo_adv_5160615_013",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很努力了呢。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼接下來，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可以請你們去幫別的孩子嗎？",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好～！",
    "voice": "vo_adv_5160615_014",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……明明連那種小不點",
    "voice": "vo_adv_5160615_015",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "都毫無怨言地工作著，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我卻一直在抱怨。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "這樣很遜呢。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "咲戀！",
    "voice": "vo_adv_5160615_016",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我這邊結束了喔！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n接下來要做什麼才好？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝妳。",
    "voice": "vo_adv_5160615_017",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼接下來",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "幫我去拿追加的木柴。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，準備順利進行著，餐桌上擺上了一個大鍋子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "這是",
    "voice": "vo_adv_5160615_018",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "火鍋……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "用大鍋子",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "將食材煮熟而已的料理。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n然後大家圍著它一起吃……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "小孩子你一言我一語的很吵鬧，",
    "voice": "vo_adv_5160615_019",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n跟我和姊姊們一起住時的",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "優雅晚餐差了非常多。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "但是……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我完全",
    "voice": "vo_adv_5160615_020",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不討厭這樣，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不對，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我覺得很有趣！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n跟大家一起吃的飯，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "居然這麼好吃啊……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎，",
    "voice": "vo_adv_5160615_021",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳的碗空了喔。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來吧，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我幫妳撈料吧。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "謝謝妳。",
    "voice": "vo_adv_5160615_022",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "幫我裝很多肉吧！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂，",
    "voice": "vo_adv_5160615_023",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "孩子們也要吃啊。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "稍微自重一點啦。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "相對的，我會幫妳撈很多蔬菜的。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "啊！",
    "voice": "vo_adv_5160615_024",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "真得很過分，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "妳這樣是在虐待蛇啊，虐待蛇！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊哈哈，",
    "voice": "vo_adv_5160615_025",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為肉也還有很多，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以放心吧。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n要先從蔬菜好好吃起喔。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "先吃蔬菜",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好像對美容也很有效喔。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……",
    "voice": "vo_adv_5160615_026",
    "unit_id": 133612
