  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那一天，咲戀育幼院為了歡迎梅杜莎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n舉辦了火鍋派對。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
