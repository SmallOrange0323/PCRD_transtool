    "name": "宮子",
    "words": "它有錯！",
    "voice": "vo_adv_5080006_099",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這傢伙吃掉了宮子的布丁喲！",
