  },
  {
    "type": "dialogue",
    "name": "妖精",
    "words": "啾～～！",
    "voice": "vo_adv_5080006_097",
    "unit_id": 15511
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看它的反應似乎就是這樣啦。",
