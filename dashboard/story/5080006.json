[
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "什麼嘛……",
    "voice": "vo_adv_5080006_000",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子才沒有做什麼壞事……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，",
    "voice": "vo_adv_5080006_001",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家偷吃了一口婆婆的布丁……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n雖然婆婆不計較，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但宮子",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "卻沒有好好跟她道歉……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子得跟婆婆道歉……",
    "voice": "vo_adv_5080006_002",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家不想見到",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "其他傢伙。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "他們",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "都認為，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n是宮子偷吃了他們的點心……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就是說嘛，",
    "voice": "vo_adv_5080006_003",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子要是真的吃掉了他們的點心，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n婆婆就可以奪冠了喲……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果做了這樣的事，",
    "voice": "vo_adv_5080006_004",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆會傷心的……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n到底該怎麼辦才好……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就這樣直接消失的話，",
    "voice": "vo_adv_5080006_005",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "誰也找不到宮子……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家不管了……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "隨便大家想怎樣就怎樣……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是……",
    "voice": "vo_adv_5080006_006",
    "unit_id": 119911
  },
  {
    "type": "background",
    "bg_id": "500895"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……！",
    "voice": "vo_adv_5080006_007",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說什麼果然啊！",
    "voice": "vo_adv_5080006_008",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子不在這裡喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n不知道跑去哪裡了喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "still",
    "still_id": "508000601"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……人家當然知道喲。",
    "voice": "vo_adv_5080006_009",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n一回神過來，就發現自己在這裡了。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆",
