    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "生氣了嗎？",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大家都認為宮子做了壞事喲。",
    "voice": "vo_adv_5080006_011",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以，婆婆肯定也……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這、",
    "voice": "vo_adv_5080006_012",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "…………",
    "voice": "vo_adv_5080006_013",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "反正……",
    "voice": "vo_adv_5080006_014",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
