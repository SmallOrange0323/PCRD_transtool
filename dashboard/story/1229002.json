    "words": "奇怪？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n過來時候的沙灘不見了！？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n怎麼回事～？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這麼說起來，",
    "voice": "vo_adv_1229002_034",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華在看的圖鑑裡，",
    "voice": null,
    "unit_id": 122911
  },
