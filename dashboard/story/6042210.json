  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "こないだあんたに呼ばれて、",
    "voice": "vo_adv_6038210_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ヨロイみたいの倒すバイトしたじゃん。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "……なんか今にして思えばメ団のねえさんたちいたような気するけど。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "で、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "世界の危機？（笑）",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "　つったっけ？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "結局アレって何だったワケ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "嘔吐、",
    "voice": "vo_adv_6038210_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "週末……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんか飲み会的なやつ？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そいや派遣のねえさん、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nじゃぼじゃぼ飲み散らかしてるの一人いたけど……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ユカリさんかアレ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "で、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "その会になんでうち呼んだの。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "紹介したかった？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "きも、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "彼氏かよ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そうそう、",
    "voice": "vo_adv_6038210_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "世界とか国とか、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "現場のねえさんたちわりと主語デカめで。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんかみんな",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "「おのれ世界の敵め！」みたいなノリで若干引いたわ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "しゃーないからうちも一緒に",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "「おのれ！」みたいな顔しといたけどさ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "分からないって……",
    "voice": "vo_adv_6038210_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あー",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ハイハイ、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うちには言えないってことね。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ま、理由とかいいけどさ、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "もしあんたがまたなんか困ったときは……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ちょっと待って。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あんた",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "本当に分かってないわけじゃないよね？",
