  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "手裡拿著神祕書本、來到【伊麗莎白牧場】的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哦～",
    "voice": "vo_adv_9002008_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天配送也辛苦啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "書？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是栞栞的包裹的啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽，",
    "voice": "vo_adv_9002008_001",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不是啦。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n今天是……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_9002008_002",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天是那個日子對吧♪",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊、",
    "voice": "vo_adv_9002008_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊～！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家明明就準備了這麼久，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n結果我卻忘記了最重要的老哥到來之日啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝妳告訴我啊！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不，",
    "voice": "vo_adv_9002008_004",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那並不是什麼了不起的事……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "鈴怎麼了呢？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明明那麼努力準備了。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天還沒有看見她，",
    "voice": "vo_adv_9002008_005",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該不會一直在睡覺吧？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "八成就是在睡覺啦。",
    "voice": "vo_adv_9002008_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n去把鈴鈴",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "叫起床吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我知道了。",
    "voice": "vo_adv_9002008_007",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "鈴的房間裡大概",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n也有那個，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我一起拿過來唷。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "鈴～！",
    "voice": "vo_adv_9002008_008",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "重要的日子裡不許睡過頭啊～！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈，",
    "voice": "vo_adv_9002008_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "笨手笨腳的對不起呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥從那麼遠的地方走過來，應該累了的啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n不如",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就泡個溫泉等一下吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "泡完澡後，喝個印有伊麗莎白牧場標記的牛奶，",
    "voice": "vo_adv_9002008_010",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "很美味喔～",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你還有必須要去的地方呢。",
    "voice": "vo_adv_9002008_011",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "既然如此，還強留你就太不識相的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還是至少喝杯牛奶吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒什麼，",
    "voice": "vo_adv_9002008_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要說謝謝的是我這邊的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "畢竟一直受到老哥你的幫助嘛。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牧場快要被沒收的時候也是，",
    "voice": "vo_adv_9002008_013",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n真的承蒙老哥諸多照顧啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "能有現在的牧場",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "都是多虧了大家",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還有老哥的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不管我多麼想要報恩，",
    "voice": "vo_adv_9002008_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n感覺恩情也只是越積越多，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過能和大家、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n和老哥一直在一起的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就太幸福啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "久等了～",
    "voice": "vo_adv_9002008_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n那個東西",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我帶過來囉～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳雖然一副理所當然的樣子登場，",
    "voice": "vo_adv_9002008_016",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但睡著了對吧？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "叫她起床真是太辛苦了……",
    "voice": "vo_adv_9002008_017",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而且叫起床之後，她還不太能理解狀況。",
    "voice": "vo_adv_9002008_018",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好了好了，",
    "voice": "vo_adv_9002008_019",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這些細節就不要在意、不要在意。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "然後呢？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就是這本書對吧，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "借我一下喔。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "把這個這樣～",
    "voice": "vo_adv_9002008_020",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這裡就這樣～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "完成了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還給你吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要好好送到下一個地方唷。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥的話",
    "voice": "vo_adv_9002008_021",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不必擔心就是了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "路上小心。",
    "voice": "vo_adv_9002008_022",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "慢走唷～♪",
    "voice": "vo_adv_9002008_023",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【伊麗莎白牧場】諸位成員目送中離去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}邁步出發前往",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n下一個目的地。",
    "voice": null,
    "unit_id": null
  }
]
