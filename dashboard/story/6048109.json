  {
    "type": "dialogue",
    "name": "依里",
    "words": "進入茜里的身體，",
    "voice": "vo_adv_6048109_000",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "讓我又重新",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "思考了很多",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n關於那個孩子的事呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這還用說嗎？",
    "voice": "vo_adv_6048109_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "當然是不管誰說什麼，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那孩子都是我最棒的妹妹。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我只是",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "更清楚明白了這一點而已。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是……",
    "voice": "vo_adv_6048109_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒有因為我的身體",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "留下什麼不好的回憶嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "如果過得開心的話就好了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是個好機會，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "去好好和茜里聊一聊吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "唔，",
    "voice": "vo_adv_6048109_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個豐滿感",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的確讓我",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有點羨慕呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我和那孩子可是姊妹喔？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "將來我一定也能……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等等，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你想讓我說什麼啊笨蛋！",
    "voice": null,
    "unit_id": 102211
  }
]
