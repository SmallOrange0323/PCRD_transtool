  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好像對我有很多誤解……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "她說希望",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我能教她有關忍者的事情耶。",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我該怎麼辦才好……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連、",
    "voice": "vo_adv_6042204_001",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連前輩也這樣～！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "教前輩的話……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這說不定",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是個好機會……？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只有我和前輩，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "兩人獨處……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "光是想像",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我就緊張到快昏倒了……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "躲藏……",
    "voice": "vo_adv_6042204_002",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗎？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我其實並沒有多小心翼翼地躲起來……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "事實上，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只是誰都沒有注意到我而已……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "才才、",
    "voice": "vo_adv_6042204_003",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "才不是呢！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "看起來有點失望……？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n呃……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我搞不好",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真的是個",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "忍者喔……",
    "voice": null,
    "unit_id": 113011
  }
]
