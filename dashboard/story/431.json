[
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……一群蟲子。",
    "voice": "vo_adv_0000431_000",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n竟敢一窩蜂地聚集起來",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "礙我的事……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_0000431_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請看這裡！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n保護霸瞳皇帝的結界，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "力量正在逐漸變弱！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_0000431_002",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也罷。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n只用現有的魔力，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n要轟飛你們所有人也綽綽有餘……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還有",
    "voice": "vo_adv_0000431_003",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "剛才妨礙我的那群傢伙，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我要讓你們連同這整個國家一起",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "回歸塵土！",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不會讓妳得逞的！",
    "voice": "vo_adv_0000431_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們上吧！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "加油呀，",
    "voice": "vo_adv_0000431_005",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥還有大家！",
    "voice": null,
    "unit_id": 102111
  }
]
