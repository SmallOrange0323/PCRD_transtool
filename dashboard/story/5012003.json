    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "真是期待那黑暗的絕望。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚、",
    "voice": "vo_adv_5012003_023",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不可以……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "啊，",
    "voice": "vo_adv_5012003_024",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "真不錯。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "你那副表情。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n一副要抵抗恐懼感的樣子，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "束手無策被吞噬的樣子，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "真棒的表情……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n我已經開始期待了呢……",
    "voice": null,
    "unit_id": 11111
  },
