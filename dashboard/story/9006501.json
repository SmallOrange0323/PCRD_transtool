[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與夥伴們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了阻止「終炎巨神」而入侵其體內。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": "vo_adv_9006501_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n索爾魔珠的所在地點呢！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之，",
    "voice": "vo_adv_9006501_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我鎖定了四個地方！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過小心點，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "附近都有擁有驚人魔力的守護者！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那恐怕是",
    "voice": "vo_adv_9006501_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "彌勒再生出的魔物們吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然會很不容易……",
    "voice": "vo_adv_9006501_003",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但我們必須解決那些傢伙",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n回收索爾魔珠才行……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "打倒BOSS，",
    "voice": "vo_adv_9006501_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "收集索爾魔珠……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呵呵。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊哈哈哈。",
    "voice": "vo_adv_9006501_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n感覺真懷念呢，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是啊。",
    "voice": "vo_adv_9006501_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n雖然是在這種時候……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但感覺這就是",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "《阿斯特朗傳奇》呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──真是的，",
    "voice": "vo_adv_9006501_007",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "受不了。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n都這種時候了還帶著玩樂的心態。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "彌勒……！",
    "voice": "vo_adv_9006501_008",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他透過魔法將幻影送過來的嗎……！",
    "voice": "vo_adv_9006501_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "日安。",
    "voice": "vo_adv_9006501_010",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "不對──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "就我來說，",
    "voice": "vo_adv_9006501_011",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我可不記得有邀請過你們。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "真是的……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n你們若能直接被燃燒殆盡，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "就能省去麻煩了。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這是我們要說的才對，",
    "voice": "vo_adv_9006501_012",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們可不記得",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n有允許你燒毀世界！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是啊！",
    "voice": "vo_adv_9006501_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這次絕對要狠狠教訓你！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n給我覺悟吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "哦哦，",
    "voice": "vo_adv_9006501_014",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "野貓們的威嚇",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n真可怕。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "但是──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我早已掌握了你們送進",
    "voice": "vo_adv_9006501_015",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "巨神內部的戰力。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n的確你們人數看起來是不少……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n但與在外頭奮鬥的七冠們相比，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "簡直是微不足道。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "因此，",
    "voice": "vo_adv_9006501_016",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我就斷言吧。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "你們無法奪回任何一顆索爾魔珠，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n而且會遭到強化再生的魔物打倒。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種事，",
    "voice": "vo_adv_9006501_017",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不試試看還不知道結果！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！",
    "voice": "vo_adv_9006501_018",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我們的羈絆是",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "絕對不會輸的！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "呵呵……",
    "voice": "vo_adv_9006501_019",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "好啊。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n我就坐在特等席上，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "慢慢欣賞你們的靈魂",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n閃耀的樣子，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "以及被粉碎消逝的時刻吧。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼！",
    "voice": "vo_adv_9006501_020",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你等著瞧吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": "vo_adv_9006501_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了奪回索爾魔珠，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看樣子",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然需要打倒",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在巨神內部中的魔物守護者。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "目前已知所在之處的",
    "voice": "vo_adv_9006501_022",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只有四隻。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想還會出現其他的魔物，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要做好長期戰的心理準備！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們要從哪裡開始挑戰，",
    "voice": "vo_adv_9006501_023",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這交由你判斷。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "如果遇到實在無法打倒的敵人，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "先去對付其他敵人也是個辦法。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好～！",
    "voice": "vo_adv_9006501_024",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們絕對要奪回索爾魔珠，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "並且解決掉彌勒！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "以及……",
    "voice": "vo_adv_9006501_025",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "阻止厄莉絲吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生！",
    "voice": null,
    "unit_id": 100211
  }
]
