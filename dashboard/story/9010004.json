[
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在吉歐‧尼布爾黑爾中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n薇歐莉特與格蕾斯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "還有管家杜蘭，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了７周年紀念日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在計劃要送賀禮到蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "該送騎士先生他們",
    "voice": "vo_adv_9010004_000",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "什麼樣的禮物才好呢。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "因為現在沒辦法去參加慶祝的宴會，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "至少",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "想要挑個能讓他們高興的賀禮……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒辦法，",
    "voice": "vo_adv_9010004_001",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我們就待在吉歐‧尼布爾黑爾陰暗地慶祝吧。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "其實妳很期待",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "烤玉米嗎？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "公主。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒、",
    "voice": "vo_adv_9010004_002",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒有。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "才不是那樣……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯真是的，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "站著大口吃東西那種事，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我已經不會再做了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……",
    "voice": "vo_adv_9010004_003",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "以前去吉歐‧格黑納時發生了什麼，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "我之後再慢慢聽……",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n吉歐‧尼布爾黑爾現在",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "正處於騷亂中。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n雖然十分可惜，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "但這次的宴會只能缺席了。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "如果我們突然到訪蘭德索爾，",
    "voice": "vo_adv_9010004_004",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "可能也會",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n讓大家嚇一跳。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "妳想想，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就像移動式鬼屋一樣，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "應該會一片混亂吧？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……哎呀？",
    "voice": "vo_adv_9010004_005",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n反倒是個好機會嗎。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "來去嚇破吧。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "把蘭德索爾所有人的膽子",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "全～都嚇破。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "請妳別一個人自得其樂了。",
    "voice": "vo_adv_9010004_006",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……雖然想著",
    "voice": "vo_adv_9010004_007",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "至少要送上賀禮。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n但要送什麼才好呢……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "能讓騎士大人",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "和大家都開心的東西……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n實在是想不到。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "果然還是",
    "voice": "vo_adv_9010004_008",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "食物嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "畢竟貪吃佩可公主很愛吃。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "話雖這麼說，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "異世界的各位會喜歡的食物，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n吉歐‧尼布爾黑爾好像也沒有……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這時候，",
    "voice": "vo_adv_9010004_009",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就要用我們的特色決勝負呢。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "剛才我有抓一些過來，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "像這個，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還有這個跟這個。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "之前在吉歐‧格黑納給大家看的時候，",
    "voice": "vo_adv_9010004_010",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n被說是有眼睛",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "又很黏稠",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "怎麼看都不像食物，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n從各位那邊收到了很多好評。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀……",
    "voice": "vo_adv_9010004_011",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "原來發生過這種事嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "惡作劇可不能做過頭喔？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是的，",
    "voice": "vo_adv_9010004_012",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我知道。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不過那時候，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n只是要獻給前輩貢品而已。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "雖然前輩想要的是布丁就是了。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "黏稠的某種東西",
    "words": "●％◇★＠△！　●％◇★＠△！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這可不是……",
    "voice": "vo_adv_9010004_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "布丁呢……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "只是誤差罷了，",
    "voice": "vo_adv_9010004_014",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "誤差。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n因為都是果凍狀的。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "趁新鮮趕快做成料理吧，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還是生的會讓他們更高興呢？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "希望",
    "voice": "vo_adv_9010004_015",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "他們不要被嚇到。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……不，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "畢竟是在廣闊的世界冒險的各位。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這些擔憂",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "應該是杞人憂天吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嗯，",
    "voice": "vo_adv_9010004_016",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n貪吃佩可公主的話",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "一定會吃得津津有味的。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "被",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嚇一大跳……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "開心的表情彷彿在眼前浮現呢。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……妳果然",
    "voice": "vo_adv_9010004_017",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n只是想嚇他們吧……？",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，吉歐‧尼布爾黑爾",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n送出了新鮮又神秘的幸福贈禮。",
    "voice": null,
    "unit_id": null
  }
]
