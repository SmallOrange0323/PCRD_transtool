  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2213006_000",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "芙蕾雅──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在術士裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被稱為「菲絲雷斯」的少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她為了治療與貪吃佩可戰鬥時所受的傷而在沉睡時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n夢見了半年前發生的事情。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510410"
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "……緊急代碼確認。",
    "voice": "vo_adv_2213006_001",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "是使用祕密線路",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "進行的插播通話，",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "八斗神局長。",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "嗯。",
    "voice": "vo_adv_2213006_002",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "還是用備用末端裝置。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "是誰打過來的？",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "……",
    "voice": "vo_adv_2213006_003",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "\\n這個ID是……",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "……是阿澤爾德高級搜查官",
    "voice": "vo_adv_2213006_004",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "打來的。",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "\\n他應該從三天前，",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "就處於失聯狀態……",
    "voice": null,
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……接起來。",
    "voice": "vo_adv_2213006_005",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「啊──",
    "voice": "vo_adv_2213006_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "啊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "日安，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "八斗神局長。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「還有",
    "voice": "vo_adv_2213006_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "貞奈特小姐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n看來妳別來無恙，真是太好了。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……阿澤爾德。",
    "voice": "vo_adv_2213006_008",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n你的缺勤申請，",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "提出時間有點晚啊？",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「非常抱歉。",
    "voice": "vo_adv_2213006_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "稍微花了一點時間準備。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "……準備？",
    "voice": "vo_adv_2213006_010",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「是的──」",
    "voice": "vo_adv_2213006_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「『潛入』的事前準備、",
    "voice": "vo_adv_2213006_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n寫好辭呈，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n再來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "就是下定決心……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "以上。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "…………",
    "voice": "vo_adv_2213006_013",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……都說為人母後，",
    "voice": "vo_adv_2213006_014",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "女生就會改變。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "男性也不例外呢。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「這是理所當然的。",
    "voice": "vo_adv_2213006_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n尤其是我家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "幾乎算是父女單親家庭。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「而且……」",
    "voice": "vo_adv_2213006_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「以正義、",
    "voice": "vo_adv_2213006_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "以工作為由。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n我太常",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "把那孩子一個人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "留在家中了。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「如果因為這樣……",
    "voice": "vo_adv_2213006_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n導致那孩子變成了『走失兒童』，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "回不了家的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n不管要放下什麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我都必須去把她接回來。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「不然，",
    "voice": "vo_adv_2213006_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n我就再也不能",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "稱自己是那孩子的父親了吧。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……",
    "voice": "vo_adv_2213006_020",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n像你這麼好的人才，",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "可不多見啊。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "菲絲雷斯",
    "words": "局長……",
    "voice": "vo_adv_2213006_021",
    "unit_id": 193731
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「哈哈。",
    "voice": "vo_adv_2213006_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n很抱歉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我違反契約辭職。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n不需要給我退休金喔。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "嗯，",
    "voice": "vo_adv_2213006_023",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "畢竟是規則。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……對了──",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "既然這樣，",
    "voice": "vo_adv_2213006_024",
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "乾脆就從內部來終結「禁錮」吧。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "如果你能順便",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "掌握超AI",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "和系統的話，",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "我會用高價買下來。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n救出女兒後，",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "你也不想讓她過貧困的生活吧。",
    "voice": null,
    "unit_id": 193631
  },
  {
    "type": "background",
    "bg_id": "502480"
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2213006_025",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……結果。",
    "voice": "vo_adv_2213006_026",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n阿澤爾德高級搜查官",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "也消失了──",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "還是在他一直尋找的女兒面前。",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……就算是這樣……",
    "voice": "vo_adv_2213006_027",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "阿澤爾德高級搜查官的女兒，",
    "voice": "vo_adv_2213006_028",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n肯定",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "是很幸福的吧……",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n因為有人願意為了救出自己，",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "賭上性命……",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "打擾了。",
    "voice": "vo_adv_2213006_029",
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n……妳是在休息中嗎？",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……黎薩‧費妲。",
    "voice": "vo_adv_2213006_030",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n離約好的時間，",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "還有點早吧？",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "唉呀，",
    "voice": "vo_adv_2213006_031",
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "對不起。",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "因為我稍微提早來了。",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2213006_032",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "算了，",
    "voice": "vo_adv_2213006_033",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不過……",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
