  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了嗎學長，",
    "voice": "vo_adv_4010181_000",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "突然帶我到這種地方。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯……",
    "voice": "vo_adv_4010181_001",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你還記得啊。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對學長來說這點小事是理所當然吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在我的生日帶我來雜貨店",
    "voice": "vo_adv_4010181_002",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "的意思是，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n難道說",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈……",
    "voice": "vo_adv_4010181_003",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過～",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "禮物是要這樣一起挑的東西嗎？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n印象中在漫畫之類的裡面，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像都是事先準備好的",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_4010181_004",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一起挑也許會比較有趣？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔～",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也能這麼想啊。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼",
    "voice": "vo_adv_4010181_005",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你先挑看看。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n挑適合我的。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺",
    "voice": "vo_adv_4010181_006",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你是想讓我變可愛？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是不討厭啦，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但我的形象",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "比較像是",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那種……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_4010181_007",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "難道說學長，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你覺得我是可愛類型的？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那還真是……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有點",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "高興？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": "vo_adv_4010181_008",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "禮物果然還是讓我選吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這之後要逛很多店家，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你都要陪我喔！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n因為……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺這樣",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "能讓生日更加愉快。",
    "voice": null,
    "unit_id": 106531
  }
]
