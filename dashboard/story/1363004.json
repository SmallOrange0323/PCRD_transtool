  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "要搭好搭滿，",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "把票價玩回本才划得來啊。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "呵呵，",
    "voice": "vo_adv_1363004_007",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "好～險啊～",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "似乎沒有引起騷動呢★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "是啊，",
    "voice": "vo_adv_1363004_008",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我想應該",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "已經被感應器偵測到位置了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "再過不久，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不識趣的黑衣人們，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n就會飛奔過來了吧。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "但～",
    "voice": "vo_adv_1363004_009",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "是～",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "今天可是聖誕節喔？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不想跟我來個遊樂園約會嗎？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "聽好了，騎士同學。",
    "voice": "vo_adv_1363004_010",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n體驗當個普通女孩，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "就是我的「反擊」。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n有什麼關係嘛，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "就聖誕節這一天。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "難得來到遊樂園，",
