  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "奇、",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "好像，突然有人出現……？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "\\n從空無一物的地方現身……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "嗯？",
    "voice": "vo_adv_1363004_006",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "人這麼多，",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "應該是妳看錯吧。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "不說這個了，走吧。",
