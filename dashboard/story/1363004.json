  {
    "type": "dialogue",
    "name": "遊樂園工作人員",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊樂園工作人員",
    "words": "得好好照順序才可以……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "趁現在！",
    "voice": "vo_adv_1363004_024",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n進到這裡面……！",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "still",
    "still_id": "136300401"
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "呼……",
    "voice": "vo_adv_1363004_025",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "真是好險呢。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n差一點，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "就要遊戲結束了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "騎士同學，",
    "voice": "vo_adv_1363004_026",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "現在就來欣賞風景吧。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "難得還剩下一圈的時間。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我不是說過了嗎。",
    "voice": "vo_adv_1363004_027",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n我今天要體驗",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "當個普通女孩。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……不管怎麼說還是太勉強了嗎？",
    "voice": "vo_adv_1363004_028",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我自己也明白",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "這樣很亂來。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "…………但是，",
    "voice": "vo_adv_1363004_029",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "對不起。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n其實，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "在這之後",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "才是真正的反擊。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我待會，",
    "voice": "vo_adv_1363004_030",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "會被他們抓起來，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "帶到據點去，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n然後我就會宰掉他們所有人，結束這一切……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "嗯，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "反過來被打倒的可能性",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "也很高就是了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "所以說，",
    "voice": "vo_adv_1363004_031",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我現在想好好享受",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "剩下的兩人時光。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n拜託你了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "…………",
    "voice": "vo_adv_1363004_032",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……氣氛實在是糟透了呢。",
    "voice": "vo_adv_1363004_033",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "這也難怪。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "勉強表現得很快樂，",
    "voice": "vo_adv_1363004_034",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "也讓人看不下去吧？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n或許就靜靜地眺望夜景，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "也不錯呢。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……啊，",
    "voice": "vo_adv_1363004_035",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "就是那附近吧，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我們相遇的地方。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "夜景，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "很美呢。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "………………",
    "voice": "vo_adv_1363004_036",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "…………雖然我，",
    "voice": "vo_adv_1363004_037",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "經歷了很多難受的事情，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "跟騎士同學的聖誕節約會",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我玩得很開心──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "應該說整趟逃亡之旅，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "都很開心……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "多虧了騎士同學，",
    "voice": "vo_adv_1363004_038",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我才能體驗當個普通女孩，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "並且懂得愛人。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "這樣我就心滿意足了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……可是。",
    "voice": "vo_adv_1363004_039",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n我是傷害了許多人的壞孩子。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "所以，如果有什麼好事是我能辦到的，",
    "voice": "vo_adv_1363004_040",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n那就是，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "終結一切，跟大家永別……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……能在最後，",
    "voice": "vo_adv_1363004_041",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "把我的心意告訴你，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n真是太好了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "still",
    "still_id": "136300402"
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……是啊。",
    "voice": "vo_adv_1363004_042",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不行的其實是我。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "在這個世界，",
    "voice": "vo_adv_1363004_043",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "已經沒有我的容身之處了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n……這種感覺，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "你應該不懂吧。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "對不起，我這樣恣意妄為。",
    "voice": "vo_adv_1363004_044",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "對不起，總是這麼任性。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我最喜歡你了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……請好好保重喔──",
    "voice": "vo_adv_1363004_045",
    "unit_id": 118231
  },
  {
    "type": "still",
    "still_id": "136300404"
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "喂、",
    "voice": "vo_adv_1363004_046",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "喂！",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "\\n突然",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "男朋友",
    "words": "有女孩子……！？",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "是、",
    "voice": "vo_adv_1363004_047",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "是剛才看到的女孩子。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "但是，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "那些人",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "抓住了那孩子……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "background",
    "bg_id": "510322"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "黑衣部下",
    "words": "費了我們這麼多工夫。",
    "voice": "vo_adv_1363004_048",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣部下",
    "words": "\\n",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣部下",
    "words": "組長，",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣部下",
    "words": "跟她一起逃亡的小鬼要怎麼辦？",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "我不想再更引人注目了，",
    "voice": "vo_adv_1363004_049",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "隨他去吧。",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "不過就是一個小鬼，",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "什麼事也做不了吧。",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "把Ｍ３號帶回去據點。",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "再見……",
    "voice": "vo_adv_1363004_050",
    "unit_id": 118231
  },
