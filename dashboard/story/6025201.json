  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我要去分發點心給小孩子，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那你要做什麼呢？",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "和我一樣呢。",
    "voice": "vo_adv_6025201_001",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n都是大人了，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以得分發點心才行呢。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們一起去發吧。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要去惡作劇嗎？",
    "voice": "vo_adv_6025201_002",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請別說這種像禊一樣的話。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好了，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們一起去發點心啦。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "遊行？",
    "voice": "vo_adv_6025201_003",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我很期待美美扮裝去遊行。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n大家一起去遊行也很不錯呢。",
    "voice": null,
    "unit_id": 111111
  }
