[
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "祕、",
    "voice": "vo_adv_5122323_000",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "祕密魔物又開始掉下來了！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n而且這次……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還同時在大聲地暴露祕密耶～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "好──",
    "voice": "vo_adv_5122323_001",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "既然如此！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n我就大聲暴露自己的祕密，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n讓那些傢伙的聲音",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "無法被聽見！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "咳咳。",
    "voice": "vo_adv_5122323_002",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "我就老實說吧，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這個粗獷系的",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "銀飾品……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "是靠祕密廢棄服務賺來的",
    "voice": "vo_adv_5122323_003",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "分配金買的啦──！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "…………",
    "voice": "vo_adv_5122323_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……秋乃，",
    "voice": "vo_adv_5122323_005",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n麻煩妳將多到堵塞的吐槽點整理一下。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "第一，",
    "voice": "vo_adv_5122323_006",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "事到如今那種事根本就不是祕密。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "第二，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說起來只要大聲就好，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n內容根本不需要是祕密。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就是說，",
    "voice": "vo_adv_5122323_007",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "雖然吐槽點很多，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過就結果上沒有問題。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你繼續吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "──好呀！",
    "voice": "vo_adv_5122323_008",
    "unit_id": 6411
  }
]
