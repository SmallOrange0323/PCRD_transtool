  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "先冷靜下來吧。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦，",
    "voice": "vo_adv_1351001_006",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我這是",
