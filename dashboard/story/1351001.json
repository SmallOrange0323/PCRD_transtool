  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說說的啦……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我怎麼可能有辦法那麼直接地問出口呢！",
