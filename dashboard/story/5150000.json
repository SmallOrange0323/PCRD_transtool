  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我們都不需要啊……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這只是我的猜測，",
    "voice": "vo_adv_5150000_062",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但應該是",
