  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不是會造成居民的混亂嗎！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這麼做也會影響到自然環境啊！",
