  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なあオマエ、",
    "voice": "vo_adv_6056402_000",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ネネカ見なかったか？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アイツってコロコロ変身して、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "すぐ勝手にどっか行くんだよな。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nなんか今回も小難しいこと考えてるみたいだし。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "あんなちっこい見た目してるのにな。",
    "voice": "vo_adv_6056402_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシも最初は驚いたぞ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "変身できるんだし",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "自分の身長でも伸ばせばいいのに……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ってうおおお！？　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ネネカ、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いつからそこにいたんだ！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……いや、",
    "voice": "vo_adv_6056402_002",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "さすがに今回はないだろ。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ない……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ないはず……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ないよな？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でも",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ネネカならありえそうだな、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "うん……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オマエも気をつけろよな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nいつどこで何してるか、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "分かんないヤツだからな、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ネネカは！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "まあそうだな。",
    "voice": "vo_adv_6056402_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いつもなに考えてるのか全然分からないけど、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "仲間にいれば頼りになるのは確かだな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n今回は味方で助かったよ……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "前は色々大変だったんだぞ！？",
    "voice": null,
    "unit_id": 106113
  }
]
