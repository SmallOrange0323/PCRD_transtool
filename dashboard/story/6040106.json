    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為了要能夠報恩，",
    "voice": "vo_adv_6040106_001",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "首先我們得好好振作呢。",
