    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "的確比起勉強做些什麼，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣可能還比較好吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n去各式各樣的地方兜售，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "跟各種各樣的人說話，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要是",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "想到了什麼感覺能夠辦到的事情，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就去做的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "報恩之旅嗎！",
    "voice": "vo_adv_6040106_003",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "　這樣子確實不錯的啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n把印有伊麗莎白牧場標記的商品",
    "voice": null,
    "unit_id": 112811
  },
