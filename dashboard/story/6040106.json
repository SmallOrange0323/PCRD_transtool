    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "得讓來溫泉的人們看見",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牛群悠閒生活著的",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "和平牧場才行呢。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的嗎？",
