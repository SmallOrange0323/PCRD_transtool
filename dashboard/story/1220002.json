[
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在幽靈船委託的幾天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}受到忍的邀請，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依約造訪了海邊的一間店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "前陣子謝謝你。",
    "voice": "vo_adv_1220002_000",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "多虧了{0}，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們才能平安回到蘭德索爾。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天",
    "voice": "vo_adv_1220002_001",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就讓我請你吃飯作為答謝吧。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n聽說這家店的餐點",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "似乎很好吃哦。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "料理店的老闆娘",
    "words": "嗨，",
    "voice": "vo_adv_1220002_002",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "料理店的老闆娘",
    "words": "歡迎光臨！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "料理店的老闆娘",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "料理店的老闆娘",
    "words": "空出來的位子",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "料理店的老闆娘",
    "words": "都可以自由入座哦。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝。",
    "voice": "vo_adv_1220002_003",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼就",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "挑那邊視野不錯的位子吧。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺吹著海風會很舒服──",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "喂，",
    "voice": "vo_adv_1220002_004",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "那邊那個女人！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "站住！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "到底有什麼事……？",
    "voice": "vo_adv_1220002_005",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n這傢伙態度還真是囂張啊。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "嗯……",
    "voice": "vo_adv_1220002_006",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n跟受害者描述的特徵",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "一致呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1220002_007",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請問有什麼事嗎？",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "不好意思，",
    "voice": "vo_adv_1220002_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "想問妳一點事情。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n我們目前",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "正在調查某起事件。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "最近，",
    "voice": "vo_adv_1220002_009",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "有些受害者尋求我們協助，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n說在蘭德索爾這一帶，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n有人硬是賣給他們高價的壺和護身符……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "依據",
    "voice": "vo_adv_1220002_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "受害者提供的情報，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n犯人是穿著白衣服的女人，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "自稱為占卜師的樣子。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "白衣服……",
    "voice": "vo_adv_1220002_011",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也正好穿著白衣服呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "還有，",
    "voice": "vo_adv_1220002_012",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "她會用奇怪的水晶占卜，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n然後說受害者是「被惡靈附身了」、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "「被前世的孽緣纏上了」等等，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n用話術哄騙，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "讓對方買下商品。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什麼？",
    "voice": "vo_adv_1220002_013",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "奇怪的水晶……",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "難道是說我？",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "看到我這樣的俊男不可能會說出那種話吧。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "綜合上述的情報來看，",
    "voice": "vo_adv_1220002_014",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n眼前的女孩和目擊證言實在是如出一轍。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……等一下，",
    "voice": "vo_adv_1220002_015",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "從剛才的說詞來看，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你該不會",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "是在懷疑忍吧？",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我家寶貝女兒哪可能跑去騙人呢！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸……",
    "voice": "vo_adv_1220002_016",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就算找遍蘭德索爾，",
    "voice": "vo_adv_1220002_017",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n也很難找到像忍這麼可愛又純真的孩子啊。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你這臭傢伙，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "聽懂的話就快給我滾！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "還有這是最後的情報……",
    "voice": "vo_adv_1220002_018",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n受害者們似乎",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "都一下子就被犯人的美貌給騙上鉤了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n聽說是在蘭德索爾",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "也很少見的超級大美人。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那肯定是我家寶貝女兒不會錯！",
    "voice": "vo_adv_1220002_019",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n首先是難得一見的大美女這點絕對不會錯。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n想不到你們還蠻有看人的眼光呢！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哇哈哈！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸……",
    "voice": "vo_adv_1220002_020",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "好，",
    "voice": "vo_adv_1220002_021",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "已確認嫌犯的自白了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "啊，",
    "voice": "vo_adv_1220002_022",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "糟了！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我剛才說的不是那個意思……！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "不好意思，請麻煩跟我們到局裡一趟。",
    "voice": "vo_adv_1220002_023",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n拒絕的話，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "我們就不得不動用武力了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔唔唔唔……",
    "voice": "vo_adv_1220002_024",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我說你，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "快想個辦法！！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "……有什麼事嗎，",
    "voice": "vo_adv_1220002_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "少年？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n一直盯著我瞧，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "是我的頭盔上有些什麼嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "幽靈……？",
    "voice": "vo_adv_1220002_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "你在說什麼？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n之前，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "在幽靈船見到……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "無頭騎士？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "不好意思，",
    "voice": "vo_adv_1220002_027",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "我沒時間聽你開玩笑……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n……不，等等。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "你剛才",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "說了什麼？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "解決幽靈船事件的人原來是你們啊。",
    "voice": "vo_adv_1220002_028",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n稍早我們打聽到的情報也確認了你們有不在場證明，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n不好意思懷疑了你們。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "假如有任何跟事件相關的情報還請聯絡我們，",
    "voice": "vo_adv_1220002_029",
