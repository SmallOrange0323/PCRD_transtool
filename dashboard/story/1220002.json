    "name": "神秘女性",
    "words": "自己還有一點事情……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "神秘女性",
    "words": "\\n先告辭了！",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那個的占卜師就是事件的犯人嗎！",
    "voice": "vo_adv_1220002_053",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "要被她給逃了！！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": "vo_adv_1220002_054",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們快走吧。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "必須早點阻止她才行……！",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "剛才靠近她，",
    "voice": "vo_adv_1220002_055",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓我弄清楚了。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那顆水晶是幽靈船上的寶物……",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n是拴住幽靈海盜們的一部分詛咒。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓受害者遭逢不幸和受傷也是……",
    "voice": "vo_adv_1220002_056",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n全都是用那顆水晶之力引起的。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "她做的",
    "voice": "vo_adv_1220002_057",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "並不是替人占卜，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n而是下了害他人不幸的",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "詛咒。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一開始假裝占卜，",
    "voice": "vo_adv_1220002_058",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對客人下詛咒，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只要客人不買高價的商品",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就不解開詛咒的話……",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就會如預言所說的一樣遭逢不幸。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也就是說，",
    "voice": "vo_adv_1220002_059",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "她所言惡靈帶來的災害或不幸，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只是靠詛咒捏造出來的……",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "自導自演。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但是……",
    "voice": "vo_adv_1220002_060",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "任何詛咒都伴隨著反蝕之力。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "越是強大的詛咒，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就越會要求付出使用的代價……",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們必須在更多人受害之前……",
    "voice": "vo_adv_1220002_061",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n快點",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "解開詛咒才行。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "水晶占卜師",
    "words": "只要有這股力量，",
    "voice": "vo_adv_1220002_062",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "水晶占卜師",
    "words": "我就能變得更有名……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "水晶占卜師",
    "words": "\\n誰也別想得到……",
