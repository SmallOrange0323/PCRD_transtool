    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n竟然讓施術者失控，將生命力轉為魔力。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n這樣下去，",
