    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "水晶占卜師",
    "words": "是怎樣啦……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "水晶占卜師",
    "words": "\\n不要妨礙我！",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
