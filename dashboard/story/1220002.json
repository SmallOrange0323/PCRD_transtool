    "type": "dialogue",
    "name": "忍",
    "words": "喝啊啊啊！！",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "忍",
