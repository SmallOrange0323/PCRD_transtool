[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在福運會的喧囂散去後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n神社內僅剩舒適的寂靜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "璃乃等人則在神社境內的長椅上休息片刻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呼……",
    "voice": "vo_adv_1379004_000",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天一整天",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都在全力奔跑……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "腳已經",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都快變成木頭了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿……",
    "voice": "vo_adv_1379004_001",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為哥哥在我身邊，我很努力喔。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能和哥哥一起來，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我還是",
    "voice": "vo_adv_1379004_002",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一直都在依賴你",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呢。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "謝謝你，",
    "voice": "vo_adv_1379004_003",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "光是剛剛的那句話，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "到剛才為止的疲累",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都一下子",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就消失了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……回頭一看，",
    "voice": "vo_adv_1379004_004",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天真的過得很充實。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n福運會的",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "許多課題，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "跟姐姐的對決……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而且",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "最終審查，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我心臟還在撲通直跳呢。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天的事情……",
    "voice": "vo_adv_1379004_005",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我絕對不會忘記。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n因為今天對我來說，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已成為特別的一天。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯……？",
    "voice": "vo_adv_1379004_006",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "本殿那邊有光……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感覺……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好刺眼啊……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哇……",
    "voice": "vo_adv_1379004_007",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好多人……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n氣氛跟平常的神社",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好像完全不同。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n有這麼多人在等待",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "跨年的瞬間啊。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "still",
    "still_id": "137900401"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那、",
    "voice": "vo_adv_1379004_008",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會不會很難走？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我的和服、",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會不會……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很礙事？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我、",
    "voice": "vo_adv_1379004_009",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然因為穿不習慣，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有點辛苦，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但今天也好好確認過鞋帶了。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比起這個，",
    "voice": "vo_adv_1379004_010",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為跟哥哥一起穿和服出門，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我好像有些緊張。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是，",
    "voice": "vo_adv_1379004_011",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天來真是太好了。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這次的寒假一～直在念書，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好像都快喘不過氣了……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥",
    "voice": "vo_adv_1379004_012",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已經決定好要祈求什麼了嗎？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我的話……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "祈求合格",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當然是不可或缺的。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是啊，",
    "voice": "vo_adv_1379004_013",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我有跟哥哥說過吧，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我的志願學校……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就是",
    "voice": "vo_adv_1379004_014",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "跟哥哥一樣的，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "椿丘高中。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": "vo_adv_1379004_015",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n準備考哪間高中、",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗎？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我沒說過嗎？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯。",
    "voice": "vo_adv_1379004_016",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我想和哥哥",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讀同一所高中。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘖～",
    "voice": "vo_adv_1379004_017",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n明明我是打算考上後再告訴哥哥，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓哥哥嚇一跳的。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "以我的學力偏差值來說，",
    "voice": "vo_adv_1379004_018",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n合格機率是一半一半……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以我沒什麼",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "自信能考上。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是，",
    "voice": "vo_adv_1379004_019",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n如果我考上的話，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n哥哥要給我獎勵的",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「魔法」喔。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們約好了喔，",
    "voice": "vo_adv_1379004_020",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1379004_021",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "非常努力用功喔☆",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "still",
    "still_id": "137900401"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我無論如何都想跟哥哥念同一所學校，",
    "voice": "vo_adv_1379004_022",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n自那之後",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就一直拼命努力。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在學習遇到瓶頸時，",
    "voice": "vo_adv_1379004_023",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n哥哥在旁邊教我……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真的讓我很安心。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "之前我也為了模擬考的成績沮喪，",
    "voice": "vo_adv_1379004_024",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n差點哭出來過……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是因為哥哥的鼓勵，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我才終於",
