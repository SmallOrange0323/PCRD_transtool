[
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～欸～",
    "voice": "vo_adv_5126301_000",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "傳說中的魔物……",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "記得是叫阿爾杰什寶？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣一看",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像氣炸了欸……？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n牠是那個嗎，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有起床氣的類型～？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都已經睡了800年，",
    "voice": "vo_adv_5126301_001",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就繼續睡下去啦！！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼要在這個時間點醒來……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是因為我敲響了鐘呀……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……真、",
    "voice": "vo_adv_5126301_002",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是沒辦法呢！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n看來我好像",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也稍微有一點責任，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就來盡一下",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的義務吧！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也會幫忙的！",
    "voice": "vo_adv_5126301_003",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "阿爾杰什寶，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然很抱歉，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但要請你再回去睡覺覺囉！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，",
    "voice": "vo_adv_5126301_004",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們上吧！！",
    "voice": null,
    "unit_id": 127211
  }
]
