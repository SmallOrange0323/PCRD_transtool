[
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "特別講座の事前説明会──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nアキノたちの口から詳細が告げられたあと、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n聖テレサ女学院の生徒たちはしばらく騒然としていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": "vo_adv_5038600_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なるほどな……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "優れたアイデアがあれば、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "財団が経済力をもって其れを実現させる。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n此度の講座はそういう主旨か。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "実績も信用もない起業家は、",
    "voice": "vo_adv_5038600_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "一般的な投資が受けづらく、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nビジネスエンジェルなどと呼ばれる富裕な個人を探すものと聞くが。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おそらく彼女らこそ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々にとってのエンジェルに相違ない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "エンジェリック・ドラゴンスレイヤー……",
    "voice": "vo_adv_5038600_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n竜殺しの天使…………",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ふーん、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "いいじゃん。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "やー、",
    "voice": "vo_adv_5038600_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "マザーのスクハラでしぶしぶ参加する講座でしたけど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "まさかワンチャンセレブ入りのご案内だったとは驚きですね。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n棚から牡丹餅どころか、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ガチョウが金の牡丹餅を産むレベルですよ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ソレもう牡丹餅じゃなくてよくない。",
    "voice": "vo_adv_5038600_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そこはどーでもいいんです！　",
    "voice": "vo_adv_5038600_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "学校のこういうイベント授業って、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nフツー長々とつまんない話聞かされたり、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "長々とつまんないレポート書かされたりするじゃないですか！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あーね。",
    "voice": "vo_adv_5038600_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ま、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "その点、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "今回は本番にバシッと一発",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n結果だけ出しゃーいンだから本当アドいわ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あ、",
    "voice": "vo_adv_5038600_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そっか……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "結果だけでいいのか……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "え、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "え、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そしたらもう、あるじゃないですか。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "アレでよくないです？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nあのユニ先輩が飼ってる、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ほら、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "たまに文鎮代わりにされてる──",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ロゼッタか。",
    "voice": "vo_adv_5038600_008",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "言われてみれば",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "即席簡易疑似ゴーレムというのは、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくの引きこもり精神──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もとい",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "独創的な発想によって産まれた",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n狂気の産物──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もとい",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "革新的な技術の結晶だ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "財団の要求に符号する。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "マジか。",
    "voice": "vo_adv_5038600_009",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え、じゃあソレじゃん。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "すでにあンじゃん結果。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nヤバい、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うちら戦わずして勝ったわ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "もうすることないわ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "さて。",
    "voice": "vo_adv_5038600_010",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n特別講座の内容については",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "以上です。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "戸惑っているかもしれませんが、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "行うべきことは",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "とてもシンプルです。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "──チャレンジ、",
    "voice": "vo_adv_5038600_011",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ですわ。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "未来へと突き進む学生として、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n実現したい夢の形を",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私たちにお見せくださいませ。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え、",
    "voice": "vo_adv_5038600_012",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんかアキノ先輩、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "こっち見ながら言ってンだけど。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんで。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "どゆこと。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "パイセン訳して、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "端的に。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": "vo_adv_5038600_013",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "チャレンジ精神……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "結果だけではなく過程……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なるほどな。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nどうやら我々に、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ズルはするなと言っているようだ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本件はビジネスではなく、",
    "voice": "vo_adv_5038600_014",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ビジネスに学ぶ授業。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ビジネスなら成果がすべてだが、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "授業となればさにあらず。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nおそらく財団は、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "クライアントの意向も尊重しているのだろう。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "クライアント？　",
    "voice": "vo_adv_5038600_015",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ああ、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "うちの学校か。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "然り。",
    "voice": "vo_adv_5038600_016",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "学院め、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々四人の行動には注意するよう要請したに違いない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "マザーヒルダはそういうこと言う。",
    "voice": "vo_adv_5038600_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "マザヒルちゃん、",
    "voice": "vo_adv_5038600_018",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "最近うちらの思考完全に読んできますよね。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "あ、それと。",
    "voice": "vo_adv_5038600_019",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "今回の特別講座、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "過程の方も重視したいと思っています。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "発表の際、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "資料をまとめたレポートを提出していただきますわ！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "……と、",
    "voice": "vo_adv_5038600_020",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "クライアントが要請したわけですね？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "えぇー",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふん、",
    "voice": "vo_adv_5038600_021",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "過程をレポートだと？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの思考マップを開示しろと言うのか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "厚かましい、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "当学の教員には知的プライバシーという概念がないのか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "てか、",
    "voice": "vo_adv_5038600_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "シンプルにめんどみ。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "レポートってか、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あの作文的なやつ？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "アレ系全般、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うち苦手なンだよなァ……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "第一そうなってくると、",
    "voice": "vo_adv_5038600_023",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "生徒の拘束時間長すぎません？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ちょっとブラックくないです？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "このご時世ですよ？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "大丈夫ですか？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "同意だがチエル君、",
    "voice": "vo_adv_5038600_024",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "これは労働ではない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "残念ながら、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本邦にまだ学び方改革の波は到来していないのだ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "端的に換言すれば、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "反論の余地はない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "なかよし部",
    "words": "はあ……",
    "voice": "vo_adv_5038600_025",
    "unit_id": null
  }
]
