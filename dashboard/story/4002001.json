  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天，\\n{0}與【美食殿堂】的人，\\n共同在蘭德索爾中散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊嗚～……",
    "voice": "vo_adv_4002001_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n肚子好餓～、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肚子好餓～……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_4002001_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肚子餓～、",
    "voice": "vo_adv_4002001_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好餓～……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我是肚子餓得咕嚕咕嚕叫的",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "貪吃佩可～……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵死了！",
    "voice": "vo_adv_4002001_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要在碎碎念了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我會生氣的喔！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我也是肚子餓到心情不是很好的說？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留就算沒有肚子餓，",
    "voice": "vo_adv_4002001_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不都也是常常生氣的樣子～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "根本就是愛生氣小公主～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰是愛生氣小公主！",
    "voice": "vo_adv_4002001_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不要用奇怪的方式叫我，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳是想說我像公主一樣可愛嗎！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然沒有說公主就一定可愛～……",
    "voice": "vo_adv_4002001_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不要再到處亂叫了，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣肚子反而會更餓喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也是～。",
    "voice": "vo_adv_4002001_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n今天不知道怎麼了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n到處都找不到地方吃飯……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕快隨便找一家店，",
    "voice": "vo_adv_4002001_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去大吃一頓順便消除一下壓力。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": "vo_adv_4002001_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，貪吃佩可，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n{0}跟可蘿仔呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像沒在附近，",
    "voice": "vo_adv_4002001_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n難道說……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟我們走失了嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉呦？",
    "voice": "vo_adv_4002001_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很不妙呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿～！\\n{0}！",
    "voice": "vo_adv_4002001_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你們在哪裡啊，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有聽到的話就回個聲吧～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_4002001_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像從那個方向",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好像傳來{0}的聲音！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "走吧，貪吃佩可，",
    "voice": "vo_adv_4002001_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有種莫名的不祥預感……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "500380"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐～！",
    "voice": "vo_adv_4002001_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n凱留小姐～！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在這裡啊！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_4002001_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "找到了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們這樣不可以喔～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼擅自到處亂走！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們可是很擔心的？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真、",
    "voice": "vo_adv_4002001_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的很對不起。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們也不知道發生了什麼事情……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是普通的走著。",
    "voice": "vo_adv_4002001_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一回過神來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就來到了這個詭異的空間了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～？",
    "voice": "vo_adv_4002001_019",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這個空間",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到底是什麼呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然很廣闊，",
    "voice": "vo_adv_4002001_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，在蘭德索爾有這樣子的建築物嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯～。",
    "voice": "vo_adv_4002001_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n感覺好像不小心進入了異世界一樣……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到底是哪裡呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個地方？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡是『戰鬥競技場』……",
    "voice": "vo_adv_4002001_022",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n受到太陽與星辰",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "祝福的人們，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n穿越時空互相競爭的鬥技場。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！？",
    "voice": "vo_adv_4002001_023",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳是誰！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "抱歉。",
    "voice": "vo_adv_4002001_024",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n禮貌上應該先報上姓名的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "我是米奈β。",
    "voice": "vo_adv_4002001_025",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n是這個『戰鬥競技場』的管理人。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "米、",
    "voice": "vo_adv_4002001_026",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "米奈……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "貝塔小姐？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "是的。",
    "voice": "vo_adv_4002001_027",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n正式說起來，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "有個更長的稱號……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "不過為了方便，還是叫這樣就好。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "不過",
    "voice": "vo_adv_4002001_028",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "不用太過於在意我，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n我只是像個沒有靈魂的人偶。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "只是遵從程式的指令，",
    "voice": "vo_adv_4002001_029",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n默默的執行該做的事情而已。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "話雖如此。",
    "voice": "vo_adv_4002001_030",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "既然你們到達了這個地方，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n代表你們已經具備了資格。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "如果可以的話，",
    "voice": "vo_adv_4002001_031",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n不妨參加這裡舉辦的",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "『鬥技大會』試看看呢？",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鬥、",
    "voice": "vo_adv_4002001_032",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "『鬥技大會』？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是什麼東西，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "舉辦非官方的活動可是違反法律的！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "已經有取得認可了。",
    "voice": "vo_adv_4002001_033",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n妳看，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "這是蓋過國王認可的文件。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給我看看。",
    "voice": "vo_adv_4002001_034",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是真的，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這份公文真的沒有任何問題。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～、",
    "voice": "vo_adv_4002001_035",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是真的呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然同意的是好幾任以前的國王……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n連我都沒見過，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是好久好久以前的祖先。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "什麼？",
    "voice": "vo_adv_4002001_036",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n妳說祖先是……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，沒有，",
    "voice": "vo_adv_4002001_037",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我什麼都沒有說……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總之，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "像『鬥技大會』這個東西，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我覺得沒有必要參加。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像只要有出場，",
    "voice": "vo_adv_4002001_038",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就能夠獲得豪華獎品的樣子。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "獎品的內容似乎沒有在書面上說明，",
    "voice": "vo_adv_4002001_039",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "究竟可以得到什麼呢～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就個人來說",
    "voice": "vo_adv_4002001_040",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比較想要綜合水果籃，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n或是一年份的白米。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "如果那就是您的願望的話，",
    "voice": "vo_adv_4002001_041",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "也可以去準備喔。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "我是達成願望的系統殘渣，",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n將會回應各種願望。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "如果會覺得有點詭異的，",
    "voice": "vo_adv_4002001_042",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "可以想像只是單純的從事工作而已。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "只要付出一定程度的勞力，",
    "voice": "vo_adv_4002001_043",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n就會給予報酬……",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "差不多就這種感覺。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "不過，反正也不是強制參加，",
    "voice": "vo_adv_4002001_044",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "當有想到，再過來參加就夠了。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n絕對不會有所虧損的。",
    "voice": null,
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "『戰鬥競技場』",
    "voice": "vo_adv_4002001_045",
    "unit_id": 191111
  },
  {
    "type": "dialogue",
    "name": "米奈娃β",
    "words": "\\n會一直衷心地等待各位參加的。",
    "voice": null,
    "unit_id": 191111
  }
]
