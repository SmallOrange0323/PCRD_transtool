[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！\\n{0}，終於找到你了！",
    "voice": "vo_adv_1029006_000",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我決定要開演唱會了！\\n然後啊，我把你的入場券也拿來囉。",
    "voice": "vo_adv_1029006_001",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你一定要來喔！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯？你那天有工作啊？",
    "voice": "vo_adv_1029006_002",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是、是喔……真可惜……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但、",
    "voice": "vo_adv_1029006_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是如果有工作也沒辦法嘛！嗯！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你、你不用太在意！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "………………",
    "voice": "vo_adv_1029006_004",
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後，演場會當天――――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "早安。\\n",
    "voice": "vo_adv_1029006_005",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來要去工作了嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也來幫忙……",
    "voice": "vo_adv_1029006_006",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你的工作吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你問我為什麼……\\n",
    "voice": "vo_adv_1029006_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為早點結束就能來聽我的演唱會了吧？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你不用客氣啦。\\n",
    "voice": "vo_adv_1029006_008",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "首先我該做什麼好呢？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "先搬東西……？\\n把這個搬到店裡面就可以了吧。",
    "voice": "vo_adv_1029006_009",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道了！\\n兩個人一起做的話，很快就能完成了！",
    "voice": "vo_adv_1029006_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們趕快把它們搬完吧！",
    "voice": "vo_adv_1029006_011",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿咻！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看你動作太慢了！\\n要快點把工作做完啊！",
    "voice": "vo_adv_1029006_012",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯？是我動作太快了……？",
    "voice": "vo_adv_1029006_013",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～我好歹也是個偶像，平常都在唱唱跳跳的。",
    "voice": "vo_adv_1029006_014",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還蠻有體力的喔？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這種粗活，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過是小事一樁！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接著是打掃啊。\\n",
    "voice": "vo_adv_1029006_015",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "兩個人一起做的話，時間就能縮短一半呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n加油吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "終於完成了！接下來呢？",
    "voice": "vo_adv_1029006_016",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……下一份工作也是打掃啊。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要、要打掃這裡嗎！？",
    "voice": "vo_adv_1029006_017",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "整座城！？就我們兩、兩個！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚嗚～我會加油的！",
    "voice": "vo_adv_1029006_018",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定要讓你來聽我的演唱會！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……那麼，最後是撿垃圾嗎？",
    "voice": "vo_adv_1029006_019",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n將垃圾裝滿袋子後，就可以結束了吧？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……這只能一步一腳印地做了呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是，這個袋子這麼大，好像會花很多時間……",
    "voice": "vo_adv_1029006_020",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我還得去排演、化妝和演唱會的事前討論……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我趕得上演唱會嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣就沒意義了不是嗎。\\n你也得來演唱會才行！",
    "voice": "vo_adv_1029006_021",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那樣不行啦",
    "voice": "vo_adv_1029006_022",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "！\\n你會失去信用的！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓我們好好地完成工作之後，\\n兩個人再一起去演唱會！明白了嗎？",
    "voice": "vo_adv_1029006_023",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……什麼？\\n你說我演唱會遲到會更糟糕……？",
    "voice": "vo_adv_1029006_024",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我可是專業的喔。演唱會絕對不會遲到。",
    "voice": "vo_adv_1029006_025",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我一定會在演唱會開始之前完成給你看！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？你問為什麼我要那麼努力？",
    "voice": "vo_adv_1029006_026",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那是因為……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我無論如何都希望你能來。\\n",
    "voice": "vo_adv_1029006_027",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定要讓你聽見我今天的演唱會！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "終於完成了！",
    "voice": "vo_adv_1029006_028",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接著只要把裝滿垃圾的袋子送過去就結束了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那個任務就交給你處理囉。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我要趕著去演唱會現場！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一直都是你在幫助我不是嗎。\\n該說謝謝的人是我。",
    "voice": "vo_adv_1029006_029",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天能幫你做點事，我很高興喔！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你不要遲到，一定要來喔！\\n",
    "voice": "vo_adv_1029006_030",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定喔！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……好險有趕上。",
    "voice": "vo_adv_1029006_031",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "他也在座位上看著我吧。",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好，上場了！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "still",
    "still_id": "102900601"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家――！\\n",
    "voice": "vo_adv_1029006_032",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感謝你們今天能來我的演唱會――！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "粉絲們",
    "words": "望望～！\\n好可愛啊！！",
    "voice": "vo_adv_1029006_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來我有首新歌想讓你們聽聽。\\n這是",
    "voice": "vo_adv_1029006_034",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的第一首情歌……而且歌詞是我自己作的。",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "――一邊想著你。",
    "voice": "vo_adv_1029006_035",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以演唱會一開始希望能讓大家聽聽這首歌。",
    "voice": "vo_adv_1029006_036",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n「因為想要看見你的笑容」。",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……\\n我非要你來演唱會的理由……是否傳達給你了呢？",
    "voice": "vo_adv_1029006_037",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……呵呵呵。\\n你那麼遲鈍，應該沒有意會到吧。",
    "voice": "vo_adv_1029006_038",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "望一邊這麼想，一邊開心地笑著。",
    "voice": null,
    "unit_id": null
  }
]
