[
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "文化系の学芸展示も、",
    "voice": "vo_adv_5064603_000",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n小論文とか自由研究とか色々ありましたよね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ん？　",
    "voice": "vo_adv_5064603_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうだったな……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あれ、",
    "voice": "vo_adv_5064603_002",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "歯切れわる子ちゃんですね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nユニ博士の日頃の研究成果を提出しなかったこと、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "後悔してるんです？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いや、",
    "voice": "vo_adv_5064603_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それについては考えても詮無きことだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nそも考えようとしたところで、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "不思議なぐらい",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "「ま、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうでもいいや」と気が逸れてしまうからな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくが思案していたのは、",
    "voice": "vo_adv_5064603_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それではなく",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "芸術出展の方だ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ああ、",
    "voice": "vo_adv_5064603_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あの不細工な呪われし異形の像、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "通称ユニアート。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "うむ、",
    "voice": "vo_adv_5064603_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "例の好事家たちは",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『名もなき芸術』などと称していたが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくは今、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "制作者としてあれに『青春』という銘を打ちたい。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "かつて想い焦がれた風景。",
    "voice": "vo_adv_5064603_007",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そして今そこに身を浸している感慨。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n取るに足らん毎日こそが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの年表に燦然と輝くその二文字なのだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "わあ、",
    "voice": "vo_adv_5064603_008",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いいですね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n素晴らしい作品だと思います。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "……な、",
    "voice": "vo_adv_5064603_009",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なんだね急に。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nさんざん不細工だの",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "呪われし異形だのと",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこき下ろしてきた君が、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "急にどうしたというのだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "や、",
    "voice": "vo_adv_5064603_010",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "てっきりアレってツッコミ待ちのネタアートかと思ってたんで。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "真面目に作ってアレだったんなら、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "話はちょっと変わってきますよ？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "もしユニ先輩が全力で一生懸命作った結果がアレだったんなら、",
    "voice": "vo_adv_5064603_011",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nまあ、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "はい、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "仕方ないですもんね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "チエル無理して誉めるぐらいの社交性は持ち合わせてます。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あ、",
    "voice": "vo_adv_5064603_012",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうなんだ……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なんか、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あの、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "無理させちゃってごめんね？",
    "voice": null,
    "unit_id": 116411
  }
]
