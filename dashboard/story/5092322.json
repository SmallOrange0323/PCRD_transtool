[
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔，",
    "voice": "vo_adv_5092322_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "魔物們突然聚集起來。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣下去就沒辦法攻擊守護者了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼，",
    "voice": "vo_adv_5092322_001",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "應該是小弟們在保護老大吧。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真是會耍小聰明。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過",
    "voice": "vo_adv_5092322_002",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "每一隻魔物都很難擊倒，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "攻擊力也不能小看。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "再加上",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼大量的魔物要是湧上來，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n難保會被它們強行壓制。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不愧是占卜師，",
    "voice": "vo_adv_5092322_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是敏銳的觀察力呢，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "忍。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這裡就由我和忍來掩護，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓杏奈能確實的擊倒每一隻魔物，妳覺得如何？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真有意思。",
    "voice": "vo_adv_5092322_004",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不管有多少數量，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "它們都是一群烏合之眾。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "讓它們曉得，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不可能和擁有智慧和羈絆的我們為敵！",
    "voice": null,
    "unit_id": 121911
  }
]
