  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "哇，",
    "voice": "vo_adv_1323001_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "天才！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "竟然選擇第三個選項，真聰明呢♪",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n那，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我就兩個都買了～！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "呵呵，",
    "voice": "vo_adv_1323001_003",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "我還是第一次遇到這樣子購買素材的客人呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "\\n又不是在約會時讓男朋友選適合的衣服。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "討、",
    "voice": "vo_adv_1323001_004",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "討厭啦，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "才不是那樣呢，什麼約會還男朋友的……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n只是因為東西靠我自己拿實在太重了，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "所以叫他來幫忙而已……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "沒關係，",
    "voice": "vo_adv_1323001_005",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "我懂的。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "妳是裝作那樣，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "來找藉口約會對吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "才！！",
    "voice": "vo_adv_1323001_006",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n才不是那樣好嗎！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "再、",
