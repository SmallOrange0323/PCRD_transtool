  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "店長阿姨",
    "words": "都已經幾十年沒有容光煥發了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這跟年紀可沒有關係喔。",
