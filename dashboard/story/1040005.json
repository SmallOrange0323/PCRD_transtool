[
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}！今天也很感謝你，",
    "voice": "vo_adv_1040005_000",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n為了BB團的活動而來到森林裡……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想到了一件事情……！",
    "voice": "vo_adv_1040005_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我認為提高BB團的知名度，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也是我們成員重要的職責之一吧。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只要增加BB團的知名度，",
    "voice": "vo_adv_1040005_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想知道交朋友的方法的人，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n應該就會來到這個森林的！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想交朋友的人聚集在一起，",
    "voice": "vo_adv_1040005_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n大家就能一起思考交朋友的方法，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這樣就肯定能提高效率！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗯嗯，我有一個想法……",
    "voice": "vo_adv_1040005_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那就是創作一首BB團的主題曲，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你覺得這個方法如何呢？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要是一首不自覺地就可以使人琅琅上口、",
    "voice": "vo_adv_1040005_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n馬上就能記住的歌！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦，這是個好主意……？",
    "voice": "vo_adv_1040005_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真、真的嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所、所以今天……",
    "voice": "vo_adv_1040005_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想說如果可以和你",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一起填詞就好了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦，你願意和我一起填詞嗎？",
    "voice": "vo_adv_1040005_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，我們先想想草稿吧……",
    "voice": "vo_adv_1040005_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我打算一邊聽你的意見，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n一邊創作！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後他們兩個人討論了大約三小時，\\n完成了主題曲的歌詞草稿。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "完成了！",
    "voice": "vo_adv_1040005_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我來朗讀一次吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「BB團朋友讚譽曲（暫定）」",
    "voice": "vo_adv_1040005_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果想成為朋友，",
    "voice": "vo_adv_1040005_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n就手牽手吧！啦啦啦～",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們並不可怕啊！",
    "voice": "vo_adv_1040005_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們名叫BB團，嚕嚕嚕～",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……不……",
    "voice": "vo_adv_1040005_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣就好了嗎……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你的反應很委婉呢……",
    "voice": "vo_adv_1040005_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但我跟你的感想一樣……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總覺得，是不是少了點吸引力……",
    "voice": "vo_adv_1040005_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "再輕快一點……",
    "voice": "vo_adv_1040005_017",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像是能夠吸引青少年的那種節奏，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n會不會好一點呢……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "加進一點饒舌試試吧。",
    "voice": "vo_adv_1040005_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n比起歌詞的意思，把焦點放在發音上。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對啊。聽說街上的年輕人，",
    "voice": "vo_adv_1040005_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有種利用即興饒舌來交流的文化。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也想吸引這一類型的人。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有……第一行的歌詞令我有點在意……",
    "voice": "vo_adv_1040005_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是的。我覺得這句……",
    "voice": "vo_adv_1040005_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n好像把朋友形容得太草率了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n加上對「朋友」的定義應該比較好吧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，因為每一個人對朋友的",
    "voice": "vo_adv_1040005_022",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "定義都不相同，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這裡明確地說出朋友的定義會比較體貼聽眾吧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有這裡，第三行的「我們並不可怕啊」。",
    "voice": "vo_adv_1040005_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這裡如果太強調我們不可怕這點，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n是不是可能會引起反效果呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我覺得比起強調我們不可怕，",
    "voice": "vo_adv_1040005_024",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不如強調我們很親切",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "才是正確的表現方式。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼說來，前陣子在家做飯時，",
    "voice": "vo_adv_1040005_025",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n因為蓋著鍋蓋，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以醬汁滾了就整個滿出來呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果那個時候有人願意提醒我的話，",
    "voice": "vo_adv_1040005_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我就會覺得那人很親切。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不如試試將這種含義加到歌詞裡吧！",
    "voice": "vo_adv_1040005_027",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有，乳酸菌之類的東西也對人有益……",
    "voice": "vo_adv_1040005_028",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "然後，為了不要讓歌詞偏重於親切、貼心，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以把閃電等帥氣的單詞也加進去吧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，雙關語也要仔細的寫上解釋！",
    "voice": "vo_adv_1040005_029",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n如果聽眾沒有注意到就太可惜了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "完成了！這樣很完美！",
    "voice": "vo_adv_1040005_030",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我再來朗讀一次吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……咳咳。",
    "voice": "vo_adv_1040005_031",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我要開始囉……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「BB團朋友讚譽曲",
    "voice": "vo_adv_1040005_032",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "←",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "讚譽和參與的發音相近」",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "Hey ",
    "voice": "vo_adv_1040005_033",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "YO！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那裡的小子！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想和你！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n成為朋友唷！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "紅毛雪貂！",
    "voice": "vo_adv_1040005_034",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "新式體操！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n碗豆酥！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "決鬥書！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n學生手冊！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想到對策！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個也是這個也是！",
    "voice": "vo_adv_1040005_035",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n來吧來吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和你一起喲！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我好想！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "認識新朋友喲！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "（※附註，這裡的「朋友」是指，",
    "voice": "vo_adv_1040005_036",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n一星期有超過一次以見面、書信，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n或念力等方式互相聯絡者。）",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "暫且不管這個，",
    "voice": "vo_adv_1040005_037",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "醬汁！醬汁！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n醬汁！醬汁！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你！家裡的！",
    "voice": "vo_adv_1040005_038",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n醬汁滿出來了喔！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "醬汁！醬汁！",
    "voice": "vo_adv_1040005_039",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n滿出來的話！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "醬一支",
    "voice": "vo_adv_1040005_040",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "高電壓閃電棒",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊～ 像那樣子～ 對人有益的～",
    "voice": "vo_adv_1040005_041",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n乳酸菌和BB團～♪",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………",
    "voice": "vo_adv_1040005_042",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "創作出一首不錯的歌呢！",
    "voice": "vo_adv_1040005_043",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這應該是一首用心良苦的佳作！",
    "voice": "vo_adv_1040005_044",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這一切都是因為你的幫忙才能達成。",
    "voice": "vo_adv_1040005_045",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有，這是我和你的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "第一次合作……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我超開心的。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘿嘿嘿……好開心喔……",
    "voice": "vo_adv_1040005_046",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n歌詞真不錯……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總之現在就只缺曲子了！",
    "voice": "vo_adv_1040005_047",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "拜託你了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦……？",
    "voice": "vo_adv_1040005_048",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": "vo_adv_1040005_049",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、我以為只要有歌詞的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n後續就會萬事OK了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你問我有沒有認識的人會作曲……",
    "voice": "vo_adv_1040005_050",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n認識什麼的……門路什麼的……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n想要依靠別人，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "果然還是需要朋友啊……",
    "voice": null,
    "unit_id": 104011
