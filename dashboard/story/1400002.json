[
  {
    "type": "background",
    "bg_id": "501070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，{0}被叫到克蕾琪塔的勤務室。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "少年，",
    "voice": "vo_adv_1400002_000",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "成為我的戀人吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵，",
    "voice": "vo_adv_1400002_001",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這青澀的反應很不錯。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n當然會感到錯愕了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n畢竟可是被極致奢華職場女強人說了甜言蜜語。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但是很遺憾，",
    "voice": "vo_adv_1400002_002",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "當然不是認真的。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不好意思囉？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "答應的太快了吧！！",
    "voice": "vo_adv_1400002_003",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "再更錯愕一點啊，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你可是被極致奢華職場女強人說了甜言蜜語喔。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……咦，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你說反正不是認真的？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哼，",
    "voice": "vo_adv_1400002_004",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "都被看穿了嗎，真無聊。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是的，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "當然不是認真的。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這個「R＆A度假村」",
    "voice": "vo_adv_1400002_005",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就快要開幕了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "準備也萬無一失，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呢！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還留下了令人不安的因素，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那就是……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "針對年輕情侶的企劃。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然有委託你和優衣小姐扮演情侶進行測試了，",
    "voice": "vo_adv_1400002_006",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但是",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "小心為上。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "過度謹慎又務實，這就是我的流派──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這樣的話，為了掌握顧客需求，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我果然也要親自確認。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你理解得很快真是太好了，",
    "voice": "vo_adv_1400002_007",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "畢竟也沒有其他適合的工作人員。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是這樣，今天一天，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "和我去逛度假村吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n以戀人的身分……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只是作為業務的一環",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喔。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯，",
    "voice": "vo_adv_1400002_008",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這只是業務的一環。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n說到底有陛下在，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我也不可能向少年出手──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "──呃。",
    "voice": "vo_adv_1400002_009",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我在跟自己辯解什麼啊？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真不像我……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總而言之，",
    "voice": "vo_adv_1400002_010",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是這樣了！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n決定好了就趕快開始約會吧！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來，",
    "voice": "vo_adv_1400002_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "首先是逛街購物♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這裡的購物園區",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "齊聚了我嚴選的",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一流名牌們！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來吧少年……",
    "voice": "vo_adv_1400002_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不對，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "現在的設定是戀人……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咳。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "{0}。",
    "voice": "vo_adv_1400002_013",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n今天你要什麼",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我都會買給你哦♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1400002_014",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們可是戀人，不用客氣喔。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "而且要站在我身旁的話，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n就得穿上一流的衣物才行。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼我來幫你挑吧。",
    "voice": "vo_adv_1400002_015",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "讓你變身成為",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "有別於以往的成熟男性。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "謝謝老闆。",
    "voice": "vo_adv_1400002_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n一套西裝",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "是50萬盧幣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我都說不用客氣了……",
    "voice": "vo_adv_1400002_017",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼可以給我那件絲綢布料的衣服嗎？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "好的。",
    "voice": "vo_adv_1400002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n這件是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "20萬盧幣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "走吧走吧，",
    "voice": "vo_adv_1400002_019",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "再來去吃午餐吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這裡的廚師，",
    "voice": "vo_adv_1400002_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是超越三星的傳說中的四星廚師喔。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我在國際博覽會時建立了人脈，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這次",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "挖角過來當主廚了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "用令人目瞪口呆的高額薪資♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "老闆，",
    "voice": "vo_adv_1400002_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "感謝您蒞臨本店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "\\n今天要",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "點什麼呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我看看。",
    "voice": "vo_adv_1400002_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那就給我這個",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "「極-KIWAMI-套餐」吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n{0}也吃一樣的沒問題吧？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "因為是老闆的同行人，",
    "voice": "vo_adv_1400002_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "我們準備了特別價格。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "\\n一人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "廚師",
    "words": "30萬盧幣怎麼樣呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "等、",
    "voice": "vo_adv_1400002_024",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "等等！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你要去哪裡～！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……到底是怎麼回事！？",
    "voice": "vo_adv_1400002_025",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n從剛才開始就一直拒絕我的計畫。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n跟我約會有什麼不滿嗎！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "到底是怎樣啊，",
    "voice": "vo_adv_1400002_026",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那不乾脆的態度……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你要那樣的話，我也要認真了……！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "熱血沸騰了～！！　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "絕對要",
    "voice": "vo_adv_1400002_027",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "讓你迷上我！！　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這款錢包",
    "voice": "vo_adv_1400002_028",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是土蛇皮的。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n好的錢包可以招財喔♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我送給你吧，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "店員，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來，我付58萬盧幣。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這款手錶，",
    "voice": "vo_adv_1400002_029",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "世上限定只有五支喔♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "店員，請給我這個。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我付200萬盧幣。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵，",
    "voice": "vo_adv_1400002_030",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "果然高級馬車才能展現男人的地位。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n充滿高級感的悍馬徽章也很棒呢。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "1300萬盧幣。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "502911"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚",
    "voice": "vo_adv_1400002_031",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "都送這麼多禮物了，居然都不屈服。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這樣的話不然就買棟公寓給你好了……！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不，哪裡來的暴發戶社長啊。",
    "voice": "vo_adv_1400002_032",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不知道的人來看的話，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n怎麼看都是渴求年輕男子青睞的",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "中年婦女。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號！？",
    "voice": "vo_adv_1400002_033",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳什麼時候出現的……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "最一開始！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不過，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳說的也算是有點道理。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n剛才的我，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "的確是有點咄咄逼人了……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是我",
    "voice": "vo_adv_1400002_034",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "說什麼都想拿下少年！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但不管我做什麼，都被少年拒絕了……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……因為您天生就不服輸，",
    "voice": "vo_adv_1400002_035",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n所以才開啟了奇怪的幹勁開關，不過……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "只是那樣咄咄逼人，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "可是無法獲得男性青睞的。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！？",
    "voice": "vo_adv_1400002_036",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐……",
    "voice": "vo_adv_1400002_037",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "雖然只是我的猜想。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n但您是不是沒有經歷過",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "一般所謂的普通戀愛？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "您年輕時",
    "voice": "vo_adv_1400002_038",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就將時間花費在工作上。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "相遇的人自然會被受限，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n追求您的男性，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不是想把您當錢包的軟飯男，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就是油膩膩的中年暴發戶。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "普通的戀愛經驗……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哎呀哎呀看看這個，",
    "voice": "vo_adv_1400002_039",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這墨鏡的設計真不錯～",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "唔哇，",
    "voice": "vo_adv_1400002_040",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "被無視到令人震驚的程度。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哼。",
    "voice": "vo_adv_1400002_041",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n就算不用金錢的力量也沒問題！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是嗎，",
    "voice": "vo_adv_1400002_042",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "那麼──",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n請說出讓騎士先生會不自覺「心動♡」的，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n愛的耳語。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這是什麼即興搞笑大賽！？",
    "voice": "vo_adv_1400002_043",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哼。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼首先",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳先示範看看啊。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n都說到這種程度了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一定可以做出完美的範本吧？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "我知道了。",
    "voice": "vo_adv_1400002_044",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n不好意思騎士先生，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "請站在旁邊看著我。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "失禮了──",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "呵呵……",
    "voice": "vo_adv_1400002_045",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "你給予我的愛，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "比夏日豔陽還要炙熱。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "我彷彿要",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "因你而融化了……♪",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……那個，",
    "voice": "vo_adv_1400002_046",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "之後",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "還有時間吧？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "如果你願意的話……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n我想要去",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "可以和你",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "兩人獨處的地方……♡",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
