    "voice": "vo_adv_1400002_080",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "これはティーン向けの雑誌ですね。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n『初めての夏の恋愛特集』",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……付箋がいたるところに。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "毎日お忙しいのに、",
    "voice": "vo_adv_1400002_081",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "こんなに読み込んで。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n全く……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いつ寝てるんでしょうか",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あの人は……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ふふ。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "騎士さん。",
    "voice": "vo_adv_1400002_082",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nあなたはクレジッタさまのこと、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "どう思います？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "流石よく見てますね。",
    "voice": "vo_adv_1400002_083",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n私も概ね同じです。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "どうです？",
    "voice": "vo_adv_1400002_084",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nあの方と一緒にいると、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "毎日飽きないと思いませんか？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "こうしてまた一つクレジッタの魅力を知った{0}は、\\n秘書の言葉に大きく頷いたのだった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500286"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "うう……っ。",
    "voice": "vo_adv_1400002_085",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "一瞬とはいえ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少年を惚れさせてやるなどと……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下に申し訳が立ちませんわ……っ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "そして一人、自己嫌悪に陥るクレジッタだった。",
    "voice": null,
