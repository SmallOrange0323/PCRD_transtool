[
  {
    "type": "background",
    "bg_id": "501070"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ある日、{0}はクレジッタの執務室に呼ばれた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少年。",
    "voice": "vo_adv_1400002_000",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしの恋人になりなさい。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "フッ、",
    "voice": "vo_adv_1400002_001",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "初心なリアクションでよろしくってよ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそりゃ思わずたじろぎもするってもんですわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこんなバリキャリファビュラスウーマンに口説かれたのですから。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ですが残念でしたわね、",
    "voice": "vo_adv_1400002_002",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もちろん本気じゃありませんわよ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ごめんあそばせ？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "物わかり良っ！！　",
    "voice": "vo_adv_1400002_003",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もっとたじろぎなさいな、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこんなバリキャリファビュラスウーマンに口説かれたんですから。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……え、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "本気じゃないでしょって？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふん、",
    "voice": "vo_adv_1400002_004",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お見通しって訳ですか面白くないですわね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もちろん本気じゃありませんわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "この『R＆Aリゾート』。",
    "voice": "vo_adv_1400002_005",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "オープン直前、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "準備は万端",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "し・",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "か・",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "し！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "未だ残る不安材料、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それは……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "若いカップル向けの施策ですわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたとユイさんにカップル役としてモニターをお願いしましたが、",
    "voice": "vo_adv_1400002_006",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "念",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "には念を。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "石橋を叩いて壊れたら補修するのがわたくし流──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "となればやはり自分も顧客ニーズを掴むため、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "現場に出ようかと。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "理解が早く助かりますわ。",
    "voice": "vo_adv_1400002_007",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "他に適任のスタッフもおりませんしね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "という訳で今日一日、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしとリゾートを回っていただきたいのです。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n恋人として……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あくまで業務の一環として、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そう、",
    "voice": "vo_adv_1400002_008",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あくまで業務の一環です。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそもそも陛下の手前、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしが少年にちょっかいをかける訳にはいきませんもの──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "──って。",
    "voice": "vo_adv_1400002_009",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nなにを自分自身に言い聞かせておりますの？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしらしくもない……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "とにかく、",
    "voice": "vo_adv_1400002_010",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そういうことですのっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそうと決まれば早速デート開始ですわよっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さっ、",
    "voice": "vo_adv_1400002_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まずはショッピングですわよ♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこちらのショッピングパークには",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしが厳選した、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n一流ブランドの数々が軒を連ねておりますわ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さあ少年……",
    "voice": "vo_adv_1400002_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえ、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今は恋人設定……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "コホン。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "{0}くん。",
    "voice": "vo_adv_1400002_013",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n今日はあなたのために",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんでも買ってあげますわ♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あらあら、",
    "voice": "vo_adv_1400002_014",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "恋人なのですから遠慮は無用でしてよ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それにわたくしの隣に並ぶのならば、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n一流のアイテムを身に着けていただきませんと。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ではわたくしが選んで差し上げますわ。",
    "voice": "vo_adv_1400002_015",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "一味違う、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "大人の男性に変身させてみせましょう。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "ありがとうございますオーナー。",
    "voice": "vo_adv_1400002_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\nスーツ一式でしめて",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "50万ルピになります。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "遠慮は無用と言っておりますのに……",
    "voice": "vo_adv_1400002_017",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それではこちらのシルクの布の服をくださるかしら？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "承知しました。",
    "voice": "vo_adv_1400002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\nそれではこちら",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "20万ルピになります。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さあさあ、",
    "voice": "vo_adv_1400002_019",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それではランチをいただきましょうか。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ここのシェフ、",
    "voice": "vo_adv_1400002_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "三ツ星を超えた伝説の四ツ星シェフですの。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "万博でコネができまして、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今回、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "料理長として引き抜きましたの。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "目ん玉飛び出るほどの高額なギャラでね♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "オーナー、",
    "voice": "vo_adv_1400002_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "ご来店ありがとうございます。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "\\n本日のご注文は",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "なにになさいますか？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そうですわね。",
    "voice": "vo_adv_1400002_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれではこちらの",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "『極-KIWAMI-コース』をいただこうかしら。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n{0}くんも同じのでいいですわよね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "オーナーとお連れ様ですから",
    "voice": "vo_adv_1400002_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "特別価格でご用意します。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "\\nお一人、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフ",
    "words": "30万ルピでいかがでしょう。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょ、",
    "voice": "vo_adv_1400002_024",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nどこに行くおつもりですの～っ！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……まったくどういうことですの！？",
    "voice": "vo_adv_1400002_025",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nさっきからわたくしのプランを断ってばかり。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしとデートするのが不服なのかしら！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんですのなんですの、",
    "voice": "vo_adv_1400002_026",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その煮え切らない態度は……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そっちがその気ならこっちも本気でいかせてもらいますわ……！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "フフフ……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "燃えてきましたわよ～……っ！！　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "絶対に、",
    "voice": "vo_adv_1400002_027",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "惚れさせてやりますわっ！！　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こちらの財布、",
    "voice": "vo_adv_1400002_028",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ツチノコブラ革ですわね。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nいい財布はお金を呼び込みますのよ♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こちらプレゼントしますね、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "店員さん、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はい58万ルピ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あらこの腕時計、",
    "voice": "vo_adv_1400002_029",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "世界で限定５本ですのよ♪",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "店員さんこちらいただけるかしら。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はい、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "200万ルピ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "フフン、",
    "voice": "vo_adv_1400002_030",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "やはり高級馬車は男のステイタス。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n高級感あふれる暴れ馬のエンブレムも素敵ですわね。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はい、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "1300万ルピ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "502911"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ぐ",
    "voice": "vo_adv_1400002_031",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ぬぬっ……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これだけのプレゼントでもなびかないだなんて。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこうなったらマンションでも貢いでやろうかしらっ……！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いやどこの成金社長ですか。",
    "voice": "vo_adv_1400002_032",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "知らない人からしたら、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n若い燕の気を引こうとしてる",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "姥桜にしか見えませんよ。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "秘書１号っ！？　",
    "voice": "vo_adv_1400002_033",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたいつから……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "初めからっ！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……しかし、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたの言うことは一理なくもないですわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n今のわたくし、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少々ギラついてしまっていたかもしれませんわね……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ですがわたくし、",
    "voice": "vo_adv_1400002_034",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何が何でも少年を落としたいのですっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それなのに少年は何をしても断るばかりで……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……生来の負けず嫌いから、",
    "voice": "vo_adv_1400002_035",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n謎のやる気スイッチが入っておられるようですが……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ギラギラするだけでは",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "殿方は落とせませんよ。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ！？",
    "voice": "vo_adv_1400002_036",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま……",
    "voice": "vo_adv_1400002_037",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あくまで予想ですが。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nあなたは俗にいう",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "普通の恋愛をしてこなかったのでは？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あなたは若い時代を",
    "voice": "vo_adv_1400002_038",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "仕事で消費してきました。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "出会いは当然限られ、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n言い寄る男性は",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "財布目当てのヒモ志望か、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "脂ぎった中年の成金ばかり。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nですから",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "普通の恋愛は……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……あらあらまあまあ、",
    "voice": "vo_adv_1400002_039",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このサングラスいいデザインですわね～",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "うわ、",
    "voice": "vo_adv_1400002_040",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "驚くほどスルーされた。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふんっ。",
    "voice": "vo_adv_1400002_041",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n金の力など使わなくとも問題ありませんわっ！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そうですか。",
    "voice": "vo_adv_1400002_042",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "それでは──",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n騎士さんが思わず「きゅん♡」としちゃう、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n愛のささやきをお願いいたします。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんの大喜利ですの！？",
    "voice": "vo_adv_1400002_043",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……フン。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "だったらまずは",
