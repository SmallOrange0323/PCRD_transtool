    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "っ！！？",
    "voice": "vo_adv_1400002_047",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふ、",
    "voice": "vo_adv_1400002_048",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふーん。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "中々やるじゃありませんの。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "正直申しまして少々甘く見ておりましたわ……",
