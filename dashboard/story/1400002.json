    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ちょっと隣に立ってこっち見ててくださいね。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nそうそう",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そんな感じで。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……では、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "僭越ながら──",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "フフ……",
    "voice": "vo_adv_1400002_045",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あなたが注いでくれる愛が、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "夏の日差しよりも熱くて。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あなたに溶けてしまいそう……♪",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……ね、",
    "voice": "vo_adv_1400002_046",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "まだ時間",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "だいじょうぶよね？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "もし嫌じゃなかったら……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nどこか",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "二人っきりになれる場所に、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
