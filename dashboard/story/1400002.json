    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたがやって見せなさいな。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれだけいうのなら、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さぞや見事な手本が見られるのでしょうね？",
