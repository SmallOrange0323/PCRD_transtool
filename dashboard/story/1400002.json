    "name": "克蕾琪塔",
    "words": "是啊！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "作為業務的一環！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要扮演戀人的話就要認真投入！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這才是身為職業人士該做的！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n哦呵呵呵呵……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好了好了約會工作就到此為止！！",
    "voice": "vo_adv_1400002_078",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "少年，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "辛苦你了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "今天的事情就全忘了吧！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n知道了吧？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "３、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "２、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "１，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好了全忘了！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那就失陪了！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……走掉了。",
    "voice": "vo_adv_1400002_079",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "嗯，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "哦，",
    "voice": "vo_adv_1400002_080",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "這是青少年雜誌呢。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n「第一次的夏天戀愛特輯」",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……到處都貼了便利貼。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "明明每天都這麼忙，",
    "voice": "vo_adv_1400002_081",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "還讀得這麼認真。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "那個人",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "到底什麼時候睡覺啊……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "騎士先生。",
    "voice": "vo_adv_1400002_082",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n你對克蕾琪塔小姐",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "有什麼想法？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不愧是你，看得很清楚呢。",
    "voice": "vo_adv_1400002_083",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n我也差不多是這麼想的。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "怎麼樣？",
    "voice": "vo_adv_1400002_084",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n不覺得和她在一起的話，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "每天都不會膩嗎？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}又發現克蕾琪塔的一項魅力，\\n對秘書的話大力點頭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500286"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚嗚……",
    "voice": "vo_adv_1400002_085",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就算只有一瞬間，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "居然想讓少年迷上我……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒有臉面對陛下了……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一邊是，獨自陷入自我厭惡的克蕾琪塔。",
    "voice": null,
    "unit_id": null
  }
]
