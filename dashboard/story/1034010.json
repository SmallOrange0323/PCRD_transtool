    "name": "優花梨",
    "words": "那我先說明情況，",
    "voice": "vo_adv_1034010_024",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n【墨丘利財團】的流通路線",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n接獲有魔物出現的報告。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這種事情原本",
    "voice": "vo_adv_1034010_025",
    "unit_id": 103411
  },
  {
