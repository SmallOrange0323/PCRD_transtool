  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自禁酒宣言後數日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}很在意優花梨的情況，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便來到了【墨丘利財團】的公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，",
    "voice": "vo_adv_1034010_000",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這裡的計算有錯。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n看來是沒加到這部分的數字。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我這裡先做更正吧。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯，",
    "voice": "vo_adv_1034010_001",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這份文件",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總算是送來了啊。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "明明就拜託過這種申請要早點送過來了。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n還有很多資料都沒填到……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "得聯絡退回才行。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這月的營業額報告書……",
    "voice": "vo_adv_1034010_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然有穩定上升，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n但還有不少能改進的地方。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來整理削減不必要經費的方案吧。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "接下來是……",
    "voice": "vo_adv_1034010_003",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這不是{0}嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n怎麼了？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抱歉，",
    "voice": "vo_adv_1034010_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我現在正在忙。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n沒什麼空能陪你聊天。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯？　",
    "voice": "vo_adv_1034010_005",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n一臉驚訝的樣子……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵。",
    "voice": "vo_adv_1034010_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……難道我一直都被認為講話含糊不清嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你到底是怎麼看待我的啊……",
    "voice": "vo_adv_1034010_007",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "的確是我每次都讓你看到那樣的一面。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然我總是讓{0}見到我鬆懈的一面，",
    "voice": "vo_adv_1034010_008",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n但這",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才是原本的我喔。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你明白嗎？　",
    "voice": "vo_adv_1034010_009",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真的？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……啊，",
    "voice": "vo_adv_1034010_010",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都已經這個時間了。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "差不多該去喝……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，不對不對！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "差點就要一副理所當然的樣子說出口了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真可怕……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不可以，",
    "voice": "vo_adv_1034010_011",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "優花梨！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n妳不是已經發誓要禁酒了嗎！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抱歉，",
    "voice": "vo_adv_1034010_012",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我要接著繼續處理沒做完的工作，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n所以沒辦法和你一起去吃飯！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "今天的工作量也很多呢。",
    "voice": "vo_adv_1034010_013",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要拿出幹勁來囉～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再隔天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵、",
    "voice": "vo_adv_1034010_014",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒事，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒事的，優花梨！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是為工作而生的！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，一週後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呃……",
    "voice": "vo_adv_1034010_015",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這邊的文件很香……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這裡的數字很順口呢……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "每天加班之後，",
    "voice": "vo_adv_1034010_016",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總覺得",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "心情都嗨起來了……！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這種時候",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就想一口氣乾下那個",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵呵呵呵……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "酒？",
    "voice": "vo_adv_1034010_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊！？　",
    "voice": "vo_adv_1034010_018",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我、",
