[
  {
    "type": "background",
    "bg_id": "500360"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "クレジッタは打ち合わせのため【美食殿】のギルドハウスを訪れた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下ー、",
    "voice": "vo_adv_5132067_000",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いらっしゃいますかー？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "親愛なる忠臣、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "クレジッタ・キャッシュですわー！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あ、",
    "voice": "vo_adv_5132067_001",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさん！　",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "すみません、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしちょっと出かけるので、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "中で待っててくださーい！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "え、",
    "voice": "vo_adv_5132067_002",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "へ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下！？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nちょっと、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どちらへ行かれますのーっ！？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさま、",
    "voice": "vo_adv_5132067_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "誰かいらっしゃったのです──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "おや、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "クレジッタさま。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "いらっしゃいませ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさまにご用事ですか？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あ、",
    "voice": "vo_adv_5132067_004",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "チビ……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "い、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "コッコロさん、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ごきげんよう。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下にお話があったのですが……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "申し訳ありません。",
    "voice": "vo_adv_5132067_005",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさまは",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今晩の鍋パーティーで使う",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nポン酢を買いに行かれました。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "お鍋に浮かれすぎたあまり、",
    "voice": "vo_adv_5132067_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "材料ばかりに気をとられ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nポン酢が切れていたことに",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "先ほど気付かれたようです。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "すぐにお戻りになりますから、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "中でお待ちください。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あまりスケジュールに余裕はないのですけれど……",
    "voice": "vo_adv_5132067_007",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "出直す方が時間がもったいないですわね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n仕方ありません。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "この際ですし、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もてなされて差し上げますわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "はい。",
    "voice": "vo_adv_5132067_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nお任せくださいませ。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "粗茶ですが、",
    "voice": "vo_adv_5132067_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "よろしければどうぞ。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n外は冷えますから、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "熱く淹れております。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "お気を付けくださいまし。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "フン、",
    "voice": "vo_adv_5132067_010",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "粗茶ですって？　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こちらではそんなものしか出せないのかしら。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nもし万が一陛下にやっすい茶葉の出涸らしなど飲ませていたら",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくし承知しませんことよ──",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "（ごくっ）",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……これは……！　",
    "voice": "vo_adv_5132067_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "決して高級ではありませんけれど、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n確かな技術と真心を感じる一杯ですわね……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何より、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少し熱めに",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n煎じられた茶の温かさが、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "凍えた身体に染み渡りますわ……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "こちら頂き物ではありますが、",
    "voice": "vo_adv_5132067_012",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "お茶請けでございます。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n【メルクリウス財団】からのお歳暮ですので、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "味は折り紙つきですよ。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nわたくしが手塩にかけた漬物もございます。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "あとそれから──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "クレジッタさまは、",
    "voice": "vo_adv_5132067_013",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔物料理を抵抗なく召し上がっておられましたね。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "では",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "こちらを──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさまが狩った魔物の燻製です。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n後ほど感想をいただければ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさまも喜ぶかと。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ああ、",
    "voice": "vo_adv_5132067_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ひょっとしてお昼ご飯がまだでいらっしゃいますでしょうか。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "それでしたら、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ただちにご用意させていただきます。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "取り急ぎ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "おにぎりとラーメンとサンドイッチとスパゲッティと──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっとお待ちなさいな！？　",
    "voice": "vo_adv_5132067_015",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしそんなに食べられませんわよ",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "っていうかどれだけ食べ物出てきますのこのお家は食堂か何かでしたの",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ああそうでしたわね【美食殿】でしたわねこちらのギルド！？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "えっ？",
    "voice": "vo_adv_5132067_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「待て」と言われましても……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "その前に",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「もてなせ」と",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nおっしゃられたのは、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "クレジッタさまではありませんか。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "限度というものがあるでしょう！？",
    "voice": "vo_adv_5132067_017",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それにあれは、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そう、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっとした軽口でございましてよ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そもそも。",
    "voice": "vo_adv_5132067_018",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女のほうだって、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "赤の他人どころか",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nかつては敵のようなものだったこのわたくしを",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこれほどもてなす義理はないでしょうにっ……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……キャルさまは",
    "voice": "vo_adv_5132067_019",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "否定されるかもしれませんが、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "わたくしは",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "クレジッタさまに悪感情はありません。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "むしろ今回のクリスマスを通じ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝の気持ちを抱いております。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "少し前……",
    "voice": "vo_adv_5132067_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "わたくしたちは、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "辛い別れを経験しました。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nぺコリーヌさまも、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明るくふるまってはおられますが……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n折に触れて、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "悲しいお顔をされることがございます。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……",
    "voice": "vo_adv_5132067_021",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ですが、",
    "voice": "vo_adv_5132067_022",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "このところ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ペコリーヌさまは心の底から楽しそうなのです。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一時であれ、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "楽しく過ごしていただけたら。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "なので本当に、",
    "voice": "vo_adv_5132067_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ありがとうございます、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "クレジッタさま。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……べっ、",
    "voice": "vo_adv_5132067_024",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "別に貴女たちのためではございませんわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n全ては陛下のためにやったこと、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女たちのことなんて",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nその副産物みたいなものですわよ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "はい。",
    "voice": "vo_adv_5132067_025",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n存じておりますが、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "それでもわたくしは",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "お礼を申し上げたいのです。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……全く、",
    "voice": "vo_adv_5132067_026",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "調子狂いますわね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これだから甘ちゃんのお子ちゃまは……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ただいまー！　",
    "voice": "vo_adv_5132067_027",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はぁー、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ギルドハウスの中はぽかぽかですねぇ……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あ、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさん、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "お待たせしてすみません！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お帰りなさいませ、",
    "voice": "vo_adv_5132067_028",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どうぞお気になさらずに。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "コッコロさんから、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "厚くもてなしていただいておりましたので。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_5132067_029",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "なんだか、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "部屋の中がいい雰囲気ですね。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "二人で何を話してたんですか？",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "べ、",
    "voice": "vo_adv_5132067_030",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "別にそんな……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ただの世間話ですわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "はい。",
    "voice": "vo_adv_5132067_031",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "仲間同士の他愛もない話です。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な、",
    "voice": "vo_adv_5132067_032",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仲間……！？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そうだったんですか～",
    "voice": "vo_adv_5132067_033",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "でも、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "二人だけで楽しんでちょっとずるいです。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしもまぜてください！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "それでは",
    "voice": "vo_adv_5132067_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "お茶を淹れ直してまいります。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえ、",
    "voice": "vo_adv_5132067_035",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そうしたいところは山々ですけれど。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あの、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしは用件が済んだらお暇を……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それはだめです。",
    "voice": "vo_adv_5132067_036",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんには",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "夜のお鍋にも",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n付き合ってもらいますから！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お、",
    "voice": "vo_adv_5132067_037",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お待ちください陛下！　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "せっかくの【美食殿】のパーティーなのに",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしがいては台無しになってしまいますわ……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "おかしなことをおっしゃいますね。",
    "voice": "vo_adv_5132067_038",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "仲間同士で鍋を囲むだけですのに、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nなぜ台無しになるのでしょう？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "くっ、",
    "voice": "vo_adv_5132067_039",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんな曇りなき瞳で見つめないでくださいな！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "しかし貴女たちがよろしくても、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あのネコ助はどう思うか……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それは大丈夫です。",
    "voice": "vo_adv_5132067_040",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "キャルちゃんだって",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "口では悪ぶっていても",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nちゃんとクレジッタさんのことは理解しているはずです☆",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……だといいのですが。",
    "voice": "vo_adv_5132067_041",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "そうと決まれば、",
    "voice": "vo_adv_5132067_042",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主さまとキャルさまがお戻りになる前に、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nお鍋の準備を進めておきましょう。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "では、",
    "voice": "vo_adv_5132067_043",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "せめてお手伝いさせてくださいませ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "客人ではなく、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仲間と呼んでいただけるのでしたら、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "は、",
    "voice": "vo_adv_5132067_044",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "は",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "い！　",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "よろしくお願いします！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "ふふ、",
    "voice": "vo_adv_5132067_045",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "楽しいパーティーになりそうです。",
    "voice": null,
    "unit_id": 105913
  }
]
