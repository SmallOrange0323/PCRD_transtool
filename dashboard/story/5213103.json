  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "覺醒☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n神清氣爽，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "連睡意也不知道跑到哪裡去了☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然",
    "voice": "vo_adv_5213103_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "非常酸，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但正是這種酸味感覺令人上癮，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就像整個口腔都被清爽地沖洗過一樣～♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "多虧了醬汁，食材的口感也變得",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "彈牙",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "緊實，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真好吃～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來這裡的路上，",
    "voice": "vo_adv_5213103_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "其實有點開始想睡了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "多虧了大家，小初音",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "已經完全復活了～☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
