  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "やあ同志、",
    "voice": "vo_adv_6023302_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "今日も知識を育んでいるかね。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なに、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくについて知りたい？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "よかろう、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なんなりと聞きたまえ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "学問以外であれば、",
    "voice": "vo_adv_6023302_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうさな、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "芸術方面にも多少の造詣はあるぞ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もっとも、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの独創的な作品群は",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "余人の理解が及ばないらしい。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n人類にはまだ早いなどと評されたよ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "身長１７０センチ、",
    "voice": "vo_adv_6023302_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "体重６０キロ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nスリーサイズは上から順に",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "９０・",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "５５・",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "９０の予定だ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "現在は途上の段階だがな。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "はい次の質問。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ……",
    "voice": "vo_adv_6023302_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君はアレかね。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "星座占いや",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "血液型診断を信じるクチかね。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "構わんよ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "思想も信仰も個人の自由さ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "その手の本に言わせれば、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくは適応力のうお座・",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "寛容性のО型ということらしいからな。",
    "voice": null,
    "unit_id": 111011
  }
]
