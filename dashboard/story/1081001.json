  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被突然出現的魔物襲擊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請快趴下……",
    "voice": "vo_adv_1081001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "幻影驚駭！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼。",
    "voice": "vo_adv_1081001_001",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "剛才好危險。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你有受傷嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太好了。",
    "voice": "vo_adv_1081001_002",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在這時期，不知道會發生什麼事情。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子！　",
    "voice": "vo_adv_1081001_003",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "要是你就那樣掛掉就好了，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "呸呸。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸。",
    "voice": "vo_adv_1081001_004",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說話別那麼兇。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還有爸爸，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算你說",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「呸」，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n其實也吐不出口水吧？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個。",
    "voice": "vo_adv_1081001_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在萬聖節這時期，現實與靈界會變得比較接近，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以魔物會受到惡靈之類的影響，變得很容易失控。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，",
    "voice": "vo_adv_1081001_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我很不希望你一個人獨自行動……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊。",
    "voice": "vo_adv_1081001_007",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你現在是要回蘭德索爾對吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們就一起走吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也有事要去那裡一趟。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為在這時期魔物很容易失控，",
    "voice": "vo_adv_1081001_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以想換一些新裝備。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n現在我就是要去拿訂製的裝備。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哦哦哦！　",
    "voice": "vo_adv_1081001_009",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那些穿著萬聖節Cosplay的女孩，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "還真是大膽呢！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n大腿實在太耀眼了！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "而且，",
    "voice": "vo_adv_1081001_010",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "居然大剌剌地把胸部秀出來，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "真是太不知羞恥了！\\n",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔齁齁，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "好想埋在那胸部中間！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸。",
    "voice": "vo_adv_1081001_011",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這種話偷偷說出來就好。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你這麼大聲地喊出來，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真不知道誰才是不知羞恥的人呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………",
    "voice": "vo_adv_1081001_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081001_013",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你說我看起來好像沒什麼精神嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……",
    "voice": "vo_adv_1081001_014",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實我，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "並不是很喜歡萬聖節。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我很不習慣",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "待在人多的地方。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "505030"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1081001_015",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是這裡呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我過去拿東西，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請稍等一下。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "哦，",
    "voice": "vo_adv_1081001_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "訂製裝備的客人呀！　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "等妳很久了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "\\n這次的成品可是連冶煉工匠都拍胸脯保證的最棒傑作呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣啊……",
    "voice": "vo_adv_1081001_017",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這裝備有點……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "尺寸可以再幫妳做些調整，",
    "voice": "vo_adv_1081001_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "請試穿看看！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "\\n來吧，這邊請！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "久、",
    "voice": "vo_adv_1081001_019",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "久等了……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想這真的是很棒的裝備，",
    "voice": "vo_adv_1081001_020",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但這外觀實在是……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好像我很喜歡過萬聖節一樣，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太令人害羞了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳說什麼啊，忍！　",
    "voice": "vo_adv_1081001_021",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我覺得很適合妳又很可愛唷，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這套服裝呀！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1081001_022",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個是裝備唷。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "並不是什麼服裝。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081001_023",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非常可愛，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n怎麼連",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}都這麼說……！",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍……",
    "voice": "vo_adv_1081001_024",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我剛剛也說妳可愛，根本就是差別待遇啊！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n可惡啊，小伙子！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我要把你的頭蓋骨給打爆！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣很",
    "voice": "vo_adv_1081001_025",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "時髦嗎？　",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我對一般的流行不是很清楚，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過能聽到你稱讚我，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太好了……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1081001_026",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不對。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是這樣。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一點也不好。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子，",
    "voice": "vo_adv_1081001_027",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你居然有膽用那種有色眼光看我家的忍，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n看我不把你的喉嚨給咬斷！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "怎、",
    "voice": "vo_adv_1081001_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "怎麼了！？　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "地震！？　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "商品突然擅自動了起來……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "噫！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……",
    "voice": "vo_adv_1081001_029",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "連幽靈們",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也都很滿意嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
