[
  {
    "type": "background",
    "bg_id": "500016"
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "おや、",
    "voice": "vo_adv_5044431_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "今日でバカンスも終わりなのかい。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "まだ来たばかりだと思っていたんだけどねぇ。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ぐぬぬ、",
    "voice": "vo_adv_5044431_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "やり足りないことだらけではないか！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "この地に眠る伝説を",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "まだ探し終わっていないのだぞ！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "何言ってんのアンナたそ、",
    "voice": "vo_adv_5044431_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "来年また来ればいいでしょ。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "織姫ちゃんたちと会うって約束したんだし。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ね？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……",
    "voice": "vo_adv_5044431_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "確かに、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ナナカの言う通りだな。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ならば仕方あるまい、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "伝説探しは",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "来年の楽しみとしておこう。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "帰る前に買い物しなきゃね！",
    "voice": "vo_adv_5044431_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ミツキさんとエリコ様にお土産買わなきゃ",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "絶対怒られるし～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "さぁて、",
    "voice": "vo_adv_5044431_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "最後に思いっきり遊んでいこうかね。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さんは",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何かやり残したことはないかい？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシたちと一緒に、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "夜まで楽しもうじゃないか！",
    "voice": null,
    "unit_id": 105611
  }
]
