  },
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "到此為止了！",
    "voice": "vo_adv_1032009_032",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n你這個壟斷限量商品，",
    "voice": null,
    "unit_id": 103211
  },
