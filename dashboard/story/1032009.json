  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你把餐具的位置擺錯了喔，",
    "voice": "vo_adv_1032009_043",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而且今天的料理",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不需要用到這組餐具。",
