    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "這不算犯法吧！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……真是夠了。",
    "voice": "vo_adv_1032009_036",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "看來你連商人的自尊都失去了呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "只不過是個暴發戶大小姐，",
    "voice": "vo_adv_1032009_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "不吃點苦頭就不會懂的吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "你們幾個，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "去讓她見識見識這世界有多殘酷。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "唉，",
    "voice": "vo_adv_1032009_038",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然我不太喜歡動粗，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但若有人要加害我，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就不得不反擊了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要上囉，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500070"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "辛苦你了，",
