    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "我只是把稀有的東西賣給想要它們的人而已。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "\\n可沒做任何虧心事啊？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "我也是在做生意，",
    "voice": "vo_adv_1032009_035",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "提高些價格也是情非得已。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "黑心商人",
    "words": "就算有點貴，但還是許多人想要購買。",
