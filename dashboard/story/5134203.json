[
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……嗯，",
    "voice": "vo_adv_5134203_000",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "做了個好夢！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然要說的話，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好像跟作戰完全沒有關係，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而是在宇宙空間中跟隕石對揍，然後就把它破壞掉了！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "慢著！",
    "voice": "vo_adv_5134203_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n如果真的是那樣也很困擾吧，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這不就代表未來又改變了嗎！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "應該說，",
    "voice": "vo_adv_5134203_002",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "光是從身處在宇宙空間這點來看就很奇怪啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳再睡一次，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好好去作本來的夢啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n怎麼可能用肉身突破大氣層啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦～",
    "voice": "vo_adv_5134203_003",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是沒辦法呢……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是我已經餓到睡不著了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n可以先讓我去攤販買東西吃嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還、",
    "voice": "vo_adv_5134203_004",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還真是我行我素呢……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "先讓她像這樣稍微休息一下，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n或許也能讓預知夢的結果變好？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這我是不知道啦，",
    "voice": "vo_adv_5134203_005",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但就只能相信她了吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我們也去吃個晚餐吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這說不定會是最後的晚餐呢，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我要大吃一頓。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "才不會是最後的晚餐呢！",
    "voice": "vo_adv_5134203_006",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為我們都還沒有吃到年菜啊，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要更積極地來努力吧～☆",
    "voice": null,
    "unit_id": 128411
  }
]
