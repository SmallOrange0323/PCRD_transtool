  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "如果你不介意就一起吃吧♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請",
    "voice": "vo_adv_1260002_028",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "慢用～",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "嗚喵～～♪",
    "voice": "vo_adv_1260002_029",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵，",
    "voice": "vo_adv_1260002_030",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "看來",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很合你們的胃口，真是太好了……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不需要吃得那麼急也沒關係唷～",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要細嚼慢嚥哦，",
    "voice": "vo_adv_1260002_031",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嚼嚼、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嚼嚼、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嚼嚼……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "吃飽後我們再一起去洗澡吧……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "剛、",
    "voice": "vo_adv_1260002_032",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "剛才那句話不是在對哥哥說哦！？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n要一起洗澡的是……！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……啊，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "你說你知道？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說的也是呢，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不好意思……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "嗚喵……♪",
    "voice": "vo_adv_1260002_033",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗯，",
    "voice": "vo_adv_1260002_034",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "怎麼",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "跑過來玩了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n你的飯還沒有吃完哦～？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是想跟我說什麼嗎～？",
    "voice": "vo_adv_1260002_035",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說謝謝……",
    "voice": "vo_adv_1260002_036",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵……",
    "voice": "vo_adv_1260002_037",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "居然向我道謝。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "小貓咪，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要道謝的話，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "應該要向這位哥哥說才對哦？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……那個，",
    "voice": "vo_adv_1260002_038",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n老實說……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要不是跟哥哥一起遇見牠，",
    "voice": "vo_adv_1260002_039",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我想我一定……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n不會把這孩子帶回家。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……我。",
    "voice": "vo_adv_1260002_040",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我",
    "voice": "vo_adv_1260002_041",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "並非大家心中所認為的……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……那種聖女。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我不是什麼好孩子……",
    "voice": "vo_adv_1260002_042",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……呵呵，",
    "voice": "vo_adv_1260002_043",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n過來吧。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "嗚喵～",
    "voice": "vo_adv_1260002_044",
    "unit_id": 1711
  },
  {
    "type": "still",
    "still_id": "126000201"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我",
    "voice": "vo_adv_1260002_045",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "從小只要在別人面前，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就會裝出一副乖寶寶的樣子……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n真的是不自覺的。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "裝得像貓一樣乖……",
    "voice": "vo_adv_1260002_046",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "開玩笑的♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": "vo_adv_1260002_047",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……剛才回來的路上，",
    "voice": "vo_adv_1260002_048",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我不是問了哥哥一個問題嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n問你",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "覺不覺得我是普通的女孩子。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "沒錯，",
    "voice": "vo_adv_1260002_049",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我只是個普通的女孩子。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是聖女也不是其他身分……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就只是個",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普通的女孩子。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以",
    "voice": "vo_adv_1260002_050",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在打工地點被店長或常客",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那樣子叫……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "讓我有點難為情。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……不過，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這些都是我自己的問題就是了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "明明是自己裝成乖巧聽話的樣子，",
    "voice": "vo_adv_1260002_051",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n一旦被人稱做「聖女」時，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "卻又覺得討厭……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我這樣太任性了對吧……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "still",
    "still_id": "126000202"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……所以。",
    "voice": "vo_adv_1260002_052",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n不管是把這孩子帶回來這件事，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還是替牠做飯這件事，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n都不是出自純粹的善心。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……而是因為",
    "voice": "vo_adv_1260002_053",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是在哥哥面前……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我才這麼做的。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "打工也是，",
    "voice": "vo_adv_1260002_054",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "因為是在哥哥面前，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n所以我才沒有逃跑。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要是哥哥不在的話……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……啊，",
    "voice": "vo_adv_1260002_055",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但並不是因為",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥在我心中是特別的……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是因為這樣！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也不能說不特別就是了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": "vo_adv_1260002_056",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……不對，",
    "voice": "vo_adv_1260002_057",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我到底在胡說些什麼啊？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這些事我從沒對別人……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "甚至連莉莉我都沒有跟她說過……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……這就是我真實的樣子。",
    "voice": "vo_adv_1260002_058",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n讓你幻滅了嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……真的",
    "voice": "vo_adv_1260002_059",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n哥哥果然很溫柔呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……！",
    "voice": "vo_adv_1260002_060",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n很……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很喜歡……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真是的……",
    "voice": "vo_adv_1260002_061",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n請別說那種",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "容易讓人誤會的話好嗎……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n尤其",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "絕對不能在莉莉",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "的面前說……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "126000201"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……呵呵，",
    "voice": "vo_adv_1260002_062",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "總覺得只要在哥哥面前，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就會不小心把心裡話都說出口呢……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可是……",
    "voice": "vo_adv_1260002_063",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請幫我",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對大家保密哦。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "因為我似乎並不討厭",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在哥哥面前裝乖喔♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……呵呵。",
    "voice": "vo_adv_1260002_064",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n好……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵～",
    "voice": "vo_adv_1260002_065",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_1260002_066",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對不起，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "飯才吃到一半呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好了，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥也快點吃吧♪",
    "voice": null,
    "unit_id": 126012
  },
  {
