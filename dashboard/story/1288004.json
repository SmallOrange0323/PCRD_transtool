[
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克服了暴風雨的考驗的怜與{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再次造訪了布里薩溪谷。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……果然如此。",
    "voice": "vo_adv_1288004_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不論是從這個地方",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是祖父的劍，都感受不到力量。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "考驗結束後，",
    "voice": "vo_adv_1288004_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "試著來看看有沒有發生變化……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但看來",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡能做的事都已經結束了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1288004_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這晴天簡直就像那場暴風雨是騙人的呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這不會……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有點太耀眼了嗎……？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我說你，",
    "voice": "vo_adv_1288004_003",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這邊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我在等你喔。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你要喝什麼飲料？",
    "voice": "vo_adv_1288004_004",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……特調？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，",
    "voice": "vo_adv_1288004_005",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "追加一杯特調咖啡。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉突然把你叫出來。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "最近",
    "voice": "vo_adv_1288004_006",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我家管得越來越嚴了呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要是被事先知道安排，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有可能會被察覺。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "考慮到我的性格，這根本是反效果，",
    "voice": "vo_adv_1288004_007",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n真希望他們有差不多領會到這點就好了……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但要是他們有這麼好溝通，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也就不用辛苦了吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "噢，",
    "voice": "vo_adv_1288004_008",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "馬上進入正題吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我偶然間",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得到了這樣的東西喔。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_1288004_009",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我學校作業交出的作文，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在競賽中運氣很好地得獎了呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是附帶的獎賞喔。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1288004_010",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是兩張一組的票……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個，",
    "voice": "vo_adv_1288004_011",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這間似乎是國內首屈一指的水族館。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想說不用的話也很浪費。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果票只有一張，我就自己去了，",
    "voice": "vo_adv_1288004_012",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是三張的話，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也想過要約優衣和日和……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但總之",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是兩張呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為是兩張的關係。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你想，",
    "voice": "vo_adv_1288004_013",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我如果只約其中任何一方，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n該怎麼說……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也會覺得不太對吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唔，",
    "voice": "vo_adv_1288004_014",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "正因為是你",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "才行。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算知道我家的事，",
    "voice": "vo_adv_1288004_015",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也能自然地與我相處吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我能像這樣無顧忌地相處的對象",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "絕對不多。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且，",
    "voice": "vo_adv_1288004_016",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你總是在幫助我，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也想把這……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當作",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝禮……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……難不成你很為難",
    "voice": "vo_adv_1288004_017",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這、",
    "voice": "vo_adv_1288004_018",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1288004_019",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果要把館內全都逛完，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多少加快腳步也好。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "感謝",
    "voice": "vo_adv_1288004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "各位的光臨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n還請慢慢",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "欣賞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……館內意外地暗呢。",
    "voice": "vo_adv_1288004_021",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是為了配合展示的魚",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而調整了照明嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對面那邊很亮呢。",
    "voice": "vo_adv_1288004_022",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那是",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這座水族館招牌的……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "128800401"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…………",
    "voice": "vo_adv_1288004_023",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然有聽說這裡是全國首屈一指……",
    "voice": "vo_adv_1288004_024",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但這還真是驚人呢……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊……",
    "voice": "vo_adv_1288004_025",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我一時",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說不出話……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這個水槽",
    "voice": "vo_adv_1288004_026",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是在重現珊瑚礁之海嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": "vo_adv_1288004_027",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還不只這裡。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n同規模的大水槽",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有好幾個……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "每一個都各自重現了不同的海洋……",
    "voice": "vo_adv_1288004_028",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "世界上",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有這麼多的海洋存在呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1288004_029",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看著悠游的魚群，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n該說緊張的心情放鬆了嗎……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總覺得連呼吸都",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "稍微輕鬆了一點啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "128800402"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": "vo_adv_1288004_030",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你比我還更興奮不是嗎。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n呵呵……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不枉我約你了啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "128800401"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這些魚能活多久呢……",
    "voice": "vo_adv_1288004_031",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n聽說有些種類",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以活幾十年。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也有推算活了30年以上的魚啊。",
    "voice": "vo_adv_1288004_032",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在比我出生還",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "更早之前就……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_1288004_033",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這些魚",
    "voice": "vo_adv_1288004_034",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會不會想出去外面呢？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_1288004_035",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡的展示說明上也有寫，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這個水槽",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有配合魚群整頓槽內的環境。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "魚群之中",
    "voice": "vo_adv_1288004_036",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果有在水族館出生的魚，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那就也有從大自然中收集來的魚了吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這些魚",
    "voice": "vo_adv_1288004_037",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會就這樣一直在水槽中生存。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該也有原本是在大海中游泳的魚。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "了解外面世界的魚群，",
    "voice": "vo_adv_1288004_038",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會想些什麼呢？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這水槽中生活比較幸福嗎……",
    "voice": "vo_adv_1288004_039",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我忍不住會去思考這種事。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無聊……",
    "voice": "vo_adv_1288004_040",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這我連想都沒想過呢……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不過，",
    "voice": "vo_adv_1288004_041",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我一定",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也會得出一樣的回答。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不會否定在安寧中度過。",
    "voice": "vo_adv_1288004_042",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那樣我",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不會滿足的。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "假設要遵循誰的意志前進，",
    "voice": "vo_adv_1288004_043",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "然後成為某個人。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那樣就……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是我了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算是為了我量身打造出來的環境，",
    "voice": "vo_adv_1288004_044",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也不會覺得止步於其中是件好事吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算身在水槽中，",
    "voice": "vo_adv_1288004_045",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也會持續憧憬外面的世界，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "直至生命的盡頭。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咦？",
    "voice": "vo_adv_1288004_046",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "鮪魚？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……啊啊，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是在對面的水槽裡吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "展示說明寫的，",
    "voice": "vo_adv_1288004_047",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我剛才也有讀到呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n透過持續游泳，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓水通過鰓",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來呼吸的結構……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我記得",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是叫撞擊換氣吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是不持續游泳就不能呼吸，這種事，還真費力啊……",
    "voice": "vo_adv_1288004_048",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不對，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也是一樣的嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無法停留在同一個地方，",
    "voice": "vo_adv_1288004_049",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算身處封閉的水槽，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也會憧憬著外面的世界而感到焦躁。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若我是孤身一人，",
    "voice": "vo_adv_1288004_050",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "心中可能早已屈服了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n對改變不了的未來感到絕望，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "並向命運屈膝……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或者",
    "voice": "vo_adv_1288004_051",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會只剩憤怒裝滿心中，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n並持續戴著假面具生活。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……但是，",
    "voice": "vo_adv_1288004_052",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "自從遇見了你，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為有你在，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我才沒有迷失自我。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若是",
    "voice": "vo_adv_1288004_053",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我將我心懷的一切全盤托出，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n並向你求助……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一定",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會毫不猶豫地回應我吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算是在洶湧的海浪中，",
    "voice": "vo_adv_1288004_054",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算呼嘯的暴風雨將至……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算是沒有勝算的戰鬥，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n即便如此，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也還是會盡你所能。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我竟會獲得一個能如此信任的人。",
    "voice": "vo_adv_1288004_055",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n若是和你相遇之前的我，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "肯定無法相信吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": "vo_adv_1288004_056",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我…………",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我以前一直",
    "voice": "vo_adv_1288004_057",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "認為自己身在水槽裡。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那或許只是我自認如此。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我並不是在對抗無法改變的命運，",
    "voice": "vo_adv_1288004_058",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而是其實",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在與你相遇時，早已在改變了……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "128800402"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵……",
    "voice": "vo_adv_1288004_059",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若真是那樣，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那可真是個滑稽。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我可能很久以前就越過我設想的高牆了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "極小的事件",
    "voice": "vo_adv_1288004_060",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會大幅改變未來，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這種現象是叫什麼呢……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……沒錯，",
    "voice": "vo_adv_1288004_061",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "蝴蝶效應。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過真虧",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你知道呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "最近讀的小說裡有出現，",
    "voice": "vo_adv_1288004_062",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為很有趣就記住了？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哦，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是被你誇獎到這種程度的作品，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那我稍微有點興趣呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咦？",
    "voice": "vo_adv_1288004_063",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你要借我嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天回程途中",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那還真是又……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很突然呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過……",
    "voice": "vo_adv_1288004_064",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是呢，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我就接受你的好意吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟我並不知道",
    "voice": "vo_adv_1288004_065",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼事會如何改變未來……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "況且，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不論是怎樣不明確的未來，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n至少你會陪在我身邊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1288004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有做一場好夢嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然你大概沒有自覺，",
    "voice": "vo_adv_1288004_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但在這個世上，有很多人因為你而改變了喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "與誰相遇、",
    "voice": "vo_adv_1288004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "並建立羈絆……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也有人被你一直以來所做的事",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拯救了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這一點",
    "voice": "vo_adv_1288004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正像蝴蝶拍動翅膀一樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n儘管是瑣碎的契機……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也會慢慢",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "引起改變未來的連鎖反應。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "既然無法看透未來，",
    "voice": "vo_adv_1288004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那就只能相信現在覺得",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最好的道路並前進了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最終",
    "voice": "vo_adv_1288004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能說服自己的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就只有自己……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怜或許已經",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "知道這一點了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，",
    "voice": "vo_adv_1288004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當你繼續幫助一個個女孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n如果是你，或許連世界都能拯救。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這並不是玩笑，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在我就是這麼想的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "加油喔♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……",
    "voice": "vo_adv_1288004_073",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我不小心睡著了嗎……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我總是一直被你幫助呢。",
    "voice": "vo_adv_1288004_074",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不對，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "並不只有你。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不論是優衣教我的料理，",
    "voice": "vo_adv_1288004_075",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "向日和學到的積極，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "從祖父那裡繼承來的劍，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有與志那都的修行……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一切交會在一起，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "才有了現在的我。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那是叫什麼呢……",
    "voice": "vo_adv_1288004_076",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總覺得我好像有夢到啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是那樣嗎……？",
    "voice": "vo_adv_1288004_077",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n總覺得是更不一樣的話……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": "vo_adv_1288004_078",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個情況，那句話可能也適用。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……與你的相遇，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對我而言就是嶄新之風呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然如此，",
    "voice": "vo_adv_1288004_079",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓我們持續吹起新的風吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n畢竟好不容易才獲得了風的屬性之力呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了，",
    "voice": "vo_adv_1288004_080",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們快點和大家會合後出發吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n向著",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你與我們的新冒險！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，得到了新力量的怜，以愉快的表情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和{0}一起面對未知的冒險。",
    "voice": null,
    "unit_id": null
  }
]
