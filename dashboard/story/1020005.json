  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美美與{0}\\n為了尋找兔子而外出了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": "vo_adv_1020005_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "只要這樣模仿兔子先生的叫聲，",
    "voice": "vo_adv_1020005_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "兔子先生就不會怕我們了呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥也試試看～！",
    "voice": "vo_adv_1020005_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔哇～！",
    "voice": "vo_adv_1020005_003",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，學得很像、很像～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒事的喔～",
    "voice": "vo_adv_1020005_004",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥一定會是一隻可愛的兔子先生～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，和美美一起做吧～",
    "voice": "vo_adv_1020005_005",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1020005_006",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這樣的話，兔子先生就會立刻出現了吧？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美呢～如果見到兔子先生的話，",
    "voice": "vo_adv_1020005_007",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n一定要盡情地撫摸牠～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好想快點見到兔子先生呀～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "毛茸茸、毛茸茸、兔子先生～♪",
    "voice": "vo_adv_1020005_008",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n快點出現吧，蹦蹦跳～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！哥哥，你聽見了嗎？",
    "voice": "vo_adv_1020005_009",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "現在的聲音是兔子先生的叫聲呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是從森林那裡傳來的。",
    "voice": "vo_adv_1020005_010",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們過去看看吧～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，",
    "voice": "vo_adv_1020005_011",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這邊這邊～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "兔子先生，等等～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！？",
    "voice": "vo_adv_1020005_012",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n是、是魔物！？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦！？",
    "voice": "vo_adv_1020005_013",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這個叫聲原來是魔物先生的聲音嗎……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不是兔子先生呀～",
    "voice": "vo_adv_1020005_014",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美還以為總算找到了呢……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n嗚嗚……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥，怎麼了？",
    "voice": "vo_adv_1020005_015",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n你說魔物先生的後面……？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――呱歐歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊～是兔子先生的叫聲！",
    "voice": "vo_adv_1020005_016",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n原來是小小格里芬先生的聲音呀～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠怎麼了呢～？",
    "voice": "vo_adv_1020005_017",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n小小格里芬先生一臉悲傷的表情呦～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美試著問牠看看喔～",
    "voice": "vo_adv_1020005_018",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦！？",
    "voice": "vo_adv_1020005_019",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "大、大事不好了，糟了～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠正在向我求救呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n這隻魔物先生似乎正在欺負牠。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "可以呦～♪",
    "voice": "vo_adv_1020005_020",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美就是知道牠應該是在說這件事～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是真的呦～！",
    "voice": "vo_adv_1020005_021",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，哥哥也來聽聽看吧～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對吧？",
    "voice": "vo_adv_1020005_022",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n「好可怕～！救救我～！我會被吃掉的～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美、哥哥～！」",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠是這麼說的吧？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們得幫幫小小格里芬先生才行！",
    "voice": "vo_adv_1020005_023",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "魔物先生雖然很可怕……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但是欺負別人是不對的～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥也要幫忙嗎？",
    "voice": "vo_adv_1020005_024",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝哥哥～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們一起幫幫小小格里芬先生吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太好了～！",
    "voice": "vo_adv_1020005_025",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n魔物先生逃走了～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為哥哥一起幫忙的關係，",
    "voice": "vo_adv_1020005_026",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n所以美美也很努力呦～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這樣小小格里芬先生就可以放心了吧～",
    "voice": "vo_adv_1020005_027",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～♪",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊哈哈，",
    "voice": "vo_adv_1020005_028",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好癢呀～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n但是牠全身毛茸茸、軟綿綿的～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n摸起來真舒服～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是得到幫助的小小格里芬也因此非常親近美美。",
    "voice": null,
    "unit_id": null
  }
]
