  {
    "type": "dialogue",
    "name": "千惠",
    "words": "哇啊，",
    "voice": "vo_adv_4010218_000",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好時髦的店。",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我感覺到了種沉穩成熟？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "的氛圍！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "騎士先生要點什麼？",
    "voice": "vo_adv_4010218_001",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "蛋糕跟瑪芬全都很可愛喔♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "咦？",
    "voice": "vo_adv_4010218_002",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n這是、",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "整塊大蛋糕？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "哇啊……",
    "voice": "vo_adv_4010218_003",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "哇啊～！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "騎士先生♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "騎士先生能幫我祝賀啟動日，",
    "voice": "vo_adv_4010218_004",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n我非",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "常開心♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "……啊，",
    "voice": "vo_adv_4010218_005",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "難道現在的我，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n連蛋糕都能吃下去了嗎！？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我很憧憬",
    "voice": "vo_adv_4010218_006",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "吃蛋糕呢！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "平常都沒辦法吃，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n即使吃了也只能靠數值理解味道。",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "事不宜遲……",
    "voice": "vo_adv_4010218_007",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我開動了──！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "啊嗯。",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "～～～～！",
    "voice": "vo_adv_4010218_008",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "真好吃～♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n大家都是吃這麼甜又美味的蛋糕",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n來慶祝生日的啊！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "不光是蛋糕，",
    "voice": "vo_adv_4010218_009",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "還有禮物啊？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "嗯──",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "要什麼呢？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n說到禮物，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "果然──",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "還是想要跟騎士先生擁抱！",
    "voice": "vo_adv_4010218_010",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "movie",
    "movie_id": "401016401"
  },
  {
    "type": "background",
    "bg_id": "509015"
  },
  {
    "type": "background",
    "bg_id": "510352"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "辛苦了。",
    "voice": "vo_adv_4010218_011",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n跟你一起，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "工作果然就會很順。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是種",
    "voice": "vo_adv_4010218_012",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "效率可以提升二、三倍的感覺吧。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "成果超乎我的預期，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是幫了我大忙。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n而且總覺得你今天特別有幹勁呢。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是，",
    "voice": "vo_adv_4010218_013",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你為什麼突然說要幫我工作？",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難道是零用錢花光了？",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "受",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不了，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不能這樣啦，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要好好節制啊。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦……？",
    "voice": "vo_adv_4010218_014",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今天的確",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是我的生日……",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你是為了我",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "才這麼賣力工作的啊？",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝、",
    "voice": "vo_adv_4010218_015",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總覺得",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很不好意思。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也可以不那麼努力，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "更輕鬆地慶祝啊……",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_4010218_016",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "什麼意思嘛。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這種甜言蜜語只對我",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有用喔。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……本來",
    "voice": "vo_adv_4010218_017",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "工作後就該趕緊",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "回家的……",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但畢竟今天是特別的日子，",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "浪費一下時間也沒關係吧。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": "vo_adv_4010218_018",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為了能完整收下你的努力。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n接下來就單獨",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來開個生日宴會吧。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_4010218_019",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n那",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接下來的護送",
    "voice": "vo_adv_4010218_020",
    "unit_id": 104833
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就交給你囉♪",
    "voice": null,
    "unit_id": 104833
  }
]
