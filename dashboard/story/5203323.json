  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這股從我身體裡發出的力量！！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "把我們這份火熱之心！",
