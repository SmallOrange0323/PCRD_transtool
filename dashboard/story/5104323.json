    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺終於要一決勝負了呢……！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為被逼到絕境，",
    "voice": "vo_adv_5104323_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "敵人也提起幹勁了啊。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一旦陷入背水一戰的局面，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就會讓人湧現出不容小覷的力量。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是",
    "voice": "vo_adv_5104323_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "克莉絲提娜姐姐我一定會超越那股力量的。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n高潮時刻到了，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來讓這場戲碼落幕吧！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也會超越自己的極限的！",
    "voice": "vo_adv_5104323_003",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要用超過100％的",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "1000％真本事！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n開創出屬於大家的未來！",
    "voice": null,
    "unit_id": 123911
  }
