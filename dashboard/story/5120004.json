  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "──您注意到我了嗎。",
    "voice": "vo_adv_5120004_092",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "為了不讓魔力洩漏出來，",
    "voice": "vo_adv_5120004_093",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "我明明很謹慎地隱藏著……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "然而似乎是對伊莉亞大人強大的魔力起了反應呢。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "真不愧是",
    "voice": "vo_adv_5120004_094",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "伊莉亞大人呢。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "布拉德現身在發現可疑地下洞窟的伊莉亞一行人面前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n臉上表情仍舊從容不迫的他，注視著伊莉亞。",
