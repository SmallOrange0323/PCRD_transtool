  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……應該就是這裡了是也。",
    "voice": "vo_adv_4010199_000",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天，",
    "voice": "vo_adv_4010199_001",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "被人放在學校鞋櫃裡的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "老舊信封。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "上頭寫著，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要在這裡等待……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這一定是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "挑戰書是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗯嗯！",
    "voice": "vo_adv_4010199_002",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來者何人！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n還不快點現身，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你這可疑人士！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咕、",
    "voice": "vo_adv_4010199_003",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咕啊！？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒想到我會",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在這種地方被打敗，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太遺憾了，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是也……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……呼～！",
    "voice": "vo_adv_4010199_004",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不愧是將軍！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n真是出色的隱身術是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這封信",
    "voice": "vo_adv_4010199_005",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "果然是將軍放的嗎？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難道說為了叫我出來，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你特地",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "跑到了我的學校是也？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哦──！",
    "voice": "vo_adv_4010199_006",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你居然記得我的生日是也──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n居然能夠實際體驗戰死來作為",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "生日禮物，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我真是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太感動了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咦？",
    "voice": "vo_adv_4010199_007",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不只這樣？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "剛剛",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "殺死我的刀……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n難道說，這個",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要送給我……！？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呼～！",
    "voice": "vo_adv_4010199_008",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n沒想到能從將軍那裡",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "獲贈一把刀……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n製作得好精細，簡直就像真的一樣，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好美麗是也……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "決定了！",
    "voice": "vo_adv_4010199_009",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要用這把刀",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來永遠守護",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來吧，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天我們兩個就這樣",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "直接",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "到街上漫步是也！",
    "voice": null,
    "unit_id": 103031
  }
]
