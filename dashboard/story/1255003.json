[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "透過在洞窟的冒險，吉塔不只得到了新的轉換職業的力量，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n還磨練了作為冒險者的心態。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天她和{0}一起在街上散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "抱歉喔，",
    "voice": "vo_adv_1255003_000",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明明是我要買東西卻讓你幫忙。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我一投入在騎空團的活動中，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n就完全忘了要補充",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "食材跟日用品之類的了啊……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "必須要買的是牛奶、",
    "voice": "vo_adv_1255003_001",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "清潔劑，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "其他還有……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呀",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "啊，好痛痛……",
    "voice": "vo_adv_1255003_002",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不好意思……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n因為很著急，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "一不小心就撞到妳了……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不會，",
    "voice": "vo_adv_1255003_003",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我自己才是疏忽了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對不起！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過，婆婆，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳這麼慌張是怎麼了嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "其實我家老頭子昨天就去山裡打獵了，",
    "voice": "vo_adv_1255003_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n但到了今天早上也沒回來啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "他明明一直都是即使過夜，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "也會在天亮時回來的……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我在想",
    "voice": "vo_adv_1255003_005",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "他該不會是遭遇事故了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n現在正要去【王宮騎士團】找人商量。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是這樣啊……",
    "voice": "vo_adv_1255003_006",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……嗯！",
    "voice": "vo_adv_1255003_007",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你果然",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也是一樣的心情吧？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n畢竟要搜山的話，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "人手多一點也比較好。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "婆婆，",
    "voice": "vo_adv_1255003_008",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳不介意的話，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也讓我們幫忙找爺爺吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳知道",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "他平時都是在哪一帶打獵嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我想想，",
    "voice": "vo_adv_1255003_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "他有對我說，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "萬一他出了什麼事就看這張地圖……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n他說過他不會",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "在做標記以外的地方打獵。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來如此……",
    "voice": "vo_adv_1255003_010",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "他就在這個標記位置的某處吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……嗯，",
    "voice": "vo_adv_1255003_011",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我大致記住標記的地點了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "整理一下裝備，先朝山上前進！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n婆婆就去【王宮騎士團】那裡……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "謝謝妳……",
    "voice": "vo_adv_1255003_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n請你們",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "要多加小心。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這裡",
    "voice": "vo_adv_1255003_013",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是爺爺遇難的山吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "積了相當多雪，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n他果然是被捲入事故中了嗎……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "總之，",
    "voice": "vo_adv_1255003_014",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "因應寒冷的對策是必要的吧！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……嘿！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼，",
    "voice": "vo_adv_1255003_015",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "轉換職業完成！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我也已經開始習慣",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "變成這副模樣了啊。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "接下來，",
    "voice": "vo_adv_1255003_016",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是用魔法生火……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n如果生大火會很危險，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以這種程度就夠了吧。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n雖說會變得看起來像是遊魂一樣就是了。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "讓這個火苗",
    "voice": "vo_adv_1255003_017",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "跟在我們身邊。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我想這樣就能在",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "免於凍傷的情況下搜索爺爺了。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這都是多虧了",
    "voice": "vo_adv_1255003_018",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "和你一起累積各種經驗的關係喔。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果只有自己一個人，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想我一定無法成長到這個地步。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "特別是上次的冒險，",
    "voice": "vo_adv_1255003_019",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "多虧了你和戰士先生他們，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我也學到了重要的事。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n必須不忘持續實踐才行。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不可以吃喔！？",
    "voice": "vo_adv_1255003_020",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這可是火球啊！？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你肚子很餓……？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這麼說來，",
    "voice": "vo_adv_1255003_021",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "他所屬的是名為【美食殿堂】的公會吧？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然從名字聽來是跟食物有關的公會，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n但平時就是什麼都會放進嘴裡嗎……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……那麼，",
    "voice": "vo_adv_1255003_022",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "再重述一遍。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n以地圖上有標記的地點為中心來找找看吧。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n得盡早找到爺爺保護他才行！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "爺爺──",
    "voice": "vo_adv_1255003_023",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你在嗎～！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n在的話請回答～！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n婆婆",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "很擔心你喔～！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也不在這裡嗎……",
    "voice": "vo_adv_1255003_024",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n其他有標記的地方都已經調查完了，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n要是在這裡找不到的話……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "有人在嗎～！",
    "voice": "vo_adv_1255003_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n我在這～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "幫幫我～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是爺爺的聲音嗎！？",
    "voice": "vo_adv_1255003_026",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n去看看吧！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "呼，",
    "voice": "vo_adv_1255003_027",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "有人來我就放心了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "妳",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "是來找我的嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n看起來不像是【王宮騎士團】啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然我們不是【王宮騎士團】，",
    "voice": "vo_adv_1255003_028",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n但我們是來找爺爺的沒錯。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "婆婆很擔心你，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以我們一起回去吧。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "我是很想那麼做，",
    "voice": "vo_adv_1255003_029",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n但其實我的腳受傷了啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n因為這樣，我的行動很不方便。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "幸好，",
    "voice": "vo_adv_1255003_030",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "為了預防遇難，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n我有帶生火的道具和簡易的帳篷來。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n我就是靠這個在救援來之前堅持住的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來是這樣啊。",
    "voice": "vo_adv_1255003_031",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我看看，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "傷口……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n看樣子",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "應該是不會危及生命的傷……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "吧？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但",
    "voice": "vo_adv_1255003_032",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你的臉色不太好……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n就體力上來說，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "感覺也很難讓你自行走路。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你沒問題嗎？",
    "voice": "vo_adv_1255003_033",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n爺爺的個子不高，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以我也能跟你輪流……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我有",
    "voice": "vo_adv_1255003_034",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "屬於我的任務？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n像是用魔法取暖，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還有在魔物靠近時把它們趕跑……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯，",
    "voice": "vo_adv_1255003_035",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n那",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就由我來引路下山吧。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n爺爺就交給你了喔。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不好意思呢。",
    "voice": "vo_adv_1255003_036",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n麻煩你們了啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿咻。",
    "voice": "vo_adv_1255003_037",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "目前",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們下山的步調很好呢。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n應該已經到一半左右了吧？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是能",
    "voice": "vo_adv_1255003_038",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "以這個節奏下到山腳……",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "哎呀，",
    "voice": "vo_adv_1255003_039",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "糟了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "你們看天空。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n明明還沒到傍晚，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "但天空卻開始變暗了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n暴風雪要來了喔！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "background",
    "bg_id": "500543"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真、",
    "voice": "vo_adv_1255003_040",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真的開始下暴風雪了！？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n勉強前進會很危險，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以先暫時躲到岩石後吧！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "幸好",
    "voice": "vo_adv_1255003_041",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我保險起見有確實帶著柴火等等的過來呢。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我已經把火移過去，可以取暖了，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以暫時是沒問題吧。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "嗯……",
    "voice": "vo_adv_1255003_042",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "唔……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不好意思啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "要是沒有我，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "你們已經能趕快下山了吧……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們就是來幫助爺爺的。",
    "voice": "vo_adv_1255003_043",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n只有我們自己下山這種事我們辦不到。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請你不要在意。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "爺爺",
    "voice": "vo_adv_1255003_044",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "已經明顯到達極限了。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n雖然我們無法在這場暴風雪中下山，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但要是一直在這裡等，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "可能就來不及了……！　",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "妳啊，",
    "voice": "vo_adv_1255003_045",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "真的很不會掩飾呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "看樣子這似乎",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "也是我該離開的時候了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你在說什麼！",
    "voice": "vo_adv_1255003_046",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我絕對會帶你回家的，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請不要放棄！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "正因為我一直以來都是在山裡度過的，",
    "voice": "vo_adv_1255003_047",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "所以我已經有所覺悟了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "無望的時候，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不論做什麼",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "都沒用啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "但，",
    "voice": "vo_adv_1255003_048",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "並不是連你們都要配合這個覺悟。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n接下來一旦天氣緩和，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "你們就把我留在這裡下山吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n要是背著拖油瓶走，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "你們可能又會被捲入暴風雪。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那種事",
    "voice": "vo_adv_1255003_049",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我做不到！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n一定會有方法的，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以請你相信我！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "哈哈，",
    "voice": "vo_adv_1255003_050",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "以現今年輕人來說，妳可真有毅力……",
    "voice": null,
    "unit_id": 511
  },
  {
