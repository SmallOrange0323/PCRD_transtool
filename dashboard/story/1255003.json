  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有幫上忙真是太好了！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那麼，",
    "voice": "vo_adv_1255003_077",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們也回去吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n婆婆一定",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一邊擔心，一邊在等著我們嘛。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "老頭子……！",
    "voice": "vo_adv_1255003_078",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "你沒事",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "真是太好了！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "抱歉讓妳擔心了啊，",
    "voice": "vo_adv_1255003_079",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "老婆子。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "雖然給很多人添了麻煩，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "但我總算是回來了啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "婆婆",
    "voice": "vo_adv_1255003_080",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "看起來真的很開心呢。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是你那時",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有對我說要用魔法通知【王宮騎士團】位置，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n可能就不會是這樣了。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我這次也",
    "voice": "vo_adv_1255003_081",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "受到你的幫助了。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真的很謝謝你",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有你陪著我。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "妳還是一樣挺行的嘛。",
    "voice": "vo_adv_1255003_082",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "想起各種事",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "讓我的心情很複雜也是事實……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "心情很複雜……？",
    "voice": "vo_adv_1255003_083",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你知道我的名字呢？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們有在哪裡見過……？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "我是之前向妳提出決鬥的山賊頭目啦。",
    "voice": "vo_adv_1255003_084",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "\\n我按照約定「轉換職業」了，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "在【王宮騎士團】工作。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦……",
    "voice": "vo_adv_1255003_085",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊──！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是那時候的！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我確實是覺得有聽過你的聲音，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n但那個～",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你是不是",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "瘦了很多啊？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "因為團長的訓練相當嚴苛啊……",
    "voice": "vo_adv_1255003_086",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "多虧如此，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "我的體態變得相當健康啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來【王宮騎士團】……",
    "voice": "vo_adv_1255003_087",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有那麼嚴格啊……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "當然，",
    "voice": "vo_adv_1255003_088",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "其他人也都有確實成為王宮騎士了喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "\\n我們能從事正當的工作，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "都是因為有小姑娘妳的勸告。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "\\n今後也",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "前山賊頭目",
    "words": "請小姑娘妳繼續保持這樣吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……好的！",
    "voice": "vo_adv_1255003_089",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在成功救助遇難者的同時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n吉塔與{0}跟意想不到的人物重逢了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她離開現場時，前山賊頭目的話語也為她帶來了勇氣。",
    "voice": null,
    "unit_id": null
  }
]
