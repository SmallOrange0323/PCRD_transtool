    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不、",
    "voice": "vo_adv_5102000_072",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不不不！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不管是",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "遊戲、",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "漫畫",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還是魔法少女！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我都絕對不會喜歡上的！",
