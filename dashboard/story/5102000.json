    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔嗯唔嗯……",
    "voice": "vo_adv_5102000_069",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n智閣下是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這種類型的人嗎。",
