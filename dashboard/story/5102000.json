  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "教起來應該會很有成就感呢！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小七七香、",
