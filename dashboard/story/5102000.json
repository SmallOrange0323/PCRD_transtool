    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我已經決定要為劍術而活了啊……！　",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……雖、",
    "voice": "vo_adv_5102000_068",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我並不喜歡什麼魔法少女。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是這是為了任務，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我姑且",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "聽聽看吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
