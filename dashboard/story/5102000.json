[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──蘭德索爾的人們最近十分浮躁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這是因為「蘭德索爾文化祭」就快要到來了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這樣浮躁的人也存在於【王宮騎士團】中……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "……我說啊。",
    "voice": "vo_adv_5102000_000",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "這次的蘭祭，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n你決定要從哪開始逛了嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n我打算",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "以遊戲展示會為主喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "其實",
    "voice": "vo_adv_5102000_001",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "我這次有報攤，然後抽中攤位了啊。",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "正在畫新刊……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "目前",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "處於趕稿修羅場之中。",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "真的嗎。",
    "voice": "vo_adv_5102000_002",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "你要擺攤啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "感覺很辛苦呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n是說，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "你畫了什麼同人誌啊？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "是原創作品喔。",
    "voice": "vo_adv_5102000_003",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n內容是主角以成為頂尖直播主為目標，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n努力做遊戲實況的故事……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前輩們，",
    "voice": "vo_adv_5102000_004",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "現在正在巡邏中不是嗎？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "同人誌的話題",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就等你們下班之後再聊吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "哎呀，",
    "voice": "vo_adv_5102000_005",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "小智妳",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "真的很認真呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前輩過獎了。",
    "voice": "vo_adv_5102000_006",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n身為【王宮騎士團】團員這是理所當然的。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "為了守護人們，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "必須先遵守紀律才行。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "是啊，",
    "voice": "vo_adv_5102000_007",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "妳說的對。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "我因為蘭祭近了而有些鬆懈了呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n……啊，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "對了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "我想起來了，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "團長在找小智喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純找我……？",
    "voice": "vo_adv_5102000_008",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "她好像",
    "voice": "vo_adv_5102000_009",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "是要拜託小智執行特別的任務的樣子。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "詳情妳就去問團長吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "謝謝你告訴我這件事。",
    "voice": "vo_adv_5102000_010",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這附近的巡邏",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就拜託你們了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "了解。",
    "voice": "vo_adv_5102000_011",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "好啦，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "我們也向小智看齊，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n認真工作吧。",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "就是說啊。",
    "voice": "vo_adv_5102000_012",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "同人誌",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "如果畫不完就跟我說吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n如果是塗黑或是貼網點的話，我能幫忙喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "嗯，",
    "voice": "vo_adv_5102000_013",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "那，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "可以請你今天就來幫忙嗎？",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "\\n我一個人看不到終點，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員2",
    "words": "已經三晚沒睡了……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "……你今天",
    "voice": "vo_adv_5102000_014",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "要好好睡覺喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是的。",
    "voice": "vo_adv_5102000_015",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就算祭典快要到了，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n大家也太興奮過頭了吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102000_016",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "同人誌",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗎。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那種東西……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那種東西……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我好想讀……！",
    "voice": "vo_adv_5102000_017",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好想讀讀看！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我至今都沒有讀過任何一本同人誌啊！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "大家",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都畫了怎樣的漫畫啊？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我好在意……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "蘭祭上",
    "voice": "vo_adv_5102000_018",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也會舉辦新遊戲的展示會吧？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我好想去喔……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我之前就對",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "格鬥遊戲之類的有興趣了！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "RPG跟棒球遊戲感覺也很有趣啊！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……啊！",
    "voice": "vo_adv_5102000_019",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這樣",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不行！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我要振作一點……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這是我自己決定的……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我不會對遊戲或漫畫這類的興趣出手……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是【王宮騎士團】的團員，",
    "voice": "vo_adv_5102000_020",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也是歷史悠久的御久間流的繼承人。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我還不夠成熟……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以",
    "voice": "vo_adv_5102000_021",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我沒時間投入到劍術以外的地方。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然我對遊戲跟同人誌",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都有興趣……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是為了將劍之道登峰造極，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不能隨便繞遠路。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102000_022",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還有，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我也要注意不能被人發現",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我喜歡魔法少女這件事。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102000_023",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然很遺憾，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是如果跟別人說我喜歡魔法少女，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可能會有人說",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我很孩子氣之類的。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "身為肩負責任的人，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不能被人小看啊……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102000_024",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不對。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比起這個……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n純她在找我。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要快點過去才行……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨，",
    "voice": "vo_adv_5102000_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳來啦。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n事情妳已經聽說了吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是的，",
    "voice": "vo_adv_5102000_026",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我聽前輩說了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n他說",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳有任務要交給我執行。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5102000_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想把跟「蘭德索爾文化祭」有關的任務",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "交給小智負責。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "蘭祭的任務……？",
    "voice": "vo_adv_5102000_028",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那是",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼任務……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近整個蘭德索爾，",
    "voice": "vo_adv_5102000_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n流行著應用通訊魔法進行的動畫實況……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正如小智所知，",
    "voice": "vo_adv_5102000_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n發生了多起人氣直播主被攻擊的事件。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……就是那個",
    "voice": "vo_adv_5102000_031",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "「直播主獵人」對吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然被害者們沒有生命危險，",
    "voice": "vo_adv_5102000_032",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是不幸中的萬幸……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是聽說很多被襲擊的人都終止實況了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那也難怪。",
    "voice": "vo_adv_5102000_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "事件對他們造成很大的心靈創傷吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……不能再繼續",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "放任加害者製造下一個受害者了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "犯人是會做這種過激行動的人。",
    "voice": "vo_adv_5102000_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n他有可能盯上參加文化祭的人氣直播主。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想拜託小智當某個人的護衛。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "某個人……？",
    "voice": "vo_adv_5102000_035",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這次",
    "voice": "vo_adv_5102000_036",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想交給小智的任務。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "內容是──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──當超人氣直播主",
    "voice": "vo_adv_5102000_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小輝美的護衛。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要我當",
    "voice": "vo_adv_5102000_038",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "輝美小姐的……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "護衛嗎！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": "vo_adv_5102000_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳知道",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小輝美是誰嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "當然知道。",
    "voice": "vo_adv_5102000_040",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然我沒看過她的直播……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但是她是實況遊戲之類的有名人吧？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我聽說",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她是蘭德索爾現在",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "最有人氣的直播主。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5102000_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這次文化祭上，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小輝美",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "預計會參加訪談活動和遊戲活動。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我希望小智",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳能保護她。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼樣？",
    "voice": "vo_adv_5102000_042",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳願意接這個任務嗎，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我願意，",
    "voice": "vo_adv_5102000_043",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "請交給我吧！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我一定",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會保護輝美小姐的！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5102000_044",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "拜託妳了喔……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說回來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智妳",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "熟悉遊戲、漫畫",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "跟實況之類的東西嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不……",
    "voice": "vo_adv_5102000_045",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我幾乎不懂。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然我有興趣……",
    "voice": "vo_adv_5102000_046",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是因為我",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "避免接觸那些東西，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n所以不是很清楚啊……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果是關於魔法少女的話題，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我可以說個不停就是了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5102000_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "果然是這樣嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟我沒聽過小智講過",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關於遊戲的話題呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以我已經請了",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對次文化很詳細的老師來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_5102000_048",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "次文化的老師……！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n為什麼要請那種人……！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "文化祭是",
    "voice": "vo_adv_5102000_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會舉辦同人誌販售會、遊戲展示會、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還有LIVE舞台等活動的祭典。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然是護衛任務，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是既然都跟文化祭有關，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "加深對它們的理解很重要吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且，",
    "voice": "vo_adv_5102000_050",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "理解護衛對象，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在執行任務上也是件很重要的事情啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……就是這樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "老師，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "拜託妳們了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有人喊我就蹦出來鏘鏘鏘鏘～！",
    "voice": "vo_adv_5102000_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼……！？",
    "voice": "vo_adv_5102000_052",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳們是……！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我是",
    "voice": "vo_adv_5102000_053",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "魔法少女七七香！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這位是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "黑貓小鈴！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "誰是黑貓啊。",
    "voice": "vo_adv_5102000_054",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是松鼠啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那不重要就是了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純，",
    "voice": "vo_adv_5102000_055",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這到底是……！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說到【暮光流星群】的收藏家，",
    "voice": "vo_adv_5102000_056",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n她對遊戲之類的",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "次文化造詣深厚很是出名的呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我覺得她是適合的人選，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以就拜託她",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "來幫小智上課。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀──",
    "voice": "vo_adv_5102000_057",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我在公會小屋跟鈴閣下玩著遊戲的時候，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n【王宮騎士團】的團長突然跑來了啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的嚇我一大跳啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "害我以為",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「我要被逮捕了！？」",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是，",
    "voice": "vo_adv_5102000_058",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在聽她解釋之後，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我覺得很有趣所以就接下任務了～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會好好教智閣下",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "很多宅宅知識喔～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "先不說那個，",
    "voice": "vo_adv_5102000_059",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼連我都要當講師啊？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n七七香一個人就夠了吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我覺得我比較適合當",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在旁邊滾來滾去耍廢的角色啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5102000_060",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有什麼關係嘛！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這絕對會很有趣的！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n而且這樣",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不定",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "能讓玩遊戲的夥伴增加喔？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "玩遊戲的夥伴……！？",
    "voice": "vo_adv_5102000_061",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果能有那種夥伴感覺會很有趣呢！",
    "voice": "vo_adv_5102000_062",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我有",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "繼承御久間流的使命！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不能分心到……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "遊戲上……！　",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我、",
    "voice": "vo_adv_5102000_063",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我對",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "遊戲什麼的沒興趣啦。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔～？",
    "voice": "vo_adv_5102000_064",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n在體會到遊戲的魅力後，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳還有辦法這麼說嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後",
    "voice": "vo_adv_5102000_065",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不只是遊戲而已喔。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我也會好好為妳解說",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "魔法少女之類的魅力喔！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼，",
    "voice": "vo_adv_5102000_066",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "魔法少女……！！？",
