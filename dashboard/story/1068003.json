    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "反而就是要味道普通才能入口！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我雖然覺得可麗餅是個很深奧的東西，",
    "voice": "vo_adv_1068003_048",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但多虧少年，我才能像現在這樣注意到這件事。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "抱歉。",
    "voice": "vo_adv_1068003_049",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "說了這麼多，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "結果還是讓你幫忙我到這種時間。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n今天都讓你一直在幫我忙，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "至少讓我送你回去吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是晚上回去發生什麼萬一也會很困擾，",
    "voice": "vo_adv_1068003_050",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而且我也希望",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "能讓大家吃吃看可麗餅啊♪",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": "vo_adv_1068003_051",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "食材也都準備好了，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話又說回來，",
    "voice": "vo_adv_1068003_052",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年你經歷了不少有趣的體驗吧？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n希望下次",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你能仔細地說給我聽聽呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……少年，",
    "voice": "vo_adv_1068003_053",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你能",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "幫我拿一下食材嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "請你暫時",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "乖乖待著別動。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是不清楚對方是誰，",
    "voice": "vo_adv_1068003_054",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但還真是不解風情。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "難得有機會能和少年親親熱熱的……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "OK，",
    "voice": "vo_adv_1068003_055",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我就來陪你玩玩吧。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我知道你在那裡，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "出來吧。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "「嘰、嘰」……",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原來如此，",
    "voice": "vo_adv_1068003_056",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "本人只負責隔岸觀火啊……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n目的是要偵察這裡的情況吧？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很遺憾。",
    "voice": "vo_adv_1068003_057",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "淑女的祕密",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可不能輕易洩漏給他人知道呢。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過，",
    "voice": "vo_adv_1068003_058",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我想你也不能空手而歸吧，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以你如果能傷到我，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那我就告訴你一個情報吧。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一決勝負！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "權能，",
    "voice": "vo_adv_1068003_059",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "解放！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "改變吧世界！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n──「迷宮生成！」",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "「嘰、嘰」……！",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "歡迎光臨。",
    "voice": "vo_adv_1068003_060",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這是將物件變更",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並再造所建構而成的，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的世界。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我以迷宮女王的身分歡迎你們。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在這裡",
    "voice": "vo_adv_1068003_061",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就能不必在意主人的命令",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "盡情戰鬥了吧？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n來～",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "放馬過來吧。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "姐姐我來陪你們玩玩！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……怎麼了？",
    "voice": "vo_adv_1068003_062",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "該不會是",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嚇破膽了？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n人偶總不可能會感到害怕吧？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "「嘰、嘰」……！",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "太慢了太慢了！",
    "voice": "vo_adv_1068003_063",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "攻擊要這樣做才對啊！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "……！",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "掰掰，",
    "voice": "vo_adv_1068003_064",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可憐的人偶們。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……這樣就行了，",
    "voice": "vo_adv_1068003_065",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是讓他們帶回任何一點情報就麻煩了，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我把他們和迷宮一起消滅掉了。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當然",
    "voice": "vo_adv_1068003_066",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒事啦，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓你擔心了呢。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……很抱歉把你捲進來。",
    "voice": "vo_adv_1068003_067",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你真的很溫柔呢，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "從那時候起就一直是……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正因為少年是這樣的人，",
    "voice": "vo_adv_1068003_068",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我才會覺得為此賭上性命也願意……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_1068003_069",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "礙事的傢伙都收拾掉了，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "前往公會小屋吧！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n得向大家展示一下我和少年",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一起做的新口味魔物可麗餅呢！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這次的目標不是少年，",
    "voice": "vo_adv_1068003_070",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而是我。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n今後對方也會盯著我來。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來我盡量到處去留下蹤影，",
    "voice": "vo_adv_1068003_071",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n把自己當成誘餌會比較好呢……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "放心吧，",
    "voice": "vo_adv_1068003_072",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "無論這之後的戰鬥會迎來什麼樣的結局，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我都一定",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "會成為你的力量。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成功阻止敵人襲擊的拉比林斯達，在內心重新下定決心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並與{0}一同走在夜晚的路上。",
    "voice": null,
    "unit_id": null
  }
]
