    "name": "男性１",
    "words": "就是說啊～！",
    "voice": "vo_adv_1170002_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳說得一點都沒錯！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n走吧，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "用我們熾熱的愛情",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "讓炎熱的夏天更加火熱吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "他們認為……",
    "voice": "vo_adv_1170002_007",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n……自己是這片海灘上……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "最相愛的人嗎……？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這也誤會得太離譜了……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為在那邊的臭蟲們講了莫名其妙的話",
    "voice": "vo_adv_1170002_008",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "，\\n我火氣都上來了……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n在這片沙灘上最相愛的人",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然是我和您了。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……既然如此，",
    "voice": "vo_adv_1170002_009",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們該做的事情就只有一件。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那就是讓臭蟲們",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "體會到這是天大的誤會……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也沒辦法了……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們去參加吧，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "司儀",
