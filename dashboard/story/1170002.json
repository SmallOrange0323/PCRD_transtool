  {
    "type": "dialogue",
    "name": "旁白",
    "words": "惠理子重新製作了媚藥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n帶著{0}來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來，",
    "voice": "vo_adv_1170002_000",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n去玩之前，先來塗防曬乳吧。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這次由我來幫您塗，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一定要……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一定要讓我來……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就算您想敷衍也沒用的……",
    "voice": "vo_adv_1170002_001",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您死心，讓我幫您塗吧……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "已經沒有要參加的人了嗎！？",
    "voice": "vo_adv_1170002_002",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n這是一年一度的",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "最佳情侶競賽！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n馬上就要截止報名囉～！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……最佳……",
    "voice": "vo_adv_1170002_003",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "情侶競賽……？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "要不要試著拿到第一名，",
    "voice": "vo_adv_1170002_004",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "在這片海灘證明",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n兩人之間的羈絆多麼強大，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "愛情又是何其深沉呢！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我們也去參加吧～！",
    "voice": "vo_adv_1170002_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n反正恩愛的我們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "一定能拿第一！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n輕輕鬆鬆♪",
