[
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了感謝主公大人的照顧，",
    "voice": "vo_adv_4012004_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請讓在下幫忙打掃。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼事不宜遲……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "掃啊掃，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "擦啊擦。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "唉──",
    "voice": "vo_adv_4012004_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可可蘿真能幹。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒想到她居然只跟彩羽差了一歲。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是另一個世界的事嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔……",
    "voice": "vo_adv_4012004_002",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "什麼嘛，小苑。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n比起彩羽，妳更喜歡可可蘿啊……",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯、",
    "voice": "vo_adv_4012004_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "幹嘛生氣？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "難道是吃醋了～？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……才不是，",
    "voice": "vo_adv_4012004_004",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n小苑這個笨蛋……",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "受不了，",
    "voice": "vo_adv_4012004_005",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我最喜歡的肯定是妳啊～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我給妳摸摸頭，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "過來這邊～？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……嗯。",
    "voice": "vo_adv_4012004_006",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_4012004_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位感情真好。",
    "voice": null,
    "unit_id": 105913
  }
]
