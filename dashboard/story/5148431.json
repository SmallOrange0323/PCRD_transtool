[
  {
    "type": "background",
    "bg_id": "500553"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "はぁ～……",
    "voice": "vo_adv_5134431_000",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nまったく、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "とんだ大晦日でしたよ！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n全然休んだ気がしねーです！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "本当に大忙しっていうか、",
    "voice": "vo_adv_5134431_001",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "大慌てで爆睡したよ～！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "こんなに必死に寝ようとしたの、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "人生で初めてかも。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "何一つ間違ったことは言ってないはずなのに、",
    "voice": "vo_adv_5134431_002",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nものすごくナンセンスなことを言ってるように聞こえるね……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "でも、",
    "voice": "vo_adv_5134431_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ハツネさんが頑張ってくれたおかげで、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nランドソルは救われたんだ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "改めてお礼を言わせてほしい、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ありがとう。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "ううん、",
    "voice": "vo_adv_5134431_004",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "私だけのがんばりじゃないよ。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "カスミンもイノリちゃんも、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "他のみんなも、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\nできることをいっぱい手伝ってくれたし……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "キミも、",
    "voice": "vo_adv_5134431_005",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "最後まで傍にいてくれたしね。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "すごく頼りになったよ、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "ありがとう♪",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "あ～、",
    "voice": "vo_adv_5134431_006",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こほん！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "さて、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "過去を振り返るのはこれくらいにして、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nそろそろ屋台を見て回るのはどうかな？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あっ、",
    "voice": "vo_adv_5134431_007",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そうですね！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n【自警団（カォン）】からの報酬もあるし、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n今財布に入ってるお金は使い切る勢いで",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "食べまくるですよ！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "ハツネちゃん、",
    "voice": "vo_adv_5134431_008",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "温かいものが食べたいな～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "ずっと寒いとこ歩いてて、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "凍えちゃいそうだもん。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "それじゃあ、",
    "voice": "vo_adv_5134431_009",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "たい焼きでも買おうか。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "助手くんも食べたいものがあれば、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "遠慮なく言ってくれたまえ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "おめでたい日なんだから、",
    "voice": "vo_adv_5134431_010",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n思いっきりみんなで楽しもうね！",
    "voice": null,
    "unit_id": 128411
  }
]
