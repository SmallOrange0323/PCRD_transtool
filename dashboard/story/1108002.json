  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖德蕾莎女學院 。\\n在這間充滿品行端正的良家子弟的學校裡，\\n一介平民的克蘿依常常和周圍顯得格格不入。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好燙！",
    "voice": "vo_adv_1108002_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "克蘿依？",
    "voice": "vo_adv_1108002_001",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n課上到一半，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "怎麼突然這樣。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108002_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒事！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n沒事沒事，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為手指有點弄到那個……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "妳現在",
    "voice": "vo_adv_1108002_003",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "偷偷藏了什麼東西吧。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n請拿出",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "桌子下的東西。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108002_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這個是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為想預習明天考試，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不小心就……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "捲軸――",
    "voice": "vo_adv_1108002_005",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "咒文的書卷嗎。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "我能理解",
    "voice": "vo_adv_1108002_006",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n妳對自己魔術的成績有些焦急，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "不過現在是",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "數學課。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "請妳自重。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是，",
    "voice": "vo_adv_1108002_007",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，不對，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的深感抱歉。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好危險，",
    "voice": "vo_adv_1108002_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好險沒事。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒有連捲軸的內容",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也一起被深究真是太好了――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……嗯？　",
    "voice": "vo_adv_1108002_009",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "妳有看到嗎，",
    "voice": "vo_adv_1108002_010",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "克蘿依的捲軸？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好像是",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "非常古老的術式的樣子……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "對，",
    "voice": "vo_adv_1108002_011",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "我也很在意呢……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "我記得那個",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "不就是在現代",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "被禁止的咒術嗎。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哇――",
    "voice": "vo_adv_1108002_012",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "被發現了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "根本完全穿幫了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "妳、",
    "voice": "vo_adv_1108002_013",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "妳說禁咒嗎？　",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "還真可怕。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n克蘿依真是的，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "為什麼要在學校裡這麼做……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "簡直是不良少女呢。",
    "voice": "vo_adv_1108002_014",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n被老師發現的話",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "可不是退學就能了事的呢。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108002_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且我，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不知為何好像，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "被那群孩子",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "莫名地害怕著啊――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，",
    "voice": "vo_adv_1108002_016",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然也是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂啦――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "――不，一點也不好。",
    "voice": "vo_adv_1108002_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好不容易能夠進這間學校，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "絕不能被退學。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "吶。",
    "voice": "vo_adv_1108002_018",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "噫，",
    "voice": "vo_adv_1108002_019",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "克蘿依！？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉，",
    "voice": "vo_adv_1108002_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可以聊一下嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n關於剛剛在課堂裡的事，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這裡有點不方便說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可以出來跟我去校區裡――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒、",
    "voice": "vo_adv_1108002_021",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒有！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我們、",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我們",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "什麼都沒看見唷！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "對，",
    "voice": "vo_adv_1108002_022",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "我們絕對不會",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "和老師報告",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "禁咒的事情！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "所以拜託，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "請原諒我們……！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": "vo_adv_1108002_023",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝謝啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "那、",
    "voice": "vo_adv_1108002_024",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "那麼我們，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "還有人在等著接我們！　",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "再會！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108002_025",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那就先這樣。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "小心一點。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "啊哇哇，",
    "voice": "vo_adv_1108002_026",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "怎麼辦才好……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n我們已經，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n被那個克蘿依",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "給盯上了啦！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "…………",
    "voice": "vo_adv_1108002_027",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "…………怎麼覺得",
    "voice": "vo_adv_1108002_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有種被誤會的感覺。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了……",
    "voice": "vo_adv_1108002_029",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "說到底，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也不是為了玩耍才來學校的？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n無所謂啦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎樣都好。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂啦……",
    "voice": "vo_adv_1108002_030",
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "克蘿依？",
    "voice": "vo_adv_1108002_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "\\n還好嗎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "學校那邊？　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "開心嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "\\n有交到，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的媽媽",
    "words": "很多朋友嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108002_032",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "馬馬虎虎啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n比起這個，媽媽，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不好好休息是不行的唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "好好喔",
    "voice": "vo_adv_1108002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姐姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "有好多朋友真好！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n我們長大之後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "也要去上學！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_1108002_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "上學很開心唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n所以大家也要，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當個乖孩子",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "努力用功念書才行呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "――雖然這麼說，",
    "voice": "vo_adv_1108002_035",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有什麼立場說呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_1108002_036",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "去打工吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "哦哦克蘿依，",
    "voice": "vo_adv_1108002_037",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "等妳很久囉。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "如何，",
    "voice": "vo_adv_1108002_038",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "妳幫我保管的捲軸狀況。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n應該有照我說的，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "幫我好好地",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "攤開來晾乾吧？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "店長，",
    "voice": "vo_adv_1108002_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "拜託饒了我吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這個在課堂中突然變燙",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的嚇死我了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "差點得跟你討",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "職災和",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "退學補助啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "因為上面塗滿了",
    "voice": "vo_adv_1108002_040",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "活跳跳魔物的腦脊髓液呢，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n偶爾發生這種事是正常的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "還真是場災難。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，笑什麼啦。",
    "voice": "vo_adv_1108002_041",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我可是很認真地在訴苦耶。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n為什麼搞得一副像是",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "校園荒唐事件一般。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你把我",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當作什麼了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "哦大叔，",
    "voice": "vo_adv_1108002_042",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "\\n剛剛提到的，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "禁咒的捲軸",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "是什麼？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "你在說什麼話，",
    "voice": "vo_adv_1108002_043",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "我可是不會經手違法的術具喔。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "這只是在旅途中",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "用來生點小火的日用品。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "話雖如此？",
    "voice": "vo_adv_1108002_044",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n只要一不留神",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "念錯一行咒文，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "驚人的噴射火焰",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "就會席捲而來？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "咕嘿嘿，",
    "voice": "vo_adv_1108002_045",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "那可真不得了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "\\n得小心，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "別不留神就",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "念錯某一行呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～",
    "voice": "vo_adv_1108002_046",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當作沒聽到",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當作沒聽到",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是沒救了的店。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "那麼大叔，",
    "voice": "vo_adv_1108002_047",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "那個",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "可愛的書卷",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的客人",
    "words": "就給我吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "嘿",
    "voice": "vo_adv_1108002_048",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "謝謝惠顧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "來教你",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "讀錯時的處理方法――",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "――唔，",
    "voice": "vo_adv_1108002_049",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "好像有新的客人上門了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "因為我這邊忙不過來，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "克蘿依，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "那邊就麻煩妳了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗨，",
    "voice": "vo_adv_1108002_050",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "歡迎光臨――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n歡迎來到點亮您生活色彩的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "『藍鬍子古物店』――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "――咦。",
    "voice": "vo_adv_1108002_051",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是之前的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好像是叫，{0}嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊。",
    "voice": "vo_adv_1108002_052",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你好。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，你是來做什麼的，",
    "voice": "vo_adv_1108002_053",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "在這種時間。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該不會是因為那個吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n又是和父母吵架想學壞的時期啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": "vo_adv_1108002_054",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你要這麼想是無所謂，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，最好還是多思考一下比較好吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我覺得這種沒救了的店，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好像",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不太適合你呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然有時的確會覺得父母或家裡的事很煩人，",
    "voice": "vo_adv_1108002_055",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過到最後，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這種東西還是自己的責任――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又來了啊。",
    "voice": "vo_adv_1108002_056",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，不過太好了，",
    "voice": "vo_adv_1108002_057",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這次能及時把話題停住。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "差點又要",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "衍生為冗長又感傷的對話呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說回來{0}，",
    "voice": "vo_adv_1108002_058",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n之前在酒館被打的傷……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊，",
    "voice": "vo_adv_1108002_059",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "太好了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好像沒事呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": "vo_adv_1108002_060",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為那件事學到教訓了吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n吶。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那樣的店，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別再去了好嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這種店也差不多糟。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦那算什麼，反駁？　",
    "voice": "vo_adv_1108002_061",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真囂張啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗚哇――，",
    "voice": "vo_adv_1108002_062",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這小孩般的純真眼神。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n啊這個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只是",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "單純的疑問啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_1108002_063",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是沒關係啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我因為一些個人原因之類的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是這麼一回事。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？　",
    "voice": "vo_adv_1108002_064",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該說是因為",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "需要錢嗎……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "主要是因為時薪很好不是嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這種的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有一些問題的店。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1108002_065",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "與其說我已經習慣了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不如說在這方面我比較無感。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n因為精靈族也是正在瀕臨消失的種族，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "天生就很頑強。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1108002_066",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n什麼意思",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "第一次被這樣說。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有點搞不懂。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，什麼意思，",
    "voice": "vo_adv_1108002_067",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "現在是在誇獎我嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n真的嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊這樣嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "順帶一提……",
    "voice": "vo_adv_1108002_068",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有去過獸人街",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之類的嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然，我沒去過就是。",
    "voice": "vo_adv_1108002_069",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n但是傳聞說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那裡啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n要是隨隨便便進去的話，很不妙喔。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你不知道嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "蘭德索爾這座城市，",
    "voice": "vo_adv_1108002_070",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "基本上雖然治安算好。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但是因為是大城鎮，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還是有極少地區",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是騎士團",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "監控不到的吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們家所屬的地區，也算在那種地帶。",
    "voice": "vo_adv_1108002_071",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "簡單來說？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n就是沒有受到什麼光鮮亮麗的優良教育啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大概是這樣，",
    "voice": "vo_adv_1108002_072",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是無所謂啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這種沒救的店也是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "如果能賺錢也就行了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是說……",
    "voice": "vo_adv_1108002_073",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我的父母，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "現在身體很虛弱。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然我們家的積蓄只要省吃儉用，似乎能過得下去，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但至少得靠自己解決學費啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": "vo_adv_1108002_074",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我姑且也算是妙齡少女。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也不是沒有想過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n在複製魔法這種光鮮亮麗的店家打工……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但說到底，",
    "voice": "vo_adv_1108002_075",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們學校本來就禁止打工。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以如果在老師之類的相關人士會去的地方打工的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n會有點危險吧？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是這麼一回事。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_1108002_076",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大概就是那樣吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "明白了嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "{0}，",
    "voice": "vo_adv_1108002_077",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好像是所謂的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n騎士？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "勇者？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "般的裝扮，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "看來應該是在很有教養的家庭裡被養育長大的孩子吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？　",
    "voice": "vo_adv_1108002_078",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼意思。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "記憶喪失？",
    "voice": "vo_adv_1108002_079",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然不太懂，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯～。",
    "voice": "vo_adv_1108002_080",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n雖然看起來沒有什麼煩惱，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不過你似乎也滿辛苦的呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，",
    "voice": "vo_adv_1108002_081",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "難怪啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊不，",
    "voice": "vo_adv_1108002_082",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我其實不是那種，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n會到處八卦地把別人隱私講出去的人啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是，",
    "voice": "vo_adv_1108002_083",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼說才好……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "{0}散發著奇妙的氣場呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n總覺得很脫線。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108002_084",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這算是",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "稱讚的話唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "嗯？",
    "voice": "vo_adv_1108002_085",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n什麼啊克蘿依，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "妳會笑啊，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "還真難得。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "這麼看來那個小夥子，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "道具店的店長",
    "words": "是妳的男人吧？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好噁心。",
    "voice": "vo_adv_1108002_086",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n雖然噁心，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但那不重要，你幫我顧店一下啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我，把這個迷路的傢伙，",
    "voice": "vo_adv_1108002_087",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n送到大路上再回來喔。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "欸{0}，要走囉。",
    "voice": "vo_adv_1108002_088",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊討厭，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "頭髮亂糟糟的啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真沒辦法……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "總體來說，克蘿依擁有很會照顧人的長女氣質。",
    "voice": null,
    "unit_id": null
  }
]
