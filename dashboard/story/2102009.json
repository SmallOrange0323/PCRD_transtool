    "words": "就無法",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "實現……",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳的",
    "voice": "vo_adv_2102009_031",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "願望……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是……？",
    "voice": "vo_adv_2102009_032",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
