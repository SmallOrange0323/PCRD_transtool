[
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩、",
    "voice": "vo_adv_5068301_000",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王……",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請聽我們說話！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n現在的你",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "誤會了跟小孩子的友情……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "閉嘴閉嘴閉嘴！",
    "voice": "vo_adv_5068301_001",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我是小孩子的朋友！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n無論今天、明天，還是後天，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我都要一直玩下去！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "照那個樣子看來，",
    "voice": "vo_adv_5068301_002",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "它並沒有把我們的話聽進去……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再爭論下去太沒有效率了。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很遺憾的，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們似乎只能戰鬥了……！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要跟那麼巨大的對象戰鬥嗎！？",
    "voice": "vo_adv_5068301_003",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們會被踩扁的喔〜！？",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "妳冷靜點，",
    "voice": "vo_adv_5068301_004",
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "碧。",
    "voice": null,
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "\\n只要同心協力，",
    "voice": null,
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "我們沒有辦不到的事情。",
    "voice": null,
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說、",
    "voice": "vo_adv_5068301_005",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "無敵好朋友號！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了說服玩具王，",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我會試著努力看看……！",
    "voice": null,
    "unit_id": 116713
  }
]
