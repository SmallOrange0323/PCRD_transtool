[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在神殿結束參拜的{0}與可可蘿，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了因為新年廟會而熱鬧非凡的繁華街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_1119002_000",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "參拜的內容",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是祕密。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算是主公大人，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也不能說。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為在下聽說，",
    "voice": "vo_adv_1119002_001",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若是說給別人聽，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "願望就不會實現了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以，",
    "voice": "vo_adv_1119002_002",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人也不可以說出來喔。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話又說回來，",
    "voice": "vo_adv_1119002_003",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明新年都快要結束了，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n卻還非常熱鬧呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼主公大人，",
    "voice": "vo_adv_1119002_004",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您肚子餓了嗎？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡有很多攤販，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若有任何想吃的東西，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請儘管告訴在下。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請別擔心錢的問題。",
    "voice": "vo_adv_1119002_005",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下從家鄉那裡領到了不少壓歲錢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_1119002_006",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來那邊",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎非常熱鬧呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人有興趣的話，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們就一起去看看吧。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "情侶（男）",
    "words": "是這裡嗎？",
    "voice": "vo_adv_1119002_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "就是這種感覺。",
    "voice": "vo_adv_1119002_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "\\n要慢慢地，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "慢慢地喔。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是……",
    "voice": "vo_adv_1119002_009",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雙人羽織啊。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有很多男女參加呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "哦，",
    "voice": "vo_adv_1119002_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那邊的小姐，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "你們有興趣嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n以雙人羽織的方式吃蕎麥麵，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "來考驗兩個人的羈絆。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "要是能夠吃完，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "就送你們可以在附近攤販",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "使用的折價券喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "啊啊！",
    "voice": "vo_adv_1119002_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "　就說不是那裡了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情侶（女）",
    "words": "\\n你認真點啦～！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊……",
    "voice": "vo_adv_1119002_012",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "麵被放到",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那位女性的鼻子裡了！",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是讓人同情……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "哈哈，",
    "voice": "vo_adv_1119002_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那對情侶不會長久呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那種人每年都很多，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "簡直要讓人看不下去了啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雙人羽織",
    "voice": "vo_adv_1119002_014",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "連這種事情都看得出來嗎？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "嗯，",
    "voice": "vo_adv_1119002_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "只要像我一樣長年",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "做這份工作，就看得出來喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "但是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "如果兩個人之間的羈絆是真實的，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "雙人羽織根本是小事一樁啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "糟糕，",
    "voice": "vo_adv_1119002_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "嚇到你們了嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不過……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "就我來看的話，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n我猜小姐你們兩位",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "一定能夠吃完蕎麥麵吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那麼，",
    "voice": "vo_adv_1119002_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "怎麼樣呢？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "要來展示一下",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "妳和這位小哥的羈絆嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們的羈絆嗎？",
    "voice": "vo_adv_1119002_018",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺似乎比想像中還困難……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您真有自信呢。",
    "voice": "vo_adv_1119002_019",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下被您那可靠的樣子",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給打動了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對您來說，雙人羽織的難度",
    "voice": "vo_adv_1119002_020",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "根本算不上什麼嗎？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟壓歲錢也有限，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個獎品確實是很吸引人……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是說呢，",
    "voice": "vo_adv_1119002_021",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若是在下和主公大人的話，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肯定不會有問題的。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1119002_022",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請讓我們也參加吧。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們會漂亮地",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "吃完這碗蕎麥麵的。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "好喔～！",
    "voice": "vo_adv_1119002_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "　就是該這樣才對嘛！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這是你們的羽織。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "在下一輪開始前，",
    "voice": "vo_adv_1119002_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "先決定好",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "誰坐前面、誰坐後面吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "要換你們上場時，我再叫你們！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身為『嚮導』，",
    "voice": "vo_adv_1119002_025",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就由在下來\\n確實地",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將蕎麥麵引導至",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人的嘴裡吧。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎還要再等一下",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才會輪到我們的樣子，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
