  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聚集了鈴奈等人的祈禱之力，晴神大人終於平安甦醒。\\n海灘變得晴空萬里，雨神大人也恢復了原本的模樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5019007_000",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難道他就是……？",
    "voice": "vo_adv_5019007_001",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉吉吉吉～～！！",
    "voice": "vo_adv_5019007_002",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "唔！",
    "voice": "vo_adv_5019007_003",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n早安！",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉、",
    "voice": "vo_adv_5019007_004",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我好想見你啊～！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了！",
    "voice": "vo_adv_5019007_005",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喚醒晴吉了呢！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哎呀，",
    "voice": "vo_adv_5019007_006",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只要交給我們，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "很快就沒事了啦！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "各位，",
    "voice": "vo_adv_5019007_007",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你們辛苦了。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今天我要幫你們畫特大的鼓勵小花！",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "你們那樣吵吵鬧鬧的在做什麼？",
    "voice": "vo_adv_5019007_008",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n我的頭還有點昏昏沉沉的……",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n感覺這次",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "好像有點睡過頭了呢？",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "而且，",
    "voice": "vo_adv_5019007_009",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "你說的晴吉",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "是什麼？",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "呵呵呵，",
    "voice": "vo_adv_5019007_010",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n那是鈴奈為我們",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "想的暱稱！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n鈴奈她呀，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "是我新結交的",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "人類朋友。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "她說是朋友的話，",
    "voice": "vo_adv_5019007_011",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "有個暱稱會比較好。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n所以說，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我叫雨吉！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "咦！",
    "voice": "vo_adv_5019007_012",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n妳就是鈴奈？",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n以一個人類來說，",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "妳還蠻有品味的嘛！",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈哈，",
    "voice": "vo_adv_5019007_013",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還好啦！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那個……",
    "voice": "vo_adv_5019007_014",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雨神大人……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "不對，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是雨吉，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "還有晴吉，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這次的事",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "實在很抱歉！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "……？",
    "voice": "vo_adv_5019007_015",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為晴吉之前在沉眠，",
    "voice": "vo_adv_5019007_016",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n看來你不知道",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "之前只有雨吉先甦醒了呢。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "無論如何，",
    "voice": "vo_adv_5019007_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我們已經體會到",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "自己有多麼自私了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "像這樣的事情，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "不會再讓它發生第二次……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "懇請您們",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "原諒……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "已經沒關係了，",
    "voice": "vo_adv_5019007_018",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我不生氣了。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n不僅見到了晴吉，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "而且也結交了新朋友。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "鈴奈？",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對呀！",
    "voice": "vo_adv_5019007_019",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就和我們一起玩吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "嗯！",
    "voice": "vo_adv_5019007_020",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "　天氣一事，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "就交給我們。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n對吧！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "我是不知道發生了什麼事，",
    "voice": "vo_adv_5019007_021",
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "不過沒問題喔！",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "\\n請多指教，",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "晴吉",
    "words": "鈴奈！",
    "voice": null,
    "unit_id": 11711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就馬上來――",
    "voice": "vo_adv_5019007_022",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等一下！",
    "voice": "vo_adv_5019007_023",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "接下來，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳要到舞台上表演啊？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……啊！",
    "voice": "vo_adv_5019007_024",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　對耶！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家還有工作沒做完！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是啊，",
    "voice": "vo_adv_5019007_025",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們是來這裡幫妳加油的，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n要好好表現喔！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好！",
    "voice": "vo_adv_5019007_026",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔，嗚哇哇！",
    "voice": "vo_adv_5019007_027",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n為什麼拉住我的手啦！？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呀啊？",
    "voice": "vo_adv_5019007_028",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "　連、",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "連我也是？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好了，好了！",
    "voice": "vo_adv_5019007_029",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要一起上台喔！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "still",
    "still_id": "501900701"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你好你好！",
    "voice": "vo_adv_5019007_030",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n讓大家久等了！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各位，",
    "voice": "vo_adv_5019007_031",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你們沒事吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n雖然剛才的表演有點浮誇，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但大家玩得開心嗎～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "呀！",
    "voice": "vo_adv_5019007_032",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "　鈴奈！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "雖然嚇了一跳，",
    "voice": "vo_adv_5019007_033",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "但很開心喔！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了～！",
    "voice": "vo_adv_5019007_034",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "已經沒下雨了，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n請大家不要顧慮，好好享受喔！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這就是",
    "voice": "vo_adv_5019007_035",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈她",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一直看著的風景……？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "實在太壯觀了……",
    "voice": "vo_adv_5019007_036",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n和講台上看到的完全不一樣……",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "站在旁邊的人是誰啊？",
    "voice": "vo_adv_5019007_037",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "那個姐姐",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "超性感的！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "另一位女孩子，",
    "voice": "vo_adv_5019007_038",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "既漂亮又可愛！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那邊的！",
    "voice": "vo_adv_5019007_039",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "　我都聽見了！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n真是沒禮貌呢！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天多虧了大家，",
    "voice": "vo_adv_5019007_040",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家才會站在這裡。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以今天我想",
    "voice": "vo_adv_5019007_041",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和大家一起站上台。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "still",
    "still_id": "501900702"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈～！",
    "voice": "vo_adv_5019007_042",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "馬上就創造了",
    "voice": "vo_adv_5019007_043",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一個很棒的回憶呢。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家已經想玩想得不得了！",
    "voice": "vo_adv_5019007_044",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以說，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "夏天要開始了，請多指教！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要開始了喔――！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "預備……！",
    "voice": "vo_adv_5019007_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，伴隨著鈴奈、伊緒、美咲的海水浴場開幕宣言，\\n島上開始了熱鬧的夏天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "2隻精靈坐在掛在天空中的彩虹，\\n一直笑容滿面的守護著，\\n沙灘上開心遊玩的人類。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "movie",
    "movie_id": "501900701"
  }
]
