    "name": "可可蘿",
    "words": "歡迎您來，",
    "voice": "vo_adv_5137070_038",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哪會添麻煩，",
    "voice": "vo_adv_5137070_039",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有這種事的～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我跟小凱留不是好朋友嗎☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊真是的，",
    "voice": "vo_adv_5137070_040",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要貼這麼緊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我宰了妳哦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果是被小凱留宰掉的話，那我求之不得☆",
    "voice": "vo_adv_5137070_041",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說什麼",
    "voice": "vo_adv_5137070_042",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "求之不得☆」啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "妳們感情真好呢！",
    "voice": "vo_adv_5137070_043",
    "unit_id": 100011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啥──！？",
    "voice": "vo_adv_5137070_044",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你有沒有長眼睛啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「…………」",
    "voice": "vo_adv_5137070_045",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「不准頂撞……",
    "voice": "vo_adv_5137070_046",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n「區區……」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n「一隻霸瞳皇帝飼養的貓……」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「百地希留耶……」",
    "voice": "vo_adv_5137070_047",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「雖然妳的目標是尤絲蒂亞娜，」",
    "voice": "vo_adv_5137070_048",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n「但妳對騎士先生做出的言行舉止讓人看不下去。」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「……正因如此。」",
    "voice": "vo_adv_5137070_049",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n「不管在哪個世界線，",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都會受到相應的懲罰吧。」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「……確認過的眾多世界線之中，」",
    "voice": "vo_adv_5137070_050",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n「最有可能打倒霸瞳皇帝的，",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是這個【美食殿堂】。」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「之後",
    "voice": "vo_adv_5137070_051",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會讓D型檢體加入的，",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "說不定就是這個公會。」",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「沒問題吧──",
    "voice": "vo_adv_5137070_052",
    "unit_id": 129012
  },
  {
    "type": "dialogue",
