[
  {
    "type": "dialogue",
    "name": "未央",
    "words": "要成為偶像就是得跨越重重困難呢。",
    "voice": "vo_adv_5035322_000",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "只要打倒這隻魔物，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們就離偶像之路更近了，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "絕對是這樣！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央這種樂觀的思考方式",
    "voice": "vo_adv_5035322_001",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "雖然沒有任何根據，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n但在這種狀況下真的幫了不少忙呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的！　",
    "voice": "vo_adv_5035322_002",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "為了能夠更接近成為偶像的那條路，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n讓我們一起跨過這個困難吧！",
    "voice": null,
    "unit_id": 112411
  }
