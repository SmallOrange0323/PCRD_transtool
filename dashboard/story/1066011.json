  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩個人在草原上奔跑後的第二天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和祈梨在巷弄裡散步。",
