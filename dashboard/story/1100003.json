[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴奈與攝影師正在討論――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "想要衝浪的照片？",
    "voice": "vo_adv_1100003_000",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "不只是拍攝沙灘的照片，",
    "voice": "vo_adv_1100003_001",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n我們也想要拍一些特別場景！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "因此，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "想說如果請妳衝浪的話如何呢――",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我們有這個想法。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像很有趣！！",
    "voice": "vo_adv_1100003_002",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為模特兒之間很流行，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我很早就有興趣了～♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "想試想試！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "就知道妳會這麼說，",
    "voice": "vo_adv_1100003_003",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "所以已經為妳準備衝浪板了唷！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "準備好周到唷！",
    "voice": "vo_adv_1100003_004",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我就來衝浪囉♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼，",
    "voice": "vo_adv_1100003_005",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你說我真的能用這個板子衝浪嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不能衝浪就趕不上流行了～",
    "voice": "vo_adv_1100003_006",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒問題沒問題～♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我出發啦♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "――浪過來了！　",
    "voice": "vo_adv_1100003_007",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是現在……！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "用手划水～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "然後在感覺對的時候站起來……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "站起來……",
    "voice": "vo_adv_1100003_008",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇哇哇！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n哇啊啊啊！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊――！　",
    "voice": "vo_adv_1100003_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "可惜！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "好唷――",
    "voice": "vo_adv_1100003_010",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈！　",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "就這樣繼續下去！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "海水好鹹――！！",
    "voice": "vo_adv_1100003_011",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺好像能站起來！！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "噗啊！",
    "voice": "vo_adv_1100003_012",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "試了好多次都站不起來～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "別灰心別灰心！　",
    "voice": "vo_adv_1100003_013",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "我們休息一下！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好～……",
    "voice": "vo_adv_1100003_014",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呼，",
    "voice": "vo_adv_1100003_015",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看起來很簡單的樣子說……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才不好意思呢――",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你在旁邊看也不有趣吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100003_016",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說我不斷挑戰的樣子很酷嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不用這麼客套～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家跟秀才是朋友吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家打起精神了。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是，",
    "voice": "vo_adv_1100003_017",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "衝浪還真難～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "本來以為馬上就能站起來的說～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是啊。",
    "voice": "vo_adv_1100003_018",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n希望太陽下山前，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "能拍攝成功……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100003_019",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "晚上不能衝浪嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "天色變暗之後就不行囉。",
    "voice": "vo_adv_1100003_020",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n因為很危險。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇哇哇！　",
    "voice": "vo_adv_1100003_021",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那現在可不是休息的時候！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "重來重來！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯？　",
    "voice": "vo_adv_1100003_022",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺力量好像……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你該不會強化人家了？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "的確在這種狀態下，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "應該可以衝浪成功……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "真的嗎！？",
    "voice": "vo_adv_1100003_023",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n那麼，趕快來拍攝吧――",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "――",
    "voice": "vo_adv_1100003_024",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等等！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "鈴奈？",
    "voice": "vo_adv_1100003_025",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才的心意",
    "voice": "vo_adv_1100003_026",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我心領了……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這次",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家想靠自己的力量達成。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "投機取巧，卻說這是人家的實力，",
    "voice": "vo_adv_1100003_027",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說這種謊不是很遜嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "身為專業模特兒，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這點我可不會讓步！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當然！　",
    "voice": "vo_adv_1100003_028",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "會讓你看見我成功衝浪的樣子，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n請幫我加油～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇哈哈，",
    "voice": "vo_adv_1100003_029",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不用道歉啦～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你是為人家才這樣做的吧？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_1100003_030",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我要再次",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "挑戰唷～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇！　",
    "voice": "vo_adv_1100003_031",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀呀……！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n哈啊啊啊！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "鈴奈，",
    "voice": "vo_adv_1100003_032",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
