  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這是剛到這裡時我就要她先做的",
    "voice": "vo_adv_5156006_004",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n逃走專用車，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "為了應對作戰曝光時的情況。",
