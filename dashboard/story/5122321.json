[
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "祕密魔物已經",
    "voice": "vo_adv_5122321_000",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒有再噴出來了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "趁現在",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "集中攻擊牠的本體吧！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "說是這麼說，",
    "voice": "vo_adv_5122321_001",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但這傢伙果然",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "大到不合常理呢……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們感覺起來",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就跟豆子差不多……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這有什麼好畏懼的呢？",
    "voice": "vo_adv_5122321_002",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "既然龐大，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就代表攻擊容易命中。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這可是很棒的好事呢！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好了，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們上前突擊吧！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃內心的積極正向",
    "voice": "vo_adv_5122321_003",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也是強到不合常理呢……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果要挑選最希望是自己上司的人，",
    "voice": "vo_adv_5122321_004",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "和最不希望是自己上司的人，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n她都會雀屏中選吧。",
    "voice": null,
    "unit_id": 126611
  }
]
