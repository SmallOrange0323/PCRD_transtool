  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才喜歡哪種煙火？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我也很喜歡耶！",
