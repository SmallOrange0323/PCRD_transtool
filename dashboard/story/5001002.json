  {
    "type": "dialogue",
    "name": "栞",
    "words": "像是只有這樣的店才會有的",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n稀有的書之類的就好了……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（果然小栞還是想要書啊！",
