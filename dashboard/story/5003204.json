[
  {
    "type": "dialogue",
    "name": "香織",
    "words": "漆黑一片，",
    "voice": "vo_adv_5003204_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "總覺得有種不妙的感覺―",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n大家要小心啊―",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊嗚……",
    "voice": "vo_adv_5003204_001",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "找不到前往",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不可思議之國的大門呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_5003204_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對妾身來說，空氣還挺舒服的！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好像還有深處！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身也變得更輕鬆了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "　走囉，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們幾個！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "往裡面走的話，",
    "voice": "vo_adv_5003204_003",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就可以去不可思議之國了嗎―？",
    "voice": null,
    "unit_id": 101011
  }
]
