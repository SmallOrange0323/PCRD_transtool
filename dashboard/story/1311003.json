    "name": "卡里莎",
    "words": "誰要聽妳的啊！",
    "voice": "vo_adv_1311003_082",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我要回岸邊去了……",
