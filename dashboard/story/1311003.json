    "name": "涅婭",
    "words": "有精神地說出來哦～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n預備～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "涅婭姐姐！",
    "voice": "vo_adv_1311003_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊～",
    "voice": "vo_adv_1311003_054",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真讓人受不了～♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "全員滿分，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "送給你們一年份的",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "糖果",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "作為獎勵～！",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好耶～！",
    "voice": "vo_adv_1311003_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯？",
    "voice": "vo_adv_1311003_056",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n這個嘛……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……這次就算了～",
    "voice": "vo_adv_1311003_057",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n不管哪個孩子都不是第二代，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "而是獨一無二的。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "讓孩子們過自己的人生",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "感覺會更耀眼呢。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "只是這樣看來，",
    "voice": "vo_adv_1311003_058",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "繼承系統似乎不太行呢～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我可以也試試別的想法嗎？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這次的",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "應該會比較好哦？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_1311003_059",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n感覺再煮久一點比較好～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_1311003_060",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n是讓身體停止成長的藥唷～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "只要完成這個，",
    "voice": "vo_adv_1311003_061",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小卡里莎",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就能永遠都是正太了對吧？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "果然不行嗎……？",
    "voice": "vo_adv_1311003_062",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "算了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "也是啦……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n如果小騎士反對的話，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那我就不做了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，涅婭持續嘗試了各種想法。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是，沒有一個結果是令她滿意的，全都以失敗收場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對不起～",
    "voice": "vo_adv_1311003_063",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "還讓你這樣一直陪著我～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……不過，",
    "voice": "vo_adv_1311003_064",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "多虧了像這樣嘗試過各種方法，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我好像能搞懂到底是哪裡不對了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……當小卡里莎不再是正太的時候，",
    "voice": "vo_adv_1311003_065",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我根本不知道我會變得怎樣～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n所以才會這麼地",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "焦急吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "至今為止，",
    "voice": "vo_adv_1311003_066",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "也歷經了無～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "數次與小孩的",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n相遇與別離……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但是從來沒有過，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "讓我這麼執著的情況呢～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "雖然到頭來，",
    "voice": "vo_adv_1311003_067",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "全～部都失敗了。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但是，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "也因為這樣感覺舒暢多了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "搞不好～？",
    "voice": "vo_adv_1311003_068",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我只是希望小騎士",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "能來阻止不斷掙扎的自己",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n也說不定？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "謝謝你～",
    "voice": "vo_adv_1311003_069",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不過果然很虛幻呢～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n時間這種東西，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "完全拿它沒辦法呀～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……沒錯呢。",
    "voice": "vo_adv_1311003_070",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "說的真是太對了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "雖然沒辦法的事，",
    "voice": "vo_adv_1311003_071",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就是沒辦法。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但要如何去面對，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "全都看我自己呢～♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我有點",
    "voice": "vo_adv_1311003_072",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "太死腦筋了呢～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不行不行。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "得像個史萊姆一樣，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "更柔軟更放鬆才行～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "為了到時候不會感到後悔，",
    "voice": "vo_adv_1311003_073",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "得來製造些",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "回憶。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "或是應該再多品嘗一點小卡里莎～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "謝啦，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士♡",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "喂，",
    "voice": "vo_adv_1311003_074",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "你們！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n又在謀劃些什麼了！？",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "剛剛，",
    "voice": "vo_adv_1311003_075",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "有一群小鬼不知為何",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n一邊喊著初代一邊追著我跑……",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "那是你們搞的鬼對吧！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "哦，",
    "voice": "vo_adv_1311003_076",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真不愧是",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "初代小卡里莎♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "來得正好～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n快來跟姐姐我，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "一起製造回憶吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "still",
    "still_id": "131100301"
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "喂！",
    "voice": "vo_adv_1311003_077",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n這是什麼……！？",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯哼哼～",
    "voice": "vo_adv_1311003_078",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n史萊姆水上步行球。",
