[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "湛藍的天空與平靜的海洋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是，在充滿活力的沙灘上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻有一張格格不入的陰沉面孔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "唉……",
    "voice": "vo_adv_1311003_000",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好難受……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士～",
    "voice": "vo_adv_1311003_001",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n你聽我說你聽我說～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是說",
    "voice": "vo_adv_1311003_002",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對不起啊～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "因為想給個驚喜，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "所以私底下偷偷做了很多準備～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "又來了啊……",
    "voice": "vo_adv_1311003_003",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n妳這次又在策劃什麼了。",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "作為調查蘭德索爾的交換條件，",
    "voice": "vo_adv_1311003_004",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我拜託了姊姊當我的贊助者～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不過，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "還是被她拒絕了……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "贊助者……？",
    "voice": "vo_adv_1311003_005",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n【憤怒‧軍團】的嗎？",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "以妳來說，",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "還真是正經的提案呢。",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不是～",
    "voice": "vo_adv_1311003_006",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不是那個～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n是小卡里莎遊樂園的贊助者～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "啥……",
    "voice": "vo_adv_1311003_007",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "妳剛剛",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "說什麼……？",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "姊姊～♪",
    "voice": "vo_adv_1311003_008",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我按照約定，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "把調查結果彙整好了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "辛苦妳了，",
    "voice": "vo_adv_1311003_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "涅婭呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家瞧瞧，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "嗯……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此次報告，",
    "voice": "vo_adv_1311003_010",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "似乎比過往都要更加詳細呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不錯吧～",
    "voice": "vo_adv_1311003_011",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不錯吧～♪",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那麼，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就拜託囉～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小卡里莎遊樂園的贊助者～♡",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……汝剛剛，",
    "voice": "vo_adv_1311003_012",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "說什麼？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n並非是",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "贊助【憤怒‧軍團】嗎？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯……？",
    "voice": "vo_adv_1311003_013",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n是贊助小卡里莎遊樂園哦？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是的～",
    "voice": "vo_adv_1311003_014",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "振作一點啦～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n妳沒有在聽我說話嗎～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "因為吉歐‧提格尼亞",
    "voice": "vo_adv_1311003_015",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "有「大夢想樂園」～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "所以吉歐‧格黑納也來做個主題樂園對抗一下。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我之前不是說過了嗎～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……不。",
    "voice": "vo_adv_1311003_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此等事宜，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家還是初次聽聞。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是嗎？",
    "voice": "vo_adv_1311003_017",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "既然那邊有小卡巴邦，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n那我們的吉祥物",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就只有小卡里莎了吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "如果是吉祥物就不會變老。",
    "voice": "vo_adv_1311003_018",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小卡里莎就永遠都是正太了。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n簡直就是一舉多得？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "只要去小卡里莎遊樂園，",
    "voice": "vo_adv_1311003_019",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n就能隨時見到小卡里莎，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這種如夢境一般的場所，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真讓人興奮～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "說真的～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這只能贊助了吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "嗯，",
    "voice": "vo_adv_1311003_020",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此事即便繼續討論，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n也是徒勞。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "哇～♪",
    "voice": "vo_adv_1311003_021",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n謝謝謝謝，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "謝謝妳──",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……等等。",
    "voice": "vo_adv_1311003_022",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n可別會錯意了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的意思是「不同意」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "咦……！？",
    "voice": "vo_adv_1311003_023",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "為什麼為什麼～！？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "卡里莎小子，",
    "voice": "vo_adv_1311003_024",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並非來自吉歐‧格黑納。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "故奴家無法贊助",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "小卡里莎遊樂園。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是的～！",
    "voice": "vo_adv_1311003_025",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n姊姊妳這個大笨蛋～！",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "之前發生了這樣的事呢～",
    "voice": "vo_adv_1311003_026",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真讓人受不了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "…………",
    "voice": "vo_adv_1311003_027",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "因為妳的關係，",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "讓我腦袋快變得不正常了……",
    "voice": null,
