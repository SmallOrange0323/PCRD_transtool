    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "怎麼有這種事啊──！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n我還以為可以更輕輕鬆鬆就打倒牠的──！",
