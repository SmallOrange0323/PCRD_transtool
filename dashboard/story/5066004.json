[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "祈梨一行人藉由回到過去，解決了許多接連發生的問題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一天一天過去，幫派成員對祈梨的信任，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n已經晉升到了信仰的地步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "老大真的超厲害欸……",
    "voice": "vo_adv_5066004_000",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "簡直像能看透未來似的！",
    "voice": "vo_adv_5066004_001",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "不輸給",
    "voice": "vo_adv_5066004_002",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "上一任老大啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "background",
    "bg_id": "501320"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵、",
    "voice": "vo_adv_5066004_003",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我都聽到了唷，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那些稱讚我的聲音……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就這樣讓家族擴張，超越從前……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n再由我統治一切吧……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂，",
    "voice": "vo_adv_5066004_004",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳還好嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n發生那麼多事",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳也累了吧。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "稍微歇會兒啦。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒、",
    "voice": "vo_adv_5066004_005",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒什麼大不了的啦……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我只是在盡好老大的職責……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然妳這麼說……",
    "voice": "vo_adv_5066004_006",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但這傢伙看起來也滿累的……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "……功能、",
    "voice": "vo_adv_5066004_007",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "沒有、",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "問題……",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳每次一有事就回到過去",
    "voice": "vo_adv_5066004_008",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓它變成沒發生過……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不過更應該做的是",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "小心避免事情發生吧？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……妳想表達什麼？",
    "voice": "vo_adv_5066004_009",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最好別再",
    "voice": "vo_adv_5066004_010",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "使用時間儀了吧？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我跟妳說過沒關係了！",
    "voice": "vo_adv_5066004_011",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n現在的我可是Big Boss唷。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "卑微的嘉夜夜要干涉老大的方針，",
    "voice": "vo_adv_5066004_012",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n還早了一百年啊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_5066004_013",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "結果是白費唇舌",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不然老大，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要休個假，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜！？",
    "voice": "vo_adv_5066004_014",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……在祈梨的頭腦冷靜下來前，",
    "voice": "vo_adv_5066004_015",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓我暫時離開吧。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n時間儀我就留在這了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜啦。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜、",
    "voice": "vo_adv_5066004_016",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "夜……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "隨她去吧。",
    "voice": "vo_adv_5066004_017",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n因為……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我是老大。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我怎麼可能做出那麼沒面子的事！",
    "voice": "vo_adv_5066004_018",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我可是Big Boss喔！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "而且，",
    "voice": "vo_adv_5066004_019",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要有了這個魔導具",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就是無敵的呢！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "反正嘉夜夜",
    "voice": "vo_adv_5066004_020",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "肚子餓就會馬上回來了唷。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "老大！",
    "voice": "vo_adv_5066004_021",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "不好了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "隔壁那幫傢伙",
    "voice": "vo_adv_5066004_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "闖進我們地盤找碴啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼！",
    "voice": "vo_adv_5066004_023",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來得正好！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓他們看看我的實力！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n全體出擊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "跟我來唷！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而，幾小時後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n祈梨率領的幫派本應兇猛地衝向敵人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n現在卻被魔物不停追著跑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為、",
    "voice": "vo_adv_5066004_024",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為、",
    "voice": "vo_adv_5066004_025",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼會變成這樣啊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "對方",
    "voice": "vo_adv_5066004_026",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "好像雇用了魔物使！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼我們會因為那點事就輸得這麼慘！？",
    "voice": "vo_adv_5066004_027",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "抱歉，",
    "voice": "vo_adv_5066004_028",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "我們",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "對付人還可以，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "但還不習慣對付魔物……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "糟糕了",
    "voice": "vo_adv_5066004_029",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "老大！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "\\n在所有人外出時",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "據點被攻下啦！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為、",
    "voice": "vo_adv_5066004_030",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼呀啊啊啊啊啊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚，",
    "voice": "vo_adv_5066004_031",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是屈辱……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n地盤被占走還跟我們要賠償金……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "輸得一敗塗地啊……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "老大……",
    "voice": "vo_adv_5066004_032",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "請別這麼消沉。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "我們一直贏到現在了啊，",
    "voice": "vo_adv_5066004_033",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "偶爾也會發生一兩次這種狀況啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "這種時候",
    "voice": "vo_adv_5066004_034",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "要是嘉夜在就好了啊……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "喂！",
    "voice": "vo_adv_5066004_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "你啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……我想一個人靜靜。",
    "voice": "vo_adv_5066004_036",
    "unit_id": 116511
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": "vo_adv_5066004_037",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "確實是有點累了……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有沒有什麼可以讓人安心的地方……",
    "voice": "vo_adv_5066004_038",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n很久沒去那家店了，來去看看！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喂──！",
    "voice": "vo_adv_5066004_039",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好久不見呀！",
