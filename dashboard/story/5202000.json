    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為想說你一個人很危險，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以就跟上來了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝兩位",
    "voice": "vo_adv_5202000_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "救了主公大人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "其實在下等人",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是接到了討伐委託",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而來到這裡的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳們不是為了討伐，",
    "voice": "vo_adv_5202000_012",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "而是來調查的對吧？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_5202000_013",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "其實我們",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "最近也偶然碰上了失控的魔物，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那時候──",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你這個笨蛋魔物為什麼會出現在這種地方啊～！",
    "voice": "vo_adv_5202000_014",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們要去找怜大人玩，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "別來礙事！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "今天可是難得的休假耶～！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請路過的各位退後！",
    "voice": "vo_adv_5202000_015",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這裡就交給我們──",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "────",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
