    "words": "但那是蘊含了魔力的歌聲。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n目前還只是猜測……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但我想最近的異狀",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n搞不好就是起因於",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個歌聲。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以說，",
    "voice": "vo_adv_5202000_020",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
