    "voice": "vo_adv_5202000_017",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我剛才",
    "voice": "vo_adv_5202000_018",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好像聽到了什麼……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是歌聲……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒錯，",
    "voice": "vo_adv_5202000_019",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然我只有聽到微弱的聲音，",
    "voice": null,
    "unit_id": 104211
  },
