    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "吧？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼突然這樣問？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個嘛。",
    "voice": "vo_adv_7003003_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我一個很要好的模特兒朋友，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n最近就很熱衷呢～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "似乎，",
    "voice": "vo_adv_7003003_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是和嚮往已久的男孩約會的樣子。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像很開心的樣子呢～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我就在想，",
    "voice": "vo_adv_7003003_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是不是大家都常常約會",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就我一個人還什麼都不知道。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家……",
    "voice": "vo_adv_7003003_005",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會、",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會是怎樣的呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為偶像是禁止戀愛的，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n至少我是",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對約會完全不瞭解呢……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "唔——",
    "voice": "vo_adv_7003003_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "回想起那開心的樣子，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就覺得好羡慕啊～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對了！",
    "voice": "vo_adv_7003003_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　欸秀才，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們一回到蘭德索爾就來約會吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這點子很不錯吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸欸！？",
    "voice": "vo_adv_7003003_008",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　和{0}約會！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不可以的啦！！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為、",
    "voice": "vo_adv_7003003_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要問為什麼，",
    "voice": "vo_adv_7003003_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這……",
