[
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふっふっふ、",
    "voice": "vo_adv_6106103_000",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公！　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どうだ、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "この装いは！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n実用性と機能美を兼ね備えた完璧な仕立てだ。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どのような難題が",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n立ち塞がろうとも、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "もはや恐れるに足るまい！　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "実に気に入ったぞ！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なぁっ！？　",
    "voice": "vo_adv_6106103_001",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "わわ、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "私としたことが……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ち、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "違うのだ！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n装いも新たにしたことだし、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ここは一つ甘味で景気づけをと思って……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "んむぅっ",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "──や、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "やめろっ！　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ハンカチで拭うなぁっ！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あっ、",
    "voice": "vo_adv_6106103_002",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "これはその……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "はは、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "メニューの名前を記したメモだ。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nカフェのメニューは種類が多い上に、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どれもこれも名前が長くてな……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n覚えるのに難儀していて……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公も覚えるのを手伝ってくれないか？",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうだろう、",
    "voice": "vo_adv_6106103_003",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうだろう！　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "特にこのエプロン！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n裾の部分まで生地がしっかり縫いこまれていて、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "頑丈で機能的で──",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あっ……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "と、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "すまない。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "たくしあげるのははしたなかったな、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "はは……",
    "voice": null,
    "unit_id": 105312
  }
]
