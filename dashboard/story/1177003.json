  {
    "type": "dialogue",
    "name": "旁白",
    "words": "香織說有事需要幫忙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是{0}來到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【哞哞自衛隊】的據點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～♪",
    "voice": "vo_adv_1177003_000",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n謝謝你",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "過來～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你問要幫忙什麼事？",
    "voice": "vo_adv_1177003_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哎呀～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我沒講嗎？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "其實啊～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我想請你幫忙",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "做開口笑～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我跟【動物苑】的其他人討論了一下，",
    "voice": "vo_adv_1177003_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n今年的萬聖節想做點什麼～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "於是",
    "voice": "vo_adv_1177003_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們決定要發送點心，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n給蘭德索爾的人們～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我打算",
    "voice": "vo_adv_1177003_004",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "做很多開口笑，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n所以才想請{0}幫忙～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～♪",
    "voice": "vo_adv_1177003_005",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n就是這個氣勢～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……你們說，要做好吃的",
    "voice": "vo_adv_1177003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "開口笑？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～？",
    "voice": "vo_adv_1177003_007",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剛才的聲音是……？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n有人在嗎～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "哎呀，",
    "voice": "vo_adv_1177003_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "我是不是嚇到你們了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n我就在這裡啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "你們應該看不到我。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真的耶～",
    "voice": "vo_adv_1177003_009",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽得到聲音",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "卻看不到身影～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n……這代表，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳是幽靈吧～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "是啊。",
    "voice": "vo_adv_1177003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "我只是剛好路過而已……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n不過一聽到開口笑，我就沒辦法不吭聲呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "阿婆，",
    "voice": "vo_adv_1177003_011",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳知道",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "開口笑嗎？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "是啊，",
    "voice": "vo_adv_1177003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "何止是知道，我非常喜歡喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n我以前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "去過某座島旅行……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n在那裡吃到的開口笑，真的很好吃呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "阿婆",
    "voice": "vo_adv_1177003_013",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "旅行時去的那個島，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "可能就是我的故鄉～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那裡是個好地方對吧！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "那座島很棒啊，去過後會讓人生變得不一樣。",
    "voice": "vo_adv_1177003_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n經過那一次旅行之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n我自己也學會做開口笑了呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "開口笑是這麼好吃的東西，",
    "voice": "vo_adv_1177003_015",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n我想讓更多人知道這個甜點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n這曾經",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "是我的夢想。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "可是",
    "voice": "vo_adv_1177003_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "像我這樣的老太婆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n能做到的事很有限哪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n結果",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "沒能實現夢想，人生就這麼結束了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這樣呀～",
    "voice": "vo_adv_1177003_017",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n明明是很美好的夢想，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒辦法實現真遺憾呢……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……",
    "voice": "vo_adv_1177003_018",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我決定了！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "阿婆的夢想，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "由我們來實現吧～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "真的嗎？",
    "voice": "vo_adv_1177003_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n小姑娘你們……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "要幫我實現？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "當然呀～！",
    "voice": "vo_adv_1177003_020",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n畢竟我也想把開口笑，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n推廣給大家知道嘛～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼，",
    "voice": "vo_adv_1177003_021",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們馬上，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就來做開口笑吧～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "油溫",
    "voice": "vo_adv_1177003_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "要再低一點點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n這樣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "形狀才能炸得漂亮喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "原來如此～",
    "voice": "vo_adv_1177003_023",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "阿婆真是開口笑博士呢～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "希望妳再多教我一些～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "我沒有太多可以教小姑娘妳的呢。",
    "voice": "vo_adv_1177003_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n妳已經，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "早就學會最重要的事了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "做開口笑來說最重要的事，",
    "voice": "vo_adv_1177003_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "\\n就是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老婆婆幽靈",
    "words": "對開口笑的愛啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～♪",
    "voice": "vo_adv_1177003_026",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "的確，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我非常喜歡",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "開口笑喔～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我要灌注愛心來製作～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "background",
    "bg_id": "505034"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "開心地做點心之後，",
    "voice": "vo_adv_1177003_027",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要來",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "發點心了～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我要把這些開口笑全部發完，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n實現",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "阿婆的夢想～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊，",
    "voice": "vo_adv_1177003_028",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有個女生來了～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
