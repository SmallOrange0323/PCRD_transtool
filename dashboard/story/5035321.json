  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那些人長得跟我們一樣……？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "跟、",
    "voice": "vo_adv_5035321_001",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "跟自己戰鬥的話還好，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是要和小凜還有未央敵對，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n總覺得會有點不知道該怎麼辦……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "卯月，",
    "voice": "vo_adv_5035321_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那並不是真的我們，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "所以妳不用客氣唷。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "甚至還讓人感覺有點噁心……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "讓我們盡快解決掉吧！",
    "voice": null,
    "unit_id": 112511
  }
