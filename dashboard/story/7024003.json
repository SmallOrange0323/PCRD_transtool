[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人繼續往露娜之塔上方前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過只是一語不發地前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號被挖角……？",
    "voice": "vo_adv_7024003_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "很難以置信……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不過她的確很優秀。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "話雖如此，",
    "voice": "vo_adv_7024003_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "她竟然要拋下相處這麼久的我……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "正因為",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "認識夠久，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也很清楚她是多追求合理的人……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "偷瞄……",
    "voice": "vo_adv_7024003_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "…………",
    "voice": "vo_adv_7024003_003",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "連看都不看這裡呢……",
    "voice": "vo_adv_7024003_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我才不擔心呢！",
    "voice": "vo_adv_7024003_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我就靠自己的力量",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n來幫助陛下！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "前方有一群魔物聚集。",
    "voice": "vo_adv_7024003_006",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "準備進行戰鬥。",
    "voice": "vo_adv_7024003_007",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳待在最後方看著敵人的動向。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是的。",
    "voice": "vo_adv_7024003_008",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要上囉。",
    "voice": "vo_adv_7024003_009",
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花在前陣迎擊魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和克蕾琪塔則是在後方掩護。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只要一進入戰鬥",
    "voice": "vo_adv_7024003_010",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就無事可做啊……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "至少你還能幫忙強化啊。",
    "voice": "vo_adv_7024003_011",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不像我真的只能在旁邊看……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "似似花小姐，",
    "voice": "vo_adv_7024003_012",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "右前方有",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "敵軍增援。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n數量20。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我要直接壓制前線。",
    "voice": "vo_adv_7024003_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n跟我來。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "明白了。",
    "voice": "vo_adv_7024003_014",
    "unit_id": 6111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "光是哭喪著臉也沒用。",
    "voice": "vo_adv_7024003_015",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就算我只能在一旁看著，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "至少能集中注意……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n只能把我握有的資源做最大化的利用了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "說不定",
    "voice": "vo_adv_7024003_016",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就這樣被我找出了弱點呢。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "話說……",
    "voice": "vo_adv_7024003_017",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這個叫似似花的魔法師的戰鬥方式……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總覺得有點不對勁，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好像有點奇怪呢。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "她在使用",
    "voice": "vo_adv_7024003_018",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "分身對吧？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我曉得有些魔法道具可以做出分身，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是沒辦法像這樣簡單地出現、消失，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "更別說能自由自在地操縱了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如果這是幻影魔法創造出來的分身，",
    "voice": "vo_adv_7024003_019",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n幻影有辦法施放魔法……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那看起來簡直像是",
    "voice": "vo_adv_7024003_020",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "本體自由地在不同分身間穿梭……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這不過是猜想罷了。",
    "voice": "vo_adv_7024003_021",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "看來你比較清楚呢。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那究竟是怎麼回事……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是的……",
    "voice": "vo_adv_7024003_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "淑女的祕密可不行隨便說出去啊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼……？",
    "voice": "vo_adv_7024003_023",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳剛才",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不是還在那裡戰鬥……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在被包圍前我們貫穿過去。",
    "voice": "vo_adv_7024003_024",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "敵人數量最少的地方在哪裡？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "中間有大型魔物。",
    "voice": "vo_adv_7024003_025",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n只要擊倒它",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "應該就能開出一個洞。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "知道了。",
    "voice": "vo_adv_7024003_026",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n讓它消失吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳不是在最前線迎擊嗎？",
    "voice": "vo_adv_7024003_027",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那我現在眼前的妳究竟是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳就說說",
    "voice": "vo_adv_7024003_028",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳的猜想讓我當參考吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我來幫妳審查看看。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔……",
    "voice": "vo_adv_7024003_029",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好啊……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n正在迎擊的妳和我面前的妳，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "兩邊都擁有自我意識。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因此，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這應該不是幻影也不是自動人偶……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這有兩種可能，",
    "voice": "vo_adv_7024003_030",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一個是原本就有叫做似似花的兩個人物。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n或者是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "用不明手段",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "讓同一個人分裂。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哦。",
    "voice": "vo_adv_7024003_031",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "後者比較恐怖呢。",
    "voice": "vo_adv_7024003_032",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n如果只有兩個人的話至少能分開擊倒。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如果會不斷分裂的話那就沒完沒了了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我從妳老神在在的樣子……",
    "voice": "vo_adv_7024003_033",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "感受到這種恐怖。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此，",
    "voice": "vo_adv_7024003_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算妳及格吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為什麼要如此大費周章？",
    "voice": "vo_adv_7024003_035",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "兩個人一起上的話",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "應該很輕易就能打倒敵人……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳覺得是為什麼呢？",
    "voice": "vo_adv_7024003_036",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "依我猜想，",
    "voice": "vo_adv_7024003_037",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可能是因為其中一方並無戰鬥力，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n只能夠負責監視。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "說不定連我都能打贏……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳要試試看嗎？",
    "voice": "vo_adv_7024003_038",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……還是算了吧。",
    "voice": "vo_adv_7024003_039",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n妳最令人恐懼的",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "並不是魔法技巧……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "像現在妳和我談話的時候，",
    "voice": "vo_adv_7024003_040",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n另一個妳",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "正在和秘書一號一起迎擊魔物……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也就是說",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "存在著多個有思考能力的同一號人物。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如妳這般造詣的魔法師，",
    "voice": "vo_adv_7024003_041",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "竟然在世間默默無聞，那原因恐怕是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因為妳不想被發現……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一般人不可能如此徹底保守祕密。",
    "voice": "vo_adv_7024003_042",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳卻擁有這樣的力量。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "喔……",
    "voice": "vo_adv_7024003_043",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "說得好，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "繼續講。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳的本領是",
    "voice": "vo_adv_7024003_044",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "使用這份能力進行諜報……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只要用分身或變身潛入，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n無論什麼組織都沒辦法保守祕密。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，",
    "voice": "vo_adv_7024003_045",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可以說幾乎全對呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來妳比我想像得還要聰明呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這樣糟糕的能力……",
    "voice": "vo_adv_7024003_046",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要不是我親眼看見實在無法相信。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這種東西，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "簡直像童話故事裡的七……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "到此為止，",
    "voice": "vo_adv_7024003_047",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "別再說下去了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我只是陪妳這個小人物玩玩而已，",
    "voice": "vo_adv_7024003_048",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要是妳隨便探究……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "明白吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔",
    "voice": "vo_adv_7024003_049",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "說到底，",
    "voice": "vo_adv_7024003_050",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我的真實身分",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "和妳又有何相干？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "當然有啊。",
    "voice": "vo_adv_7024003_051",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "像妳這種擁有怪物般力量的人存在……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "比起我，陛下更寵愛妳",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也無可奈何。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是因為我不中用……",
    "voice": "vo_adv_7024003_052",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n陛下才會找妳來",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n監視我呢……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "唉……",
    "voice": "vo_adv_7024003_053",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳竟然在意這種無聊的小事。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "無聊小事？",
    "voice": "vo_adv_7024003_054",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳竟然說這是無聊小事？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n妳說我的忠義無聊？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳嘴上說著忠義，",
    "voice": "vo_adv_7024003_055",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但實在很膚淺。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "難不成妳所謂的忠義",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不和他人比較就無法確定嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要我說的話，",
    "voice": "vo_adv_7024003_056",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這種忠義根本是假的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "竟然說我的忠義……",
    "voice": "vo_adv_7024003_057",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "假的……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳其實自己也有自覺吧？",
    "voice": "vo_adv_7024003_058",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以才會",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "整天把忠義掛在嘴上。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "到頭來……",
    "voice": "vo_adv_7024003_059",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我還是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "心裡只在乎得失的",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "商人嗎……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼了？",
    "voice": "vo_adv_7024003_060",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你該不會",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在擔心她吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是的，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "公主也好你也好，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你們真的是想法很天真。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "她過去",
    "voice": "vo_adv_7024003_061",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "曾和想要殺公主的一夥人有關係……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼可以隨便相信呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "話說……",
    "voice": "vo_adv_7024003_062",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "虧我都親自出馬了，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "結果卻如此無趣。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你沒有察覺到嗎？",
    "voice": "vo_adv_7024003_063",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要說的話，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "調查塔只是順便。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在聽到你講的事情後，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我就有了幾個猜測。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我真正的目的是……",
    "voice": "vo_adv_7024003_064",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "摸清",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "克蕾琪塔‧凱許的底細。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算本人沒有這個意圖，",
    "voice": "vo_adv_7024003_065",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "並不代表沒有幕後黑手。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只要對方不再和我們作對就好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要是對方不這麼想的話……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了保護你",
    "voice": "vo_adv_7024003_066",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我可是會不擇手段。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "她自信的說道，語畢同時，受到最前線的似似花的攻擊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n最後的魔物應聲倒下。",
    "voice": null,
    "unit_id": null
  }
