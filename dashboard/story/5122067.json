  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5122067_000",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您幫我找到了是嗎。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n竟然能找到這瓶",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "被祕密廢棄掉的小藥瓶，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不愧是該成為我伴侶的大人呢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "咦？",
    "voice": "vo_adv_5122067_001",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您說它瀰漫著一股不祥之氣？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真沒想到您會這麼說。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這藥啊，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "可是我一邊想著您所做的呢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……嘻嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然囉，",
    "voice": "vo_adv_5122067_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "瀰漫的才不是瘴氣，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "而是我的愛喔。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是為了大人您所準備的藥……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n請再看著它一遍。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您還覺得，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "它看起來有不祥的氛圍嗎？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻嘻……",
    "voice": "vo_adv_5122067_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您能理解就好了……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請張開嘴巴，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓我來餵您喝下……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_5122067_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那個……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不是我丟棄的。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n是深月她在暗地裡",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "擅自將它廢棄掉的……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒想到深月那樣的人",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "竟然",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "說這個太危險了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5122067_005",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您怎麼了嗎，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您想知道喝下去",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "會怎麼樣……？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n充滿好奇心是件好事呢，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……不過，",
    "voice": "vo_adv_5122067_006",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人您不需要知道那種事。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為這可是我",
    "voice": "vo_adv_5122067_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "每晚傾注愛情所調製出來的藥……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n搖一次藥瓶，我就想著大人您，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "再搖一次，我也想著大人您……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "單憑這個事實，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就足以構成讓您喝下的理由了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您覺得如何？",
    "voice": "vo_adv_5122067_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是不是想要立刻喝下這藥了呢？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "並不想",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是奇怪……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我還以為您會很高興的說。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是代表我",
    "voice": "vo_adv_5122067_009",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還教育得不夠嗎……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我會好好教育您，總有一天會讓您",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n開心地喝下這瓶藥。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您好好期待吧……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "它能夠回到我手上，",
    "voice": "vo_adv_5122067_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是謝謝您……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n嘻嘻嘻……",
    "voice": null,
    "unit_id": 102711
  }
]
