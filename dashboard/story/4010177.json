  {
    "type": "dialogue",
    "name": "碧",
    "words": "你、",
    "voice": "vo_adv_4010177_000",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你剛剛……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說了什麼……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "生日……",
    "voice": "vo_adv_4010177_001",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "派對……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那種東西，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我只在傳聞中聽過……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": "vo_adv_4010177_002",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "生日派對",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是要在生日的時候舉辦對吧。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n今天是平凡無奇又普通的一天……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n究竟是",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要幫誰慶祝呢……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是",
    "voice": "vo_adv_4010177_003",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "今天是……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的生日……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為邊緣人就是會忘掉這些紀念日的生物，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以我完全沒發現……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也就是說，",
    "voice": "vo_adv_4010177_004",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是要舉辦",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的生日派對……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你是認真的嗎，",
    "voice": "vo_adv_4010177_005",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n生日派對……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我和你",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一起……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我知道了……",
    "voice": "vo_adv_4010177_006",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n就舉辦……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "生日派對吧。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在我們的邊緣人歷史上踏出值得紀念的一步吧。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "兩個人一起",
    "voice": "vo_adv_4010177_007",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "過生日……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "首、",
    "voice": "vo_adv_4010177_008",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "首先要做什麼才好呢……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要準備禮物才行。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n紀念生日派對的禮物……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長。",
    "voice": "vo_adv_4010177_009",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們一起",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "創造最棒的生日吧……♪",
    "voice": null,
    "unit_id": 104033
  }
]
