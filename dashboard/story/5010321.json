[
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "竟然、",
    "voice": "vo_adv_5010321_000",
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "將煩惱、",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "打破什麼的……",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "來讓我集結、",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "全部的煩惱……！",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "給你們瞧瞧吧！",
    "voice": "vo_adv_5010321_001",
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "\\n你們這些傢伙，",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "邪餅神鏡餅",
    "words": "將人類的污穢的心靈……！",
    "voice": null,
    "unit_id": 10811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "全部的煩惱……？",
    "voice": "vo_adv_5010321_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "該不會，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要把108種煩惱一口氣全部叫出嗎！？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此，",
    "voice": "vo_adv_5010321_003",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來這手啊……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "接下來的戰鬥會更嚴峻呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論是什麼樣的對手，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "絕對不可氣餒，去戰鬥吧！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好的——！　",
    "voice": "vo_adv_5010321_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然我不太懂煩惱的事，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n總之把它們解決掉吧！　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要上囉——！！",
    "voice": null,
    "unit_id": 108711
  }
]
