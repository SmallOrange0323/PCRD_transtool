    "name": "鬼魂教父",
    "words": "做得還不錯嘛，",
    "voice": "vo_adv_5050006_046",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "腳邊出現空隙了啊？",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼！",
    "voice": "vo_adv_5050006_047",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唔哇！？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人！！",
    "voice": "vo_adv_5050006_048",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "解決看起來最麻煩的傢伙了呢，",
    "voice": "vo_adv_5050006_049",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n話說回來，這傢伙的精氣真是充足啊！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n我的力量都湧現出現了！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哼哈哈哈！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過",
    "voice": "vo_adv_5050006_050",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "還不夠，",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我吃得還不夠。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n啊……",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "還有幾個礙眼的傢伙在呢。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修、休茲",
    "words": "……咦？",
    "voice": "vo_adv_5050006_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希、茉莉",
    "words": "危險！！",
    "voice": "vo_adv_5050006_052",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "紡希、茉莉",
    "words": "嗚哇！？",
    "voice": "vo_adv_5050006_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "力量……",
    "voice": "vo_adv_5050006_054",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "從身體……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "動彈……",
    "voice": "vo_adv_5050006_055",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不得了……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希……！！",
    "voice": "vo_adv_5050006_056",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "茉莉……！！",
    "voice": "vo_adv_5050006_057",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "保護吊車尾而自我毀滅，真是愚蠢。",
    "voice": "vo_adv_5050006_058",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "如此一來，就沒有能反抗我的傢伙了呢。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n接下來就慢慢收拾這些吊車尾……",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "為、",
    "voice": "vo_adv_5050006_059",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "為什麼會變成這樣……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n這種嚇人的方法……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "是不對的啊……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "你不需要思考那些事，",
    "voice": "vo_adv_5050006_060",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n反正都要在這裡被我吃掉而消失了。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "危、",
    "voice": "vo_adv_5050006_061",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "險……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希！！",
    "voice": "vo_adv_5050006_062",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的……",
    "voice": "vo_adv_5050006_063",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在可不是、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "發呆的時候啊……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "那副身軀還能動啊？",
    "voice": "vo_adv_5050006_064",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "真是了不起呢。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過，",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這樣就結束了！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "快、",
    "voice": "vo_adv_5050006_065",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "快住手──！！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "嗚哇────！？",
    "voice": "vo_adv_5050006_066",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "休茲！",
    "voice": "vo_adv_5050006_067",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "嗚……",
    "voice": "vo_adv_5050006_068",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "休茲！",
    "voice": "vo_adv_5050006_069",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哈哈哈！",
    "voice": "vo_adv_5050006_070",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "沒想到還自己送上門來讓我吃啊！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n一個吊車尾天真成這樣真是幫了大忙呢！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我感覺到力量越來越強大了啊！",
    "voice": "vo_adv_5050006_071",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n這樣就可以讓人類",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "一同陷入恐怖深淵了呢！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n我就是最恐怖的鬼怪！！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不要做這種事啊！",
    "voice": "vo_adv_5050006_072",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "為何？",
    "voice": "vo_adv_5050006_073",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n可以變成更恐怖的鬼怪啊，",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這麼做有什麼不對嗎？",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那是因為、",
    "voice": "vo_adv_5050006_074",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那個……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那個……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的……",
    "voice": "vo_adv_5050006_075",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你只要回答……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "「我想看大家開心的表情」",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就好了。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你應該早就察覺到了吧。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我不是說過嗎？",
    "voice": "vo_adv_5050006_076",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要讓人開心，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "得先讓自己開心。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而你們幾個",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "很自然地就明白這一點了呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希……！",
    "voice": "vo_adv_5050006_077",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯……",
    "voice": "vo_adv_5050006_078",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為鬼屋就是",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這樣的東西……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_5050006_079",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "正是如此……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "妳、",
    "voice": "vo_adv_5050006_080",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "妳們！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "為什麼還可以動！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這該怎麼形容呢……",
    "voice": "vo_adv_5050006_081",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "算是",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "毅力嗎？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "毅力……",
    "voice": "vo_adv_5050006_082",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不錯呢，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我喜歡這個詞。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有就是，",
    "voice": "vo_adv_5050006_083",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為我們沒辦法放下這些孩子",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "的關係啊。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "……哈哈。",
    "voice": "vo_adv_5050006_084",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "有什麼好笑的！",
    "voice": "vo_adv_5050006_085",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我知道了！",
    "voice": "vo_adv_5050006_086",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n比起讓人害怕，",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我更喜歡逗人開心啊！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n和紡希她們一起經營的鬼屋非常有趣！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "如果說身為鬼怪，這麼做是錯的，",
    "voice": "vo_adv_5050006_087",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n那就算我不能成為獨當一面的鬼怪也無所謂！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不對，",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "是我不想成為獨當一面的鬼怪了！！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "鬼魂教父的做法一點都不開心！",
    "voice": "vo_adv_5050006_088",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n所以這種做法是錯的！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "這答案簡單到連我也明白！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哼！",
    "voice": "vo_adv_5050006_089",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "就憑你是能做什麼！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n讓我吸乾你那渺小的精氣吧！！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "馬修",
