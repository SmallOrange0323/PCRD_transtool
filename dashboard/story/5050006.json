    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "很勇敢嘛！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
