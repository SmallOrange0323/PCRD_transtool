    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "是開心的表演秀啊！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n不過會開心的",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "只有我而已！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n哈哈哈！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "要上了，",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "看我的！",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
