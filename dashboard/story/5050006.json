  {
    "type": "dialogue",
    "name": "旁白",
    "words": "紡希等人為了尋找消失的兩人的線索，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了鬼魂教父所在的鬼屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然你說沒有見到維多他們，",
    "voice": "vo_adv_5050006_000",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不過有人看到他們跟你待在一起喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "是看錯了吧？",
    "voice": "vo_adv_5050006_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我真的不知道他們兩個……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚、",
    "voice": "vo_adv_5050006_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "紡……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "希……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這個聲音是！",
    "voice": "vo_adv_5050006_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "大家……",
    "voice": "vo_adv_5050006_004",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "快逃……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "鬼魂教父他……",
    "voice": "vo_adv_5050006_005",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "變得怪怪的……",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "維多！",
    "voice": "vo_adv_5050006_006",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "艾迪！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "嘖！",
    "voice": "vo_adv_5050006_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "醒過來了嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n早知道這樣，就把精氣連皮帶骨吞噬乾淨就好了呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "精、",
    "voice": "vo_adv_5050006_008",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "精氣？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "鬼魂教父",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "你在說什麼啊？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我是說，要是把他們的精氣都給",
    "voice": "vo_adv_5050006_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "吞噬乾淨就好了呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n你沒聽清楚嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "鬼怪吃的不是悲鳴嗎……",
    "voice": "vo_adv_5050006_010",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "只吃悲鳴是沒辦法變強的。",
    "voice": "vo_adv_5050006_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "那樣的話不管過了多久",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n都只能逗得人類哇哇叫而已。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你、",
    "voice": "vo_adv_5050006_012",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你在說什麼？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n鬼屋不就是那樣的嗎？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我想要成為真正意義上帶來恐怖的存在啊。",
    "voice": "vo_adv_5050006_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n可不是鬼屋那種小家子氣的東西。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "好不容易可以透過遊行，",
    "voice": "vo_adv_5050006_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "從人類身上一口氣吸取精氣，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "鎮長那個傢伙……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "竟然小看我！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難、",
    "voice": "vo_adv_5050006_015",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難道你連鎮長都……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "也罷，",
    "voice": "vo_adv_5050006_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "無所謂。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n只要讓你們也閉上嘴事情就又能順我意了",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "所以就在這裡……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "讓我吃掉吧！！",
    "voice": "vo_adv_5050006_017",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼！？",
    "voice": "vo_adv_5050006_018",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "怎麼回事，",
    "voice": "vo_adv_5050006_019",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n有個巨大的鬼怪耶。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是什麼表演秀嗎！",
