[
  {
    "type": "dialogue",
    "name": "初音",
    "words": "每次想看",
    "voice": "vo_adv_4012009_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "跟小栞借來的書就會睡著，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我還只看了六行耶～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有沒有可以不會想睡的藥？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "有喔。",
    "voice": "vo_adv_4012009_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易特製能量飲。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "只要喝了這個，睡意就會瞬間消失……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": "vo_adv_4012009_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……咦，",
    "voice": "vo_adv_4012009_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "已經睡著了啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好了，",
    "voice": "vo_adv_4012009_004",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "快起來。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "試著喝喝看這個，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n它會像是給妳一對翅膀一樣……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "噗哈……",
    "voice": "vo_adv_4012009_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……咦，",
    "voice": "vo_adv_4012009_006",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "已經在飛了啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕。",
    "voice": "vo_adv_4012009_007",
    "unit_id": 101211
  }
]
