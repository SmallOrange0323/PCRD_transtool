[
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "怜與{0}\\n在逛著萬聖節樂園內的攤販。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不愧是主要大街，",
    "voice": "vo_adv_1140002_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這附近相當熱鬧呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "慶典的人很多，",
    "voice": "vo_adv_1140002_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是走散就麻煩了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要小心",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別離得太遠。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": "vo_adv_1140002_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個是什麼？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是那個吊著很多繩子的攤販。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那個是",
    "voice": "vo_adv_1140002_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抽獎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "繩子跟獎品綁在一起，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是只要拉繩子，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就能把拉中的獎品拉起來的機關啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": "vo_adv_1140002_004",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "攤販賣的食物，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也和在鎮上看到的東西挺不一樣的呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然在鎮上",
    "voice": "vo_adv_1140002_005",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也會看到賣食物的攤販，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但這裡賣的感覺似乎有另外下過工夫。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我還是第一次看到色彩這麼鮮艷的雪酪。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話又說回來……",
    "voice": "vo_adv_1140002_006",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n擺設了這麼多家店，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "目光會不禁就被吸引過去了呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以現在我也想要問問你有沒有什麼推薦的去逛的地點，",
    "voice": "vo_adv_1140002_007",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你覺得呢？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂～",
    "voice": "vo_adv_1140002_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "你們兩個！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你是前幾天的……",
    "voice": "vo_adv_1140002_009",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "果然是小妹妹你們啊。",
    "voice": "vo_adv_1140002_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "前陣子真的幫大忙了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n多虧你們替我收集來的建材，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n我才能",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "像這樣順利出攤，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "多謝啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "就如你們所見，",
    "voice": "vo_adv_1140002_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我這裡是開射擊遊戲的攤販……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n小妹妹你們要不要也來玩玩看？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "射擊嗎……",
    "voice": "vo_adv_1140002_012",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的也是，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得人家都邀請了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就玩玩看吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "好喔，",
    "voice": "vo_adv_1140002_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "客人兩位～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "規則很簡單，",
    "voice": "vo_adv_1140002_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "射中靶子，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "若是掉下來就能得到獎品。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n只要倒下還不算，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "要完全掉到地板上才行。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就",
    "voice": "vo_adv_1140002_015",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "開始玩玩看吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "首先是……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看我的！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……沒中啊，",
    "voice": "vo_adv_1140002_016",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來沒那麼簡單呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼了？",
    "voice": "vo_adv_1140002_017",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "瞄準的時候盡量把手伸直？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這樣……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "仔細瞄準獵物……",
    "voice": "vo_adv_1140002_018",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "命中吧！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哦，",
    "voice": "vo_adv_1140002_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "射中了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳技術不錯喔，小妹妹！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "平時都是我負責指導你，",
    "voice": "vo_adv_1140002_020",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n感覺就像立場顛倒了呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣的話……！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "又射中了！",
    "voice": "vo_adv_1140002_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "小妹妹，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "妳很有天分喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n小哥你也要努力別輸給她了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該是你很會教人吧，",
    "voice": "vo_adv_1140002_022",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我覺得自己還能繼續射下獎品。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哦，",
    "voice": "vo_adv_1140002_023",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看起來也很有幹勁呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那接下來",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就讓我見識你的技術吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我替你加油。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "來，",
    "voice": "vo_adv_1140002_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這是小姑娘獲得的獎品。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "謝謝你們來玩，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "如果有空",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "就再來玩吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_1140002_025",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為得到了很多獎品。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n以第一次來說，算是很不錯的成果吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這也是",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多虧有你的建議。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "給你，",
    "voice": "vo_adv_1140002_026",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一起吃獲得的點心吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我一個人也吃不完。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過你",
    "voice": "vo_adv_1140002_027",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真是吃得津津有味呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該說你很值得讓人餵你吃東西嗎，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一不小心就會想餵你……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可能是你有點像小狗狗吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1140002_028",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "接下來要做什麼？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你有什麼想做的事嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你很在意那邊嗎？",
    "voice": "vo_adv_1140002_029",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那是……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是製作萬聖節周邊小物的專區嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們去看看吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嘿～",
    "voice": "vo_adv_1140002_030",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "胸針、帽子、人偶……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "連籃子都能做啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個是……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把南瓜挖空做成的燈籠啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真令人感興趣。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳想做燈籠嗎？",
    "voice": "vo_adv_1140002_031",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n如果有興趣，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "要不要試試看呢？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是，",
    "voice": "vo_adv_1140002_032",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得的機會，就來體驗看看吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且你",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像也對這個很感興趣。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那麼",
    "voice": "vo_adv_1140002_033",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我去拿必要的道具過來。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "南瓜就堆放在那裡，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n請挑自己喜歡的。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "擺放了很多漂亮的南瓜呢。",
    "voice": "vo_adv_1140002_034",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只要從擺在這裡的南瓜中",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "挑選就行了吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……原來如此，",
    "voice": "vo_adv_1140002_035",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "裡面早就已經都挖空了啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只要雕刻外皮好像就能完成了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，",
    "voice": "vo_adv_1140002_036",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來你也選好了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n道具好像也都準備好了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就來開始做吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼了？",
    "voice": "vo_adv_1140002_037",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "拿著南瓜待愣在原地。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你想和我比賽做燈籠？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我覺得這應該跟比賽沒什麼關係……",
    "voice": "vo_adv_1140002_038",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但好啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你想比的話。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得的機會，",
    "voice": "vo_adv_1140002_039",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "規則就定",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "輸的那方請客也行喔。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那樣子感覺讓人更有幹勁。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然要比，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就彼此盡全力來比賽吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵……",
    "voice": "vo_adv_1140002_040",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總覺得我也開始有點熱血沸騰了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就趕快來開始吧！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著過了一段時間後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "來了來了，",
    "voice": "vo_adv_1140002_041",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "馬上就做好，請等一下喔。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "七戰六勝",
    "voice": "vo_adv_1140002_042",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一平手……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到會都讓你請客，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖說是比賽的結果，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但感覺有點不好意思呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_1140002_043",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是段非常有意義的時間。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n多虧你，我才能有這麼刺激的體驗。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_1140002_044",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "像這樣度過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就讓我會想",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "自己是不是也稍微體驗了一般女孩子會做的事情呢？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為我至今都沒機會參加這類的活動，",
    "voice": "vo_adv_1140002_045",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也有因為學習和家裡的事情而無法去的時候……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且家裡的人都對我說",
    "voice": "vo_adv_1140002_046",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "人多吵雜的地方很危險，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n特別是像慶典這種地方就更是如此。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或許我內心中也默默對此感到憧憬吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": "vo_adv_1140002_047",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我沒想到\\n你居然會這麼喜歡比賽。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "以你平常的樣子來看，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感覺有點意外呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": "vo_adv_1140002_048",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有什麼理由嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咦……？",
    "voice": "vo_adv_1140002_049",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那你",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "並不是很在意輸贏，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只是想和我一起玩，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈……",
    "voice": "vo_adv_1140002_050",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那真是中了你的計呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n結果我完全稱了你的意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "still",
    "still_id": "114000201"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難怪我會變成這種打扮。",
    "voice": "vo_adv_1140002_051",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "從中途開始就很樂於讓我穿上各種裝飾吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真受不了你……",
    "voice": "vo_adv_1140002_052",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我是不會說我沒樂在其中，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但這種引人注目的打扮，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓人有點難為情啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": "vo_adv_1140002_053",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就看在這棉花糖的份上",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "放過你吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要是只有我一個人，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我一定不會買吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我說不定",
    "voice": "vo_adv_1140002_054",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是第一次吃到棉花糖，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到會是這麼甜的東西呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…………",
    "voice": "vo_adv_1140002_055",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你那樣盯著我看，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會讓人難以入口……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也買自己的份就好了啊……",
    "voice": "vo_adv_1140002_056",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然那麼在意，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要吃一口看看嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這麼乖地把嘴張開等人餵你吃，",
    "voice": "vo_adv_1140002_057",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n讓我有種母鳥在餵小鳥的感覺。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呃……",
    "voice": "vo_adv_1140002_058",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
