  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "はぁ、",
    "voice": "vo_adv_5040703_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ようやく追い払えたよ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんかねずみたち、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nどんどん必死になってる感じがするんだけど……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "気のせい？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "でもまぁ、",
    "voice": "vo_adv_5040703_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんとか守れてよかったよ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あんたたちも",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "食べられなくてよかったね……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "って、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nあたし",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんでチーズに話しかけてるの？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "この子たちのために戦ってたから愛着湧いちゃった……？",
    "voice": "vo_adv_5040703_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ん？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "この子って……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたし本当にどうしたんだろう。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nどのみち食べられるのに変わりはないじゃん。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "チーズがなくなったら",
    "voice": "vo_adv_5040703_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まっひ～が悲しむからだよね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "うん。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "それだけだよ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "ねずみ",
    "words": "ちゅ～～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "また来たの？　",
    "voice": "vo_adv_5040703_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "本当に懲りないね～……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "って！？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "すごいデカいじゃん！！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ほんとにねずみなの！？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "ねずみ",
    "words": "ちゅ～～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ちゅ～～って鳴いてるからねずみか。",
    "voice": "vo_adv_5040703_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あ～～もう、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "何度来たって無駄だよ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nここは絶対に通さないから！！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "この子たちはあたしが守り抜いてみせる！！",
    "voice": "vo_adv_5040703_006",
    "unit_id": 102611
  }
]
