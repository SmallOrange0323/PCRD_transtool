  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與吉塔結束了工作，\\n一同在蘭德索爾裡散步聊天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "吶，",
    "voice": "vo_adv_1057003_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你明天有空嗎？",
