[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在鮮花祭的前一天晚上，鈴莓被幫派抓去當作人質。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而{0}和龍次",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n都還沒有察覺到這件事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "結果，",
    "voice": "vo_adv_5144006_000",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "老大還是沒有來約定的地點……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "他該不會",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是決定放棄這個村子了嗎？　",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "村裡目前也很平靜。",
    "voice": "vo_adv_5144006_001",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "要是能這樣子平安結束，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那就再好不過了。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "早安，",
    "voice": "vo_adv_5144006_002",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "龍次先生。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你已經開始進行早上的作業了嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "啊啊，",
    "voice": "vo_adv_5144006_003",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是鏡華和陰柔男啊。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "你們才是，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "怎麼這麼早就來了，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n還可以再睡久一點呀？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "啊？",
    "voice": "vo_adv_5144006_004",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "沒有，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我沒看見。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "她不是和你們待在一起嗎？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "昨天晚上，",
    "voice": "vo_adv_5144006_005",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "她說要先做好洗衣服的準備再睡覺，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以叫我們先去睡……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在那之後，",
    "voice": "vo_adv_5144006_006",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "她好像沒有回到房間。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "明明她平時總是比我早起，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以會來叫我起床。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那傢伙，",
    "voice": "vo_adv_5144006_007",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是在昨晚",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "說要去做洗衣服的準備是吧？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那她要洗的東西",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "現在在哪裡？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "關於這個",
    "voice": "vo_adv_5144006_008",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也有一點奇怪。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那些衣物到處散落在地上，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n甚至還有花瓣掉在四周……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "……",
    "voice": "vo_adv_5144006_009",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "讓我看一下。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是這種花瓣。",
    "voice": "vo_adv_5144006_010",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "和村裡種的花",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "似乎是不同品種。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "糟了，",
    "voice": "vo_adv_5144006_011",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "可惡！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n他們用怪物去襲擊小姑娘了嗎！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": "vo_adv_5144006_012",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你說的怪物是指什麼？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "……",
    "voice": "vo_adv_5144006_013",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "果然",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "只能全部說出來了！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "跟我過來吧，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我們還需要借助老頭子的力量！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個～！",
    "voice": "vo_adv_5144006_014",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請放開我，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼你們要做這種事呢～！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "呵呵呵，",
    "voice": "vo_adv_5144006_015",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "反正事情結束後我們就會把妳給收拾掉了。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "我就告訴妳，讓妳當作上路的伴手禮吧。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "我們接下來要去襲擊村莊。",
    "voice": "vo_adv_5144006_016",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "但是，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "儘管對方只是偏遠鄉下的孱弱農民，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n如果我們正面進攻的話，在數量上還是會輸。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "不過，",
    "voice": "vo_adv_5144006_017",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "要是他們為了找妳而分散開來……",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "妳不覺得要解決他們就輕鬆多了嗎？",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "對於身為賓客而且深受信賴的妳，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "村長也無法置之不管。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你是為了這種目的，",
    "voice": "vo_adv_5144006_018",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而把我抓起來的嗎！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "竟然打算",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "利用村民們的溫柔！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "只要能贏就好了啊，",
    "voice": "vo_adv_5144006_019",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "能贏就好！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "等我把村裡的傢伙全部收拾掉，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "接著就換觀光客們了。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "剩下的值錢東西和作物，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "我們會全部拿來有效運用的！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "……特別是",
    "voice": "vo_adv_5144006_020",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "這個村子的土壤，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n非常適合用來量產這種「魔物植物」啊！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是、",
    "voice": "vo_adv_5144006_021",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是昨天襲擊我的魔物對吧……！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可是，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "魔物為什麼會聽人類的話！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "妳很在意嗎！？",
    "voice": "vo_adv_5144006_022",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "那我就連同這點也告訴妳吧！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "要馴服魔物",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "雖然需要長期的訓練或才能，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "但這傢伙經過了品種改良，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "會立刻就聽從於人類！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "不枉費我在龍次那傢伙搞砸後，",
    "voice": "vo_adv_5144006_023",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n還是耗費苦心把種子偷出來！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "哼哈哈哈～！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要、",
    "voice": "vo_adv_5144006_024",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要是這種魔物大量增加，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可就大事不妙了！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "得想想辦法才行～！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "……也就是說",
    "voice": "vo_adv_5144006_025",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "你受到了幫派威脅，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n所以沒告訴大家，會有危險的魔物植物來攻擊村子是吧？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "而鈴莓小姐",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "也因此被綁架了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "沒錯，",
    "voice": "vo_adv_5144006_026",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "全部都是我的錯……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "之後不管有任何懲罰我都接受！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n但是現在",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "想先請你幫忙尋找小姑娘！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "村長先生，",
    "voice": "vo_adv_5144006_027",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你不會棄鈴莓不顧吧……！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有錯的人既不是鈴莓也不是龍次！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n而是做出卑鄙行動的幫派啊！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "放心吧，",
    "voice": "vo_adv_5144006_028",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我當然會派出人手。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "要是有什麼萬一，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我也沒臉面對咲戀小姐。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "老頭子……",
    "voice": "vo_adv_5144006_029",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "你也是",
    "voice": "vo_adv_5144006_030",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "為了村子著想才會陷入兩難的吧？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n坦白說你的判斷並不正確，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "但是有錯的當然是威脅人的那一方。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝你，",
    "voice": "vo_adv_5144006_031",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "村長先生……！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只要很多人一起去找，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該就能找到的！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5144006_032",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n得在她有什麼危險之前，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "救出她才行！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我",
    "voice": "vo_adv_5144006_033",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "先去請【王宮騎士團】支援！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "找人的部分就要麻煩大家，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但為了以防萬一還是有備無患！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是啊，麻煩妳了。",
    "voice": "vo_adv_5144006_034",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "走吧，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "男丁們出發去尋找鈴莓小姐！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n不管是鋤頭還是鐮刀都行，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "把能當武器的東西拿在手上！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性村民們",
    "words": "喔喔！！",
    "voice": "vo_adv_5144006_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們也走吧！",
    "voice": "vo_adv_5144006_036",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還差一點點",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就能舉辦鮮花祭了，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們絕對",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要把鈴莓小姐帶回來！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5144006_037",
    "unit_id": 102311
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "老大，",
    "voice": "vo_adv_5144006_038",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "村裡的人開始行動了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "\\n跟預想中的一樣，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "他們似乎打算分頭找人。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "看起來，",
    "voice": "vo_adv_5144006_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "作為賓客來訪的小鬼們似乎也混在裡面……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "反正只是來湊人數的吧？",
    "voice": "vo_adv_5144006_040",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "總之，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "就想辦法處理掉。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "只要像對村民一樣對付他們就好了吧。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "不過，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "記得別殺了村長和龍次，把他們帶到這裡來。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "我要確認村子財產的所在位置，",
    "voice": "vo_adv_5144006_041",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n而且也得和龍次做個了斷。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n……",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你也這麼覺得對吧？",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "那個魔物植物的花瓣，",
    "voice": "vo_adv_5144006_042",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "\\n好像一路朝著森林的方向。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "他們一定",
    "voice": "vo_adv_5144006_043",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是把鈴莓小姐藏在森林深處了！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n畢竟要是在村子裡，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很快就會被發現了。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過，",
    "voice": "vo_adv_5144006_044",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "結果他們還是留下了花瓣，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真是糊塗呢。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "或許他們是不輸鈴莓的",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "冒失幫派也說不定。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "小姑娘，",
    "voice": "vo_adv_5144006_045",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "\\n太瞧不起大人可是不行的喔。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "尤其，",
    "voice": "vo_adv_5144006_046",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "是拿著武器的大人啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "出現了是吧！",
    "voice": "vo_adv_5144006_047",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我要把你們全都……！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等等！",
    "voice": "vo_adv_5144006_048",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這些人之所以會出現，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是因為被他們發現我們來找人了！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "沒辦法了，",
    "voice": "vo_adv_5144006_049",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "我們兵分二路吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "\\n這些傢伙我們會想辦法應付！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "趕快去鈴莓那裡！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「雖然說得很瀟灑，",
    "voice": "vo_adv_5144006_050",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n但大叔你們",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "在戰鬥方面是外行人吧？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我也留下來戰鬥！",
    "voice": "vo_adv_5144006_051",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n雖然很擔心鈴莓，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n但如果是交給哥哥他們就沒有問題！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "抱歉了，",
    "voice": "vo_adv_5144006_052",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "綾音小姐！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這裡就交給他們，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們先往前進吧！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "感謝你們，",
    "voice": "vo_adv_5144006_053",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "要平安無事啊！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "居然會交給小鬼處理而自己逃跑，",
    "voice": "vo_adv_5144006_054",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "你真是墮落了呢，龍次！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "我怎麼可能這麼輕易地放你們走……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_5144006_055",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "全力揮～擊！！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "噗哺啊！？",
    "voice": "vo_adv_5144006_056",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "那、",
    "voice": "vo_adv_5144006_057",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "那傢伙是怎麼回事啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "幫派手下2",
    "words": "\\n不是說他們只是來湊人數的嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "大叔。",
    "voice": "vo_adv_5144006_058",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n太瞧不起小孩子可是不行的喔？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「尤其，",
    "voice": "vo_adv_5144006_059",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是拿著巨大槌子的小孩子！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……",
    "voice": "vo_adv_5144006_060",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n得趕快",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "找到鈴莓小姐才行……！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "可惡，",
    "voice": "vo_adv_5144006_061",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "要是我有早點找人商量就好了……！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是啊！",
    "voice": "vo_adv_5144006_062",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要道歉的話……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就等我們救回鈴莓小姐後，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "向她本人道歉吧！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "這我知道啦……！",
    "voice": "vo_adv_5144006_063",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "很好，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "花瓣數量越來越多……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "就快到了……！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "哼哈哈哈哈哈哈！",
    "voice": "vo_adv_5144006_064",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你來啦，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "龍次！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "看來我那群部下光是應付村民就忙不過來了呢。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "真是的，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "所以我才會想要又強又聽話的棋子。",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "movie",
    "movie_id": "514400601"
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃……",
    "voice": "vo_adv_5144006_065",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總、",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總之我們成功解救鈴莓小姐了！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且也成功打倒壞人了呢！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真抱歉，",
    "voice": "vo_adv_5144006_066",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "直到最後我都這麼冒失，扯了大家的後",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "腿……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要是我沒有被抓住，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "應該就能",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "更輕鬆地",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n對付那些幫派了……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是啊，說的對。",
    "voice": "vo_adv_5144006_067",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n錯的是老大……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "還有搖擺不定而一直迷惘的我。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n要是我當時沒有對威脅感到害怕，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "好好地依賴周遭就好了。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "好了，",
    "voice": "vo_adv_5144006_068",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那麼既然鈴莓小姑娘也到齊了……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n我們就請這傢伙退場吧！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}先生！\\n請你",
    "voice": "vo_adv_5144006_069",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也強化我吧！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "力量開始湧現了呢～！",
    "voice": "vo_adv_5144006_070",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "鏡華！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好的！",
    "voice": "vo_adv_5144006_071",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們聯手打倒它吧！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n用我們兩人的魔法，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "預～備",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓、鏡華",
    "words": "處以懲罰！！",
    "voice": "vo_adv_5144006_072",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "雖然有效果，",
    "voice": "vo_adv_5144006_073",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "但是沒能完全打倒它啊！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我想說火焰比較有效，所以帶了油過來，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n可要是剛才的魔法不管用，那就很難對付了……！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "喔啊，",
    "voice": "vo_adv_5144006_074",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是肥料袋？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "這大概是哪個散漫的笨蛋忘記收起來的吧，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n這種東西根本沒有任何用處……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "等等，",
    "voice": "vo_adv_5144006_075",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "是這樣啊！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n把肥料",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "和油",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "混在一起……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "好了！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n接著就只要",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "等那傢伙再把嘴巴張開就好！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "很好！",
    "voice": "vo_adv_5144006_076",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n你這怪物，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "就讓你再吃一口吧！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "龍次先生，",
    "voice": "vo_adv_5144006_077",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你丟了什麼進去啊！？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好像被它給一口吃掉了……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我是借用了小姑娘的冒失啦！",
    "voice": "vo_adv_5144006_078",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "再給它來一發剛才的攻擊吧！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "包在我身上！",
    "voice": "vo_adv_5144006_079",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "用打掃魔法……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看招～！",
    "voice": null,
    "unit_id": 130811
