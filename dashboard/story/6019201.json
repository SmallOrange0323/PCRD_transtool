  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你打算",
    "voice": "vo_adv_6019201_000",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在海邊玩什麼？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說來聽聽，讓具有熱帶風情又華麗的我，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n作為渡假的參考！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "游、",
    "voice": "vo_adv_6019201_001",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "游泳！？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我不會游……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒、",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒事啦！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果你陪我的話，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我可以考慮看看！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然沒錯呢～！？",
    "voice": "vo_adv_6019201_002",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "刨冰上加",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "冰淇淋，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有島上採的熱帶水果，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n做成水果冰也很不錯呢～！　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我快等不及了～！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "打、",
    "voice": "vo_adv_6019201_003",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "打西瓜，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你覺得我會做那麼孩子氣的事嗎……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是好像很有趣，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是嗎……？　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔唔～",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然你都那樣說了，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n陪你玩一下也可以啦？　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是因為你拜託我才做的喔！？",
    "voice": null,
    "unit_id": 110211
  }
]
