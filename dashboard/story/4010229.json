  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉，我遲到了！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我就是",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿～地",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "去幫困擾的人們……！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難得你說",
    "voice": "vo_adv_4010229_001",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "想在生日跟我見面～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可是可是，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我非常期待……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚喵……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510201"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": "vo_adv_4010229_002",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊、",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊啊──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我睡著了！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難得生日",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可以跟你在一起的～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉，",
    "voice": "vo_adv_4010229_003",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你一直陪在我身邊吧？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "記得",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "之前你還讓我躺在你腿上吧。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不行啊，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我老是給你添麻煩。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真、",
    "voice": "vo_adv_4010229_004",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是的～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好狡猾～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也想看你的睡臉！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我就要這個當生日禮物！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來，",
    "voice": "vo_adv_4010229_005",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "快睡快睡！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "枕頭……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有個肯定能讓你安眠的",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "柔軟東西☆",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510271"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呵呵，",
