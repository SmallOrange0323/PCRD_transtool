  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真受不了……",
    "voice": "vo_adv_5140422_000",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這次可真是折騰啊。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然我們好不容易",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "才搭上飛空艇回到這裡，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n但富美惠學姐那傢伙，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不管被打倒幾次，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都會再站起來呢。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依，",
    "voice": "vo_adv_5140422_001",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "現在不是像主角一樣說明狀況的時候了。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們終於跨越了障礙，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "趕快來進行計畫吧。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "說的也是。",
    "voice": "vo_adv_5140422_002",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n都到這裡來了，",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n富美惠學姐和綠之監視員小姐也不在吧。",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼～",
    "voice": "vo_adv_5140422_003",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒有人來攪局真是太棒了。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼總之，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就趁要顧慮的人不在時完美收場吧～！",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可喜可賀、可喜可賀！",
    "voice": "vo_adv_5140422_004",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～☆",
    "voice": null,
    "unit_id": 129511
  }
]
