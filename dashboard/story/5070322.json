  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n那位大人露出了非常苦惱的表情……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真想代替他……",
    "voice": "vo_adv_5070322_001",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟已經很努力了啊……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就是說啊……",
    "voice": "vo_adv_5070322_002",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n是不是已經可以讓他休息了呢……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟是在放暑假啊……",
    "voice": "vo_adv_5070322_003",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就算只做開心的事情應該也沒關係，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對吧……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "…………",
    "voice": "vo_adv_5070322_004",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "…………啊！！",
    "voice": "vo_adv_5070322_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不行！",
    "voice": "vo_adv_5070322_006",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不能這樣！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為弟弟還沒有放棄啊！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們得繼續鼓勵他才行！",
    "voice": null,
    "unit_id": 117111
  },
  {
