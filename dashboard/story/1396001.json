    "name": "可璃亞",
    "words": "啊～",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "果然我",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還是那個聖女妹妹啊。",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "不……",
    "voice": "vo_adv_1396001_061",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "可璃亞。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n剛才的眼神和氣勢……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "超",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "級帥氣！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦……？",
    "voice": "vo_adv_1396001_062",
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "教官……",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是聖女妹妹，",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "而是用名字叫我了……",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "……沒錯，",
    "voice": "vo_adv_1396001_063",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "至今為止的可璃亞，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "都用充滿慈悲的笑容，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n在後方溫柔地微笑著，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "完全是聖女的模樣。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "但是，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "剛剛的可璃亞並不一樣。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "站在大家身前，",
    "voice": "vo_adv_1396001_064",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "勇敢地走在崇高的路上。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n天使……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "不，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n完全就是",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "女戰神的感覺！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……女戰神。",
    "voice": "vo_adv_1396001_065",
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n──女武神──",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那我……",
    "voice": "vo_adv_1396001_066",
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n已經不是",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "聖女妹妹了……？",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "當然了！",
    "voice": "vo_adv_1396001_067",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n從今天開始",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "就是總長妹妹了！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": "vo_adv_1396001_068",
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "總、",
    "voice": "vo_adv_1396001_069",
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "總長妹妹……？",
    "voice": null,
    "unit_id": 139611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然跟想像的不太一樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但至少不再是「聖女妹妹」就好了吧……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可璃亞如此轉念一想。",
    "voice": null,
    "unit_id": null
  }
]
