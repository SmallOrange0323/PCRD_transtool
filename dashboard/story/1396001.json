    "words": "多虧{0}一行人的呼喊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n總算救出了可璃亞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那之後過了幾天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那",
    "voice": "vo_adv_1396001_000",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "個……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "重新再說一次，",
    "voice": "vo_adv_1396001_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我回來了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真的很抱歉，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "給你添麻煩了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……是，",
    "voice": "vo_adv_1396001_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "今後也請多指教了……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "等等，",
    "voice": "vo_adv_1396001_003",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "抱太緊了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好難受～♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1396001_004",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n今後也",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請多指教了……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……然後呢，",
    "voice": "vo_adv_1396001_005",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "今天請你過來",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是有原因的……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……雖然很突然，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但我。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "打算成為不良分子！",
    "voice": "vo_adv_1396001_006",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我……",
    "voice": "vo_adv_1396001_007",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在他人面前總會",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不自覺地扮演乖孩子。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……我會那樣……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……也是因為這個。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以我已經下定決心，",
    "voice": "vo_adv_1396001_008",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不再扮演乖孩子了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……我知道……",
    "voice": "vo_adv_1396001_009",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但對我來說，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就是需要這麼粗暴的療法……！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我也有請講師來，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可以一起過來嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "……啥？",
    "voice": "vo_adv_1396001_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "聖女妹妹要當不良分子？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n不可能不可能，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "放棄那種想法吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──可璃亞請來的講師，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n是之前打工時認識的地痞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "我",
    "voice": "vo_adv_1396001_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "因為聖女妹妹的淨化力量改過自新了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n也離開了小隊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "現在過著安穩的生活。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "那就這樣，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "我要去做日常行程的整理花圃了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請、",
    "voice": "vo_adv_1396001_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "已經不想當乖孩子，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也不想當聖女妹妹了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "拜託了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "就算妳這麼說，",
    "voice": "vo_adv_1396001_013",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n也有分",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "適合與不適合吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但是……",
    "voice": "vo_adv_1396001_014",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "既然前地痞都改過自新了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那我也有成為不良分子的可能吧……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "拜託了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "拜",
    "voice": "vo_adv_1396001_015",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "託了，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……地痞教官。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "哇啊啊啊啊……",
    "voice": "vo_adv_1396001_016",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "……都、",
    "voice": "vo_adv_1396001_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "都被這樣拜託了，那也辦法。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "那麼就",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "試試看",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "做不良分子的特訓吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "前地痞",
    "words": "\\n……首先。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要磨刀……",
    "voice": "vo_adv_1396001_018",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "切肉嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那、",
    "voice": "vo_adv_1396001_019",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是料理的特訓，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請讓我做不良分子的特訓……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……咦，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是在說小菜？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原、",
    "voice": "vo_adv_1396001_020",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是要我用像刀一樣銳利的眼神瞪人啊……！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我試試看！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……對著哥哥～",
    "voice": "vo_adv_1396001_021",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "蛤啊啊啊啊啊～啊？",
    "voice": "vo_adv_1396001_022",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n你是在～",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "看什麼看啊啊啊啊～？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……開、",
    "voice": "vo_adv_1396001_023",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "開玩笑的♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n怎麼樣？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "有很像不良分子嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這、",
    "voice": "vo_adv_1396001_024",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還只是剛開始而已！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "再來要",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "有像不良分子的座右銘……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n像是「幹架最行」、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "「究極無敵」……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
