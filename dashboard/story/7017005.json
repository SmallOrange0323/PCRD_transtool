[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在{0}與雪的支援下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克莉絲提娜以壓倒性的力量",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n將成群結隊來襲的魔物打倒、殲滅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣就差不多斬乾淨了吧。",
    "voice": "vo_adv_7017005_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還挺有意思的嘛，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我還以為只有小嘍囉呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要交給克莉絲提娜小姐，",
    "voice": "vo_adv_7017005_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我能照鏡子的時間就變長了，真開心。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這就是互惠互利、各取所需呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳明明就沒付出什麼吧。",
    "voice": "vo_adv_7017005_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "剛才打倒的魔物好像掉落了東西。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "閃閃發光呢。",
    "voice": "vo_adv_7017005_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "記憶之鑰嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "且慢。",
    "voice": "vo_adv_7017005_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "光芒是不是變得越來越強烈了？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這玩意是怎麼回事……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": "vo_adv_7017005_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "以耀眼光芒為背景的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是如此地神秘……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這絕對是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "今天我最美的瞬間……♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天午後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在車站前的鬧區，有位美麗的異國女性走在路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然想辦法找理由來到了這個國家沒錯，",
    "voice": "vo_adv_7017005_006",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但晶似乎隱藏了蹤影。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "果然是察覺到我要來所以逃走了嗎？",
    "voice": "vo_adv_7017005_007",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得想要來見見朋友的說。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯……？",
    "voice": "vo_adv_7017005_008",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你不是",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "晶中意的那小子嗎。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你在這種地方做什麼？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你問我嗎？",
    "voice": "vo_adv_7017005_009",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我為了給朋友一個驚喜",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n特地越洋過來，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "結果白忙一場。目前是這樣唷。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那",
    "voice": "vo_adv_7017005_010",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子你在這做什麼呢？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "喂──",
    "voice": "vo_adv_7017005_011",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "久等了。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等很久了嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很久吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "頭髮總是弄不順，真是傷腦筋。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看起來很完美吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_7017005_012",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這位姐姐",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是你認識的人嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼啊，",
    "voice": "vo_adv_7017005_013",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你跟人約好要碰面了嗎。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我好像打擾到你們了啊，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那我就在這裡先失陪了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_7017005_014",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是有什麼話想跟我說嗎？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n什麼？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我看起來很疲倦……？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "確實，",
    "voice": "vo_adv_7017005_015",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這陣子業務堆積如山呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過那也是為了",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "擠出今天一整天的休假，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n才把行程表排得如此緊湊……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過結果也是白費力氣，",
    "voice": "vo_adv_7017005_016",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "徒勞罷了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "肩膀痠得要命啊。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是的。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "晶那傢伙，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到底是跑去哪裡閒晃了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀，",
    "voice": "vo_adv_7017005_017",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不小心讓你們聽我發無聊的牢騷。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是大人的壞習慣，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原諒我吧。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一起來……？",
    "voice": "vo_adv_7017005_018",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們是要去哪裡？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔，",
    "voice": "vo_adv_7017005_019",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該怎麼做呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就這樣回國，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "繼續工作也不是不行……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好不容易費盡心思排出的空檔，",
    "voice": "vo_adv_7017005_020",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就這樣打道回府也很乏味。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "想至少紓個壓再回去呀……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……好。",
    "voice": "vo_adv_7017005_021",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就答應",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你的邀約吧。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果你帶我到奇怪的地方，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到時你要負起相應的責任唷♪",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦？",
    "voice": "vo_adv_7017005_022",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "still",
    "still_id": "701700501"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "設立在鬧區中心的足浴嗎。",
    "voice": "vo_adv_7017005_023",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且還",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "附設咖啡廳，真是有趣。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最近才開幕沒多久呢。",
    "voice": "vo_adv_7017005_024",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以泡足湯的咖啡廳",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n很少見吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "克莉絲提娜小姐，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒錯吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳是第一次泡足湯嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "恢復疲勞、",
    "voice": "vo_adv_7017005_025",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "養顏美容的效果也值得期待呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這家的花草茶",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還是當店特調呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為了獲得女性客層，",
    "voice": "vo_adv_7017005_026",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也花了心思在飲料和甜點上嗎。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦……",
    "voice": "vo_adv_7017005_027",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "味道也還不錯。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "客人，",
    "voice": "vo_adv_7017005_028",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "請問可以開始",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "為您按摩了嗎？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_7017005_029",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "拜託了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來如此……",
    "voice": "vo_adv_7017005_030",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個、確實不錯……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感覺累積的疲勞都隨之化解……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯……",
    "voice": "vo_adv_7017005_031",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這在那邊似乎也能成為一門生意呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n若是如此，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "首先要考量的就是",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "地點與客群嗎……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "咦？",
    "voice": "vo_adv_7017005_032",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那個……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "如果認錯人的話不好意思，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n請問您是克莉絲提娜‧摩根",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗎？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯，",
    "voice": "vo_adv_7017005_033",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就是克莉絲提娜本人。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊啊，",
    "voice": "vo_adv_7017005_034",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "果然如此！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "假如您不介意，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "請問可以留下您的簽名與照片，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "供本店裝飾嗎？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我們的店",
    "voice": "vo_adv_7017005_035",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "才剛開幕沒多久，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n這是第一次有名人",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "來訪！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我不會勉強您，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "還請您考慮看看……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "簽名是沒問題……",
    "voice": "vo_adv_7017005_036",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過因為現在是私人時間，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n拍攝照片就容我婉拒了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "簽名板在哪裡呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以麻煩妳拿過來嗎？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊，",
    "voice": "vo_adv_7017005_037",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "非常感謝您！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "請寫在這上面！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "哇……",
    "voice": "vo_adv_7017005_038",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "真是一手好字……！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n我會把它擺在",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "店裡顯眼的地方的！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼要拒絕拍攝照片呢？",
    "voice": "vo_adv_7017005_039",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n假如是我，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "別說一張，想拍幾張都樂意奉陪唷。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "咦，",
    "voice": "vo_adv_7017005_040",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "您說的是真的嗎？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "其實我們現在剛好",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "在找可以刊載在宣傳手冊上",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n的廣告攝影模特兒……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "對於提供協助的客人，",
    "voice": "vo_adv_7017005_041",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n本店會提供",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "能在店內使用的免費票券。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "您意下如何呢……？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_7017005_042",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然會看上我的可愛容貌，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳的品味不錯呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來吧，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管是要擺什麼姿勢都行唷。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "非常感謝您！",
    "voice": "vo_adv_7017005_043",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那麼我們馬上就開始拍攝吧。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吶，",
    "voice": "vo_adv_7017005_044",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是這種看起來放鬆的姿勢好呢？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "稍微可愛一點的風格好呢？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來吧，",
    "voice": "vo_adv_7017005_045",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再多注視我一點。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的可愛及",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n要好好將我的魅力",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一點不漏地收在相框裡唷？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你們選擇我是完全正確的唷。",
    "voice": "vo_adv_7017005_046",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這世上不存在比我還美麗的模特兒呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "世界第一可愛的我……！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_7017005_047",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可笑至極。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n要自稱是世界第一，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣做還差得遠。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在的妳，不過是擺出別人要你擺的姿勢，",
    "voice": "vo_adv_7017005_048",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n接受拍攝而已。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──在那之中有妳的美學存在嗎？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦？",
    "voice": "vo_adv_7017005_049",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "克莉絲提娜小姐能示範一下嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n讓我看看何謂勝過我的「美」。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為什麼我非得跟妳較量不可。",
