    "name": "克莉絲提娜",
    "words": "\\n只要試著去回想，就會像霧氣籠罩一般變得模糊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼啊……",
    "voice": "vo_adv_7017005_073",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我睡著了嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好像作了一個奇怪的夢……",
    "voice": "vo_adv_7017005_074",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總覺得身體好倦怠啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吶，",
    "voice": "vo_adv_7017005_075",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "事情辦完的話我們就回去吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "累了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我與這傢伙是同個時間點睡著的嗎。",
    "voice": "vo_adv_7017005_076",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難道是被什麼人施加了睡眠魔法嗎……？　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了？",
    "voice": "vo_adv_7017005_077",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這麼盯著我看。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……好像也並非如此。",
    "voice": "vo_adv_7017005_078",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n身體看起來不像是有異狀。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "難道妳……",
    "voice": "vo_adv_7017005_079",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為我太美麗而看入迷了？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以特別讓克莉絲提娜小姐",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "多看幾眼唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要出借我設施等等的禮還沒回呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，",
    "voice": "vo_adv_7017005_080",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誰什麼時候說要借妳設施了？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不要給我擅自決定啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦～？",
    "voice": "vo_adv_7017005_081",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這可是能為我的美貌做出貢獻唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這種機會",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可不多呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且也是能夠說出「這傢伙是我栽培的」",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大好機會唷？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種話",
    "voice": "vo_adv_7017005_082",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "等妳能夠讓我深信，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n借妳以後絕對不會後悔再說吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在這個狀態還是有點讓人擔心，",
    "voice": "vo_adv_7017005_083",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我沒辦法直接就點頭。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還是現在這個狀態的話喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克莉絲提娜嘴角掛著微笑，率先走下了塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪與{0}面面相覷，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n從後頭跟上克莉絲提娜的腳步。",
    "voice": null,
    "unit_id": null
  }
]
