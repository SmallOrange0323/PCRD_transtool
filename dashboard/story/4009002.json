    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰想要",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一頭栽進魔物的巢穴裡啊。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我還滿常這樣的喔？",
    "voice": "vo_adv_4009002_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為是獲得大量料理食材的好機會♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "剛剛打倒的魔物，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不知道現在還能不能回收素材……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不能，",
    "voice": "vo_adv_4009002_023",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且也不需要！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n拜託妳，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可以不要滿腦子都是魔物料理嗎～！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可一行人，發現了潛藏露娜之塔其中的新謎團。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了尋找有關{0}記憶的線索，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們接下來也不畏懼未知的危險，繼續展開探索。",
