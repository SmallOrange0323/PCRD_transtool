[
  {
    "type": "background",
    "bg_id": "500522"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是曾經在牧場發生過的事──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500152"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這次只是個教訓，",
    "voice": "vo_adv_5088005_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你們休想再來偷我們的起司！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "啾……",
    "voice": "vo_adv_5088005_001",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "各位，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們走。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "頭目！",
    "voice": "vo_adv_5088005_002",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "我們不能只有挨打的份啊！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "繼續打下去我們沒有勝算。",
    "voice": "vo_adv_5088005_003",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "撤退吧，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "啾三。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "啾……",
    "voice": "vo_adv_5088005_004",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "總有一天",
    "voice": "vo_adv_5088005_005",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我一定會雪恥。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n然後終有一日，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "牧場的起司我會一個不剩地奪走……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "background",
    "bg_id": "500123"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "時光飛逝，在咲戀育幼院的屋頂裡──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "頭目、",
    "voice": "vo_adv_5088005_006",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "頭目。",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n您怎麼了？",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "有心事嗎？",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我在想，時機差不多成熟了……",
    "voice": "vo_adv_5088005_007",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n這陣子讓你們",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "吃苦了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n都是我虧待你們，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "那麼",
    "voice": "vo_adv_5088005_008",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "我們終於……",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "沒錯。",
    "voice": "vo_adv_5088005_009",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "我們會追隨頭目",
    "voice": "vo_adv_5088005_010",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "直到最後一刻。",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "各位。",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n我沒說錯吧？",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾",
    "words": "啾！",
    "voice": "vo_adv_5088005_011",
    "unit_id": 15915
  },
  {
    "type": "dialogue",
    "name": "啾太",
    "words": "啾！",
    "voice": "vo_adv_5088005_012",
    "unit_id": 15913
  },
  {
    "type": "dialogue",
    "name": "啾也",
    "words": "啾！",
    "voice": "vo_adv_5088005_013",
    "unit_id": 15914
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "好，",
    "voice": "vo_adv_5088005_014",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "去準備吧！",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "整理行囊，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "拿好武器。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n聽好了，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們今夜就從這裡出發，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "小心不要被發現了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "手下們",
    "words": "啾！",
    "voice": "vo_adv_5088005_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們被趕出牧場後，",
    "voice": "vo_adv_5088005_016",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "好不容易流落到這個地方……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n但辛酸的時刻就要結束了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們用廚房的鍋碗瓢盆武裝。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n即便在這種屋簷下，手下也增加了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "如今正是……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "回鄉的好時機。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "啊啊……",
    "voice": "vo_adv_5088005_017",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "好懷念起司的味道，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "還有令人難以忘懷的牧場香氣……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n光是回憶，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "鬍鬚就蠢蠢欲動了呢。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天也是綾音在育幼院內巡邏。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉，",
    "voice": "vo_adv_5088005_018",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是什麼啊？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗯？",
    "voice": "vo_adv_5088005_019",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這不是腳印嗎。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n是從哪裡延伸過來的呢？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這裡是",
    "voice": "vo_adv_5088005_020",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "美咲原本要留宿的房間啊！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "腳印的主人就躲在這裡吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「可能喔。",
    "voice": "vo_adv_5088005_021",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不但有奇怪的聲音，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "柱子上還有傷痕，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n所以她後來才住到妳們的房間吧？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒錯……",
    "voice": "vo_adv_5088005_022",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但那時候並沒有任何腳印。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "地上也沒有掉這種東西……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是什麼紙呢？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "上面畫著起司。",
    "voice": "vo_adv_5088005_023",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有像文字的符號……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉看得懂嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗯……",
    "voice": "vo_adv_5088005_024",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "日期糊掉了讀不出來……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我看看喔？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……漫長流浪的最後終於來到這個安居地。",
    "voice": "vo_adv_5088005_025",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n但是起司不夠。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沒辦法讓大家再繼續餓著肚子了……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n他們似乎是從某個地方流浪到這裡的。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「下一頁是……",
    "voice": "vo_adv_5088005_026",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n尋找可當武器的東西。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "鍋子、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "叉子、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "刀子……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n為了提前準備終將來臨之日，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我下達了武裝指示。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "結果會如何……」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「這篇好像是最新的日記。",
    "voice": "vo_adv_5088005_027",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我繼續",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "唸喔。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n庭院好熱鬧。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "起司的氣味乘風飄來。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n好想回家。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "好想回去吃起司。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "也想讓大家吃起司。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「故鄉的味道，",
    "voice": "vo_adv_5088005_028",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "牧場的味道，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那個起司倉庫的味道……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我們一族",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "靈魂的味道……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n起司、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "起司、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "起司、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "起司……」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是",
    "voice": "vo_adv_5088005_029",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "之前在這裡的那些傢伙的日記吧……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗯，",
    "voice": "vo_adv_5088005_030",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "根據內容，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "最新的一頁",
    "voice": null,
    "unit_id": 2111
  },
  {
