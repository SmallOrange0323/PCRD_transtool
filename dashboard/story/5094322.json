[
  {
    "type": "dialogue",
    "name": "純",
    "words": "很好，",
    "voice": "vo_adv_5094322_000",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接二連三冒出來的手下們",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也大部分都清掉了。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n接著只剩老大",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "和牠身旁的兩個手下……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n唔？",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "蘑菇老大的舉止有些可疑呢。",
    "voice": "vo_adv_5094322_001",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n看起來似乎在對後方的手下作出指示……？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個手下所拿的武器前端……",
    "voice": "vo_adv_5094322_002",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是不是聚集了不少孢子？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "該不會，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "牠們打算把那個丟向我們……？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5094322_003",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個可能性很高。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "從剛才開始，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的身體便開始有些許的麻痺感。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n或許原因就出在那些孢子上。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "畢竟毒蘑菇十之八九會讓人麻痺呢……",
    "voice": "vo_adv_5094322_004",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們瞄準後方的手下攻擊吧！",
    "voice": null,
    "unit_id": 122211
  }
]
