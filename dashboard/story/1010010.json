  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n畢竟王子先生是很棒的人呀，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不只是我們這的孩子們，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "其他人",
