    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……咦！？",
    "voice": "vo_adv_1010010_027",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n王、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您是什麼時候！？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": "vo_adv_1010010_028",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
