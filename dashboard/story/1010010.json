  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "包含了對平時的感謝之意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真步打算為了{0}舉辦一場下午茶會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因此立刻著手開始在公會小屋內準備了起來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "茶和點心就放在這邊……",
    "voice": "vo_adv_1010010_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "準備完成～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010010_001",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然能和王子先生兩人一起喝下午茶，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n看來今天將會是最棒的一天呢～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "玄關傳來了聲響……",
    "voice": "vo_adv_1010010_002",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該不會，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是王子先生來了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣的話得去迎接他才行呀～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "吶吶，王子殿下！",
    "voice": "vo_adv_1010010_003",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n不要只是摸摸人家的頭，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "也抱抱我嘛～♪",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n我要公主抱～♪",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_1010010_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不只是王子先生而已，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有其他客人呢？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我、",
    "voice": "vo_adv_1010010_005",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我們擅自就進來了真的很抱歉。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我們正好",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "在玄關和王子殿下碰了個正著，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n然後跟在打算進來的王子殿下後頭，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "這孩子也一起跑了進來……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們的公會小屋",
    "voice": "vo_adv_1010010_006",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是來者不拒的，所以沒關係唷～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "記得沒錯，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您是那天迷路的女孩子的",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "母親對吧？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "當時，",
    "voice": "vo_adv_1010010_007",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真的非常感謝您的幫忙。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n今天是",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "專程想來道個謝。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大姐姐！",
    "voice": "vo_adv_1010010_008",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "　王子殿下！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n謝謝你們！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不用這樣，",
    "voice": "vo_adv_1010010_009",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還請別這麼客氣。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那也是咱們",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "【哞哞自衛隊】的職責嘛♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "啊，",
    "voice": "vo_adv_1010010_010",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "這個是我們烤的蛋糕。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n若不介意的話，請和【哞哞自衛隊】的各位，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "還有王子殿下一塊嘗嘗看吧。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我也有幫忙唷！",
    "voice": "vo_adv_1010010_011",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "厲害吧厲害吧～♪",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010010_012",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的很厲害呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "蛋糕就讓我們在下午茶的時候好好享用了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "那麼，",
    "voice": "vo_adv_1010010_013",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我們也差不多……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我不要～！",
    "voice": "vo_adv_1010010_014",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n我要和王子殿下在一起～！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真是的，",
    "voice": "vo_adv_1010010_015",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n妳這樣子給王子殿下添麻煩是不行的喔？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010010_016",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生真的很受女孩子們的歡迎呢♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "小妹妹，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳也喜歡上",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗯！",
    "voice": "vo_adv_1010010_017",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我長大要當公主，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n然後和王子殿下結婚的嘛～！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦……",
    "voice": "vo_adv_1010010_018",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "妳又在說這種話了……",
    "voice": "vo_adv_1010010_019",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "妳這樣子給人家添麻煩是不行的喔？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n好了，我們要回去了唷。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真步小姐，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真的非常謝謝您。",
