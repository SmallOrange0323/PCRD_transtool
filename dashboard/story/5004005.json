[
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後。\\n透過凱留的魔法在水中高速移動，\\n{0}一行人來到了海底的遺跡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但是當場就被魔物們團團包圍，舉步維艱。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之，",
    "voice": "vo_adv_5004005_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就交給那個叫鈴莓的傢伙帶路了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我這邊先",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "專心應付出現的魔物。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "知道了，",
    "voice": "vo_adv_5004005_001",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就交給我來帶路吧。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我正在透過探測魔法",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "尋找可可蘿的所在位置，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n和解析遺跡的內部構造等等。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然是挺複雜的，",
    "voice": "vo_adv_5004005_002",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但只要把握好正確路線就不會迷路了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n應該能用最短路徑，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "到達可可蘿的所在之處。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "陷阱之類的",
    "voice": "vo_adv_5004005_003",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也可以透過探測魔法，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n事先確認好位置",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "以避開。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過",
    "voice": "vo_adv_5004005_004",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "冒出來的魔物，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就必須靠各位除掉了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我這邊",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "光是使用探查魔法就已經忙不過來了，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就麻煩大家了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然妳說大家，",
    "voice": "vo_adv_5004005_005",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "基本上就是指我吧。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是平時這種情況的話，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只要把貪吃佩可扔進魔物群之中，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n她就會擅自輕鬆搞定了說。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對、",
    "voice": "vo_adv_5004005_006",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對不起。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這次，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我真的成了絆腳石了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真～的，妳這個一點用也沒有的傢伙……",
    "voice": "vo_adv_5004005_007",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n轉來轉去真的是有夠礙眼，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n至少也待在一旁別受傷就好了啊。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚。",
    "voice": "vo_adv_5004005_008",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留說話比平常還要狠～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺已經沒有顧慮我的餘地了呢。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n確實，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我至少不要妨礙人家，先退下來好了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………退後一步來到這個位置，",
    "voice": "vo_adv_5004005_009",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就是{0}平常的站位了對吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}總是，",
    "voice": "vo_adv_5004005_010",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在戰鬥時",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "站在我們的後方……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n焦慮地望著我們對吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你一直都",
    "voice": "vo_adv_5004005_011",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感受著……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這種無力感",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和疏離感吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_5004005_012",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是對不起一直盯著你看了……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得和{0}產生了一點共鳴，\\n有種感同身受的感覺。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "重要的伙伴還陷入危險之中，",
    "voice": "vo_adv_5004005_013",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n什麼事也做不了，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是令人焦急。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯。",
    "voice": "vo_adv_5004005_014",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵呵～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天在各種方面，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺都更親近{0}了呢。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂～！",
    "voice": "vo_adv_5004005_015",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別在那邊調情了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "快點給我過來！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哦，",
    "voice": "vo_adv_5004005_016",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看。",
    "voice": "vo_adv_5004005_017",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n面向我們前方的位置深處，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是有一道巨大的門嗎。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可蘿仔似乎就在",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那道門後的大空洞裡面了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的。",
    "voice": "vo_adv_5004005_018",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還有生命跡象在，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可可蘿還活著……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真想趕快把她救出來。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。",
    "voice": "vo_adv_5004005_019",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是這道門，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "似乎是個麻煩的東西呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是要靠魔法才能將鎖解開的機關，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但我不知道解開的方法。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說得沒錯。雖然調查了一番，",
    "voice": "vo_adv_5004005_020",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但我仍無法解析門上所設置的魔術迴路……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n似乎是用了某種手段，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "保護著魔術迴路不被解開的樣子。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼辦？",
    "voice": "vo_adv_5004005_021",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然我們知道可蘿仔還活著，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但完全不知道她的狀況如何……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然而卻陷入這種無法前進的窘境，",
    "voice": "vo_adv_5004005_022",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明想盡早闖進去後營救的。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "若有{0}的強化的話，",
    "voice": "vo_adv_5004005_023",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n或許能強行將門給破壞掉也說不定。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也就是用破壞魔法亂打一通，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "強行將門打壞直接突擊。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果沒有其他辦法，我認為我們應該這麼做……",
    "voice": "vo_adv_5004005_024",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有想到什麼其他能打開這道門的方法嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如果能用最聰明的方式打開這道門的話",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當然是再好不過了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯，",
    "voice": "vo_adv_5004005_025",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n該怎麼辦才好",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "，{0}？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……好喔，",
    "voice": "vo_adv_5004005_026",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就是用粗魯的方法囉。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼{0}，你就給予我最大值的強化吧。",
    "voice": "vo_adv_5004005_027",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n用我勤奮努力學來最強的破壞魔法，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n來大破壞一番吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請{0}集中強化凱留小姐吧！",
    "voice": "vo_adv_5004005_028",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為貪吃佩可小姐目前處於虛弱化狀態，",
    "voice": "vo_adv_5004005_029",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n而我",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "又不太擅長攻擊魔法……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "將{0}強化夥伴的能力",
    "voice": "vo_adv_5004005_030",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n全部集中在凱留小姐身上……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是凱留小姐",
    "voice": "vo_adv_5004005_031",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "傾全力把自己現有的所有力量，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n灌輸到她的破壞魔法的作戰。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這大概，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是我們目前所能做到的最大努力了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就這麼辦了！",
    "voice": "vo_adv_5004005_032",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然我的負擔重到不像話，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但可沒時間囉嗦了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}，",
    "voice": "vo_adv_5004005_033",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全力強化我吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這種程度的阻礙，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就由我來華麗地突破！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太好了，",
    "voice": "vo_adv_5004005_034",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "來了來了來了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}的力量蔓延開來，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我全身的細胞都躁動起來了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣一定就行得通了……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈哈☆",
    "voice": "vo_adv_5004005_035",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n任何妨礙我的東西，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我都要將它轟走！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊啊啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好耶，",
    "voice": "vo_adv_5004005_036",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "出現一個大洞了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n突擊吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_5004005_037",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的～也是……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n若為了將門打開而用盡魔力，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "導致力量全失的話可就本末倒置了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "用一般方法、",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不浪費任何力氣將門打開才是最好的辦法。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是，",
    "voice": "vo_adv_5004005_038",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎樣做才能把門給……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸欸，你們有看見那邊有一個像是蓄水池的東西嗎？",
    "voice": "vo_adv_5004005_039",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在水池底下，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "似乎設有控制桿？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸……",
    "voice": "vo_adv_5004005_040",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明還有點距離，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看得倒是挺清楚的嘛貪吃佩可？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_5004005_041",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我視力還算不錯喔！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說回來。",
    "voice": "vo_adv_5004005_042",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n門和控制桿上，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n都嵌有同樣顏色像是寶玉的東西在上面……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像推拉一下控制桿，",
    "voice": "vo_adv_5004005_043",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就能把門打開了～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊，有這個可能呢。",
    "voice": "vo_adv_5004005_044",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在這遺跡中，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "四處可見這種機關呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這種機關明明只會造成生活不便，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是謎一般的小把戲呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種遺跡本來就不是拿來生活的地方吧？",
    "voice": "vo_adv_5004005_045",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想應該是陵墓",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或是藏寶庫一樣的地方",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才對。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起這個……",
    "voice": "vo_adv_5004005_046",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可以讓我來啟動那個控制桿嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n到目前為止，我還什麼忙都沒幫上，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡讓我來效勞吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。",
    "voice": "vo_adv_5004005_047",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的也是，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "控制桿似乎在水池裡……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我對自己的泳技沒什麼自信，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就交給妳來吧。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過",
    "voice": "vo_adv_5004005_048",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要小心為妙，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "水中或許也有魔物也說不定。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是！",
    "voice": "vo_adv_5004005_049",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼我去去就回……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一二三，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "噗通～☆",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好。",
    "voice": "vo_adv_5004005_050",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n水比想像中的還要清澈，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能夠清楚得看見周圍。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "控制桿是在……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這邊嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哦，",
    "voice": "vo_adv_5004005_051",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "找到了！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只要拉一下",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個控制桿就可以了吧？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔姆姆姆……！",
    "voice": "vo_adv_5004005_052",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n唔唔，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有「皇家裝備」的加持",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好吃力啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n有夠重的，無法啟動控制桿！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是！",
    "voice": "vo_adv_5004005_053",
    "unit_id": 107511
  },
  {
