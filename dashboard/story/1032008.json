[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}陪秋乃購物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這趟購物真棒呢！",
    "voice": "vo_adv_1032008_000",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這都要多虧你為我帶路到店裡呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我雖然有聽說店舖在這附近，",
    "voice": "vo_adv_1032008_001",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但是我獨自一人怎麼走都到不了……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你知道這間店真是太好啦。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "喏，",
    "voice": "vo_adv_1032008_002",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你看看我剛買的首飾吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n閃閃發亮，非常美麗呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就像是首飾本身在發著光一樣……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎、哎呀？",
    "voice": "vo_adv_1032008_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n真的在發光……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這道光，我之前好像也有看過？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "我說，上課真無聊呢……",
    "voice": "vo_adv_1032008_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n不能趕快結束嗎。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "咦？喂，你的手機在響喔。",
    "voice": "vo_adv_1032008_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "喂，上課時間",
    "voice": "vo_adv_1032008_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n給我把手機電源關掉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "如果你有要緊的事，就到教室外面講。",
    "voice": "vo_adv_1032008_007",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀。",
    "voice": "vo_adv_1032008_008",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n早安，今天天氣真好呢。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦，你正在上課嗎？",
    "voice": "vo_adv_1032008_009",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這樣啊。我可以自由地選擇學分課程，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n所以今天沒有課喔。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "比起那個，{0}大人。",
    "voice": "vo_adv_1032008_010",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就是……如果你方便，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n接下來能陪我一會嗎？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可以的話，",
    "voice": "vo_adv_1032008_011",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我想直接跟{0}大人見個面呢。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦，你問我現在在哪裡？",
    "voice": "vo_adv_1032008_012",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n其實……我已經",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n在{0}大人附近了喔！",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "什、什麼！？",
    "voice": "vo_adv_1032008_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n有直升機要降落在屋頂耶！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "咦！為什麼！？",
    "voice": "vo_adv_1032008_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n是什麼演習嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "總之去看看吧！",
    "voice": "vo_adv_1032008_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n感覺比無聊的課還要有趣多了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "103200801"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "喔～呵呵呵！",
    "voice": "vo_adv_1032008_016",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n驚動到各位真是抱歉。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n本小姐是藤堂秋乃，今後請多關照。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我有件事想要詢問一下，",
    "voice": "vo_adv_1032008_017",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n請問{0}大人在哪裡呢？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "什麼？",
    "voice": "vo_adv_1032008_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n原來這場騷動是因為{0}啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510180"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "找不到呢……",
    "voice": "vo_adv_1032008_019",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但不論你躲在哪裡，我都會把你找出來的。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "background",
    "bg_id": "510180"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就算你逃到天涯海角，我也會緊追不捨……",
    "voice": "vo_adv_1032008_020",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我已經查出，你直到剛才都在學校裡面囉。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人，還不肯出來嗎？",
    "voice": "vo_adv_1032008_021",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "…………",
    "voice": "vo_adv_1032008_022",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這樣啊，如果你不自己出來的話，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我也自有一套方法喔。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我要祭出懸賞金囉！",
    "voice": "vo_adv_1032008_023",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n找到{0}大人的人，我就致贈一筆錢！",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "真的假的！",
    "voice": "vo_adv_1032008_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n喂喂――！他在這裡――！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀，原來你在這麼近的地方呢。",
    "voice": "vo_adv_1032008_025",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦，你問我有什麼事？",
    "voice": "vo_adv_1032008_026",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這麼說來，我還沒有",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n把要事傳達給你呢。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "其實，我希望你務必能夠向我介紹庶民生活的地方啊。",
    "voice": "vo_adv_1032008_027",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n昨晚一想到可以請你為我介紹，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就讓我期待得坐立不安，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "所以今天就跑來學校囉。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……你說你還有課，所以沒辦法？",
    "voice": "vo_adv_1032008_028",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "既然如此，沒有課就可以了吧？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "怎麼了，怎麼了？",
    "voice": "vo_adv_1032008_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n怎麼這麼吵啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀，剛剛好呢。",
    "voice": "vo_adv_1032008_030",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n您就是校長吧。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可以請您把今天的課取消嗎？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "不、不……就算妳說這種荒唐的事情……",
    "voice": "vo_adv_1032008_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你",
    "voice": "vo_adv_1032008_032",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "知道你在跟誰抱怨嗎？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我可是藤堂秋乃哦？",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只要我聯絡熟人，",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就可以利用藤堂家的力量，將區區一兩間學校……",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "噫！我、我知道了！",
    "voice": "vo_adv_1032008_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n今天的課就上到這裡！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "獲得許可了呢，這樣一來就算外出也沒關係啦。",
    "voice": "vo_adv_1032008_034",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那麼，我們馬上出發吧！",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來吧，請抓住我的手，要走囉。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀，你已經在想著要去哪裡了呢。",
    "voice": "vo_adv_1032008_035",
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "明明直到剛才都還在拒絕我，現在倒是很積極嘛。",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我真開心。我們一起好好玩吧！",
    "voice": null,
    "unit_id": 103231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了～",
    "voice": "vo_adv_1032008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說，那孩子做事還真是不得了。",
    "voice": "vo_adv_1032008_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只要下定決心，就會勇往直前呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n或者該說是唯我獨尊的感覺？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，秋乃本身也不是壞孩子，",
    "voice": "vo_adv_1032008_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而且透過和你接觸，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她好像也一點一點地學會庶民的標準了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "直到她能確實掌握世間的常識為止，",
    "voice": "vo_adv_1032008_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你就再稍微照顧她也不錯啊？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣的話，她可能會成為滿可愛的女孩呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過因為是你，就算我不說，",
    "voice": "vo_adv_1032008_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你應該也會這麼做吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，這次就先聊到這裡。",
    "voice": "vo_adv_1032008_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n再見囉～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呼……",
    "voice": "vo_adv_1032008_042",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我好像睡著了呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我做了不可思議的夢喔。",
    "voice": "vo_adv_1032008_043",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我夢到為了請教庶民的事情，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n而前去迎接{0}大人……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊，沒錯。",
    "voice": "vo_adv_1032008_044",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n搭乘像飛空艇一樣，搭乘會飛在空中的交通工具――",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人該不會也跟我做了相同的夢吧？",
    "voice": "vo_adv_1032008_045",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是不可思議呢……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可是，真是個好夢呢！",
    "voice": "vo_adv_1032008_046",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n讓{0}大人為我介紹城鎮，似乎會很開心呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有啦！不只是在夢裡，也請你實際為我做介紹吧！",
    "voice": "vo_adv_1032008_047",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n一定會很有趣的！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果這麼說定了，",
    "voice": "vo_adv_1032008_048",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那我明天就搭乘飛空艇去你家接你囉！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呵呵……真可說是重現夢裡的情境呢！",
    "voice": "vo_adv_1032008_049",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "秋乃這麼說著，露出了開心的微笑。",
    "voice": null,
    "unit_id": null
  }
]
