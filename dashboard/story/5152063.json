  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "初夢への願いか。",
    "voice": "vo_adv_5134063_000",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こ",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こはもちろん、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "名探偵として",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "さらなる難事件を",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n解決することを願うとしよう。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "もちろん、",
    "voice": "vo_adv_5134063_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "助手くんも一緒だ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n名探偵には優れた助手が必要だし……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "じ、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "事件解決を通して、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "絆も深まるかもしれないしね！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "それじゃあ、",
    "voice": "vo_adv_5134063_002",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "明日も早いし",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "休むとしよう。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "……すぅ",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "……すぅ……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406301"
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "う……",
    "voice": "vo_adv_5134063_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ん……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ああ、",
    "voice": "vo_adv_5134063_004",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "すまない助手くん。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "長丁場だったから、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "少し集中力が切れかけていたようだ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "今回尾行している相手は、",
    "voice": "vo_adv_5134063_005",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "用心深いことで有名だからね。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こちらに気付かれないよう、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "慎重に行動する必要がある。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "だから私たちは今、",
    "voice": "vo_adv_5134063_006",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "このように対象の斜め後ろから、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nカップルを装って",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "群衆に溶け込みつつ尾行しているわけだ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "どうだい、",
    "voice": "vo_adv_5134063_007",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "これなら絶対にばれないだろう？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こういった地道な調査こそが",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "探偵の腕の見せ所だ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "推理をするにも、",
    "voice": "vo_adv_5134063_008",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "手がかりは多い方が……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "えっ？",
    "voice": "vo_adv_5134063_009",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nし、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "しまった、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "会話に夢中で気付いてなかった……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ええっと、",
    "voice": "vo_adv_5134063_010",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "こうなったら……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "わ、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "私を抱きしめてくれ助手くん！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nイチャついてる恋人みたいな感じでやり過ごそう！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406302"
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "そ、",
    "voice": "vo_adv_5134063_011",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "そうだね！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nそうやって覆いかぶさるように",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n抱きしめてくれれば、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "お互いの顔も隠せるし……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "だが、",
    "voice": "vo_adv_5134063_012",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ちょっと息苦しいかも……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "いや、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "抱きしめ方が悪いわけじゃないんだが……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "いろいろと、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "刺激が強いというか……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "still",
    "still_id": "513406303"
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ええっ、",
    "voice": "vo_adv_5134063_013",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "なぜもっと密着してくるんだい！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nこれ以上過激なことをされたら、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "余計目立って……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n助手くん！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ダメだ、",
    "voice": "vo_adv_5134063_014",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "人の往来だってあるんだぞ！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n破廉恥な行為は慎んで……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "あっ……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ああっ……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "はっ！",
    "voice": "vo_adv_5134063_015",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "……は～……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "なんだ、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "夢だったのか……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "新年早々、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "息を切らせながら起きる羽目になるなんて。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "しかし、",
    "voice": "vo_adv_5134063_016",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "あの夢は",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "結局何を暗示していたんだろう？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "探偵として仕事はしていたし、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "助手くんとは……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "…………",
    "voice": "vo_adv_5134063_017",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ま、",
    "voice": "vo_adv_5134063_018",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "世の中解けない謎が一つくらいあってもいいだろう！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "流石に助手くんと、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "この謎に挑むわけにもいかないしね……",
    "voice": null,
    "unit_id": 128511
  }
]
