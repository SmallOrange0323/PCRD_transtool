    "voice": "vo_adv_1065002_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就是我吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我不覺得哪有變化呢？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那是當然，",
    "voice": "vo_adv_1065002_043",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為美食很美味呀！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你不也是這樣嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一臉覺得很美味的表情啊？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "still",
    "still_id": "106500202"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那還真是謝謝誇獎了。",
    "voice": "vo_adv_1065002_044",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對不對，",
