    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是呀？",
    "voice": "vo_adv_1065002_063",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "連我也變有名了啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂大叔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果我就是的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你打算怎麼辦？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "哈！",
    "voice": "vo_adv_1065002_064",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "不管妳在傳聞裡有多厲害，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我可是不會輸給小鬼的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n讓我來狠揍妳一頓吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿，",
    "voice": "vo_adv_1065002_065",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很好很好！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我整個人都興奮起來了！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n來吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老娘用一擊就能打倒你！",
