[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}帶著嘉夜，\\n走到想麻煩她代為爭鬥的人所在地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這裡嗎……",
    "voice": "vo_adv_1065002_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "然後",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你說的委託對象在哪呢？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "哥哥拿走了人家的獅子玩偶～！",
    "voice": "vo_adv_1065002_001",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "\\n人家，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "還要玩呢！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "玩具，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "快還來啦～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "才不要，",
    "voice": "vo_adv_1065002_002",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "這次換我跟獅子先生一起玩了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "這本來就是我的東西吧～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "哇～！",
    "voice": "vo_adv_1065002_003",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "哥哥是笨蛋笨蛋笨蛋！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂，",
    "voice": "vo_adv_1065002_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快點幫我介紹啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065002_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "欸喂。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該不會，你說的打架，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n是指兄妹之間的吵架吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔？",
    "voice": "vo_adv_1065002_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是妹妹呀。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "請多多指教！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "難道",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這就是你說的打架嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但這只是兄妹吵架吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說啊……",
    "voice": "vo_adv_1065002_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我可是以互毆為工作的打手喔？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n再怎麼說，小孩子之間的吵架我是不會介入的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不好意思，",
    "voice": "vo_adv_1065002_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這種架就交給你了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n再見。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "大姐姐，",
    "voice": "vo_adv_1065002_009",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "妳要走了嗎……？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "求求妳！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "\\n幫我拿回獅子先生───！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "我會把我的點心給妳的───！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂！",
    "voice": "vo_adv_1065002_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就說別拉了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_1065002_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "報酬是點心、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真拿妳沒辦法，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我接下了唷。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "咦～！",
    "voice": "vo_adv_1065002_012",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "妳太狡猾了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "而且是因為妳常常哭鬧，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "\\n所以我才一直都讓著妳！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "只借我一天沒關係吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……對呀。",
    "voice": "vo_adv_1065002_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "從哥哥的角度來看，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n看起來妹妹",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總是占上風吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "吶，",
    "voice": "vo_adv_1065002_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們還有",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其他兄弟姊妹嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n像這樣吵架，可是一點好處都沒有的唷？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然這個是哥哥的玩具，",
    "voice": "vo_adv_1065002_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但能不能考慮",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "兩個人一起玩呢？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "嗯、",
    "voice": "vo_adv_1065002_016",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "大姐姐",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "這樣說的話",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "\\n那就一起玩吧。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "真的嗎！？",
    "voice": "vo_adv_1065002_017",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "太好了！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "跟哥哥一起玩～！！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "那，",
    "voice": "vo_adv_1065002_018",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "兄",
    "words": "我們去那邊的公園一起跟獅子玩吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "嗯！",
    "voice": "vo_adv_1065002_019",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "妹",
    "words": "大姐姐謝謝妳───！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "他們走掉了呢。",
    "voice": "vo_adv_1065002_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個孩子，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該是想跟哥哥一起玩吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……之類的，",
    "voice": "vo_adv_1065002_021",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你以為當成美談一件就能打發過去嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託你之後認真點啦？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n下次你可要介紹給我",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "正經一點的打架工作喔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喲。",
    "voice": "vo_adv_1065002_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的假的？",
    "voice": "vo_adv_1065002_023",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這次一定沒問題吧……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總之帶我去現場吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "為什麼你每次、",
    "voice": "vo_adv_1065002_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "每次約會都遲到啊！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n反正我對你來說，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "一點都不重要吧！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我不是說過很多次了嗎！？",
    "voice": "vo_adv_1065002_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n那是因為下班前又被交代工作，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不用好的話根本回不了家呀！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……喂。",
    "voice": "vo_adv_1065002_026",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n該不會，這次是要我",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "阻止情侶吵架吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊，",
    "voice": "vo_adv_1065002_027",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳就是那個打手吧！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我會付錢的，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳能嚴厲地訓一訓這個人嗎！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "總是不斷地找藉口……",
    "voice": "vo_adv_1065002_028",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我無論如何都不能原諒他！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算妳要我嚴厲……",
    "voice": "vo_adv_1065002_029",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這位小姐。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n妳覺得我看起來是個專精口頭吵架的人嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我的專業可是跟人互毆唷。",
    "voice": "vo_adv_1065002_030",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
