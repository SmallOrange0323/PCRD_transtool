  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "哎～呀，",
    "voice": "vo_adv_4010210_000",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "這不是阿貓阿馬嗎！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "你來得正好，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n這肯定也是我",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "平時行善積德的成果呢～♪",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "什麼！？",
    "voice": "vo_adv_4010210_001",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "居然忘記本小姐的尊容，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n阿貓阿馬的腦袋果然空空如也嗎！？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "…………呃",
    "voice": "vo_adv_4010210_002",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "……哎呀？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "像這樣的庶民，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "本小姐怎麼可能",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "認識",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "呢……？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "算了，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "就這樣吧。",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "哦～呵呵，",
    "voice": "vo_adv_4010210_003",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "你記得很清楚嘛！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "不過",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "就算太陽打西邊出來，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n你也不可能忽然忘記本小姐美麗的名字吧？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "今天是",
    "voice": "vo_adv_4010210_004",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "慶祝本小姐降生的日子，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "也就是",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "我的生日。",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "但不知為何，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "隨侍們都表示身體不適，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n宴會的成員不足啊……！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "所以，",
    "voice": "vo_adv_4010210_005",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "我要把這個重大的職責交給你！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n給我準備一場和誕辰慶典相襯的款待。",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "當然，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "我不接受肯定以外的回應！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "真不愧是阿貓阿馬，",
    "voice": "vo_adv_4010210_006",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n看來你很理解自己的立場",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "與我的美麗嘛！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "那就",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "開始",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "你最豪華的款待吧！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "嗯……",
    "voice": "vo_adv_4010210_007",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "清爽宜人的風，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "還有燦爛耀眼的",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "太陽！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "世界都在祝福我的生日～",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "呃，",
    "voice": "vo_adv_4010210_008",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "這樣不就只是散步嗎！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "這可是慶祝作為世界千金的本小姐生誕的",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "大活動啊！？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "你是準備用這種野餐就搪塞過去嗎？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "這個嘛……",
    "voice": "vo_adv_4010210_009",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "的確是？",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "高高在上地俯瞰庶民們的生活，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n再次實際感受本小姐的",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "地位和",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "權力，",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n作為生日活動也還不壞……",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "那麼接下來──",
    "voice": "vo_adv_4010210_010",
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "就去更近的位置",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "眺望庶民的生活吧♪",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "我們去你家吧，阿貓阿馬！",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "我會徹底",
    "voice": null,
    "unit_id": 134931
  },
  {
    "type": "dialogue",
    "name": "伽音",
    "words": "幫你檢查每個角落的～♪",
    "voice": null,
    "unit_id": 134931
  }
]
