    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "……竟、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "竟然是真的！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "光憑你們兩個人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n就釣了這麼多金槍鮪嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "太不可思議了吧……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是啊，",
    "voice": "vo_adv_1150001_065",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只憑我們兩個人。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n若是懷疑我找了幫手，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就去問問你的同行吧。",
