    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n大間漁夫的技術",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真的相當出色呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "是、",
    "voice": "vo_adv_1150001_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "是啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "妳說的沒錯！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n嘿嘿，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "妳很清楚嘛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "小姑娘！",
