  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "什麼……？",
    "voice": "vo_adv_1150001_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你們說釣魚和消滅魚是兩碼子事，",
