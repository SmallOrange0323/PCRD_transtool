  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我不能讓你遭遇危險……",
