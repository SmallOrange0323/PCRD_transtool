    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要依靠他人了……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "哈……",
    "voice": "vo_adv_1355002_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "哈……",
    "voice": null,
    "unit_id": null
  },
  {
