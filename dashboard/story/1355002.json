    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊──不行！",
    "voice": "vo_adv_1355002_058",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我果然忍不了！",
