[
  {
    "type": "background",
    "bg_id": "501440"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}接受招待，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到埃拉所在的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "複製品世界觀光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n昨晚把埃拉送回去之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就回到自己的旅店就寢──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……啊哈哈哈哈！",
    "voice": "vo_adv_1355002_000",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "沒關係，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "別在意。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "老婆婆，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那個行李很重吧？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n妳家在哪？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我來幫妳搬。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "background",
    "bg_id": "502060"
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "埃拉大人，",
    "voice": "vo_adv_1355002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "謝謝妳啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n多虧有妳，真是太好了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不用在意啦！",
    "voice": "vo_adv_1355002_002",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有困難的時候就要互相幫助幫助，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": "vo_adv_1355002_003",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這邊的路還沒有鋪設完，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "即使慢慢來也好，我想一步步推進整備工作呢～",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "口會不會渴？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要喝水嗎？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀？",
    "voice": "vo_adv_1355002_004",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在那裡的是……",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "早安──！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "怎麼啦，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "你怎會在這裡？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀呀，",
    "voice": "vo_adv_1355002_005",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我的聲音有那麼大嗎？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉啊，吵醒你了～！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就當作是我提供的叫醒服務，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "原諒我吧。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": "vo_adv_1355002_006",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對了對了！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n謝謝你昨天送我回家！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "本來想說等等也要去騎士先生那邊露臉的。",
    "voice": "vo_adv_1355002_007",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為我想跟你道謝，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嘿嘿嘿。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……啊，",
    "voice": "vo_adv_1355002_008",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "昨天的事是祕密喔。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "別看我這樣，我可是一直都在扮演「可靠的大姐姐」呢。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然被騎士先生看到自己丟臉的地方了……",
    "voice": "vo_adv_1355002_009",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗚咕……",
    "voice": "vo_adv_1355002_010",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好的～",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不可沉溺於麥酒之海……",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是吧。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我深刻體會到了，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真的。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對了，",
    "voice": "vo_adv_1355002_011",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "等巡邏結束，我再為你導覽！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要在大街上晃晃也可以，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "或是換個路線",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "去綠洲也很推薦。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "你先想想要看哪裡──",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "找到了！",
    "voice": "vo_adv_1355002_012",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "埃、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "埃拉大人……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n大事不好了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯？",
    "voice": "vo_adv_1355002_013",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這麼慌慌張張的。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "沙、",
    "voice": "vo_adv_1355002_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "沙漠裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "有魔物襲擊商隊……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n我們想說要找人求救……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "只有我總算是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "逃到了這裡……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n大家",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "都動彈不得……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "────！！",
    "voice": "vo_adv_1355002_015",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "知道了，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我馬上過去！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n能麻煩你帶我到附近嗎？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n大家都先準備好治療傷患的用品！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉，",
    "voice": "vo_adv_1355002_016",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n明明說好要為你帶路的──",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生……",
    "voice": "vo_adv_1355002_017",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝你，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真是幫大忙了！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那就跟我一起來吧！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生！！",
    "voice": "vo_adv_1355002_018",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "喝啊啊啊啊啊啊！！",
    "voice": "vo_adv_1355002_019",
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這下",
    "voice": "vo_adv_1355002_020",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "可見範圍內的魔物都打倒了……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大家",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有沒有受傷！？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "得、",
    "voice": "vo_adv_1355002_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "得救了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "\\n埃拉大人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "\\n我還以為",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "真的要完了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好了好了，",
    "voice": "vo_adv_1355002_022",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "笑一個！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有困難的時候就是要互相幫助幫助，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……",
    "voice": "vo_adv_1355002_023",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……唔。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈……",
    "voice": "vo_adv_1355002_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大家都沒事真是太好了。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但是",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "或許有其他魔物會因為剛剛的騷動靠近，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n趕快離開沙漠吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我已經請人在城裡準備好救護站了，",
    "voice": "vo_adv_1355002_025",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n受傷、想休息的人都去那邊。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n運貨的動物們也能喝水喔。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "好、",
    "voice": "vo_adv_1355002_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "好的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "\\n總有一天",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "請讓我報答您的恩情！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不用在意那種事啦♪",
    "voice": "vo_adv_1355002_027",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n下次有人碰到麻煩時，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就出手幫忙吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也謝謝騎士先生的強化。",
    "voice": "vo_adv_1355002_028",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "多虧了你，大家都平安無事。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哇喔，",
    "voice": "vo_adv_1355002_029",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真不愧是騎士先生，看得真清楚呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這點擦傷我沒問──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "呃，",
    "voice": "vo_adv_1355002_030",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "等……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n你手伸過來是想幹嘛！？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "唔……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "什麼勉強，",
    "voice": "vo_adv_1355002_031",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這算不上勉強啦……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真的不需要擔心……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……真是的，",
    "voice": "vo_adv_1355002_032",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我都說沒關係了。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊──我知道了啦。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那就麻煩你",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "幫我包紮了……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗚……",
    "voice": "vo_adv_1355002_033",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n騎士先生偶爾會變得很固執呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n不過這個世界的你也是這樣……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯～",
    "voice": "vo_adv_1355002_034",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "可是啊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我沒辦法對有困難的人置之不理呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "如果我能幫忙的話，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就必須出手相助才行。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……我的願望",
    "voice": "vo_adv_1355002_035",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是讓大家都露出笑容。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這是我最大的願望，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "如今也沒有改變。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我沒辦法放著一臉悲傷的人不管。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "畢竟",
    "voice": "vo_adv_1355002_036",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我過去都在擔任「管理者」，守護這個世界嘛？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n雖然現在",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "頂多就是在城裡巡邏而已啦。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗚嗚……",
    "voice": "vo_adv_1355002_037",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是嗎，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "本來沒打算讓你擔心的，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我也不希望",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "你因為這樣而失去笑容。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "原來你看得出來",
    "voice": "vo_adv_1355002_038",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我在逞強啊……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "感覺很安心呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但是，",
    "voice": "vo_adv_1355002_039",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要不逞強",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好像很難……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為平常都覺得理所當然，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n就像是在要求我",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "「別當作理所當然」呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "互相幫助……",
    "voice": "vo_adv_1355002_040",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n有困難的時候",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "去依靠別人",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也沒關係吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我知道了！",
    "voice": "vo_adv_1355002_041",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n那我會試著去拜託別人，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不讓自己努力過頭！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "502060"
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "埃拉大人，",
    "voice": "vo_adv_1355002_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "謝謝妳",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "救了我們……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n如妳所見，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "商隊所有人都平安無事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n謝謝妳",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "趕走魔物！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "太好了太好了♪",
    "voice": "vo_adv_1355002_043",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n有困難的時候就要互相幫助幫助，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "老爺，",
    "voice": "vo_adv_1355002_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "因為魔物襲擊的關係，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "攤位的準備延誤了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "\\n不趕快處理的話",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "會來不及的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "是啊……",
    "voice": "vo_adv_1355002_045",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "但",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "大家都到極限了吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n剩下的就交給我，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "大家去旅店休息吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "這怎麼行，",
    "voice": "vo_adv_1355002_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "老爺才是最累的吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人的隨從",
    "words": "\\n您一個人是無法處理的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀，",
    "voice": "vo_adv_1355002_047",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "看來有需要人手呢？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那麼",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我也來幫忙──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗚……",
    "voice": "vo_adv_1355002_048",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要依靠別人，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "呃，",
    "voice": "vo_adv_1355002_049",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那麼……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "能請你幫幫這些人嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "可以嗎？",
    "voice": "vo_adv_1355002_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "那麼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "這邊的行李……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "可以麻煩你小心處理嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "請把這個搬到那邊……",
    "voice": "vo_adv_1355002_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "然後那邊也麻煩了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……行李看起來好重。",
    "voice": "vo_adv_1355002_052",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咦，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "一個人沒問題嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……啊啊，",
