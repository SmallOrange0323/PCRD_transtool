[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "12月24日、クレジッタと秘書１号はクリスマスで賑わう飲食店で",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n顔を突き合わせていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……はぁ。",
    "voice": "vo_adv_5132068_000",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "食欲がないのですか？　",
    "voice": "vo_adv_5132068_001",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "せっかくの特上肉ですのに。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いらないのでしたら私が──",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "食べますわよ！　",
    "voice": "vo_adv_5132068_002",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "勝手に特上頼まれたうえに",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしの分まで取られたんじゃたまりませんわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今の溜め息は……",
    "voice": "vo_adv_5132068_003",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n陛下のことを考えていただけですわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そういえば今日は、",
    "voice": "vo_adv_5132068_004",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あの少年と遊びに行ってるはずですね。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nもしかして",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "陛下のことが心配なのですか？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そうではありません。",
    "voice": "vo_adv_5132068_005",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下の強さは今さら語るまでもありませんし、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n少年に関しましても、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "悔しいですがわたくしより余程信頼されてます。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そして彼がその信頼を裏切ることもありえませんね。",
    "voice": "vo_adv_5132068_006",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……チクリとしますわね貴女の言葉はまったく。",
    "voice": "vo_adv_5132068_007",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その通りですわよ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ではなぜ。",
    "voice": "vo_adv_5132068_008",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nそんな筋ばかりの肉を食べたみたいな",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n浮かない顔をしてるのか──",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "元はといえば",
    "voice": "vo_adv_5132068_009",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさまの進めたイベントがご満足いただけず、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そのせいで古代遺物に付け込まれてしまいましたし。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "結果的に名誉挽回の機会を得て、",
    "voice": "vo_adv_5132068_010",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "陛下の理想のクリスマスを",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n叶えることができていますが、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "一歩間違えば大惨事でした。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n本当に大変でしたけどね。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……さっくりかつ的確にまとめないでくださる？",
    "voice": "vo_adv_5132068_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "走馬灯のごとく記憶がよみがえって、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nまた頭が痛くなってまいりましたわ……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "でもその通りですわ。",
    "voice": "vo_adv_5132068_012",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n明日のクリスマス本番が上手くいかなかったら、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n陛下はきっと自分を責めてしまわれる……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そう思うと",
    "voice": "vo_adv_5132068_013",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "胸が苦しくて……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……食べすぎでしたら",
    "voice": "vo_adv_5132068_014",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "肉はいただきますが。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "違いますわよ！！",
    "voice": "vo_adv_5132068_015",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしは",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "明日のイベントのことと",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n陛下のことを心配しているんですのよ！！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そうそう、",
    "voice": "vo_adv_5132068_016",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そのお顔です。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "しおらしく心配しているより、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "そうやって騒いでいる方が",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nクレジッタさまらしいですよ。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "今回のクリスマス、",
    "voice": "vo_adv_5132068_017",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私は必ず成功すると思っています。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nそして万が一失敗した場合は、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私も一緒に",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "次の策を考えます。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "だからどうか、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あなたはいつも通り堂々としていてください。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "自信を持って、",
    "voice": "vo_adv_5132068_018",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "陛下や少年と",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "最高のクリスマスを楽しみましょう。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nきっとそれが、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "成功への近道です。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まったく、",
    "voice": "vo_adv_5132068_019",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女ときたら。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nいつもいつも、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "１から10まで知ったような口をききますわね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "当然です。",
    "voice": "vo_adv_5132068_020",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私はクレジッタ・キャッシュの秘書ですから。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n円滑なサポートが私の仕事です。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……どうやらわたくしは、",
    "voice": "vo_adv_5132068_021",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いい秘書に恵まれたようですわね。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ええ、",
    "voice": "vo_adv_5132068_022",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "一流の商人には",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "一流の秘書が不可欠ですからね。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "待遇の改善もご検討ください。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "希望としては",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "このくらい……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ、",
    "voice": "vo_adv_5132068_023",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ！　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女はそういう人でしたわよね！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今回ばかりは",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ボーナスくらいつけさせていただきますわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "さすがクレジッタさまです。",
    "voice": "vo_adv_5132068_024",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あ、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "すみません、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "こちらの特選肉セット、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nそれと",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "特上海鮮盛りを追加でお願いします。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少しは遠慮も覚えてくださります！？",
    "voice": "vo_adv_5132068_025",
    "unit_id": 128011
  }
]
