[
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可可蘿與{0}脫離艾爾皮斯島，\\n回到了好段時間沒回來的公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "平安回來了。",
    "voice": "vo_adv_1376001_000",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n令人懷念又深愛的家，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "終究令人安心許多呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "涅比亞大人",
    "voice": "vo_adv_1376001_001",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是外出中……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不在這段期間",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來堆積了不少灰塵。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了讓主公大人放心休息，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下立刻著手打掃。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您，",
    "voice": "vo_adv_1376001_002",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼就兩人合力，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "迅速處理吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯嗯……",
    "voice": "vo_adv_1376001_003",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比在下想得還要……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不用擔心。",
    "voice": "vo_adv_1376001_004",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打掃起來",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稍微多費了點工夫。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒想到原本習慣的掃帚，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "用起來感覺會那麼短。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個行李",
    "voice": "vo_adv_1376001_005",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "暫時先放這邊……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好痛。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……抱、",
    "voice": "vo_adv_1376001_006",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n以前在下",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從來沒有在這種地方",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "撞到頭過……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這具大人的身體，",
    "voice": "vo_adv_1376001_007",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身高和手腳長度",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都差別很大。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許需要再熟悉一下，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才能像以前一樣生活……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……說得也是呢。",
    "voice": "vo_adv_1376001_008",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有必要去採購食材，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "趁此機會",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "順道買些新的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打掃用具等等或許也不錯。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常感謝您",
    "voice": "vo_adv_1376001_009",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此寬宏大量的關懷。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼事不宜遲，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一同出發前往商店街吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "上次像這樣和主公大人出來購物，",
    "voice": "vo_adv_1376001_010",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是很久以前了呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n今日的蘭德索爾如此和平，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是，",
    "voice": "vo_adv_1376001_011",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真如字面意義，和以前的視野截然不同……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n雖然或許只是一點差異，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但別有不同風景這句話，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n感覺不完全是誇飾呢……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最重要的是，",
    "voice": "vo_adv_1376001_012",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n像這樣和主公大人並排站著時，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不再需要抬頭看了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n視線和臉龐",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得非常近……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "令在下",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "十分高興。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊，",
    "voice": "vo_adv_1376001_013",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不禁",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沉浸於感嘆之中了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "首先",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要採購的是食材吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那就往常去的那間店走吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "哎呀，",
    "voice": "vo_adv_1376001_014",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "\\n可可蘿也好久不──",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "咦，",
    "voice": "vo_adv_1376001_015",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "可可蘿！？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "\\n怎麼回事，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "妳整個人的印象好像都不一樣了……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_1376001_016",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下忘記",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會需要重新說明這件事。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "其實，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "過去以來，",
    "voice": "vo_adv_1376001_017",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的身體……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "角色裡，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就一直沉眠著",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "代表父親大人名義的力量。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n年幼未成熟的狀態下，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下無法去運用那股強大的力量。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也曾請涅妃‧涅羅小姐幫忙，",
    "voice": "vo_adv_1376001_018",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n嘗試了能夠讓",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身體長大的方法。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但「想盡快幫助主公大人」",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的想法太過急躁，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "導致無法順利成功。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……是的。",
    "voice": "vo_adv_1376001_019",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽從涅妃‧涅羅小姐",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給在下的建議，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下算是找到了",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "希望自己",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成長的「動機」。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n應該是這個原因──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然向主公大人",
    "voice": "vo_adv_1376001_020",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣子說明了……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但這些內情，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就沒有必要都說明",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給街坊鄰居聽了呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個時候該……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這，",
    "voice": "vo_adv_1376001_021",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是那個……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是、",
    "voice": "vo_adv_1376001_022",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所謂的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成長期。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "成長期啊……",
    "voice": "vo_adv_1376001_023",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "既然是成長期，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "那就沒辦法了呢……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "不過突然長這麼大，",
    "voice": "vo_adv_1376001_024",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "會不會有很多不方便？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "就連住習慣的房間",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "都會感覺不一樣了吧。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說得沒有錯。",
    "voice": "vo_adv_1376001_025",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以今天來這一趟，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就是要來找些",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "適合成長後身體的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "居家用品。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "那麼有間店我推薦你們去看看喔。",
    "voice": "vo_adv_1376001_026",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "雖然是最近才開張的店，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "店裡的老婆婆",
    "words": "不過可可蘿一定會喜歡的。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": "vo_adv_1376001_027",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就立刻……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在這",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "之前。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請先給在下那邊的蘋果和香蕉，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及吐司用的果醬。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "受推薦的那間最近才開張的店，",
    "voice": "vo_adv_1376001_028",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是這間嗎。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n店面看起來相當寬闊──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "歡迎光臨！",
    "voice": "vo_adv_1376001_029",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n從生活雜貨",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "到大型家具，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "家裡的任何需求",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "都能在這裡買到！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此寬闊的場地",
    "voice": "vo_adv_1376001_030",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "賣的全是居家用品……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "品項也似乎很齊全。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下我們要找的看起來也都有，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太好了呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "兩位客人是……",
    "voice": "vo_adv_1376001_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "我理解了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "想要採購未來新生活所需的東西，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "是這樣子",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "對吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "對嘛，",
    "voice": "vo_adv_1376001_032",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "對嘛！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n未來要同甘共苦，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "成為陪伴彼此走過人生的夥伴……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n可以從兩位身上",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "明確感覺到那種氛圍！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊。",
    "voice": "vo_adv_1376001_033",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這位莫非是",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把在下和主公大人……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當成了",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "新婚夫妻嗎。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這可真是──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是",
    "voice": "vo_adv_1376001_034",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一位慧眼如炬的店員。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──不，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "重點不在這裡。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……如果是以前，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往往都會被當作是兄妹。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來用這個身體，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就會被當成那樣了呢……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……不能忘記原本的目的。",
    "voice": "vo_adv_1376001_035",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是來添購比現在所用尺寸更大的",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打掃用具。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "若是我們的商品，",
    "voice": "vo_adv_1376001_036",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n能夠為感情和睦幸福的兩位",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "提供一點支持……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n那真是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "榮幸至極！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……在下和主公大人，",
    "voice": "vo_adv_1376001_037",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像夫妻一樣……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣的對待，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓在下有一種",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得飄飄然的感覺……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": "vo_adv_1376001_038",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的可以嗎？",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……是。",
    "voice": "vo_adv_1376001_039",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這是個好機會，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都看一看吧。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一定",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能作為對未來的預習。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這邊的棚架不錯呢。",
    "voice": "vo_adv_1376001_040",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "尺寸雖然有點大，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對現在的在下而言",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倒沒有任何問題。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "真不愧是客人，",
    "voice": "vo_adv_1376001_041",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "好眼光！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n確實",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "尺寸是稍大了一些，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "但考慮到未來，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n空間從容一點不會有什麼壞處的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此……",
    "voice": "vo_adv_1376001_042",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "考慮到在下和主公大人的未來、",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "這是最先進的廚房！",
    "voice": "vo_adv_1376001_043",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n如兩位所見，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "流理台和料理台還有收納等等，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n都是追求方便使用的配置！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦……",
    "voice": "vo_adv_1376001_044",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n本來對廚房的構造",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有特別意識過，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n實際這樣上手一試，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能夠明確察覺差異呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1376001_045",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也一定要來試試看。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會有變身一流主廚的感覺。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "看來兩位都是享受料理樂趣的人呢。",
    "voice": "vo_adv_1376001_046",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n那麼想當然，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "也會想追求家具的品質吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "這裡當然",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "也有販售多種家具！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "睡眠",
    "voice": "vo_adv_1376001_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "占據了人生的三分之一，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "非常重要。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "更何況是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "兩位會在一起最久的場所，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n絕對不能妥協……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": "vo_adv_1376001_048",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這張床……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "光是躺上去，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就彷彿全身都被包覆進去了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1376001_049",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "簡直像做夢一樣……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "價格有點昂貴，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過物有所值……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1376001_050",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "下定決心了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一想到是往後和主公大人生活所用的，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這點費用並不貴。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "感謝惠顧……",
    "voice": "vo_adv_1376001_051",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "哦對了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "不只是兩位用的，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "要不要也看看嬰兒床？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "或許有點早了，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "銷售員",
    "words": "考慮到將來或許還是有需要──",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_1376001_052",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "等到有需要，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到時候、",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1376001_053",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在是一次很有意義的採購。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n非常期待",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "家具送來。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這下也買齊符合大人身體尺寸",
    "voice": "vo_adv_1376001_054",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的東西了。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n往後要比之前更努力，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為主公大人盡心──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…………啊。",
    "voice": "vo_adv_1376001_055",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……十、",
    "voice": "vo_adv_1376001_056",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "十分抱歉。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是魔力耗盡了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然覺醒成為「嚮導幼君」了，",
    "voice": "vo_adv_1376001_057",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但成人的身體，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n似乎也會",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "消耗更多魔力……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白會有時間限制，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不過還難以預測時間……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_1376001_058",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "下訂的那些家具",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對現在的身體都太大了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n趕快",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "去申請取消吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後可可蘿兩人連忙聯絡家具店，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成功取消了大部分的訂單。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "只是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1376001_059",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只有這張床，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n來不及取消了呢……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "居然犯下這樣的失誤……",
    "voice": "vo_adv_1376001_060",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的非常抱歉，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身體變成大人之後，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是得意忘形了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_1376001_061",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是呀。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n睡起來舒適度超群，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n寬度也完全足夠",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩個人自由自在地躺上去呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1376001_062",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也躺上去吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n魔力也差不多恢復了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟是為了這副身體採購的床，",
    "voice": "vo_adv_1376001_063",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若要確認舒適度，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是用這樣的身體才準確。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請吧，主公大人。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓成為大人的在下，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "陪您一起睡。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "still",
    "still_id": "137600101"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1376001_064",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n確實支撐身體，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "提供舒適的包覆感……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
