  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，{0}的mimi收到了訊息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "mimi",
    "words": "今天是和花凜在阿斯特朗傳奇相遇的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，經由mimi被佳凜約出來的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了某個住宅區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "謝謝你來這一趟。",
    "voice": "vo_adv_9006005_000",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你也收到",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那個通知了吧？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒錯，",
    "voice": "vo_adv_9006005_001",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就是這麼一回事。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "是你和我相遇的",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "值得紀念的日子！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你還記得嗎？",
    "voice": "vo_adv_9006005_002",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n我和你",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "初次見面時的情景。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "後來，",
    "voice": "vo_adv_9006005_003",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "為了想辦法和你取得聯繫，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n我註冊了阿斯特朗傳奇……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n當天就找到你了呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "當時滿辛苦的呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "但",
    "voice": "vo_adv_9006005_004",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這對我來說",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "是相當重大的事情。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "透過這個遊戲，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我遇見了許多很有意思的人。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "所以，",
    "voice": "vo_adv_9006005_005",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我真的很感謝你",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n和這款叫做阿斯特朗傳奇的遊戲喔。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "即便如此，",
    "voice": "vo_adv_9006005_006",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "也很難找到",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n像你這樣有趣的人……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你有沒有意願",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "現在就到敝公司來……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這樣啊……",
    "voice": "vo_adv_9006005_007",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "雖然很遺憾，但也沒辦法呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不過，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "真的好神奇呀。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "無論是在阿斯特朗傳奇裡面還是外面，",
    "voice": "vo_adv_9006005_008",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "只要待在你身邊",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就能遇見很有趣的人呢……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這已經",
    "voice": "vo_adv_9006005_009",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "可以稱作是一種天賦了呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你搞不好",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "比我還有",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n獵人頭的天賦呢！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "認識我之後，",
    "voice": "vo_adv_9006005_010",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你的人際關係是不是還在不斷拓展呢？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "如果有什麼有趣的人才，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "要介紹",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "給我哦♪",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那麼，",
    "voice": "vo_adv_9006005_011",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "工作上的事就先聊到這裡吧……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "如果像我一樣從事挖掘人才這種工作，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n就會知道緣分是很不可思議的。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "意志堅強的人、",
    "voice": "vo_adv_9006005_012",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "溫柔體貼的人……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "擁有這些特質的人",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "好像會",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "互相吸引。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "而",
    "voice": "vo_adv_9006005_013",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這樣交織而成的羈絆",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "會昇華周圍的人的心，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "並吸引著他們……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我認為你很特別，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "足以成為這個起點。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "今後",
    "voice": "vo_adv_9006005_014",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "遇見更多的人",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "並互相影響的話，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "世界就會",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "朝著快樂有朝氣的方向發展。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我是不是",
    "voice": "vo_adv_9006005_015",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "說得有點誇張了呢？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不好意思，說了奇怪的話。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就是這樣……",
    "voice": "vo_adv_9006005_016",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n這裡即將要舉辦",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "志工撿垃圾的活動。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你願意一起參加",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "讓世界變得更好的活動嗎？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "呵呵，",
    "voice": "vo_adv_9006005_017",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我就知道你會這麼說。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我已經準備好手套和垃圾袋了，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "請收下♪",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那麼，",
    "voice": "vo_adv_9006005_018",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "從今以後……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我們也一起努力讓這個世界",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "變得更快樂有朝氣吧！",
    "voice": null,
    "unit_id": 118531
  }
]
