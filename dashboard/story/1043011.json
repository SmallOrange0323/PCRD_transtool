    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓我挺意外的。",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我還以為你的個性會再更輕浮一點耶。",
    "voice": null,
    "unit_id": 104331
  },
