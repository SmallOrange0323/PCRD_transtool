  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "好好享受了花祭的真步與{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n坐在長椅上的兩人，欣賞著祭典並快樂地聊天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1160004_000",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是段夢一般的時間呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生做給人家的花冠，",
    "voice": "vo_adv_1160004_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家會當成寶物的。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就像玻璃鞋一樣，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要替它施展不會消失的魔法♪",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀？",
    "voice": "vo_adv_1160004_002",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是怎麼回事呢？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n明明都還沒有施展魔法，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "花冠就",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "閃閃發亮著……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_1160004_003",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您來了呀♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒事的，",
    "voice": "vo_adv_1160004_004",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "並沒有任何不對。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只是人家太過興奮，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不小心提前太多時間來了而已。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "話雖如此，",
    "voice": "vo_adv_1160004_005",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但王子先生也很早來呢。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您也很",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "期待今天嗎？",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "畢竟",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也是當到而已。",
    "voice": "vo_adv_1160004_006",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……哈啾！",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……嗚嗚，",
    "voice": "vo_adv_1160004_007",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請不要用那麼懷疑的眼神",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "來看人家。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n也沒辦法不提早來吧。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "畢竟今天……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天可是",
    "voice": "vo_adv_1160004_008",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "和王子先生的",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "夢幻約會呀♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "其實",
    "voice": "vo_adv_1160004_009",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家為了今天，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n特別",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "準備了特別的衣服喔。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是",
    "voice": "vo_adv_1160004_010",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那是只能在",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真步真步王國相傳的，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n某個特別場所才能夠穿上，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以要先保密♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那麼，",
    "voice": "vo_adv_1160004_011",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就招待王子先生",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n到真步真步王國的",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "神殿吧♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "still",
    "still_id": "116000401"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_1160004_012",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n歡迎來到",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真步真步王國的神殿～♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……說笑的。",
    "voice": "vo_adv_1160004_013",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n現今只要預約，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就能租到",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這種婚禮會場喔。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好像也常用來",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "舉辦角色扮演的活動，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以人家就申請了♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": "vo_adv_1160004_014",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真沒想到，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n竟然能借到",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這麼美妙的地方……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不只氣氛不同，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感覺就像",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的在辦婚禮一樣呢♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而且，",
    "voice": "vo_adv_1160004_015",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "工作人員",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還準備了花。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……那個呀，",
    "voice": "vo_adv_1160004_016",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有個夢想。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n在婚禮上，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "穿著自己做的禮服，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "跟夢中注定的人",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "結為連理……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這樣子的夢。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家知道",
    "voice": "vo_adv_1160004_017",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "距離夢想實現",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還需要很久。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……但是，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "抱著姑且一試心態",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "申請的會場",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然預約成功了，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n讓人家",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "想稍微偷看一下",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "自己的夢想。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以",
    "voice": "vo_adv_1160004_018",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就順勢",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "邀請了王子先生，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在王子先生回答人家之前，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家實在是",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "焦慮到不行。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說可以陪人家來的時候，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的非常開心。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "因為太開心了，",
    "voice": "vo_adv_1160004_019",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "每天一針一線",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "努力地",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "製作了禮服……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但來到這裡，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "穿上服裝後，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家終於明白了。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家根本做不出",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "夢想中的東西。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": "vo_adv_1160004_020",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "會更努力學習裁縫的。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不是為了繼承家業，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而是為了自己……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現實世界",
    "voice": "vo_adv_1160004_021",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒有灰姑娘的魔法師，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不像童話故事那樣，沒有人會把人家變成公主。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以人家要自己成為魔法師，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "做出世界上最好看的禮服。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在此對真步真步王國的神殿發誓，",
