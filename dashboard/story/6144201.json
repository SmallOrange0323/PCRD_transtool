  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "芙菈瓦村",
    "voice": "vo_adv_6144201_000",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n真的是充滿了花朵的村莊呢。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你有喜歡的花嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "像鈴莓小姐的花？",
    "voice": "vo_adv_6144201_001",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你是指有著開朗氛圍的花嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "確實，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果用這種花裝飾，感覺會讓人產生活力呢♪",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你、",
    "voice": "vo_adv_6144201_002",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你在胡說些什麼啊！？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我聽不懂你在說什麼，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但是感覺有點像變態喔！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……不過，",
    "voice": "vo_adv_6144201_003",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我也不是不高興你這樣說。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……那個，",
    "voice": "vo_adv_6144201_004",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我不是想問你這個。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n請你在這個村子裡",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不要什麼東西都放進嘴裡吃喔？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你可不是小嬰兒啊。",
    "voice": null,
    "unit_id": 130711
  }
]
