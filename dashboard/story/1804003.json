  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就饒了我吧☆",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "解決了！",
    "voice": "vo_adv_1804003_072",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n獲得珍貴食材☆",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然機會難得，那就邀請【美食殿堂】和王宮的大家",
    "voice": "vo_adv_1804003_073",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n來舉辦魔物料理派對吧！　",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然現在雙方有點尷尬，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但一起吃飯感情應該會變好吧！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "已經決定好了的話，我就來切開食材吧……",
    "voice": "vo_adv_1804003_074",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": "vo_adv_1804003_075",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n果然變身為『公主型態』之後，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n馬上肚子就空空如也呢。",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然有這麼多肉……",
    "voice": "vo_adv_1804003_076",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我稍微",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃一點點應該也沒關係吧？",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果超巨大魔物的大半部都被貪吃佩可吃進胃裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n剩下的食材則使用在她主辦的魔物料理派對上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n意外地廣獲好評。",
    "voice": null,
    "unit_id": null
  }
]
