    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那肯定是沒辦法吧！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我們只能逃跑了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但那個魔物繼續前進的話，就會進入蘭德索爾了。",
    "voice": "vo_adv_1804003_037",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n即使不行也要在這裡設法做些什麼！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不然好不容易進行的復建計畫，就會被破壞了！",
