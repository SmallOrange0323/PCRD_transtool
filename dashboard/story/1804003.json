[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可趁著公務的空檔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了享用魔物料理，打算前往魔物的棲息地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？　這不是{0}嗎。",
    "voice": "vo_adv_1804003_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "阿囉哈～☆",
    "voice": "vo_adv_1804003_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你來得正是時候呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我",
    "voice": "vo_adv_1804003_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在正想要前往狩獵魔物，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你要一起來嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會招待你好吃的魔物料理哦♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_1804003_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你懷疑我是從城堡偷跑出來嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但這次是真正的自由活動時間唷！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖說如此，但還是工作間的空檔，",
    "voice": "vo_adv_1804003_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以我們要迅速地捕獵魔物，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還要迅速料理完成才行。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為沒什麼完整的時間，",
    "voice": "vo_adv_1804003_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n能捕獲的魔物也有限，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真讓人困擾啊——",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是，",
    "voice": "vo_adv_1804003_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對於味道我絕不妥協，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一定會獻上極品美味給你哦！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣回答表示你願意跟我一起去囉！",
    "voice": "vo_adv_1804003_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天的獵物沒那麼危險，",
    "voice": "vo_adv_1804003_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以放心跟我來吧♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～，",
    "voice": "vo_adv_1804003_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天感覺是絕佳的狩獵好天氣呢～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為目標魔物會自投羅網撲上來襲擊我們，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我想馬上就能捕獲唷！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是，",
    "voice": "vo_adv_1804003_010",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不會危險哦——",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖然牠們很好戰但其實很弱唷。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也沒有什麼時間，",
    "voice": "vo_adv_1804003_011",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我們迅速捕獲吧☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真奇怪啊——",
    "voice": "vo_adv_1804003_012",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n平時的話會不斷襲擊過來的說，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n今天連影子都沒見到呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "受到霸瞳皇帝戰役的影響，",
    "voice": "vo_adv_1804003_013",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n魔物的棲息地發生變化了嗎？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這麼說來，城鎮的人也有提到過巨大生物呢。",
    "voice": "vo_adv_1804003_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這不好好仔細調查的話不行呢……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "什麼，",
    "voice": "vo_adv_1804003_015",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這個響徹肚子的巨大聲音。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是那個！　",
    "voice": "vo_adv_1804003_016",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那就是我們的目標魔物！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "追上去吧，{0}！！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……被牠逃走了。",
    "voice": "vo_adv_1804003_017",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那種魔物逃跑的情況，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我還是第一次見到。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果是平時的話，會很有精神地飛撲過來的說。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然感覺很奇怪呀……",
    "voice": "vo_adv_1804003_018",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哇啊啊————！！",
    "voice": "vo_adv_1804003_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "慘叫聲！？",
    "voice": "vo_adv_1804003_020",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聲音是從那邊傳過來吧！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！！　",
    "voice": "vo_adv_1804003_021",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們走！！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然事情演變成這樣，",
    "voice": "vo_adv_1804003_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你還是一點都沒變呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我非常",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "高興唷。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "巨大魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "馬車被巨大的魔物在追趕著！",
    "voice": "vo_adv_1804003_023",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n必須快點救人！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那邊的那位！　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請快點丟下貨物逃走吧！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "混蛋！！",
    "voice": "vo_adv_1804003_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n怎麼可能這樣做！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇哇！？　",
    "voice": "vo_adv_1804003_025",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然反應出乎我意料，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但沒有比性命更重要的東西了唷！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這些可是要送到蘭德索爾的復建工程材料！",
    "voice": "vo_adv_1804003_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我怎麼可能這麼輕易丟下逃跑！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……！！",
    "voice": "vo_adv_1804003_027",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n原來是這麼一回事。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼就讓我全力協助你逃跑吧！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳在說什麼！",
    "voice": "vo_adv_1804003_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n小姐妳才很危險，快逃跑吧！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "別看我這樣，",
    "voice": "vo_adv_1804003_029",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實我很強的！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我要上了唷――！",
    "voice": "vo_adv_1804003_030",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n公主突……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "巨大魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦，",
    "voice": "vo_adv_1804003_031",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n牠連看都沒看這邊就逃走了……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這是怎麼回事。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我逃離的並不是那個魔物唷！",
    "voice": "vo_adv_1804003_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n比那個魔物更可怕的傢伙正追過來喔！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "周圍突然變暗……",
    "voice": "vo_adv_1804003_033",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那隻超巨大的魔物是什麼呀！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "超巨大魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就是那傢伙！",
    "voice": "vo_adv_1804003_034",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我躲的正的是那傢伙！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
