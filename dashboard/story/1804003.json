  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為我會吃很多的，",
    "voice": "vo_adv_1804003_046",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以請做好心理準備吧～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那麼。",
    "voice": "vo_adv_1804003_047",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖然你自然而然地就跟我一起留下來，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但對現在的你而言這樣的狀況……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵。",
    "voice": "vo_adv_1804003_048",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我就料到你會這麼回答。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，\\n可以拜託你強化我嗎？",
