    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你也",
    "voice": "vo_adv_1804003_039",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "十分拼命，\\n就是為了運送復建工程的材料不是嗎。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看到你拼命的樣子，",
    "voice": "vo_adv_1804003_040",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我怎麼可能逃跑呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "保護大家就是我的職責！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡我會想辦法的。",
