  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "生吃也好，",
