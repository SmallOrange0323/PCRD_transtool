[
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年的【哞哞自衛隊】。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由於公會成員們各自返鄉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因此霞正獨自一人，\\n在沒有其他人的公會小屋裡看著書。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……♪",
    "voice": "vo_adv_1285001_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看家",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "最棒了……♪",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n周遭這麼安靜，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讀書的效率就會好到不行。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來要看哪一本呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1285001_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對了……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n機會難得，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就來看這本……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "戀愛指南──！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──哇啊啊啊！？",
    "voice": "vo_adv_1285001_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助助助、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你沒看到我剛才藏起來的書吧？",
    "voice": "vo_adv_1285001_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒看到對吧！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好險……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼……",
    "voice": "vo_adv_1285001_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你剛才說有事件，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是發生什麼事了嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔嗯唔嗯……",
    "voice": "vo_adv_1285001_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你在城鎮接了各種事件的委託呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……",
    "voice": "vo_adv_1285001_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我原本打算悠哉地過新年，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但只要有事件發生，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "偵探業就沒有假日呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒辦法，",
    "voice": "vo_adv_1285001_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "帶我到委託人那裡去！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……啊，",
    "voice": "vo_adv_1285001_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在那之前。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我要收拾一下書本……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可以轉過去嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我的風箏被風吹走，",
    "voice": "vo_adv_1285001_009",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "不知道飛到哪裡去了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……",
    "voice": "vo_adv_1285001_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "依風向來看，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "它應該被吹往南方了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你往那個方向找找看吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊，",
    "voice": "vo_adv_1285001_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我的風箏……！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "跟偵探小姐說的一樣！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "有香油錢小偷出現了！",
    "voice": "vo_adv_1285001_012",
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "\\n錢是在晚上被偷走的。",
    "voice": null,
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "\\n明明裡面裝了那麼多香油錢……",
    "voice": null,
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "既然是拿著香油錢那麼重的東西在雪地行走……",
    "voice": "vo_adv_1285001_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "果然沒錯。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雪地上留有拖行物體的痕跡。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我們沿著痕跡找找看吧，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "可惡～！",
    "voice": "vo_adv_1285001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n明明都沒有人看到，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "為什麼會被發現～！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "我爸爸迷路了。",
    "voice": "vo_adv_1285001_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "我爸爸是路癡，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "嚴重到連他自己都承認的程度……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_1285001_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "連自己都承認是路癡的話，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那應該不會隨便亂跑才對。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n走失地點是在……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500560"
  },
  {
    "type": "dialogue",
    "name": "爸爸",
    "words": "唔哇啊～！",
    "voice": "vo_adv_1285001_017",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "爸爸",
    "words": "我跟女兒走丟了～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "爸爸",
    "words": "回不了家了啦～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "爸、",
    "voice": "vo_adv_1285001_018",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "爸爸～！？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好",
    "voice": "vo_adv_1285001_019",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這樣就大致上都解決了吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒有那麼誇張啦。",
    "voice": "vo_adv_1285001_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不管哪件都只是很初階的推理喔，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來，",
    "voice": "vo_adv_1285001_021",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "既然委託都解決了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n就繼續悠哉地過新年假期吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然想早點回去公會小屋……",
    "voice": "vo_adv_1285001_022",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過既然都出來了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那就去路邊的攤販",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n買一些能當午餐的東西再回去吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生你……",
    "voice": "vo_adv_1285001_023",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要不要一起吃啊？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵……",
    "voice": "vo_adv_1285001_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "答得好！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼就馬上去",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "逛逛攤販吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然我喜歡一個人獨處，",
    "voice": "vo_adv_1285001_025",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但跟助手先生兩個人一起過也不錯呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……嘿嘿。",
    "voice": "vo_adv_1285001_026",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1285001_027",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是在傻笑",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "什麼啊……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "別想那些了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現在要來採買食物！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咳咳！",
    "voice": "vo_adv_1285001_028",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生你想吃什麼？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦，",
    "voice": "vo_adv_1285001_029",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "人呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生～",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你跑到哪裡去了～？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1285001_030",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真傷腦筋。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n人實在太多了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就跟助手先生走散了……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "哎呀！",
    "voice": "vo_adv_1285001_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "小哥，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "不小心一點的話會跌倒喔。",
    "voice": "vo_adv_1285001_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "走路",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "要好好看著四周啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "那就再見啦～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！",
    "voice": "vo_adv_1285001_033",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "找到你了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱歉，剛才丟下你自己走掉了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1285001_034",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對了對了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我剛才在找你的時候，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也發現了看起來不錯的攤販喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你看，",
    "voice": "vo_adv_1285001_035",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那邊感覺不用排太久就能買到了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為了避免再走散，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這次我們就一起排吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "終於輪到我們了呢。",
    "voice": "vo_adv_1285001_036",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "老闆，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可以給我們兩份什錦燒嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "店老闆",
    "words": "好的～！",
    "voice": "vo_adv_1285001_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店老闆",
    "words": "兩份什錦燒對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店老闆",
    "words": "\\n800盧幣喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哎呀……",
    "voice": "vo_adv_1285001_038",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我的零錢只有700盧幣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你有100盧幣嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱歉啊，",
    "voice": "vo_adv_1285001_039",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我晚點就還你──",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯？",
    "voice": "vo_adv_1285001_040",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦咦！？",
    "voice": "vo_adv_1285001_041",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你應該不是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "把它忘在家裡了吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……",
    "voice": "vo_adv_1285001_042",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這樣的話可能是弄丟了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或是被扒手偷走了嗎……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你有什麼頭緒嗎？",
    "voice": "vo_adv_1285001_043",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n比方說有跟人撞到之類的……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "哎呀！",
    "voice": "vo_adv_1285001_044",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "小哥，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來你有些頭緒呢。",
    "voice": "vo_adv_1285001_045",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就很可能是被偷了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們去找犯人吧……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "像這種人潮眾多的時間跟地點，",
    "voice": "vo_adv_1285001_046",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n對扒手們來說",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是正適合他們的狩獵場。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現在時間還沒到中午。",
    "voice": "vo_adv_1285001_047",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n人潮才剛開始變得密集，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以犯人大概也才剛來吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "扒手不會偷一個錢包",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就回家的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也就是說，",
    "voice": "vo_adv_1285001_048",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "犯人還在這附近。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n對方應該會混在這個人群裡面。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們絕對要把犯人找出來！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……",
    "voice": "vo_adv_1285001_049",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想想。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "最簡單的做法就是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "裝成「肥羊」，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "來引對方上鉤吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有帶小孩的人因為要顧小孩，所以容易被盯上……",
    "voice": "vo_adv_1285001_050",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但很不巧，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們沒辦法裝成帶著小孩呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣的話，",
    "voice": "vo_adv_1285001_051",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再來就是──",
