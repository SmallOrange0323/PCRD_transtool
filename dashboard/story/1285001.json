    "voice": "vo_adv_1285001_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "別說這種讓人害羞的話啦～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女朋友",
    "words": "我好開心♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──裝成感覺沒在注意周遭的笨蛋情侶，",
    "voice": "vo_adv_1285001_054",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "之類的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
