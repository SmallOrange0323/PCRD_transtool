  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真步造訪了鬧區中的雜貨店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並且採買完了公會小屋所需的日常用品，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n現在則正在享受著購物的歡樂時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "神奇真步魔法靈，",
    "voice": "vo_adv_1010009_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咕嚕咕嚕靈～……☆",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010009_001",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然能在這裡",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n遇見這～麼大、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n又這麼可愛的熊熊先生呀，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是沒想到呢～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "熊熊先生，",
    "voice": "vo_adv_1010009_002",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "從今天開始你就是我們家的孩子了唷～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓我們一起在真步真步王國過生活吧♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……咦？",
    "voice": "vo_adv_1010009_003",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n行李太多了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我拿不動呀……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也沒辦法就這樣擱在這，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": "vo_adv_1010009_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n竟然能在這裡遇見您……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們果然有著",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不論在哪都能相遇的命運呀～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可是",
    "voice": "vo_adv_1010009_005",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您說要幫忙呀……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這行李，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有一點多就是了……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哇！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……嚇我一跳呢～",
    "voice": "vo_adv_1010009_006",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您難不成比我們當初相遇時",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還更強壯了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010009_007",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生真是越來越棒了呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這讓人家又更喜歡您了呀～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那麼，",
    "voice": "vo_adv_1010009_008",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "恭敬不如從命，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在到公會小屋之前……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚哇啊～！",
    "voice": "vo_adv_1010009_009",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n媽媽！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那孩子，",
    "voice": "vo_adv_1010009_010",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "迷路了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……啊，",
    "voice": "vo_adv_1010009_011",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也一塊，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "稍等一下嘛～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "……",
    "voice": "vo_adv_1010009_012",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大哥哥，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "你是誰？",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "咦……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "你能夠幫我找到媽媽嗎！？",
