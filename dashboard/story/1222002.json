    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一雪前恥。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……今天我絕對要讓他對我刮目相看！　",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──已經先像這樣炒到有點微焦了，",
