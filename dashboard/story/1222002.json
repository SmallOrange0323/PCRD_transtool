    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_1222002_048",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "無論是露營餐還是麥酒都太棒了……♪",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n雙方互相襯托彼此的滋味……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊姆。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n嗯嗯～",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "比平時還要好粗♪",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且，",
    "voice": "vo_adv_1222002_049",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "料理能這麼有飽足感……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n喝麥酒的速度也會自然地取得平衡呢～",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "果然講究飲食是對的♪",
    "voice": "vo_adv_1222002_050",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……你覺得呢？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "味道如何？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有喜歡嗎？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_1222002_051",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那道是橄欖油大蒜蝦。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n是用大蒜和橄欖油燉煮而成的料理。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然後這一道是",
    "voice": "vo_adv_1222002_052",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一開始做的魚貝類與山菜的海鮮燉飯。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這個沾在鐵板上的鍋巴也是極致美味，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你之後吃吃看！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然後最棒的是",
    "voice": "vo_adv_1222002_053",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這道起士火鍋……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你沾著各種食材吃吃看，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可以嚐到各個不同的滋味♪",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_1222002_054",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你能喜歡就太好了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這樣我努力挑選食材也是值得了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有……",
    "voice": "vo_adv_1222002_055",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這些料理和麥酒能夠這麼美味，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我覺得都是託你的福。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你想想……",
    "voice": "vo_adv_1222002_056",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像是前陣子做新鮮果汁時，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我嘴上說是",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "為了你……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但我發現那只是在單方面強迫你，",
    "voice": "vo_adv_1222002_057",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n接受我認為開心的露營……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是你",
    "voice": "vo_adv_1222002_058",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "將這杯麥酒……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不對，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是這最棒的那一杯遞給我時，讓我注意到了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "考量到彼此的樂趣",
    "voice": "vo_adv_1222002_059",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "並一起分享，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n才會成為特別的露營。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟……♪",
    "voice": "vo_adv_1222002_060",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你看，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "正好就像這杯麥酒和露營餐一樣♪",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好了，",
    "voice": "vo_adv_1222002_061",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "多吃點多吃點！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n今天我可是特別下工夫煮出來的！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "still",
    "still_id": "122200202"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……欸！？",
    "voice": "vo_adv_1222002_062",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "每、",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "每天！？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你說每天是那個……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "通通、",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "通勤妻的意思……？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才才才、",
    "voice": "vo_adv_1222002_063",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才怪呢！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那怎麼可能嘛！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n沒什麼、",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "忘掉我剛才說的！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你只是在比喻料理有這麼好吃對吧？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我、",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我知道的啦……！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話、",
    "voice": "vo_adv_1222002_064",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話說，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你居然會說每天……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "再怎麼說也讚美過頭了啦！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n如果每天吃這麼大量的食物，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是會胖的喔。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈、",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……唔唔，",
    "voice": "vo_adv_1222002_065",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都怪你突然那種耐人尋味的話，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n害我整個人都嚇到酒醒了……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "讓我再喝一杯重新回到微醺好了……",
    "voice": "vo_adv_1222002_066",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這可是你的錯喔……？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "122200201"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "{0}……",
    "voice": "vo_adv_1222002_067",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可以再幫我添",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "「最棒的那一杯」嗎？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n要把這個酒杯",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "倒滿幸福喔？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優花梨在{0}協助下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n沒有醉倒並好好享受了單日露營。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
