    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n以榮耀的純白之翼的軍人身分，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n全力向妳挑戰！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_7019005_088",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我很期待那一刻的到來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……呵呵。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "純閣下……",
    "voice": "vo_adv_7019005_089",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "再來只要能戒掉",
    "voice": "vo_adv_7019005_090",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會像這樣下意識摸我頭的習慣，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就沒什麼好抱怨的了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "算了，",
    "voice": "vo_adv_7019005_091",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一時之間也急不來。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純不會說謊的耿直風格令莫妮卡展露笑容。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而那個笑容讓戴著頭盔的純看到入迷。",
    "voice": null,
    "unit_id": null
  }
]
