[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在連續戰鬥過後，一行人成功打倒大量的魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這時，有個閃閃發光的東西掉在{0}的腳邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂，",
    "voice": "vo_adv_7019005_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n撿起那個沒問題嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……原來如此。",
    "voice": "vo_adv_7019005_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那就是尋找少年記憶的線索嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這東西真的能幫上閣下的忙嗎……？",
    "voice": "vo_adv_7019005_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔哇！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "510320"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔喔～～！！",
    "voice": "vo_adv_7019005_003",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這裡就是所謂的「遊樂園」嗎！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我還想說怎麼有尖叫聲，",
    "voice": "vo_adv_7019005_004",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那個就是雲霄飛車吧！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然才那種程度的速度就受不了，也太沒用了！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要是搭上我國的戰鬥機，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是會連尖叫聲都發不出來的！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔，",
    "voice": "vo_adv_7019005_005",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼大家都戴著虎虎的面具？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "明明不是間諜，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "他們是覺得變裝很有趣嗎？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也跟著戴就會明白嗎！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下！",
    "voice": "vo_adv_7019005_006",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我要進那家店喔！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼～",
    "voice": "vo_adv_7019005_007",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不小心連伴手禮都買了！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喏！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "除了虎虎的面具跟手帕，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我連變身腰帶都買了！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才、",
    "voice": "vo_adv_7019005_008",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才沒有！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這些是我",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要送給小小朋友們的伴手禮！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……雖、",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然不是全部啦。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "重要的是……",
    "voice": "vo_adv_7019005_009",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n讓閣下拿我的行李，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n總覺得有些過意不去，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣好嗎？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯、",
    "voice": "vo_adv_7019005_010",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然閣下都那麼說了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然閣下要我好好享受，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但我可不是來玩的喔。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "扮演虎虎的人……",
    "voice": "vo_adv_7019005_011",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來鑑定其真面目的。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就動畫來看，",
    "voice": "vo_adv_7019005_012",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "扮演的人似乎一直壓抑著實力，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但我想確認她在實戰時有多強。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "若她夠有潛力的話，",
    "voice": "vo_adv_7019005_013",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我打算遊說她加入我的隊伍。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "換句話說，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是身為軍人的工作！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣閣下明白了嗎！",
    "voice": "vo_adv_7019005_014",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我絕對不是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對跟虎虎見面感到期待！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……呃，",
    "voice": "vo_adv_7019005_015",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不要露出那種像是很欣慰的表情！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "媽媽！",
    "voice": "vo_adv_7019005_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "現在有遊行喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女 1",
    "words": "\\n我們快去看吧！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔？",
    "voice": "vo_adv_7019005_017",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "她是說遊行？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是正在進行軍事演習嗎？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難得都來了，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們也去偵察一下吧！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是怎樣！？",
    "voice": "vo_adv_7019005_018",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n有一堆閃閃發光的車在排隊喔！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "下，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們再靠近一點去看吧！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯？",
    "voice": "vo_adv_7019005_019",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "人不見了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n難不成他",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "迷路了嗎！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不。",
    "voice": "vo_adv_7019005_020",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該不會迷路人的是我……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒辦法了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就打電話聯絡吧。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我看看，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "包包在……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………",
    "voice": "vo_adv_7019005_021",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "糟糕！！",
    "voice": "vo_adv_7019005_022",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我連行李一起交給他了！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這、",
    "voice": "vo_adv_7019005_023",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這下該怎麼辦才好……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳",
    "voice": "vo_adv_7019005_024",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難道是",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "跟媽媽走散了嗎？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔唔，",
    "voice": "vo_adv_7019005_025",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然繞到我的背後，真是可惡！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且她",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然問我是不是跟媽媽走散……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "了！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n把我當成小孩子的",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到底是誰！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯？",
    "voice": "vo_adv_7019005_026",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "虎虎的面具？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔喔！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "看來妳是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "虎虎的粉絲吧！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呃……",
    "voice": "vo_adv_7019005_027",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我叫純。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳呢？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我叫莫妮卡！",
    "voice": "vo_adv_7019005_028",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還有，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "跟我走散的不是「媽媽」。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是大人，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且是充滿榮耀的軍人！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……大人？",
    "voice": "vo_adv_7019005_029",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……喔，",
    "voice": "vo_adv_7019005_030",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來是那麼一回事嗎。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這個年紀的小朋友，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "每個都是多愁善感。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n她大概是因為被當成小孩對待才生氣的吧。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_7019005_031",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是可愛……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡。",
    "voice": "vo_adv_7019005_032",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把妳當小孩子對待，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我感到很抱歉。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有什麼是我能幫忙的嗎？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "剛才的話好像有點不太對勁，",
    "voice": "vo_adv_7019005_033",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n其實我",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "正在找某個男人……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨，",
    "voice": "vo_adv_7019005_034",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n抱歉我們遲到了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……閣下，",
    "voice": "vo_adv_7019005_035",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "抱歉我不小心走散了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呃，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你是在笑什麼啊！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼！？",
    "voice": "vo_adv_7019005_036",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們會牽手，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是因為純閣下",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怕我會走散，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我才勉強跟她牽的！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "然後",
    "voice": "vo_adv_7019005_037",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這個糖果是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "純閣下買給我的……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……事先聲明，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我可沒有露出想要的眼神喔！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不說那個了，",
    "voice": "vo_adv_7019005_038",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你應該有更重要的話要說吧！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我可是第一次知道你們認識喔！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也是嚇了一跳。",
    "voice": "vo_adv_7019005_039",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒想到妳原來是少年帶來的。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，少年，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我把莫妮卡還你了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好啦，",
    "voice": "vo_adv_7019005_040",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "秀很快就要開始了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們就好好欣賞吧。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我先告辭了……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "純閣下",
    "voice": "vo_adv_7019005_041",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "走掉了呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我聽說她是在這裡工作。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我不小心妨礙到她執行任務了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼，閣下。",
    "voice": "vo_adv_7019005_042",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n來這裡",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就能見到虎虎對吧！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n虎虎人",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在哪裡！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……咦？",
    "voice": "vo_adv_7019005_043",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "虎虎",
    "words": "向天祈禱吧，",
    "voice": "vo_adv_7019005_044",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "虎虎",
    "words": "惡徒！",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "虎虎",
    "words": "\\n接受正義的制裁吧……！",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "上啊～！",
    "voice": "vo_adv_7019005_045",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "虎虎！！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "少女 2",
    "words": "加油！！",
    "voice": "vo_adv_7019005_046",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是那裡！",
    "voice": "vo_adv_7019005_047",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很好很好，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "別輸了～！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "明明動作很輕盈，",
    "voice": "vo_adv_7019005_048",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "拳頭卻十分沉重……！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到純閣下就是虎虎……！　",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過，太可惜了。",
    "voice": "vo_adv_7019005_049",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我看得出她一直在壓抑實力。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果有那樣的部下，",
    "voice": "vo_adv_7019005_050",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "應該會很令人安心吧。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我一定要",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "跟純閣下",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "背對背戰鬥一次看看……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……怎麼？",
    "voice": "vo_adv_7019005_051",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "辦得到嗎？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我該怎麼做才行！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "壞蛋首領",
    "words": "咯咯咯……",
    "voice": "vo_adv_7019005_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "壞蛋首領",
    "words": "\\n這樣就結束了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "壞蛋首領",
    "words": "虎虎！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "糟糕！",
    "voice": "vo_adv_7019005_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "虎虎陷入危機了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "\\n現場有朋友",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "願意跟虎虎一起戰鬥",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "我我！！",
    "voice": "vo_adv_7019005_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔哇！？",
    "voice": "vo_adv_7019005_055",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n閣下",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼要舉起我的手！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可不是什麼朋友喔！？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "那麼……",
    "voice": "vo_adv_7019005_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "就那個女孩子！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秀場大姐姐",
    "words": "\\n請上舞台來！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我嗎！？",
    "voice": "vo_adv_7019005_057",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都是閣下害的喔……！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
