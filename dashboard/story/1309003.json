    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "欸欸！",
    "voice": "vo_adv_1309003_008",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我也一起嗎！？",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "怎麼行怎麼行，",
