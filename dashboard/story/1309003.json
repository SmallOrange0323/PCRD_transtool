  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "真好玩呢♪",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n使用魔法道具",
