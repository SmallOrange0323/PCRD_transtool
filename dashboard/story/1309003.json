  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "讓我跟英雄先生一起玩這種事，",
