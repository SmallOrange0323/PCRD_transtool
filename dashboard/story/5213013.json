    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……然而此事不必多言，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "縮之漲之皆隨奴家所願。",
