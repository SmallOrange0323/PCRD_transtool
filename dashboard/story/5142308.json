[
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唔喔喔！？",
    "voice": "vo_adv_5142308_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好強的力量……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "光是吼叫聲就讓人感到全身緊繃！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "小心點喔，",
    "voice": "vo_adv_5142308_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "惠理子！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有{0}！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這傢伙，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "打算用下一招確實致我們於死地！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哼，",
    "voice": "vo_adv_5142308_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是令人不悅啊，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這隻畜生……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不只對我們，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "甚至還想危害這位大人，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那麼我可不會手下留情。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "很好……",
    "voice": "vo_adv_5142308_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n想來的話",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就來吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我要把你的自尊心，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "連同你那根大角一起折斷──！",
    "voice": null,
    "unit_id": 129911
  }
]
