  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為累積了對涅妃‧涅羅公主的不滿，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蠍獅妖魔人華音終於舉起反叛的大旗。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
