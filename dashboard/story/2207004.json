    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}等人為了阻止華音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由拿娜帶領大家前往吉歐‧格黑納的「火聚山」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而說服失敗了──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "請於此現身吧！",
    "voice": "vo_adv_2207004_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n封印於煉獄的火聚九頭龍──",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "大地海德拉！！！",
    "voice": null,
    "unit_id": 134911
