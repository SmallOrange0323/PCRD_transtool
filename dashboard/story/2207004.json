    "name": "凱留",
    "words": "\\n所以引發了蒸氣噴發嗎！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其他人呢……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
