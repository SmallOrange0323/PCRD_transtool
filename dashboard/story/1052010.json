  {
    "type": "dialogue",
    "name": "旁白",
    "words": "莉瑪勤奮做著每天的伐木工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿咻，",
    "voice": "vo_adv_1052010_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "欸～☆",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "以平常的姿態",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就能輕鬆砍下木頭，真不錯呢♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "變身成人類姿態的時候，",
    "voice": "vo_adv_1052010_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就沒辦法做這種力氣活，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是遭到暴徒襲擊",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也會無法應對。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "之前雖然有被誤以為是魔物而遭到襲擊，",
    "voice": "vo_adv_1052010_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但以女孩子的身分遇到危險",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那還是",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "第一次呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現在回想起來",
    "voice": "vo_adv_1052010_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會覺得非常可怕，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但拉著我的手逃走的",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n{0}",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的～",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "超帥氣的♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "簡直",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就像是故事裡的情節呢……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那如果是個故事，",
    "voice": "vo_adv_1052010_004",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我就是",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嬌弱的貴族大小姐，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個人",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就是服侍我的執事吧……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我被強迫嫁給不想結婚的對象，",
    "voice": "vo_adv_1052010_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而那個人將我從那困境中救出。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "蠻橫的父親卻放出追兵追趕我們，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "兩人漸漸被逼得走投無路，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最後被追到死巷子……！！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "住手！　",
    "voice": "vo_adv_1052010_006",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "別對那個人動粗！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會如父親所望去結婚，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請救救那個人！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}",
    "voice": "vo_adv_1052010_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "他是我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "重要的",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人啊……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "欸！？",
    "voice": "vo_adv_1052010_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你你你",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "什麼時候在這裡的！？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就在剛才。",
    "voice": "vo_adv_1052010_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那你",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "應該只聽到",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一點點而已吧……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "從貴族大小姐那裡就在聽了？",
    "voice": "vo_adv_1052010_010",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那不就是",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "從一開始就在聽了嗎！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "羞死人了啦～～！！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……很奇怪對吧，",
    "voice": "vo_adv_1052010_011",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n輕輕鬆鬆就能舉起整塊木頭的我，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "居然會是嬌弱的大小姐。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒有那回事？",
    "voice": "vo_adv_1052010_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你果然",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是個很溫柔的人呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "正因為是這樣的你，",
    "voice": "vo_adv_1052010_013",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀～～～～～～～～～～～！！",
    "voice": "vo_adv_1052010_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "慘叫聲！？",
    "voice": "vo_adv_1052010_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n聲音是那個方向傳來的對吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n走吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救、",
    "voice": "vo_adv_1052010_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救命啊～～！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現在來救你了！",
    "voice": "vo_adv_1052010_017",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n要上囉～！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "喝～！！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呼。",
    "voice": "vo_adv_1052010_018",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是千鈞一髮呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n還好嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1052010_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊、討厭，糟糕了！",
    "voice": "vo_adv_1052010_020",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我這個樣子",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是不是會嚇到人家！？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要怎麼辦才好！？　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哎呀～～～～！！",
    "voice": "vo_adv_1052010_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n謝謝你們",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在危急的時候",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救了我！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是得救了！　",
    "voice": "vo_adv_1052010_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "畢竟是這種偏僻的地方，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n原本還以為已經沒救了呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話又說回來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那身玩偶裝做得可真精緻～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，",
    "voice": "vo_adv_1052010_023",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "喂、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "喂～！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你不要那樣子隨便亂摸啦～！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "啊，",
    "voice": "vo_adv_1052010_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "不小心就犯了職業病。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "\\n我在某個劇團",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "擔任導演和負責大道具……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "嗯？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "\\n我說你",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "前陣子該不會",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "有來看我們的戲劇演出吧？",
