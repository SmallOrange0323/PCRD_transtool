    "words": "\\n……桌子上",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有在下的照片……？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是那樣啊……",
    "voice": "vo_adv_5201008_070",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "父親大人",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在桌上放了在下的",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "照片……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5201008_071",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個……",
    "voice": "vo_adv_5201008_072",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "父親大人",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是一位沉默的人，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也是一位很聰穎的人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在下總是",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不曉得父親大人",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在想什麼。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "或許",
    "voice": "vo_adv_5201008_073",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "並不配當他的女兒，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這類想法……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在下偶爾也會有",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣的不安……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "畢竟",
    "voice": "vo_adv_5201008_074",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "今天的宙叔叔",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "看起來很開心啊。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n他說是因為能見到女兒",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "喔。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_5201008_075",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "──可蘿。",
    "voice": "vo_adv_5201008_076",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "！",
    "voice": "vo_adv_5201008_077",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "父親大人……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "沒想到妳在這種地方。",
    "voice": "vo_adv_5201008_078",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n我剛剛在找妳喔。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "非常抱歉，",
    "voice": "vo_adv_5201008_079",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "父親大人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都是因為",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下沒有遵守",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "父親大人的囑託……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "不，",
    "voice": "vo_adv_5201008_080",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n雖說妳是個比實際年齡更加可靠的孩子，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "但讓妳",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "在遠處等待的父親才有錯。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "而且讓妳見到其他的七冠，",
    "voice": "vo_adv_5201008_081",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "似乎也會對妳的成長有過度影響啊。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "以後",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "我會注意的。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……是妳發現迷路的她吧。",
    "voice": "vo_adv_5201008_082",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "感謝妳",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "引導可蘿。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "嗯。",
    "voice": "vo_adv_5201008_083",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "走吧，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "可蘿。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n妳肚子餓了吧，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "我們",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "先去吃飯。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好的，",
    "voice": "vo_adv_5201008_084",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "父親大人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "稍等一下。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那個，",
    "voice": "vo_adv_5201008_085",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下與您，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還能不能在哪見到面呢……！",
