[
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "{0}たちとの戦いに敗れたノウェムとオクトー",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n街に戻ってもノウェムは悔しさを爆発させていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "うぎーっ！　",
    "voice": "vo_adv_5110603_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "また負けたぞコンチクショー！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いやいや、",
    "voice": "vo_adv_5110603_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "強かったねぇ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "まさかあそこからあんな粘るなんて、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n今回はボクらの完敗だよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "今回は、",
    "voice": "vo_adv_5110603_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "じゃない！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n今回も、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "だろ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あれぇ？　",
    "voice": "vo_adv_5110603_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そうだっけ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "昔のことはよく覚えてないなぁ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ヘラヘラすんな！",
    "voice": "vo_adv_5110603_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nアタシたち負けたんだぞ？　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "もっと悔しがれよ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "んー、",
    "voice": "vo_adv_5110603_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そうは言ってもさ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "勝負事なんて",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "負ける時は負けるもんだよ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクだって",
    "voice": "vo_adv_5110603_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "別に負けに行ってるわけじゃないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nこれでも勝つために",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "色々考えてるんだからね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "でも、",
    "voice": "vo_adv_5110603_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "勝負は水物だからね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "万全で挑んで",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "勝利目前だったとしても、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nわずかな要因でひっくり返されるなんて",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "よくあることだよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "だからボクは勝つための努力は惜しまないけど、",
    "voice": "vo_adv_5110603_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nその後の結果までは",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "高望みしないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "逆にノウェムが",
    "voice": "vo_adv_5110603_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そこまで必死になる意味が",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクには分からないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "もっと気楽にいけばよくない？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうか、",
    "voice": "vo_adv_5110603_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "分からないか……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なら教えてやるよ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "負けたら面白くないに決まってるだろ！",
    "voice": "vo_adv_5110603_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシは勝って、",
    "voice": "vo_adv_5110603_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "気持ちよく高らかに笑いたいんだよ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "負けても次がんばろうなんて、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちっとも面白くないだろ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "戦いは",
    "voice": "vo_adv_5110603_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "全部勝つ！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "それがアタシの生き方だ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "はぁ……",
    "voice": "vo_adv_5110603_014",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "疲れそうな生き方だね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクには到底できそうにないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ふん、",
    "voice": "vo_adv_5110603_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエに分かってもらおうなんて思ってないからな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nアタシはもう寝るから、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "次は勝てるようにそのおかっぱ頭ひねっとけ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "やれやれ、",
    "voice": "vo_adv_5110603_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "困った子だね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "でも、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "その真っすぐさは",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "結構うらやましいんだよ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ノウェムには、",
    "voice": "vo_adv_5110603_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクにはできない生き方を",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "どこまでも貫いてほしいから、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクはどこまでも",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "嫌味なおかっぱ野郎でいくとしますかね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "去り行くムイミの背中にそっと語りかけるオクトーだった。",
    "voice": null,
    "unit_id": null
  }
]
