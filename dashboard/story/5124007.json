  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸和空花，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]你們都稍微降個溫、冷靜一點……",
