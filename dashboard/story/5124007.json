    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我絕對不允許！！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]嘻嘻嘻～♪",
    "voice": "vo_adv_5124007_023",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]空花和虐待狂先生的夏天終於開始了～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]在熱到快讓人融化的陽光下，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]虐待狂先生緊盯著\\n滿身是汗的空花……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]流口水～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]唉……",
    "voice": "vo_adv_5124007_024",
