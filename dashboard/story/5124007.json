  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]{0}等人順利除靈完畢，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n[FFFFFFFF]聽到消息的海灘度假村老闆也來了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]各位！",
    "voice": "vo_adv_5124007_000",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]我聽說了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]你們終於",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]成功祛除了惡靈……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]是的。",
    "voice": "vo_adv_5124007_001",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我們也在度假村內繞了幾圈，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]到處都沒有殘留任何靈氣。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我想應該是完全祛除了。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]太好了……",
    "voice": "vo_adv_5124007_002",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]我聽說事情好像很棘手，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n[FFFFFFFF]所以很擔心各位呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]像是空花小姐和骷髏老爸",
    "voice": "vo_adv_5124007_003",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]被幽靈襲擊差點身亡……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]或是在海邊被抓住腳",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]差點溺水……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]還有在外圍的洞窟",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]碰到強烈的靈異現象……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]嘻嘻嘻……",
    "voice": "vo_adv_5124007_004",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n[FFFFFFFF]但那些",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]全部",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]都是空花",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]和骷髏老爸做的好事……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]就、",
    "voice": "vo_adv_5124007_005",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]就隱瞞真相吧……",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]全部說出來的話，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]會害老闆變得很混亂的……",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]雖、",
    "voice": "vo_adv_5124007_006",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]雖說發生了很多事是事實，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]但這樣一來海灘度假村",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]就不會再出現惡靈了，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]請放心吧。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]啊啊，",
    "voice": "vo_adv_5124007_007",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]謝謝你們！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]各位靈能力者。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n[FFFFFFFF]我該怎麼答謝你們才好……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]這份恩情，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]光只有酬金可不夠！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]對了……！",
    "voice": "vo_adv_5124007_008",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]你們願意的話，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]要不要在這個夏天，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n[FFFFFFFF]隨意使用這座度假村呢？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]我想向你們表達最大的謝意！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]來打工的你也是。",
    "voice": "vo_adv_5124007_009",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n[FFFFFFFF]從今天開始",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]你不再是工讀生，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "[FFFFFFFF]而是以客人的身分",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n[FFFFFFFF]來好好享受這座度假村吧！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這、",
    "voice": "vo_adv_5124007_010",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這怎麼行。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我也不知道要怎麼在度假村度假……",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]我就不必了。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]度假村！？",
    "voice": "vo_adv_5124007_011",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]連住好幾天！？",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]讓泳裝美女成為後宮的機會，",
