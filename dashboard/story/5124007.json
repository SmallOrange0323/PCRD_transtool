    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]小、",
    "voice": "vo_adv_5124007_026",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]小伙子你做什麼！？",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]虐待狂先生，",
    "voice": "vo_adv_5124007_027",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]竟然用水刑這種瘋狂的玩法～！？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]不過不過，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]冰冰涼涼的好舒服～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]真是的……",
    "voice": "vo_adv_5124007_028",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
