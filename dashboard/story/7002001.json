  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n茜里也是，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這種地方防衛就不能鬆懈啊，你要當心一點！",
