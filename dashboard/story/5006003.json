[
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面……\\n感受到異狀而進入『王宮』內的純，\\n目擊到了不可思議的景象。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你、",
    "voice": "vo_adv_5006003_000",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你要幹嘛？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n為何突然攻擊，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "該不會是要謀反？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "嗚呀啊啊啊啊啊！！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士？？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……這是",
    "voice": "vo_adv_5006003_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼狀況？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "【王宮騎士團（NIGHTMARE）】的成員正在\\n刀劍相向……",
    "voice": "vo_adv_5006003_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "互相殘殺嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好好的同伴，怎麼會變成這樣？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……唔？",
    "voice": "vo_adv_5006003_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊啊少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不是說可能會有危險，叫你先回去了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你能聽進年長者的話。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_5006003_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "希望你好好反省。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果你受了傷，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會一直很愧疚的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然這麼說很任性……",
    "voice": "vo_adv_5006003_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但希望你能為了我，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好珍惜自己的身體。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……",
    "voice": "vo_adv_5006003_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很高興能有你這份心意，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但這是沒有必要的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為這是我的工作，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我本來就知道它的危險性。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n再說你也只是個",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身處和平的善良市民而已。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……哎呀，",
    "voice": "vo_adv_5006003_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來我沒有閒功夫可以悠哉聊天。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "到處都有暴徒橫行，",
    "voice": "vo_adv_5006003_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不應該任意移動才是。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快來躲在我身後。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然還不清楚現在的情形，",
    "voice": "vo_adv_5006003_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但得先制止正在戰鬥的大家。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們幾個！　",
    "voice": "vo_adv_5006003_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是在鬧什麼？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n立刻",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "停止戰鬥！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在充滿高貴之人的『王宮』中",
    "voice": "vo_adv_5006003_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "大聲喧鬧又胡言亂語，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這可是會遺臭萬年的！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "啊啊啊，",
    "voice": "vo_adv_5006003_012",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "團長！　",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "團長是正常的吧？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n這、這傢伙，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "不知為何突然襲擊我……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "噫呀！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "still",
    "still_id": "500600301"
  },
  {
    "type": "dialogue",
    "name": "純？",
    "words": "…………",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呣？",
    "voice": "vo_adv_5006003_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "嗯，",
    "voice": "vo_adv_5006003_014",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n有兩個團長……？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "咿！？",
    "voice": "vo_adv_5006003_015",
    "unit_id": 712
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "危險！",
    "voice": "vo_adv_5006003_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你別光害怕站著不動，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "至少得做出抵抗啊！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "平時是為了什麼而做那些嚴格訓練，",
    "voice": "vo_adv_5006003_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不就是為了應付這種緊急狀況嗎！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "是、是的！",
    "voice": "vo_adv_5006003_018",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "但是",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "完全搞不清楚狀況……！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不也一樣嗎。",
    "voice": "vo_adv_5006003_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但也不能不處理吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "保護『王宮』內的安全，",
    "voice": "vo_adv_5006003_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是我們【王宮騎士團（NIGHTMARE）】最優先的事項。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "牢騷等結束再說！",
    "voice": "vo_adv_5006003_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n【王宮騎士團（NIGHTMARE）】的全員，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n若能理解我說的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就趕緊準備應付狀況。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了正義和和平，",
    "voice": "vo_adv_5006003_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "盡你們最大的力量！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈☆",
    "voice": "vo_adv_5006003_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你還是一如往常的認真優等生形象，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n淨說些無聊的話呢……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "團長？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5006003_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲提娜副團長！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在這種混亂的情形下，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就別露出一副理所當然的樣子啦，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還是你早知道會這樣？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不，只是偶然呢。",
    "voice": "vo_adv_5006003_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是這混亂的情況吸引我來的呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我正跟『陛下』一起享受喝茶時光，",
    "voice": "vo_adv_5006003_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n被這情況打擾到，挺火大的喲。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你這傢伙，",
    "voice": "vo_adv_5006003_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "神智清醒嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "常有人這樣問我。",
    "voice": "vo_adv_5006003_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但說實在，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到底有沒有理智是由誰來評斷的呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "又該用什麼標準來評斷呢？",
    "voice": "vo_adv_5006003_029",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說不定連神都無法判別呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "非神的我們，",
    "voice": "vo_adv_5006003_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也只能以自己的標準……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n基於自己的正義感行動而已。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這就是【王宮騎士團（NIGHTMARE）】的規矩吧？團長♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊……",
    "voice": "vo_adv_5006003_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n太好了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲很冷靜呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5006003_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我已經說過很多次了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n可以叫我『克莉絲』的只有我朋友！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且我也只是隨便說說的，",
    "voice": "vo_adv_5006003_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你把他當真害我覺得怪不好意思的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_5006003_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n真是愚蠢呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "虧我還很開心能和不擅言談的團長閒話呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是嘛，",
    "voice": "vo_adv_5006003_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果要模仿，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就該學得像一點呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "完全沒有讓人稱讚的價值呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊真讓人不悅！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那劍法和動作，",
    "voice": "vo_adv_5006003_036",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一點都不俐落，太空洞了！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真不像樣！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n簡直就是個笑話呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如果你打算以這種程度模仿團長的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也不過是光有外表罷了！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可是對連我都認同的團長，",
    "voice": "vo_adv_5006003_037",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不，應該說是對騎士的",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "天大侮辱！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會奪下你的首級，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以就一邊親吻地板，一邊為你的不敬懺悔吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "純？",
    "words": "──呱喔喔喔喔喔！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……唔，",
    "voice": "vo_adv_5006003_038",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒什麼手感。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚哇……",
    "voice": "vo_adv_5006003_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看到和自己外貌相同的人的頭被砍下，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還真的不太舒服呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有，克莉絲，",
    "voice": "vo_adv_5006003_040",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不可以在不知對方來歷的情況下，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就不由分說地殺了對方。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……還真是善良。",
    "voice": "vo_adv_5006003_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是話說回來，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n感覺對方也不是能用一般方式來對付的角色？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 104714
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……復活了？",
    "voice": "vo_adv_5006003_042",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n明明就把頭也砍下了說？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 713
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_5006003_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而且還聚集了更多詭異的傢伙呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到底是怎麼回事，",
    "voice": "vo_adv_5006003_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然好像不是很強……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但搞不清楚身分，也夠讓人覺得恐怖了？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_5006003_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不知道，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就像惡夢一樣呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n該不會是那個，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近傳言中的『闇影』？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": "vo_adv_5006003_046",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是那個長得幾乎跟現實中存在的人一樣，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n類似魔物一樣",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "的東西嘛……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我也和他們交戰過幾次，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但覺得好像不太一樣？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過也僅止於直覺就是了。",
    "voice": "vo_adv_5006003_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n只要用能殺死一般人的攻擊去對付『闇影』，通常就能打倒他們了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這些傢伙就算頭都落地了，手腳也都飛了還是像沒事一樣。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且。",
    "voice": "vo_adv_5006003_048",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n剛剛稍微看到了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "鎧甲裡可是空的呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "『闇影』雖然曖昧不明，但至少擁有類似肉體的身軀，",
    "voice": "vo_adv_5006003_049",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n剛剛那些傢伙則好像是只有表面一般。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真無趣呢。",
    "voice": "vo_adv_5006003_050",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我還想一邊享受切進肉體的手感，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n一邊在悲鳴中享受戰鬥的歡愉的說。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我還真不懂克莉絲的興趣呢……",
    "voice": "vo_adv_5006003_051",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果不是『闇影』的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼那些傢伙到底來者何人？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誰知道呢？",
    "voice": "vo_adv_5006003_052",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我也不是學者才不知道呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也沒什麼興趣就是了。",
    "voice": null,
    "unit_id": 107111
  }
]
