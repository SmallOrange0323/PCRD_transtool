    "type": "dialogue",
    "name": "雪菲",
    "words": "我能做的是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……妳要離開嗎？",
    "voice": "vo_adv_2112099_014",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒有別的",
    "voice": "vo_adv_2112099_015",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "選擇了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因為",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我光是待在你們附近，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n就會讓重要的情報",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
