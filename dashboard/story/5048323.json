[
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇！",
    "voice": "vo_adv_5048323_000",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "魔、",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "魔力怎麼又提高了啊……？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊、",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可能要撐不下去了……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "振作一點！",
    "voice": "vo_adv_5048323_001",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聽好了，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對方的魔力確實高得驚人。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "老實說，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "光是被那股魔力擊中，就有可能昏厥過去。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": "vo_adv_5048323_002",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對方面臨的也是一樣的絕境。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n他也是被逼到窮途末路",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "才會做出垂死掙扎。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只要熬過眼前的難關，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "勝利就在我們手中了！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊……",
    "voice": "vo_adv_5048323_003",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "來，",
    "voice": "vo_adv_5048323_004",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "讓我們握著彼此的手。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們兩個要守護好拉菲和蘭德索爾！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……嗯！",
    "voice": "vo_adv_5048323_005",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們上吧，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里會給姊姊",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一～大堆勇氣的！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我也會",
    "voice": "vo_adv_5048323_006",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "把永不挫敗的強韌決心",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "託付給茜里的！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "蘭德索爾的雙胞胎美少女天使！",
    "voice": "vo_adv_5048323_007",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就在這裡，",
    "voice": "vo_adv_5048323_008",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們不會輸的！",
    "voice": null,
    "unit_id": 113811
  }
]
