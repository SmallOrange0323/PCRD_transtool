[
  {
    "type": "background",
    "bg_id": "500997"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "牧場温泉開業に向けて着々と準備を進める",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n【牧場（エリザベスパーク）】のメンバーたちは",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n何やら頭を抱えていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ん～",
    "voice": "vo_adv_5040700_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "困ったな。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "どうすっべ。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私が",
    "voice": "vo_adv_5040700_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "なんとかがんばれば……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "シオリちゃんには",
    "voice": "vo_adv_5040700_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "チラシを作り足してもらわないといけないでしょ。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "早めに仕事を片づけるから",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "私がやるわ。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "みんな難しそうな顔して",
    "voice": "vo_adv_5040700_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "どうしたの？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "何かあった？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "リンリン！　",
    "voice": "vo_adv_5040700_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ちょうどいいところに！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "な、",
    "voice": "vo_adv_5040700_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なになに？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n面倒なことならいやだよ？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そっか……",
    "voice": "vo_adv_5040700_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "やっぱりオラたちでどうにかするしかねぇか。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "そうですね。",
    "voice": "vo_adv_5040700_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\nリンちゃんは連日チラシ配りで疲れてるでしょうし。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あーもう！　",
    "voice": "vo_adv_5040700_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんなの！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n言ってくれなきゃなんのことか分からないよ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "一回言ってみなよ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "そう？　",
    "voice": "vo_adv_5040700_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "あのね、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "倉庫を片づけてたら",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "\\nお客さんのお土産にできそうな",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "熟成チーズが見つかったんだけど、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "チーズの匂いに釣られて",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "ねずみが来ちゃってるのよ。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "チーズを食べられないように見張りを立てなきゃいけないんだけど、",
    "voice": "vo_adv_5040700_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私たちは",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "いろんな作業で手が離せなくて。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あー",
    "voice": "vo_adv_5040700_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "確かに",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしはチラシなくなっちゃったから",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "手が空いてるね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "リンリン、",
    "voice": "vo_adv_5040700_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "疲れてると思うけど",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "チーズの見張り",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "やってくんねぇか？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "…………",
    "voice": "vo_adv_5040700_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "疲れてるなら",
    "voice": "vo_adv_5040700_014",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "無理しなくていいのよ！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "見張りって結構疲れるし！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "そうです。",
    "voice": "vo_adv_5040700_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私はチラシ作りしかやってないし、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私が見張りを……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんなに気を使ってくれなくても大丈夫だよ。",
    "voice": "vo_adv_5040700_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしがやるよ、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "チーズの見張り。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ほんとだべか！？",
    "voice": "vo_adv_5040700_017",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "うん。",
    "voice": "vo_adv_5040700_018",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "見張りって言っても相手はねずみでしょ？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そのくらいなら平気平気。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "本当に大丈夫？",
    "voice": "vo_adv_5040700_019",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "\\n無理しなくていいんだからね。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "そうだよ。",
    "voice": "vo_adv_5040700_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\nリンちゃん",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "ずっと歩き回って疲れてるだろうし。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "平気だから！　",
    "voice": "vo_adv_5040700_021",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そりゃ確かにめんどくさいけど、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n人手が足りないんだから",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "やれることはやるって！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしに任せて",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "みんなは自分の仕事して。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "リンリン、",
    "voice": "vo_adv_5040700_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ほんとうにあんがとな。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "リマ",
    "words": "手が空いたときは私たちも手伝うから！",
    "voice": "vo_adv_5040700_023",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "だから無理しなくて大丈夫だよ。",
    "voice": "vo_adv_5040700_024",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "…………みんな",
    "voice": "vo_adv_5040700_025",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしのことなんだと思ってるのさ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いやまぁ、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "手伝ってくれる分には助かるけど。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そんじゃあリンリン。",
    "voice": "vo_adv_5040700_026",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\nチーズのことは任せたべ。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "はいはい。",
    "voice": "vo_adv_5040700_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "大船に乗った気で居てよ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "チーズくらいあたしが守ってみせるから。",
    "voice": null,
    "unit_id": 102611
  }
]
