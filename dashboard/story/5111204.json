[
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚……",
    "voice": "vo_adv_5111204_000",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一來到這裡，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就突然有點頭暈……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明應該能抵抗那些傢伙的力量才對……",
    "voice": "vo_adv_5111204_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這裡危險到連我們也會受到影響……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那不就代表……",
    "voice": "vo_adv_5111204_002",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你還好嗎！？",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……老實說，",
    "voice": "vo_adv_5111204_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "有點不好受。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過我和他一樣，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "借助諾維姆妳們的力量還能撐著。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過，",
    "voice": "vo_adv_5111204_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "如果會因為這樣就害怕，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那我打從一開始就不會來了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們好歹",
    "voice": "vo_adv_5111204_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "也是經歷過不少難關的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀……",
    "voice": "vo_adv_5111204_006",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只有你才是我的搭檔！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好～",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就全力衝刺吧！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔喔──！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哇，",
    "voice": "vo_adv_5111204_007",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "她像隻卸下狗鍊的狗一樣衝出去了喔？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦、",
    "voice": "vo_adv_5111204_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦咦……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我狀態可沒有好到精神百倍的說。",
    "voice": null,
    "unit_id": 106211
  }
]
