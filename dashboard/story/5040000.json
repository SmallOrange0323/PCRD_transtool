[
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真陽結束了兜售的工作回到了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n氣氛一如往常恬靜的【伊麗莎白牧場】。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我回來啦～",
    "voice": "vo_adv_5040000_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "歡迎回來～",
    "voice": "vo_adv_5040000_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？　",
    "voice": "vo_adv_5040000_002",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴竟然出來迎接我，還真是難得。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "原來妳這麼期待我回來啊？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我才不是在等真陽啦。",
    "voice": "vo_adv_5040000_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是因為訂的遊戲",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "差不多要送到了才出來等的。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果妳有多餘的空閒的話，",
    "voice": "vo_adv_5040000_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "偶爾也跟我一起",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n到鎮上去兜售吧？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "很有意思喔。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那倒是免了。",
    "voice": "vo_adv_5040000_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "說起來，妳還真有辦法這樣每天都拿著笨重的行李",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n到鎮上去呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要想到鎮上人們開心的表情，",
    "voice": "vo_adv_5040000_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這些東西的重量根本沒什麼啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且，",
    "voice": "vo_adv_5040000_007",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也多虧大家買了很多回去，所以回程是很輕鬆的～",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "用那台攤車的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴應該也能拉得動啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "莉瑪比我更能勝任那種工作吧。",
    "voice": "vo_adv_5040000_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "而且真陽也能輕鬆一點。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪她其他的工作已經做得夠多了啦。",
    "voice": "vo_adv_5040000_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我也不能把她帶到人很多的地方去啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "既然我們幾個都可以接受的話，",
    "voice": "vo_adv_5040000_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我想大家也沒問題的～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "習慣就好～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "習慣就好。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我巡視結束囉，",
    "voice": "vo_adv_5040000_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "鈴……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳今天回來得真早。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我回來了～",
    "voice": "vo_adv_5040000_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒有啦～",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "最近這一陣子",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n印有伊麗莎白牧場標記的商品都賣得飛快呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我一個人能夠帶出去的量，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "瞬間就賣光光了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也很想幫上妳的忙……",
    "voice": "vo_adv_5040000_013",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n可是卻只能想像出自己礙手礙腳的畫面。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞已經做夠多的工作了，妳別介意啦。",
    "voice": "vo_adv_5040000_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "兜售的工作我請鈴鈴幫忙就好啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼結論會變成這樣啊。",
    "voice": "vo_adv_5040000_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這應該去找莉瑪幫忙的嘛～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "鈴鈴和莉瑪莉瑪聽起來差不多嘛，一定可以的啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳在亂扯些什麼的啦。",
    "voice": "vo_adv_5040000_016",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果莉瑪莉瑪自己也想要去鎮上的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n請她幫忙說不定也不錯呢……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那就去問問看莉瑪吧！",
    "voice": "vo_adv_5040000_017",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n莉瑪在哪裡啊？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳要找莉瑪的話，",
    "voice": "vo_adv_5040000_018",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我剛剛看到她正在森林裡睡得很香喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "竟然撇下我跑去偷懶。",
    "voice": "vo_adv_5040000_019",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不可原諒，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "莉瑪這傢伙。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳有什麼資格說別人啊……",
    "voice": "vo_adv_5040000_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n莉瑪莉瑪可是幫我們做了很多粗重的工作，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n偶爾會打個瞌睡也很正常的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦～",
    "voice": "vo_adv_5040000_021",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "太狡猾了吧～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說什麼狡猾，",
    "voice": "vo_adv_5040000_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真要說的話鈴鈴妳啊……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊！",
    "voice": "vo_adv_5040000_023",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "　該不會是我的遊戲送到了吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我話還沒有說完的啦！",
    "voice": "vo_adv_5040000_024",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真是的，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴真是讓人傷腦筋。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "遊戲♪　",
    "voice": "vo_adv_5040000_025",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "遊戲～♪　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "今天要來玩個通宵囉～！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5040000_026",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你不是來送…………",
    "voice": "vo_adv_5040000_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "遊戲……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "的吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "開始徵收家畜。",
    "voice": "vo_adv_5040000_028",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊？　",
    "voice": "vo_adv_5040000_029",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "家畜……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "徵收？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，",
    "voice": "vo_adv_5040000_030",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "等一下！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5040000_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你、",
    "voice": "vo_adv_5040000_032",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你們是幹嘛的！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n從哪兒冒出來的！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們被團團圍住了！？",
    "voice": "vo_adv_5040000_033",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳就是【伊麗莎白牧場】的公會會長嗎？",
    "voice": "vo_adv_5040000_034",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊，",
    "voice": "vo_adv_5040000_035",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我就是公會的會長，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "找我有什麼事嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真陽，",
    "voice": "vo_adv_5040000_036",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這個人，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好像說什麼要徵收家畜耶！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊……？　",
    "voice": "vo_adv_5040000_037",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "徵收？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "意思是要把我們的牛都帶走嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為什麼！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不要抵抗。",
    "voice": "vo_adv_5040000_038",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "否則可是會吃苦頭的。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "別說是抵抗了，",
    "voice": "vo_adv_5040000_039",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我根本都還搞不清楚發生了什麼事……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽！　",
    "voice": "vo_adv_5040000_040",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳看那邊！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n他們正在把牛趕到馬車上耶！？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇哇哇！？　",
    "voice": "vo_adv_5040000_041",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "住手！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "別這樣……！！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我應該已經說過了，叫妳不要抵抗了。",
    "voice": "vo_adv_5040000_042",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n動手。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是。",
    "voice": "vo_adv_5040000_043",
    "unit_id": 4511
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "唔哇！？",
    "voice": "vo_adv_5040000_044",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "危險！",
    "voice": "vo_adv_5040000_045",
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很危險耶～",
    "voice": "vo_adv_5040000_046",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你們怎麼突然發動攻擊啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "被閃開了……？",
    "voice": "vo_adv_5040000_047",
    "unit_id": 4511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我沒事啦，",
    "voice": "vo_adv_5040000_048",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "小栞妳把弓收起來吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是……！",
    "voice": "vo_adv_5040000_049",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴說得對。",
    "voice": "vo_adv_5040000_050",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n要是栞栞妳受傷的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那才真的會讓我無法承受。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "…………我知道了。",
    "voice": "vo_adv_5040000_051",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個，",
    "voice": "vo_adv_5040000_052",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你們幾個。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為什麼突然要帶走我們的牛呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "請你們說明原因好嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這是扣押。",
    "voice": "vo_adv_5040000_053",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……………………扣押？",
    "voice": "vo_adv_5040000_054",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "扣押……",
    "voice": "vo_adv_5040000_055",
    "unit_id": 103811
  },
