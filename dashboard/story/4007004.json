[
  {
    "type": "background",
    "bg_id": "500640"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在地上等候貪吃佩可等人歸來的{0}和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可可蘿親眼看到鋪天蓋地的圓盤同時撤退離開了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n神奇的是，這和凱留她們攻擊母船正好是同一時間發生。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "圓盤",
    "voice": "vo_adv_4007004_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "同時撤退了……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到底是怎麼回事……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊！？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人！　",
    "voice": "vo_adv_4007004_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "空中有什麼東西降下來了！！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是巨大的",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "莉瑪小姐？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到宇宙去冒險",
    "voice": "vo_adv_4007004_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓莉瑪小姐大幅成長了吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是心理作用嗎，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她在閃閃發光呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "機械莉瑪",
    "words": "莉瑪莉瑪莉瑪——！！",
    "voice": "vo_adv_4007004_003",
    "unit_id": 13011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "莉瑪小姐……",
    "voice": "vo_adv_4007004_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該不是吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那會不會是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "母船啊。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "戰鬥機又在哪裡……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿！　{0}！",
    "voice": "vo_adv_4007004_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n平安救出小凱留了哦！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是貪吃佩可小姐的戰鬥機！　",
    "voice": "vo_adv_4007004_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "平安無事真是太好了！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "510270"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們一鼓作氣把母船擊落了！",
    "voice": "vo_adv_4007004_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只不過也用盡彈藥啦！　",
    "voice": "vo_adv_4007004_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "接下來只能在地上戰鬥了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在就降落到那邊去，",
    "voice": "vo_adv_4007004_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請稍等一下——！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500640"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哎……",
    "voice": "vo_adv_4007004_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "終於回來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，",
    "voice": "vo_adv_4007004_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您全身黏糊糊呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到底發生了什麼事啊……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那艘母船的目的，",
    "voice": "vo_adv_4007004_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是把蘭德索爾境內的食物都變成蘋果，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n當成征服世界時所需要的運作能源。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把它徹底破壞掉的話，",
    "voice": "vo_adv_4007004_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像就能全部解決了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們趕快消滅它吧！！　",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一點渣都不能留",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_4007004_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來不想說出發生什麼事啊……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也就不要詳細追問好了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯……",
    "voice": "vo_adv_4007004_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就別問了吧……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就算妳說",
    "voice": "vo_adv_4007004_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要消滅它，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "光靠我們的話是有困難的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "戰鬥機也不能用了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "各位，",
    "voice": "vo_adv_4007004_017",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "聽得到嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我是公會管理協會的花凜！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "花凜小姐，",
    "voice": "vo_adv_4007004_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來的正好。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就在剛剛",
    "voice": "vo_adv_4007004_019",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "確認了有像是母船的巨大物體降落了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "已經向各地的公會提出救援請求了，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我想應該很快就會抵達。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是可靠呢！",
    "voice": "vo_adv_4007004_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n大家一起同心協力地",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "拯救蘭德索爾吧！",
    "voice": null,
    "unit_id": 105812
  }
]
