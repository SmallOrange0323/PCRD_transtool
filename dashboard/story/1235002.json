    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "真是謝謝妳啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "這是你們的限定版遊戲。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n你們剛好買到最後一組，",
