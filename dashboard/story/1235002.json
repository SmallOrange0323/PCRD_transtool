    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "雖然我已經請了比去年更多的人手來幫忙了，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n但畢竟攤位能容納的空間大小還是有限的呢──",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不用這麼在意啦。",
