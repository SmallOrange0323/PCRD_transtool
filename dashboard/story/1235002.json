    "type": "dialogue",
    "name": "鈴",
    "words": "當然了！",
    "voice": "vo_adv_1235002_034",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n居然搶走了",
