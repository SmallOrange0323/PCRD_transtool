  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "你們",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "很期待玩我們做的遊戲對吧？",
