    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不是，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你誇我，我是很高興啦，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可是我現在想要的反應不是那種的。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你看你看，",
    "voice": "vo_adv_1235002_073",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我好恨吶～♪",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……行不通啊，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "笑得超燦爛的。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我反倒也有點",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "高興起來了。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "哈哈哈！",
    "voice": "vo_adv_1235002_074",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n看來小姑娘扮的鬼太惹人憐愛了啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "就是說啊。",
    "voice": "vo_adv_1235002_075",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "要是我的女朋友",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "也願意做類似的打扮就好了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "background",
    "bg_id": "501872"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1235002_076",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我在",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚇人這方面",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒有才能。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "身為松鼠，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我會好好地用撒嬌當武器活下去的……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不管怎樣，",
    "voice": "vo_adv_1235002_077",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你也笑得太開心了吧？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我演技不好",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就這麼好笑嗎？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……我雖然遇上麻煩，",
    "voice": "vo_adv_1235002_078",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但看起來很高興真是太好了？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也是啦～",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大概是因為，就像攤主說的一樣，心情舒暢了。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n而且還做了很有萬聖節感覺的事，所以才非常滿足吧～？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "就是說啊。",
    "voice": "vo_adv_1235002_079",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "這下所有問題都解決了！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n大家應該也能",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "繼續享受萬聖節慶典了呢。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "謝謝你們，",
    "voice": "vo_adv_1235002_080",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真的幫了我很多。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我想跟這傢伙",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "一起玩剛剛奪回來的遊戲，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n破關之後，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我一定會寄感想給你的～",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "哈哈哈，",
    "voice": "vo_adv_1235002_081",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "那可真令人高興啊！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "\\n這作難度提升蠻多的，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "加油破關喔！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呵呵～",
    "voice": "vo_adv_1235002_082",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "正合我意～",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們兩個一定要一起破關，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你要鼓起幹勁喔。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就算遇到了麻煩，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但鈴還是拿到了想要的遊戲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鈴跟{0}在盡情享受蘭祭後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n踏上了回家的路。",
    "voice": null,
    "unit_id": null
  }
