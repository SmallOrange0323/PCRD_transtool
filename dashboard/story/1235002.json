    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不然",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我也不會去排那麼長的隊。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "攤主",
    "words": "我們也是為了能夠讓像妳這樣的人玩我們的遊戲，",
