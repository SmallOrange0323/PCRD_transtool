  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對我來說，光是每隔一段時間，",
