  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在一同拯救城鎮的危機時，碧跟{0}加深了彼此的友誼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}想趁這個氣勢結交更多的朋友，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是前往碧所居住的精靈之森。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "HEY YO！",
    "voice": "vo_adv_1040009_000",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的前途！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一片光彩！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n新朋友來！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自然很嗨！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這一切好事緣由！",
    "voice": "vo_adv_1040009_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n都是因為跟你成了朋友YO！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "HEY YO ",
    "voice": "vo_adv_1040009_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "WOW ",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "WO～W♪",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們是死黨，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "話匣子闔不上，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "WOW ",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "WOW ",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "YEAH～♪",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀啊啊啊～！？",
    "voice": "vo_adv_1040009_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n{0}！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原、",
    "voice": "vo_adv_1040009_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來你在啊！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒注意到……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其實是",
    "voice": "vo_adv_1040009_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自從之前一起創作主題曲以後，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我就愛上了Rap……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能跟團長當朋友，",
    "voice": "vo_adv_1040009_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我很開心……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那股心情化為熱情噴發而出，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n讓我創造出新作品，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以我不由得就哼起來了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "歌名我也想好了！",
    "voice": "vo_adv_1040009_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我把它取名為",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「新‧BB團朋友讚譽曲」……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個「新」",
    "voice": "vo_adv_1040009_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不只是指「新歌」的意思，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也是指結交朋友後，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "進入「新的」禁忌領域的意思，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n是個有一種說不出的可愛感，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我非常滿意的命名！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……呃，",
    "voice": "vo_adv_1040009_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就我一個人講個不停。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能跟朋友說話真的太開心了，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我才會不由得興奮過了頭……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………\\n……………………\\n………………………………",
    "voice": "vo_adv_1040009_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………欸嘿嘿。",
    "voice": "vo_adv_1040009_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒事，",
    "voice": "vo_adv_1040009_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我只是實際感受",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我跟你真的成了朋友，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以再次感到很開心。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為，",
    "voice": "vo_adv_1040009_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "平常像剛才那樣突然沒話可說時，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我都會急到亂說話不是嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是，",
    "voice": "vo_adv_1040009_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對象是你的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "似乎也能接受那樣的我，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以我就能",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "放心思考接著要說什麼才好。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種事",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很有朋友的感覺……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1040009_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "難得成為朋友，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n要不要來做點朋友才會做的事！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃……",
    "voice": "vo_adv_1040009_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想想…………",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "翻花繩……",
    "voice": "vo_adv_1040009_017",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "平時就在玩了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "接龍……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是不錯……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但更有朋友感覺的會更好對吧……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": "vo_adv_1040009_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "明明是我自己開口的，\\n卻還說這種話是也很怪……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過朋友都會做些什麼樣的事啊……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "朋友會一起做的事……",
    "voice": "vo_adv_1040009_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1040009_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "國王遊戲！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想玩國王遊戲！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那是朋友會聚集在一起",
    "voice": "vo_adv_1040009_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嬉鬧遊玩的經典遊戲──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我不知道在哪聽過這種說法！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其實……",
    "voice": "vo_adv_1040009_022",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我以前曾經想要自己玩，但卻失敗了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "既然已經結交到{0}這個朋友，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n現在肯定玩得起來！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那我們馬上開始吧！",
    "voice": "vo_adv_1040009_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我早料到會有這種情況，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以事先準備了籤！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "來吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請看過來！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼說來……",
    "voice": "vo_adv_1040009_024",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就規則來說，或許是那樣沒錯……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現在的我們",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "應該是勉強玩得起來！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "快",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "來試看看吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": "vo_adv_1040009_025",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請選擇其中一邊吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你要選右邊嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還是選左邊呢……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "喔喔！",
    "voice": "vo_adv_1040009_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你要選右邊對吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
