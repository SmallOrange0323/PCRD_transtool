[
  {
    "type": "background",
    "bg_id": "500016"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふう、",
    "voice": "vo_adv_5114411_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そろそろ客足も落ち着いてきたな。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n私たちも",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "すこし休憩にするか。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "甘味が恋しくて仕方がない……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そんなモニカのために……",
    "voice": "vo_adv_5114411_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "じゃじゃーん！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n特製カラメルたい焼きと、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n激甘ミルクティーのセットを用意しといたにゃ！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お代わりもいっぱいあるからにゃ。",
    "voice": "vo_adv_5114411_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "好きなだけ食べるといいにゃ。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむむ……",
    "voice": "vo_adv_5114411_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "営業時間中だというのに",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ものすごい誘惑だ……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "今はお客さんもいないし、",
    "voice": "vo_adv_5114411_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "賄いを食べたって問題ないにゃ♪",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "それに、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "こういう誘惑には、素直に従っておくものにゃ。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n何しろ",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "このお店の名前は……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "つまみ食いする猫！　",
    "voice": "vo_adv_5114411_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "だものな……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "確かに",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "タマキの言う通り。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ありがたくいただこう。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "──っと、",
    "voice": "vo_adv_5114411_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お客さんが来たみたいだにゃ。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "いらっしゃいませにゃ～！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あっと、",
    "voice": "vo_adv_5114411_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いかんいかん。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "私も店に出なければ。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "このたい焼きは後ほどいただくとしよう。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "──ようこそ！　",
    "voice": "vo_adv_5114411_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "猫と駄菓子の店、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "『ナッシュカッツェ』へ！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n心ゆくまで",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "くつろいでいってくれ！",
    "voice": null,
    "unit_id": 105311
  }
]
