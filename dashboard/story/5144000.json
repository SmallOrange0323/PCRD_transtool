  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不是！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我來的原因和鏡華一樣！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "並沒有",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "什麼深意啊、",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "任務啊，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全沒有那種事！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "綾音＆噗吉",
    "words": "絕對是有什麼原因嘛。\\n「絕對是有什麼原因吧。」",
    "voice": "vo_adv_5144000_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好啦好啦。",
    "voice": "vo_adv_5144000_048",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n來幫忙的人增加了也是件好事♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就是說啊。",
    "voice": "vo_adv_5144000_049",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n尤其有像鈴莓小姐這樣，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "比我們年長的人在就讓人很安心。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "工作碰上困難的時候，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我可以找妳商量嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "當、",
    "voice": "vo_adv_5144000_050",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "當然好囉～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能聽妳這樣說，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓我有點害羞呢～♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你",
    "voice": "vo_adv_5144000_051",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "時不時就會做出可疑的舉動……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "倒不如",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "由我來好好看著你！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓也是，",
    "voice": "vo_adv_5144000_052",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "與其說是可疑，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不如說是",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n常常做出讓人心驚膽跳的事呢。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓就由我來看著，放心吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「趕緊把真相告訴他們比較好吧？",
