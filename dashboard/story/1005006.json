[
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哦哦！",
    "voice": "vo_adv_1005006_000",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你看你看，{0}！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們終於到達牧場了～☆",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "暫時放心了！",
    "voice": "vo_adv_1005006_001",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "比想像中要遠得多！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n明明一大早就從城裡出發了，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在太陽都快西沉了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "耶嘿嘿。",
    "voice": "vo_adv_1005006_002",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "畢竟途中下了大雨，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n讓我們沒辦法再繼續往前走了呢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然說比返回城裡還要近，",
    "voice": "vo_adv_1005006_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n但走山路還是走得很辛苦。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "途中還後悔了好幾次。",
    "voice": "vo_adv_1005006_004",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這山路遠比我所想像的，要來的險峻。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在走這條因為大雨而變得濕滑的山路時，",
    "voice": "vo_adv_1005006_005",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n為了要注意不要滑倒，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以都慢慢地走……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "估計因此，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "花了不少多餘的時間。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看起來，",
    "voice": "vo_adv_1005006_006",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要在太陽完全西沉前下山似乎是沒辦法了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n只能拜託牧場的人，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "讓我們借住一晚了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要是在深夜裡走山路的話，",
    "voice": "vo_adv_1005006_007",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n可是會遇難的。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "得用傳信鴿",
    "voice": "vo_adv_1005006_008",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "或通訊魔法，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n聯絡家裡說",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「今天不能回去了」才行。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不然爸爸和媽媽，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會擔心的。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為不管怎麼說，",
    "voice": "vo_adv_1005006_009",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我都想完成任務，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n而且也得見見牧場的人才行。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我看看，",
    "voice": "vo_adv_1005006_010",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "牧場的人會在哪裡呢？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會是在對面看見的",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那棟建築物裡嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總而言之先去看看，\\n{0}！",
    "voice": "vo_adv_1005006_011",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "距離終點",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就只差一步了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……嗚嘎！？",
    "voice": "vo_adv_1005006_012",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊好痛……",
    "voice": "vo_adv_1005006_013",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "跌、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "跌倒了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為平安地到達了目的地，",
    "voice": "vo_adv_1005006_014",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就不小心鬆懈下來了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一個大意，",
    "voice": "vo_adv_1005006_015",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就在下過雨後的泥濘地上被絆倒了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一生的失策。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚啊，",
    "voice": "vo_adv_1005006_016",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n一頭栽進水窪裡了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n滿身泥巴。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然說",
    "voice": "vo_adv_1005006_017",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一路走山路上來，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n本來就已經弄髒不少了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可、",
    "voice": "vo_adv_1005006_018",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可不能帶著滿身泥巴的樣子，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n去見牧場的人。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該怎麼辦……",
    "voice": "vo_adv_1005006_019",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n想準備一套換洗衣物，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這裡",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有沒有店家之類的呢？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果有類似伴手禮店之類的店的話，",
    "voice": "vo_adv_1005006_020",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n感覺就至少會有在賣襯衫了……？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？",
    "voice": "vo_adv_1005006_021",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}要拜託",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "牧場的人，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n幫我和他們借換洗衣物過來是嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哎呀那還真是，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感激不盡～？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哦～",
    "voice": "vo_adv_1005006_022",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n剛好有和我差不多身高體型的孩子，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n在這座牧場裡是嗎。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你打算拜託那孩子，",
    "voice": "vo_adv_1005006_023",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n請她借我衣服啊。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "了解，",
    "voice": "vo_adv_1005006_024",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "幫了大忙。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "等你的期間，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我先用那邊的自來水把泥巴沖掉。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚嗚……",
    "voice": "vo_adv_1005006_025",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我一直",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在麻煩{0}照顧我。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果只有我一個人，",
    "voice": "vo_adv_1005006_026",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n絕對在某個地方就讓任務失敗了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我",
    "voice": "vo_adv_1005006_027",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還真是一無是處呢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n如果只是一直受人幫助的話，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就沒資格當英雄了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊……\\n{0}，\\n已經回來了。",
    "voice": "vo_adv_1005006_028",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}～？\\n回來得還真早呢。",
    "voice": "vo_adv_1005006_029",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你已經找到替換的衣服了是嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真厲害，",
    "voice": "vo_adv_1005006_030",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "果然{0}是個很能幹的人～♪",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……嗯嗯？",
    "voice": "vo_adv_1005006_031",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那個，{0}？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你手裡拿著的那個，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是換洗衣物嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎、",
    "voice": "vo_adv_1005006_032",
    "unit_id": 100511
