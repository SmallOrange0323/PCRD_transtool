    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "女の子として見てもらえたら",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\nうれしいかな～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "なんて……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "流石に高望みしすぎなのかな……",
