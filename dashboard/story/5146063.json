[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ペコリーヌはクリスマスイベントの準備が進む",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nランドソルの街を一人、散策していた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ふふ、",
    "voice": "vo_adv_5132063_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クリスマスの準備、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "着々と進んでますね。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんは心配そうでしたけど……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "この調子なら、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "当日も成功間違いなしですね♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今からもうワクワクしちゃいます☆",
    "voice": "vo_adv_5132063_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "くっ",
    "voice": "vo_adv_5132063_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "くっ",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "く……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "無邪気にクリスマスを楽しみにするなど",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\nおめでたいものだな、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "白き王女よ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "どちらさまですか？",
    "voice": "vo_adv_5132063_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "歓喜に沸く冬の祝祭、",
    "voice": "vo_adv_5132063_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "クリスマス。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "その煌めきの裏に蠢く闇があるということを",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nまだ知らぬと見える──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わあ、",
    "voice": "vo_adv_5132063_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "アンナちゃん！　",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "お久しぶりですね！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "う、",
    "voice": "vo_adv_5132063_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "うむ、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そうだな……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "息災のようでなによりだ。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ところで今、",
    "voice": "vo_adv_5132063_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クリスマスの闇がどうとかって言ってましたけど、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nそれって本当ですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "フッ、",
    "voice": "vo_adv_5132063_008",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "無論だ。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "この世界には人知の及ばぬ",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n恐ろしきものどもが",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "数多存在する。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "奴らは常に我々を監視し、",
    "voice": "vo_adv_5132063_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "隙あらば魔の手を伸ばさんとしている。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "それは",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "クリスマスとて例外ではない。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "いや、",
    "voice": "vo_adv_5132063_010",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "人々が歓楽に浮かれ心に隙が生まれる時こそ、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n奴らが狙いし絶好の機となるだろう。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "人心の闇に付け入り",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "悪逆の道へいざなわんとするのだ。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そんな……",
    "voice": "vo_adv_5132063_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ア",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ンナちゃんの話が本当なら、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "この国の王女として",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n見過ごすわけにはいきません。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n人々を守るために、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そのお話",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ぜひ聞かせてください！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "聡明なる王女よ。",
    "voice": "vo_adv_5132063_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ならば教えてやろう！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "クリスマスに顕現せし",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "恐怖の魔女、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ベファーナの伝承を！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魔女、",
    "voice": "vo_adv_5132063_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ベファーナ……？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ベファーナは",
    "voice": "vo_adv_5132063_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "善良な子供にはプレゼントを、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n悪い子には炭を贈ると伝えられている。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "炭……",
    "voice": "vo_adv_5132063_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それは、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "どうしてですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "疑問に思うのも当然だ。",
    "voice": "vo_adv_5132063_016",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "子供への戒めなら",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nもっと分かりやすくイヤなものを贈ればいい。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "悪童なら炭を渡されたとて",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "悪戯に使うこともあろう。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "黒き魔女の目的は何か……",
    "voice": "vo_adv_5132063_017",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "長きにわたり",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "謎とされていた。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私は一つの結論に辿り着いたのだ。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "これは──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "素質ある子供に対する、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "闇への誘いの証なのだ！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "炭の色──",
    "voice": "vo_adv_5132063_018",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "すなわち黒、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "これは端的に",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "闇を意味するのであろう。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n闇色の贈り物をすることで、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "子供を闇に染め、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n自らの眷属とする……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そのための",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "行動なのではないかと。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "な、",
    "voice": "vo_adv_5132063_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "言われてみればその通りです！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "さらに",
    "voice": "vo_adv_5132063_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "この伝承とよく似たブラックサンタと呼ばれる",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n黒衣の男の存在も確認されている。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "奴らはクリスマスという光の宴の裏で、",
    "voice": "vo_adv_5132063_021",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n宵闇の中に、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "蝋燭の暖かな光の作り出すわずかな影に潜んで",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nその魔の手を伸ばし続けているのだ！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_5132063_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そう、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "だったんですね。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしの知らないところで",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そんな恐ろしいことが……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "知らぬのも無理はないな。",
