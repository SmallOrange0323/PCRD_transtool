    "voice": "vo_adv_5036005_023",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不會動……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n而且盆栽小花也",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "很小……？",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……島村村？",
    "voice": "vo_adv_5036005_024",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊！",
    "voice": "vo_adv_5036005_025",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我好像",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "做了一個很奇怪的夢……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……夢？",
    "voice": "vo_adv_5036005_026",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好像是在",
    "voice": "vo_adv_5036005_027",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有點奇幻的世界。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我們一起冒險，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "一起吃飯，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好像還一起開了演唱會的夢……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦咦！？",
    "voice": "vo_adv_5036005_028",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n島村村也是嗎～！？",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳們兩個也是……？",
    "voice": "vo_adv_5036005_029",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "LIVE工作人員",
    "words": "【new generations】的各位～",
    "voice": "vo_adv_5036005_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "LIVE工作人員",
    "words": "\\n差不多要請妳們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "LIVE工作人員",
    "words": "開始準備囉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5036005_031",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對了！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我們等一下，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "還有演唱會呀～！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……真是的。",
    "voice": "vo_adv_5036005_032",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n竟然會在這種時間點睡著了……",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "早知道不該",
    "voice": "vo_adv_5036005_033",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "為了轉換心情",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "而試玩遊戲樣品了～！",
