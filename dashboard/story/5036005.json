    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不過……",
    "voice": "vo_adv_5036005_037",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然很奇怪，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是一個很不可思議的夢呢。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯……",
    "voice": "vo_adv_5036005_038",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對啊。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "第一次站在觀眾前面的時候，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那種心跳加快的心情……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "還有大家一起在錯誤中學習的",
    "voice": "vo_adv_5036005_039",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "樂趣之類的……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……還有就是，",
    "voice": "vo_adv_5036005_040",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "回歸初衷的感覺吧。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n感覺好像回想起",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "當時的心情了呢。",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯♪",
    "voice": "vo_adv_5036005_041",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……不過明明特地替我們做了首好曲子，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "卻只是場夢有點遺憾呢……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……咦？",
    "voice": "vo_adv_5036005_042",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n妳、",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "妳們兩個快看！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n今天的表演曲目中追加的",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這首歌不就是……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦！？",
    "voice": "vo_adv_5036005_043",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n這首歌，",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "該不會……！",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這不是我們在夢中",
    "voice": "vo_adv_5036005_044",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n那場甄選裡贏得冠軍後得到的……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那首曲子嗎！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "可是，",
    "voice": "vo_adv_5036005_045",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "為什麼那首歌會在這……？",
    "voice": null,
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我還以為，",
    "voice": "vo_adv_5036005_046",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那就只是一場夢而已……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "看來，",
    "voice": "vo_adv_5036005_047",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "美夢不會僅止於夢中呢♪",
    "voice": null,
    "unit_id": 112431
  },
