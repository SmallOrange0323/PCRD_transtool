  },
  {
    "type": "still",
    "still_id": "503600501"
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "啊！",
    "voice": "vo_adv_5036005_020",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦？",
    "voice": "vo_adv_5036005_021",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n……這裡是……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "休息室？",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……衣服，",
    "voice": "vo_adv_5036005_022",
    "unit_id": 112531
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "變成制服了……",
    "voice": null,
    "unit_id": 112531
  },
  {
