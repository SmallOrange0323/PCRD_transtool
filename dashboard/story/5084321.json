[
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原本以為只是平時的魔物討伐工作，",
    "voice": "vo_adv_5084321_000",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但情況似乎",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "開始變得有些不太對勁呢……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "魔物成群聚集在一起……",
    "voice": "vo_adv_5084321_001",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "其中每隻看起來都相當強悍。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個該死的眼鏡女！",
    "voice": "vo_adv_5084321_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n她到底在打什麼算盤，竟然要我們處理這麼棘手的討伐委託！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n她還真能一臉笑容地使喚我們啊！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是",
    "voice": "vo_adv_5084321_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為花凜小姐",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "信賴在下等人的實力呀。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "既然貪吃佩可小姐和主公大人都不在，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可能需要採取和平時不同的戰鬥策略。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "確實地減少敵人的數量吧。",
    "voice": "vo_adv_5084321_004",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n無論有多少強大的敵人聚集在一起，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n肯定都能找到破綻攻入的。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我晚點絕對",
    "voice": "vo_adv_5084321_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會要那個眼鏡女加碼特殊報酬！",
    "voice": null,
    "unit_id": 106011
  }
]
