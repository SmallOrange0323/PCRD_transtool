  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "啊呣",
    "voice": "vo_adv_4010238_000",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "啊呣……♪",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "真是太好吃了，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "騎士先生……♪",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "感謝您今天",
    "voice": "vo_adv_4010238_001",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "約我出來。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n自從在電視上看到廣告之後，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我就一直對這個",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "「照燒",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "三重牛肉聖母峰",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "～添加三種起司～」",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "很感興趣。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "但因為失去記憶，不太敢外出活動……",
    "voice": "vo_adv_4010238_002",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "再加上我又這麼高大，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n很容易引起他人側目，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "所以不自覺就想要躲在家裡……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我也好幾天",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "沒有呼吸到外面的空氣了……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我記得您說，",
    "voice": "vo_adv_4010238_003",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "接下來要去購物中心對吧？",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我也很期待去那裡。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n只要是跟騎士先生在一起，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "到哪裡我都願意。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "background",
    "bg_id": "510281"
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "呼……",
    "voice": "vo_adv_4010238_004",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "一口氣逛完這麼多間商店，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n讓我都不禁雀躍起來了。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "其中特別吸引我的",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "是珠寶店……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "看著那些漂亮的戒指，",
    "voice": "vo_adv_4010238_005",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我就會開始想像",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n它們戴在自己身上的樣子……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "想必",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我在失去記憶之前，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n也是個喜愛珠寶的人吧。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "這是……",
    "voice": "vo_adv_4010238_006",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "項圈？",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "您為何……？",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "您竟然記得我的生日……",
    "voice": "vo_adv_4010238_007",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "太感謝您了，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "送我項圈……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "感覺好像把我當成您的所有物一樣，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n太棒了。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "那麼，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我這就試戴看看……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "試戴、",
    "voice": "vo_adv_4010238_008",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "看看……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "啊啊、",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "啊啊啊……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "怎麼會這樣……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n我的脖子太粗，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "騎士先生送的項圈",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n戴不上去……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "啊啊……！",
    "voice": "vo_adv_4010238_009",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "手腕的話我就戴得上去了。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n而且這麼一來，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我就可以時時刻刻都看到",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n騎士先生送我的東西。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "太好了……",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我要再次……",
    "voice": "vo_adv_4010238_010",
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "跟您說聲謝謝，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "不論是您送給我的禮物，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "\\n還是",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "您對我的體貼關照，",
    "voice": null,
    "unit_id": 136031
  },
  {
    "type": "dialogue",
    "name": "夜雲",
    "words": "我都會一輩子銘記於心。",
    "voice": null,
    "unit_id": 136031
  }
]
