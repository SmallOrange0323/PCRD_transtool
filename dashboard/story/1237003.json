    "words": "那就再逛一圈會場，",
    "voice": "vo_adv_1237003_059",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不對……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還要逛第二圈第三圈，",
