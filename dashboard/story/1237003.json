  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊～",
    "voice": "vo_adv_1237003_026",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "會不會累？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們休息一下吧？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀～",
    "voice": "vo_adv_1237003_027",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "抱歉啊。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n今天本來",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是要讓你好好玩個過癮的……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但我一看到有人需要幫忙",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就會忍不住想幫",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "的說～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊哈哈……",
    "voice": "vo_adv_1237003_028",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我就在想你應該會這麼說。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你問我是不是也一樣",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個嘛……",
    "voice": "vo_adv_1237003_029",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的動機",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有點更不單純吧～？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要怎麼說呢……",
    "voice": "vo_adv_1237003_030",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n難得來到蘭祭玩，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我不希望他們留下",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "遇到麻煩～或是",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "遇到壞事～的回憶。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也不是說我沒有",
    "voice": "vo_adv_1237003_031",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "想幫助他們的念頭……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要說的話我比較像是想讓他們知道，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「這裡很開心喔～」",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣吧？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "簡單來說就是……",
    "voice": "vo_adv_1237003_032",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我想把他們拉進坑裡啦！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不知道你懂不懂～？",
    "voice": "vo_adv_1237003_033",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n嘿嘿嘿……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "待在坑裡的人數越多會越開心喔～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說是這麼說啦……",
    "voice": "vo_adv_1237003_034",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然我現在",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "除了你",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和杏奈美眉之外，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n也跟鈴閣下、依里閣下",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和智閣下她們",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "玩得很開心……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是之前的七七香",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "其實",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "跟周遭都格格不入呢～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我以前總是想著",
    "voice": "vo_adv_1237003_035",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要鑽研宅宅之道，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "結果身邊的人",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都跟我保持距離。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後發生了很多事，",
    "voice": "vo_adv_1237003_036",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我才開始被叫做收藏家呢～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我當時並不覺得自己很倔強呢……",
    "voice": "vo_adv_1237003_037",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當年的七七香也還很嫩啊。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過，",
    "voice": "vo_adv_1237003_038",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "後來我發現了，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我一個人獨享這麼開心的事情，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不是太可惜了嗎！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且，",
    "voice": "vo_adv_1237003_039",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一個人辦不到的事情，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "跟大家合作就辦得到，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就像蘭祭這個活動一樣。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大家各玩各的，",
    "voice": "vo_adv_1237003_040",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大家全都很開心的話，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不就最棒了嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以啊，",
    "voice": "vo_adv_1237003_041",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我在這裡很開心喔～！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n大家也一起在坑裡越陷越深吧～！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會這樣",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不停地推坑！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且，",
    "voice": "vo_adv_1237003_042",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "其他人",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "平常好像都在各方面壓抑著自己呢……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你看嘛，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "像是智閣下",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不就是這樣嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在遠處看著以前的我的那些人，",
    "voice": "vo_adv_1237003_043",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "會不會也是那樣壓抑自己的呢～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我現在",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不禁會這麼想……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以，",
    "voice": "vo_adv_1237003_044",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我希望至少在這樣的地方，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n他們可以做自己啊～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當大家想要",
    "voice": "vo_adv_1237003_045",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鼓起勇氣的時候，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我想在他們的背後推一把。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦！？",
    "voice": "vo_adv_1237003_046",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "still",
    "still_id": "123700301"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼啦～",
    "voice": "vo_adv_1237003_047",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你這個人",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有時候",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "會跟少年漫畫的主角一樣敏銳耶。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "平常明明就很遲鈍……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當我沒說當我沒說。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "想要有勇氣的時候，",
    "voice": "vo_adv_1237003_048",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然有啊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然我算是很隨心所欲的人，",
    "voice": "vo_adv_1237003_049",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過偶爾",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也是會覺得",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好像做得太超過了。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我偶爾",
    "voice": "vo_adv_1237003_050",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "會想起以前一個人",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "格格不入的時候",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呢……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n現在這樣",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的好嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n大家",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有樂在其中嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會想到這些。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可是，",
    "voice": "vo_adv_1237003_051",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "煩惱這些，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是很不符合",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "七七香的人設嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我還是想要貫徹自我啊，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "作為一個宅宅。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以，",
    "voice": "vo_adv_1237003_052",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "平常在其他人的面前，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我會盡量把這一面隱藏起來。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "畢竟，",
    "voice": "vo_adv_1237003_053",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我其實是很倔強的啊。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "果然還是逃不過你的眼睛……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "假如啊，",
    "voice": "vo_adv_1237003_054",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "七七香",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在宅宅的",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "道路上迷失方向時……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你會",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在背後推我一把嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "still",
    "still_id": "123700302"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "果然～",
    "voice": "vo_adv_1237003_055",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我就知道你會那麼說。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "still",
    "still_id": "123700302"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "辦得到啊，",
    "voice": "vo_adv_1237003_056",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n因為你已經推我一把了……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說說的啦！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1237003_057",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我得到你的承諾囉！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n已經不能反悔了喔～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好～！",
    "voice": "vo_adv_1237003_058",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "休息一下就有精神了～！",
