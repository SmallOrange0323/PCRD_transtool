  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一直以來都是我受到你的幫助嘛。",
