[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然說是對料理拿手，",
    "voice": "vo_adv_6054207_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但我其實也做不出太精緻的料理就是了……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過呢，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在味道方面我可是很有自信的喔。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊，",
    "voice": "vo_adv_6054207_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "的確是。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……那、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之後",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我打算在育幼院",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "做點什麼料理。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "到時會做我最拿手的菜，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你有空的話也來品嚐看看吧。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_6054207_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不如我們倆一起挑戰看看吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼事情就這麼說定，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之後別忘了騰出時間來。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……一言為定喔？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……哎唷，",
    "voice": "vo_adv_6054207_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你這人實在是，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真不知道該說你天真，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還是該說你狡猾。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是坦白講，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還是這樣的讚美",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "最讓人開心了。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……謝謝你。",
    "voice": null,
    "unit_id": 114511
  }
]
