  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天是假日，沒有社團活動。\\n然而美里卻一個人默默處理著社團的雜事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呼，",
    "voice": "vo_adv_1135001_000",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "洗完衣服了",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n今天天氣很好，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "衣服應該很快就能乾了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": "vo_adv_1135001_001",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "早安。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天沒有社團活動喔。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我在幫大家",
    "voice": "vo_adv_1135001_002",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "洗衣服喔。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n想說可以趁現在",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "做點事。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_1135001_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你問我",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天不是放假嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說得也是呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "明明是難得的休假日……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那個……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我說了你可不要笑我喔？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為我",
    "voice": "vo_adv_1135001_004",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直住在精靈之森，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以那個……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我對大海",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不太了解，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不曉得該怎麼過。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "明明作為老師，",
    "voice": "vo_adv_1135001_005",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我應該要能教導他們",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n如何享受",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大海的美好才對……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你要",
    "voice": "vo_adv_1135001_006",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "教我嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "關於享受大海的方法……？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯……",
    "voice": "vo_adv_1135001_007",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真開心。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我就恭敬不如從命吧♪",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_1135001_008",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天一天",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就請多多指教囉♪",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "明明還是早上，",
    "voice": "vo_adv_1135001_009",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就已經",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "聚集了這麼多人，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而且大家看起來都好開心♪",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這裡所有的一切都和精靈之森不同，非常新鮮。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我已經好久沒有",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這麼興奮了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "問你喔，",
    "voice": "vo_adv_1135001_010",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "到了海邊",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "應該要做什麼？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1135001_011",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "無論做什麼",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都該先填飽肚子。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好期待",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "海邊的食物喔。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "炒麵、",
    "voice": "vo_adv_1135001_012",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "烤香腸、",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "烤花枝和刨冰。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "每一樣看起來都好好吃♪",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在戶外站著吃東西",
    "voice": "vo_adv_1135001_013",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "總覺得不太禮貌，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但也讓人有點小激動，食物都變得更美味了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過──",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "呦──！",
    "voice": "vo_adv_1135001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "海邊的食物",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "真是有夠好吃──！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n我全吃光啦──！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那下一攤",
    "voice": "vo_adv_1135001_015",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "就吃那個吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "大海萬歲──！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "仔細一看，",
    "voice": "vo_adv_1135001_016",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沙灘上堆滿了垃圾呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n明明大海這麼漂亮……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對不起喔。",
    "voice": "vo_adv_1135001_017",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我呀，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "去稍微撿一下垃圾。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "海邊還是要乾乾淨淨的才好。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你。",
    "voice": "vo_adv_1135001_018",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你能變成這麼值得信賴的孩子，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師我真開心。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_1135001_019",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們分頭撿吧。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呼，",
    "voice": "vo_adv_1135001_020",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "少了垃圾，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "整個沙灘都變得不一樣了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "果然沙灘變乾淨之後，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "心情也",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跟著好起來了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "欸～欸～大姐姐你們",
    "voice": "vo_adv_1135001_021",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "在做什麼？",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n也讓我們加入嘛。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_1135001_022",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我們在撿垃圾喔？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對你們來說",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "或許會很無聊……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "可以呀──！",
    "voice": "vo_adv_1135001_023",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我也想讓海邊變乾淨！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們要一起幫忙撿垃圾～！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀呀，",
    "voice": "vo_adv_1135001_024",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家真是好孩子～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那我們就",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一起來撿垃圾。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n和哥哥姐姐一起，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "把這裡變得",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "更～",
    "voice": null,
    "unit_id": 113511
  },
  {
