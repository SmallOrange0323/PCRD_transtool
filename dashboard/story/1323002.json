  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}做完送貨的打工之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看到了盯著佈告欄的露易絲瑪莉。",
