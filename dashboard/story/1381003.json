    "words": "呵呵……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "明明見面之前充滿了不安，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "卻滿腦子想著要再去見她……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還真是現實呢。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……不只是為了烏爾姆和琳德，",
    "voice": "vo_adv_1381003_079",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有這個國家的所有人……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n以及你，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我接下來也會繼續製作",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能讓大家露出笑容的點心。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為我，",
    "voice": "vo_adv_1381003_080",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n最喜歡看到",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "人們吃了我做的點心後，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "露出笑容了♪",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這麼說著的萊拉耶爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n臉上的表情就如同烏雲散去的天空一般開朗。",
    "voice": null,
    "unit_id": null
  }
