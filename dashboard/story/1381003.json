[
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成功舉行進獻儀式數日後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n原本心情愉快的萊拉耶爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n此刻或許是因為在思考著什麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "臉上彷彿籠罩著烏雲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1381003_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "食物",
    "voice": "vo_adv_1381003_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能讓人幸福……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這句話的意思，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我現在",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "更能夠深刻感受到了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "已經讓我的國民及騎士，",
    "voice": "vo_adv_1381003_002",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都品嚐過我做的點心了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但是……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……烏爾姆。",
    "voice": "vo_adv_1381003_003",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我還沒",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓妳品嚐過……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不久前",
    "voice": "vo_adv_1381003_004",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆才終於恢復意識……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n雖說有琳德在照顧，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但離康復",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還很遙遠……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然希望可以讓妳品嚐我做的點心……",
    "voice": "vo_adv_1381003_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n可是烏爾姆",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "會願意吃嗎……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆之所以做出那樣失控的行為，",
    "voice": "vo_adv_1381003_006",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n說到底，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是因為我……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣的我做的點心，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也不知道她是否會接受……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊，",
    "voice": "vo_adv_1381003_007",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381003_008",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你看得出來嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "竟然在表情和態度上流露出來，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "果然我",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還不夠成熟呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士……",
    "voice": "vo_adv_1381003_009",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你願意聽我說嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "其實──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──事情就是這樣，",
    "voice": "vo_adv_1381003_010",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然我想要做點心給烏爾姆……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但不知道她會不會收下，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "想做點心給她的想法，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n感覺也只是我一廂情願……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯……",
    "voice": "vo_adv_1381003_011",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "錯，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n在這邊什麼都不做，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "才更加一廂情願呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼首先",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就開始行動吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "謝謝你，",
    "voice": "vo_adv_1381003_012",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就麻煩你了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n為了烏爾姆，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請助我一臂之力。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們現在",
    "voice": "vo_adv_1381003_013",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要去採集特別的蜂蜜，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那個蜂蜜，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在吉歐‧提格尼亞採集得到的蜂蜜中，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可是數一數二的，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n烏爾姆也很喜歡。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要是城裡有的話，",
    "voice": "vo_adv_1381003_014",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "大家",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都會爭相使用，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n所以才刻意不放在城裡，就是好吃到這種程度。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我也是，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "總是一不小心就用太多了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……咳咳。",
    "voice": "vo_adv_1381003_015",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所以呢，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我打算要用那個蜂蜜",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來製作點心。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼……",
    "voice": "vo_adv_1381003_016",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "差不多",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要到可以採集蜂蜜的地方──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請等一下，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "魔蜂群",
    "words": "嗡……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那是……",
    "voice": "vo_adv_1381003_017",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "魔蜂……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n是獄蜂手下的魔物呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒想到還留在吉歐‧提格尼亞……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是大意了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒錯。",
    "voice": "vo_adv_1381003_018",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n數量非常多，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "先觀察一下情況──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n小心……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "魔蜂群",
    "words": "嗡……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看來在不知不覺間",
    "voice": "vo_adv_1381003_019",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "被繞到背後了呢……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n應該在我們注意到之前，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n就先發現我們了吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然現在",
    "voice": "vo_adv_1381003_020",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "應該已經不受獄蜂支配了，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但從剛才的攻擊性來看，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "似乎一樣凶暴。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n更重要的是，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "數量相當龐大。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣下去，",
    "voice": "vo_adv_1381003_021",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "寡不敵眾……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就用更強大的力量來對付。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這裡就交給我吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「至高的彩虹塔」──",
    "voice": "vo_adv_1381003_022",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我開動了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然不被獄蜂操控的魔蜂，",
    "voice": "vo_adv_1381003_023",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "與我無冤無仇。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但是，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要是有會突然襲擊人的魔物",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "存在於吉歐‧提格尼亞，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n有一天可能會對國民造成傷害。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我絕對不接受",
    "voice": "vo_adv_1381003_024",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那樣的事情發生。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並且，",
    "voice": "vo_adv_1381003_025",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "如果是想要阻止我們",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "採集正在尋找的蜂蜜，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那麼就只能",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "將你們排除了。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……我，",
    "voice": "vo_adv_1381003_026",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還想握住烏爾姆的手。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n雖然烏爾姆",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "傷害了他人，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但我想原諒她。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "然後讓她恢復活力，",
    "voice": "vo_adv_1381003_027",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "再次回到我的身旁。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那才是",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "理想的和諧──",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n是這個國家的驕傲，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也是我的願望。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即使身分有別，",
    "voice": "vo_adv_1381003_028",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "種族相異……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即使這個世界",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並非真實世界。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就算這樣",
    "voice": "vo_adv_1381003_029",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我也愛著吉歐‧提格尼亞，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n愛著",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吉歐‧提格尼亞的國民！",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我不允許",
    "voice": "vo_adv_1381003_030",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "再有人來妨礙我們。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……永別了，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "被獄蜂操控的魔物們。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請安息吧。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好了，",
    "voice": "vo_adv_1381003_031",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "既然都平安回來了，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n就開始製作吧。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "牛奶、",
    "voice": "vo_adv_1381003_032",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雞蛋、",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "焦糖，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以及蜂蜜……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "準備就緒。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n麻煩你預熱烤箱了，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵，",
    "voice": "vo_adv_1381003_033",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很好的回答。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n為了烏爾姆，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們要做出最棒的一道點心。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我看看……",
    "voice": "vo_adv_1381003_034",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "顏色、",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "形狀，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "冷卻程度也沒問題。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "完成了，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n非常感謝",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你的幫助。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是的……",
    "voice": "vo_adv_1381003_035",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只剩下拿給她，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓她品嚐",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而已……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381003_036",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我果然",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是很不安……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要是她",
    "voice": "vo_adv_1381003_037",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不想吃我做的點心……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要是被拒絕的話",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "該怎麼辦？",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……我總是忍不住",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "想到這些事。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……好的。",
    "voice": "vo_adv_1381003_038",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只是一直覺得不安，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就無法向前邁進呢。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……！",
    "voice": "vo_adv_1381003_039",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381003_040",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們去見烏爾姆吧。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "background",
    "bg_id": "501730"
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "…………",
    "voice": "vo_adv_1381003_041",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……琳德，",
    "voice": "vo_adv_1381003_042",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "萊拉耶爾殿下！",
    "voice": "vo_adv_1381003_043",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n您來探望烏爾姆嗎？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯。",
    "voice": "vo_adv_1381003_044",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……烏爾姆，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我可以進去嗎？",
    "voice": null,
