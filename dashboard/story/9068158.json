[
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──哎呀，",
    "voice": "vo_adv_9068158_000",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "挨了很棒的一招耶。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "葡萄酒的瓶子都破了，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個人",
    "voice": "vo_adv_9068158_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然非常地強！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等！",
    "voice": "vo_adv_9068158_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n跟先前在吉歐‧提格尼亞戰鬥時相比，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n怎麼好像當時的妳還比較認真……！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我並沒有",
    "voice": "vo_adv_9068158_003",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "手下留情之類的喔。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "剛才也說過了吧？",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我今天",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是來跟你們商量的。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那麼……",
    "voice": "vo_adv_9068158_004",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n妳真的是",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "想把哥哥當成弟弟……？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "沒錯。",
    "voice": "vo_adv_9068158_005",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n是要我講幾遍啦……",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗝。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "我們。",
    "voice": "vo_adv_9068158_006",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n拒絕。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "普蕾西亞小姐？",
    "voice": "vo_adv_9068158_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "因為。",
    "voice": "vo_adv_9068158_008",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n姐姐。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n夠多了。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……啥？",
    "voice": "vo_adv_9068158_009",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那位小豬女孩",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是在說什麼啊。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呃……",
    "voice": "vo_adv_9068158_010",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞「拒絕」的理由，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n是因為一旦變成哥哥的姐姐，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對身為哥哥的妹妹的",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞來說，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n倭小姐就變成姐姐了……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9068158_011",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n謝了，不必。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一下姐姐一下哥哥，",
    "voice": "vo_adv_9068158_012",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n詞彙交錯到好像有些混亂了……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n而且我也是，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "並不需要姐姐大人……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "什麼啊。",
    "voice": "vo_adv_9068158_013",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不必跟我客氣喔。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不管妹妹有兩人三人還是十人，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "都沒什麼差別啦……",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……？",
    "voice": "vo_adv_9068158_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n從剛才起，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺對話好像不太有交集。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道說，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "倭小姐……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊～～！",
    "voice": "vo_adv_9068158_015",
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是……！",
    "voice": "vo_adv_9068158_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "蠻賊貪鯊號……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呦，若菜。",
    "voice": "vo_adv_9068158_017",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳也是來喝一杯的嗎？",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "才不是！",
    "voice": "vo_adv_9068158_018",
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊妳居然醉成這樣……",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n就算再喜歡吉歐‧格黑納的香露",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n跟八鹽折，",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也喝得太多了啦……",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_9068158_019",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她果然是喝醉了呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然臉上完全看不出醉樣，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "身手也跟先前一樣，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一點異樣都沒有就是了……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喂，若菜，",
    "voice": "vo_adv_9068158_020",
    "unit_id": 130011
  },
