    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "審判狼蛛",
    "words": "阿剌克涅！",
    "voice": null,
    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "審判狼蛛",
    "words": "\\n判決──",
    "voice": null,
    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "審判狼蛛",
    "words": "死刑！",
    "voice": null,
    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "審判狼蛛",
    "words": "死刑！",
    "voice": null,
    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "審判狼蛛",
    "words": "死刑啊啊啊啊啊啊！！",
    "voice": null,
    "unit_id": 19711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……",
    "voice": "vo_adv_5210301_001",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n那是、",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "審判長先生真正的姿態……？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這也是、",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "過去的我所造出的罪孽嗎……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "確實呢……",
    "voice": "vo_adv_5210301_002",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "魔法生物，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "照理說是不具備自我的。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "阿剌克涅小姐。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n捕食同族",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而突變成的這副模樣，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是那位審判長自己所期望的樣子喔。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "沒錯！",
    "voice": "vo_adv_5210301_003",
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "跟之前嘩啦嘩啦～跑出來的樣子完全不一樣嘛。",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "不是小阿的錯喔！",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果妳還是覺得有責任，",
    "voice": "vo_adv_5210301_004",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就親手做個了斷吧。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……我明白了。",
    "voice": "vo_adv_5210301_005",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我會做好覺悟的。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜也",
    "voice": "vo_adv_5210301_006",
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "會全～力幫忙的喔！",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "那麼那麼，",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "預～備！",
    "voice": null,
    "unit_id": 136211
  },
  {
    "type": "dialogue",
    "name": "拿娜‧霞‧阿剌克涅",
    "words": "我有異議！！",
    "voice": "vo_adv_5210301_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "エリスさんのシャドウ……",
    "voice": "vo_adv_5206301_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\nなんて迫力なの……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "おめん。",
    "voice": "vo_adv_5206301_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nこわい。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nいかつい。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "……この空間でのみ、",
    "voice": "vo_adv_5206301_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "力を増大させているようね。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "あなたたちは下がっていなさい。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nここは、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "わたしが──",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "いいえ、",
    "voice": "vo_adv_5206301_003",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "一緒に戦います。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "色々あったけど、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "今は話し合える仲だもの。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ん。",
    "voice": "vo_adv_5206301_004",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nきょうりょく。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nだいじょぶ。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "そう……",
    "voice": "vo_adv_5206301_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "くるわよっ。",
    "voice": null,
    "unit_id": 135011
  }
]
