    "name": "日和",
    "words": "啊！",
    "voice": "vo_adv_5059007_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "找到了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "喂",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "──",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "【美食殿堂】的各位！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "闖進精靈族之村的魔物皆順利討伐完畢，",
    "voice": "vo_adv_5059007_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n「黑色風之精靈」也消失無蹤，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們想說儀式應該結束了而趕來一看……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_5059007_002",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "居然在煮飯。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n很有貪吃佩可他們的風格呢。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_5059007_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "優衣～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怜還有日和，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們要不要一起吃飯呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我要我要！",
    "voice": "vo_adv_5059007_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我肚子都餓扁了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "受不了",
    "voice": "vo_adv_5059007_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……看來事情都進行得很順利，真是太好了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看到這幅景象，我就放心了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們是不是被當成無論到哪都在吃飯的",
    "voice": "vo_adv_5059007_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n悠哉集團了啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們這群人……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……呵呵。",
    "voice": "vo_adv_5059007_007",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼了？",
    "voice": "vo_adv_5059007_008",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──可可蘿，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳好像很開心的樣子。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦……",
    "voice": "vo_adv_5059007_009",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇～！",
    "voice": "vo_adv_5059007_010",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我可能是第一次看到",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可可蘿笑成那樣！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯。",
    "voice": "vo_adv_5059007_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "平時她給人的感覺很成熟，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或說是穩重……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n如今",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼講……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "天真無邪的，相當惹人憐愛。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是什麼模樣呀？",
    "voice": "vo_adv_5059007_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請妳也讓我看看吧～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也給我瞧瞧啦！",
    "voice": "vo_adv_5059007_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好了，可蘿仔，快給我笑！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不然我搔妳癢喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜、",
    "voice": "vo_adv_5059007_014",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜託妳們不要捉弄在下了，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您救救在下……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_5059007_015",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有什麼事呢，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_5059007_016",
    "unit_id": 115511
  },
  {
    "type": "still",
    "still_id": "505900701"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的！",
    "voice": "vo_adv_5059007_017",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……貪吃佩可小姐。",
    "voice": "vo_adv_5059007_018",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "什麼？",
    "voice": "vo_adv_5059007_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……凱留小姐。",
    "voice": "vo_adv_5059007_020",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_5059007_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主公大人。",
    "voice": "vo_adv_5059007_022",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可可蘿",
    "voice": "vo_adv_5059007_023",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很慶幸",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能與各位相遇。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下，",
    "voice": "vo_adv_5059007_024",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕不會再次放開這份羈絆。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此，",
    "voice": "vo_adv_5059007_025",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往後還請各位──",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──多多指教了。",
    "voice": "vo_adv_5059007_026",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "我才要請妳多指教。",
    "voice": "vo_adv_5059007_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【美食殿堂】重新維繫起險些失去的羈絆了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那張餐桌上所綻放的笑容，要比從前要來得更加開朗。",
    "voice": null,
    "unit_id": null
  },
