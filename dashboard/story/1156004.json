    "name": "優衣",
    "words": "……嗯嗯……",
    "voice": "vo_adv_1156004_066",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "奇怪，",
    "voice": "vo_adv_1156004_067",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "睡著了嗎……？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我是太累了嗎……？",
    "voice": "vo_adv_1156004_068",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對了，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我得去看看",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有沒有食材。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……嗯～",
