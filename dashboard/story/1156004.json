    "name": "優衣的弟弟",
    "words": "我可不原諒你喔～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊！",
    "voice": "vo_adv_1156004_056",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "喂，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "東西呢～！？",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……跑掉了。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我弟沒大沒小的。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是嗎……？",
    "voice": "vo_adv_1156004_057",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我覺得他應該不會這麼想就是了……",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "他跟朋友",
    "voice": "vo_adv_1156004_058",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "往我家的方向跑走了，",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我得去追他。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "實在很感謝你",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "幫我拿東西。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我下次會",
    "voice": "vo_adv_1156004_059",
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "再答謝你的。",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那就……",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "再見囉！",
    "voice": null,
    "unit_id": 100232
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1156004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你跟優衣",
    "voice": "vo_adv_1156004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的是讓人看了很心急。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要是弄個不好，我看就一輩子都是那樣了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "明明雙方應該都有意思，",
    "voice": "vo_adv_1156004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想法卻總是錯身而過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n彷彿心意相通那天永遠不會到來似的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就看的人來說",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是還挺有趣的就是了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……開玩笑的啦，",
    "voice": "vo_adv_1156004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一步一步慢慢來也好，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你就跟優衣好好面對彼此，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "努力和對方心意相通吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這也是為了那孩子好喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "懂嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，",
    "voice": "vo_adv_1156004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這下就跨出得到家人同意的第一步了呢♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "既然一起買東西、",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一起並肩回家，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這些事前練習都很順利，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想你可以稍微主動一點喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1156004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見啦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
