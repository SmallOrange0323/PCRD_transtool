    "unit_id": 115611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……你聽我說，",
    "voice": "vo_adv_1156004_071",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生……",
