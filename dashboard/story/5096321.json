[
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗚哇哇哇哇哇！？",
    "voice": "vo_adv_5096321_000",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這魔物是怎麼回事，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好驚人的水勢、",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "水勢啊──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和，",
    "voice": "vo_adv_5096321_001",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "小心點！",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這隻魔物",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會操控水來破壞我們的陣型，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且還準確地趁我們陣型崩壞的時候攻擊過來……！",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要是被這種攻擊給命中，",
    "voice": "vo_adv_5096321_002",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "後果可不光是失去意識而已喔……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我會想辦法用魔法來阻擋牠的，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳們就趁那時候攻擊！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣，謝謝妳！",
    "voice": "vo_adv_5096321_003",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n怜，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "趁優衣保護我們的時候",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一口氣進攻吧！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_5096321_004",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在被對方的步調給吞沒之前，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n讓我們攻陷牠吧！",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "各位，",
    "voice": "vo_adv_5096321_005",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "麻煩你們囉！",
    "voice": null,
    "unit_id": 122611
  }
]
