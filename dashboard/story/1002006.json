[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……優衣。妳該不會，",
    "voice": "vo_adv_1002006_000",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之後就只是請那傢伙喝茶然後就沒有下文了吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……",
    "voice": "vo_adv_1002006_001",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就是在公會之家，兩人一起喝茶，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n之後目送有事要忙的騎士先生先離開……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就沒了。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "果然啊……",
    "voice": "vo_adv_1002006_002",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳這樣的話，不管過多少年都只能在好朋友的關係下無疾而終喔？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳想要等兩人變成老爺爺老奶奶之後還在書店約會嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該不會吧……",
    "voice": "vo_adv_1002006_003",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣妳不知道對方的想法，所以鼓不起勇氣。",
    "voice": "vo_adv_1002006_004",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳現在立刻去搞清楚那傢伙的想法吧！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸欸欸欸！",
    "voice": "vo_adv_1002006_005",
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……結局我被真琴趕出門了。",
    "voice": "vo_adv_1002006_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n明明是我們兩人的公會之家的說……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就算叫我確認他的想法，但要怎麼做才好呢……",
    "voice": "vo_adv_1002006_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果騎士先生在城鎮裡的某處就好了……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！午、午安。這麼巧呀！",
    "voice": "vo_adv_1002006_008",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那個。不知道可否稍微聊聊呢？",
    "voice": "vo_adv_1002006_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果可以的話，我們換個地方說話吧？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……到這裡應該就可以了。",
    "voice": "vo_adv_1002006_010",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你陪我一起來這裡。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生，謝謝你上次陪我一起逛街。",
    "voice": "vo_adv_1002006_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我用上次買的魔法書努力用功，已經能使用更多種多樣的魔法了呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "像是這種魔法…",
    "voice": "vo_adv_1002006_012",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "身體變得溫暖了吧？",
    "voice": "vo_adv_1002006_013",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個魔法呀，可以讓人就算在寒冷的地方或是受寒氣攻擊都平安無事呦。是我之前就一直想學的魔法呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……我在說什麼啊我！？",
    "voice": "vo_adv_1002006_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n現在不是說明魔法內容的場合呀！）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（但是我不知道如何開口問呀！",
    "voice": "vo_adv_1002006_015",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n幫幫我呀～！真琴……！！）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如、",
    "voice": "vo_adv_1002006_016",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果有這個魔法，當有人在寒冷的地方感到困擾時",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我就能幫助他了對吧……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣的話，我應該比之前更能幫上大家的忙吧……？",
    "voice": "vo_adv_1002006_017",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是……這樣的嗎？",
    "voice": "vo_adv_1002006_018",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "重要的人……",
    "voice": "vo_adv_1002006_019",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛才你說的，我沒有聽錯吧……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（騎士先生，是這樣看待我的呀……）",
    "voice": "vo_adv_1002006_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……說是重要的人呢。我好高興……",
    "voice": "vo_adv_1002006_021",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有一股暖流洋溢擴展到心坎裡……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生……你有沒有，喜歡的對象呢……？",
    "voice": "vo_adv_1002006_022",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦！？",
    "voice": "vo_adv_1002006_023",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你聽到我剛才說的話了嗎！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這、這個……那個嘛……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（話說回來，騎士先生他失去記憶……",
    "voice": "vo_adv_1002006_024",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說不定，他不知道喜歡是代表什麼意思……？）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……所謂的喜歡呀，就是當和某人在一起時會心跳加速，或是感到心頭暖洋洋……",
    "voice": "vo_adv_1002006_025",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "想經常和那個人在一起的念頭，這就是喜歡呦。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當吃到美味食物的時候，",
    "voice": "vo_adv_1002006_026",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n因為好吃所以希望再吃到的想法雖然也是「喜歡」，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但和我剛才說的……那種「喜歡」的意義是不同的呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……這是因為，",
    "voice": "vo_adv_1002006_027",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我雖然也很喜歡日和和怜……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但有層次更加不同的「喜歡」存在的。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是不好意思呢。我沒辦法很明確的表達出來……！",
    "voice": "vo_adv_1002006_028",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我知道喜歡的心情是如何，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但很難用語言來表達出來……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我！？",
    "voice": "vo_adv_1002006_029",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個……那個嘛……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（我我我我我……！",
    "voice": "vo_adv_1002006_030",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你這樣問我，我該如何說出口……！？）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……現、現在是祕密！",
    "voice": "vo_adv_1002006_031",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……總有一天會坦白的……請等待那天到來吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝……",
    "voice": "vo_adv_1002006_032",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……我要擁有更多的勇氣，",
    "voice": "vo_adv_1002006_033",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "直到有天能將這份感情說出口……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "請你再等我一下下呦……騎士先生。",
    "voice": "vo_adv_1002006_034",
    "unit_id": 100211
  }
]
