[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾的夜空突然變紅後，過了一陣子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n忍他們邊走邊看著在街角談論的人們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "和前一陣子相比，",
    "voice": "vo_adv_5136069_000",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "赤色之夜的騷動也平息下來了呢。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但大家的內心",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "似乎還是惴惴不安……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "正因如此，",
    "voice": "vo_adv_5136069_001",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "才需要有像我們這樣的人。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n也是為了要貼近大家不安的心，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "給予支持啊。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說的也是。",
    "voice": "vo_adv_5136069_002",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然還不知道原因，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但如果我們也能多少幫上忙的話……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "所以啦，",
    "voice": "vo_adv_5136069_003",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "年輕貌美的美女們～！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n在睡不著的夜裡，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "務必要把俊俏的骷髏頭一起帶上床！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我會為妳送上連不安都能趕跑的刺激夜晚～！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是的，",
    "voice": "vo_adv_5136069_004",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸還是老樣子……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哎呀，",
    "voice": "vo_adv_5136069_005",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "說著說著就發現美女了！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n那邊那位小姐，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "要不要跟我",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "傾訴看看",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳心中的煩惱呢～！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "等等，爸爸！？",
    "voice": "vo_adv_5136069_006",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不要造成別人的困擾啊！",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咦？",
    "voice": "vo_adv_5136069_007",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗚哇喔……",
    "voice": "vo_adv_5136069_008",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "還真是大膽的打扮啊！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n小姐，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳會不會冷？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "一個人的夜晚會不會很難熬？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n這種時候就交給我",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "骷髏老爸──",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊……",
    "voice": "vo_adv_5136069_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n你們難道是骷髏老爸",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "跟忍？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對不起，",
    "voice": "vo_adv_5136069_010",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請妳不要放在心上。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸你真是的，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "差不多該適可而止──",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "噢噢，到此為止！",
    "voice": "vo_adv_5136069_011",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "忍，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "停下、停下～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "什麼……？",
    "voice": "vo_adv_5136069_012",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那個，忍呀？",
    "voice": "vo_adv_5136069_013",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n老爸他啊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "只是稍～微開了點玩笑而已！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以說啊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "希望妳可以忍住",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不要把他劈成兩半喔",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "劈成兩半……？",
    "voice": "vo_adv_5136069_014",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n請問，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳究竟是……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳認識我們嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": "vo_adv_5136069_015",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n妳不是要對老爸下重手嗎……？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": "vo_adv_5136069_016",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "莫非這是……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n與我的世界",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "個性不同的那種情況？　",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "沒想到會在日和不在的時候碰上這種事……",
    "voice": "vo_adv_5136069_017",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我一個人要說明的話感覺有點困難啊……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……嗯。",
    "voice": "vo_adv_5136069_018",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就先蒙混過去吧！　",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "欸──",
    "voice": "vo_adv_5136069_019",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "其實呢，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "兩位，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就實話實說了，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我認識跟你們很相似的人。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "很相似的人……？",
    "voice": "vo_adv_5136069_020",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "而且！",
    "voice": "vo_adv_5136069_021",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n他們也是一個占卜師，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "帶著變成骷髏頭的父親。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這不只是很相似了吧！？",
    "voice": "vo_adv_5136069_022",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……難道，",
    "voice": "vo_adv_5136069_023",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳剛才說",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "劈成兩半的事情是……！",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對，",
    "voice": "vo_adv_5136069_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我說的就是他們。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "說到那個骷髏頭啊？",
    "voice": "vo_adv_5136069_025",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n也很～常對女人出手呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "而他的女兒",
    "voice": "vo_adv_5136069_026",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "似乎很討厭他那樣騷擾人家。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我絕不原諒！！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "她每次都這樣說，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "然後就會進行很～嚴厲",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "的懲罰……！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "劈成兩半，",
    "voice": "vo_adv_5136069_027",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在火上面烤，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "或是用銼刀磨……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n雖然每次結束後都會確實恢復原狀，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但我看著都覺得好痛……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抖抖抖抖……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咿、",
    "voice": "vo_adv_5136069_028",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咿……！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n爸爸",
    "voice": null,
    "unit_id": 2411
