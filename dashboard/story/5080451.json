  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然發生了很多事，",
    "voice": "vo_adv_5080451_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好險事情結果還算圓滿呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好吃的點心當然會被認可！",
    "voice": "vo_adv_5080451_001",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而且",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "宮子也很努力呀！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為了布丁努力是理所當然的喲！",
    "voice": "vo_adv_5080451_002",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不過，",
    "voice": "vo_adv_5080451_003",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "當婆婆露出笑容時，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子會感受到和吃布丁時",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "相同的心情……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……這樣啊。",
    "voice": "vo_adv_5080451_004",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那就好好",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "珍惜那份心情吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "難道說",
    "voice": "vo_adv_5080451_005",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆也和布丁一樣好吃！？",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "宮子……",
    "voice": "vo_adv_5080451_006",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n氣氛都被糟蹋了唷……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哈哈，",
    "voice": "vo_adv_5080451_007",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真有宮子的風格。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但是",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可不能真的把婆婆吃掉喔？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家知道啦！",
    "voice": "vo_adv_5080451_008",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子才不會把給人家布丁的人吃掉呢！",
    "voice": null,
    "unit_id": 119911
  }
]
