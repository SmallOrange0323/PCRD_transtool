  {
    "type": "dialogue",
    "name": "晶",
    "words": "嘿，少年，",
    "voice": "vo_adv_4010187_000",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "歡迎你來。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n難道說",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你是來買可麗餅的嗎？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我很高興哦，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "額外多送你一點",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "配料～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "咦？",
    "voice": "vo_adv_4010187_001",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那難道說，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是來幫忙店裡的！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n幫大忙了～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我正想專心思考新菜單呢～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……也不是為了這個，",
    "voice": "vo_adv_4010187_002",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那是什麼～？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "居然能讓被稱為迷宮女王的我",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這麼煩惱，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n少年你還真不簡單呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊～！",
    "voice": "vo_adv_4010187_003",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "原來是這樣，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "原來如此……！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "確實稍微想一下就會知道，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "今天是我的生日！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "因為我平常總是過著漫不經心的浪人生活～",
    "voice": "vo_adv_4010187_004",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "所以沒有慶祝紀念日的習慣。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過沒想到，",
    "voice": "vo_adv_4010187_005",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n少年居然會特地過來幫我慶祝生日……",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這股心情是什麼，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "難道這就是喜悅嗎？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "心臟越跳越快了。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗚哇～",
    "voice": "vo_adv_4010187_006",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你到底想把大姐姐我怎麼樣～？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "而且這個還是",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "FPS的新作耶！",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我還沒有入手呢～",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很好，少年，",
    "voice": "vo_adv_4010187_007",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我們現在就來一起玩吧。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你說顧店？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "當然是臨時休息啊。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n不管是遊戲機還是螢幕",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "全都有在車子裡哦♪",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "平常就已經",
    "voice": "vo_adv_4010187_008",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "受你這麼多照顧了，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n居然還讓你來慶祝",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我的生日……",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "如果沒有",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "讓你盡情玩個夠本的話，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "反而會",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很失禮呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "少年，",
    "voice": "vo_adv_4010187_009",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n從你身上「得到的東西」我一定會報答的。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n賭上我的一切，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "來回報給你，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哦。",
    "voice": null,
    "unit_id": 106832
  }
