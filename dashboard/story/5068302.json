[
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "唔唔……？",
    "voice": "vo_adv_5068302_000",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n妳們也真是煩人啊……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": "vo_adv_5068302_001",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們當然不會放棄……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為我們不想讓孩子們感到害怕！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且……",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "做出這種事的，",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "居然是由我們製作出來的玩具……",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這怎麼可以視而不見呢……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒錯！",
    "voice": "vo_adv_5068302_002",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們工作是為了",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "孩子們的笑容。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我們一點也不想看到",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "他們哭泣的模樣！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "明明是和我一起玩，",
    "voice": "vo_adv_5068302_003",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "小孩子卻會哭……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n……我還以為妳們想說什麼，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "別笑死人了！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我可是",
    "voice": "vo_adv_5068302_004",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "史上最棒的玩具！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "跟我一起玩的小孩子，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n肯定是每一個都會發出愉快的笑聲！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "絕對是這樣！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看來它還沒有冷靜下來呢……！",
    "voice": "vo_adv_5068302_005",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "它現在很情緒化，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "千萬不可以大意喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好、",
    "voice": "vo_adv_5068302_006",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好的……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "若是為了玩具王，",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "無論多少次，我都會挺身戰鬥……！",
    "voice": null,
    "unit_id": 116713
  }
]
