  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵、呵、呵……",
    "voice": "vo_adv_5008101_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我乃安妮羅潔‧馮‧修特帕魯！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n人稱",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "疾風之冥姬！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "被貧窮壓得喘不過氣的杏奈美眉為了求一份工作，",
    "voice": "vo_adv_5008101_001",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而前往了溪谷洞窟。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而那悽涼的背影，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "便是她",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最後的身影了……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "完。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "七七香，",
    "voice": "vo_adv_5008101_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不要把話講得這麼可怕啊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然沒錢倒是真的……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "然而，",
    "voice": "vo_adv_5008101_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看看這個！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n藉由這尋求志願者的公告，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我的困境也將獲得淨化。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵、呵、呵……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我都快被自己的強運給閃瞎了呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "若翻成人話，",
    "voice": "vo_adv_5008101_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "撿到意外還不賴的打工傳單所以安啦！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "――是這樣的意思吧♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真一如往常的熱鬧呢，",
    "voice": "vo_adv_5008101_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們幾個。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦哦，",
    "voice": "vo_adv_5008101_006",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "流夏大姐來啦～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別叫我大姊頭呀……",
    "voice": "vo_adv_5008101_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "話又說來這還真是巧呢，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家都有事前往同樣的方向。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏、修特帕魯、七七香",
    "words": "下回，",
    "voice": "vo_adv_5008101_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏、修特帕魯、七七香",
    "words": "「暮光破壞者」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來吧，",
    "voice": "vo_adv_5008101_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓我們一起踏上冒險的旅程吧！",
    "voice": null,
    "unit_id": 105611
  }
]
