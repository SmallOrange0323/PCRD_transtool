    "type": "dialogue",
    "name": "謎樣男子",
    "words": "真倒楣耶……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "喂！",
    "voice": "vo_adv_1254001_067",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "我可沒下令說可以休息！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n快點搬起那個木桶！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "我說你啊──",
    "voice": "vo_adv_1254001_068",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "你是誰啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那是我們要問的才對。",
    "voice": "vo_adv_1254001_069",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你知道這裡是魔物保護區嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不對，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你是明明知道還非法入侵的吧？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "唔……！",
    "voice": "vo_adv_1254001_070",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "利用遭到禁止的隸屬魔法操縱麼物，",
    "voice": "vo_adv_1254001_071",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n依照魔物保護法的規定，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是剝奪魔物尊嚴的行為。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "況且你還利用那些魔物襲擊村子，",
    "voice": "vo_adv_1254001_072",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n搶奪食物……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "完全是竊盜罪。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我要以遊俠的權限",
    "voice": "vo_adv_1254001_073",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "拘捕你。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n詳細的事情，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就到牢裡再說吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "……！",
    "voice": "vo_adv_1254001_074",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "給我殺了那些傢伙！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請你快點退下！",
    "voice": "vo_adv_1254001_075",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我會和喵特一起",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "制止魔物！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特！",
    "voice": "vo_adv_1254001_076",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n過來這裡！！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎喔喔──！！",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一口氣壓制住牠們！",
    "voice": "vo_adv_1254001_077",
    "unit_id": 125413
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "可惡……！",
    "voice": "vo_adv_1254001_078",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n得快去通知老大──",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你別想逃。",
    "voice": "vo_adv_1254001_079",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "可惡……！",
    "voice": "vo_adv_1254001_080",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "居然連拖延時間都辦不到……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n那些傢伙在搞什麼啊……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠們應該正在熟睡中喔，",
    "voice": "vo_adv_1254001_081",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為遊俠的麻醉箭效果很強。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "比起那個──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我勸你在這裡乖乖就範，",
    "voice": "vo_adv_1254001_082",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為我並不想對你動粗。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "…………可惡，",
    "voice": "vo_adv_1254001_083",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "謎樣男子",
    "words": "真的有夠倒楣耶……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "纏上繃帶……",
    "voice": "vo_adv_1254001_084",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "包好了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n幸好我有跟真陽學替魔物包紮的方法。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……………………",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好了，",
    "voice": "vo_adv_1254001_085",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你不需要繼續生活在恐懼之下了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有你的同伴",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都已經自由了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "…………\\n……………………",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……走掉了呢。",
    "voice": "vo_adv_1254001_086",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖說是被人操縱，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我知道依照原本的規定，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n牠們也必須受懲罰才行。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是……",
    "voice": "vo_adv_1254001_087",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "既然隸屬魔法已經解除了，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想牠們也不會再出現在人類的村子了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……是的。",
    "voice": "vo_adv_1254001_088",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們也回村子去吧，",
    "voice": "vo_adv_1254001_089",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n得向村長先生報告才行。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "沒想到會這麼快就查清楚原因了……！",
    "voice": "vo_adv_1254001_090",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們確實逮到了一名犯人，",
    "voice": "vo_adv_1254001_091",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過還稱不上是解決了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n要說我們現在能做的事，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "頂多只有進行巡邏……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我們會盡力防止事件再次發生的。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "妳叫做",
    "voice": "vo_adv_1254001_092",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "栞小姐對吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我相信只要有妳在，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我們和魔物就都能放心生活了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "今後也麻煩妳了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": "vo_adv_1254001_093",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的！",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你。",
    "voice": "vo_adv_1254001_094",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為有你的協助，才能有這樣的成果。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇啊！？",
    "voice": "vo_adv_1254001_095",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也沒有忘了喵特喔。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n謝謝你和我一起戰鬥。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "咕嚕嚕♪",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那位愛吃醋的搭檔硬是擠到兩人中間坐了下來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n栞則是抱緊牠，對牠露出笑容。",
    "voice": null,
    "unit_id": null
  }
]
