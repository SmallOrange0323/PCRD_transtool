    "name": "妮諾",
    "words": "我還有退路是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我還有",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個水蜘蛛！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "妳還說這種話，",
    "voice": "vo_adv_1096002_047",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "反正都是在虛張聲勢吧？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "妳差不多該覺悟了！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊，",
    "voice": "vo_adv_1096002_048",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　我正在等你是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請向我的腳，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "發射出威勢吧！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "still",
    "still_id": "109600201"
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這就是",
    "voice": "vo_adv_1096002_049",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "狗急跳牆之力，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "忍法",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "・水蜘蛛之術是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "她、",
    "voice": "vo_adv_1096002_050",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "她走在水上了！？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "\\n妳的忍法和諺語的用法",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "忍者居所的管理員",
    "words": "未免都太亂來了吧！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "各位朋友，",
    "voice": "vo_adv_1096002_051",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天看得開心嗎？",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你們還會再來玩吧！？",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　還請",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "保重身體！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "閻魔大人也",
    "voice": "vo_adv_1096002_052",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "再會了忍忍是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "隱身是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著在水上跑著的妮諾的背影，\\n觀眾們響起了今天最大的歡呼聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但是因為妮諾跑的那個池塘水很淺，\\n其實她只是看起來像是在水上跑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "腳",
    "voice": "vo_adv_1096002_053",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "都濕透了是也。",
    "voice": null,
    "unit_id": 109611
  },
