[
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在一切塵埃落定之後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}他們接受涅妃‧涅羅的召集，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在鬼岩城塞與煉獄的皇女會面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "霞閣下。",
    "voice": "vo_adv_5210007_000",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n疏於問候，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在萬分抱歉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "大致緣由",
    "voice": "vo_adv_5210007_001",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家已從",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "米亞那兒聽聞。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "皆因奴家管理不周，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n令汝煞費一番勞苦──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒有這回事，",
    "voice": "vo_adv_5210007_002",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "涅妃‧涅羅小姐。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我才是，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不知道是否滿足了妳的期待呢？",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "哦……",
    "voice": "vo_adv_5210007_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝所言之",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "期待是指？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳會把這面「真實之鏡」交付給我，",
    "voice": "vo_adv_5210007_004",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n正是希望我揭露",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "審判長和會長的本意，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我認為這是妳的請託，因此接下了──",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵呵。",
    "voice": "vo_adv_5210007_005",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這正可謂",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「不言自明」──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不愧為王都之名偵探。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非也，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如今",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝應為煉獄之名偵探才是。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咦？",
    "voice": "vo_adv_5210007_006",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咦？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哼。",
    "voice": "vo_adv_5210007_007",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "反正我就知道會是這樣。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "涅妃早就猜到",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那兩個人很可疑了吧？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "哦……",
    "voice": "vo_adv_5210007_008",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "華音。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家聽聞汝",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吃太多溫泉饅頭而已撒手人寰……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝之雙腿還在？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "很遺憾！",
    "voice": "vo_adv_5210007_009",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n本小姐的玉腿",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一如既往",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "的",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "美麗啊，別裝傻！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正如霞閣下的推斷，",
    "voice": "vo_adv_5210007_010",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家早已看穿",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "彼些傢伙心懷鬼胎。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而──",
    "voice": "vo_adv_5210007_011",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若由奴家親自出馬，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n定必讓蘭德索爾",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "諸位商人惶恐。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "故此奴家忍住羞愧，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "求助於",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "赫赫有名之名偵探閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "能將難以伺候的「真實之鏡」運用於指掌間，",
    "voice": "vo_adv_5210007_012",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "出色破解謎團之舉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此凡種種成果，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "皆遠超奴家之期望。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "再次感謝",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "霞閣下對此事之協助。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "承蒙誇獎，",
    "voice": "vo_adv_5210007_013",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我深感榮幸。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n當作這次工作的報酬──",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然不能這麼說，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但其實，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我有一事相求。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "來吧，",
    "voice": "vo_adv_5210007_014",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "阿剌克涅小姐。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "好、",
    "voice": "vo_adv_5210007_015",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "好的……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "………",
    "voice": "vo_adv_5210007_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "那、",
    "voice": "vo_adv_5210007_017",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "那個，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "涅羅！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "希望妳能聽拿娜說──！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n小阿已經",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "不是以前的小阿了！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "拿娜，",
    "voice": "vo_adv_5210007_018",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不必如此吵鬧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與其由奴家絮絮叨叨，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "問問幾位當事人，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "豈不更為實際？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "諸位。",
    "voice": "vo_adv_5210007_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "進來吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "妖魔人們",
    "words": "打、",
    "voice": "vo_adv_5210007_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人們",
    "words": "打擾了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你們是",
    "voice": "vo_adv_5210007_021",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "曾經懷疑阿剌克涅的……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "雖說是受到審判長唆使，",
    "voice": "vo_adv_5210007_022",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "我們對妳",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "做了很過分的事。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "\\n",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "真的",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "非常抱歉。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "請原諒我們。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "我們向妳賠罪。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "請、",
    "voice": "vo_adv_5210007_023",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "請不要道歉。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "各位的憤怒",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是十分合理的……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "自那之後，",
    "voice": "vo_adv_5210007_024",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "男性妖魔人",
    "words": "我被弟弟妹妹罵了。",
    "voice": null,
    "unit_id": 52111
  },
  {
