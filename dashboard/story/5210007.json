    "words": "騎士閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還請",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "稍微過來一會。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好的。",
    "voice": "vo_adv_5210007_052",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "涅妃‧涅羅小姐。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "今後無條件相信阿剌克涅小姐……",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "並非如此對吧？",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非也，",
    "voice": "vo_adv_5210007_053",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非也。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n如今那傢伙",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "毫無疑問地純粹……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正因其存在有如剛出生之嬰孩。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n當下可謂毫無威脅之物。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳的意思是，",
    "voice": "vo_adv_5210007_054",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在她的內心深處，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還潛伏著過往的魔性？",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "誰知道……？",
    "voice": "vo_adv_5210007_055",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家亦未敢妄斷……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁有何想法？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是。",
    "voice": "vo_adv_5210007_056",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "好比",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那會長。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n那青年毫無疑問",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "深愛此煉獄之地。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正因如此──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "才墮入黑暗。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "走上歪道之危險性，",
    "voice": "vo_adv_5210007_057",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "阿剌克涅亦然。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為免其墮入黑暗、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為免其受內心黑暗所噬。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n還請諸位看望──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明白了。",
    "voice": "vo_adv_5210007_058",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想她肯定沒問題的。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為現在的阿剌克涅小姐",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有朋友在啊。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "沒料到那魔蜘蛛與拿娜",
    "voice": "vo_adv_5210007_059",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟能締結情誼……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呼呼呼……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "background",
    "bg_id": "502250"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "呼。",
    "voice": "vo_adv_5210007_060",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "結束了呢！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "那個，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小阿。",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "今天的零食要吃什麼？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "已經沒有甜甜圈了～",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "零食……",
    "voice": "vo_adv_5210007_061",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n在吉歐‧格黑納",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "沒有像甜甜圈一樣的甜點。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那麼──",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "蜘蛛愛吃的，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "甜蟲子怎麼樣？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咦！？",
    "voice": "vo_adv_5210007_062",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "蟲子也有甜的嗎？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "雖然有點可怕……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小阿",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "會和拿娜一起吃嗎？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "會的，",
    "voice": "vo_adv_5210007_063",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "小拿。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "還有……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "也可以邀請",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生一起嗎？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "當然",
    "voice": "vo_adv_5210007_064",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "可以了！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n小騎士一定會說",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "「我要去！」",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "的！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "嗯。",
    "voice": "vo_adv_5210007_065",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "和小拿，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "還有騎士先生，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "不論到哪裡也……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "是三人一起的",
    "voice": "vo_adv_5210007_066",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "零食探險隊！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "為了尋找各式各樣世界的甜點，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "出發──！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜‧阿剌克涅",
    "words": "啊哈哈哈哈哈♪",
    "voice": "vo_adv_5210007_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "響徹吉歐‧格黑納天空的笑聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那是曾經",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "身為加害者與受害者",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "如今，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "卻成為了獨一無二的「朋友」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那兩人的笑聲──",
    "voice": null,
    "unit_id": null
  },
