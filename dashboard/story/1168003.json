[
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「出餐快又品質好！」、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「貓咪模型贈品很可愛」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由於這些佳評，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "工廠內外都有許多客人前來光顧珠希的鯛魚燒店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而這一天她卻突然休店，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "開起了會議。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……事情嚴重了喵。",
    "voice": "vo_adv_1168003_000",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n聽我說之前，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你先看看這個喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵。",
    "voice": "vo_adv_1168003_001",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n是我不小心放進贈品裡的黑歷史喵……！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "珠希模型我已經自主回收了。",
    "voice": "vo_adv_1168003_002",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還沒回收的就只剩",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}你那一個而已喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然我想叫你趕快還來，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但現在先不說這個……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "已經沒在市場流通的模型，為什麼會出現在這裡？",
    "voice": "vo_adv_1168003_003",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n{0}，你有辦法推理出原因嗎喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "給你個提示喵，",
    "voice": "vo_adv_1168003_004",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你仔細觀察這個模型的尾巴喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這個尾巴成了倒鉤型，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "更何況還只有一條尾巴喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最嚴重的是……",
    "voice": "vo_adv_1168003_005",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這模型一點都不可愛喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是冒牌貨喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "順帶一提，",
    "voice": "vo_adv_1168003_006",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個模型是一個鯛魚燒店常客的喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n似乎是在某個攤販",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "用特別價買到的喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "可是，",
    "voice": "vo_adv_1168003_007",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我去找那個攤販時，已經不在了……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然心有不甘，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但無法繼續追查下去了喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我只好不甘不願的打道回府……",
    "voice": "vo_adv_1168003_008",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是說真的，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個模型到底是怎樣喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要抄襲也抄徹底一點喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當然氣喵！",
    "voice": "vo_adv_1168003_009",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n明明上市得比我還晚，品質怎麼會做得這麼爛喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這就證明他們根本就欠缺讓客人開心的精神喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "妳說得非常好，",
    "voice": "vo_adv_1168003_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "珠希！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵！？",
    "voice": "vo_adv_1168003_011",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "工廠長！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你是來買鯛魚燒的喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "嗯。",
    "voice": "vo_adv_1168003_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我是想來買鯛魚燒沒錯，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "但看來今天沒開呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "先別說這個，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "剛才珠希的怒吼，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n實在是大快人心啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "其實",
    "voice": "vo_adv_1168003_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我們工廠製造的玩具",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "也被人仿造了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n似乎還宣稱是上錯色或者是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "什麼夢幻產品序號，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n編造一堆謠言，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "藉此賣出高價。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "聽說，",
    "voice": "vo_adv_1168003_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "是由某個貴族率領集團在製作仿冒品。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我無法容忍這種行為，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "於是前往那個貴族的宅邸抗議……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "結果卻吃了閉門羹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我既沒有證據，",
    "voice": "vo_adv_1168003_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "也無法找騎士團投訴。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n與此同時仿冒品仍持續出現在市面上，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我也只能把委屈往肚裡吞了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "那個「貓咪模型」的仿冒品",
    "voice": "vo_adv_1168003_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "應該也是他們做的吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "……居然對如此惡行置若罔聞，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "真是世風日下啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "工廠長，",
    "voice": "vo_adv_1168003_017",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你可以寫下更詳細的資訊，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n向蘭德索爾的",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "意見箱投書喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "弱勢族群的夥伴，",
    "voice": "vo_adv_1168003_018",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n幻影貓一定會幫忙你的喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "妳說的幻影貓，",
    "voice": "vo_adv_1168003_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "是那個義賊嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "……也好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我就死馬當活馬醫吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "珠希。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我先走了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好久沒幹老本行喵！",
    "voice": "vo_adv_1168003_020",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "到了晚上就開始行動喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過我先聲明，",
    "voice": "vo_adv_1168003_021",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，這次你不能跟去喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然是為了伸張正義，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是讓一般人跟我一起涉險，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n實在不合乎我的原則喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之！",
    "voice": "vo_adv_1168003_022",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n幫助玩具工廠的人們，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就是我幻影貓的職責喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……喵！？",
    "voice": "vo_adv_1168003_023",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n{0}，你這傢伙真的是……！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "明明平常總是一臉呆樣，",
    "voice": "vo_adv_1168003_024",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就只有這種時候才……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你真的是太狡猾了喵……！　",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
