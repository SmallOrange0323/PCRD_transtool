    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然這樣……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n金庫就交給{0}你來開喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "什麼？",
    "voice": "vo_adv_1168003_052",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你擔心自己打不開金庫？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這你就不用擔心了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，我給你的那個手環……",
    "voice": "vo_adv_1168003_053",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只要把它裝到金庫上，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就會輔助你尋找出密碼了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在你找到之前……",
    "voice": "vo_adv_1168003_054",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就由我來對付這些雜魚喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n處理魚我可是專門的喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "看我把你們料理得",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一乾二淨喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "保鑣1",
    "words": "妳一個小丫頭有什麼能耐！？",
    "voice": "vo_adv_1168003_055",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "保鑣1",
    "words": "\\n喝啊啊啊啊！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓貓拳喵～～！！！！",
    "voice": "vo_adv_1168003_056",
    "unit_id": 116811
  },
  {
    "type": "background",
    "bg_id": "501242"
  },
  {
    "type": "dialogue",
    "name": "保鑣1",
    "words": "噗啊！？",
    "voice": "vo_adv_1168003_057",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "那、",
    "voice": "vo_adv_1168003_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "那是什麼東西……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "\\n她的背包中出現了手臂！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "且聽我說明喵！",
    "voice": "vo_adv_1168003_059",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是",
    "voice": "vo_adv_1168003_060",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "改良了鯛魚燒機而成的必殺工具背包喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n順帶一提，剛才那是「貓手機械臂」喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "遇到肉球拳，沒有人不會淪陷的喵♪",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "可惡……！",
    "voice": "vo_adv_1168003_061",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "誰快去聯絡老爺……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "\\n順便要求支援……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "保鑣2",
    "words": "嗯～～～～！？",
    "voice": "vo_adv_1168003_062",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "聽我再次說明喵！",
    "voice": "vo_adv_1168003_063",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是口香糖球喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n中了這招就無法開口說話了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}！",
    "voice": "vo_adv_1168003_064",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n金庫打開了喵！？",
