    "voice": "vo_adv_1246003_006",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n這是什麼啊～！？",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "啊，",
    "voice": "vo_adv_1246003_007",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "這是要送給美里的伴手禮！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n老實說，昨天的常客們",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "都已經迷上美里了呢！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n他們拜託我",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "務必要把這些東西帶來給妳……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "話說回來，這裡為什麼會有小孩子啊？",
    "voice": "vo_adv_1246003_008",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n……不，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我曾聽小伙子說美里是老師。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n不過，現在是新年期間吧？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "幼稚園沒有放假嗎？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯，",
    "voice": "vo_adv_1246003_009",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "有放假喔～",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "只是",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們已經厭倦待在家裡了～！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "老大",
