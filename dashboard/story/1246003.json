    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "人太好嗎……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n為了讓美里可以好好休息，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n我還特地搬了這個過來呢。",
    "voice": null,
    "unit_id": 1412
  },
