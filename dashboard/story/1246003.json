    "words": "真是的，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "難得的新年假期，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n至少要讓美里好好休息啊……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "不過，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n她休假還過來我店裡幫忙，我也沒資格說別人……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_1246003_011",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為我想早點見到大家，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n所以我也很開心。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而且",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}也過來了～♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "真是的，",
    "voice": "vo_adv_1246003_012",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "該說妳",
