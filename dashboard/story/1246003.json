    "name": "美里",
    "words": "哎呀，{0}，",
    "voice": "vo_adv_1246003_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "怎麼了嗎～？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n抱著這麼一大包的行李……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有另一個人。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我還在想是誰，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "原來是昨天的老闆～！",
