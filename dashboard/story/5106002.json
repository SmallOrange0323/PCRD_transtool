[
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在牢房的一角，幾人交疊雙手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在進行互相鼓舞、提振士氣的儀式，然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "大家一起努力，",
    "voice": "vo_adv_5106002_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "讓聖誕節充滿幸福吧♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "好──！",
    "voice": "vo_adv_5106002_001",
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "510600201"
  },
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "雖然和姊姊一樣是見習天使，",
    "voice": "vo_adv_5106002_002",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "但因為我很優秀，所以不受物理侷限，",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n可以降臨到任何地方。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……總言而之，",
    "voice": "vo_adv_5106002_003",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n我的雙胞胎姊姊承蒙關照了。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5106002_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哪裡哪裡……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳太客氣了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "45度的鞠躬……",
    "voice": "vo_adv_5106002_005",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一看就很能幹，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她真的是拉菲的妹妹嗎？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要說像的話，",
    "voice": "vo_adv_5106002_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "確實是有點像，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但氛圍完全不一樣呢。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗯哼！",
    "voice": "vo_adv_5106002_007",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n經常有人",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "說我們是「天壤之別」呢！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呃，那個……",
    "voice": "vo_adv_5106002_008",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不是稱讚吧。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我們小時候經常在一起，",
    "voice": "vo_adv_5106002_009",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n不過，艾米是見習生裡",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "最優秀的，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "所以最近幾乎",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "見不到面……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這麼說起來，",
    "voice": "vo_adv_5106002_010",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "如果通過這次的升級考試，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n艾米就能拿到見習生徽章了！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "雖然我老是",
    "voice": "vo_adv_5106002_011",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "卡在這一關。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "艾米肯定沒問題的！",
    "voice": "vo_adv_5106002_012",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這次一定能",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "升級成「獨當一面的天使」",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "的！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "與其擔心我，",
    "voice": "vo_adv_5106002_013",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "不如擔心一下自己吧。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "要不然",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我來協助妳",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "升級吧。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "艾米來幫我！？",
    "voice": "vo_adv_5106002_014",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "可是……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我沒有問題的。",
    "voice": "vo_adv_5106002_015",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不行啦！",
    "voice": "vo_adv_5106002_016",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n艾米妳",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "就專注在自己的考試上吧！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這次我很有信心的！",
    "voice": "vo_adv_5106002_017",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我和我的好夥伴弓箭……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "和這孩子",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "做了很多修行！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "況且，",
    "voice": "vo_adv_5106002_018",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里她們也會幫我的，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "所以沒關係！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "啊，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里她們之前……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我知道。",
    "voice": "vo_adv_5106002_019",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "她們是阻止了妳的失控場面的恩人吧。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我都在天界看見了。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "咦！？",
    "voice": "vo_adv_5106002_020",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳都看見了嗎！？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "……太、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "太丟人了。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "現在還顧得上丟不丟人嗎。",
    "voice": "vo_adv_5106002_021",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "這種事情有一就有二。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n就算拉菲是我的姊姊，",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我的等級也比妳高，",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n妳就老老實實地聽我的吧。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不要！",
    "voice": "vo_adv_5106002_022",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n我想自己證明！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n證明我也是",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "貨真價實的幸福天使！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "唔唔唔～\\n…",
    "voice": "vo_adv_5106002_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哎呀，",
    "voice": "vo_adv_5106002_024",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "兩個人都不肯讓步呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什麼情況？",
    "voice": "vo_adv_5106002_025",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n姊妹許久不見，一見面就吵架？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……不，",
    "voice": "vo_adv_5106002_026",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我才不會",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "像小孩子一樣吵架。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "但是──",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "拉菲！",
    "voice": "vo_adv_5106002_027",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n我們來比一比，",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "看誰能讓更多人感到幸福！",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "咦？",
    "voice": "vo_adv_5106002_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "如果拉菲能贏過我的話，",
    "voice": "vo_adv_5106002_029",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n我以後就懷著敬意",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "再用「姊姊」稱呼妳。",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "但",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "如果妳輸了……",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "妳就得吃掉",
    "voice": "vo_adv_5106002_030",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "一整盤的青椒！！",
    "voice": null,
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "比賽就算了，",
    "voice": "vo_adv_5106002_031",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "但為什麼是青椒呀！？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "單純想找碴而已。",
    "voice": "vo_adv_5106002_032",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "太過分了！！！！",
    "voice": "vo_adv_5106002_033",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "但是，",
    "voice": "vo_adv_5106002_034",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我好想再被可愛的艾米",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n喊一聲「姊姊」啊……！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "唔唔唔唔……",
    "voice": "vo_adv_5106002_035",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n我就接受",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這場比賽吧！！！！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "唔唔唔～！\\n……",
    "voice": "vo_adv_5106002_036",
    "unit_id": 8911
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": "vo_adv_5106002_037",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還說自己",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "「不會像小孩子一樣吵架」，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但這就是",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "小孩子等級的可愛吵架呀？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，",
    "voice": "vo_adv_5106002_038",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們作為雙胞胎前輩，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n來讓拉菲和艾米和好吧？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然能不吵架當然是最好的……",
    "voice": "vo_adv_5106002_039",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "總之，我們就先觀望，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "再從旁協助她們吧。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，",
    "voice": "vo_adv_5106002_040",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "純小姐，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有件事想請問妳。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n裝飾聖誕樹",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "需要取得許可嗎……？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個嘛……",
    "voice": "vo_adv_5106002_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我先知會地方自治會或警備兵吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n否則不了解情況的大人",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "恐怕會像我一樣上前勸阻的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "貴為團長",
    "voice": "vo_adv_5106002_042",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還為我們想得這麼周全……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不愧是深受百姓歡迎的團長！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別這麼說……",
    "voice": "vo_adv_5106002_043",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n居民們的幸福",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也是我所期盼的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果有困難的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳們可以隨時向我尋求幫助。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "彼此彼此啊，",
    "voice": "vo_adv_5106002_044",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這次你能把她們找來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是幫了大忙。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n一定要讓我好好道個謝……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……對了。",
    "voice": "vo_adv_5106002_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n下次休假的時候，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再一起去吃個飯怎麼樣呀？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯。",
    "voice": "vo_adv_5106002_046",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想不到能讓你這麼高興，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幸好我有邀請你。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很期待呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我就先離開了，",
    "voice": "vo_adv_5106002_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果有什麼事",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就告訴外面的守衛吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "告辭。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "謝謝妳～♪",
    "voice": "vo_adv_5106002_048",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……",
    "voice": "vo_adv_5106002_049",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n妳過來一下……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然她穿著鎧甲，",
    "voice": "vo_adv_5106002_050",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但茜里看得出來！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "純小姐",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是一位很棒的大姐姐吧！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "他們還約好了要一起去吃飯，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是不是關係很好呀！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "…………",
    "voice": "vo_adv_5106002_051",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n應該",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是吧……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我說得對吧！？",
    "voice": "vo_adv_5106002_052",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……姊、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "………………",
    "voice": "vo_adv_5106002_053",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼～",
    "voice": "vo_adv_5106002_054",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "原來他在純小姐的面前",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "會笑得像個小孩啊……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "在我面前的時候",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就滿",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "普通",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……不過，",
    "voice": "vo_adv_5106002_055",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "想想也是。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "畢竟我和他的關係",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是建立在遊戲上的，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "算不算得上是朋友都不好說……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但",
    "voice": "vo_adv_5106002_056",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我還是忍不住期待了一下。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有某種特別的",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "「連結」，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n只存在於",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們兩個之間。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可是……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對我來說，他是有點特別的。",
    "voice": "vo_adv_5106002_057",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但對他來說……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我只不過是一大群人裡的其中一個……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只因為他願意主動接近我，",
    "voice": "vo_adv_5106002_058",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我就……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "感覺",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "都是我自己在一廂情願，太難為情了……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我還是",
    "voice": "vo_adv_5106002_059",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不約他了吧……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "他",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "朋友那麼多……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "搞不好都決定好要約誰了。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "如果只是要一起",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "玩遊戲，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就算不約在聖誕節這天也沒關係嘛。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦～！？",
    "voice": "vo_adv_5106002_060",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n妳剛才不還幹勁十足的嗎！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不管怎麼樣，",
    "voice": "vo_adv_5106002_061",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "現在要集中精力幫忙才行。",
    "voice": null,
    "unit_id": 102212
