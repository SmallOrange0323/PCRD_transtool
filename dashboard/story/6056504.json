[
  {
    "type": "background",
    "bg_id": "501161"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……新年的規劃嗎？",
    "voice": "vo_adv_6056504_000",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒有規劃。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n那些季節性的節慶，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我本來就沒什麼閒暇能夠參與。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的，",
    "voice": "vo_adv_6056504_001",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "忙那些堆積如山的事。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了完成那些事，接下來也會請你四處奔走。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……對於你接下來的表現，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我可是深懷期待的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "死心吧，",
    "voice": "vo_adv_6056504_002",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "用那種小狗般期盼的眼神看我",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也沒用的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "唉，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是拿你沒辦法……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果只是新年參拜，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n陪你一下倒也無妨就是……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "想不到你這人也越來越有一手了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……真是的，",
    "voice": "vo_adv_6056504_003",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "受不了你這個人。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也必須承認即使是我，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "偶爾也需要休息一下。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你可別因為是新年，就過度鬆懈懶散喔。",
    "voice": null,
    "unit_id": 115011
  }
]
