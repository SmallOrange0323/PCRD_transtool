[
  {
    "type": "background",
    "bg_id": "500080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在{0}轉學進來後過了數天……\\n大家今天也在上伊緒的課程。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大家都差不多解出問題了嗎？",
    "voice": "vo_adv_3015003_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？\\n你好像還沒寫呢？",
    "voice": "vo_adv_3015003_001",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "臉好像也紅紅的……身體不舒服嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我稍微量一下你的體溫喔。\\n",
    "voice": "vo_adv_3015003_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓我摸摸額頭……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等等等一下！伊緒！",
    "voice": "vo_adv_3015003_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n額頭貼額頭……！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "離太近了呀！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳用美色實在卑鄙！",
    "voice": "vo_adv_3015003_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？美色……？",
    "voice": "vo_adv_3015003_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n什麼",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "意思？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳是自然而然這麼做的嗎？\\n",
    "voice": "vo_adv_3015003_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼嘛，這樣不是最強的嘛……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？ 欸？",
    "voice": "vo_adv_3015003_007",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我做了什麼壞事嗎……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～？人家搞不懂，",
    "voice": "vo_adv_3015003_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼靠近的話，秀才無法集中精神吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這、這樣啊？",
    "voice": "vo_adv_3015003_009",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我只",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是想看看他是不是發燒而已……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小伊緒實在有點大膽呢。",
    "voice": "vo_adv_3015003_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n妳穿那麼低胸的衣服，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果往前彎的話，會被看光吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸、",
    "voice": "vo_adv_3015003_011",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸欸！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n被看到了嗎……！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好、好害羞……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是如果穿普通的衣服，",
    "voice": "vo_adv_3015003_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n胸部這裡很悶，實在穿不住……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是在挖苦人吧！？是刺激人吧！",
    "voice": "vo_adv_3015003_013",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n妳是想和我吵架嗎！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸欸！？\\n為什麼美咲要生氣呢？",
    "voice": "vo_adv_3015003_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我只",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是說實話而已……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然很天然！\\n",
    "voice": "vo_adv_3015003_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也就是說，是天生性感的老師……好可怕……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀哎呀美咲，先冷靜一下。",
    "voice": "vo_adv_3015003_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "以後妳就會變大的。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "總之小伊緒在旁邊的話，",
    "voice": "vo_adv_3015003_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才無法專心，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "由人家來教你也可以喔？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊！只有鈴奈來教太狡猾了！",
    "voice": "vo_adv_3015003_018",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n鈴奈",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "能教的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我也能教你！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸……那個……",
    "voice": "vo_adv_3015003_019",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n妳們都有辦法好好教嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小事、小事！",
    "voice": "vo_adv_3015003_020",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那首先由人家來！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，人家來教你九九乘法！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一乘一等於七……",
    "voice": "vo_adv_3015003_021",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一開始就錯了啦！",
    "voice": "vo_adv_3015003_022",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這、這只是個小失誤。",
    "voice": "vo_adv_3015003_023",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n七的",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "乘法那邊再調整就好了吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "調整也不行！",
    "voice": "vo_adv_3015003_024",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才",
    "voice": "vo_adv_3015003_025",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "，\\n九九乘法裡面需要注意的是七的乘法！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "從七的乘法開始就會超難的喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可以說是九九乘法裡面的大魔王。\\n如果可以打倒七的乘法，",
    "voice": "vo_adv_3015003_026",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就等於征服了九九乘法喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "明明是九九乘法，\\n可不能忘了八和九的乘法呀……",
    "voice": "vo_adv_3015003_027",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～！\\n",
    "voice": "vo_adv_3015003_028",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為八和九的乘法，實在難翻天，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家也搞不清楚啊。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那不就是不能教～",
    "voice": "vo_adv_3015003_029",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……對嘛對嘛。\\n那個",
    "voice": "vo_adv_3015003_030",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "部分是不能漏教的。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，美咲。",
    "voice": "vo_adv_3015003_031",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳在教{0}數學呀？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不是。\\n我教",
    "voice": "vo_adv_3015003_032",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "的是特別課程。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是關於戀愛教戰守則！",
    "voice": "vo_adv_3015003_033",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "聽好了？\\n只有追求是不行的。",
    "voice": "vo_adv_3015003_034",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n有時",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也要欲擒故縱！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那應該不是在學校教的東西耶……？",
    "voice": "vo_adv_3015003_035",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "誰，誰叫……",
    "voice": "vo_adv_3015003_036",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒有擅長的科目可以教別人。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，這個應該是有幫助的喲！",
    "voice": "vo_adv_3015003_037",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n對吧？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，人家也想聽感想！",
    "voice": "vo_adv_3015003_038",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，人家教得九九乘法如何呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為什麼不敢直視我！",
    "voice": "vo_adv_3015003_039",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "絕對是在說謊吧！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣啊～\\n教人果然很難呢？",
    "voice": "vo_adv_3015003_040",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……真是沒辦法。\\n今天就暫時放棄了。",
    "voice": "vo_adv_3015003_041",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這傢伙就由老師來教吧。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，果然還是那樣比較好。",
    "voice": "vo_adv_3015003_042",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，總有一天我也要教秀才～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對呀……\\n",
    "voice": "vo_adv_3015003_043",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們也要為此好好地學習才行。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
