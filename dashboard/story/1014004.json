  },
  {
    "type": "still",
    "still_id": "101400401"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "話說回來為什麼要抱著我睡呢，",
    "voice": "vo_adv_1014004_082",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我才不是你的布娃娃唷？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "掙、",
    "voice": "vo_adv_1014004_083",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "掙脫不了……",
