[
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_1014004_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這可是個簡單的推理唷，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "說起來這連推理都算不上呢。",
    "voice": "vo_adv_1014004_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這只是統計了目擊「闇影」的地區，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還有活動的模式而已。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這麼一來，",
    "voice": "vo_adv_1014004_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n便能從「闇影」出現的分布圖中，找到這個中心點。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而這裡就是……",
    "voice": "vo_adv_1014004_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能推測出「闇影」",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可能會出現的地方。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這真是累人呢。",
    "voice": "vo_adv_1014004_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n得先一個個在地圖上做標記……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後再親自到現場，",
    "voice": "vo_adv_1014004_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "把預想與現實之間的誤差給一個個補齊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然我對這類型的事",
    "voice": "vo_adv_1014004_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "頗有自信且也樂在其中，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以沒吃到什麼苦頭。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過仍舊耗費了不少時間啊。",
    "voice": "vo_adv_1014004_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓你陪我到處奔波還真是對不起呢，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "陪我一起到處訪查，",
    "voice": "vo_adv_1014004_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n又替我整理資料，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就連準備吃的也麻煩你……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還真受到你的照顧了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖說這也是你工作的一部分，",
    "voice": "vo_adv_1014004_009",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但真是幫了大忙唷。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "獨自一人的話，",
    "voice": "vo_adv_1014004_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也有觸及不到的真相呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但，",
    "voice": "vo_adv_1014004_011",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還不到鬆懈的時候。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n好戲可是現在才要上場喔，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我認為「闇影」出現的所在地，",
    "voice": "vo_adv_1014004_012",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n已經徹底揭曉了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但這畢竟尚無法證實，",
    "voice": "vo_adv_1014004_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n隨著時間的經過，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "地點搞不好也會有所變動。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "另外。",
    "voice": "vo_adv_1014004_014",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n「闇影」所誕生的地點，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n看來也並非只固定在同一個地方。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "光在城中，",
    "voice": "vo_adv_1014004_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "至少就有十幾個地方。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以以統計學的角度，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n要確定出地點",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是得相當費工夫的呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這次是用同個概念，",
    "voice": "vo_adv_1014004_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n特別將多數「闇影」的出現源頭給嚴格挑選出來……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "最後才挑了這裡來埋伏做監視唷。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若如預期「闇影」真的出現了，",
    "voice": "vo_adv_1014004_017",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就順勢捕獲。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n如果能將「闇影」的實物給捕捉到，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "進而觀察並調查的話，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "應該就能知道「闇影」究竟為何物了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "依照我的推理，",
    "voice": "vo_adv_1014004_018",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "大約幾天之內「闇影」便會現身。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以接下來",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "除了耐住性子等候之外別無他法，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若你還有其他的要事，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也可以暫時離開哦。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要你日夜都埋伏守在這，",
    "voice": "vo_adv_1014004_019",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也有些過意不去呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "況且我的手頭上也不充裕，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "無法負擔你的加班費。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且，",
    "voice": "vo_adv_1014004_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "和我不同……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你有",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等著你回家的家人對吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……助手先生？",
    "voice": "vo_adv_1014004_021",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你好歹也應個話呀，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "喂～？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": "vo_adv_1014004_022",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "難不成",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你睡著了嗎……？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然說已經是乖孩子上床睡覺的時間了，",
    "voice": "vo_adv_1014004_023",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但現在還仍在工作中耶？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呀！？",
    "voice": "vo_adv_1014004_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "510221"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼嚕、",
    "voice": "vo_adv_1014004_025",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯、",
    "voice": "vo_adv_1014004_026",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯嗯……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哇？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呃，",
    "voice": "vo_adv_1014004_027",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "睡著了……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "感覺好像做了個",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "奇妙的夢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1014004_028",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "早安……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n{0}學長。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是學長",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "叫醒我的吧。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是為什麼，",
    "voice": "vo_adv_1014004_029",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n學長，會在我的……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一年A班的教室裡呢？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長明明就是學長，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真奇怪呢？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦咦？",
    "voice": "vo_adv_1014004_030",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "的確",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我很喜歡推理之類的故事，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n也相當憧憬著故事裡的名偵探。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但在所謂的",
    "voice": "vo_adv_1014004_031",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "推理小說裡頭的名偵探，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n每一次都能將真相給看破的理由……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是因為，作者本來就知道答案唷。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "作者不過只是自己設定了謎團，",
    "voice": "vo_adv_1014004_032",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再通過了名偵探這個角色來找到答案而已。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以在這個不存在作者的現實當中，",
    "voice": "vo_adv_1014004_033",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要將真相給查個水落石出可不簡單呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，嗯，",
    "voice": "vo_adv_1014004_034",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我還是會努力試著想想看就是了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔、",
    "voice": "vo_adv_1014004_035",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那是，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "話又說回來，學長，",
    "voice": "vo_adv_1014004_036",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我記得你",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以往不是都只叫我「霧原」的嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為什麼突然直喊名字呢？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，沒什麼。",
    "voice": "vo_adv_1014004_037",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也不是說",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不願意被人這樣叫。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個總是會為了他人",
    "voice": "vo_adv_1014004_038",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而率先行動的學長，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我一直都很憧憬……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "想、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "想跟你的關係變好，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為我也是這麼想的。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊……",
    "voice": "vo_adv_1014004_039",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想起來了，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n學長",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……會來一年A班教室的理由，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我可能知道了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長。",
    "voice": "vo_adv_1014004_040",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我之前借了你推理小說，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你是專程拿來還我的對吧？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我有借給你對吧，",
    "voice": "vo_adv_1014004_041",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我很推薦的那本書。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "描寫真相的部分刻意隱晦，",
    "voice": "vo_adv_1014004_042",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是本稍微有點特別的小說……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "依自己的看法，試著推理了一下答案。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但也想要聽聽看其他人的意見，",
    "voice": "vo_adv_1014004_043",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以才推薦了學長這本小說。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來是已經讀完了呢～",
    "voice": "vo_adv_1014004_044",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然因為文筆相當艱澀，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以讀起來不怎麼輕鬆吧。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嘿嘿。",
    "voice": "vo_adv_1014004_045",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我一直都很嚮往，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能像這樣和他人一起",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "分享自己的推理呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣非常有懸疑感……",
    "voice": "vo_adv_1014004_046",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怪推理、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或是神推理，都可以一起盡情討論喔♪",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我呢，",
    "voice": "vo_adv_1014004_047",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "其實完全沒有",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能夠互相傾訴興趣的好朋友……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "自從認識了學長後，",
    "voice": "vo_adv_1014004_048",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能夠像這樣",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一起開心地說說話，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我真的非常開心。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然也想再開朗點、",
    "voice": "vo_adv_1014004_049",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n自然地",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "融入大家……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是因為",
    "voice": "vo_adv_1014004_050",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我太消極、畏縮不前嗎。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n除了和學長以外，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總是沒辦法好好地和人說上話。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1014004_051",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼一臉怪樣？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "難不成是我的推理，",
    "voice": "vo_adv_1014004_052",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哪裡出了問題嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那到底為什麼，",
    "voice": "vo_adv_1014004_053",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長要特地來到我的教室呢……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔～",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "請給點提示！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯嗯？",
    "voice": "vo_adv_1014004_054",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n就是從外頭經過時，碰巧看到我，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以才出聲打招呼……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後發現我好像睡著了，",
    "voice": "vo_adv_1014004_055",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n才會覺得不好意思叫醒我……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊哈哈。",
    "voice": "vo_adv_1014004_056",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是嗎，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "原來是這樣呢……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這就是現實呀。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "並非所有事情都會有理由，",
    "voice": "vo_adv_1014004_057",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n又或像是埋上了什麼伏筆的偵探劇呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所謂的真相，",
    "voice": "vo_adv_1014004_058",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總是些不值得一提的事呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這種事，",
    "voice": "vo_adv_1014004_059",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明明早就有深刻的體悟了呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但總讓人覺得有些寂寥，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有一點遺憾呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1014004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，",
    "voice": "vo_adv_1014004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是如同夢境一般的情景唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "醒來之後，就會全都忘光囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是由你，",
    "voice": "vo_adv_1014004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和與你有著羈絆的某人……，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n依據你們的記憶所構築而成的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯～也可以說就像是場電影一樣的東西。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是導演，",
    "voice": "vo_adv_1014004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而你們全都是演員～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣說明",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能理解嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也還沒辦法把多麼有意義的記憶給播放出來。",
    "voice": "vo_adv_1014004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，現在的你不用太在意這件事也沒關係。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "比起那個。",
    "voice": "vo_adv_1014004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次是因為想給你忠告，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以才像這樣做了干涉唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟目前我和你",
    "voice": "vo_adv_1014004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也只能在夢境之中相會……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只能像這樣，透過夢境與你接觸。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總而言之。\\n{0}，",
    "voice": "vo_adv_1014004_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最好不要跟「闇影」的事扯上關係比較好唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為那是這個世界",
    "voice": "vo_adv_1014004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "產生的錯誤。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "由強硬的「再構築」和",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "某種惡意所扭曲的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在這世界裡發生的一種矛盾唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也許接觸後，",
    "voice": "vo_adv_1014004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會有什麼不好的影響也說不定呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最壞的情況，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是連你也被這個失誤給波及……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "並受到感染，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最後演變成無法挽回的事態喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，我也會盡我所能，試著幫你抵禦看看。",
    "voice": "vo_adv_1014004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但畢竟效果有限呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒事別去招惹麻煩，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "自己衡量一下吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也請替我把這件事",
    "voice": "vo_adv_1014004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n傳達給霞吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她是位名偵探……",
    "voice": "vo_adv_1014004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖會作為工作的一環，會遇到惡意與壞事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但那也是那孩子所期盼，",
    "voice": "vo_adv_1014004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n且一直懷抱在心中的願望。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過繼續下去的話，",
    "voice": "vo_adv_1014004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "終究會過於疲憊、",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "甚至完全垮掉的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還得靠你在一旁支持著、",
    "voice": "vo_adv_1014004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "陪伴著，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n守護著她唷……{0}。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再怎麼說，",
    "voice": "vo_adv_1014004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你可是",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "霞所憧憬的人呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以就如同她所引頸期盼的，",
    "voice": "vo_adv_1014004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n讓她見見你最讓她著迷的那一面吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼嚕、",
    "voice": "vo_adv_1014004_078",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯、",
    "voice": "vo_adv_1014004_079",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯唔……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我",
    "voice": "vo_adv_1014004_080",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "難道睡著了嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不敢相信！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明明就還在監視中呢！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": "vo_adv_1014004_081",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生也睡著了！",
