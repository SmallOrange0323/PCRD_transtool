  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼，",
    "voice": "vo_adv_1014004_086",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "太好了……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n看起來，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「闇影」還沒有出現過。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「闇影」出現時總會瀰漫著某種獨特的魔力，",
    "voice": "vo_adv_1014004_087",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不如說，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那東西整個就是怪異魔力的集合體呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只要有出現，",
    "voice": "vo_adv_1014004_088",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或是有所行動便一定會留下痕跡。",
