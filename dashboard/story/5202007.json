    "words": "在創造出專屬於自己的歌曲後，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就會將那首歌寫成譜。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而曾創造出自己歌曲的唱喚士，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "往後，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n只要唱出他人譜寫的歌曲，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就能召喚出別的精靈。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_5202007_053",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就是那邊的屋子！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "覺得好開心，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n竟然能像這樣介紹唱喚士夥伴給人認識。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "哎呀，",
    "voice": "vo_adv_5202007_054",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這個氣息是──",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "妳",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不是之前來過的唱喚士嘛。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好久不見了，",
    "voice": "vo_adv_5202007_055",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "婆婆。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "以前您不只給了我樂譜，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還告訴我其他唱喚士的情報，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "非常謝謝您。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "其實我今天",
    "voice": "vo_adv_5202007_056",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "帶來了同為唱喚士的夥伴！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蘭法小姐，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請過來吧！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "哎呀，",
    "voice": "vo_adv_5202007_057",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "原來是這樣嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n我瞧瞧……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這可真是。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "是嗎是嗎，",
    "voice": "vo_adv_5202007_058",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n妳們",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "終於見到面了嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_5202007_059",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n請問，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是什麼意思？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "還會是什麼意思，",
    "voice": "vo_adv_5202007_060",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n就是我之前跟妳提的",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "年輕唱喚士啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "那邊的她，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "正是那位唱喚士。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "紡希、雪菲、千歌",
    "words": "什麼！？",
    "voice": "vo_adv_5202007_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是蘭法小姐",
    "voice": "vo_adv_5202007_062",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在從千歌小姐那裡聽說前，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不是都不知道",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唱喚士的存在嗎……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "啊……",
    "voice": "vo_adv_5202007_063",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "這個……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "那個……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "在來到「這個世界」後",
    "voice": "vo_adv_5202007_064",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "沒多久……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n我為了尋找安靜的地方，",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "而四處",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "遊蕩……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "雖然老婆婆",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "有向我搭話，",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "那個……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "我下意識地……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "下意識地",
    "voice": "vo_adv_5202007_065",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "逃走了……？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "唔……",
    "voice": "vo_adv_5202007_066",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請等一下。",
    "voice": "vo_adv_5202007_067",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這難道是說……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蘭法小姐現在，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n其實擁有樂譜，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只是不知道",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼使用？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "這",
    "voice": "vo_adv_5202007_068",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "個……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "是的。",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……我明白了。",
    "voice": "vo_adv_5202007_069",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天就來場課外教學，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟我一起",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "學習樂譜方面的事吧。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "順便也把我的樂譜交給妳。",
    "voice": "vo_adv_5202007_070",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我有帶著空白的譜紙和筆，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "馬上就開始進行吧。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好、",
    "voice": "vo_adv_5202007_071",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好的……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n千歌老師……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "就是說啊。",
    "voice": "vo_adv_5202007_072",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "雖然我聽聲音",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "就知道她是唱喚士，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "但她實在太沉默寡言了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我也很傷腦筋。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "用年輕人的話來說，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "就是「陰沉角」",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "結果那時候，",
    "voice": "vo_adv_5202007_073",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我就只有把樂譜塞給她……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不過，看來她們彼此",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "都找到好夥伴了呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過去尋尋覓覓的夥伴，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "其實就近在身邊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n感受到這段緣分是如此不可思議的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌與蘭法。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在峽谷中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這兩名唱喚士所交織出的歌曲",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n優美地迴盪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "520200701"
  }
]
