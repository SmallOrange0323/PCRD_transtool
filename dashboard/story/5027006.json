    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……動員整個公會",
    "voice": "vo_adv_5027006_077",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還飄洋過海來這裡，最後卻只找到",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "連龍也不是的奇怪蜥蜴，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還有這稱不上是遺跡的少少殘骸。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "根本就是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "賠了夫人又折兵嘛？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是啊……",
    "voice": "vo_adv_5027006_078",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還暴露給【王宮騎士團（NIGHTMARE）】不少情報，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n而且開拓工作的進展也完全不如預期，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "別說拿不到報酬，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n根本是大虧損～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以我們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只好暫時停薪囉☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "太……",
    "voice": "vo_adv_5027006_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "可惡啦～！！\\n太……太可惡啦～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩位少女痛哭的聲音在密林中迴響著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就這樣，【龍族巢穴】在艾爾皮斯島的探索\\n暫時落幕了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這就是……",
    "voice": "vo_adv_5027006_080",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "正義必勝",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
