  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]就算是常常被女生包圍的你，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]應該也有「其實我最喜歡這個女生」",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這種內心的想法吧？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]說吧，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]你最喜歡的其實是誰？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124404_001",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]惡",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]、靈",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]、退",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]、散！！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124404_002",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]喔、",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]喔……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]她確實身材很好呢。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]身材方面是啦。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]不過，我說你啊，那個……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]不，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]沒什麼。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124404_003",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]巨乳！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]美腿！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]真讓人受不了對吧──！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]可是啊──",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我要是很陽光地跟她搭話，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]她就會露出一副世界末日的表情……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]好受傷啊……",
    "voice": null,
    "unit_id": 2415
  }
]
