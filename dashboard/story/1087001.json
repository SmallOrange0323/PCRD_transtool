  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個給你！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還有這個，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "跟這個！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣就差不多了……",
    "voice": "vo_adv_1087001_036",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有騎士先生你在實在太好了～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果我是自己一個人來的話，一定吃不完的～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊啊……",
    "voice": "vo_adv_1087001_037",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼辦，騎士先生。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我的兩隻手都空不出來。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣下去的話，兩個人都吃不了呀，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你！",
    "voice": "vo_adv_1087001_038",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那我也來餵騎士先生吃！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n好～",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "兩個人互相餵對方吃吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來喔，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～！",
    "voice": "vo_adv_1087001_039",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊呣，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嚼嚼……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯～！",
    "voice": "vo_adv_1087001_040",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯呼呼～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真好吃～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好吃嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了！",
    "voice": "vo_adv_1087001_041",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還要吃嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那就再一口，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1087001_042",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "竟然從去年我幫助過的人們那裡，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n收下這麼多的謝禮了呀。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然我不是為了什麼謝禮才會去幫助人的，",
    "voice": "vo_adv_1087001_043",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但還是很",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "開心呢……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今年我也",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要讓更多人",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "露出笑容唷～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就先從騎士先生開始吧！",
    "voice": "vo_adv_1087001_044",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "下一個想吃什麼？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n蘋果糖？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "烤花枝？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來吧，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "給你挑給你挑！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}和日和兩人，\\n一塊開心地享用著從眾多人手中收下的各種美食。",
