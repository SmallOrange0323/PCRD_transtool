    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1087001_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒想到竟然能夠遇到騎士先生，",
