    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總覺得像佩可小姐一樣呢！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在大家一起去看了新年的日出之後，",
    "voice": "vo_adv_1087001_002",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我直到昨天都一～直",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n在幫忙動物苑的新年會，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可真累壞了呀～",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今天也是收拾到了剛剛才結束，",
