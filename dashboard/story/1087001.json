  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在新年首賣的鬧區上，\\n{0}遇見了日和。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是騎士先生耶～！",
