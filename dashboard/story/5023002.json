[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧插班進入聖德蕾莎女學院的隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說，",
    "voice": "vo_adv_5023002_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這到底是怎麼回事啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "本想說午休到了，",
    "voice": "vo_adv_5023002_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n還特地跑到國中部來",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "關心她的狀況？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "結果她竟然不在。",
    "voice": "vo_adv_5023002_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n根本人去樓空嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～♪",
    "voice": "vo_adv_5023002_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小碧～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要不要一起去吃午飯？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_5023002_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "只有{0}學長和克蘿依學姐？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n小碧跑到哪裡去了？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我才想問呢！",
    "voice": "vo_adv_5023002_005",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉唷～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "到底是怎麼回事啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種時候就要現場打聽大作戰。",
    "voice": "vo_adv_5023002_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那邊那位路過的女孩～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n妳有看到小碧嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "咦？　",
    "voice": "vo_adv_5023002_007",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "妳說的是今天插班過來的人吧……？",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n妳找她的話，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "鐘一響她就用很驚人的速度",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "衝出教室了……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "謝謝妳～",
    "voice": "vo_adv_5023002_008",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為了感謝妳，妳可以把這個招呼語拿去用喔！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～♪　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好，跟著我一起，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～♪",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "切、",
    "voice": "vo_adv_5023002_009",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "切嚕～……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "在國中部也要不斷推廣喔～♪",
    "voice": "vo_adv_5023002_010",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "……唉。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐，狀況似乎是如此。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n害我白跑一趟，真沒勁～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳切換開關也太快了吧？",
    "voice": "vo_adv_5023002_011",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然這樣……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那她到底跑去哪裡了？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯。",
    "voice": "vo_adv_5023002_012",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我猜我應該知道。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "優妮學姐，",
    "voice": "vo_adv_5023002_013",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳怎麼那麼自然地站在這裡。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且妳也來得太晚了吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不、",
    "voice": "vo_adv_5023002_014",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是因為那個，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不可抗力的因素。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我的研究室，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也就是『象牙之塔』，在舊校舍那邊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "離被統稱為新校舍的腹地有些距離。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "藉口就不必了。",
    "voice": "vo_adv_5023002_015",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不管那個了，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n妳真的知道小碧去了哪裡嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對學姐的態度還真差呢，",
    "voice": "vo_adv_5023002_016",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這幾位學妹",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我大概猜得出她在哪裡。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不過這個比較接近",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果是我的話會怎麼做，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這種接近自我分析的推論。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然這樣，我們就馬上過去吧。",
    "voice": "vo_adv_5023002_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我現在肚子餓得不得了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊！",
    "voice": "vo_adv_5023002_018",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n什麼啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不需要道謝啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這是我自己決定要做的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是這麼一回事。{0}學弟。",
    "voice": "vo_adv_5023002_019",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n照顧你的好友碧",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就等同於",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n和你和睦相處是一樣的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這同時也是領取獎學金的條件，",
    "voice": "vo_adv_5023002_020",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也就是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "達成和你好好相處這個課題。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好朋友社原本就是",
    "voice": "vo_adv_5023002_021",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n為了獎學金而組成的一個",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "充滿算計的公會。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n而現在已經如同字面上的意義，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "變成感情和睦的三人組了♪",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_5023002_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒那回事。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……唉。",
    "voice": "vo_adv_5023002_023",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "打擾了～",
    "voice": "vo_adv_5023002_024",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "噫！？　",
    "voice": "vo_adv_5023002_025",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "克克克、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "克蘿依！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n{0}、琪愛兒、還有優妮你們……！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們找妳找了好久呢～",
    "voice": "vo_adv_5023002_026",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小碧～♪",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5023002_027",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "果然是在沒什麼人在的地方。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "怎麼樣啊？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "跟我按照行動心理學所分析出來的結果一樣吧！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": "vo_adv_5023002_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這已經是第五個地點了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n根本只是單純的地毯式搜索而已。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "各、",
    "voice": "vo_adv_5023002_029",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "各位……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為什麼會？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那是我要說的話。",
    "voice": "vo_adv_5023002_030",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳為什麼會待在這種空教室裡面呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "找妳找得超辛苦的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……",
    "voice": "vo_adv_5023002_031",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不知道該跟班上的人",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說些什麼才好……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自我介紹也",
    "voice": "vo_adv_5023002_032",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "做得不好……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "課程也聽不太懂，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我真的不知道到底該怎麼辦才好……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……我說妳啊。",
    "voice": "vo_adv_5023002_033",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好了～克蘿依學姐，",
    "voice": "vo_adv_5023002_034",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這個等一下再說",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們先吃午飯好不好？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "確實。",
    "voice": "vo_adv_5023002_035",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n雖然我精確地分析發揮了效果",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "得以及早找到她，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但畢竟時間還是有限。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要聊的話也可以邊吃邊聊吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "still",
    "still_id": "502300201"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這麼說起來",
    "voice": "vo_adv_5023002_036",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們好朋友社的成員",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "難得一起吃午餐耶？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "仔細想想，",
    "voice": "vo_adv_5023002_037",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好像的確是如此。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n雖然我們",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "經常混在一起。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": "vo_adv_5023002_038",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "放學後的公會活動就算了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n連午休也要經常聚在一起",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "吃飯的話實在太麻煩了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "會嗎？",
    "voice": "vo_adv_5023002_039",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒我很喜歡像這樣",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "跟大家一起吃飯呢～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔！",
    "voice": "vo_adv_5023002_040",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒那種",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "賺取好感度的手法也太露骨了吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n身為學姐的我也不能輸給妳……！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優妮也想要跟大家一起吃飯呢～",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗚～",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不對，那種的就不必了。",
    "voice": "vo_adv_5023002_041",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼連你也來搶著賺取好感度啊。",
    "voice": "vo_adv_5023002_042",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你想變可愛嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n發現帥氣路線對你來說太勉強了嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哼～",
    "voice": "vo_adv_5023002_043",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這樣啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……我也，那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是不開心。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該說，",
    "voice": "vo_adv_5023002_044",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也不是特別……？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n想聚在一起吃飯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只是如果妳們認真要這樣的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我個人是覺得",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，也沒甚麼關係。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳聽到了嗎？優妮學姐！",
    "voice": "vo_adv_5023002_045",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n克蘿依學姐好狡猾！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "她根本是個狡猾的集合體！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可惡，",
    "voice": "vo_adv_5023002_046",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我錯看妳了克蘿依……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我一直深信妳不是那種",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會輕易捨棄冰山美人的矜持，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n急功好利的女人……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不知羞恥，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳這個毒婦！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喂，根本不知所云啊？",
    "voice": "vo_adv_5023002_047",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼我只不過說了句，\\n一起吃飯也可以",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就要遭受這種異樣的否定啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n能不能不要再搞這種，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "克蘿依不會說這種話的解釋戰爭。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊哈！　",
    "voice": "vo_adv_5023002_048",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大家一起吃午飯真的很開心耶～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真好～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "越來越切嚕了呢～？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呃，就算妳這樣含混著要我同意也不行。",
    "voice": "vo_adv_5023002_049",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且那個謎樣單字，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然妳很拼命想要讓它流行起來，不過那是不可能的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n未來永遠都不會有人用它的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": "vo_adv_5023002_050",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為什麼妳們幾位",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總是待在一起呢？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n明明大家都是不同學年……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒有啦，",
    "voice": "vo_adv_5023002_051",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們也沒有總是待在一起。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n的確我們常常待在一起，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為我們幾個在德蕾女高也是相當異樣的存在。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我……",
    "voice": "vo_adv_5023002_052",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很羨慕妳們幾個。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我也想和妳們一樣",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "跟某個人……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "變得感情很好。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然我覺得把我們當成參考可能不是很恰當。",
    "voice": "vo_adv_5023002_053",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "剛剛，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳說妳不知道",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "跟班上的人要聊什麼對不對？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是……",
    "voice": "vo_adv_5023002_054",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是啊。",
    "voice": null,
    "unit_id": 110711
  },
  {
