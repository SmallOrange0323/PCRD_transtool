[
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束了長年的海外生活，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n久違回國的真璃",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了問候而前往祖母的家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "呃……",
    "voice": "vo_adv_5204069_000",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "在這個轉角轉彎……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n在這條路直走……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "咦？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n又走回剛才那條路了……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "祖母的家是在哪裡來著……",
    "voice": "vo_adv_5204069_001",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "完全迷路了啊。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "話說",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "地圖是要怎麼看……！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n……唔唔唔。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖然平常總是被敷衍過去，",
    "voice": "vo_adv_5204069_002",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但今天絕對",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要讓對方好好聽我抱怨才行。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n寺小姐、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "寺小姐！！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "呵呵，",
    "voice": "vo_adv_5204069_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "深月，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "妳好♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊，",
    "voice": "vo_adv_5204069_004",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "剛剛那是祖母的聲音！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……而且，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "她說話的對象是……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「妳好♪」",
    "voice": "vo_adv_5204069_005",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼啦……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "寺小姐，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說啊，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n請妳不要",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "跟鄰居到處散播些",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "隨便亂說的話。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼肚臍上抹鹽能治針眼，",
    "voice": "vo_adv_5204069_006",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n頭痛的話",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在太陽穴貼梅子就萬無一失♪",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之類的，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "全都是胡說八道！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是出什麼意外不就糟糕了嗎。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "呵呵，",
    "voice": "vo_adv_5204069_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "這不是胡說八道，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "而是老奶奶的智慧啊♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "\\n比起那個，深月，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "妳比以往還更氣鼓鼓的呢，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "\\n是聯誼派對",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "進行得不順利嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……少囉嗦……",
    "voice": "vo_adv_5204069_008",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我現在沒在講那件事吧！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不對！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不希望妳胡說八道智慧的",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "犧牲者再增加了！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我可不准妳說忘了",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "10年前暴風雨之夜的事啊！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "嗯，",
    "voice": "vo_adv_5204069_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "我當然記得喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "\\n10年前",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "被猛烈的暴風雨淋到後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "深月發了高燒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "\\n所以奶奶我才很擔心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "就幫妳圍上了吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯……",
    "voice": "vo_adv_5204069_010",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n在我的脖子",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "圍上了蔥。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因發燒而做了惡夢的我，",
    "voice": "vo_adv_5204069_011",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "鼻子還被蔥的氣味侵襲……！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為那樣，自那以後",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我都變得沒辦法吃蔥了啊！！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "撇開個人的怨恨不談，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我有義務阻止災害擴大。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "但是，",
    "voice": "vo_adv_5204069_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "妳退燒了吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唔，",
    "voice": "vo_adv_5204069_013",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "退",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是退了啦……！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但就只是我的免疫力戰勝了感冒而已！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n蔥奏效了這種不科學的事，我可……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n研究室叫我過去了……！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳的運氣還真好呢，",
    "voice": "vo_adv_5204069_014",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天就先放過妳吧。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但相對地，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我很快又會再來的，早早認命吧！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "呵呵呵♪",
    "voice": "vo_adv_5204069_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "寺婆婆",
    "words": "\\n好──♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……唔？",
    "voice": "vo_adv_5204069_016",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊……",
    "voice": "vo_adv_5204069_017",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "妳、",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "妳好。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……？",
    "voice": "vo_adv_5204069_018",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳好。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……我的臉上",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有什麼嗎……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "不好意思，",
    "voice": "vo_adv_5204069_019",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "我",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "是寺祖母的孫女，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "我叫真璃。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "那個……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "妳是",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "祖母的鄰居",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "深月小姐",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "吧。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5204069_020",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是真璃嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……真是長大了呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好久不見……",
    "voice": "vo_adv_5204069_021",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算這麼說，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳或許也不記得吧。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳還小的時候，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也有陪妳一起玩過喔。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳現在",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是住在國外之類的嗎？",
    "voice": null,
