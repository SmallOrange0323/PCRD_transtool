[
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……嗯。",
    "voice": "vo_adv_5201083_000",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "長老，",
    "voice": "vo_adv_5201083_001",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "關於我之前提交的",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "世界觀設定──",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "──我現在正在看。",
    "voice": "vo_adv_5201083_002",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n拉基庫瑪爾‧拉基尼卡東。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是這樣啊。",
    "voice": "vo_adv_5201083_003",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "啊",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "啊",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "那套裝束，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n因為是精靈族流傳的儀式中",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "所使用的服飾，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n所以我特別採用了與大自然",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "融為一體的設計。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "嗯，",
    "voice": "vo_adv_5201083_004",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "可以說很出色。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "不過……",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "有什麼讓您在意的點嗎？",
    "voice": "vo_adv_5201083_005",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "…………",
    "voice": "vo_adv_5201083_006",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "棗宙……",
    "voice": "vo_adv_5201083_007",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "嚮導老君。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "在怪才齊聚的七冠中",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "可說是最老成的人。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "他的觀點總是",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "能放眼於",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "擺脫世俗的某些事物。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "那麼，",
    "voice": "vo_adv_5201083_008",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這次您會看見什麼，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "又會引導什麼呢……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……我在擔心設計是否會太大膽。",
    "voice": "vo_adv_5201083_009",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "…………",
    "voice": "vo_adv_5201083_010",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "不，",
    "voice": "vo_adv_5201083_011",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "絕無此事。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我認為所謂的裝束，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "與現代衣服",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n光是從設計理念來看",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就有根本上的不同──",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "原來如此。",
    "voice": "vo_adv_5201083_012",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "但是，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "然而，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "這個要……",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "蘿穿……",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……話說回來，",
    "voice": "vo_adv_5201083_013",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n世界觀之類的設定",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "雖是由我負責，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n但這座精靈族之村，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是長老親自打造的吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "長老，難不成",
    "voice": "vo_adv_5201083_014",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "您想讓令千金",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "擔任村落的巫女嗎？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "嗯。",
    "voice": "vo_adv_5201083_015",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n也並非沒有變成那樣的可能。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n畢竟未來是無法肯定的。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "長老，",
    "voice": "vo_adv_5201083_016",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "請別打算蒙混過去。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "您是以令千金為前提",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "在考量的對吧？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……用這個設計就行了。",
    "voice": "vo_adv_5201083_017",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "很感謝",
    "voice": "vo_adv_5201083_018",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "您的認可。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "不過第二張再讓我考慮一下吧。",
    "voice": "vo_adv_5201083_019",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "這樣會感冒的。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……好的。",
    "voice": "vo_adv_5201083_020",
    "unit_id": 107331
  }
]
