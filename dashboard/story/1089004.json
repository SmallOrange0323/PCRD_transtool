[
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "勸退了追兵的怜與{0}，\\n回到【破曉之星】的公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總算是回來了。",
    "voice": "vo_adv_1089004_000",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是門沒被弄壞就好……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我去泡茶吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你坐著等一下。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": "vo_adv_1089004_001",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "明明在房間裡，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼感覺特別亮。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到底這個光……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是哪裡……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來的──",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "元旦的隔天。{0}\\n接到了怜打來的電話，來到車站前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喂──",
    "voice": "vo_adv_1089004_002",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看這邊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這裡喔。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "上這輛車。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不想引人注意，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "快點。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……開車吧。",
    "voice": "vo_adv_1089004_003",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "知道了。",
    "voice": "vo_adv_1089004_004",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "108900401"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗨。",
    "voice": "vo_adv_1089004_005",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉，突然叫你出來。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n當我在思考正好有空不知道做什麼時，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就想到了你。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你過得好嗎？",
    "voice": "vo_adv_1089004_006",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "年假還愉快嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……？",
    "voice": "vo_adv_1089004_007",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看你一臉訝異。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……喔喔，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這身打扮嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "直到剛才我還在老家的宴席陪場呢。",
    "voice": "vo_adv_1089004_008",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為不想浪費時間，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就直接穿著過來了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_1089004_009",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……真是奇妙。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "同樣一句話在宴席上，\\n明明已經聽到厭煩，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都不想再聽了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但聽到你這麼說，",
    "voice": "vo_adv_1089004_010",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我卻不覺得討厭。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也不枉費我穿這身衣服了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真，",
    "voice": "vo_adv_1089004_011",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也真是……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這樣說就太輕浮了不是嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過如果那是真心話就好……",
    "voice": "vo_adv_1089004_012",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好、",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好啦。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用對我比讚啦！",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "言歸正傳吧。",
    "voice": "vo_adv_1089004_013",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你的新年，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "過得怎麼樣？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n應該不會整天都在睡吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……難道我說中了？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你還真懶散呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不過，",
    "voice": "vo_adv_1089004_014",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能這樣自甘墮落也很讓人羨慕。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我可是",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "每天都過得像招攬客人的熊貓一樣啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日復一日，每天都在宴客。",
    "voice": "vo_adv_1089004_015",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "陪那些政界財界的大人物……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n感覺快窒息了，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一點活著的實感都沒有。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說起那些傢伙，",
    "voice": "vo_adv_1089004_016",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過是仗著家族的權勢對人頤指氣使，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n再把別人的血汗結晶說成自己的成果，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "掛在嘴邊自誇的強盜……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……但說這些話的我，",
    "voice": "vo_adv_1089004_017",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "司機是父親雇用，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這輛車也是家裡的……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和他們根本是一丘之貉……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1089004_018",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對不起。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我明明不是為了抱怨",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "才來見你的……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真丟臉呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能去哪裡嗎……",
    "voice": "vo_adv_1089004_019",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也好。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得的機會，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就試試看吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "找個遠一點的……",
    "voice": "vo_adv_1089004_020",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "麻煩到海邊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "知道了。",
    "voice": "vo_adv_1089004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1089004_022",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "愉快的車程要開始囉。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這條路是……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以稍微閒晃一下的樣子。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想吃點甜的東西呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看得到海了。",
    "voice": "vo_adv_1089004_023",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n海平線一望無際呢……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "景觀真美。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，",
    "voice": "vo_adv_1089004_024",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "隨便找地方停下來，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們去海邊玩吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不好意思，",
    "voice": "vo_adv_1089004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "怜小姐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n時間已經差不多了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "108900402"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1089004_026",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這樣",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不客氣……",
    "voice": "vo_adv_1089004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "您與朋友的時間，",
    "voice": null,
