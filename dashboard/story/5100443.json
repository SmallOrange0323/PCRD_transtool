  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真步小姐！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n要是從一開始就太努力，很快就會累了呢。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就跟爬樹一樣！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喔！",
    "voice": "vo_adv_5100443_002",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳還真是說了一番好話呢，",
    "voice": null,
    "unit_id": 2113
  },
  {
