[
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔……",
    "voice": "vo_adv_5110308_000",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這傢伙的等級",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不同於以往的魔物呢……！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是說啊，",
    "voice": "vo_adv_5110308_001",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且它看似沒有想要放過我們的樣子。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說起來，",
    "voice": "vo_adv_5110308_002",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "它原本就不是可以輕易擺脫的對手。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我說啊。",
    "voice": "vo_adv_5110308_003",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "嘉夜、望",
    "words": "駁回。",
    "voice": "vo_adv_5110308_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我、",
    "voice": "vo_adv_5110308_005",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我什麼都還沒說耶！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不用妳說，我們也都知道。",
    "voice": "vo_adv_5110308_006",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "矛依未，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳打算自己一個人迎戰對吧？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "然後，",
    "voice": "vo_adv_5110308_007",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓我們可以趁機脫逃是吧？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是個蠢蛋……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔……",
    "voice": "vo_adv_5110308_008",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可、",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是……",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要不然這下該怎麼辦？",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很簡單啊。",
    "voice": "vo_adv_5110308_009",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們一起擊倒他，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣就行了。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖說是臨時湊成的，",
    "voice": "vo_adv_5110308_010",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我們早已像支小隊了吧？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳要信任",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": "vo_adv_5110308_011",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我差點就做出了與壞蛋作風不符的差勁選擇。",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "望！",
    "voice": "vo_adv_5110308_012",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘉夜！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "跟著我這個大壞蛋諾維姆大人一起上吧！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n讓膽敢阻擋在我們前面的傢伙，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在地獄裡悔不當初！",
    "voice": null,
    "unit_id": 125014
  }
]
