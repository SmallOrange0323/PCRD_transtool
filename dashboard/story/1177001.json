    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "昨天的惡作劇還真好玩呀～♪",
    "voice": "vo_adv_1177001_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n大叔",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "都已經是大人了，還被蟲蟲嚇個半死！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n今天該怎麼惡作劇呢～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那個小孩的",
