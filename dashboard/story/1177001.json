    "type": "dialogue",
    "name": "少年幽靈",
    "words": "\\n還是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年幽靈",
    "words": "要像那個大叔一樣會大聲尖叫的才好玩！",
