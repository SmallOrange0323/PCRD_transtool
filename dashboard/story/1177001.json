[
  {
    "type": "background",
    "bg_id": "505034"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "香織在瀰漫著濃厚萬聖節氣氛的街道上散步，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看起來很愉快地向前走著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊，",
    "voice": "vo_adv_1177001_000",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗨",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呵～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_1177001_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你這聲招呼真有活力～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "看你一臉好奇的樣子，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……我為什麼",
    "voice": "vo_adv_1177001_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "穿著萬聖節拯救隊的制服？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為這件衣服很有萬聖節的風格，也很可愛呀～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "而且",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也會讓人提起幹勁呢～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然萬聖節期間，",
    "voice": "vo_adv_1177001_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n【哞哞自衛隊】的工作我暫時休假……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n但如果",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有人遇到困難",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也不能放著不管～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以",
    "voice": "vo_adv_1177001_004",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我為了守護萬聖節，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n才穿著這身制服",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "巡邏呀～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你有空的話",
    "voice": "vo_adv_1177001_005",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}也跟我一起巡邏吧～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一邊欣賞萬聖節的裝飾",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一邊散步也滿好玩的……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚、",
    "voice": "vo_adv_1177001_006",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚哇啊啊啊啊啊啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……剛才的尖叫聲",
    "voice": "vo_adv_1177001_007",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是從對面的店裡傳來的──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "發生什麼事了嗎──！？",
    "voice": "vo_adv_1177001_008",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "蟲、",
    "voice": "vo_adv_1177001_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "蟲……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "有蟲……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～？",
    "voice": "vo_adv_1177001_010",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "蟲？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n……啊，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說放在桌上的這個嗎～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然做得很像，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這是玩具啦～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是玩具……？",
    "voice": "vo_adv_1177001_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "呼，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嚇我一跳……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "還好不是什麼危險的事件～♪",
    "voice": "vo_adv_1177001_012",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽到好大聲的尖叫，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚇了我超大一跳呢～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "唉呀唉呀，",
    "voice": "vo_adv_1177001_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真難為情……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我實在太怕蟲子了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過是誰搞這種惡作劇呢……",
    "voice": "vo_adv_1177001_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……該不會",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真的是幽靈在搗蛋？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "幽靈？",
    "voice": "vo_adv_1177001_015",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "最近",
    "voice": "vo_adv_1177001_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "鎮上到處都有店家",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "因為被惡作劇而引起騷動……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n被惡作劇的店家老闆",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "都一致這麼認為啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是「幽靈在搗蛋」呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那些老闆都說",
    "voice": "vo_adv_1177001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "他們看到了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n惡作劇的小孩好像在空中飄或穿過了牆壁。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但是",
    "voice": "vo_adv_1177001_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "按常理講，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不可能會有什麼幽靈吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "所以我是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不相信那種事啦……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我猜那些可能，",
    "voice": "vo_adv_1177001_019",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n真的是幽靈搞的鬼喔～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "之前",
    "voice": "vo_adv_1177001_020",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "發生一些事的時候",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我有聽他說過……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n在萬聖節時",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "現實與",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "靈界會變得比較接近。",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很多幽靈會受到影響而跑出來～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以一定是",
    "voice": "vo_adv_1177001_021",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "喜歡惡作劇的幽靈們，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n在到處",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "惡作劇吧～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "既然這樣",
    "voice": "vo_adv_1177001_022",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就該萬聖節拯救隊出場了～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "會守護萬聖節的～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……",
    "voice": "vo_adv_1177001_023",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你問要怎麼防止幽靈惡作劇？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我現在來想辦法～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯……",
    "voice": "vo_adv_1177001_024",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "該怎麼做呢……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……啊，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我想到好點子啦──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們",
    "voice": "vo_adv_1177001_025",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "來做風獅爺吧！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對呀，",
    "voice": "vo_adv_1177001_026",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "風獅爺！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在我的故鄉那裡，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "人們為了驅邪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "會在家裡擺風獅爺喔～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
