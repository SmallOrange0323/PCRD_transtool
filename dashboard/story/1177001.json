    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年幽靈",
    "words": "你看得見我嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年幽靈",
    "words": "\\n挺厲害的嘛！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年幽靈",
    "words": "所以",
