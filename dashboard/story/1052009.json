  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在參加玩偶裝舞會後的數日，\\n莉瑪勤奮地進行伐木工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿～咿☆",
    "voice": "vo_adv_1052009_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呼～",
    "voice": "vo_adv_1052009_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天大概這樣就行了吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n最近一直去蘭德索爾",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以沒什麼在伐木，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "得多砍點木頭才行。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也謝謝你來幫我忙。",
    "voice": "vo_adv_1052009_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真～",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "的幫大忙了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？　",
    "voice": "vo_adv_1052009_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是你自己帶我出來的，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以幫忙是應該的？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你不需要在意那種事啊！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我才應該",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "和你\\n道謝才行呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然發生了點意料之外的事，",
    "voice": "vo_adv_1052009_004",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但我真的很開心。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然很想再稍微多待一些，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n可是我也不能",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要求太多呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要再去就行了嗎？　",
    "voice": "vo_adv_1052009_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我記得",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要使用變身蘋果，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n應該就能夠去蘭德索爾了，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但一個人去好可怕。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟不曉得會發生什麼事啊。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你要再陪我一起去？",
    "voice": "vo_adv_1052009_006",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你真的",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是個很溫柔的人呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有你那份溫柔就足夠了。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你說不需要客氣",
    "voice": "vo_adv_1052009_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你為什麼要為我做到這種程度？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為我",
    "voice": "vo_adv_1052009_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看起來很開心？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓你稍微",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "聽聽我的任性要求",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也可以嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你前陣子送來的信件裡，",
    "voice": "vo_adv_1052009_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n夾了舞台劇的傳單。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很想去",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看看那個～",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "才怪",
    "voice": "vo_adv_1052009_010",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我不應該",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要求這麼多吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你真的",
    "voice": "vo_adv_1052009_011",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要陪我一起去嗎？　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不會給你添麻煩？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼，",
    "voice": "vo_adv_1052009_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我就接受",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你的好意",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可以嗎……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿嘿。",
    "voice": "vo_adv_1052009_013",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等一下真的能夠看到舞台劇對吧。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好像在作夢！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天上演的戲劇是",
    "voice": "vo_adv_1052009_014",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "身分懸殊的悲戀！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n一對男女愛上了彼此，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "然後跨越障礙，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "接著",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最後是……",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯，",
    "voice": "vo_adv_1052009_015",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我非～～",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "常期待喔。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為至今只能在書上讀到的東西，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "居然有機會能親眼看見呀！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_1052009_016",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不好不好。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "差不多要開始了，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要安靜點才行呢！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_1052009_017",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對不起！　",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等一下就要看劇了，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n所以不需要我的解說吧！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n如果你親眼觀賞後，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能覺得開心的話我會很高興的。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊～！　",
    "voice": "vo_adv_1052009_018",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的在親眼觀賞舞台劇呢！　",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "當然舞台劇也讓人超開心的，",
    "voice": "vo_adv_1052009_019",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但能在這麼近的距離",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n看到許多人享受戲劇的樣子，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這也令人感到幸福呢！　",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不曉得{0}",
    "voice": "vo_adv_1052009_020",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是不是也有好好享受呢……",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了～",
    "voice": "vo_adv_1052009_021",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "他看舞台劇看得非常投入呢。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然很擔心自己是不是勉強他來了，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但他似乎很享受呢！　",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "哦哦哦！！",
    "voice": "vo_adv_1052009_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n還真是沒內容的故事耶～！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "他們到底要到什麼時候才會在一起啦！　",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "啊――！？",
    "voice": null,
    "unit_id": 911
  },
  {
