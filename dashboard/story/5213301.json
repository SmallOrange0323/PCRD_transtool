  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "薇歐莉特公主──",
    "voice": "vo_adv_5213301_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n妳那副模樣究竟是……！？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁想必覺醒了如汪洋般，",
    "voice": "vo_adv_5213301_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "包羅萬象的慈悲之心吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此景此情，恰如親見神佛天降，令人心生敬畏。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "從內心深處湧現出的這份情感，",
    "voice": "vo_adv_5213301_003",
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "正是慈愛。",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "無論發生什麼事，",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我都要守護",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "國家與子民──",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而這……",
    "voice": null,
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "正是，",
    "voice": "vo_adv_5213301_004",
    "unit_id": 138012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我的驕傲！",
    "voice": null,
    "unit_id": 138012
  }
