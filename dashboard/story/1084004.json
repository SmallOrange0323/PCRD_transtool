  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "表演結束後的千歌、與{0}兩人，正沉浸在落幕後的餘韻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總覺得",
    "voice": "vo_adv_1084004_000",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "手還是會發抖。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過這應該是，",
    "voice": "vo_adv_1084004_001",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感受到觀眾的熱情……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以喜悅地顫抖了，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒事的喔。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個。",
    "voice": "vo_adv_1084004_002",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "表演，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "覺得如何……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很棒的表演，",
    "voice": "vo_adv_1084004_003",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "竟然那麼的誇獎我，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n雖然高興，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "卻覺得有點害羞呢。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天的表演，",
    "voice": "vo_adv_1084004_004",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "比起以往達成目標有更高的成就感而很滿足呢。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就像能清楚感受到，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "自己有所成長的感覺吧……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1084004_005",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　怎麼了呢，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼感覺十分耀眼……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呀！？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "歡迎光臨――",
    "voice": "vo_adv_1084004_006",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊、{0}！",
    "voice": "vo_adv_1084004_007",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　來得正好啊。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n其實有件事情要拜託你……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能看一下，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這張傳單嗎？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是有關於聖歌隊的演唱會，",
    "voice": "vo_adv_1084004_008",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果可以的話，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聖誕節",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要不要去看這場表演？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是常常在海外公演",
    "voice": "vo_adv_1084004_009",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很有名的聖歌隊！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n表演的節目也是跨及現代風，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到流行文化的內容……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我現在已經期待到快等不及了！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "行程沒問題嗎？",
    "voice": "vo_adv_1084004_010",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "太好了！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1084004_011",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　雖然這麼地期待，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但是為什麼",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到目前為止，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "都沒去看過嗎？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那是……",
    "voice": "vo_adv_1084004_012",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想只要你到了會場",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就會明白了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節當天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "108400401"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有看到非常多的情侶吧？",
    "voice": "vo_adv_1084004_013",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這就是，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "都沒來看的原因。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是、",
    "voice": "vo_adv_1084004_014",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "畢竟是這種節日，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n受到情侶們的喜愛",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也是沒辦法……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是、",
    "voice": "vo_adv_1084004_015",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　這種氣氛之中一個人待著",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感覺會難以忍受的、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以我一直都不敢來……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": "vo_adv_1084004_016",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然現在才在問、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會不會造成你的困擾？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒有那回事、",
    "voice": "vo_adv_1084004_017",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n反而還很期待是嗎……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "太好了，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣我就放心了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "其實，",
    "voice": "vo_adv_1084004_018",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我一開始還在猶豫要不要邀請你、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我很想跟{0}一起來……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1084004_019",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　反而，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "選自己當同伴真的好嗎？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n那是當然的了！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　我對、{0}――",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊！？",
    "voice": "vo_adv_1084004_020",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　表演好像開始了！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什、",
    "voice": "vo_adv_1084004_021",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你不要在意我剛剛想說什麼。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "比起那個、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還是先享受演唱會吧。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": "vo_adv_1084004_022",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是好棒的表演呢。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n真是滲透人心的歌聲呢……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且，",
    "voice": "vo_adv_1084004_023",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "加上聖誕節的燈光，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也是相當美麗……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就好像、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在夢中一樣呢。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1084004_024",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　該不會是想成為歌手、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗎？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "當然，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總有一天我也想要站上那種舞台。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是……",
    "voice": "vo_adv_1084004_025",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "當我開始唱歌、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就沒辦法待在{0}的身邊了，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n今天還是當觀眾就好。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天呢，",
    "voice": "vo_adv_1084004_026",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是我唱歌的日子，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是跟{0}",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n一起享受音樂的日子才對……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真的，",
    "voice": "vo_adv_1084004_027",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "非常謝謝你。",
    "voice": null,
    "unit_id": 104232
  },
  {
