[
  {
    "type": "background",
    "bg_id": "500035"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "矛依未等人離開據點後，走在夜晚的街道上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並搜尋著千歌與紡希。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔、",
    "voice": "vo_adv_5110003_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔唔",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咿咿！",
    "voice": "vo_adv_5110003_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你這傢伙！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我宰了你喔……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只是有什麼東西倒下的聲音吧？",
    "voice": "vo_adv_5110003_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳也太害怕了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……祈梨，",
    "voice": "vo_adv_5110003_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "剛才是我不應該激妳。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n妳回去據點",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "保護公主殿下吧，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什、",
    "voice": "vo_adv_5110003_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我一點都不害怕好嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就靠這群人要面對蘭德索爾的危機，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n反而令人擔心到不敢回去啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "的確，",
    "voice": "vo_adv_5110003_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "偶像、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "幫派成員、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "自稱壞蛋",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和一般人，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n感覺就像一群烏合之眾呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈，",
    "voice": "vo_adv_5110003_006",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過這或許",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "確實是滿少見的組合。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n如果我們照常生活，根本沒機會相遇呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "和這些少見的成員，",
    "voice": "vo_adv_5110003_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥全部都認識，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我反而覺得是小哥有點可怕呢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底要吃什麼長大才會有這樣的緣分啊？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會嗎？",
    "voice": "vo_adv_5110003_008",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我倒是很興奮喔！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們",
    "voice": "vo_adv_5110003_009",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都和我的舊識很像。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "給我像在和他們並肩戰鬥一樣，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "感覺還不錯呢。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "舊識？",
    "voice": "vo_adv_5110003_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是啊！",
    "voice": "vo_adv_5110003_011",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一個是像嘉夜一樣性格急躁的男人！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還很粗野又煩人，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是個很麻煩的傢伙。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哦，",
    "voice": "vo_adv_5110003_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳這是在兜圈子罵我嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈，",
    "voice": "vo_adv_5110003_013",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不是不是。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "他雖然是這樣的人，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但個性直率，很強很可靠。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n看到嘉夜，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不禁會令人想起那傢伙呢。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_5110003_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔～",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然不曉得對方是何方神聖，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不過打起架應該會很過癮吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳下次見到他，",
    "voice": "vo_adv_5110003_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "幫我轉告他",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打手要跟他會一會。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我也",
    "voice": "vo_adv_5110003_016",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "和妳的舊識很像嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那當然！",
    "voice": "vo_adv_5110003_017",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n慈樂之音的",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "製作人是克莉絲提娜不是嗎？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "或許是因為如此，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看著妳，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不禁會令我想起她的身影。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦咦～！",
    "voice": "vo_adv_5110003_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我和製作人嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "騙人騙人，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們一點都不像呀！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、",
    "voice": "vo_adv_5110003_019",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我承認自己多少有點任性，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是和製作人任性到專制的程度相比，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我這還算可愛的吧？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且",
    "voice": "vo_adv_5110003_020",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人是美人型的不是嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳想想，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是偶像，所以完全是不同類型呀！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我不是那個意思……",
    "voice": "vo_adv_5110003_021",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是妳勇於朝著自己的信念前進，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "並堅定不移的地方讓我看到了她的影子。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳可是那個克莉絲提娜特別關照的。",
    "voice": "vo_adv_5110003_022",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想必她",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "內心中也有這種想法吧。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哼、",
    "voice": "vo_adv_5110003_023",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哼嗯～",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我和製作人",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "或許還不錯呢，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "然後你是",
    "voice": "vo_adv_5110003_024",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶的公主騎士啊。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然是湊巧，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但這裡剛好",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都聚集了和我認識的傢伙",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很像的人！",
    "voice": null,
