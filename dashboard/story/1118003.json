[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "將神殿外的攤販從頭逛到尾的貪吃佩可兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n悠閒地在神殿散步著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肚子也飽了，",
    "voice": "vo_adv_1118003_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們去求籤吧。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇、",
    "voice": "vo_adv_1118003_001",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇啊啊。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "對、",
    "voice": "vo_adv_1118003_002",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "對不起。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n水濺到妳了吧……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我沒事的。",
    "voice": "vo_adv_1118003_003",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "老婆婆妳沒受傷吧？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "謝謝妳啊，",
    "voice": "vo_adv_1118003_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n只是不小心絆了一跤而已。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "唉，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "真不想老這麼快啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "老伴啊，",
    "voice": "vo_adv_1118003_005",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我沒事，",
    "voice": "vo_adv_1118003_006",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "只是不小心把桶子裡的水濺到這位小姐……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "對不起啊小姑娘。",
    "voice": "vo_adv_1118003_007",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "把妳漂亮的和服弄髒了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n放心吧，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我們會賠償妳的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不用不用，",
    "voice": "vo_adv_1118003_008",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我沒事的，請不必費心了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起這個，老婆婆，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳拿著這麼重的東西很辛苦吧。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我去幫妳打水好了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不必不必，",
    "voice": "vo_adv_1118003_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我不能讓妳做這種事。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "況且，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這些都是我們自願做的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "自願……？",
    "voice": "vo_adv_1118003_010",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你們不是神殿的相關人員嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我們兩人是因為來這座神殿參拜而結下姻緣的。",
    "voice": "vo_adv_1118003_011",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n所以每年新年都會來這裡幫忙打掃。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "話雖如此，",
    "voice": "vo_adv_1118003_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還真是歲月不饒人啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是啊。",
    "voice": "vo_adv_1118003_013",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會在這裡相遇也算是一種緣份。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請務必讓我們幫忙。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "說實話",
    "voice": "vo_adv_1118003_014",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "禮貌上是該婉拒你們的……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n但能麻煩你們幫把手嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是啊。",
    "voice": "vo_adv_1118003_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n清掃做得不夠徹底，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就太對不起神明大人了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "包在我們身上吧！",
    "voice": "vo_adv_1118003_016",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們會把神殿打掃得一塵不染！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "background",
    "bg_id": "500560"
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我們負責打掃神殿內部，",
    "voice": "vo_adv_1118003_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n能麻煩小姑娘你們",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "去掃參拜道路嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "你們真的不需要勉強喔。",
    "voice": "vo_adv_1118003_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n現在就拒絕離開也沒關係的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒問題的！",
    "voice": "vo_adv_1118003_019",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們對體力活可是很有自信的喔！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對吧？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "真是可靠啊。",
    "voice": "vo_adv_1118003_020",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "很謝謝你們。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那我們就去掃神殿了。",
    "voice": "vo_adv_1118003_021",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n要是有什麼事就來叫我們吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好啦！",
    "voice": "vo_adv_1118003_022",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們就回應老婆婆他們的期待，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n快速俐落地打掃乾淨吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要把石頭擦乾淨",
    "voice": "vo_adv_1118003_023",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "意外地很費力呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n老婆婆他們",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "每年都在做著這種事啊。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我們每年都來參拜，",
    "voice": "vo_adv_1118003_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n今年還是第一次遇到結緣之神呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這下我們的感情之路也會",
    "voice": "vo_adv_1118003_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "走得順順利利吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "結緣之神……？",
    "voice": "vo_adv_1118003_026",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是有這樣的神，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也想見見看呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_1118003_027",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不可以不可以。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n現在要先認真打掃才行！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呼，",
    "voice": "vo_adv_1118003_028",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "終於打掃完了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n到處都閃閃發光啦！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們去告訴老婆婆他們吧。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "奇怪？",
    "voice": "vo_adv_1118003_029",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼聚集了這麼多人。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在那裡的是……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "老婆婆他們？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那、",
    "voice": "vo_adv_1118003_030",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那個！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n請問能和我握個手嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "不嫌棄我這老頭子的話，想握幾次都沒問題。",
    "voice": "vo_adv_1118003_031",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那個，",
    "voice": "vo_adv_1118003_032",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "請告訴我夫妻感情和睦的祕訣！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我是很想告訴妳，",
    "voice": "vo_adv_1118003_033",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但我們其實也沒",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "做什麼特別的事……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個──",
    "voice": "vo_adv_1118003_034",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀小姐，",
    "voice": "vo_adv_1118003_035",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "你們已經打掃完啦。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "果然年輕人就是手腳快呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請問，",
    "voice": "vo_adv_1118003_036",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這些人是……？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "什麼？",
    "voice": "vo_adv_1118003_037",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "你們不是來見這兩位的嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是，",
    "voice": "vo_adv_1118003_038",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們只是碰巧遇見了而已。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這樣啊？",
    "voice": "vo_adv_1118003_039",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那你們運氣很好呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n在新年這天遇見這對老夫婦的情侶，都能幸福地終生相守，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n這個傳聞非常有名喔。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_1118003_040",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以剛剛在參拜路上聽到的",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n結緣之神指的難道就是……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "神？",
    "voice": "vo_adv_1118003_041",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n我們才沒有那麼偉大呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_1118003_042",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我們只是相伴多年的老夫老妻而已。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n沒什麼稀奇的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "全都是碰巧、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "碰巧罷了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "但老婆婆你們很出名呢。",
    "voice": "vo_adv_1118003_043",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "聽說有很多人都在遇見你們後",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "幸福修成正果呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_1118003_044",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是動人的佳話呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "就是說啊，",
    "voice": "vo_adv_1118003_045",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "年輕人幸幸福福的是好事啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我們也絕對",
    "voice": "vo_adv_1118003_046",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "會幸福下去的！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不會讓老爺爺你們失望的！",
    "voice": "vo_adv_1118003_047",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "哈哈哈！",
    "voice": "vo_adv_1118003_048",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "不用顧慮我們兩個啦。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n只要你們期望能帶給對方幸福，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n這就算是",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "一種幸福了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_1118003_049",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "雙方都盡力而為就行了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我們老人家能給的忠告也就這麼多了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性2、男性2",
    "words": "謝謝您！",
    "voice": "vo_adv_1118003_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那兩人臉上",
    "voice": "vo_adv_1118003_051",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "掛著滿足的笑容離開了呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "每年都能見到年輕人的笑容，",
    "voice": "vo_adv_1118003_052",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我們才是幸福的那一方啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "希望他們明年也能",
    "voice": "vo_adv_1118003_053",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "像這樣一起前來。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵，",
    "voice": "vo_adv_1118003_054",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好像有點明白",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為什麼你們兩位會被稱為",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "結緣之神了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咦？",
    "voice": "vo_adv_1118003_055",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你們兩位會替對方著想，",
    "voice": "vo_adv_1118003_056",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "並由衷地為他人的幸福感到欣喜。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "正是一段好姻緣的最佳範本呀。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "是、",
    "voice": "vo_adv_1118003_057",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "被這麼誇獎，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "很讓人害臊啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也想和你們學習呢。",
    "voice": "vo_adv_1118003_058",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "妳在說什麼啊，",
    "voice": "vo_adv_1118003_059",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "小姑娘。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就是說啊。",
    "voice": "vo_adv_1118003_060",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小姐妳們不是早就如此了嘛。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……咦？",
    "voice": "vo_adv_1118003_061",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "因為擔心我們",
    "voice": "vo_adv_1118003_062",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "而幫忙打掃、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n為陌生人的笑容而開心。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "而且，",
    "voice": "vo_adv_1118003_063",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "你們兩個並肩打掃的樣子，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n和我們年輕時一模一樣。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是、",
    "voice": "vo_adv_1118003_064",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "當然，",
    "voice": "vo_adv_1118003_065",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我們可以掛保證。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n你們兩人很登對喔。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這、",
    "voice": "vo_adv_1118003_066",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好害羞喔☆",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "呵呵，",
    "voice": "vo_adv_1118003_067",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "純純的愛真好啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "打擾這對小情侶也不太好意思，",
    "voice": "vo_adv_1118003_068",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "就此告辭吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊──！",
    "voice": "vo_adv_1118003_069",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還有什麼",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是我們能幫忙的嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "不必了，",
    "voice": "vo_adv_1118003_070",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我們這裡也做完了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "剩下的事差不多也就求個籤後回家去吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "求籤！",
    "voice": "vo_adv_1118003_071",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我完全忘記了！！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也去吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "數兩秒後同時看結果吧？",
    "voice": "vo_adv_1118003_072",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我要數囉，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一、二！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "往好處想，這代表之後會越來越好，",
    "voice": "vo_adv_1118003_073",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也算是好結果嘛。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒必要因此而沮喪。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實我也是末吉。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們一樣呢☆",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼那麼，",
    "voice": "vo_adv_1118003_074",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "重點是裡面寫了什麼呢？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我看看……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "still",
    "still_id": "111800301"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你快看！",
    "voice": "vo_adv_1118003_075",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "籤上說「等待的人就在身旁」",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "耶！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這一定是指你吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好害羞喔☆",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊、",
    "voice": "vo_adv_1118003_076",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎麼說……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是預料之外的答案。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種會讓人怦然心跳的回答",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太狡猾了啦……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_1118003_077",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為我還有很多",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非做不可的事。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以，",
    "voice": "vo_adv_1118003_078",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再一下就好，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請你在我身旁守望著我吧，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的等待之人。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "如此說著的貪吃佩可，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再次愛憐地望向了手中的籤。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
