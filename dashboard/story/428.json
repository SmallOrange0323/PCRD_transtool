  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看起來應該",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不會再復活了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼哼哼！",
    "voice": "vo_adv_0000428_001",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n別小看我們，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "儘管這連零頭都稱不上……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但總算是還以顏色啦！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "伊莉亞，",
    "voice": "vo_adv_0000428_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳好厲害耶！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "老師好驚訝！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼哈哈哈！",
    "voice": "vo_adv_0000428_003",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n再更崇拜妾身一點也無妨唷，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這位女教師！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n吾乃傳說的吸血鬼，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……唔。",
    "voice": "vo_adv_0000428_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "方才的戰鬥，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把妾身好不容易才留下來的魔力消耗殆盡了嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是的，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "最後還是用個精光了啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？　",
    "voice": "vo_adv_0000428_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "又讓老師驚訝了！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "伊莉亞，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "變得好可愛！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，對了♪　",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "伊莉亞，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要不要來當我們學校的學生呀？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂喂，",
    "voice": "vo_adv_0000428_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別黏過來！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n話說回來應該由比妳年長的妾身",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來當老師才合適吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……我們的",
    "voice": "vo_adv_0000428_007",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "魔力和體力也都到極限了……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不知道在其他地方戰鬥的大家",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "順不順利……",
    "voice": null,
    "unit_id": 103111
  }
