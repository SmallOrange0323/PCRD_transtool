[
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "除了逃避社會服務活動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【蠻賊三姊妹】還被問罪假釋期間的盜賊活動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}前來面訪倭，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她一人扛起罪名並因此入獄。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──噗哈。",
    "voice": "vo_adv_5156007_000",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這是什麼呀？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "咖哩果汁？",
    "voice": "vo_adv_5156007_001",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰叫你帶這種東西來探監的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我不是跟你說過好幾次，要你帶葡萄酒來的嘛！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……嘖。",
    "voice": "vo_adv_5156007_002",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "每天晚上都來，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我不知道你是剛打完工還是怎樣，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "一下帶來果菜汁，一下換燉菜，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "還有藥材冰沙……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你以為你是若菜嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………哼。",
    "voice": "vo_adv_5156007_003",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰叫她們老是被我牽著走，",
    "voice": "vo_adv_5156007_004",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我說這次一定沒問題，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這是賭上性命的關鍵一戰，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "結果變成這～種下場。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那兩個傢伙",
    "voice": "vo_adv_5156007_005",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "也不是小鬼了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n事已至此，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n她們也有她們的打算吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼～",
    "voice": "vo_adv_5156007_006",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰知道呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們一直以來都",
    "voice": "vo_adv_5156007_007",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n隨心所欲地過日子。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "會有什麼下場，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "也都是理所當然。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "為什麼你要一臉窩囊的樣子啊？",
    "voice": "vo_adv_5156007_008",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子你也只是",
    "voice": "vo_adv_5156007_009",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "被捲進來的人質吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你應該恨我才對，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n沒道理這樣老實地",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來見我啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你要誤解也給我差不多點。",
    "voice": "vo_adv_5156007_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n大蜘蛛和鱷魚男的時候都一樣，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n因為我看他們不爽，才會賞他們一刀的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "好了，",
    "voice": "vo_adv_5156007_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "快回去快回去！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n已經不需要人質這角色了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你快滾吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啥～？",
    "voice": "vo_adv_5156007_012",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你真的一直都是個蠢蛋耶。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……怎麼可能寂寞。",
    "voice": "vo_adv_5156007_013",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你以為我是誰啊？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………好啦，",
    "voice": "vo_adv_5156007_014",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "時間差不多了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "離牆壁遠一點！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "background",
    "bg_id": "500342"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "────！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈哈～ｗ",
    "voice": "vo_adv_5156007_015",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n明明是監獄的牆壁，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "居然這麼好搞定～♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "破、",
    "voice": "vo_adv_5156007_016",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "破壞得這麼明目張膽……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我不是說稍微挖個洞就好嗎～！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的，",
    "voice": "vo_adv_5156007_017",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰叫妳們搭「這個」來的呀。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不是要妳們別引人注意了嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "因為～",
    "voice": "vo_adv_5156007_018",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我想讓大家看",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "新～的小鯊鯊號嘛～♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……嗯，",
    "voice": "vo_adv_5156007_019",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "咦？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這不是雜碎哥哥嗎。",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好久不見～♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n你越來越雜碎了耶～ｗｗ",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "哇啊，{0}先生，",
    "voice": "vo_adv_5156007_020",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好久不見！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n之前承蒙你照顧。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你們幾個，",
    "voice": "vo_adv_5156007_021",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "可沒時間打招呼喔。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "在警衛來之前快上車。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我們要離開這裡了！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501760"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "到這裡就比較安心了",
    "voice": "vo_adv_5156007_022",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呼……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "還是自己家裡好。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──是說小子，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你還跟著啊！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": "vo_adv_5156007_023",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "說、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "說得也是！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "抱歉太晚跟你通知了。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那正式來一次，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "鏘～",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我們的家翻新了～！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……說是這樣說，",
    "voice": "vo_adv_5156007_024",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n其實只是把已經破舊不堪的家，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n修整回原來的樣子罷了。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對、",
    "voice": "vo_adv_5156007_025",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "對呀～",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n雖然財寶都已經被沒收了……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個，",
    "voice": "vo_adv_5156007_026",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呃……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然是不能大聲嚷嚷的事……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
