[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "世界で一番の悪いヤツを目指しているノウェムは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n今日もしっかり（？）鍛錬に励んでいた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "はっはっはっは～！",
    "voice": "vo_adv_5110607_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……いや、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "微妙に違う気がするな～？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nもう少し、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "低い声でやった方が……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "む……？",
    "voice": "vo_adv_5110607_001",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\nオクトー、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "ノウェムは何をやっているんだ？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "突然笑い出したかと思えば、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "逆に黙り込んだりしているが。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あー、",
    "voice": "vo_adv_5110607_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あれねー",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n悪党らしい高笑いの練習だってさ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクにはさっぱり理解できない趣味だけど。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "な、",
    "voice": "vo_adv_5110607_003",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "なんということだ！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "高笑いはむしろ、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "正義の味方の特権……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n彼女の認識を正す必要があるな！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "……",
    "voice": "vo_adv_5110607_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "忘れてた。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nベクトルが違うだけで、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "この人も似たようなもんだったよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "めんどくさい展開にならないといいけど。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おーほっほっほっほ……",
    "voice": "vo_adv_5110607_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いや、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "これも違う！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ぐへへへへ～……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちょっと、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いやらし過ぎるなぁ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n悪党らしい高笑いって、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "かなり難しいぞ……！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "当然だぞ、",
    "voice": "vo_adv_5110607_006",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "ノウェム！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\nなぜなら",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "澄み渡る空に向かって高らかに笑うのは、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\nいつだって正義の側だと相場が決まっているからだ！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんだと～！？",
    "voice": "vo_adv_5110607_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nじゃあ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエの高笑いを見せてみろ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nちゃんと立派な、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "正義感あふれる高笑いなんだろうな！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "いいだろう、",
    "voice": "vo_adv_5110607_008",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "しっかりと目と耳に焼き付けてくれ！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "……あー、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "あー、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "コホン。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "ふふふ……",
    "voice": "vo_adv_5110607_009",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "ククク……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "あーはっはっはっはっは！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\nふははははははははははははははははははは！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "どうだ、",
    "voice": "vo_adv_5110607_010",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "私の高笑いの完成度は！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\nいつか我が主にも披露したいと考え、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n毎日早起きして練習し続けた",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "とっておきだぞ！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "す、",
    "voice": "vo_adv_5110607_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "すご",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "い……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "すごく、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "悪党っぽい！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "感動したぞ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "マサキ！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "悪党の才能があるんじゃないか！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nこんなに邪悪な高笑いができるなんて！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "なっ、",
    "voice": "vo_adv_5110607_012",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "私の高笑いが邪悪だと！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "オクトーは",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "私の「正義の」高笑いをどう感じた！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "情けは無用だ、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "忌憚のない意見を聞かせてほしい！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "物語の折り返しくらいで倒されるぱっとしない中ボス、",
    "voice": "vo_adv_5110607_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nって感じの笑い方だったかなー",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あと、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ご主人様の前ではやらない方がいいよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "えっ、",
    "voice": "vo_adv_5110607_014",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "そこまでだったか……？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "このままでは、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "我が主をお守りすることができないではないか……！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いや、",
    "voice": "vo_adv_5110607_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "単なる笑い方の話なんだけど。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "どんな笑い方してても、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "強さには影響しないでしょ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム・マサキ",
    "words": "する！　",
    "voice": "vo_adv_5110607_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム・マサキ",
    "words": "絶対にする！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "えぇ……？",
    "voice": "vo_adv_5110607_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なぁ、",
    "voice": "vo_adv_5110607_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いったん",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "悪と正義で手を取り合わないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "このままちゃんとした高笑いができなかったら、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n共倒れになっちゃうからな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "私も同じ提案をしようとしていたところだ！",
    "voice": "vo_adv_5110607_019",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "正義と悪の決着は、",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "高笑いを極めてから改めてつけるとしよう！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "じゃあ、",
    "voice": "vo_adv_5110607_020",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクは正義も悪も高笑いもどうでもいいんで、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nこの辺で失礼するよ～……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ノリが悪いぞ、",
    "voice": "vo_adv_5110607_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトー！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "一人だけ逃げられると思ってるのか！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "マサキ",
    "words": "その通り！",
    "voice": "vo_adv_5110607_022",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
