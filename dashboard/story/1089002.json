  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你的一舉一動，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n可能會在哪天讓家人或是鄰居遭遇不幸喔？",
