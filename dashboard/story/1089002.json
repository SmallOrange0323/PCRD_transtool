    "name": "怜",
    "words": "已經離開城區很遠了，",
    "voice": "vo_adv_1089002_000",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也感覺不到追兵……",
