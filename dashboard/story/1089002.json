  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝您！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n沒想到在貴族之中，還有您這樣的人存在！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這份恩情我們一輩子都不會忘記！",
    "voice": "vo_adv_1089002_085",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不。",
    "voice": "vo_adv_1089002_086",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "忘了還比較好。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "希望你們把今天發生的事情都忘掉，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "平靜而幸福地過日子就好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……",
    "voice": "vo_adv_1089002_087",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "謝謝您！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "會幸福的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
