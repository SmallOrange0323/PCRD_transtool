    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那位貴族，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我在之前的舞會上有見過……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "當然就是在說你啊！",
    "voice": "vo_adv_1089002_008",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n分明是你不顧她的抗拒，強行將她帶上馬車！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我相信你會來救我，",
    "voice": "vo_adv_1089002_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "一直都相信著……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難道那貴族，",
    "voice": "vo_adv_1089002_010",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要強迫那位女性跟他結婚？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈！",
    "voice": "vo_adv_1089002_011",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "真是的，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "那種村夫野老有哪裡好啊？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "明明跟我結婚肯定會幸福一輩子的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我有",
    "voice": "vo_adv_1089002_012",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "一個訂下終生的婚約者，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我應該早就說過了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我只要和這個人一起，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "只要一點小小的幸福就足夠了！",
