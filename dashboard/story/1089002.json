    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不是那樣的。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我，",
    "voice": "vo_adv_1089002_094",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有那麼任性嗎……？",
