    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "擅自跳出來很抱歉。",
    "voice": "vo_adv_1089002_036",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我已經忍無可忍了……！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "嗯？",
    "voice": "vo_adv_1089002_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "妳是……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這不是怜小姐嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n在前陣子的宴席上才剛見過……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "別來無恙啊？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "您家老爺正在找您呢？",
    "voice": "vo_adv_1089002_038",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "真是找得眼都紅了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "沒想到居然在這種地方。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "正好。",
    "voice": "vo_adv_1089002_039",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "就請您和那位女孩一同移駕這趟吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "您家老爺肯定也會笑逐顏開的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "閉嘴！",
    "voice": "vo_adv_1089002_040",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "誰要回去那種家裡！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只要一看到像你這種，",
    "voice": "vo_adv_1089002_041",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "以為全世界的一切\\n都會照自己意思走的傲慢之人，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我心中的怒火就無法壓抑！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "以為全世界的一切都會照自己意思走？",
    "voice": "vo_adv_1089002_042",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "……呵、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "呵呵呵、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈哈哈哈！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你笑什麼！",
    "voice": "vo_adv_1089002_043",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有什麼好笑的！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "您是用什麼立場說這話呢……",
    "voice": "vo_adv_1089002_044",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "真要說起來，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "您拒絕我的提親才是原因吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說什麼……？",
    "voice": "vo_adv_1089002_045",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈！",
    "voice": "vo_adv_1089002_046",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "連這點自覺都沒有嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n和我比起來，妳才更加傲慢！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "提親被顏面盡失地拒絕，",
    "voice": "vo_adv_1089002_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "在整個家族面前丟臉的我，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n現在正拼命在找結婚對象。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "到底有什麼不對的！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確在之前，",
    "voice": "vo_adv_1089002_048",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "爸爸有介紹聯姻的人選。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我說，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對那種事沒有興趣，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就全部回絕掉了……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "怜小姐。",
    "voice": "vo_adv_1089002_049",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "要不是因為妳任性拒絕我的提親，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n那兩人現在就不會遭到這種事情囉？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "還是說，",
    "voice": "vo_adv_1089002_050",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "妳要負起責任跟我結婚嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這……",
    "voice": "vo_adv_1089002_051",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我明白。",
    "voice": "vo_adv_1089002_052",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是詭辯。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他那綁架犯一樣的惡行，\\n把女子強行擄走，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確是不由分說的事實……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": "vo_adv_1089002_053",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說我的行為，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "導致他做出這種事，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n難道這也是事實嗎……？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對！",
    "voice": "vo_adv_1089002_054",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我只是！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒錯！",
    "voice": "vo_adv_1089002_055",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這女孩",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不打算回應任何人的提親啊！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n是這樣吧？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊、是啊……",
    "voice": "vo_adv_1089002_056",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "而你是把我的未婚妻，",
    "voice": "vo_adv_1089002_057",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不經她同意就擄走了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那只是單純的綁架！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就算身為貴族，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "犯罪還是犯罪！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你們兩個……",
    "voice": "vo_adv_1089002_058",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就像你們說的。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "聽清楚了！",
    "voice": "vo_adv_1089002_059",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你蠻橫的暴行，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我絕不原諒！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "咿嗚！",
    "voice": "vo_adv_1089002_060",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "什麼啊，這什麼鬧劇啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n掃興！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "真掃興啊！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "喂！",
    "voice": "vo_adv_1089002_061",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "把他們痛揍一頓！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n不用手下留情了！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "遵命！",
    "voice": "vo_adv_1089002_062",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "你們幾個，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "別想活著回去啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你啊！",
    "voice": "vo_adv_1089002_063",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能借我力量嗎？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝！",
    "voice": "vo_adv_1089002_064",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來吧，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要打就儘管來！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "別太囂張啦！",
    "voice": "vo_adv_1089002_065",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "──真弱呢！",
    "voice": "vo_adv_1089002_066",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝！！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "咕啊啊啊啊啊啊！！",
    "voice": "vo_adv_1089002_067",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "騙人的吧……？",
    "voice": "vo_adv_1089002_068",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "她有這麼強嗎……！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "現在可不只我的力量……",
    "voice": "vo_adv_1089002_069",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這是他交給我，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為了一同向前邁進的力量！！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "認命吧！！",
    "voice": "vo_adv_1089002_070",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝啊啊啊啊啊啊！！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "咿呀啊啊啊啊！！",
    "voice": "vo_adv_1089002_071",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1089002_072",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "又被你幫了一次，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是你的話讓我清醒了。",
    "voice": "vo_adv_1089002_073",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在我陷入迷惘的時候。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500024"
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可惡────！",
    "voice": "vo_adv_1089002_074",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可惡，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可惡！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我已經手下留情了。",
    "voice": "vo_adv_1089002_075",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不准再靠近我跟那些人。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這次姑且放過你們。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "是嗎……",
    "voice": "vo_adv_1089002_076",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "你就是傳聞中的對象嗎……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這種看就知道很沒用的軟爛男人竟然比我好嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "傳聞中的對象？",
    "voice": "vo_adv_1089002_077",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的是他？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "不要小看我的情報網！",
    "voice": "vo_adv_1089002_078",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我可是一直都有在調查的！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "粉絲俱樂部的女會員們，八卦起來可是滔滔不絕的！",
    "voice": "vo_adv_1089002_079",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "「怜大人已經有心儀的對象了」什麼的！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "粉絲俱樂部……？",
    "voice": "vo_adv_1089002_080",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "她們居然還把我說成寄生蟲……",
    "voice": "vo_adv_1089002_081",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這種暴力女到底有哪一點好的啊！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我才是不想再看到妳呢！",
    "voice": "vo_adv_1089002_082",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n我要回去跟爸爸告狀！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……走掉了呢。",
    "voice": "vo_adv_1089002_083",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "被叫成暴力女，還真是沒想到啊。",
