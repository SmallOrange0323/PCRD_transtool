    "voice": "vo_adv_1089002_095",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多虧你我心裡舒服多了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1089002_096",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這麼任性的我，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就請你再多陪伴一段時間吧？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這麼說著的怜，那抹笑容在{0}看來，\\n感覺稍微恢復開朗了。",
