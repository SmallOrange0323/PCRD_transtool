    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就在這邊休息一會好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "求求你！",
