[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "よく晴れたある日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n{0}たちは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "音楽劇団の公演を手伝うために\\n村の劇場に向かっていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "それにしても、",
    "voice": "vo_adv_5100601_000",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "まさかぷうきちが音楽劇に出る日が来るなんてね！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『お？　",
    "voice": "vo_adv_5100601_001",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "なんだ？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\nムーサの町での俺の活躍を忘れたのかー？』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "忘れるわけないよ！",
    "voice": "vo_adv_5100601_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "あの時のぷうきち、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "かっこよかったもん！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『あの時はマホの姫さんも、",
    "voice": "vo_adv_5100601_003",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "アヤネも頼もしく見えたぜ？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\n二人がいてくれたから、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "俺も音楽劇に出るって、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "腹を決めたんだ』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "そうやったんやねえ。",
    "voice": "vo_adv_5100601_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "あの時は",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "劇団のお人も、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "ずいぶん喜んでくれはって。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "またこうして会えるなんて、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "うれしいご縁やなぁ。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "そうそう、",
    "voice": "vo_adv_5100601_005",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "そうなんだよね！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "\\n音楽劇も楽しみだけど、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "何より……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "劇団のみんなにまた会えるのが\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "私はすっごく楽しみなんだ！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『あぁ！　",
    "voice": "vo_adv_5100601_006",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "俺も同じ気持ち……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "ん？』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "ぷうきちはん？　",
    "voice": "vo_adv_5100601_007",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "どないしはったん？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『……いや。",
    "voice": "vo_adv_5100601_008",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "気のせいだ。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\n一瞬あいつがいたような気がして、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "な……』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "あいつ言うんは、",
    "voice": "vo_adv_5100601_009",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "バロメッツはんのこと？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『あぁ。",
    "voice": "vo_adv_5100601_010",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "けどあいつは今旅に出てるし、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\nいくらなんでも、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "偶然こんなところで会うわけないよな』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "うん。",
    "voice": "vo_adv_5100601_011",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "ちょっと前に、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "次の旅は深い山奥、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "ってお手紙が届いてたもんね。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『だよな。",
    "voice": "vo_adv_5100601_012",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "やっぱり気のせいだよな！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\nバロメッツが、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "こんなところにいるなんて』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "お姉ちゃんたち、",
    "voice": "vo_adv_5100601_013",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "バロメッツを知ってるの？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "えっ？",
    "voice": "vo_adv_5100601_014",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "くまさんくまさん！",
    "voice": "vo_adv_5100601_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nもしかして、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "あなたがぷうきちさん？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『お、",
    "voice": "vo_adv_5100601_016",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "おう！　",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "いかにも俺がぷうきち様だぜ！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\n早速俺のファンがいるのかよ……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "さすが俺』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "ぷうきち落ち着いて。",
    "voice": "vo_adv_5100601_017",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "アヤネ",
    "words": "まだ誰もそんなこと言ってないよ！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "『っと。",
    "voice": "vo_adv_5100601_018",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "悪い悪い。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "んで、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "嬢ちゃんはなんで俺のこと、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "知ってるんだ？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "ぷうきち",
    "words": "\\n初めて会ったよな？』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "うん！　",
    "voice": "vo_adv_5100601_019",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "あのね！　",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "バロメッツに話を聞いたの！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "あんさん、",
    "voice": "vo_adv_5100601_020",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "マホ",
    "words": "バロメッツはんのこと知ってはるの？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "うん！　",
    "voice": "vo_adv_5100601_021",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "バロメッツは私のいのちのおんじん、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "なんだよ！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "background",
    "bg_id": "501840"
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "あのね、",
    "voice": "vo_adv_5100601_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "この前ねえ……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "パパのご用で\\nちょっと遠くまでおでかけしたの。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "ぬいぐるみのカエルさんも一緒に！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "パパにおりこうさんで待っててね",
    "voice": "vo_adv_5100601_023",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "って言われた噴水のところで",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nカエルさんと一緒に待ってたらね、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "近くの馬車のお馬さんが、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nきゅうに走り始めちゃったの！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "気がついたら、",
    "voice": "vo_adv_5100601_024",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "すぐ近くにお馬さんがいて……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nみんなが、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "逃げろって叫んでたんだけど、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nこわくって体がうごかなかったの。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "その時は、",
    "voice": "vo_adv_5100601_025",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "もうぶつかる！　",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "って思ったんだよ。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\n怖くって",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "目をぎゅーってつぶったの。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nそうしたら……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "危ない！",
    "voice": "vo_adv_5100601_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "って声が聞こえたの。",
    "voice": "vo_adv_5100601_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "でも、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "いつまでたっても、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "馬車はぶつからなくて。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\nおかしいなっておもったら、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "バロメッツが、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "私とお馬さんの",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "\\n間に入ってお馬さんをとめてくれてたの！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "あいたたた……",
    "voice": "vo_adv_5100601_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "だいじょうぶだった？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "\\n……うん、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "よかった！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "ケガはしてないね。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "\\nお馬さんも、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "バロメッツ",
    "words": "ちゃんと止まってくれてありがとう。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "バロメッツ、",
    "voice": "vo_adv_5100601_029",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女の子",
    "words": "すーっごくかっこよかったんだよ！",
