[
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在莉瑪回到【伊麗莎白牧場】後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n已經過了一陣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "優雅優雅……",
    "voice": "vo_adv_5061601_000",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "距離在宅邸學習課程的那些日子，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n雖然已經過了好幾天，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但我已經能夠自然地表現出優美的舉止了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現在想起來，",
    "voice": "vo_adv_5061601_001",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還是覺得那段日子真的像在做夢呢……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "羅伊德先生和公主殿下，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不知道相處得好不好呢？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哎呀，",
    "voice": "vo_adv_5061601_002",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你來啦♪{0}。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天有什麼事嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現在",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "除了我以外的大家都出門囉，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_5061601_003",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天是送信的打工啊。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "話說回來",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有我的信？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n到底是誰寄的呢……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這、",
    "voice": "vo_adv_5061601_004",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這是",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "公主殿下寄來的信！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這時機還真是剛好呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然我想應該是好消息，",
    "voice": "vo_adv_5061601_005",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但總覺得有些心跳加速呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "吶，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你也跟我一起讀吧？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我馬上泡杯好喝的紅茶，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "快進來吧♪",
    "voice": null,
    "unit_id": 105213
  }
]
