  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "比方說一個人進到店裡",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "吃飯的時候！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然是這樣！",
