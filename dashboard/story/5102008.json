[
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "トモたちとの激闘の末、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nカガミが自らの正体を明かし逮捕されたことにより、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nランドソルは一時、騒然となった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "──それから二日後。ランフェス最終日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nランドソルはある程度落ち着きを取り戻していた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ナナカとリンはランフェスを楽しむべく、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n{0}と共に、再び会場を訪れたのだった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "や～",
    "voice": "vo_adv_5102008_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "いろいろとあったけども！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nこうして平和になったフェスを見て回れるなんて幸せですぞ～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ま、",
    "voice": "vo_adv_5102008_001",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そだね。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "とはいえ……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n配信界隈の方はまだ結構ごたついてるっぽいけど。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "無理もないけどね。",
    "voice": "vo_adv_5102008_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "トップ配信者が急にいなくなったんだから。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nけど、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "これから、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "新しい時代が始まって……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nまた新しい人気配信者が生まれるんだろうね。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "今度は問題起こしたり、",
    "voice": "vo_adv_5102008_003",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nナナカの魔法を斬ったりしないゲーム実況者に\\n頂点に立ってほしいもんだね。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……って、",
    "voice": "vo_adv_5102008_004",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あれ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あそこにいるのは……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あああ、",
    "voice": "vo_adv_5102008_005",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "どうしよう……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n見て回りたいところがたくさんある……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ゲーム展示会で最新ゲームのチェックもしたいし……",
    "voice": "vo_adv_5102008_006",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nそれからフィギュアの展示も行われてるらしいから見てみたいな……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……なんかはっちゃけてんね、",
    "voice": "vo_adv_5102008_007",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "トモ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "はっ！？　",
    "voice": "vo_adv_5102008_008",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "リンさん！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nそれに、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ナナカさんとあなたも……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ここで会うなんて奇遇だね、",
    "voice": "vo_adv_5102008_009",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "トモ殿！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nいろいろ気になってるところあるっぽいけど、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nそれなら私たちと一緒に行かない？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "絶対楽しいからさ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ああ、",
    "voice": "vo_adv_5102008_010",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "いや……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "お誘いしてもらえるのはうれしいですけど……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n【王宮騎士団（NIGHTMARE）】として、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nフェスの警備にあたっているところなので……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "遊びに行くわけには……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そのことについては気にしなくてもいいさ。",
    "voice": "vo_adv_5102008_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n遊びに行きたいのなら許可するとも。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ジュンさん！　",
    "voice": "vo_adv_5102008_012",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "いいんですか……！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ああ。",
    "voice": "vo_adv_5102008_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "もちろん。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "というか、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "遊んできてほしい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nトモちゃんはフェスでの任務を本当に頑張ってくれたからね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n存分に楽しんでくるといい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "おお！　",
    "voice": "vo_adv_5102008_014",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "それはよかったですな～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "トモ殿！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "……ところで、",
    "voice": "vo_adv_5102008_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ちょうどよかった。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nカガミちゃんについて、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "君たちにも伝えておこうと思ってね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "逮捕されたカガミちゃんだが、",
    "voice": "vo_adv_5102008_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nもちろん、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "これまでの自らの犯行を認めている。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n今までにやってきたことを心から悔いているようだ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "それと……",
    "voice": "vo_adv_5102008_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "トモちゃん宛の言付けを預かっている。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "私に……？",
    "voice": "vo_adv_5102008_018",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "カガミ",
    "words": "……トモちゃんにはランドソル一の剣士になれるだけの才覚がある。",
    "voice": "vo_adv_5102008_019",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "カガミ",
    "words": "\\n好きなものを心の支えに、",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "カガミ",
    "words": "剣の道を進んでほしい。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "カガミ",
    "words": "\\n応援しているよ。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "カガミ",
    "words": "君のファンより……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "……とのことだ。",
    "voice": "vo_adv_5102008_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "……ありがとうございます。",
    "voice": "vo_adv_5102008_021",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n応援されたからには……頑張らないと、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ですね。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "うん。",
    "voice": "vo_adv_5102008_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "私も応援しているよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "……それにしても。",
    "voice": "vo_adv_5102008_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "さっきから思っていたんだが……\\nずいぶんと晴れ晴れとした顔をしているね、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "トモちゃん。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そうですか？　",
    "voice": "vo_adv_5102008_024",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "だとすれば……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n自分に素直になろうと決めたからかもしれません。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "自分の好きなものは、",
    "voice": "vo_adv_5102008_025",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "好きだと言おうって！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そうか。",
    "voice": "vo_adv_5102008_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "フェスではいろいろと大変だったと思うけど……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n同時に、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "トモちゃんにとっていい経験になったようだね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "今回は本当にお疲れさま。",
    "voice": "vo_adv_5102008_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nさあ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "遊んでくるといい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "はいっ！　",
    "voice": "vo_adv_5102008_028",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "それじゃあ、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "まずは……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "……あっ。",
    "voice": "vo_adv_5102008_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "先日のシャイニー★トモに似てる方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "\\nまた、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "いらしてくれたんですね。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "はい。",
    "voice": "vo_adv_5102008_030",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あの本が、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "どうしても欲しくて来たんですけど……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nまだ、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "置いてあったりしますか……？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "あ、",
    "voice": "vo_adv_5102008_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "全然あります。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "\\nえへへ……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "どうしても欲しい、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "なんて初めて言われました。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "\\nはい、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "サークル主",
    "words": "どうぞ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ありがとうございます……！",
    "voice": "vo_adv_5102008_032",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nふふっ。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "初めて魔法少女の同人誌買っちゃった……♪",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "それもまさか自分のなんて……！",
    "voice": "vo_adv_5102008_033",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nある意味では役得かも……！　",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "改めて見ても、",
    "voice": "vo_adv_5102008_034",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "表紙からかなり力が入ってるね！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nこの決めポーズ再現がすごすぎる……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "トモ殿は、",
    "voice": "vo_adv_5102008_035",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "本当に魔法少女が好きなんですなあ。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nムフフ……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "これはナナカちゃんの\\n魔法少女秘蔵コレクションが火を噴く時かもしれませんぞ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "えっ、",
    "voice": "vo_adv_5102008_036",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "見たい……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nというか、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ナナカさんと魔法少女トークをしてみたい……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……ついこの間は魔法少女とか興味ないって言ってたのにね。",
    "voice": "vo_adv_5102008_037",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nま、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんかうれしそうだし、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いっか。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "で、",
    "voice": "vo_adv_5102008_038",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "次はどこ行く？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n一応、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "最後まで付き合うよ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "え、",
    "voice": "vo_adv_5102008_039",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "じゃあ、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "今度は……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "そうして、トモはナナカたちと一緒に会場を見て回り、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n思う存分、楽しんだのだった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "や～",
    "voice": "vo_adv_5102008_040",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "すっかりフェスを満喫しましたなぁ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n『魔法少女セリイちゃん』のハロウィンバージョンフィギュアを\\nたっぷり眺めたり、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "企業ブースをいろいろ見て回ったり！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "同人誌も結構買ったね～",
    "voice": "vo_adv_5102008_041",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nナナカはどんなのゲットしたの？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ふっふっふ……",
    "voice": "vo_adv_5102008_042",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "気になっちゃう？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "じゃあ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "お見せしよう！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nじゃじゃんっ！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "『ドングリレンジャーvsトワイライトキャラバン』！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや。",
    "voice": "vo_adv_5102008_043",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "どう考えても負けでしょ、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしの。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nオーバーキル過ぎる。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ナナカ一人相手だろうと手も足も出ないっての。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "大丈夫！　",
    "voice": "vo_adv_5102008_044",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "こういうvsものはたいてい、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nなんやかんや共通の敵が現れて共闘するパターンだから！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ちなみに！　",
    "voice": "vo_adv_5102008_045",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ランドソルでは割とナマモノが許されてる風潮だけど……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nトーゴクとかの同人誌即売会では相当センシティブらしいよ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nこっちのとはいろいろと違いがあるから、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "その辺は気をつけるように！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まあ、",
    "voice": "vo_adv_5102008_046",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしたちは描かれてる側で描く側じゃないから、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n気をつけるもなにもないんだけど。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "覚えておきはするよ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "それはそれとして……",
    "voice": "vo_adv_5102008_047",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nフェスはどうだった、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "トモ？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "……楽しかったです。",
    "voice": "vo_adv_5102008_048",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n本当に、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "胸がいっぱいになるくらいに……楽しかった。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そか。",
    "voice": "vo_adv_5102008_049",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なら、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "良かったんじゃん？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……そうだ。",
    "voice": "vo_adv_5102008_050",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "前にも誘ったけどさ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nあたしたち、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "時々ゲーム会やってるって言ったでしょ？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "興味あったら、",
    "voice": "vo_adv_5102008_051",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いつでも来てくれていいからさ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nまた一緒にゲームやろーよ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "好きなんでしょ、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ゲーム。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "……一度断ってしまったのに、",
    "voice": "vo_adv_5102008_052",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "いいんですか？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nゲームの面白さが理解できないなんて、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n失礼なことまで言ってしまったのに……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんなのどうでもいいって。",
    "voice": "vo_adv_5102008_053",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n４人対戦のゲームがあるんだけどさ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n３人で協力してヨリヨリを倒そう。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "３人がかりでも勝てるかどうか！",
    "voice": "vo_adv_5102008_054",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n魔王みたいな強さだからね、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ヨリ殿ってば！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そこまで……！？",
    "voice": "vo_adv_5102008_055",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nけど……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "挑みがいがあって、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "楽しそうだ……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "じゃ、",
    "voice": "vo_adv_5102008_056",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "決まりね。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "今度、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "みんなで遊ぼう。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんじゃあ、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "疲れたし、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしはそろそろ帰る。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n帰って、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "寝る。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "違うな。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "寝て、",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "帰る。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ナナカ、",
    "voice": "vo_adv_5102008_057",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "またベッド出して。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ギルドハウスまで送ってって。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nなんならここから近い【自警団（カォン）】の方でもいいからさ。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "全く、",
    "voice": "vo_adv_5102008_058",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "世話が焼けますな～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nま、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "リン殿ってば今回のフェスじゃいろいろ頑張ったからね！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n全然、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "送ってあげるよ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "では、",
    "voice": "vo_adv_5102008_059",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そういうわけでおさらば！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n帰ったら同人誌やら、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "同人魔導書やら整理しなきゃ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nその時間も楽しいんだよね！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "……二人とも、",
    "voice": "vo_adv_5102008_060",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "行ってしまった。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n……私たちも、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そろそろ帰ろうか。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "……うん。",
    "voice": "vo_adv_5102008_061",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "私もそう思う。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n大切なことに気付けたからね。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "私は、",
    "voice": "vo_adv_5102008_062",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ゲームが好きだ。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "コスプレだって、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "漫画だって。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nそして、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "なにより……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "魔法少女が大好きだ。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "もしかすると、",
    "voice": "vo_adv_5102008_063",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "大人になるにつれて、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n好きなものが変わったりもするかもしれない。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nけれど、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "それはそれで構わないのだと思う。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "大事なのは……",
    "voice": "vo_adv_5102008_064",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "好きだという気持ちに素直になること。",
    "voice": null,
    "unit_id": 123611
  },
  {
