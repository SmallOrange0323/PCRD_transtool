    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "戴眼鏡來根本沒意義嘛～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不對，",
    "voice": "vo_adv_1311004_039",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "說不定反而剛剛好？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "因為戴了，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "才知道原來戴眼鏡也很不錯♪",
