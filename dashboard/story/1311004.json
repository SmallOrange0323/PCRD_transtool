  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小卡里莎～",
    "voice": "vo_adv_1311004_050",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n謝謝你的果汁～♡",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "別開玩笑了！",
    "voice": "vo_adv_1311004_051",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "什麼東西！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "沒～錯♪",
    "voice": "vo_adv_1311004_052",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n很厲害對吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n用史萊姆當模具做出來的～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "什麼",
    "voice": "vo_adv_1311004_053",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "小卡里莎遊樂園！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n快把我從這裡放出去！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "有好好說對不起了嗎～？",
    "voice": "vo_adv_1311004_054",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你也還沒有",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "跟小騎士道歉對吧～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "妳不也叫我去跑腿了嗎！",
    "voice": "vo_adv_1311004_055",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n這樣就扯平了吧！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭、卡里莎",
    "words": "「當然～♪」\\n「最好是啦！」",
    "voice": "vo_adv_1311004_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對了～",
    "voice": "vo_adv_1311004_057",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "機會難得。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n來探索一下小卡里莎遊樂園好了～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好期待裡面會有什麼遊樂設施哦～♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "住手，",
    "voice": "vo_adv_1311004_058",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "別過來……！",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n誰來，",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "救救我──！",
    "voice": null,
