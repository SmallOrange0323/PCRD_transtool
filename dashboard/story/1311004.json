    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "以前視力還很好的～",
    "voice": "vo_adv_1311004_027",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "但到了這邊之後，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "太沉迷於遊戲跟網路……",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n然後？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "視力",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就變得很差了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "平常都是戴著隱形眼鏡，",
    "voice": "vo_adv_1311004_028",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n但在游泳池沒辦法戴不是嘛？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "所以才會，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "戴眼鏡。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "只是，",
    "voice": "vo_adv_1311004_029",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
