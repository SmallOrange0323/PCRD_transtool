  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "小卡里莎遊樂園在夕陽下閃閃發光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這個既吵鬧又愉快的光景，將作為永不褪色的回憶，",
    "voice": null,
