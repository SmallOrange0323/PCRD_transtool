    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "真的？",
    "voice": "vo_adv_1311004_036",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n因為眼鏡掉在泳池裡會很危險……？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n原來是這樣，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我以前都不知道。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "在泳池邊",
    "voice": "vo_adv_1311004_037",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "雖然可以戴著，",
