    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n玩累的三人，在岸邊稍作歇息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊～",
    "voice": "vo_adv_1311004_000",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "口好渴～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小卡里莎，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "去買個果汁來～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "為什麼",
    "voice": "vo_adv_1311004_001",
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我要聽妳的話去跑腿啊。",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n妳就這樣",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "脫水乾掉吧。",
    "voice": null,
    "unit_id": 191618
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "咦～",
    "voice": "vo_adv_1311004_002",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真沒勁～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n話說，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我有點想睡……",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "哦，",
    "voice": "vo_adv_1311004_003",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "這不是小騎士嗎！",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n你在做什麼～？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嘿～",
    "voice": "vo_adv_1311004_004",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "有點好奇小騎士會用什麼角色～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n我啊～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "只會選正太角色♪",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n而且很愛聽被打時發出的聲音，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "所以基本上都會輸掉～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不錯哦～",
    "voice": "vo_adv_1311004_005",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我也很喜歡♪",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "小騎士你",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "有玩新歌曲的大師難度嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那個會玩到手斷掉，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "要有個心理準備比較好喔～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "是嗎～？",
    "voice": "vo_adv_1311004_006",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我懂～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n我有時候，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "也會只盯著夾娃娃機看喔～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "想說搞不好會換獎品，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "總之先確認一下呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "有點無聊？",
    "voice": "vo_adv_1311004_007",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那麼",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "要來跟我約會嗎～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n做些有夏日風情的事",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "感覺也很不錯呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不錯嘛～♪",
    "voice": "vo_adv_1311004_008",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那要來",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "做什麼好呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "現在這個時間，",
    "voice": "vo_adv_1311004_009",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "去海邊的話有點晚了呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "也沒有舉辦夏日祭典……",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "小騎士，",
    "voice": "vo_adv_1311004_010",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你有想做的事嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "什麼都可以說哦～♪",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "哦，",
    "voice": "vo_adv_1311004_011",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "原來如此呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n你想看姐姐我的泳裝嗎～？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯？",
    "voice": "vo_adv_1311004_012",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你說想學會游泳……？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "啊～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "說起來小騎士好像還不會游泳？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那麼，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就讓我來訓練你吧～♪",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "啊，",
    "voice": "vo_adv_1311004_013",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不過說到泳池的話，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就要用那個嗎……",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯……",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "啊～抱歉。",
    "voice": "vo_adv_1311004_014",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我也想跟你說沒有問題～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不過～",
    "voice": "vo_adv_1311004_015",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "難得",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "都來遊樂中心了。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n就用賽車遊戲一決勝負吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我贏了就去放煙火。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "小騎士贏了的話",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就去游泳池～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "好強！",
    "voice": "vo_adv_1311004_016",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我又輸了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "接著是釣魚遊戲～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "糟糕……",
    "voice": "vo_adv_1311004_017",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "已經這麼晚了。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "遊戲實在太好玩了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "結果是小騎士贏了啊……",
    "voice": "vo_adv_1311004_018",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n現在這個時間",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "只剩夜間泳池了吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我們",
    "voice": "vo_adv_1311004_019",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就先回去拿泳裝吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n在車站前集合可以嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "很好，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那就這麼決定了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "background",
    "bg_id": "510352"
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "哦～",
    "voice": "vo_adv_1311004_020",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "久等了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n準備好了嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "姐姐我",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "也準備萬全～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "說起來，",
    "voice": "vo_adv_1311004_021",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "我還是第一次去夜間泳池呢～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n會有人去那裡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "練習游泳嗎～？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "如果姐姐我",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "被搭訕的話～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你會保護我嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯哼哼～",
    "voice": "vo_adv_1311004_022",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "謝謝～♡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n就靠你囉～♪",
    "voice": null,
    "unit_id": 123331
  },
  {
