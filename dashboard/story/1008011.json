  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "儘管我不曉得前方有什麼在等著，",
    "voice": "vo_adv_1008011_053",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但都走這麼遠了，怎麼可能就此打道回府呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就只差一點，",
    "voice": "vo_adv_1008011_054",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我便能獲得美的祝福……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我已經等不及要出發了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也動作快！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "趕緊走吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "刻不容緩，",
    "voice": "vo_adv_1008011_055",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "得馬上就到聖山──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎，好危險呀，",
    "voice": "vo_adv_1008011_056",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不小心絆到了石頭……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要不是前方有牆壁，我就會跌倒了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊哈哈，",
    "voice": "vo_adv_1008011_057",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個姿勢該不會就是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所謂的「壁咚」吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "儘管是碰巧發生的狀況，",
    "voice": "vo_adv_1008011_058",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但我還真沒想到會有對你做出壁咚的一天呢！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……你怎麼一臉錯愕的模樣呀？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "噢，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "莫非是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在仔細品味這幸運的一刻？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "的確，",
    "voice": "vo_adv_1008011_059",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有幸被我做出這動作的人，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n找遍全世界恐怕也只有你一個。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論是至今為止，",
    "voice": "vo_adv_1008011_060",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還是往後──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都肯定是如此。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好啦好啦，",
    "voice": "vo_adv_1008011_061",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "快別嚇傻在那邊了，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你可得好好感謝我哪♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在維持壁咚動作下被拋了一個媚眼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n令{0}不禁感到心頭小鹿亂撞。",
    "voice": null,
    "unit_id": null
  }
]
