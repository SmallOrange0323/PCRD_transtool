[
  {
    "type": "background",
    "bg_id": "500405"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和雪順利通過了第二道測驗。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接著，他們倆總算是成功抵達神殿所在處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "終於、",
    "voice": "vo_adv_1008011_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "終於到了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看這地方散發出的神聖氛圍，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這裡肯定",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就是女神的神殿！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一路上歷經了各種辛勞，",
    "voice": "vo_adv_1008011_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總算是能接受女神的祝福了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……不過，",
    "voice": "vo_adv_1008011_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "目前感覺似乎還沒有受到祝福哪。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟在來神殿的途中有碰上測驗，",
    "voice": "vo_adv_1008011_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我想在這邊",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大概也有類似的東西要挑戰吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "愛梅斯神該不會，",
    "voice": "vo_adv_1008011_004",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是認為忍耐是種美德",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n的那一種女神吧……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "算了，",
    "voice": "vo_adv_1008011_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "反正傻傻站在這裡也不是辦法，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我們前進吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "根據聽到的消息，",
    "voice": "vo_adv_1008011_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這裡似乎有座女神像……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "並且還正好有個",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "供人參拜的空間呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "去祈求一下，",
    "voice": "vo_adv_1008011_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "希望能平安通過測驗吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也要",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了我祈禱喔！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "女神大人，",
    "voice": "vo_adv_1008011_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還請賜給我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美的祝福……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊……",
    "voice": "vo_adv_1008011_009",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "發光了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "難不成",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這就是祝福？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這光芒會不會有點太耀眼啦？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇、",
    "voice": "vo_adv_1008011_010",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇啊啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "510091"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在外頭處理完事情後，回到了家裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當他一打開自己房間的門──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有夠慢的。",
    "voice": "vo_adv_1008011_011",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然這麼晚才回來，你是做什麼去了？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還問為什麼呀。",
    "voice": "vo_adv_1008011_012",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我看了你的訊息，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這到底是什麼意思？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我原本可是很期待",
    "voice": "vo_adv_1008011_013",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "今天的約會，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "結果你竟然突然說要取消。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n比起看一長串的道歉文，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我更想要你親口說明，所以就跑來啦！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在你給出一個能接受的解釋前，",
    "voice": "vo_adv_1008011_014",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我可是不會回去的唷。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你為什麼想要逃跑、",
    "voice": "vo_adv_1008011_015",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呢！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "still",
    "still_id": "100801101"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好啦，",
    "voice": "vo_adv_1008011_016",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不會生氣的，就告訴我嘛？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "究竟是有什麼事，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比跟我約會還來得重要呢？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "欸，",
    "voice": "vo_adv_1008011_017",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "別把臉轉開啦。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好看著我的眼睛呀。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我呀，",
    "voice": "vo_adv_1008011_018",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "非～",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "常期待今天的喔？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不僅用玫瑰精油保養肌膚，",
    "voice": "vo_adv_1008011_019",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n還去了髮廊將頭髮弄得閃亮滑順，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也特地挑選可愛的衣服穿。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你應該看得出來吧？",
    "voice": "vo_adv_1008011_020",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n今天的我，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是比平常還要耀眼喔。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然而，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你卻……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "難得我特地想展示自己最美麗動人的模樣給你瞧瞧，",
    "voice": "vo_adv_1008011_021",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n結果你竟臨時說不來了……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這不像是你會做的事啊。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我問你……",
    "voice": "vo_adv_1008011_022",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "到底發生了什麼事？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你平時",
    "voice": "vo_adv_1008011_023",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是絕對不會做出這麼過分的事唷？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我希望",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你可以至少說明一下理由。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣呀。",
    "voice": "vo_adv_1008011_024",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "簡單來說，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n有其他學校的男同學誤以為",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你是我的男朋友，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n並在今天早上",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "突然就跑來找你一決高下，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後，",
    "voice": "vo_adv_1008011_025",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你不想讓我擔心，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就瞞著我私下去找對方談了……？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "結果對方一直不太能接受你的說詞，",
    "voice": "vo_adv_1008011_026",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但畢竟你又不是",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我真正的男朋友，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n所以也不敢表現得太強勢……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因此，",
    "voice": "vo_adv_1008011_027",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最後才會拖到這麼晚……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你後來還是有成功讓對方接受你的說詞了……？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此。",
    "voice": "vo_adv_1008011_028",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "確實很像你會做出的事。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然是為了可愛的我才這麼做的，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那也不能怪你了。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_1008011_029",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是下次再發生這種事，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "立刻通知我。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我會和你一起去找對方。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然實在是很懶得處理這種麻煩事，",
    "voice": "vo_adv_1008011_030",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但畢竟是我的可愛所引起的嘛。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唉，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我還真是",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "罪孽深重呀……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有了，",
