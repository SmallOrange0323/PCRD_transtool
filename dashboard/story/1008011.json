    "unit_id": 100832
  },
  {
    "type": "still",
    "still_id": "100801102"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的意思是，",
    "voice": "vo_adv_1008011_032",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「要不我們乾脆",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "交往吧？」",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這麼做的話，",
    "voice": "vo_adv_1008011_033",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也用不著再顧慮太多，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n而且以我的立場來看，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也能藉此避開不少搭訕，",
