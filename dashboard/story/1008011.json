    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過也是啦，",
    "voice": "vo_adv_1008011_035",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "被我這麼美麗的人逼近眼前，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "任誰都會是這種反應吧。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話說回來，",
