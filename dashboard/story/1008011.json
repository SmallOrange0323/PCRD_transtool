    "name": "雪",
    "words": "映照在你眼裡的我，",
    "voice": "vo_adv_1008011_037",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也就是",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "正在望著你的我，",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n真是格外美麗呢♪",
