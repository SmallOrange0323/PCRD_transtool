    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可不能眨眼喔♪",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為你得再讓我看更仔細一點。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n讓我好好看一下",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我那映照在你眼裡的美麗身影啊。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊啊，真是的！",
    "voice": "vo_adv_1008011_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "竟然斷在這麼精彩的地方……！",
