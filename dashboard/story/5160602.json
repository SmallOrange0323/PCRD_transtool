[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "正月で賑わうランドソルの繁華街を、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nモニカとメドゥーサは散策していた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "っくしゅん！",
    "voice": "vo_adv_5160602_000",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "蛇祭りのときは気づかなかったけど、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ランドソルって寒いわね……！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "この国の人たち、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "よくこんな寒い所で生きていけるわね……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむ、",
    "voice": "vo_adv_5160602_001",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "たしかに寒いが、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "この時期ならこれくらいは普通だな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nしのげないほどではあるまい。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nさらに寒い土地に暮らす人々もいることだし。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "うえぇ、",
    "voice": "vo_adv_5160602_002",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "信じられない……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "蛇には絶対に無理ね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ジオ・ゲヘナが快適なんて全然言えないけど、",
    "voice": "vo_adv_5160602_003",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n少なくともこんな凍えそうな目に遭ったことはないわ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ランドソルはいい所だけど、",
    "voice": "vo_adv_5160602_004",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "今はちょっとだけ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ジオ・ゲヘナの暑さが恋しいわね……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ならば其方にうってつけの店があるぞ。",
    "voice": "vo_adv_5160602_005",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "案内してやろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ちょうど腹も減ってきた頃だろう？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "別にいいけど。",
    "voice": "vo_adv_5160602_006",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アンタのことだから甘いもののお店でしょ？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "甘酒とかおしることか。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "お待たせしました、",
    "voice": "vo_adv_5160602_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "特製ボルケーノカレーです！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お、",
    "voice": "vo_adv_5160602_008",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "来た来た。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "熱いうちにいただくとしよう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "いや、",
    "voice": "vo_adv_5160602_009",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ちょっと待ちなさいよ！　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "これって激辛料理じゃない！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nジオ・ゲヘナのと同じくらい真っ赤だわ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "あぅ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "か、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "辛さが目に……！　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "こんなの食べられないわよ！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ん？　",
    "voice": "vo_adv_5160602_010",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうか。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ジオ・ゲヘナの貴族なら",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nこれくらいはあっさりと完食できると思ったのだが……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "まあ無理はするな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "其方の分も私が食べよう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "は、",
    "voice": "vo_adv_5160602_011",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "はぁ？　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "このアタシがこれくらいで退くはずがないじゃない！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n食べるわよ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "食べきってやるわよ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "はむっ。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "……ん、",
    "voice": "vo_adv_5160602_012",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "んんんん！　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "か、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "辛いいいいー！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "口の中がヒリヒリするし、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "一気に汗が噴き出してきた……！　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "この強烈さ、",
    "voice": "vo_adv_5160602_013",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ジオ・ゲヘナのご飯にも負けてないわよ。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nああ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "全身がカッカしてなんだか向こうにいるみたいだわ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "もしかしてモニカのヤツ、",
    "voice": "vo_adv_5160602_014",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nこのためにアタシを連れて来てくれたの？　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どうした？　",
    "voice": "vo_adv_5160602_015",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "手が止まってるぞ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "さすがに辛すぎたか？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふ、",
    "voice": "vo_adv_5160602_016",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふん。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "おいしくてちょっと感動してただけよ。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アンタこそ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ギブアップするなら今の内よ！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "は、",
    "voice": "vo_adv_5160602_017",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふうぅ……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どうにか食べきったが、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "口の中が熱くてたまらんな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あれを私より先に完食するとは、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "さすがだな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "と、",
    "voice": "vo_adv_5160602_018",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "当然よ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アタシを、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "だ、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "誰だと思ってるのよ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "あー辛かったぁ……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "今は確かに、",
    "voice": "vo_adv_5160602_019",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "冷え込む時期だが",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nだがいずれ季節が巡って暖かくなり、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "楽しいことも沢山待っている。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "だから",
    "voice": "vo_adv_5160602_020",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "もう少しだけ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "我慢してほしい。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "そうね。",
    "voice": "vo_adv_5160602_021",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "また寒さに耐えられなくなったら、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nまたあのカレーを食べるから大丈夫。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "もちろんアンタのおごりでね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふっ、",
    "voice": "vo_adv_5160602_022",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "了解した。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "その時はさらに辛さ増し増しを食わせてやろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "の、",
    "voice": "vo_adv_5160602_023",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "望むところよ……！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "こうしてモニカの荒療治によって",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nメドゥーサのホームシックは見事解消されたのだった。",
    "voice": null,
    "unit_id": null
  }
]
