    "name": "流夏",
    "words": "這傢伙不好對付。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果貿然使用忍法刺激牠，反而會適得其反。",
