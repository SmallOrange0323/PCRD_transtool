  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人打敗許多魔物一邊往上前進的途中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n新的強敵再次阻擋了他們的去路。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈啊，",
    "voice": "vo_adv_7011004_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一隻接一隻來，真是不讓人閒著啊。",
