    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會從基礎開始教妳。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……咦？",
    "voice": "vo_adv_7011004_026",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以答應我。",
