[
  {
    "type": "background",
    "bg_id": "500960"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呵、",
    "voice": "vo_adv_5038603_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "完成了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n終於完成了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "同志。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "來吧，",
    "voice": "vo_adv_5038603_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好好看清楚。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這就是「好朋友X　Mk-Ⅱ」。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就是我們透過上次的經驗，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所學習到的結晶！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒錯。",
    "voice": "vo_adv_5038603_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好朋友X初號機需要改善的地方，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就在於過於龐大的身軀。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n又不是軍事兵器，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真的有需要那麼做到那麼大嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我也沒有財團的那種預算和設備。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當然，",
    "voice": "vo_adv_5038603_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這可不是因為妥協，才把它縮小的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就讓我來正面反駁",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "大能兼小的這種謬論吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這次搭載的各種功能，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "都比初號機還要來得更加先進。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "比如說這個鯛魚燒加農砲。",
    "voice": "vo_adv_5038603_004",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這部分",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "反映了市場調查的結果。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n能夠避免因顧客需求不同而引起的非必要戰爭。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是可以選擇紅豆餡、豆沙餡。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呵呵。",
    "voice": "vo_adv_5038603_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n看起來學弟，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好像嚇到嘴巴都闔不上了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不過，還有很多我重新修改過的功能。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "以麥酒水柱為例。",
    "voice": "vo_adv_5038603_006",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n為了避免過度攝取，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一旦發現使超過一定的用量，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n健康促進系統就會啟動，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "自動切換成熱湯。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然後，",
    "voice": "vo_adv_5038603_007",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "初號機的亮點，也就是說話功能。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這部分則是因應近來的寵物風潮，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n升級成可說是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "高級版本的散步功能。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "它只要偵測到動作反應，就會發出",
    "voice": "vo_adv_5038603_008",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「切嚕～☆」等叫聲，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n並且乖乖地跟在主人後方約三步的距離的功能。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為散步所以是三步啦，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "怎麼樣呀。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？　",
    "voice": "vo_adv_5038603_009",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "喂喂，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "等一下，學弟。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你要去哪裡，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "新功能的說明還沒結束呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什麼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "上課？　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊～",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我忘記一般學生還要上課……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒辦法。",
    "voice": "vo_adv_5038603_010",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那麼",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「好朋友X　Mk-Ⅱ」，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "跟在他後面吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你可要好好地疼愛它哦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？　",
    "voice": "vo_adv_5038603_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊～不，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n因為在我製作的過程中，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你也有幫忙……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "應該說，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原本就是為了你才製作的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": "vo_adv_5038603_012",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想要感謝你平日的照顧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這就是所謂的禮物。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "身為共同研究者……",
    "voice": "vo_adv_5038603_013",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "身為我的第一個朋友的你，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不論在現實或在精神上，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "都給了我許多照顧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但是，",
    "voice": "vo_adv_5038603_014",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "誠如你所知，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我很不擅長表達自己的情感。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n也不是說因為害羞，才說不出謝謝這兩個字，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n純粹是我有自覺自己不擅長察覺應該道謝的時機。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不論是在過去，",
    "voice": "vo_adv_5038603_015",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "甚至於是從今以後的日子，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我想如此遲鈍的我，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對你的感謝一定都遠遠不足。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想把這個送給你，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "來表達我的感謝。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "至於，",
    "voice": "vo_adv_5038603_016",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你究竟會不會喜歡這個禮物，這就是另外一個問題了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那已經不屬於我的責任範圍。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n書上也說，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "送禮物的心意，本身就已經是禮物了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個是我真心誠意所做出來的，",
    "voice": "vo_adv_5038603_017",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "全世界獨一無二的心意。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n如果你願意收下，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是我的榮幸。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_5038603_018",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是以後還請多多指教。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "鞠躬。",
    "voice": null,
    "unit_id": 111011
  }
]
