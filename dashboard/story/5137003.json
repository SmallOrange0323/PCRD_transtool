    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_5137003_068",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就算我這麼問，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你也很困擾吧？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我明白優衣的心情。",
    "voice": "vo_adv_5137003_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但現在的情況還滿緊急的。",
