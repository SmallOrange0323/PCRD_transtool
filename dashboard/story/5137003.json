[
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}來到了厄莉絲的夢中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n出現在他面前的是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……對不起，",
    "voice": "vo_adv_5137003_000",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n突然請你過來一趟。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為久違地能見到面，",
    "voice": "vo_adv_5137003_001",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "忍不住就……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生……",
    "voice": "vo_adv_5137003_002",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "太好了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗯……",
    "voice": "vo_adv_5137003_003",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n她向我道歉了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "跟之前一樣裝作好孩子說些漂亮話……",
    "voice": "vo_adv_5137003_004",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一直把自己的想法強加於我。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可是……",
    "voice": "vo_adv_5137003_005",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即使讓騎士先生的紀錄流入她的腦海中，",
    "voice": "vo_adv_5137003_006",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "她卻還是一樣。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n抬頭正眼看向了我。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……比起這個，",
    "voice": "vo_adv_5137003_007",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你過得好嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我的話……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想想，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "該怎麼說好呢……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……嗯。",
    "voice": "vo_adv_5137003_008",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n角色的保護與修復……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n兼具兩者的功能。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是出自對我的憐憫或者同情……",
    "voice": "vo_adv_5137003_009",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還是想要我為差點將世界給破壞掉一事贖罪。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我並不曉得是因為什麼。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……但我並沒有消失。",
    "voice": "vo_adv_5137003_010",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n唯有這一點是事實。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是這樣",
    "voice": "vo_adv_5137003_011",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "的嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "既然騎士先生都這麼說了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n那麼或許是吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……因為無論何時。",
    "voice": "vo_adv_5137003_012",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n騎士先生總是會幫助他人。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "現在也是。",
    "voice": "vo_adv_5137003_013",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n你為了幫助與你毫無關係的兩個人而在努力著。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "明明對方並不是這個世界的存在。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……我說，",
    "voice": "vo_adv_5137003_014",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我可以說點",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "壞心眼的話嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……我問你。",
    "voice": "vo_adv_5137003_015",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "幫助那兩個人，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "意味著什麼呢？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我很清楚。",
    "voice": "vo_adv_5137003_016",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n回到自己的世界之後，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "她們會變成怎麼樣……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只能一直看著某個人，",
    "voice": "vo_adv_5137003_017",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n在自己無法觸及的地方受到傷害。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就這樣無數次地反覆循環……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "連結束都不被允許。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我認為……",
    "voice": "vo_adv_5137003_018",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這是一件非常痛苦的事。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "讓她們回到那種地方。",
    "voice": "vo_adv_5137003_019",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n真的可以說",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是在幫助她們嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我很清楚，",
    "voice": "vo_adv_5137003_020",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那兩個人都還沒有放棄。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可是即使如此……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那又能做到什麼呢，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過……？",
    "voice": "vo_adv_5137003_021",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……",
    "voice": "vo_adv_5137003_022",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……我們也無法擅自決定她們的未來。",
    "voice": "vo_adv_5137003_023",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "意思是，那兩個人的未來……",
    "voice": "vo_adv_5137003_024",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n只有那兩個人，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "才會知道嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……",
    "voice": "vo_adv_5137003_025",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對不起，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我說了些壞心眼的話。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生果然很厲害呢。",
    "voice": "vo_adv_5137003_026",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n面對跟這個世界毫無關係的人，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你還是會溫柔對待……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "咦……？",
    "voice": "vo_adv_5137003_027",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_5137003_028",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……這樣啊。",
    "voice": "vo_adv_5137003_029",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是啊……",
    "voice": "vo_adv_5137003_030",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n你依然是騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生還真是，",
    "voice": "vo_adv_5137003_031",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n一點都沒變呢。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生",
    "voice": "vo_adv_5137003_032",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "無論對方是誰，都會願意出手相助。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只要有人遇到困難，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就一定會這麼做。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就連壞人也會幫助，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只會對壞事加以斥責。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "他肯定",
    "voice": "vo_adv_5137003_033",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會接受所有一切。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "他讓我，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有這樣的想法。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……即使是像我這種人。",
    "voice": "vo_adv_5137003_034",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n即使是我這種嚴重扭曲且不確定的存在。",
