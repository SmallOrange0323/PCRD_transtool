  {
    "type": "background",
    "bg_id": "501623"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你說傳達過去了，",
    "voice": "vo_adv_5137003_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你這個人啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……這樣啊。",
    "voice": "vo_adv_5137003_073",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "既然如此，",
