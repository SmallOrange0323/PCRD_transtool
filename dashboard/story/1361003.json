    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "耍得團團轉的感覺，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n但跟這比起來，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "身為偶像，能舉辦演唱會這件事更讓我感到開心嘛。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "所以直到演唱會開始前，",
