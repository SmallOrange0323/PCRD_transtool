  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "如果完全沒有準備",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而被迫上場的話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我認為",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "即使中止或延期也是沒有辦法的事。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "不。",
    "voice": "vo_adv_1361003_013",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "不會中止也不會延期。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n我會舉辦個人演唱會喔，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "薇歐莉特。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "既然決定要辦，",
