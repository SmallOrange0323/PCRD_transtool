  {
    "type": "dialogue",
    "name": "旁白",
    "words": "收到了來自法蘭秀秀製作人的聯絡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n關於聯絡內容提及的事，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n櫻正打算向{0}詢問一下意見。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "其實，",
    "voice": "vo_adv_1361003_000",
    "unit_id": 136111
  },
  {
