  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "那應該就沒問題吧。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "比起我的事情……",
    "voice": "vo_adv_1361003_012",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "櫻小姐您",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "打算怎麼辦呢？",
