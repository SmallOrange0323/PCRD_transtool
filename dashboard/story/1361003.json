    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這真是太棒了呢，",
    "voice": "vo_adv_1361003_001",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "櫻小姐。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請務必也讓我",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "來觀賞您的演唱會。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請問演唱會的",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "日期是什麼時候呢？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "演唱會的舉辦日……",
    "voice": "vo_adv_1361003_002",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "就是今天！！！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "您是說……",
    "voice": "vo_adv_1361003_003",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "今天嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "沒錯，",
    "voice": "vo_adv_1361003_004",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "就是今天。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "總是這樣。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "老是那麼突然。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n每次都是當天才講！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "呼……",
    "voice": "vo_adv_1361003_005",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "話說回來，薇歐莉特，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n妳待在這裡沒關係嗎？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n以公主的身分來說。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒問題。",
    "voice": "vo_adv_1361003_006",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我是瞞著格蕾斯──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "瞞著我的護衛騎士",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "過來的。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "嗯，",
    "voice": "vo_adv_1361003_007",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "這可不叫做沒問題哦。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "…………",
    "voice": "vo_adv_1361003_008",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "呵呵──",
    "voice": "vo_adv_1361003_009",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯的話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一定馬上就能找到我的。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這是她平時讓我困擾的回禮，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而且更重要的是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我還想再與櫻小姐及",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生見面啊。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "妳真是說了讓人開心的話呢～",
    "voice": "vo_adv_1361003_010",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "薇歐莉特。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "不過……",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "真的沒問題嗎，",
