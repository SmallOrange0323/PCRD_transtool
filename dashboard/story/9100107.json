  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "唔……",
    "voice": "vo_adv_9100107_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n變成靈體無法好好戰鬥……！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "宮……",
    "voice": "vo_adv_9100107_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "不對，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "忍，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "妳還好嗎～！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "唔唔，",
    "voice": "vo_adv_9100107_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "的確，一直維持在身體交換的狀態下，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "會有極限呢……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n該怎麼辦……！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "妖精",
    "words": "啾啾啾！",
    "voice": "vo_adv_9100107_003",
    "unit_id": 15511
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "咦？",
    "voice": "vo_adv_9100107_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "那傢伙是",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "偷吃的愛吃鬼妖精喲！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n牠為什麼在灑點心來的？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n布丁呢？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "有布丁嗎～！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "弓箭",
    "words": "……！",
    "voice": null,
    "unit_id": 13811
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "啊！",
    "voice": "vo_adv_9100107_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "姐姐，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "弓箭的注意力被點心吸走了！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n它是要吃嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "但它沒有嘴巴耶。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這、",
    "voice": "vo_adv_9100107_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這部分我不太清楚呢……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不過幫大忙了！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "牠",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "幫助了我們呢……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵呵，",
    "voice": "vo_adv_9100107_007",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "有多少幫到忙了嗎？",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "幸好有將店裡",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "所有的點心都帶來。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "啊──！",
    "voice": "vo_adv_9100107_008",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "是老婆婆喲～！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n宮子的布丁呢！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "有帶來嗎～！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "哎呀呀，宮子？",
    "voice": "vo_adv_9100107_009",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n妳在不知不覺間",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "變得相當嬌小了呢……",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n到底",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我、",
    "voice": "vo_adv_9100107_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我覺得她變化的程度不是用變嬌小就能帶過的耶……！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那個！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "其實我們",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "靈魂交換了──",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "弓箭",
    "words": "──！",
    "voice": null,
    "unit_id": 13811
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "唔哇啊啊！？",
    "voice": "vo_adv_9100107_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "啾啾……？",
    "voice": "vo_adv_9100107_012",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n啾！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n啾啾啾───！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "茜里？",
    "words": "唔！？",
    "voice": "vo_adv_9100107_013",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里？",
    "words": "看樣子身體又交換了哪～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里？",
    "words": "唔唔唔……！",
    "voice": "vo_adv_9100107_014",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里？",
    "words": "\\n真希望",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里？",
    "words": "至少讓我變成那邊那位發育比較好的啊……！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "就算真的讓你如願，",
    "voice": "vo_adv_9100107_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "如果亂摸就是犯罪喔，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "爸爸。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "妖精？",
    "words": "啾啾！\\n（雖然沒辦法說話，但宮子要布丁喲～！）",
    "voice": "vo_adv_9100107_016",
    "unit_id": 15511
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_9100107_017",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "宮子不管變成什麼樣子，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "都最喜歡布丁呢。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "又、",
    "voice": "vo_adv_9100107_018",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "又交換身體了……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "雖然用點心吸引了它的注意力，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "但一轉眼就被吃光了呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "\\n看來點心相當好吃呢……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "老婆婆？",
    "words": "討厭～！",
    "voice": "vo_adv_9100107_019",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "老婆婆？",
    "words": "怎麼辦～！",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "老婆婆？",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "老婆婆？",
    "words": "一點都不了解姐姐之外的",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "老婆婆？",
    "words": "身體啊～！",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "什……",
    "voice": "vo_adv_9100107_020",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "喂，茜里！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "\\n妳不要用別人的身體說些奇怪的話呀！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "這樣老婆婆很可憐耶！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "唔唔唔～！",
    "voice": "vo_adv_9100107_021",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "我已經莫名其妙了啦～！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "\\n誰快來想想辦法啊～～～！！",
    "voice": null,
    "unit_id": 103111
  }
]
