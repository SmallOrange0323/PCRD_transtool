[
  {
    "type": "background",
    "bg_id": "501033"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夜幕降臨，海岸籠罩在一片寂靜之中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和可可蘿眺望著海浪靜靜拍打岸邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "海浪現在很平穩，",
    "voice": "vo_adv_1076008_000",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們出發吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您準備好了嗎？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……那麼，",
    "voice": "vo_adv_1076008_001",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓在下來施展精靈的加護──",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哎呀？",
    "voice": "vo_adv_1076008_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們是……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您是……",
    "voice": "vo_adv_1076008_003",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "海之家的……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "喔，",
    "voice": "vo_adv_1076008_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "果然是你們。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "這麼晚了還待在海邊？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1076008_005",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們接下來，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要前往被稱為",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「星海」的海溝。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "「星海」",
    "voice": "vo_adv_1076008_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n上次聽到這個名字……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "不知道已經是幾年前了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦？",
    "voice": "vo_adv_1076008_007",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下聽說",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個地方在這一帶很有名……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "嗯。",
    "voice": "vo_adv_1076008_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "之前是這樣沒錯。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n只是最近",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "都沒什麼人提起了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是怎麼一回事？",
    "voice": "vo_adv_1076008_009",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n根據文獻記載，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那邊有著很棒的景色，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難道事實並非如此嗎……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "不。",
    "voice": "vo_adv_1076008_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "那裡過去確實就像文獻裡記載的一樣吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "妳應該知道那座海溝有獨特的海洋生物吧？",
    "voice": "vo_adv_1076008_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "那些生物的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "身體會發出光芒，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "就像是在歡迎來訪者一樣。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "發出的光芒能把附近一帶全都照亮……",
    "voice": "vo_adv_1076008_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "彷彿就像是置身於繁星之中。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "所以，",
    "voice": "vo_adv_1076008_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "那裡之前才會被稱為「星海」。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "不過，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "現在那些海洋生物已經不會發光了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼會……",
    "voice": "vo_adv_1076008_014",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為什麼會這樣呢？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "這也只是我聽說的……",
    "voice": "vo_adv_1076008_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n那裡的海洋生物",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "目前似乎很衰弱……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "「星海」那個地方，",
    "voice": "vo_adv_1076008_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "即使使用能在水中行動的魔法，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n要過去也相當不容易。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "每年",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "觀光客的人數都在減少……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "住在那裡的生物",
    "voice": "vo_adv_1076008_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "都很親人……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "人越來越少，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "同時也讓牠們感到不安而日漸衰弱。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "這類的傳聞傳開之後，",
    "voice": "vo_adv_1076008_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "去的人又更少了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "所以，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "「星海」現在已經",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "被人們遺忘了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來",
    "voice": "vo_adv_1076008_019",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是這樣……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "就連最後一次聽說有人去，",
    "voice": "vo_adv_1076008_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "都已經是好幾年前的事情了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n沒人知道那裡現在的情況。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "這樣你們還想去嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……當然要去。",
    "voice": "vo_adv_1076008_021",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下已經",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "發誓要帶主公大人",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "前往「星海」了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算",
    "voice": "vo_adv_1076008_022",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知道那裡會有什麼景象在等著我們，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要有一絲可能性，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就想",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "過去親眼看看。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是",
    "voice": "vo_adv_1076008_023",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下身為嚮導的任務，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "同時也是主公大人的冒險。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "……這樣啊。",
    "voice": "vo_adv_1076008_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "那我就沒有理由阻止你們了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "碰到你們也是緣分，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "跟我來吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "background",
    "bg_id": "500842"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝您",
    "voice": "vo_adv_1076008_025",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "特地為了我們開船出海。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "嗯，",
    "voice": "vo_adv_1076008_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "不用客氣啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "我通常都是開這艘船到海之家的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "只是稍微繞個路而已。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_1076008_027",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來運氣是站在我們這邊的。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這肯定是",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛梅斯大人的引導。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「星海」……",
    "voice": "vo_adv_1076008_028",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到底會是怎樣的景象呢……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是……！",
    "voice": "vo_adv_1076008_029",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "好，",
    "voice": "vo_adv_1076008_030",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "我們到了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "這裡是海溝的正上方。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n你們直接潛下去就行了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "我會把繩索垂下去，",
    "voice": "vo_adv_1076008_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "你們就順著它下潛吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "想回來就拉個繩索通知我。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝您為我們做了這麼多。",
    "voice": "vo_adv_1076008_032",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們一定會",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看到那美麗的景象的。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼主公大人，",
    "voice": "vo_adv_1076008_033",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們就手牽手",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一起前往「星海」吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "風之精靈啊……！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1076008_034",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "根據文獻記載，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n「星海」應該就在",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個深度才對……？　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "連月光都照不進來，",
    "voice": "vo_adv_1076008_035",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "四周一片黑暗……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "住在這道海溝裡的生物",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的都很虛弱……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……？",
    "voice": "vo_adv_1076008_036",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……您說得對。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在放棄還太早了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是沒人來訪才造成這種情況，",
    "voice": "vo_adv_1076008_037",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那我們或許該",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "通知一下牠們有人來了……！　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下會把治癒之風包覆在泡泡中，",
    "voice": "vo_adv_1076008_038",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "送往這一帶的海域。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接著將精靈的加護",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "注入這把槍……！　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定要讓主公大人",
    "voice": "vo_adv_1076008_039",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "親眼見到「星海」！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喝──！！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哇……！",
    "voice": "vo_adv_1076008_040",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這就是……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這就是「星海」……！　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": "vo_adv_1076008_041",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您看到了嗎……？　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人的聲音……？",
    "voice": "vo_adv_1076008_042",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為什麼會在海裡……？　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1076008_043",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛剛聽到了在下的聲音……？　",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1076008_044",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有聽到在下的聲音嗎？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喔喔，",
    "voice": "vo_adv_1076008_045",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太驚人了……！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "之前使用凱留小姐的魔法時",
    "voice": "vo_adv_1076008_046",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還沒辦法對話……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但或許是風之加護的效果，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "使聲音被包覆氣泡之中，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此才能聽到彼此的說話聲。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這才讓我們得以，",
    "voice": "vo_adv_1076008_047",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n用言語來分享",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "眼前這幅景象的美麗……！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請看，",
    "voice": "vo_adv_1076008_048",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n星星……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這些閃閃發光的海洋生物，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就像是在歡迎我們一樣，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "開始游了起來。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "風的氣息",
    "voice": "vo_adv_1076008_049",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "充滿了海溝這一帶。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠們都順利恢復了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊……",
    "voice": "vo_adv_1076008_050",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是美麗的景色♪",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這全都",
    "voice": "vo_adv_1076008_051",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "託主公大人的福……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為侍奉在主公大人的身邊，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下才有機會看到",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這幅景象。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人的存在賜予了在下力量，",
    "voice": "vo_adv_1076008_052",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n將在下這個嚮導",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "帶到了之前在村落裡生活時，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從來沒想像過的地方。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "除了這裡之外，",
    "voice": "vo_adv_1076008_053",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個世界想必還有",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很多美妙的地方。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下希望和您一起遊歷各個景點，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和您一起繼續成長。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然後，",
    "voice": "vo_adv_1076008_054",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有朝一日……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n希望我們能一起越過天空，拜訪天空上方的廣大空間……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並不僅僅是比喻，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那裡有著真正的",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「星海」。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的！",
    "voice": "vo_adv_1076008_055",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了實現這個目標，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下身為嚮導，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定會盡自己的微薄之力支援您。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來吧，",
    "voice": "vo_adv_1076008_056",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "期盼未知的冒險的同時，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也別忘了",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "享受",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當下的美麗景色。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這就是",
    "voice": "vo_adv_1076008_057",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們在這個夏天",
    "voice": null,
    "unit_id": 107611
  },
