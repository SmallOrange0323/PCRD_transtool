    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會如此感嘆，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "無論是什麼樣的人，神明都會賜予才能呢。",
