    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而對於{0}來說，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就是指遊戲。",
