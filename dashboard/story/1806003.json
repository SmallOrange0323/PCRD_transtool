  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "快點，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其他人也是。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "可、",
    "voice": "vo_adv_1806003_087",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "可是……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
