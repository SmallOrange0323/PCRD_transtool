    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "不過嘛，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "留得青山在不怕沒柴燒。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n走吧，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "小姑娘。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "趁還沒傷著的時候趕快逃吧！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒問題的，",
    "voice": "vo_adv_1806003_033",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡就交給我！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n哈啊啊啊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "嚇了我一跳……",
    "voice": "vo_adv_1806003_034",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "小姑娘妳真的很厲害呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該不是只有那一隻而已對吧？",
    "voice": "vo_adv_1806003_035",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如果不徹底根除的話，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就沒有意義了。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "村裡的男人們",
    "voice": "vo_adv_1806003_036",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "是有追查到魔物巢穴所在的森林……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_1806003_037",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我去去就回。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那裡很危險，請不要讓村裡的人靠近。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "可千萬不要勉強自己呀，",
    "voice": "vo_adv_1806003_038",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "小姑娘！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉～",
    "voice": "vo_adv_1806003_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還以為會被抱怨說也太慢來，",
    "voice": "vo_adv_1806003_040",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n反而讓人摸不著頭緒呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不知道是不是有什麼隱情。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且，",
    "voice": "vo_adv_1806003_041",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在村子裡打倒的魔物也不是什麼厲害的傢伙，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果是找麻煩的話也太弱了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可不能大意呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "數量倒是真的多到很麻煩。",
    "voice": "vo_adv_1806003_042",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼一大群的魔物都放著不管，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n【王宮騎士團】到底是多缺人手啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕快收拾掉吧。",
    "voice": "vo_adv_1806003_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我可不想因為手腳太慢就被王宮的那些人嘮叨呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "替我強化吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可是一隻都不會放過的，納命來吧！",
    "voice": "vo_adv_1806003_044",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喝啊啊啊啊！！",
    "voice": "vo_adv_1806003_045",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是這點程度嗎。",
    "voice": "vo_adv_1806003_046",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n數量是多了點，但也沒什麼嘛。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼哼，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "王宮的那些人也太小看我了吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": "vo_adv_1806003_047",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "回去村子裡報告吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "清得這麼徹底，應該不會被抱怨了吧。",
