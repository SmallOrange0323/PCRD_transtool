    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……沒事的。",
    "voice": "vo_adv_1806003_084",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n婆婆妳跟大家一起躲起來。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳、",
    "voice": "vo_adv_1806003_085",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳在說什麼？",
