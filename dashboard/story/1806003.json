  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "真是的，",
    "voice": "vo_adv_1806003_032",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "好不容易才開始稍微收拾的。",
