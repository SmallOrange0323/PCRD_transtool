  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "像往常那樣逃跑就……",
