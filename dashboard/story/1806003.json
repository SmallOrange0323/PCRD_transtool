    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟那些都沒關係。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "遇到有困難的人，",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以出手幫助。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就只是這樣而已。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你讓那些對我好的人感到困擾，",
    "voice": "vo_adv_1806003_108",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以──",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就讓你後悔出現在我的眼前！",
    "voice": "vo_adv_1806003_109",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n消失吧！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喝啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1806003_110",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算你想逃我也不會放過你的！",
    "voice": "vo_adv_1806003_111",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說過會讓你消失的吧！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n吃我這招！！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "深淵終結……",
    "voice": "vo_adv_1806003_112",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "炸裂────！！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈啊……",
    "voice": "vo_adv_1806003_113",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總算打倒了。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我還想說都已經那樣放話了，要是打不倒該怎麼辦呢。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵、",
    "voice": "vo_adv_1806003_114",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵死了！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那種事情不用一一說出來！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過……",
    "voice": "vo_adv_1806003_115",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也相信跟你一起就沒有問題。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "謝……",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔、",
    "voice": "vo_adv_1806003_116",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的很會挑時間呢……",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "肚子雖然餓到不行了，",
    "voice": "vo_adv_1806003_117",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但還是快點讓村子的人放心下來吧。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到時候應該就能好好地，",
    "voice": "vo_adv_1806003_118",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "打從心底，",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟大家一起感受喜悅了。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這樣說著並朝向通往村莊的道路踏出步伐的凱留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n臉上是從未有過的開朗表情。",
    "voice": null,
    "unit_id": null
  }
]
