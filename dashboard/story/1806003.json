    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺會造成很嚴重的災害呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們要盡全力把它打倒！",
    "voice": "vo_adv_1806003_099",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯，",
    "voice": "vo_adv_1806003_100",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全力以赴。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要盡早讓村子裡的人安心才行呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "500271"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……\\n……",
    "voice": "vo_adv_1806003_101",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……全新的鑰匙。",
    "voice": "vo_adv_1806003_102",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n自萬象之塔頂端，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "至天之盡頭而去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "寧靜而深沉地，",
    "voice": "vo_adv_1806003_103",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n朝向已解放的心靈深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n詠唱吧──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算只有一點也好，",
    "voice": "vo_adv_1806003_104",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也要追上你。",
