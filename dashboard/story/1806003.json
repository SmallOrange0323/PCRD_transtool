  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還以為自己多少有改變了，",
    "voice": "vo_adv_1806003_070",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n沒想到，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還真是一點都沒變呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "像{0}這樣",
    "voice": "vo_adv_1806003_071",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "天生的善意，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我是無論如何都做不到的呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想，{0}一定",
    "voice": "vo_adv_1806003_072",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完全沒有考慮自己的事，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n全心關切著",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "眼前那些有困擾的人吧……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是我也能變成那樣就好了。",
    "voice": "vo_adv_1806003_073",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然想是這麼想……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
