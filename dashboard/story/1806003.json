    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們回來了。",
    "voice": "vo_adv_1806003_048",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "小姑娘！",
    "voice": "vo_adv_1806003_049",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳沒事嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這麼早就回來了，果然是沒辦法嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1806003_050",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "沒事，",
    "voice": "vo_adv_1806003_051",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳平安回來就好了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n別放在心上。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，",
    "voice": "vo_adv_1806003_052",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魔物幾乎都打倒了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n暫時應該不用擔心了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "你們聽到了嗎！？",
    "voice": "vo_adv_1806003_053",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n這個小姑娘幫我們把魔物都給打倒了呀！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "真的嗎！",
    "voice": "vo_adv_1806003_054",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "森林安全了的話，",
    "voice": "vo_adv_1806003_055",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "就可以摘採水果了呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n這樣村子也暫時能有點收穫了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1806003_056",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是你們還沒去森林看過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我說不定是騙人的……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "是騙人的嗎？",
    "voice": "vo_adv_1806003_057",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是、",
    "voice": "vo_adv_1806003_058",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是沒有騙人啦……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這樣啊，",
    "voice": "vo_adv_1806003_059",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那不就放心了嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話是",
    "voice": "vo_adv_1806003_060",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣子，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯啦……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "現在就帶上村裡的男人們去森林吧。",
    "voice": "vo_adv_1806003_061",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "去找找可以賣的東西，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "補貼毀掉的作物收入啊！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "是呢！",
    "voice": "vo_adv_1806003_062",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "得去把大家叫來才行！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "真的很謝謝妳！",
    "voice": "vo_adv_1806003_063",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1806003_064",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不會……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "still",
    "still_id": "180600301"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大家毫不懷疑地就跟我道謝了……",
    "voice": "vo_adv_1806003_065",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我之前還想那麼多，真像個笨蛋。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說回來，",
    "voice": "vo_adv_1806003_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我難道是在懷疑這些人嗎？　",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一直以為是王宮那邊來找麻煩的，",
    "voice": "vo_adv_1806003_067",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "浪費力氣在那邊防備……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也沒有考慮到這些真的有困難的人，",
    "voice": "vo_adv_1806003_068",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只想著自己的事。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是，",
    "voice": "vo_adv_1806003_069",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的個性本來就是這個樣子。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一直怕東怕西、懦弱的背叛者……",
