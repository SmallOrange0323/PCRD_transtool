  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "難不成，",
    "voice": "vo_adv_9010008_013",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳打算全部都吃嗎……？",
