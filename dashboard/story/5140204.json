[
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "奇怪……",
    "voice": "vo_adv_5140204_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "暫停──等一下。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳們不覺得……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這一帶的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "氣氛好像哪裡怪怪的嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔，",
    "voice": "vo_adv_5140204_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個不吉利的鐘聲是……！？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不好了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "諸位，快躲起來！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "♪聖～～",
    "voice": "vo_adv_5140204_002",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "德蕾莎～",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "女子～學～院──",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "噫欸！",
    "voice": "vo_adv_5140204_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n剛才應該已經被我們打倒的魔王，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "正一臉平靜地若無其事走著！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "「逃犯們＜那群傢伙＞」是跑哪去了……",
    "voice": "vo_adv_5140204_004",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "啊啊──",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "一找到就要把她們處以「斬首刑＜斷頭＞」，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "還想玩玩\\n把砍斷的「頭顱＜臉部＞」拿來踢的「球類運動＜遊戲＞」呢，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "呵哈哈哈！",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "糟糕，",
    "voice": "vo_adv_5140204_005",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她還活蹦亂跳的呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "皮膚也充滿了光澤呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "剛才的戰鬥，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "到底是有多優待新手啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這下不妙，",
    "voice": "vo_adv_5140204_006",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在兩種意義上都要加快動作。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "現在絕對不能被富美惠修女抓住，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要是拖得太久，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "公會管理協會也會碎碎唸的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也對，",
    "voice": "vo_adv_5140204_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "總之",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "快點前往「飛翔切嚕號」吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "墨團的飛空艇，",
    "voice": "vo_adv_5140204_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是叫這個名字的嗎？",
    "voice": null,
    "unit_id": 110811
  }
]
