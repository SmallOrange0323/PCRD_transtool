[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在城中購物時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n發現了似乎很高興的禊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1004009_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊一直都很想要這種魔物的擺飾呢～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "看來這下子又能對哥哥惡作劇了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥會露出怎樣的表情呢？",
    "voice": "vo_adv_1004009_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊等不及想看看了～♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……啊，",
    "voice": "vo_adv_1004009_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過禊在陷阱地洞裡出不來的時候，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好像是哥哥他",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "救禊出來的。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "他那時似乎很努力地在找禊……",
    "voice": "vo_adv_1004009_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n平常也總是願意陪禊一起玩……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是不是應該送他什麼回禮比較好呢？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇！？",
    "voice": "vo_adv_1004009_004",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "原來是哥哥啊～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你才是呢，在這種地方做什麼呀？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是什麼？",
    "voice": "vo_adv_1004009_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這不是這附近的地圖嗎？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這種東西根本沒必要……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n上面好像有很多標記。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個標記該不會是！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇！",
    "voice": "vo_adv_1004009_006",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好棒好棒！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真好呢～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": "vo_adv_1004009_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但是哥哥你說",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是你買的對吧？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "總覺得這張地圖還挺新的……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你是不是被騙了呀？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1004009_008",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼真的是貨真價實的藏寶圖嗎～？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n而且比較大的標記是在很遠的山，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "搞不好真的有寶藏在那裡呢……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯～",
    "voice": "vo_adv_1004009_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不去確認看看是不會知道的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們兩人一起去確認吧！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥你也是禊探險隊的一員，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可不能獨占寶物哦！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": "vo_adv_1004009_010",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "原來是那樣嗎？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那你要先說嘛～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n欸嘿嘿。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼禊探險隊，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "出發～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "雖然很小，",
    "voice": "vo_adv_1004009_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但這裡也是有叉叉記號的地點呢。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這種地方會有寶物嗎～？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "明明聽說能一夜致富的，",
    "voice": "vo_adv_1004009_012",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n結果根本找不到魔石嘛！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這樣看來果然我們也該去山上……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我剛才不是說過了嗎？",
    "voice": "vo_adv_1004009_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那邊已經被挖得一乾二淨了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n既然如此，還不如在礦脈的周邊尋找還比較有希望。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "只要能找到幾顆，就能夠賺到錢了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "唉……",
    "voice": "vo_adv_1004009_014",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "知道了啦。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004009_015",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那些人好像也在找寶物！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們也不能輸給他們！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "才沒那回事呢！",
    "voice": "vo_adv_1004009_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "既然不在這裡的話，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們就去其他地方找找看吧！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要走囉，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯～",
    "voice": "vo_adv_1004009_017",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這裡好像也沒有。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "完全找不到呢～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "老大，",
    "voice": "vo_adv_1004009_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "差不多該放棄了吧～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n都已經這麼努力地找了，卻還是找不到，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n看來這裡已經沒有希望了啦～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "吵死了！",
    "voice": "vo_adv_1004009_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "再挖深一點的話，搞不好就能找到了不是嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "\\n有時間動嘴巴的話，還不如快給我動手！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004009_020",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "又有在找寶物的人了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但是果然這裡也沒有嗎～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "啊？",
    "voice": "vo_adv_1004009_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "為什麼有小鬼在這裡？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "會不會是在玩的時候迷路到這裡了？",
    "voice": "vo_adv_1004009_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "才不是呢！",
    "voice": "vo_adv_1004009_023",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們是來找寶物的～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "妳說什麼？",
    "voice": "vo_adv_1004009_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "妳以為你們這些小鬼，用那種玩耍的心態能找到嗎！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "\\n就連我們這麼努力地找可都找不到啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "老、",
    "voice": "vo_adv_1004009_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "老大！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "稍微冷靜點吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n就算遷怒小孩子也是找不到的啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "吵死了！",
    "voice": "vo_adv_1004009_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "我們去別的地方找，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性4",
    "words": "跟我來！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "是、",
    "voice": "vo_adv_1004009_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "是的！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "真不好意思啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n老大",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "他因為在山上四處找了很久還是沒有收穫，所以變得有些暴躁。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n那就再見了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為什麼大家這麼急躁呢～？",
