  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "可惡可惡可惡啊啊！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看來是有效了。",
    "voice": "vo_adv_5017321_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "用拉姆的魔法來追擊他……！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請等一下，",
    "voice": "vo_adv_5017321_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "魔女的殘香",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "突然變濃郁了！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "不會結束……",
    "voice": "vo_adv_5017321_003",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "不會結束的！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "\\n我必須回應其寵愛！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "\\n對魔女",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "對魔女對魔女對魔女對魔女！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "怎、",
    "voice": "vo_adv_5017321_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "怎麼突然間",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "「不可視之手」的攻勢……！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "或許會有什麼陷阱……",
    "voice": "vo_adv_5017321_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "毫無計畫的就衝進去太危險了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可是，",
    "voice": "vo_adv_5017321_006",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我必須接近他才行。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "到底該怎麼做……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沒事的，",
    "voice": "vo_adv_5017321_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我有辦法解決！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人，",
    "voice": "vo_adv_5017321_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "您有什麼對策嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "在被「不可視之手」抓住之前，",
    "voice": "vo_adv_5017321_009",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n打倒大罪司教就好啦！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳說，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是不是超～級簡單？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……雖然有很多想說的，",
    "voice": "vo_adv_5017321_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過現狀也只能這樣了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那麼雷姆就來",
    "voice": "vo_adv_5017321_011",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n開闢一條抵達大罪司教身邊的道路！",
    "voice": null,
    "unit_id": 109711
  }
]
