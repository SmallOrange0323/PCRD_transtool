[
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_5106323_000",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那個刺刺的外型",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "很可怕耶……！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "發狂的聖誕樹",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "比想像中還要棘手……！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "對不起！",
    "voice": "vo_adv_5106323_001",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "都是我的錯……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "還是讓我自己想辦法吧！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n各位請退後一點！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我自己來──！",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "唉～",
    "voice": "vo_adv_5106323_002",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "唉。",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n艾米根本是嘴上說一套，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "實際上做一套啊。",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……咦？",
    "voice": "vo_adv_5106323_003",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我之前不依賴妳，",
    "voice": "vo_adv_5106323_004",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳不是還不高興，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "要我多依賴妳一點？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "為此訓了我一頓的",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不就是艾米妳嗎？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……！！",
    "voice": "vo_adv_5106323_005",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n姊姊……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "對不起……",
    "voice": "vo_adv_5106323_006",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": "vo_adv_5106323_007",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "看來我們",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也可以幫忙吧？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "──那麼",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "進行最後的攻擊吧！",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5106323_008",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了苦苦等待幸福聖誕節的人們……",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "為了全世界的",
    "voice": "vo_adv_5106323_009",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "可愛姊妹檔……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "要上囉！",
    "voice": "vo_adv_5106323_010",
    "unit_id": null
  }
]
