[
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天的放學後，凱留與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了買點心而來到一家食品店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然不知道這個「會改變味道的魔法巧克力」是什麼，",
    "voice": "vo_adv_1272003_000",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是光50公克就有300大卡的熱量",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也太扯了吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃了一定會胖的！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_1272003_001",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "待在【美食殿堂】的時候，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明明吃了那麼多卻沒有變胖呢～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為了驅除魔物之類的，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "活動量也是不少呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗚嗚，",
    "voice": "vo_adv_1272003_002",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "身體因為學園生活已經懈怠下來了，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就這樣回到【美食殿堂】的話",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺會很不妙啊……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "得活動一下筋骨才行呢～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……說著",
    "voice": "vo_adv_1272003_003",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就看到這邊剛好有一張公告，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n上面寫了魔物出沒的情報。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哦～",
    "voice": "vo_adv_1272003_004",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "上面寫說南邊的平原有魔物出沒。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n因為那附近是露營地，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也有人因此受傷呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～",
    "voice": "vo_adv_1272003_005",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當作復健或許剛剛好呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我們就去看看狀況吧。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……你們兩個不要呆站在門口好嗎。",
    "voice": "vo_adv_1272003_006",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n很擋路耶。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，妳是",
    "voice": "vo_adv_1272003_007",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "凱留……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對吧。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n聽說超級優秀，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一下就從學園畢業，所以很出名呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那妳又是誰？",
    "voice": "vo_adv_1272003_008",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我們學園的學生嗎？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒錯。",
    "voice": "vo_adv_1272003_009",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我跟妳不一樣，只是個一般人。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳就別管我了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得妳話中帶刺呢。",
    "voice": "vo_adv_1272003_010",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不過話說回來，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然有點突然……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是妳接下來打算離家出走對吧？",
    "voice": "vo_adv_1272003_011",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "妳、",
    "voice": "vo_adv_1272003_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "妳怎麼知道……！？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n……啊，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "因為我帶著露營組合嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "還買了一大堆食物呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1272003_013",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然也有這些因素，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是我總覺得妳散發出一種離家少女的氛圍呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "啥？",
    "voice": "vo_adv_1272003_014",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "搞不懂妳在說什麼……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "再拖下去會被父母發現的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "閒聊就到此為止，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "給我讓開……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……什麼？",
    "voice": "vo_adv_1272003_015",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n誰想回去那種父母一直碎碎念的家啊……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "都是你害我想起來……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "真是氣死人了！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳看起來很不爽呢～",
    "voice": "vo_adv_1272003_016",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也沒有打算要阻止，妳開心就好。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是看妳帶著露營組合……",
    "voice": "vo_adv_1272003_017",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "勸妳還是不要去南方的平原，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n據說那邊的魔物變多了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……哼、",
    "voice": "vo_adv_1272003_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "哼！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "要是害怕魔物，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "可沒辦法離家出走！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n我的決心才沒有那麼半吊子呢！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "再見！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": "vo_adv_1272003_019",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她走掉了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺能理解她的心情……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到了那種地步就無法拉下臉了呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_1272003_020",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你打算怎麼做？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不用問我就能猜到答案了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1272003_021",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就知道。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們就出發吧～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "background",
    "bg_id": "501591"
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……你們為什麼要跟來啊。",
    "voice": "vo_adv_1272003_022",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我可不需要有人陪！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別逞強了，",
    "voice": "vo_adv_1272003_023",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其實妳心裡鬆了一口氣對吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再說，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳這不是把搭帳篷的工作都丟給他了嗎。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說又回來，",
    "voice": "vo_adv_1272003_024",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你看起來明明什麼都不會，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是卻什麼都辦得到呢……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "這、",
    "voice": "vo_adv_1272003_025",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "這樣的話你當然辦得到啊。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我又沒有經驗……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "之前跟家人來露營的時候，",
    "voice": "vo_adv_1272003_026",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我明明說了想要來搭帳篷，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n父母卻阻止我說這很危險，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "對我而言還太早了……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "就算我說想要生火",
    "voice": "vo_adv_1272003_027",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "也會因為危險而不准……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "說想握菜刀",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "也會因為危險而不准……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "不管我想挑戰什麼事情都被會否決……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "真的是煩死了！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "不管",
    "voice": "vo_adv_1272003_028",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我做什麼事情他們都要挑毛病……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "還問我要去哪裡？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "幾點會回家？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "每天",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "都把我管得死死的……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n真讓人受不了……！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這就是妳離家出走的理由？",
    "voice": "vo_adv_1272003_029",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是好懂的反抗期呢～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……煩死了。",
    "voice": "vo_adv_1272003_030",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n反正你們",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "根本就不會懂我的感受。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我懂，",
    "voice": "vo_adv_1272003_031",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我超懂的。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也遇過很多讓人受不了的事情。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……咦？",
    "voice": "vo_adv_1272003_032",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不久之前，",
    "voice": "vo_adv_1272003_033",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才有個嬌生慣養的混帳貴族，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說我是沒有教養的卑賤小丫頭……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "來挑釁呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的是，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果我當時心情不好，絕對會把他給宰了……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那只是結果論罷了！",
    "voice": "vo_adv_1272003_034",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～突然覺得好不爽！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我要來做咖哩然後暴吃一頓！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……噗，",
    "voice": "vo_adv_1272003_035",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n什麼嘛，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "凱留其實是不認真的那種類型嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我還以為是個戴著眼鏡，自以為優等生的人。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "戴個眼鏡就覺得是優等生，也太好騙了吧～",
    "voice": "vo_adv_1272003_036",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來妳會笑啊。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我還以為妳的表情也離家出走了呢～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "啊哈哈！",
    "voice": "vo_adv_1272003_037",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "嘴巴還真壞！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n不過這個樣子",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "還比較好相處呢！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留等人",
    "words": "你吵死了！！",
    "voice": "vo_adv_1272003_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是凱留與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起陪伴這位離家少女，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就這樣過了兩天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501592"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "每餐都吃咖哩，果然還是會覺得膩呢～",
    "voice": "vo_adv_1272003_039",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "時機也剛剛好，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃完這頓飯就差不多該回家了吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我、",
    "voice": "vo_adv_1272003_040",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我才不會回去呢！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我可不是來露營的，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "而是離家出走耶！？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……再說，",
    "voice": "vo_adv_1272003_041",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "事到如今也不可能回去了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼？",
    "voice": "vo_adv_1272003_042",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "因為……",
    "voice": "vo_adv_1272003_043",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "就算過了兩天父母也沒有來找我……！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "平常一直對我碎碎念，",
    "voice": "vo_adv_1272003_044",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "只是因為在意旁人的眼光罷了……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "要是女兒不中用，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "會讓自己丟臉……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "其實",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "他們根本就不需要我！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有夠麻煩的……",
    "voice": "vo_adv_1272003_045",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這種感覺",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是同類相斥吧。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1272003_046",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂───！",
    "voice": "vo_adv_1272003_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n翔子！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳在嗎───！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "翔子……！",
    "voice": "vo_adv_1272003_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n拜託妳",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "回我一聲……！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "！！",
    "voice": "vo_adv_1272003_049",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "是我的父母……！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "凱留……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "我要去躲起來，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "妳隨便應付一下他們……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦！？",
    "voice": "vo_adv_1272003_050",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算妳突然這麼說……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "他們過來了……！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "啊……",
    "voice": "vo_adv_1272003_051",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "妳身上穿的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "是安布羅斯的制服……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "請問妳認識我的女兒嗎！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦！！？",
    "voice": "vo_adv_1272003_052",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不知道耶～",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "這樣啊……",
    "voice": "vo_adv_1272003_053",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "因為家裡的露營組合不見了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n我還以為",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "她一定是在這裡……",
    "voice": null,
    "unit_id": 1411
  },
