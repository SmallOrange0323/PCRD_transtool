    "type": "dialogue",
    "name": "離家少女",
    "words": "……真的",
    "voice": "vo_adv_1272003_091",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "很對不起！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n都是我害你們遇到危險……！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "沒這回事。",
    "voice": "vo_adv_1272003_092",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n我們才應該道歉，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "都沒有考慮到妳的心情，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "對不起啊……！！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "是啊……",
    "voice": "vo_adv_1272003_093",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "今後",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "讓我們一起多聊聊吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "不管是討厭的事，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "或是覺得不滿的事，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我全部",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "都會好好聽的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "……",
    "voice": "vo_adv_1272003_094",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "嗯！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n爸爸、",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "媽媽……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "……對了，",
    "voice": "vo_adv_1272003_095",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "也得好好地",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "跟那位女孩道謝才行。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n不只是幫忙照顧女兒，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "還打倒了魔物……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "……咦，",
    "voice": "vo_adv_1272003_096",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "她不見了……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "凱留……！？",
    "voice": "vo_adv_1272003_097",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "離家少女",
    "words": "凱留妳在哪裡──！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉～",
    "voice": "vo_adv_1272003_098",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是吵死人了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1272003_099",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想應該沒問題了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她應該也不想被朋友看見",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n自己跟家人的那副模樣吧。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你不用特地說出來啦。",
    "voice": "vo_adv_1272003_100",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "算了，",
    "voice": "vo_adv_1272003_101",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然多花了不少功夫，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但也有成功打倒魔物，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "算是皆大歡喜吧。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼我們就回去吧～",
    "voice": "vo_adv_1272003_102",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不過在那之前，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還得先收拾露營用具呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉～",
    "voice": "vo_adv_1272003_103",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真累人。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然嘴上在抱怨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但在月光照射下的凱留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻露出了非常溫柔的表情。",
    "voice": null,
    "unit_id": null
  }
]
