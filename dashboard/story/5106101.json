  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "祝大家聖誕幸福♪",
    "voice": "vo_adv_5106101_000",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n我是為了讓大家變得超級無敵幸福",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "而降臨的資優生天使，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n名字叫做",
