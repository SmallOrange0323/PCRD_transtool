[
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "距離「R＆A度假村」開幕越來越近的某天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在處理雜務時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看到了在碼頭吵鬧的克蕾琪塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "──太慢了～！",
    "voice": "vo_adv_1400001_000",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "冒險者還沒來嗎？好慢，太慢了！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我可是用緊急冒險委託給公會的。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這樣就算降低報酬也不能抱怨喔，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "畢竟時間就是金錢！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好了好了，",
    "voice": "vo_adv_1400001_001",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就耐心等待吧。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n難得來到度假勝地了。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可沒時間這麼悠哉了！",
    "voice": "vo_adv_1400001_002",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n在這期間也不知道魔物什麼時候會……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "出現了！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "警衛也趕不過來了，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真沒辦法，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "退後吧秘書一號！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "百萬彈射！！",
    "voice": "vo_adv_1400001_003",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……真是的，",
    "voice": "vo_adv_1400001_004",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要是破壞了這個度假村，我可不會放過你。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n管你是魔物還是什麼，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我都會走正當途徑，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "狠狠地搾取損害賠償金啊。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！？",
    "voice": "vo_adv_1400001_005",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還躲著一隻嗎！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這傢伙……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔，",
    "voice": "vo_adv_1400001_006",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好冷！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "幫大忙了！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n看我的啊啊～！！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "很好的助攻，騎士先生。",
    "voice": "vo_adv_1400001_007",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "熬夜後還這麼勉強，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "可不只受輕傷這麼簡單喔？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n本來您",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就是比起戰鬥更擅長事務工作的人了。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真囉嗦，秘書一號！",
    "voice": "vo_adv_1400001_008",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總比開幕延後要好吧！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不過少年，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還是要謝謝你。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然全身濕透了……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也沒關係吧。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……是啊。",
    "voice": "vo_adv_1400001_009",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不久前我們擊退了海中霸主不是嗎？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那隻鯊魚。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n看來是受到那個影響，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這附近的魔物都活躍起來了。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "所以才委託人來討伐魔物，",
    "voice": "vo_adv_1400001_010",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但那些冒險者們還沒來……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……什麼！？",
    "voice": "vo_adv_1400001_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "等、",
    "voice": "vo_adv_1400001_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下，這是怎麼回事……！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "怎麼越來越小……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……不，",
    "voice": "vo_adv_1400001_013",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不是我們變小。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "看來又……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呀啊啊啊啊啊啊啊！！？",
    "voice": "vo_adv_1400001_014",
    "unit_id": 140011
  },
  {
    "type": "still",
    "still_id": "521800201"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為……",
    "voice": "vo_adv_1400001_015",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n為、為、為……！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為什麼我又巨大化了～～～！？",
    "voice": "vo_adv_1400001_016",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這絕對是「巨大化的祕藥」的效果吧！？",
    "voice": "vo_adv_1400001_017",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "怎麼會……！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我沒有被祕藥潑到啊……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不對，",
    "voice": "vo_adv_1400001_018",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "剛才……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐，",
    "voice": "vo_adv_1400001_019",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "這裡有祕藥的空瓶。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n看來是混進",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "騎士先生正在整理的雜物中了。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "太、",
    "voice": "vo_adv_1400001_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "太不小心了吧……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "少年，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這到底是怎麼回事！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喂，",
    "voice": "vo_adv_1400001_021",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "說真的到底是怎麼回事！？！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為、",
    "voice": "vo_adv_1400001_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為什麼你又剛好夾在我的胸部間了！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……打算救我而跑過來就被捲入……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我才不管呢！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喂秘書一號！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你剛剛一瞬間偷笑了對吧！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是的，為什麼我會遇到這種事……！",
    "voice": "vo_adv_1400001_023",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n別再從各種角度看我了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "快點去找「變小的祕藥」！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
