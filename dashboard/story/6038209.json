[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_6038209_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們的簡報最後雖然慘敗收場，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過倒也挺好的就是了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別管那個了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你怎麼樣？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你也試試看嘛，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "簡報。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "試試看……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就隨便找個你身邊的東西，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "把它推銷給我看看吧？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這什麼？",
    "voice": "vo_adv_6038209_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "根本是稀有度零的垃圾嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你說",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是重要的東西，怎麼可能……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　這是之前我送你的？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　啊～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之前覺得好玩",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "才送你的。好懷念喔。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的假的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你一直很珍惜地留著這種東西？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喔，",
    "voice": "vo_adv_6038209_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "感覺好像在哪裡看過這個蛋糕耶，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那我就……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "開動啦～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "討厭，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這什麼！？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "在美味的暴力之下眼淚都掉出來了……！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那些訴說著你我之間深刻羈絆的東西，好像快要浮現出來了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "心動。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是，",
    "voice": "vo_adv_6038209_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不至於什麼都沒有吧？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你再仔細看看你的口袋裡？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你看，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你不就莫名地拿著這一堆",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "像是票券一樣的東西嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還有這是什麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "蒐集了好多種像錢幣一樣的東西。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "要不要我幫你丟掉？",
    "voice": null,
    "unit_id": 110811
  }
]
