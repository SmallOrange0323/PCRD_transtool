    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說、",
    "voice": "vo_adv_5084203_006",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……繃緊神經往前進吧。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "下次戰鬥也很期待妳的表現喔，",
