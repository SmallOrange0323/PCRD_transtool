[
  {
    "type": "dialogue",
    "name": "深月",
    "words": "欸我說。",
    "voice": "vo_adv_5108302_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那位神明大人",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "又在作亂了耶……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀……",
    "voice": "vo_adv_5108302_001",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看來是心情又好過頭了呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是的～",
    "voice": "vo_adv_5108302_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "既然是神，就不能再稍微自制一點嗎～？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "總之，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要再款待祂一次了，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "深月、",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "美里！",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "知道了。",
    "voice": "vo_adv_5108302_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這次再更猛烈地",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "款待祂一下吧……！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼我也",
    "voice": "vo_adv_5108302_004",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "再款待得狠心一點吧。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……妳們是在說款待吧？",
    "voice": "vo_adv_5108302_005",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n是在說接待客人的事吧？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "接招吧──！\\n吃我這一記！",
    "voice": "vo_adv_5108302_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呃、",
    "voice": "vo_adv_5108302_007",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那個……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對了！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為了讓來場的客人們不要誤會，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我在此說明一下，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這只是本旅館在進行款待，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "敬請見諒……♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……嗯呵呵♪",
    "voice": "vo_adv_5108302_008",
    "unit_id": 124611
  }
]
