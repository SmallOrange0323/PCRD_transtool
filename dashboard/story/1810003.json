    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n正是因為很清楚，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我才會追過來。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我也是",
    "voice": "vo_adv_1810003_073",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不希望安受傷。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "但如果安受了傷，",
