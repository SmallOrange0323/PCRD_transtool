  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這天──{0}等人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n收到公會管理協會的緊急召集，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到職員所在之處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "謝謝",
    "voice": "vo_adv_1810003_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "各位撥冗前來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n其實……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "「未知的巨大生物",
    "voice": "vo_adv_1810003_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "正從加托羅斯山上往山下移動」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n我們之前收到這樣的通報，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "並派了數人前去處理……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "然而",
    "voice": "vo_adv_1810003_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "討伐以失敗告終。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n由於損傷太過慘重，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n在那之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "沒有人願意承攬這個委託……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "但是，",
    "voice": "vo_adv_1810003_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "根據花凜小姐所言，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "如果是各位的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n說不定會願意接下委託──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "加托羅斯山……",
    "voice": "vo_adv_1810003_004",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "未知的巨大生物……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……安。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是巨靈呢。",
    "voice": "vo_adv_1810003_005",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n明明至今為止都沒有感受到它要離開山的氣息……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我記得在山腳下",
    "voice": "vo_adv_1810003_006",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "有一些",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "村落……？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "如果巨靈下山的話……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那些村落抵擋不了多久的。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "現在馬上準備出發吧。",
    "voice": "vo_adv_1810003_007",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……要是",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "貪吃佩可她們也在的話就好了。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "是啊。",
    "voice": "vo_adv_1810003_008",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "但是貪吃佩可她們",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "和露一起去離島了……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "就算用通訊魔法聯繫上她們，",
    "voice": "vo_adv_1810003_009",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n也沒有時間等她們回來了呢……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……沒辦法了，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "就我們自己去吧！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "dialogue",
    "name": "古蕾婭、安",
    "words": "……咦！？",
    "voice": "vo_adv_1810003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我說，",
    "voice": "vo_adv_1810003_011",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n那和我們所知的巨靈",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "有點不一樣耶……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "顏色不同……",
    "voice": "vo_adv_1810003_012",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "若是只有",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "顏色不一樣就好了，但是……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……！",
    "voice": "vo_adv_1810003_013",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n有其他的巨靈",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "從反方向來了……！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "亞種巨靈",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "巨靈",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 11211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭、安",
    "words": "……唔！",
    "voice": "vo_adv_1810003_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "亞種巨靈",
    "words": "──嘎滋！",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "亞種巨靈",
    "words": "咕嚕！！",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "巨靈在",
    "voice": "vo_adv_1810003_015",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "襲擊巨靈……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "最後還把對方的魔石碎片吃下去了！",
    "voice": "vo_adv_1810003_016",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不同的不只是外觀，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n它比起其他巨靈",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "更殘暴，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "能力也更強！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "肯定是",
    "voice": "vo_adv_1810003_017",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "因為搶來的魔石力量……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那個巨靈，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一直持續在「進化」……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們必須在這邊阻止它……",
    "voice": "vo_adv_1810003_018",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "兩",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "位！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我先尋找它的弱點，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "麻煩掩護我！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗯……！",
    "voice": "vo_adv_1810003_019",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "喝啊啊啊！！",
    "voice": "vo_adv_1810003_020",
    "unit_id": 109411
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "dialogue",
    "name": "亞種巨靈",
    "words": "……唔！",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安！",
    "voice": "vo_adv_1810003_021",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "懲處之焰！！",
    "voice": "vo_adv_1810003_022",
    "unit_id": 109211
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "dialogue",
    "name": "亞種巨靈",
    "words": "…………",
    "voice": null,
    "unit_id": 11212
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "騙人……",
    "voice": "vo_adv_1810003_023",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n我的火焰和",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安的炎魔法同時攻擊也無效……！？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那個人和古蕾婭的物理攻擊也無法造成傷害。",
    "voice": "vo_adv_1810003_024",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "所有屬性的上級魔法、",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "混合屬性的複合魔法，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n竟然也都行不通……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安……",
    "voice": "vo_adv_1810003_025",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那個巨靈",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "完全盯上我們了。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n再繼續激怒它的話，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "事情會變得很不妙。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我們先撤退，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "然後想想作戰策略吧。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……如果是老師的話絕對會說要這麼做呢。",
    "voice": "vo_adv_1810003_026",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是我想在巨靈下山前做個了斷！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n拜託了，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "讓我再試試看！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "…………",
    "voice": "vo_adv_1810003_027",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……接下來",
    "voice": "vo_adv_1810003_028",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "要怎麼做？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……！",
    "voice": "vo_adv_1810003_029",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "起",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "全力攻擊！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n然後也要麻煩你！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "請把力量借給我！！",
    "voice": null,
