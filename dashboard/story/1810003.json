    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我有話想跟妳說。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "still",
    "still_id": "181000301"
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……唔！",
    "voice": "vo_adv_1810003_067",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不要想著得自己一個人戰鬥。",
    "voice": "vo_adv_1810003_068",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "讓我在安的身邊",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "和妳一起戰鬥吧。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n我這次不會成為妳的累贅的。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "咦！？",
    "voice": "vo_adv_1810003_069",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭才不是我的累贅呢！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n絕對不是！！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我才是每次都受到古蕾婭的幫助！",
    "voice": "vo_adv_1810003_070",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n這次也是",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我害的……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不是喔，",
    "voice": "vo_adv_1810003_071",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "並不是安害的。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "所以……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "被安丟下，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "讓我感到有點寂寞。",
