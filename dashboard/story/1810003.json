  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n多虧安",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "放了那麼多的慰問禮物陪伴我啊。",
