    "type": "dialogue",
    "name": "３人",
    "words": "…………",
    "voice": "vo_adv_5050008_068",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "505000801"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對、",
    "voice": "vo_adv_5050008_069",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對啊！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n畢竟我們這裡",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有一位去過靈界的騎士先生，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說不定我們還會去看看你們有沒有鬆懈唷！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "雖然我們那裡",
    "voice": "vo_adv_5050008_070",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "沒什麼像這裡一樣熱鬧的地方，",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不過到時候我們",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "會十分樂意地帶妳們參觀喔！",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯，",
    "voice": "vo_adv_5050008_071",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "很期待唷。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那麼就這樣，",
    "voice": "vo_adv_5050008_072",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "該走了呢。",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要保重身體喔。",
    "voice": "vo_adv_5050008_073",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒來的話就變鬼嚇你們唷！",
    "voice": "vo_adv_5050008_074",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "之後再見吧。",
    "voice": "vo_adv_5050008_075",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們絕對會再來的！",
    "voice": "vo_adv_5050008_076",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "那麼……",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "再見了～！",
    "voice": "vo_adv_5050008_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯，",
    "voice": "vo_adv_5050008_078",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "再見……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "他們離開了呢。",
    "voice": "vo_adv_5050008_079",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼……",
    "voice": "vo_adv_5050008_080",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "終於結束了，真是清靜多了呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "今年的萬聖節",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "忙了好多好多事情啊。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "紡希……",
    "voice": "vo_adv_5050008_081",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……說的也是呢，",
    "voice": "vo_adv_5050008_082",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們也得要好好努力，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "免得下次見面讓那些孩子看笑話呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳果然已經認同馬修他們了嘛，",
    "voice": "vo_adv_5050008_083",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n明明清楚地說出來就好了。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不說出口就是愛的鞭策，",
    "voice": "vo_adv_5050008_084",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要誤會了！",
    "voice": "vo_adv_5050008_085",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才不是什麼愛！",
    "voice": null,
    "unit_id": 113911
  },
