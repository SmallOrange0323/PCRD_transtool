    "words": "啊對了！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "盡情發出許多開心的悲鳴吧！",
