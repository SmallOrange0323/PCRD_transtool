    "type": "dialogue",
    "name": "茉莉",
    "words": "讓人感到害怕也沒關係了嗎？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "當然！",
    "voice": "vo_adv_5050008_037",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "因為我們最喜歡逗人開心了！",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "多虧了紡希，",
    "voice": "vo_adv_5050008_038",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們成長了很多喔！",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "應該……",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "有成長了吧？",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們這幾個傢伙還早得很呢……",
    "voice": "vo_adv_5050008_039",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然我很想這樣說，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過看到離開鬼屋那些遊客的表情，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就說不出口呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "客人玩得非常開心，",
    "voice": "vo_adv_5050008_040",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們也都很開心嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "嗯！",
    "voice": "vo_adv_5050008_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這就是我的答案。",
    "voice": "vo_adv_5050008_042",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "咦？",
    "voice": "vo_adv_5050008_043",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希這是在稱讚你們呢。",
    "voice": "vo_adv_5050008_044",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大概是最高等級的，",
    "voice": "vo_adv_5050008_045",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對吧？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5050008_046",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的！",
    "voice": "vo_adv_5050008_047",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請妳們兩個不要說些多餘的話！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n如果這樣就滿足了，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "明年就會偷懶了吧！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不能就這樣鬆懈啊！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "明年我們會好好的提昇自己的！",
    "voice": "vo_adv_5050008_048",
    "unit_id": 6011
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "光靠我們",
    "voice": "vo_adv_5050008_049",
    "unit_id": 5811
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 5811
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "這個的話",
    "voice": "vo_adv_5050008_050",
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "就要……",
    "voice": null,
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "困擾的時候就拜託紡希吧！",
    "voice": "vo_adv_5050008_051",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不要。",
    "voice": "vo_adv_5050008_052",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "咦～～～～！",
    "voice": "vo_adv_5050008_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "其實妳超級想要幫忙的吧？",
    "voice": "vo_adv_5050008_054",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不然",
    "voice": "vo_adv_5050008_055",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就不會擔心明年了呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唉……",
    "voice": "vo_adv_5050008_056",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果同意的話，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這些孩子說不定就會想要偷懶了啊。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "……！",
    "voice": "vo_adv_5050008_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "\\n紡希！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們會加油的！",
    "voice": "vo_adv_5050008_058",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n為了回應紡希的期許，",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "明年我們會更加成長，再來見妳的！",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我就不抱期待地等著你們吧。",
    "voice": "vo_adv_5050008_059",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "到最後都這麼不坦率呢。",
    "voice": "vo_adv_5050008_060",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "呵呵，",
    "voice": "vo_adv_5050008_061",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不過我們都知道",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希很溫柔嘛。",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是啊，",
    "voice": "vo_adv_5050008_062",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我很溫柔，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以你們要長長久久感謝我喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有，",
    "voice": "vo_adv_5050008_063",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的只要送到這裡就好了嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n讓我們送你們到最後不是很好嗎……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "嗯，",
    "voice": "vo_adv_5050008_064",
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "因為別離會讓人很難受嘛……",
    "voice": null,
    "unit_id": 5711
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "而且怜大人",
    "voice": "vo_adv_5050008_065",
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "會害怕墳場吧？",
    "voice": null,
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "\\n靈界的入口",
    "voice": null,
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "可是墳場啊？",
    "voice": null,
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "沒關係嗎？",
    "voice": null,
    "unit_id": 5911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈，",
    "voice": "vo_adv_5050008_066",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是為了你們，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那不算什麼唷。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是呢，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n少了你們的墳場",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很是冷清，也許是讓人挺難受的呢……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "…………",
    "voice": "vo_adv_5050008_067",
    "unit_id": null
  },
