    "type": "dialogue",
    "name": "休茲",
    "words": "非常可怕喔！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "不過還是謝了！",
    "voice": "vo_adv_5050008_005",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "\\n如果來鬼屋的話",
    "voice": null,
    "unit_id": 5912
  },
