  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遊行當天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n萬聖節樂園來了許多遊客，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們所看到的……並不是恐怖的鬼怪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "歡迎來到，",
    "voice": "vo_adv_5050008_000",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我們的城鎮～♪",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "很恐怖唷～",
    "voice": "vo_adv_5050008_001",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "很恐怖唷～",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "會嚇一跳唷～♪",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "卻非常開心唷～♪",
    "voice": null,
    "unit_id": 5812
  },
