    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n跪倒在我跟前吧！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "呃～",
    "voice": "vo_adv_5050008_007",
