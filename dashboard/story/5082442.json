    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來如此。",
    "voice": "vo_adv_5082442_001",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n真是費了不少力氣。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "材料看起來都沒事。",
    "voice": "vo_adv_5082442_002",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "運氣不錯嘛，雪菲。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真是太好了……",
    "voice": "vo_adv_5082442_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這都是兩位的功勞。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的很謝謝妳們。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這麼一來，",
    "voice": "vo_adv_5082442_004",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就能跟大家一起做年菜了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "兩位如果方便，也想請妳們一起來品嚐……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_5082442_005",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那妾身就心懷感激地前去享用吧。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可以嗎？",
    "voice": "vo_adv_5082442_006",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那我會很期待哦。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒問題。",
    "voice": "vo_adv_5082442_007",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我會努力",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "製作出好吃的料理！",
    "voice": null,
    "unit_id": 120711
  }
