[
  {
    "type": "background",
    "bg_id": "509010"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿！　",
    "voice": "vo_adv_1061500_000",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "最近還好嗎？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我最近很好喔！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以呢？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "找我有什麼事嗎？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔，",
    "voice": "vo_adv_1061500_001",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的生日啊！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……加那個「小」是多餘的！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我叫諾維姆啦！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別再忘記了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n算了，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝你的祝福！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原本我就不知道是什麼時候生日的，",
    "voice": "vo_adv_1061500_002",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "像這樣被別人親口祝福\\n雖然很開心，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但有點害羞呢。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿嘿……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說慶祝，",
    "voice": "vo_adv_1061500_003",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是指什麼？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "身高又沒有長高……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的生日？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "難不成，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你是要幫我慶祝嗎！？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的生日啊，",
    "voice": "vo_adv_1061500_004",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還有除了我以外的傢伙重視著我的生日呢……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "到底是為什麼呢？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是你能幫我慶祝很讓人開心呢！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "禮物？　",
    "voice": "vo_adv_1061500_005",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是什麼的？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我什麼都沒做啊？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想送什麼我都收下吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊，這樣啊！　",
    "voice": "vo_adv_1061500_006",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為今天是我的生日啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "早說嘛！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝呀！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n竟然會有那麼一天能被你祝福，真是讓人吃驚呢！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "被你慶祝那就代表著",
    "voice": "vo_adv_1061500_007",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我出生在這個世界上",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也就具有意義了！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那就想成是那樣",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來盛大地慶祝吧！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "盡情地！",
    "voice": null,
    "unit_id": 106112
  }
]
