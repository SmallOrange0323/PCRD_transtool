    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你這個笨蛋！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不要忽然遮住別人的眼睛啊！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "光是聽到你的聲音，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我當然能立刻猜出你是誰吧！",
