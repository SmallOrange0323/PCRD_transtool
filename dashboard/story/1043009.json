    "words": "嗚、",
    "voice": "vo_adv_1043009_055",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚哇──",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}！",
    "voice": "vo_adv_1043009_056",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n……你怎麼會在這裡……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "咦……？",
    "voice": "vo_adv_1043009_057",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "蹲在小孩子的面前，",
    "voice": "vo_adv_1043009_058",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "和對方對上眼？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n好厲害，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一下子就吸引住快要哭出來的小孩子了……！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "那個，",
    "voice": "vo_adv_1043009_059",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "媽媽",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "有和我說，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "要我來跑腿……！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "可是，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "這裡有好多間店，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我搞不清楚是哪間……！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此……",
    "voice": "vo_adv_1043009_060",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一邊稱讚對方幫忙跑腿很棒，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n一邊調侃自己也很常迷路，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "藉此逗笑小孩子……！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊哈哈……♪",
    "voice": "vo_adv_1043009_061",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "她剛才明明就快哭出來了，",
    "voice": "vo_adv_1043009_062",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在卻掛著笑容……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……他這不是",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "超會應付小孩子的嘛。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "感覺他會是個好爸爸──",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我在想什麼啊！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……快想起剛才的決心。",
    "voice": "vo_adv_1043009_063",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要和{0}",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "保持距離的吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這可是我自己決定的事情。",
    "voice": "vo_adv_1043009_064",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n接下來得盡量",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "自己一個人工作了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但事情的發展與她的決心唱反調，居民們接二連三來詢問事情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真琴不得不請{0}來幫忙──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路上的人們",
    "words": "謝謝！",
    "voice": "vo_adv_1043009_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是怎樣啊，",
    "voice": "vo_adv_1043009_066",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一下有人問哪間店有在賣美味的魔物料理，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n一下又有人問有沒有人能調製普通的店不會賣的特殊藥，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有人問哪裡能撿看了會身體發熱的大膽書籍，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一般來說誰知道啊！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}……",
    "voice": "vo_adv_1043009_067",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n你知道很多",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我不知道的事情呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在我不知不覺間，",
    "voice": "vo_adv_1043009_068",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你已經變成了這麼可靠的傢伙啊……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……可惡，",
    "voice": "vo_adv_1043009_069",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "本想著要保持距離的，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n卻不小心……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "依靠他了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我這樣子",
    "voice": "vo_adv_1043009_070",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不行啊……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡，",
    "voice": "vo_adv_1043009_071",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "狀態不太好。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我應該不是做事會這麼拖拖拉拉的人啊……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": "vo_adv_1043009_072",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "得要振作起來。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "必須專注在工作上，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不然可保不住【哞哞自衛隊】的面子。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然這陣子很和平，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但還是不能鬆懈。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……嗯？",
    "voice": "vo_adv_1043009_073",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那傢伙的臉，",
    "voice": "vo_adv_1043009_074",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好像在哪看過……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是【哞哞自衛隊】的通緝狀！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是這傢伙",
    "voice": "vo_adv_1043009_075",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒有錯……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "罪狀是……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "針對其他種族的暴力行為，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "以及仇恨心理？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n認為獸人族是最優秀的──",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在還有懷抱著這種思想的人在啊？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且他還在這種人多的地方晃來晃去的，",
    "voice": "vo_adv_1043009_076",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n代表他只是個不會瞻前顧後的三流惡棍吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……這樣的工作",
    "voice": "vo_adv_1043009_077",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "才適合我啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好了，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "趕緊把他抓起來吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這次要",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不依靠那傢伙完成工作。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……喂，",
    "voice": "vo_adv_1043009_078",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那邊的那個人。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "啊啊？",
    "voice": "vo_adv_1043009_079",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "怎樣，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "是在叫我？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我有點事要找你，",
    "voice": "vo_adv_1043009_080",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "麻煩你乖乖跟我走一趟。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可以的話，我並不想動粗。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n找你有什麼事……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你懂的吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "妳……",
    "voice": "vo_adv_1043009_081",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "是【哞哞自衛隊】啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嘖，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "被麻煩的傢伙發現了──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "啊！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "呀啊，",
    "voice": "vo_adv_1043009_082",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "怎麼回事！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": "vo_adv_1043009_083",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，你這傢伙！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……妳",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "嗯、",
    "voice": "vo_adv_1043009_084",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "嗯……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "多虧有妳接住我……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "果斷地利用了路人──！？",
    "voice": "vo_adv_1043009_085",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很駕輕就熟……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n還以為他是三流惡棍，我太小看他了嗎！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嘿嘿，",
    "voice": "vo_adv_1043009_086",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "再見啦！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘖！",
    "voice": "vo_adv_1043009_087",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "什麼，",
    "voice": "vo_adv_1043009_088",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你是什麼時候……！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "區區人族，",
    "voice": "vo_adv_1043009_089",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "礙事！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，",
    "voice": "vo_adv_1043009_090",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你沒事吧！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個混蛋！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "嘿，",
    "voice": "vo_adv_1043009_091",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "妳這個獸人族還真窩囊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "都是因為你和人族一起行動啦──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡，",
    "voice": "vo_adv_1043009_092",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "他混入人群之中了……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "剛才的事……",
    "voice": "vo_adv_1043009_093",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是一開始就和這傢伙聯手抓他，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n就絕對不會讓對方逃走了……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真沒用……！",
    "voice": "vo_adv_1043009_094",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我到底在幹嘛啊……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……唔。",
    "voice": "vo_adv_1043009_095",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還好，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒什麼事啦。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你才是因為我的緣故，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "被他狠狠撞了一下吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真對不起，",
    "voice": "vo_adv_1043009_096",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這是我的失誤。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我原本打算要一個人把他抓起來的，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但這樣還真難看。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……你這個人",
    "voice": "vo_adv_1043009_097",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是會說這種話呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "聽到這種話，會不小心搖起尾巴的我也──",
    "voice": "vo_adv_1043009_098",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n該怎麼說……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很無藥可救啊……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唉……",
    "voice": "vo_adv_1043009_099",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真琴深深嘆了氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n存在於她心中的複雜情感不斷地膨脹下去。",
    "voice": null,
    "unit_id": null
  }
]
