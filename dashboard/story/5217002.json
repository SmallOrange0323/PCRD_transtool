  },
  {
    "name": "八斗神",
    "words": "「強大」，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "誠實和寬容是",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "「弱小」。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "這種精神上的弱肉強食",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "經歷了數代積累，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "就這麼遺傳了下來。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "人類",
    "voice": "vo_adv_5217002_037"
  },
  {
    "name": "八斗神",
    "words": "要從這裡修正軌道……",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n也只能採取些許強硬的手段了。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "所以才會需要",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "「認知修正」。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "……哎呀呀。",
