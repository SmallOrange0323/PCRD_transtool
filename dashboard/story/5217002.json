  },
  {
    "name": "格魯尼",
    "words": "即便是在現實，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n應該甚至能讓所有人類把局長",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "「認知」為「王」。",
