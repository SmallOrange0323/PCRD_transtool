  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "要是",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "還有其他辦法，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "還真想讓你教教我呢。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "我怎麼笑得出來呢。",
    "voice": "vo_adv_5217002_040"
  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "世界若失去和平，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "就沒辦法安心玩遊戲了。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "透過「認知修正」，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "感覺大有可為。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "不過我有兩個在意的點，",
