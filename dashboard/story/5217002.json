  },
  {
    "name": "格魯尼",
    "words": "\\n要是累積在模組內的那些受到解放，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "處於消失狀態的玩家靈魂",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n也會受到影響吧，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "畢竟座標距離非常近。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "嗯，",
    "voice": "vo_adv_5217002_046"
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "恐怕不只是受到影響而已。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "畢竟是在沒有退路，",
    "voice": "vo_adv_5217002_047"
  },
  {
    "name": "八斗神",
    "words": "連意識都沒有的狀態下",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "受到汙染。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "即便回到現實那一邊，",
