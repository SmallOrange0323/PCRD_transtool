  },
  {
    "name": "八斗神",
    "words": "做好保險，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "控制情報──",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "一旦戰爭開始，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "就賣武器，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "使其陷入持久戰，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "令人疲憊，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "再淘汰人類──",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "之後",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "再便宜買進荒涼的土地，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "奪取資源，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "創造資本主義的奴隸。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "現今世界的支配階層",
    "voice": "vo_adv_5217002_036"
  },
  {
    "name": "八斗神",
    "words": "不斷重複這種殘忍行徑。",
