  },
  {
    "name": "格魯尼",
    "words": "失禮了！",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n這番話聽起來就像是在測試局長的覺悟呢，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n真不好意思。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "如果說到",
    "voice": "vo_adv_5217002_051"
  },
  {
    "name": "八斗神",
    "words": "必要的犧牲，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n我們也已經付出去了吧。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "羅蘭搜查官──",
