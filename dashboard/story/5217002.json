  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "就跟你的內褲一樣，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "我對那種地位沒興趣。",
