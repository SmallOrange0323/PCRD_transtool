  },
  {
    "name": "八斗神",
    "words": "悔恨和",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "憎惡──",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n像這樣",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "身處在負面情感中，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "讓我重新體會到。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n……",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "人類",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "從根本上就是邪惡的生物。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "在各地撒下戰爭的火種，",
