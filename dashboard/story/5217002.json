  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "有個少年選了",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "某位少女作為公主。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n而少女",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "對塔的最上層的",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "[rub:神明]超級ＡＩ[/rub]",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "許了這樣的願望──",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "「我想跟大家」",
