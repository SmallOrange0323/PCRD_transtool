[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真步在街道上巡邏著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在這時，偶然地遇見了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正好接下了相同委託的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "神奇真步魔法靈，",
    "voice": "vo_adv_1010012_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咕嚕咕嚕靈～……☆",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵～",
    "voice": "vo_adv_1010012_001",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然能和",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生一塊工作，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真讓人開心呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "果然您和人家，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "正是被命運連接著的呢～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊……",
    "voice": "vo_adv_1010012_002",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可不能興奮過了頭呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先要先確認街道上的狀態呀～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_1010012_003",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那塊石頭是不是有點危險？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "如果害得小孩子摔倒了可不好，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是撿起來吧",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這邊的路面則是有些損毀了呢。",
    "voice": "vo_adv_1010012_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n雖然人家不太擅長通訊魔法，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但為了能早一點修理好，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是報告一下吧。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家可不是",
    "voice": "vo_adv_1010012_005",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一直都是以前的那個人家了唷～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不管是魔法",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還工作，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家可是都更努力了唷♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我想想，",
    "voice": "vo_adv_1010012_006",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "通訊魔法",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n首先得要先指定好座標……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "然後是要怎麼做來著？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒、",
    "voice": "vo_adv_1010012_007",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒問題的唷～？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n最近",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家有去請教過霞了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "比較正式的魔法，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也有好好從頭開始學了……！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先",
    "voice": "vo_adv_1010012_008",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要先把魔力凝聚起來……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然會有魔物出現在這種地方，",
    "voice": "vo_adv_1010012_009",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n看來偵查魔法",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也還不夠完美的樣子呢……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "總之，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這裡就交給人家來吧～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我想想，",
    "voice": "vo_adv_1010012_010",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒記錯的話，攻擊魔法的基本，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不是要一口氣放出所有魔力，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n而是要好好的控制……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_1010012_011",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咿呀！？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": "vo_adv_1010012_012",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您保護了人家～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就、",
    "voice": "vo_adv_1010012_013",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就算不用那個魔法也沒問題的唷～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請您安心，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "下次一定會順利成功的。",
    "voice": "vo_adv_1010012_014",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我想想……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先要凝聚魔力，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n再來要一邊好好地控制……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀，",
    "voice": "vo_adv_1010012_015",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "失敗了呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "得要從頭再來一次才行……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……咦？",
    "voice": "vo_adv_1010012_016",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n您靠得人家這麼近，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是發生什麼事了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您說要我們快逃……？",
    "voice": "vo_adv_1010012_017",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "魔物還……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎～～呀～～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……我們離街道有相當一段距離了呢。",
    "voice": "vo_adv_1010012_018",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "天色也漸漸暗了，",
    "voice": "vo_adv_1010012_019",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "差不多",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該做些什麼事了呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n魔物的話……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好像還在附近的樣子呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒問題的唷～",
    "voice": "vo_adv_1010012_020",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然剛剛不是很順利，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n但這次一定會好好地做給您看的……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……那、",
    "voice": "vo_adv_1010012_021",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那可不行！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊……",
    "voice": "vo_adv_1010012_022",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "抱、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "抱歉，王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家竟然這麼大聲對您說話……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……可是，",
    "voice": "vo_adv_1010012_023",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n若是用平常的魔法可不行呀。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是用人家好好學起來的魔法可不行。",
    "voice": "vo_adv_1010012_024",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "若不這麼做，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就沒辦法證明人家真的有在努力了呀……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……那一次",
    "voice": "vo_adv_1010012_025",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "回老家的時候呀，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家向父親",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "把自己在考慮的事，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n還有心中所想的事",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "全都說出口了唷。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "包括了做為一名公會長，",
    "voice": "vo_adv_1010012_026",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "經歷了過去從未經歷過的經驗……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只要和大家待在一塊，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就會開心到連時間都忘記了的事情……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
