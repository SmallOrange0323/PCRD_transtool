[
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……是因為現在已經用星素之力",
    "voice": "vo_adv_5136204_000",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "強化過了嗎。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n可以清楚感覺到",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "環境的變化呢。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "聽妳這麼一說……",
    "voice": "vo_adv_5136204_001",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n感覺皮膚好像在隱隱作痛？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這就代表精靈是這麼地憤怒嗎。",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟妨礙到它的工作了呢，",
    "voice": "vo_adv_5136204_002",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n心情想必是不會好的吧。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n無論如何，",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要趕緊做個了斷才好。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我來探查看看",
    "voice": "vo_adv_5136204_003",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "精靈的氣息吧。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "經過在精靈族之村的修行，",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我現在",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該可以比較容易掌握到它的所在地。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "拜託妳了，",
    "voice": "vo_adv_5136204_004",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也來仔細聆聽一下周遭的聲音！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我聽聽看……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哈啾！！",
    "voice": "vo_adv_5136204_005",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇啊啊！？",
    "voice": "vo_adv_5136204_006",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n嚇了我一跳！！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉抱歉！",
    "voice": "vo_adv_5136204_007",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我脖子周圍的這個茸毛啊？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n有點搔得鼻子癢癢的～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "了……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………沒有準備動作的噴嚏對心臟很不好啊。",
    "voice": "vo_adv_5136204_008",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嚇了一跳……",
    "voice": null,
    "unit_id": 135613
  }
]
