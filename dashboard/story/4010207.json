  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先～生♪",
    "voice": "vo_adv_4010207_000",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不好意思",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓您久等了哪。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n因為是王子先生的邀約，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "多花了點時間準備……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦……？",
    "voice": "vo_adv_4010207_001",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "發、",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "發生什麼事了，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生？",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "比平時還要",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "閃閃發亮……！？",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呀啊！？",
    "voice": "vo_adv_4010207_002",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "牽起人家手的動作",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也好帥氣呀……！",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不可以，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓人家這麼",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "心跳加速……！",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "當然，",
    "voice": "vo_adv_4010207_003",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "因為是慶生的邀請，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以人家有點期待，但是……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n沒想到會這麼用心……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不愧是人家的王子先生……♪",
    "voice": "vo_adv_4010207_004",
    "unit_id": 101031
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_4010207_005",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這地方氣氛真好哪……♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "被王子先生牽著手，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "走在花朵盛開的路上……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是公主的特權呢……♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……難道說，",
    "voice": "vo_adv_4010207_006",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也可以由人家",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "提出「願望」嗎？",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那麼，",
    "voice": "vo_adv_4010207_007",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那個……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家想要",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感受王子先生",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "手腕的觸感。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是用",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家的一部分……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而是用全身。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是的，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "公主抱呢。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呀……♪",
    "voice": "vo_adv_4010207_008",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "彷彿置身夢境一般♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": "vo_adv_4010207_009",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n就這樣誘拐人家，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "去到",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "任何地方都好……♪",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請讓今天成為最棒的生日吧……♪",
    "voice": null,
    "unit_id": 101031
  }
]
