    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是學到了一課。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "……我知道了！",
    "voice": "vo_adv_1065003_061",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我輸了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "投降！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿，",
    "voice": "vo_adv_1065003_062",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣呀……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啥？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "是嗎。",
    "voice": "vo_adv_1065003_063",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "別這麼賭氣，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n早點投降不就好了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對不對不對不對！",
    "voice": "vo_adv_1065003_064",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n難得現在正要開始，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為什麼要投降啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不，",
    "voice": "vo_adv_1065003_065",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "因為打架受傷的話就做不了生意呢……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "今天賺到的錢給你一半吧。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "你就饒了我吧。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我知道了。",
    "voice": "vo_adv_1065003_066",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這個結果都多虧了這位打手大姐。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n我就從他賺到的錢當中支付酬勞給妳吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我想說的不是這個啊～～！！",
    "voice": "vo_adv_1065003_067",
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……雖然",
    "voice": "vo_adv_1065003_068",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒辦法打架，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打工費加上剛剛的酬勞賺了不少，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天的晚餐就吃豪華一點吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我請客，",
    "voice": "vo_adv_1065003_069",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你想吃多少就吃多少！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "開動～了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我吃！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我吃！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯！",
    "voice": "vo_adv_1065003_070",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真美味！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果有打贏再吃的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該會更好吃吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是真的，",
    "voice": "vo_adv_1065003_071",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只要和你在一起，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n有趣的事一個接一個地發生呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果是我一個人的話，",
    "voice": "vo_adv_1065003_072",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該不可能不打架就拿到酬勞。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "多虧你叫我要忍耐。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很高興有你這個死黨。",
    "voice": "vo_adv_1065003_073",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說真的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_1065003_074",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "死黨就是死黨呀。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我跟你",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是朋友。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對，",
    "voice": "vo_adv_1065003_075",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "朋友唷。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "搞什麼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "難道你之前不認為我是死黨嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那從現在開始，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我和你是朋友唷。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對對。",
    "voice": "vo_adv_1065003_076",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "工作後一起吃美食互相談笑。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這就是死黨吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "身為死黨，",
    "voice": "vo_adv_1065003_077",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今後也麻煩你了呢！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "勾著{0}的肩膀，微笑的嘉夜臉上\\n映現了工作之外才能得到的充實感。",
    "voice": null,
    "unit_id": null
  }
]
