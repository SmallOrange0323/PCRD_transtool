[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了打倒在餐廳林立街道上阻礙通行的小混混，\\n{0}委託工作給嘉夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這拳就是致命一擊！",
    "voice": "vo_adv_1065003_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "哇啊啊啊！！",
    "voice": "vo_adv_1065003_001",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂你這傢伙！",
    "voice": "vo_adv_1065003_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別說些通行費之類無聊的話！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n鎮上大家都覺得很困擾呢！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "嗚嗚嗚！",
    "voice": "vo_adv_1065003_003",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "對、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "對不起！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n我不會再犯了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "原、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "原諒我……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不要讓我在這條街上再看到你！",
    "voice": "vo_adv_1065003_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n聽懂的話就把倒地的傢伙帶走，快消失在我眼前！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "好、",
    "voice": "vo_adv_1065003_005",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "好的！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "對不起！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……嘖，",
    "voice": "vo_adv_1065003_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該已經沒事了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "連勝記錄又更新了呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你也是。",
    "voice": "vo_adv_1065003_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近你有好好把打架的工作帶來呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "幫了大忙。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼……",
    "voice": "vo_adv_1065003_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n今天既然沒有公會也沒有幫派的工作，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有點閒呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "之後要做什麼呢……",
    "voice": "vo_adv_1065003_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你要打工，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也不能拉你去晃晃……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……對了！",
    "voice": "vo_adv_1065003_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "欸，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓我來幫忙吧，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你的打工。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別客氣啦！",
    "voice": "vo_adv_1065003_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "單方面只讓你一直介紹工作給我，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是很奇怪嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快點，",
    "voice": "vo_adv_1065003_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一直發呆下去，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打工可要遲到了哦？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快出發吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這裡，",
    "voice": "vo_adv_1065003_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你打工的地方嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n什麼都沒有，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就只有一般的路邊而已……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "你好。",
    "voice": "vo_adv_1065003_014",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "今天也請多指教。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "這個人是……？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳好，",
    "voice": "vo_adv_1065003_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是他的朋友。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n這份工作",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也能做嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "當然！",
    "voice": "vo_adv_1065003_016",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "而且今天剛好缺人正煩惱著呢，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n妳來的正好。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "這個給妳。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個是……？",
    "voice": "vo_adv_1065003_017",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "這個工作",
    "voice": "vo_adv_1065003_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "要用這個計時器，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "來調查交通量唷。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "\\n長時間坐著調查會有點辛苦，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "要加油喔！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦～！",
    "voice": "vo_adv_1065003_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "竟然有這樣的打工啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和打手的工作完全不同……",
    "voice": "vo_adv_1065003_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像很有趣！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "果然今天",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "跟著你來是正確的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "那麼就請兩位，",
    "voice": "vo_adv_1065003_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "職員",
    "words": "進行這條路的交通量調查吧！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼我來計算",
    "voice": "vo_adv_1065003_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "從右側過來的人，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你計算從左側過來的人吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "開始！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯嗯……",
    "voice": "vo_adv_1065003_023",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一人、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "兩人、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "三人。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n哦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "現在跑過來的一群孩子也算進去的話，就有",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "六人",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呢……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿嘿，",
    "voice": "vo_adv_1065003_024",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個很適合鍛鍊動態視力！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺很好打發時間！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "642人、",
    "voice": "vo_adv_1065003_025",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "643人……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "母親帶著嬰兒，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以是644人。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦不對。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是645人嗎……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊────真是的！",
    "voice": "vo_adv_1065003_026",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我有沒有算對呀！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n像這樣連續算好幾個小時，都要搞亂了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不行了不行了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話說回來，",
    "voice": "vo_adv_1065003_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你從剛才開始就默默地數著，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不會厭煩嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "騙人的吧。",
    "voice": "vo_adv_1065003_028",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "到底多有耐心啊……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我已經極限了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你超厲害的啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
