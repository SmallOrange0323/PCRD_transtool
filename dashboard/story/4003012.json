    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！　",
    "voice": "vo_adv_4003012_033",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也會那樣轉告花凜的！",
