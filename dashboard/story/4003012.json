  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的跟龍戰鬥起來了……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為尾巴被插進了根刺。",
    "voice": "vo_adv_4003012_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為很痛才發狂的吧。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說，",
    "voice": "vo_adv_4003012_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳是不是把刺連同尾巴一起砍下來了……",
