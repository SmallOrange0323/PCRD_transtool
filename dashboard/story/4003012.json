  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還以為",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳因為龍給逃掉了而意志消沉呢……",
