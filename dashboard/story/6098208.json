  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "街を歩いていたら",
    "voice": "vo_adv_6050208_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "子どもたちにお菓子をねだられたよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あいにく持ち合わせがなくていたずらされてしまったけど、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ハロウィンだと思えば",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "楽しいものだね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "え？　",
    "voice": "vo_adv_6050208_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "キ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "キミも？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "い、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "いや、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "さすがにキミからいたずらされるのは恥ずかしいな……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "冗談？　",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "今のがイタズラだったのか。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "一本取られたよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "わっ、",
    "voice": "vo_adv_6050208_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "こんなにたくさん？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "これだけあれば",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "さっきの子どもたちに渡せそうだ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n一緒に渡しに行こう。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "きっと喜んでもらえるよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "いや、",
    "voice": "vo_adv_6050208_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "楽しそうな子どもたちを見ていると",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "こちらまで",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n明るくなれるというだけで……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "キミ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ひょっとして今",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\nいたずらしようとしていた？",
    "voice": null,
    "unit_id": 114011
  }
