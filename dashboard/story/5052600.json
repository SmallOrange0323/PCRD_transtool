  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "気になるなら調べてみる？",
