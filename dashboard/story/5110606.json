[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對晶甚感好奇的諾維姆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n決定要向同為七冠的誓約女君探聽她是個什麼樣的人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "對了，",
    "voice": "vo_adv_5110606_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我從以前就一直很好奇……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n晶她",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "究竟是個什麼樣的人啊？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "什麼啊，",
    "voice": "vo_adv_5110606_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "這種不切實際的提問。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n她是個什麼樣的人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "就如同妳看到的那樣啊？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "是想要阻止我們野心的敵人。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我不是這個意思啦～",
    "voice": "vo_adv_5110606_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "妳在現實中也曾見過她吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "一直都是那種調調，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我根本搞不清楚她的個人品。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "關於這一點，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我想克莉絲提娜",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "應該會知道吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "例如她是個正義感很強，",
    "voice": "vo_adv_5110606_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "但在現實中卻超惡質的傢伙。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "或者是會抱著布偶睡覺啦，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喜歡的點心是馬卡龍啦，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n像這類的資訊也行喔！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "別讓我想像奇怪的畫面！",
    "voice": "vo_adv_5110606_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n她絕不會有",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "那種既夢幻又軟綿綿的嗜好……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我認為不會。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "不過，她既然經營著可麗餅店，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "搞不好私底下……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不、",
    "voice": "vo_adv_5110606_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不用想得那麼認真啦！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果不知道她的私生活，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "說說她在工作場合的狀況也行。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n妳有想到什麼嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "她在研發現場",
    "voice": "vo_adv_5110606_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "也一直都是那個樣子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "交代給她的事都能順利完成，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "但對於不喜歡的事，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n她也會很明確地表示她不喜歡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "然後，",
    "voice": "vo_adv_5110606_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "她平時也會主動協助周遭的夥伴，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n在企劃成員當中深受信賴。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "雖然如今已經跟我們",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "分道揚鑣了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯，",
    "voice": "vo_adv_5110606_008",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我聽得似懂非懂……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "該怎麼說呢？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我知道她人很好，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "但還是搞不太清楚……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "感覺就是",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "難以捉摸的樣子……？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "她實際上",
    "voice": "vo_adv_5110606_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "就是個這樣的女人。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n總是輕浮地憨笑著，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n卻絕不會向他人",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "透漏自己內心深處的想法。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "雖說我和晶的交情應該也夠久了……",
    "voice": "vo_adv_5110606_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "但我還是沒把握",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "自己確實有了解她真實的想法。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣啊。",
    "voice": "vo_adv_5110606_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那麼，對克莉絲提娜來說，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n晶是很重要的朋友囉！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "妳有認真聽我說嗎？",
    "voice": "vo_adv_5110606_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n我剛剛才說過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我無法了解她的實際想法。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "她怎麼會是我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "很重要的朋友呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果不是很重要的朋友，",
    "voice": "vo_adv_5110606_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n妳應該就不會這麼認真地看待吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "像我，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不重要的事很快就忘掉了。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "明明是個小鬼頭，",
    "voice": "vo_adv_5110606_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "還說什麼大話。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "不過……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我承認。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n她確實是我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "為數不多的朋友之一。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "果然是這樣！",
    "voice": "vo_adv_5110606_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "連克莉絲提娜都這麼說了，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n該不會",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "在阿斯特朗的能力排名，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "也是她比較強吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "絕對不是！",
    "voice": "vo_adv_5110606_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哇啊！？",
    "voice": "vo_adv_5110606_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n什、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "突然喊得那麼大聲！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "害我嚇一大跳！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "誰叫妳說了蠢話！",
    "voice": "vo_adv_5110606_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n我怎麼可能",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "會比晶還要弱！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n無論是不是在阿斯特朗傳奇的遊戲裡！！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我在競速遊戲裡以87戰44勝贏過她，",
    "voice": "vo_adv_5110606_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n在格鬥遊戲裡以123戰61勝……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "唔，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "這倒是我輸了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "其他還有像是比腕力之類的……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我、",
    "voice": "vo_adv_5110606_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我就說我知道了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "妳們竟然可以對戰那麼多場～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果是我，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "應該很快就會感到厭倦了。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "與晶之間的對戰，",
    "voice": "vo_adv_5110606_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我想應該不會有感到厭倦的時候。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "因為她是個擁有可以和我相互競爭的實力，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n極少數的優秀玩家……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯……",
    "voice": "vo_adv_5110606_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "雖說是敵人，但交情並不差嗎……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n而且總是在互相競爭……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "對了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n這就是所謂的",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "亦敵亦友吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆對於晶與誓約女君之間的奇妙友誼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n開啟了無限的想像。",
    "voice": null,
