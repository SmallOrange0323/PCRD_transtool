  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_4010195_000",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "剛剛上的課有不懂的地方嗎？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那個……",
    "voice": "vo_adv_4010195_001",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今天",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "的確是我的生日……",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n難道說這個，",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是要送我的生日禮物嗎？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……呵呵。",
    "voice": "vo_adv_4010195_002",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你記得我的生日。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但是，",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不可以帶跟學習無關的東西來學校哦？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個就由老師先幫你保管。",
    "voice": "vo_adv_4010195_003",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n放學後，",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "記得到老師這裡來。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "──我在屋頂上等你。",
    "voice": "vo_adv_4010195_004",
    "unit_id": 101832
  },
  {
    "type": "background",
    "bg_id": "510181"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對不起。",
    "voice": "vo_adv_4010195_005",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n做了這種拐彎抹角的事。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "只是，",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為走廊上還有其他學生在看著……",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來。",
    "voice": "vo_adv_4010195_006",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "按照約定，",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個禮物還給你。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "然後……",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為已經放學了。",
    "voice": "vo_adv_4010195_007",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "所以……",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能再來一次嗎？",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你……♪",
    "voice": "vo_adv_4010195_008",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_4010195_009",
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在學校的屋頂做這種事。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n感覺心臟跳得好快♪",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是真的哦。",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要……",
    "voice": null,
    "unit_id": 101832
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來聽聽看嗎……？",
    "voice": null,
    "unit_id": 101832
  }
]
