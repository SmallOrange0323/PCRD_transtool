[
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在和美里一起冒險的最後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n取得了花的種子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_1015010_000",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n把種子撒在那裡，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "輕輕蓋上一層土。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "然後",
    "voice": "vo_adv_1015010_001",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要澆上足夠的水喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很好，",
    "voice": "vo_adv_1015010_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "做得很好。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "接下來就只要",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "等它發芽囉。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "以後要每天",
    "voice": "vo_adv_1015010_003",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "幫它澆水，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不能忘記喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這個嘛，",
    "voice": "vo_adv_1015010_004",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我想想喔……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為精靈之森的",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "土壤非常肥沃，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是非常適合植物生長的環境，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n所以只要每天好好澆水，我想應該就沒問題了～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊。",
    "voice": "vo_adv_1015010_005",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有一件事",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很重要喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這件事不僅是對花，",
    "voice": "vo_adv_1015010_006",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對任何事……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "每當你「培育某種事物」時，都是很重要的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那就是─",
    "voice": "vo_adv_1015010_007",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "─愛喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵。",
    "voice": "vo_adv_1015010_008",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你還無法理解是嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過呢，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這點可不能忘記喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}你也嘗試帶著愛去照顧吧。",
    "voice": "vo_adv_1015010_009",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n那麼一來，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這朵花也一定會回應你的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天又是美好的一天呢～♪",
    "voice": "vo_adv_1015010_010",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我要趁孩子們來之前準備好才行。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n玩具和繪本，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……哎呀？",
    "voice": "vo_adv_1015010_011",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "早安。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你今天來得很早耶，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n以往都是在其他孩子到齊的時候來的啊……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……咦？",
    "voice": "vo_adv_1015010_012",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來澆水的？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你還真心急呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1015010_013",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真可愛，你的頭髮睡到翹起來囉。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這麼急著要過來嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "早上要澆的水",
    "voice": "vo_adv_1015010_014",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "平常都是由我統一澆的，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以你不用這麼辛苦也沒關係的……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1015010_015",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過也好。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "既然都過來了，你也和我一起去吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對了，",
    "voice": "vo_adv_1015010_016",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你吃過早餐了嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n早餐如果沒有好好吃，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一整天都會沒有力氣的喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你就跟老師一起吃吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "又隔一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1015010_017",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你又早起過來了嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是努力呢。",
    "voice": "vo_adv_1015010_018",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我想，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}的花一定也會很高興的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_1015010_019",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天其實不用澆水喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為昨天晚上",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是有下雨嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果澆太多水，",
    "voice": "vo_adv_1015010_020",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n花朵的肚子",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也會變得鼓鼓的喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你如果吃得太飽，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "動作也會變得遲緩不是嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1015010_021",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過既然你都來了，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可以請你幫老師的忙嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天因為地上濕濕的，",
    "voice": "vo_adv_1015010_022",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不能去外面玩，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以我打算改成",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "讓大家學唱歌。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我教孩子們唱歌的時候，",
    "voice": "vo_adv_1015010_023",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n如果{0}可以先開口唱出來，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那就太好了。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有些孩子很害羞，",
    "voice": "vo_adv_1015010_024",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我需要你當那些孩子的模範……♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "又過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你現在已經",
    "voice": "vo_adv_1015010_025",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很會澆水了呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n小花都閃耀著光芒，好像很開心喔♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_1015010_026",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你在跟它們說話嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……看來你跟小碧問過讓它開花的訣竅了吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_1015010_027",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也來",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跟它們說說話吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "各位小花～♪",
    "voice": "vo_adv_1015010_028",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要像孩子們那樣，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "健健康康地長大喔～♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀？",
    "voice": "vo_adv_1015010_029",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n顏色好奇怪的液體……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "朋友幫忙製作的營養劑？",
    "voice": "vo_adv_1015010_030",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有那種東西呀～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_1015010_031",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這個真的沒問題嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "顏色是深綠色，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好像還一直冒著泡泡……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──然而，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "花卻完全沒有發芽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在那之後已經過了幾天了，",
    "voice": "vo_adv_1015010_032",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "卻還沒有發芽呢。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我覺得新芽應該差不多要冒出頭了才對呀……",
    "voice": "vo_adv_1015010_033",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……為什麼沒有發芽呢？",
    "voice": "vo_adv_1015010_034",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "精靈之森明明是",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "非常適合植物生長的環境……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就算要請小碧幫忙，",
    "voice": "vo_adv_1015010_035",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n現在還沒有發芽，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以也無法讓她聽小花的心聲。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "莫非，",
    "voice": "vo_adv_1015010_036",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是一種很難開花的植物嗎？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n種在精靈之森無法開花嗎……？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可是那孩子那麼努力，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "小花呀，",
    "voice": "vo_adv_1015010_037",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你聽我說。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n那孩子每天都很努力，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我希望你可以回應他的努力……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": "vo_adv_1015010_038",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你在啊！？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……早安。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你今天也很早來呢～！",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……那個，",
    "voice": "vo_adv_1015010_039",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你會不會太勉強自己了？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你總是一大早就過來照顧這些花，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直忙到很晚……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "…………",
    "voice": "vo_adv_1015010_040",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……那個，",
    "voice": "vo_adv_1015010_041",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你是不是",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很焦急？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣啊……",
    "voice": "vo_adv_1015010_042",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看來，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n小花遲遲不發芽這件事讓你很在意呢。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒問題的，",
    "voice": "vo_adv_1015010_043",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你不用擔心喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n新芽還沒有冒出來，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就證明了小花它現在很努力喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……所以，",
    "voice": "vo_adv_1015010_044",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "開心一點吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}你一直哭喪著臉，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n會讓小花也會不敢探出頭的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……好嗎？",
    "voice": "vo_adv_1015010_045",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……！",
    "voice": "vo_adv_1015010_046",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒有那回事……",
    "voice": "vo_adv_1015010_047",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "絕對不是那樣的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你為了這棵小花，",
    "voice": "vo_adv_1015010_048",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "每天早早起床，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "到處找人請教、",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "找人幫忙，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "任何你做得到的事，你都盡力去做。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣的努力，",
    "voice": "vo_adv_1015010_049",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是再正確不過的事了。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "抱歉……",
    "voice": "vo_adv_1015010_050",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你一定很不安吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過請你一定要相信，",
    "voice": "vo_adv_1015010_051",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你的愛",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "絕對不會是錯的。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這孩子",
    "voice": "vo_adv_1015010_052",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有很多事都不懂。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我不該隨口",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說什麼愛的……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "害他因為等不到發芽，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n就誤以為",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是自己的愛不夠，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為此感到不安。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對這孩子來說，",
    "voice": "vo_adv_1015010_053",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "「做自己」是最困難的事。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……但這卻是非常重要的事啊。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……我必須教導他。",
    "voice": "vo_adv_1015010_054",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然難以用言語表達，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但只要是",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我能夠做到的……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你先暫時……",
    "voice": "vo_adv_1015010_055",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就這樣乖乖別動喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……",
    "voice": "vo_adv_1015010_056",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣有沒有……",
    "voice": "vo_adv_1015010_057",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n或多或少",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感受到我的心意？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這就是……",
    "voice": "vo_adv_1015010_058",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "愛。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我希望你能綻放笑容，",
    "voice": "vo_adv_1015010_059",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望你能健康成長。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這種珍惜重視你的念頭，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就是你現在",
    "voice": "vo_adv_1015010_060",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "努力帶給這棵小花的心意喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你有沒有……",
    "voice": "vo_adv_1015010_061",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感受到呢？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感受到我的愛……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……？",
    "voice": "vo_adv_1015010_062",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是……",
    "voice": "vo_adv_1015010_063",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是你的",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "力量……？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不僅我感受到了，",
    "voice": "vo_adv_1015010_064",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還穿過我的身體……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "擴散到森林裡……？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "多麼溫暖、",
    "voice": "vo_adv_1015010_065",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "多麼溫柔的力量……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "森林好像很高興……",
    "voice": "vo_adv_1015010_066",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我從來沒有",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "見過這種事……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊……！",
    "voice": "vo_adv_1015010_067",
    "unit_id": 101512
  },
  {
