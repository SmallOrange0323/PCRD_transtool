[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～……",
    "voice": "vo_adv_5038101_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒這個月的零用錢，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "餘額已經有點不妙了……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真巧。",
    "voice": "vo_adv_5038101_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n從我家鄉寄來的生活費也快不夠用了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮學姐妳應該沒差吧。",
    "voice": "vo_adv_5038101_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n畢竟妳是學院中的特權階級，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n只要說是研究上的需要，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不管什麼東西都可以拿去請款吧。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒錯。",
    "voice": "vo_adv_5038101_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但因為我剛開始",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一直亂申請一些有的沒的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以現在會計變得很神經質。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我是不是該學克蘿依",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "開始偷偷去打工呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": "vo_adv_5038101_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然妳都知道我是偷偷摸摸的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那可不可以請妳不要刻意多此一舉把我的名字講出來啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這間學校可是禁止打工的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這麼說起來，",
    "voice": "vo_adv_5038101_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "年底的時候克蘿依學姐",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n向學校請了一個禮拜的假對吧。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那也是為了去打工嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～沒錯，",
    "voice": "vo_adv_5038101_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我突然被找去。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那是個要把一堆會不斷冒出的盔甲",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "徹底擊潰的打工。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那是",
    "voice": "vo_adv_5038101_007",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什麼啊？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "誰知道。",
    "voice": "vo_adv_5038101_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我是說真的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "他們完全沒向我做任何解釋，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "突然就莫名其妙地要我去現場。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但那是無所謂啦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總之我去拯救了世界。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喔～",
    "voice": "vo_adv_5038101_009",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "時薪多少啊？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不曉得耶？",
    "voice": "vo_adv_5038101_010",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也還沒有收到明細呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "請款單到底應該寄去哪裡啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哎呀呀，",
    "voice": "vo_adv_5038101_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "果然這個世界今天還是一樣的瘋狂。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n有沒有什麼有賺頭的工作啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對吧～？　",
    "voice": "vo_adv_5038101_012",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我是不會期望天降鉅款這種事啦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過妳看嘛，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒不是一個有心就做得到的孩子嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不曉得會不會",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n出現個有錢人看出琪愛兒的潛力而切嚕地投資我們呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5038101_013",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳說的是所謂的天使投資人嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "天使……？",
    "voice": "vo_adv_5038101_014",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我記得優妮學姐",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是那種會突然拿一些童話舉例的人啊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該是死期將近所以預見了什麼吧。",
    "voice": "vo_adv_5038101_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳別管她。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳這蠢蛋。",
    "voice": "vo_adv_5038101_016",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我可不是在說什麼長著翅膀的嬰兒。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我說的是商業天使——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就是會對經濟能力堪慮的創業家伸出援手，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那些富有的個人投資人。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉……",
    "voice": "vo_adv_5038101_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n就算突然跟我說什麼創業，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又講什麼投資的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我還是有點傻眼就是了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "打個比方，",
    "voice": "vo_adv_5038101_018",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不是有些貴族會因為相信對方的才華有天會開花結果，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n而花錢養一些沒沒無聞的藝術家或音樂家嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講簡單一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這大概可以算是那個的商業版。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "以金錢資助那些剛起跑、具有才能的年輕人——",
    "voice": "vo_adv_5038101_019",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在那個領域，有這種特殊喜好的投資家",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "似乎就叫做天使。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦～真好～！",
    "voice": "vo_adv_5038101_020",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒也想見見天使～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒、優妮、克蘿依",
    "words": "下一回，",
    "voice": "vo_adv_5038101_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒、優妮、克蘿依",
    "words": "「恩賜的財團與",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒、優妮、克蘿依",
    "words": "神聖學院的問題兒童」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500730"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這裡就是聖德蕾莎女子學院吧 。",
    "voice": "vo_adv_5038101_022",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "感覺事情越來越有趣了呢，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊～哈哈哈……！",
    "voice": null,
    "unit_id": 103211
  }
]
