    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是能由自己選擇的……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們在過去，",
    "voice": "vo_adv_5130451_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
