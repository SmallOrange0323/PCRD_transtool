[
  {
    "type": "background",
    "bg_id": "501800"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──那是發生於過去，",
    "voice": "vo_adv_5201000_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "確實存在過的記憶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500380"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你終於醒來了！",
    "voice": "vo_adv_5201000_001",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我是妖精菲歐。",
    "voice": "vo_adv_5201000_002",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n我會告訴你阿斯特朗的各種事，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "所以你要仔細聽喔！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "某個少年",
    "voice": "vo_adv_5201000_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "被帶到了未知的世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n並與一名嚮導小妖精",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一同踏上冒險。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我希望少年你",
    "voice": "vo_adv_5201000_004",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "代替我在阿斯特朗做些事。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "把打倒各區域Boss後所獲得的魔珠收集起來，",
    "voice": "vo_adv_5201000_005",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "前往塔的最上層。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "遊戲的破關條件。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這麼做的目的是",
    "voice": "vo_adv_5201000_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "破關《阿斯特朗傳奇》，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n也就是引導公主前往索爾之塔的塔頂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "並實現她的願望。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n他",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在這趟旅程中──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "──這樣啊！",
    "voice": "vo_adv_5201000_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n原來你就是晶的公主騎士！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "你就叫我「誓約女君」吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "遭遇眾多強敵。",
    "voice": "vo_adv_5201000_008",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501650"
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "我不會再有所保留了。",
    "voice": "vo_adv_5201000_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n一定會在這裡",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "打倒你們，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n以我的全力──！",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "跨越諸多苦難。",
    "voice": "vo_adv_5201000_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "……我相信",
    "voice": "vo_adv_5201000_011",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "你們。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "立於無數願望之上。",
    "voice": "vo_adv_5201000_012",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "初次見面。",
    "voice": "vo_adv_5201000_013",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n晶的公主騎士……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我的名字是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "霸瞳皇帝……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "501650"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──騙人。",
    "voice": "vo_adv_5201000_014",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這是騙人的吧。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "怎麼可能有這種事！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我的願望是",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "創造新世界，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓一切都按照我的意思……",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "少年在最終",
    "voice": "vo_adv_5201000_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "獲得了太陽與星星的祝福。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "──歡迎你們",
    "voice": "vo_adv_5201000_016",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "來到索爾之塔。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n跨越諸多試煉而來的",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "勇敢冒險者啊，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n很高興",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "能見到你們。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……認證完成。",
    "voice": "vo_adv_5201000_017",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我認可妳是公主。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n現在，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "公主連結程序",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "即將開始執行……",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "background",
    "bg_id": "501800"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那曾經走過，",
    "voice": "vo_adv_5201000_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "卻失去了的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「過去」──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──喂！",
    "voice": "vo_adv_5201000_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你快醒醒啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你終於醒來了！",
    "voice": "vo_adv_5201000_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唉，",
    "voice": "vo_adv_5201000_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你在看哪裡啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這邊啦、這邊啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n把你的視線再往下移一點！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……",
    "voice": "vo_adv_5201000_022",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "早安。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你該不會是在想「我難道還在夢裡」吧？",
    "voice": "vo_adv_5201000_023",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這既不是你做的夢，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也不是我讓你做的夢喔。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你好像意識還不是很清楚。",
    "voice": "vo_adv_5201000_024",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真拿你沒辦法，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "姑且讓我確認一下吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你知道我是誰嗎？",
    "voice": "vo_adv_5201000_025",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯，",
    "voice": "vo_adv_5201000_026",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "很好。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "看來你還記得──",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "還擁有關於我的記憶呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……呵呵♪",
    "voice": "vo_adv_5201000_027",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你睡迷糊了嗎？",
    "voice": "vo_adv_5201000_028",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n還是說，其實妖精在你眼中看起來都長一樣？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "現在對你惡作劇一下，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "讓那傢伙背黑鍋好像也不錯呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我說你啊……",
    "voice": "vo_adv_5201000_029",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "算了，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這也不能怪你。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那麼，首先就來自我介紹吧。",
    "voice": "vo_adv_5201000_030",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我是菲歐，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n曾經存在於",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "《阿斯特朗傳奇》",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "的嚮導小妖精。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也有人稱呼為嚮導妖精，",
    "voice": "vo_adv_5201000_031",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過反正沒什麼很大的差別。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "因為種種原因，嚮導小妖精幾乎都被消除了，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但我和涅比亞想辦法存活下來了。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是我原本的模樣。",
    "voice": "vo_adv_5201000_032",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你平時見到的「愛梅斯」，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是我們嚮導小妖精的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原型……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也就是類似於祖先的存在喔。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "至今為止，",
    "voice": "vo_adv_5201000_033",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我都在不知名的原因下",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "被困在「愛梅斯」的體內，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n無法變回我原本的模樣……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但今天早上，",
    "voice": "vo_adv_5201000_034",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我就忽然變成這樣了，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n真是嚇了我一大跳呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "契機……",
    "voice": "vo_adv_5201000_035",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……我好像",
    "voice": "vo_adv_5201000_036",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "做了一場夢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "令人非常懷念──",
    "voice": "vo_adv_5201000_037",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但已消逝的夢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這不重要啦……",
    "voice": "vo_adv_5201000_038",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n關於我為何會變回這個模樣，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "必須確實找出原因才行。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "當然也要請你幫忙囉，",
    "voice": "vo_adv_5201000_039",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "而且你沒有拒絕的權利！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊，",
    "voice": "vo_adv_5201000_040",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我這樣有點強人所難吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真糟糕、真糟糕，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "以前的習慣又跑出來了呢，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要多注意才行……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……原原本本，",
    "voice": "vo_adv_5201000_041",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n雖然我沒有要扮演愛梅斯的意思，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但難道這就是所謂的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "身體牽動心靈嗎。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過，",
    "voice": "vo_adv_5201000_042",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "既然你說",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這樣就很好──",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好了好了，",
    "voice": "vo_adv_5201000_043",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你還在發什麼呆？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n趕快動起來準備出門吧！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊，",
    "voice": "vo_adv_5201000_044",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "換衣服可要自己來喔。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "就算我是獨當一面的嚮導小妖精，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n也不能連這種事都幫你做嘛♪",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "…………",
    "voice": "vo_adv_5201000_045",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "總覺得",
    "voice": "vo_adv_5201000_046",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "有點難為情……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "話說回來，",
    "voice": "vo_adv_5201000_047",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我不知道已經多久沒有以這副模樣來到蘭德索爾了……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "應該說這是第一次吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "會不會出什麼問題呢？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "像是變成眾人矚目的焦點？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "於再構築時幾乎全被刪除的嚮導小妖精，",
    "voice": "vo_adv_5201000_048",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是否能被現在的世界",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "所接納呢……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你好啊，小哥。",
    "voice": "vo_adv_5201000_049",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n喔，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你今天是跟妖精一起做事嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "小哥身邊帶著的人",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還真是多彩多姿呀！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哇哈哈！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……很尋常地被接受了呢。",
    "voice": "vo_adv_5201000_050",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "說得也是，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你身邊圍繞了很多個性鮮明的人呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "如今區區妖精也沒什麼好驚訝的吧～",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過還真是讓人不甘心呀。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊！",
    "voice": "vo_adv_5201000_051",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳不是之前跑來我們店裡惡作劇的妖精嗎！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "竟然擅自在菜單上補寫了「微笑100盧幣」！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n害得我們很辛苦耶！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "現在都變成人氣商品了啦！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是天大的抹黑啊，涅比亞那傢伙！",
    "voice": "vo_adv_5201000_052",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一得到自由就為所欲為～～～！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "是妖精～！",
    "voice": "vo_adv_5201000_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "把她捉起來～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "等等、",
    "voice": "vo_adv_5201000_054",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "等一下、等一下！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不要用捕蟲網捉我！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真是的，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你也別笑了，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "快阻止這些小朋友啊～！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呼……",
    "voice": "vo_adv_5201000_055",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一切都沒變呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n蘭德索爾……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這個世界都沒變。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我原以為",
    "voice": "vo_adv_5201000_056",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "會有更明顯的不習慣感。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "完全沒問題呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呃，",
    "voice": "vo_adv_5201000_057",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不知不覺就忘了目的，專心逛起街來了。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你還好吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "會不會累？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我們到鬧區去",
    "voice": "vo_adv_5201000_058",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "買點喝的吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "別太勉強自己喔。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "打擾了～！",
    "voice": "vo_adv_5201000_059",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n我們想買東西喝……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……店員不在嗎？",
    "voice": "vo_adv_5201000_060",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒營業──",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "應該不會吧……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那麼隔壁的店……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不好意思～！",
    "voice": "vo_adv_5201000_061",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n……這邊",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也沒人。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "欸……",
    "voice": "vo_adv_5201000_062",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "情況是不是怪怪的啊？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "為什麼就只有這裡",
    "voice": "vo_adv_5201000_063",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "安靜成這樣……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n到剛剛為止都還很熱鬧的說……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這裡",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "應該是鬧區才對吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是啊，",
    "voice": "vo_adv_5201000_064",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "彷彿時間停止了。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5201000_065",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……！？",
    "voice": "vo_adv_5201000_066",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5201000_067",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "她的外貌……",
    "voice": "vo_adv_5201000_068",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "和我在裡面時不一樣。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "壞掉的部分也修復了……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "更重要的是",
    "voice": "vo_adv_5201000_069",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "她對我們的聲音有反應……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這就表示",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "有人在裡面……！　",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那邊的傢伙，",
    "voice": "vo_adv_5201000_070",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n是妳奪走了那個身體吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "雖然那不是",
    "voice": "vo_adv_5201000_071",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我的身體，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但我們可要請妳回答妳這麼做的意圖！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這個城鎮的異狀也是！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "兩者之間應該不會沒關係吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5201000_072",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "她剛剛",
    "voice": "vo_adv_5201000_073",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "看著我……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "笑了？　",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──",
    "voice": "vo_adv_5201000_074",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……！",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是……！？",
    "voice": "vo_adv_5201000_075",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n為什麼妳……！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "等一下！",
    "voice": "vo_adv_5201000_076",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n妳到底──！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與陌生樣貌的「愛梅斯」邂逅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n隨後，{0}和菲歐便被光芒籠罩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n對{0}而言，這道光有股熟悉的感覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510460"
  },
