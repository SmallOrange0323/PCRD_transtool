  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "宮子前來找{0}玩耍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喂～快把布丁交出來的～",
    "voice": "vo_adv_1007003_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "順便一起玩喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯？",
    "voice": "vo_adv_1007003_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你怎麼看起來一臉嚴肅來的？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……宮子變成幽靈的理由？",
    "voice": "vo_adv_1007003_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子自己也不清楚來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……死掉以前的事情？",
    "voice": "vo_adv_1007003_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這個宮子也不記得了喲～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你突然怎麼了？",
    "voice": "vo_adv_1007003_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為什麼要問那些事情來的～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……只要想起臨死前的事情，",
    "voice": "vo_adv_1007003_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n或許就能知道宮子變成幽靈的理由？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哼嗯……的確是讓人有點在意來的～",
    "voice": "vo_adv_1007003_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那我們兩人一起調查一下，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子怎麼會變成幽靈的吧～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯……",
    "voice": "vo_adv_1007003_007",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是生前的事情……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "過去的事情宮子已經都不記得了喲～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……從最近的事情開始回想？",
    "voice": "vo_adv_1007003_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "欸……昨天……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "昨天宮子吃了布丁來的～♪",
    "voice": "vo_adv_1007003_009",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "前天沒有吃到布丁來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大前天有吃到布丁來的～！嗯哼～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯？不可以光想布丁的事情嗎～？",
    "voice": "vo_adv_1007003_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯～可是宮子只記得布丁的事情來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……接下來要四處打聽情報？",
    "voice": "vo_adv_1007003_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要找出認識宮子的人嗎？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子想到了～！",
    "voice": "vo_adv_1007003_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子飄上去～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n從空中來問問看吧～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喂～！",
    "voice": "vo_adv_1007003_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果有人認識宮子，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n請告訴我們來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "咖啡店員",
    "words": "啊！妳是！？",
    "voice": "vo_adv_1007003_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯！",
    "voice": "vo_adv_1007003_015",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你該不會認識宮子來的吧──！？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "咖啡店員",
    "words": "是啊，我認識妳……",
    "voice": "vo_adv_1007003_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "咖啡店員",
    "words": "昨天妳隨便吃掉了我客人的布丁吧！",
    "voice": "vo_adv_1007003_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "咖啡店員",
    "words": "\\n快點賠錢！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……這麼說起來好像有這麼一回事來的～",
    "voice": "vo_adv_1007003_018",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，快逃跑吧～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我們去了好幾個地方，",
    "voice": "vo_adv_1007003_019",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n但是都沒有人認識宮子來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "結果宮子還是，",
    "voice": "vo_adv_1007003_020",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n不知道變成幽靈以前的事來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯，好可惜來的…………",
    "voice": "vo_adv_1007003_021",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦？也沒那麼可惜喲～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那太難了！",
    "voice": "vo_adv_1007003_022",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子打不起精神來的──！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為……因為，宮子已經半天沒吃到布丁了喲──！",
    "voice": "vo_adv_1007003_023",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁――布丁――――！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "結果宮子完全不知道為什麼會變成幽靈來的。",
    "voice": "vo_adv_1007003_024",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是可是，和你去了很多地方，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n超開心的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "雖然不記得臨死前的事情，",
    "voice": "vo_adv_1007003_025",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n但是宮子記得見到你時，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子收到布丁然後很高興來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "和你一起玩也很開心來的～！",
    "voice": "vo_adv_1007003_026",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n明天也要一起玩喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算不知道變成幽靈的理由，",
    "voice": "vo_adv_1007003_027",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n只要能和你在一起，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "什麼都好來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "宮子露出了無憂無慮的微笑。",
    "voice": null,
    "unit_id": null
  }
]
