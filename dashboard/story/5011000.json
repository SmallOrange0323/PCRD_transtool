  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再過幾天就即將到情人節的某一天。\\n走在蘭德索爾市區中的{0}，\\n在街上的一處發現了璃乃。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哼哼哼～",
    "voice": "vo_adv_5011000_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天也很可愛呢！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可可亞烏拉",
    "words": "巧克♪",
    "voice": "vo_adv_5011000_001",
    "unit_id": 10911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來～",
    "voice": "vo_adv_5011000_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我來幫你澆水喔～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n怎麼樣～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "舒服嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可可亞烏拉",
    "words": "巧克、巧克♪",
    "voice": "vo_adv_5011000_003",
    "unit_id": 10911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呵呵呵，",
    "voice": "vo_adv_5011000_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那我再多澆一點喔！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n快快長大〜♪　",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "快快長大～♪",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5011000_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！　",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你好！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你看牠，",
    "voice": "vo_adv_5011000_006",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "非常可愛對吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可可亞烏拉",
    "words": "巧克♪",
    "voice": "vo_adv_5011000_007",
    "unit_id": 10911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_5011000_008",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你說牠不就是魔物嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對啊，",
    "voice": "vo_adv_5011000_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "牠是一種叫做可可亞烏拉的魔物寶寶。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我現在",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "正在幫牠澆水照顧牠。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_5011000_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你問我養牠的理由？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "牠的尾巴是可可亞的幼苗對吧？",
    "voice": "vo_adv_5011000_011",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聽說只要用幸福的話語來養育牠，",
    "voice": "vo_adv_5011000_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這裡就會結出美味的可可亞果實喔！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "然後，",
    "voice": "vo_adv_5011000_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "使用那個可可亞的話，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n似乎就能做出讓吃的人變幸福的",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "頂級巧克力『LoveDestiny』！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來，",
    "voice": "vo_adv_5011000_014",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你看這裡！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n看起來",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是不是再過一陣子就要結出可可亞的果實了？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "以這步調來看，似乎有足夠的時間能趕在情人節之前結果。",
    "voice": "vo_adv_5011000_015",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？　",
    "voice": "vo_adv_5011000_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "難道說哥哥，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你不知道情人節嗎！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不是不是，",
    "voice": "vo_adv_5011000_017",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那並不是祭典……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聽好囉。　",
    "voice": "vo_adv_5011000_018",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "情人節就是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n送巧克力給珍視之人，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是個非常重要的日子！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_5011000_019",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你問為什麼要送巧克力嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那是因為……",
    "voice": "vo_adv_5011000_020",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為了要將自己的心意傳達給喜歡的人！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會用心養育這孩子，",
    "voice": "vo_adv_5011000_021",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓牠結出美味的可可亞果實。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "然後，",
    "voice": "vo_adv_5011000_022",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會用那顆可可亞做出巧克力，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再把巧克力送給哥哥喔！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "大概……",
    "voice": "vo_adv_5011000_023",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也會收到",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n靜流姐送的巧克力喔。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我沒有靜流姐那麼會做料理……",
    "voice": "vo_adv_5011000_024",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是情人節就是戰爭！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以就算是最喜歡的靜流姐，我也不會輸給她！",
    "voice": "vo_adv_5011000_025",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請你好好期待喔！",
    "voice": null,
    "unit_id": 101112
