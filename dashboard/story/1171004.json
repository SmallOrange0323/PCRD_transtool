    "name": "靜流",
    "words": "心情好複雜。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不但沒租到海邊小屋，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n還把賺的錢花光光了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明離和弟弟一起住的夢想",
    "voice": "vo_adv_1171004_091",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還非常遙遠……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但總覺得，",
    "voice": "vo_adv_1171004_092",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "光是像現在這樣……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就非常幸福了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸，",
    "voice": "vo_adv_1171004_093",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你──",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？　",
    "voice": "vo_adv_1171004_094",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這呼吸聲是？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "又",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "睡著了啊。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是不是因為趴在姐姐背上",
    "voice": "vo_adv_1171004_095",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "很舒服呢？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……呵呵，",
    "voice": "vo_adv_1171004_096",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是撒嬌鬼♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}睡著的呼吸聲、海浪聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n靜流聽著這些令人心情舒暢的聲音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n細細品味著此時此刻的幸福。",
    "voice": null,
