  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "放棄住進海邊小屋的靜流，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與{0}一同漫步在被夕陽染紅的沙灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……唉。",
    "voice": "vo_adv_1171004_000",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n結果，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看來是沒機會住進海邊小屋了呢。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼夢想、憧憬啊，",
    "voice": "vo_adv_1171004_001",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "往往都與現實背道而馳呢。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真想和{0}一起住進海邊小屋，",
    "voice": "vo_adv_1171004_002",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n開心地度過每一天啊……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1171004_003",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}……！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1171004_004",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這樣啊……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說得也是。",
    "voice": "vo_adv_1171004_005",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我只要",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和弟弟在一起，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就非常開心、",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "滿足、",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "非常幸福了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "再奢求更多",
    "voice": "vo_adv_1171004_006",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就太貪心了對吧。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": "vo_adv_1171004_007",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們趕在天黑之前",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "回去吧。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呃，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n怎麼變亮了──？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……醒醒。",
    "voice": "vo_adv_1171004_008",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……快醒醒，",
    "voice": "vo_adv_1171004_009",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你不快點起床的話，",
    "voice": "vo_adv_1171004_010",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就沒時間和姐姐玩囉？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1171004_011",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你終於醒啦？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵。",
    "voice": "vo_adv_1171004_012",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟真是",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "貪睡呢。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然每天早上",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是得要姐姐叫才肯起床。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這裡？",
    "voice": "vo_adv_1171004_013",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如你所見，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是海邊唷♪",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你一副",
    "voice": "vo_adv_1171004_014",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「我怎麼會在海邊」的表情呢。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是的，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好過份。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你忘了和姐姐約好",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要來海邊玩了嗎？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當然有呀！",
    "voice": "vo_adv_1171004_015",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想想……",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "差不多在去年夏末吧。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼？",
    "voice": "vo_adv_1171004_016",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你已經不記得去年的事了？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好傷心啊，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐記得很清楚耶。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐盼著和弟弟一起去海邊的那一天，",
    "voice": "vo_adv_1171004_017",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n每天每天",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "都掰著手指頭算時間呢。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "然後，",
    "voice": "vo_adv_1171004_018",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "等著等著",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就等不及了……",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "於是就趁弟弟睡著時把你帶來海邊啦。",
    "voice": "vo_adv_1171004_019",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n欸嘿嘿♪",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯♪",
    "voice": "vo_adv_1171004_020",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n重要的是",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你現在和姐姐一起在海邊唷。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們今天要盡～",
    "voice": "vo_adv_1171004_021",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "情享受",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只屬於我們姐弟倆的海邊時光唷♪",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "來，",
    "voice": "vo_adv_1171004_022",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "把嘴張大～",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n……啊～嗯♪",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好吃嗎？",
    "voice": "vo_adv_1171004_023",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這是姐姐特製的",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "刨冰可麗餅！",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "再多吃點吧♪",
    "voice": "vo_adv_1171004_024",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "冰到頭痛了嗎？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐給你摸摸頭吧……",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿嘿♪",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能在海裡游泳、",
    "voice": "vo_adv_1171004_025",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在沙灘上互相追逐、",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "吃美味的食物。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "海邊果然很有趣呢。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當然，",
    "voice": "vo_adv_1171004_026",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是因為和弟弟在一起才有趣。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你呢──",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "欸，",
    "voice": "vo_adv_1171004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "我們接下來要做什麼～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊～",
    "voice": "vo_adv_1171004_028",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟真是的，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n明明姐姐就在眼前，竟然還看其他女孩子。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是的，",
    "voice": "vo_adv_1171004_029",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然是男孩子。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n總是對女孩子充滿興趣呢。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是不懂姐姐的心……",
    "voice": "vo_adv_1171004_030",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對了。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咳咳……",
    "voice": "vo_adv_1171004_031",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟也差不多該學習",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如何與女孩子相處了。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒錯唷。",
    "voice": "vo_adv_1171004_032",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "現在的弟弟",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "根本完全不了解少女的心。",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這樣下去的話，",
    "voice": "vo_adv_1171004_033",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當你遇到命中注定的另一半，",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n可是會抓不住她的心的唷？",
    "voice": null,
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以啊，",
    "voice": "vo_adv_1171004_034",
    "unit_id": 117131
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就由姐姐來教你！",
