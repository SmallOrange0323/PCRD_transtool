  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "夏感じさせちゃうよね～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nハート型のストローとか差しちゃって一緒に飲んじゃう～？",
