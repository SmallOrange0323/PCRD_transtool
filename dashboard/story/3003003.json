    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽，真溫柔……）",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "(絕對不會，",
    "voice": "vo_adv_3003003_079",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n做出我們討厭的事情……)",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "(我總是，",
    "voice": "vo_adv_3003003_080",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n向這樣的咲戀媽媽撒嬌呢……？)",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "(但是，這樣是不行的呢……",
    "voice": "vo_adv_3003003_081",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "演戲的事，雖然從來沒想過……)",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "(站在大家面前會覺得緊張，",
    "voice": "vo_adv_3003003_082",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n變得搞不清楚狀況……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是我的壞習慣……）",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "（也許透過演戲的練習，",
    "voice": "vo_adv_3003003_083",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n能夠克服這點……）",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "（在大家面前不會緊張，大聲地說話……",
