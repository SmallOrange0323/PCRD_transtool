    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊、那個……？",
    "voice": "vo_adv_3003003_035",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不是的，是有名的經典文學……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不不、不是、奇怪的書喔……！",
    "voice": "vo_adv_3003003_036",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "十分有趣喔，綾音、也要讀看看嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯～",
    "voice": "vo_adv_3003003_037",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n看書會變得想睡，不要！",
    "voice": null,
    "unit_id": 102311
  },
  {
