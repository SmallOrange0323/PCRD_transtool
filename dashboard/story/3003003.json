    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "小狗之類的，如何……？",
    "voice": "vo_adv_3003003_039",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n嘿嘿，哥哥～？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "伸手～……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我覺得，",
    "voice": "vo_adv_3003003_040",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n胡桃有時會有天馬行空似的言行舉止……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "{0}哥哥，這樣好嗎？",
    "voice": "vo_adv_3003003_041",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "被比自己年紀輕的女孩子，當作寵物照顧好嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒關係啊……",
    "voice": "vo_adv_3003003_042",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那，{0}哥哥是小狗吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我就是媽媽，噗吉是爸爸！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃……",
    "voice": "vo_adv_3003003_043",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n嗯，演情婦真的沒關係嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n演可愛的獨生女覺得如何？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "演、演情婦就好……",
    "voice": "vo_adv_3003003_044",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "總覺得，很有趣……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是、是嗎？",
    "voice": "vo_adv_3003003_045",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那麼，開始吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿，很久沒玩扮家家酒了～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我回來了～♪",
    "voice": "vo_adv_3003003_046",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家，有乖乖的嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我回來了～♪",
    "voice": "vo_adv_3003003_047",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很抱歉呢，",
    "voice": "vo_adv_3003003_048",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我和大小姐都不在家……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為有無論如何都必須處理的事情。",
    "voice": "vo_adv_3003003_049",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓妳們感到寂寞了吧～？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不會的……",
    "voice": "vo_adv_3003003_050",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n看來，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那傢伙好像有幫忙照顧小朋友呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好像玩得很開心呢，",
    "voice": "vo_adv_3003003_051",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個是在玩些什麼呀？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "開什麼玩笑！",
    "voice": "vo_adv_3003003_052",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n說清楚這是怎麼回事！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "騙子！",
    "voice": "vo_adv_3003003_053",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "明明告訴我只愛我一個，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n會和那個人分手！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我要殺了你，",
    "voice": "vo_adv_3003003_054",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你這個背叛者……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦……！？　",
    "voice": "vo_adv_3003003_055",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n怎怎怎、怎麼回事？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總是很溫順的小胡桃，",
    "voice": "vo_adv_3003003_056",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n竟然說出那種殺氣騰騰的話！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還、還想要撕碎噗吉！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "請、請不要吵架！",
    "voice": "vo_adv_3003003_057",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "發生什麼事了呢，胡桃！？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看起來很像正在因爭風吃醋而吵架？",
    "voice": "vo_adv_3003003_058",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難道說，是在爭奪那傢伙嗎……！？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我說你呀！",
    "voice": "vo_adv_3003003_059",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n你居然對這麼小的小朋友們出手嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n真是看錯你了！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_3003003_060",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊噫，對不起……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不、不是的，這是『扮家家酒』……？",
    "voice": "vo_adv_3003003_061",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是是是、在演戲……！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "喔，演戲？",
    "voice": "vo_adv_3003003_062",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是、是這樣嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "什麼嘛，嚇了我一跳……♪",
    "voice": "vo_adv_3003003_063",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是相當逼真的演技呀，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我還以為真的要演變成戰場了呢～？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，說得也是。",
    "voice": "vo_adv_3003003_064",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "胡桃呀，妳也挺有演戲的才能不是嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_3003003_065",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我我、我那個……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "演戲什麼的，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我我我、我做不到……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳呀，很害怕陌生人呢。",
    "voice": "vo_adv_3003003_066",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣呀～……我想要是胡桃能夠演戲的話、",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就剛剛好了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "剛剛，",
    "voice": "vo_adv_3003003_067",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我接受了負責慰問附近的養老院的工作呦。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "【咲戀育幼院】的經營也漸漸穩定下來了，",
    "voice": "vo_adv_3003003_068",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n所以也想做些作為公會的活動內容呀。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果讓可愛的小朋友們，有如才藝發表會般來演戲的話……",
    "voice": "vo_adv_3003003_069",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n老爺爺和老婆婆可能會很開心呢～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我是這麼想的呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊、好像很有趣！",
    "voice": "vo_adv_3003003_070",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我想演戲！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這個呢、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我想演公主♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我做不到……",
    "voice": "vo_adv_3003003_071",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n如果是扮家家酒還可以，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "在大家面前，不認識的人面前演戲什麼的……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "光光光、",
    "voice": "vo_adv_3003003_072",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n光是想到就緊張得",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "連胃都好像要吐出來了……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "胃！？",
    "voice": "vo_adv_3003003_073",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嘛、前提是『做得到的話』呦。",
    "voice": "vo_adv_3003003_074",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不用勉強自己的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "【咲戀育幼院】，",
    "voice": "vo_adv_3003003_075",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n只要能當作讓小朋友們安穩居住的地方就好了……♪",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比起這些，大家應該都餓了吧。",
    "voice": "vo_adv_3003003_076",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n鈴莓，我們來準備晚餐吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的，大小姐。",
