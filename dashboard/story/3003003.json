    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽今天也很漂亮……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯、嗯。",
    "voice": "vo_adv_3003003_089",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n雖然不知道為什麼稱讚我，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n多謝……？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "（嗚，",
    "voice": "vo_adv_3003003_090",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一緊張又說了奇怪的話了……！？）",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "（想改變這樣的自己……",
