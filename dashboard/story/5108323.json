[
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼，",
    "voice": "vo_adv_5108323_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n宴會也差不多進入高潮了吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "溫泉之神",
    "voice": "vo_adv_5108323_001",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也看起來心情很好呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是到目前為止……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "最開心的一次。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳們兩位",
    "voice": "vo_adv_5108323_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該懂吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們的職責",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是使客人幸福。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n在這間旅館工作的人們",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "全都是為了這個目的而全力以赴。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯……",
    "voice": "vo_adv_5108323_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那當然。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我可沒打算偷懶。",
    "voice": "vo_adv_5108323_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "既然如此，",
    "voice": "vo_adv_5108323_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我就不用多說什麼了吧。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就算對方是神明，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也要用盡全力使祂開心。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……就用我們的方式來款待。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "來吧，",
    "voice": "vo_adv_5108323_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "溫泉之神。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n接下來是陽卵旅館引以為豪的",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "極致款待。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "請好好地",
    "voice": "vo_adv_5108323_007",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "享受吧！",
    "voice": null,
    "unit_id": 124511
  }
]
