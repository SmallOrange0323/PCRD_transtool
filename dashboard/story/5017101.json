[
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "玄關的打掃結束了，",
    "voice": "vo_adv_5017101_000",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n剩下的就是打掃房間",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "和整理倉庫了……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳看起來沒什麼精神呢，",
    "voice": "vo_adv_5017101_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n在妳去叫巴魯斯起床之前明明還那麼有精神，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n是因為看到巴魯斯的蠢臉不開心嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不，",
    "voice": "vo_adv_5017101_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴的睡臉",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "非常可愛，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆看一整天都不會膩……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "其實",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆一直有一種很不好的預感。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "而且，",
    "voice": "vo_adv_5017101_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "總覺得宅邸也散發出一股不好的氣息……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n明明魔獸的事情才剛結束，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "應該不會有甚麼問題才對啊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這樣啊……",
    "voice": "vo_adv_5017101_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是令人擔心。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "把經常惹是生非的巴魯斯",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "綁起來丟出去就是",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "最好的辦法。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "――",
    "voice": "vo_adv_5017101_005",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真是的，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拉姆每次都這樣",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n故意講一些很壞心的話。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "早安，",
    "voice": "vo_adv_5017101_006",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_5017101_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "早安。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雷姆怎麼了嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的。",
    "voice": "vo_adv_5017101_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "好像有",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "什麼不好的預感……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這樣啊，",
    "voice": "vo_adv_5017101_009",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原來雷姆也是？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n其實我也……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不過",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我感覺到的",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n不單是那種很討厭的焦躁感。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不單是很討厭的感覺而已……",
    "voice": "vo_adv_5017101_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_5017101_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "的確因為不好的預感",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "而有焦躁感，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "在那之上卻有種",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非常、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常美好的邂逅",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n似乎即將就要出現的",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "期待感！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "下一回",
    "voice": "vo_adv_5017101_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「Re:從零開始聚集的異世界餐桌」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "美好的邂逅……",
    "voice": "vo_adv_5017101_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n愛蜜莉雅大人也來到這個年紀了呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n看來，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "巴魯斯要心碎了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦？",
    "voice": "vo_adv_5017101_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n為什麼昴要心碎呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴……",
    "voice": "vo_adv_5017101_015",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n有時候連雷姆",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "都覺得他好可憐……",
    "voice": null,
    "unit_id": 109711
  }
]
