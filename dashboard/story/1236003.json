  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "出來了！！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼都沒做的話就不用逃了吧！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦……",
    "voice": "vo_adv_1236003_054",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哇啊！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n裡面有好多人！！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……不對，",
    "voice": "vo_adv_1236003_055",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這些不是人！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "背後有拉鍊！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n雖然做得很逼真，但這些全都是布偶裝……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而且仔細一看，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n有身材壯碩的男性、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "駝背的老婆婆、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "獸人族的年輕男性……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也完全吻合被害人的證言……",
    "voice": "vo_adv_1236003_056",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n而且手指的地方還沾有漆彈的顏料！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "剛剛那個人果然就是犯人……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們追上去！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看到了，",
    "voice": "vo_adv_1236003_057",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是那個人！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n會將手大幅度往側邊揮的跑步特徵也一樣！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "站住──！！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "吁……",
    "voice": "vo_adv_1236003_058",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "吁……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "可惡……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "\\n今天……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "跑太久了……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "吁……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "\\n體力，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "已經……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "透……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "支……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呼、",
    "voice": "vo_adv_1236003_059",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呼、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好，追到了！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "逮捕──！！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "嫌犯",
    "words": "呃啊啊！！",
    "voice": "vo_adv_1236003_060",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是【王宮騎士團】。",
    "voice": "vo_adv_1236003_061",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n關於漆彈事件，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可以讓我聽聽你的說詞嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "background",
    "bg_id": "501074"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……謝謝你老實交代。",
    "voice": "vo_adv_1236003_062",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這次的事件，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "果然是你穿著布偶裝所做的事對吧？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "……呿。",
    "voice": "vo_adv_1236003_063",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你家裡的布偶裝已經全數扣押了。",
    "voice": "vo_adv_1236003_064",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你是事先",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在各個地點藏了布偶裝，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n逃走後換裝、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "逃走後換裝，這樣反覆地犯案是吧。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "然後就跟證言一樣，",
    "voice": "vo_adv_1236003_065",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也在樹陰下，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n找到了脫下後丟棄的另一件布偶裝。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是令人吃驚啊……",
    "voice": "vo_adv_1236003_066",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒想到在萬聖節遊行中出現的魔物，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n居然也是你的布偶裝……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "話說回來，",
    "voice": "vo_adv_1236003_067",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這個些布偶裝真的是做得很精巧呢。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n竟然連我的前輩們都被騙到了，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這是你做的嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "……沒錯，",
    "voice": "vo_adv_1236003_068",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "是又怎樣？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……果然是這樣沒錯！",
    "voice": "vo_adv_1236003_069",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然對犯人這樣說可能不太好，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是我很尊敬你喔。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你很厲害呢……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "……！",
    "voice": "vo_adv_1236003_070",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "\\n妳說",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "尊敬……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "我、",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "我第一次被人這麼說……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "\\n第一次……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "被人誇獎……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "唔嗚嗚……！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦！？",
    "voice": "vo_adv_1236003_071",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "等等、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你為什麼哭了！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我說，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你冷靜一點……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會聽你說的。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這樣啊，",
    "voice": "vo_adv_1236003_072",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你從小",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就喜歡裁縫啊。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "卻被班上的同學們",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嘲諷……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "笑你明明是個男的……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n為此受到打擊後，你就閉門不出了嗎……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "是啊……",
    "voice": "vo_adv_1236003_073",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "我因為這樣導致積累的壓力失控，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "而做出了這樣的蠢事……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "因為不能說出自己喜歡的事物，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "而累積壓力……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "原來是這樣……",
    "voice": "vo_adv_1236003_074",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": "vo_adv_1236003_075",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "能夠懂你的心情喔。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "犯人",
    "words": "咦……？",
    "voice": "vo_adv_1236003_076",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就在不久之前，",
    "voice": "vo_adv_1236003_077",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也跟你一樣",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在意別人的目光，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n而不敢展現自己喜歡的愛好。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "想著",
    "voice": "vo_adv_1236003_078",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要是自己喜歡的東西被人否定了該怎麼辦……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "害怕被說「沒想到妳會喜歡那種東西」，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而導致別人對自己失望……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "想了各種可能性，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就開始害怕起來呢……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……不過呢，",
    "voice": "vo_adv_1236003_079",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "決定承認自己的喜好了。",
