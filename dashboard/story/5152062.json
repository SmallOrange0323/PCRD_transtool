  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "初夢に",
    "voice": "vo_adv_5134062_000",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "願い事、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ですかー……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "も",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ちろん、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あたしは",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "初心に帰り",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ビッグボスの座をお願いするですよ。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "賢いギャングは、ころころ目標を変えたりしねーですからね。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あのクソボスババアに下剋上を果たして、",
    "voice": "vo_adv_5134062_001",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ビッグなイノリさまが",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ファミリー全員を取り仕切る……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "来年の初日の出は、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "【ドラゴンズネスト】の夜明けになるですよ！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "というわけで、",
    "voice": "vo_adv_5134062_002",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "さっさと寝ることにするです……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "くか～……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "still",
    "still_id": "513406201"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "はーっはっはっは！",
    "voice": "vo_adv_5134062_003",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nついに……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "このイノリさまが",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n名実ともにギルドマスターの地位を……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ファミリーのボスの座を",
    "voice": "vo_adv_5134062_004",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "手に入れたですよ～！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "……にしても、",
    "voice": "vo_adv_5134062_005",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "出迎えがないですね？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ビッグボスイノリさまが顔を出したっていうのに。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "どいつもこいつも挨拶なしとは",
    "voice": "vo_adv_5134062_006",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "礼儀がなってねーです！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "still",
    "still_id": "513406202"
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "あら～、",
    "voice": "vo_adv_5134062_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "遅れてごめんなさい、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ボス。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nちょっと急患の対応で立て込んでて……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "やっと来たですね……",
    "voice": "vo_adv_5134062_008",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "うん？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nなんで闇医者が挨拶に来るんです？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nいつから【ドラゴンズネスト】のメンバーになったですか？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "クスクスクス……",
    "voice": "vo_adv_5134062_009",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "なにをおっしゃっているんです？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "イノリさんは今日から",
    "voice": "vo_adv_5134062_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n【トワイライトキャラバン】のボスになったんですよ……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "クスクスクス♪",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "still",
    "still_id": "513406203"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "は？　",
    "voice": "vo_adv_5134062_011",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "はああああああ！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nどんなミラクルが起きたらそうなるですか！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "全然理解が追い付かねーですよ！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "あなたがどう思おうが、",
    "voice": "vo_adv_5134062_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "これが現実よ。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ところでボス……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "新しい薬草を試したいんだけど、",
    "voice": "vo_adv_5134062_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n知り合いに",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "科学の礎になってもよさそうな人は",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "いないかしら？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "それと、",
    "voice": "vo_adv_5134062_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "賞金のかかっていた魔物を討伐したんですが、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "持ち帰ってきた首を置いておく場所がなくて……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ギルドハウスの",
    "voice": "vo_adv_5134062_015",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n倉庫をお借りしても……？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ぴいっ！？",
    "voice": "vo_adv_5134062_016",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n新鮮なまま持ち帰ってくるんじゃねーですよ！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あと",
    "voice": "vo_adv_5134062_017",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "マッドサイエンティストの",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n生贄にしてもいい知り合いもいねーです！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "他にまともなヤツはいねーんですか！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "あっ。",
    "voice": "vo_adv_5134062_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nナナカちゃんとアンナちゃんは金欠らしくって。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "次に賞金が入ったら返済するから、",
    "voice": "vo_adv_5134062_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nギルドのお金を借りられないか",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ってあなたを捜してたわよ？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "残りももれなく、",
    "voice": "vo_adv_5134062_020",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ろくでもねーヤツじゃねーですか！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n金にだらしねーのは感心しねえですよ、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "まったく……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "still",
    "still_id": "513406204"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "こんな連中、",
    "voice": "vo_adv_5134062_021",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "元々のギルドマスターは",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nどうまとめてたですか？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "泣こうが喚こうが、",
    "voice": "vo_adv_5134062_022",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "今はあなたがギルドマスター",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "もしも値しないと分かったら……",
    "voice": "vo_adv_5134062_023",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私の手で退場していただきます。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "……クスクス♪",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "もし不安なら、",
    "voice": "vo_adv_5134062_024",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "まずはお互いを",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n理解するところから始めてもいいわよ？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "さぁ、",
    "voice": "vo_adv_5134062_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "イノリちゃんの体を",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "私に診せてくれる？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ドラゴン族の体の仕組み、",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "興味があったのよ～♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ぴい～っ！？　",
    "voice": "vo_adv_5134062_026",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "も、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "もうやってられねーです！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "こんなん付き合ってたら",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "バラされるか",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n責任とらされて",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "牢屋いき確実です！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ボスじゃなくていいから",
    "voice": "vo_adv_5134062_027",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n【ドラゴンズネスト】にあたしを戻すですよ～！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ぴ",
    "voice": "vo_adv_5134062_028",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ゃあっ！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "新年早々、",
    "voice": null,
    "unit_id": 128311
