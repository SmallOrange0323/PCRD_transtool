[
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "很～好，",
    "voice": "vo_adv_5140321_000",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "豬隻們！",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n接下來就換個旨趣，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "來「一對一＜單挑＞」吧！？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "妳們之中",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "「最」強的那一隻，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "到「賽場上＜前面＞」來。",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是在叫我嗎？",
    "voice": "vo_adv_5140321_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "不是妳，去旁邊坐好。",
    "voice": "vo_adv_5140321_002",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "粉色頭髮雖然有「資質＜潛力＞」，",
    "voice": "vo_adv_5140321_003",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "但終究只是「臨陣磨槍＜外行人＞」。",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "在這點上，金髮精靈族──",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "妳受過的「訓練」可是異常地多啊？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是，",
    "voice": "vo_adv_5140321_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n在教育現場分出第一還第二這種排序，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是違反時代潮流的吧？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "的確有這種說法呢。",
    "voice": "vo_adv_5140321_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聽說最近甚至有學校舉辦運動會比賽跑時，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n是全體喊「預備～」後一起抵達終點的呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "啊？",
    "voice": "vo_adv_5140321_006",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "那是在搞啥？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n沒有「到達順序」的話是要賭「什麼」才好啊？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n那種「賭場＜比賽＞」是吸引不到客人的吧。",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "奇怪……？",
    "voice": "vo_adv_5140321_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們現在是在說運動會對吧？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雖然妳應該是在開玩笑，",
    "voice": "vo_adv_5140321_008",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但以防萬一我還是先說一下，修女。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒有獲得官方承認的賭博行為",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是被法律禁止的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "法律？",
    "voice": "vo_adv_5140321_009",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "是那個趁小官不在場時擅自定下的東西啊？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這傢伙，",
    "voice": "vo_adv_5140321_010",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真厲害啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n竟然把法律",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "說得像是在跟打工的同事喝酒聚會一樣。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過，",
    "voice": "vo_adv_5140321_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是意外啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n正義的學生會竟然與違法行為沾邊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這讓我們獲得了名為告發的王牌。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "蠢蛋，",
    "voice": "vo_adv_5140321_012",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "小官才不會去賭博，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "小官跟你們打賭。",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "她的腦袋完全變得像是賭徒一樣了，這樣沒問題嗎？",
    "voice": "vo_adv_5140321_013",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "…………",
    "voice": "vo_adv_5140321_014",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔，",
    "voice": "vo_adv_5140321_015",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不妙！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n綠之監視員一直刻意地在瞥手錶！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那麼，",
    "voice": "vo_adv_5140321_016",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就縮短時間，立刻開始吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n優妮們，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好朋友社，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 110911
  }
]
