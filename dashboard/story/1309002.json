    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "可是，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "該怎麼做才好……？",
    "voice": null,
    "unit_id": 130912
  },
