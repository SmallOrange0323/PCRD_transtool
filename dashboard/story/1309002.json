    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "哇呀啊！",
    "voice": "vo_adv_1309002_002",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n英雄先生！！？",
    "voice": null,
    "unit_id": 130912
