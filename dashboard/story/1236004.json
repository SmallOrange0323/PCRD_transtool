    "name": "智",
    "words": "你說的沒錯。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n……我其實對變裝很有興趣。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
