    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "才沒有那種事呢，",
    "voice": "vo_adv_1236004_009",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "小智妳也已經不是小孩了啊♪",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……也、",
    "voice": "vo_adv_1236004_010",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也是呢……",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "等等，{0}。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你從剛剛開始就在默默分裝糖果呢。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "對呢，",
    "voice": "vo_adv_1236004_011",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我們快點準備好吧！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n我朋友的孩子們也說他們要變裝，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "非常興致勃勃呢♪",
