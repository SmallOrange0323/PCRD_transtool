  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都是從以前就認識我了。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "他們是不是會認為，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n現在的我是個成熟穩健的道場孩子呢。",
