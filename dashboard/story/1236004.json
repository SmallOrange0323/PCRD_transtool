  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "還手忙腳亂的。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n如果知道妳要和男朋友約會，我就不會找妳幫忙了……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不、",
    "voice": "vo_adv_1236004_006",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不是的，他不是我的男朋友……！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我和{0}",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只是剛好在那邊遇到後，",
