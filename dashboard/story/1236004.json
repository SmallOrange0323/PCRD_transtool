    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真不愧是你呢。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n表面上感覺沒想什麼，其實觀察力很敏銳啊。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_1236004_022",
    "unit_id": 103731
  },
