  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "這種想法很孩子氣對吧。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那、",
    "voice": "vo_adv_1236004_013",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那種事情……",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……啊，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "聊著聊著手上的工作就停下來了呢。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n{0}你把糖果袋給我吧？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我跟你分工。",
    "voice": null,
    "unit_id": 103731
  },
