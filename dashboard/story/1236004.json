    "type": "dialogue",
    "name": "智",
    "words": "我很猶豫。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n該說是有點無法鼓起勇氣……",
