    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是這次她有好好說出來呢♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好感動……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這一切，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "都是託了你的福呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "喔，",
    "voice": "vo_adv_1236004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好像差不多要醒來了呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼就再見了～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500092"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……嗯……",
    "voice": "vo_adv_1236004_062",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我睡著了……？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "{0}，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你的嘴邊有口水喔？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你也睡著了啊。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_1236004_063",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "總覺得好像做了奇怪的夢呢……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是因為在睡著之前，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說了關於變裝的事嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_1236004_064",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "居然會在這種地方睡著，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "果然是太累了吧。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "得回去家裡",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好好地在床上睡一覺才行。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵，",
    "voice": "vo_adv_1236004_065",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "怎麼了──？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你的眼神怎麼那麼難過。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是因為要和我分開所以很寂寞嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真拿你沒辦法～",
    "voice": "vo_adv_1236004_066",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我就護送你回家吧♪",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "畢竟讓你一個人走夜路",
