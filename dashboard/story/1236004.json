    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "能對自己喜歡的事物說出喜歡之後，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n還注意到了",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "一件很重要的事。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那就是，",
    "voice": "vo_adv_1236004_069",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要享受喜歡的事物，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n和平是很重要的──",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就是這件事。",
