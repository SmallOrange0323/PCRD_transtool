  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好刺眼！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這道光是……",
