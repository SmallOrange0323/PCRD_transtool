    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "哎呀，原來是這樣啊？",
    "voice": "vo_adv_1236004_007",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "因為你們很般配，我就以為一定是情侶。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什、",
    "voice": "vo_adv_1236004_008",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼般配，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "才沒有……！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……首先，",
