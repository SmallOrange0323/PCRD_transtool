    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……是很孩子氣的事嗎？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就、",
    "voice": "vo_adv_1236004_018",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就是呢！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
