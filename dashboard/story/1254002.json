    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "話雖這麼說，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "但下次如果敢再妨礙我們的生意，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "我們也是有對策的。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n這點我先警告你們了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你們還打算繼續這種行為是嗎。",
    "voice": "vo_adv_1254002_057",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n為什麼你們做得出這麼過分的事情！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "妳還太嫩了。",
    "voice": "vo_adv_1254002_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "硬要說的話，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "這個世界是弱肉強食。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "弱者沒有資格抱怨。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n現在的小姑娘妳也一樣。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": "vo_adv_1254002_059",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「魔物",
    "voice": "vo_adv_1254002_060",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是個蹂躪踐踏一切生命的",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "邪惡存在。」",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我曾在書上看過這句話，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但是……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "抱歉……",
    "voice": "vo_adv_1254002_061",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n比起生氣，現在還有更該優先去做的事情呢。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我來治療喵特的眼睛。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特，",
    "voice": "vo_adv_1254002_062",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "看得見",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "咕嚕嚕♪",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "太好了……",
    "voice": "vo_adv_1254002_063",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你保護我。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都怪我太弱了……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原本以為",
    "voice": "vo_adv_1254002_064",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "即使是這樣的我，也有什麼做得到的事，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不過看來……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "並不是這麼回事。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……對不起，我不應該說喪氣話呢。",
    "voice": "vo_adv_1254002_065",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "至少將魔物的遺體",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "帶回牠們故鄉的森林吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "501851"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不曉得",
    "voice": "vo_adv_1254002_066",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣是否",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "能作為對牠們的弔唁……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "怎麼了，",
    "voice": "vo_adv_1254002_067",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你用頭抵住我的背……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是想帶我去哪裡嗎？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": "vo_adv_1254002_068",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這孩子……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "年幼的魔物",
    "words": "…………",
    "voice": null,
    "unit_id": 2313
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是和喵特",
    "voice": "vo_adv_1254002_069",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "同種類的魔物呢。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該是在剛才的狩獵受到了波及，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠現在非常虛弱。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "母親沒有在身邊，這就表示……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……遊俠無法干涉",
    "voice": "vo_adv_1254002_070",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n魔物之間發生的鬥爭，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為人類的自私自利而受傷的魔物是例外。",
    "voice": "vo_adv_1254002_071",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……這孩子還有救，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們把牠帶回去吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "我們收到信後，",
    "voice": "vo_adv_1254002_072",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "就立刻趕過來了♪",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "這孩子",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "就交由我們獵人公會照顧。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "放心交給我們吧，",
    "voice": "vo_adv_1254002_073",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "我們會負起責任",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "養育牠到回歸野外為止的。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "那麼，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "任務",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女遊俠",
    "words": "請繼續加油！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的，",
    "voice": "vo_adv_1254002_074",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "麻煩妳了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特，",
    "voice": "vo_adv_1254002_075",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "幸虧你發現了那孩子。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n喵特是牠的救命恩人喔。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "咕嚕嚕♪",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我能做到的",
    "voice": "vo_adv_1254002_076",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也只有那點事而已。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": "vo_adv_1254002_077",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然微不足道……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還是有我",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "做得到的事。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在保護那隻小魔物時，",
    "voice": "vo_adv_1254002_078",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓我回想起了以前的喵特。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當時我",
    "voice": "vo_adv_1254002_079",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "非常猶豫到底",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "該不該救這孩子。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當然，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有部分原因是我不曉得自己是否有辦法養育魔物──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我",
    "voice": "vo_adv_1254002_080",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當時身體",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "比現在還虛弱……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "光是為了活過當下就用盡了全力，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "別說是未來了，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我甚至沒辦法去好好想像明天。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是……",
    "voice": "vo_adv_1254002_081",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "將那份溫暖抱在懷裡後，我有了個想法。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n要我放棄這個拚命想活下去的",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "生命、",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這份光輝……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就像是在對自己見死不救一樣，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不想要那樣。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就這樣，",
    "voice": "vo_adv_1254002_082",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我投入一切養育的小小生命，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n在不知不覺間",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "長得這麼大了……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我自己也受到牠活下去的力量所影響，",
    "voice": "vo_adv_1254002_083",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "開始有了各種夢想。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "現在我做得到的事",
