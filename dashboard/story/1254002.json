    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "這可是遊俠的基本常識啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "…",
    "voice": "vo_adv_1254002_055",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "…！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n如果敢輕舉妄動，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就射出這支箭。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n……剛才居然沒有趁機逃走，",
