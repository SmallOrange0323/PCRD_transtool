    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物",
    "voice": "vo_adv_1254002_033",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不會憑自己的意志做出這種行為。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n牠們之所以會做出這麼過分的事──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "把能用的東西全部回收！",
    "voice": "vo_adv_1254002_034",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n除此之外的東西都扔掉！",
