    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n現在立刻拘捕所有人。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我和喵特負責抓住他們，",
    "voice": "vo_adv_1254002_037",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n麻煩你",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "支援我們。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "沙陸毒蛇的鱗片、",
    "voice": "vo_adv_1254002_038",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "綠葉野豬的角",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "和戳戳鳥的羽毛啊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n運到鄰國去",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "大概能賺點零用錢吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "再來",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "只要找到我們鎖定的獵物──",
