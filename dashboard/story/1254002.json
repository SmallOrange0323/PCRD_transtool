    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "好啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "看我擋住你們！！！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "……才怪咧。",
    "voice": "vo_adv_1254002_050",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "哼",
