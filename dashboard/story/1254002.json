    "words": "我沒事！",
    "voice": "vo_adv_1254002_053",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n跌倒時，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是喵特墊在下面保護了我！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特牠……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "那些傢伙敏銳的感覺的確不容小覷，",
    "voice": "vo_adv_1254002_054",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n不過相對的，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "則是非常無法承受高音和強光。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "使用耳罩或眼藥水來防範意外，",
