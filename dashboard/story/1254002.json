[
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人停留在魔物保護區裡的村子幾天之後的早上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與栞在村子周圍進行長跑訓練，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n訓練結束後，兩人回到了村子的入口。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "早上訓練很舒服呢，",
    "voice": "vo_adv_1254002_000",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n感覺身體也變輕盈了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵……",
    "voice": "vo_adv_1254002_001",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n在這種地方睡覺，可是會感冒喔。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我來拉你起來。",
    "voice": "vo_adv_1254002_002",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嘿咻。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": "vo_adv_1254002_003",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n感覺得出來嗎……！？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "其實",
    "voice": "vo_adv_1254002_004",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我開始有肌肉了♪",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然只有一點點，",
    "voice": "vo_adv_1254002_005",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我的手臂也能擠出肌肉囉……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你看。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n現在我說不定也背得動你呢♪",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你、",
    "voice": "vo_adv_1254002_006",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你這樣一直盯著人看，感覺有點難為情……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然看得出來對吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我努力練腹肌也是值得了♪",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我之前都完全胖不起來，",
    "voice": "vo_adv_1254002_007",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但自從開始每天訓練後，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我的食量也增加了很多……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然偶爾還是會生病，",
    "voice": "vo_adv_1254002_008",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我感覺身體狀況有漸漸在改善。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "說不定",
    "voice": "vo_adv_1254002_009",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "總有一天……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "即使是這樣的我，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n也能夠守護大家",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有你呢。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的。",
    "voice": "vo_adv_1254002_010",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "為了達成這個願望，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "首要目標是",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "全身練滿肌肉呢♪",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_1254002_011",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "找到了找到了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "遊俠小姐～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n有獵人公會",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "寄來的信件喔！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": "vo_adv_1254002_012",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "信件？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是教官寄來的……",
    "voice": "vo_adv_1254002_013",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n看來是",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "關於前陣子我們逮捕的男人的報告。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我來看信上",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "寫什麼──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "501690"
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "「關於你們逮捕的那個男人……",
    "voice": "vo_adv_1254002_014",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n經過我們偵訊的結果，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "得知他是盜獵集團的成員。」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "「而且還不是普通的小混混。",
    "voice": "vo_adv_1254002_015",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "他是會操縱魔物，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "從魔物和人身上搶走他們想要的東西……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n在遊俠間很有名的黑暗公會的成員。」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "「角、牙齒、毛皮……",
    "voice": "vo_adv_1254002_016",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "就算被遊俠盯上，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n他們照樣會將眼前想要的東西狩獵殆盡。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "因為那些傢伙的關係，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "甚至導致有的魔物瀕臨絕種。」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "「即使夥伴遭到逮捕，",
    "voice": "vo_adv_1254002_017",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "那群人也不會就此罷手。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n我想他們肯定還留在那個地區，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "希望你們繼續保持警戒。」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "「如果有得知什麼線索，",
    "voice": "vo_adv_1254002_018",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我會再聯絡你們。」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──以上就是信上的內容。",
    "voice": "vo_adv_1254002_019",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個犯人",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然還有其他同夥呢。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "村長有說過。",
    "voice": "vo_adv_1254002_020",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這附近的魔物們都很溫馴，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以容易被盜獵者盯上。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物的數量因此減少，",
    "voice": "vo_adv_1254002_021",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n導致毒沼產生、",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "暗夜精靈也增加，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "結果差點讓這裡變成無人可生活的荒蕪之地……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，",
    "voice": "vo_adv_1254002_022",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "多虧遊俠們開始守護魔物，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n才讓這裡又恢復成美麗的森林。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只是",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這似乎花費了長達幾十年的時間。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……我們的責任",
    "voice": "vo_adv_1254002_023",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很重大呢。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "得繃緊神經，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "確實取締盜獵者才行。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也去叫上在村子外頭待命的喵特，",
    "voice": "vo_adv_1254002_024",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n今天就增加巡邏次數，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後擴大巡邏的範圍吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "501850"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "…………",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "第五個",
    "voice": "vo_adv_1254002_025",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "檢查點，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有異常。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "待在這裡的魔物們，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真的都很溫馴呢……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「魔物",
    "voice": "vo_adv_1254002_026",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是個蹂躪踐踏一切生命的",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "邪惡存在，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因此沒有辦法與我們共存。」",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不認為在書上讀到的內容是錯的，",
    "voice": "vo_adv_1254002_027",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只是看到這裡的魔物後，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我認為書中的內容",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "並不代表一切。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n而且──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "……？",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
