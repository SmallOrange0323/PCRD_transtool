    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還不多，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也沒有強大到能保護他人。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我要從小事來培養自己的能力，",
