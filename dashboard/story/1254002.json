    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物在襲擊魔物……",
    "voice": "vo_adv_1254002_032",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那個",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不是爭奪地盤，也不是狩獵。",
