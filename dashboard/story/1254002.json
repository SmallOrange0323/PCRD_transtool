    "unit_id": 125413
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "哦，",
    "voice": "vo_adv_1254002_047",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "可不能讓妳得逞呢，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "貓耳小姑娘。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "首先由我來當妳的對手……",
