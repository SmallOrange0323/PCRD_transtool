  },
  {
    "type": "dialogue",
    "name": "盜獵團的成員1",
    "words": "唔哇！？",
    "voice": "vo_adv_1254002_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "盜獵團的成員1",
    "words": "\\n你們這些傢伙搞什麼！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "盜獵團的成員2",
    "words": "老大！",
    "voice": "vo_adv_1254002_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "盜獵團的成員2",
    "words": "遊俠來了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "盜獵團的成員2",
    "words": "\\n而且還是魔物使！",
