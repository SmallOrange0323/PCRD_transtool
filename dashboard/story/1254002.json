    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "哦哦，",
    "voice": "vo_adv_1254002_049",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵團的首領",
    "words": "居然就這樣老老實實地從正面攻過來？",
