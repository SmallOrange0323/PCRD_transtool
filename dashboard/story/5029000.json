  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "各位――！",
    "voice": "vo_adv_5029000_000",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n謝謝大家今天",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來參加我們【慈樂之音】的聖誕演唱會～！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "希望今晚",
    "voice": "vo_adv_5029000_001",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕老人",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n會到訪各位的家裡～♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "下雪的聖誕節。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【慈樂之音】的聖誕演唱會就在狂熱的氣氛中落幕了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "結束了，",
    "voice": "vo_adv_5029000_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "辛苦妳了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然妳可能已經聽膩了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過還是請妳接受這個掌聲吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人！",
    "voice": "vo_adv_5029000_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳覺得我們的演唱會",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼樣！？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_5029000_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很棒喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n【慈樂之音】有這麼大的進展，真是太好了……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "非常謝謝！",
    "voice": "vo_adv_5029000_005",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希和千歌她們",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也都很感謝製作人。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然這麼說有點突然，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是真的很謝謝妳當我們的製作人！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈。",
    "voice": "vo_adv_5029000_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n因為我最討厭無聊了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要是有趣的事，我都願意做。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且，",
    "voice": "vo_adv_5029000_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "今天可是令人愉悅不已的聖誕節喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然我不是聖誕老人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過能夠為興奮的國民們",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "帶來一些歡樂也不錯……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哎呀～",
    "voice": "vo_adv_5029000_008",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身本來覺得太吵，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "打算來抱怨個幾句的，\\n沒想到",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這個叫做什麼演唱會的東西還挺有看頭的嘛。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n果然聽你的話過來看是對的。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔，",
    "voice": "vo_adv_5029000_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在那裡。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n剛剛的偶像女孩。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029000_010",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？　",
    "voice": "vo_adv_5029000_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是迷路的小朋友嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這裡禁止工作人員以外的人進入喔！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小妹妹。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳叫誰小妹妹阿！",
    "voice": "vo_adv_5029000_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "統御黑夜之人，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯坦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在妾身的眼裡",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們才是小妹妹呢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那還真是失敬了。",
    "voice": "vo_adv_5029000_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "克莉絲提娜。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "伊莉亞‧奧恩斯坦……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯～",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個名字好像在哪裡聽過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n到底是在哪裡呢……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，",
    "voice": "vo_adv_5029000_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的事情不重要。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "我們要找的是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那邊那位偶像女孩。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……喂",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有事情要辦就快一點。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": "vo_adv_5029000_015",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "咦？",
    "voice": "vo_adv_5029000_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這不是小子嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！\\n你來看",
    "voice": "vo_adv_5029000_017",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕演唱會啦！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不。",
    "voice": "vo_adv_5029000_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你不用道謝啦！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也很希望{0}你來看……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔喔。",
    "voice": "vo_adv_5029000_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來妳送了他相關人員才有的票啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難怪他能夠在後台出入自如呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真可惜，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我本來打算等一下要去修理那群警衛的說……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身只不過是跟在{0}後面",
    "voice": "vo_adv_5029000_020",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就自然而然地進來了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "果然還是要送那群警衛很嚴～厲的處罰當作禮物才行。",
    "voice": "vo_adv_5029000_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且今天又是聖誕節……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人，",
    "voice": "vo_adv_5029000_022",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請手下留情……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是個可怕的聖誕老人啊。",
    "voice": "vo_adv_5029000_023",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯？　",
    "voice": "vo_adv_5029000_024",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼好像，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有什麼奇怪的聲音傳來……？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次又是怎麼了？　",
    "voice": "vo_adv_5029000_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "鈴鐺的聲音……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家快看！　",
    "voice": "vo_adv_5029000_026",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個是……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿！？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n馴鹿在天上飛耶！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "後面拉著的該不會是雪橇吧？",
    "voice": "vo_adv_5029000_027",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n簡直就像是……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔？　",
    "voice": "vo_adv_5029000_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來他似乎打算要降落在這裡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵呵！",
    "voice": "vo_adv_5029000_029",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n聖誕快樂！　",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐們！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……聖誕",
    "voice": "vo_adv_5029000_030",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "老人？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身還是第一次親眼看到……",
    "voice": "vo_adv_5029000_031",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次可是貨真價實的非法入侵。",
    "voice": "vo_adv_5029000_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n給你一點教訓後，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再請你離開這裡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦！？",
    "voice": "vo_adv_5029000_033",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "哇！？　",
    "voice": "vo_adv_5029000_034",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "等、",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "等一下等一下！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n老夫，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "是聖誕老人……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳看",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我身邊還有馴鹿……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無憑無據的。",
    "voice": "vo_adv_5029000_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我看你比較像是個穿紅衣服帶著馴鹿在天空飛的可疑人士吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": "vo_adv_5029000_036",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這麼一說，的確如此。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳這樣一講，",
    "voice": "vo_adv_5029000_037",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還真無法反駁……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "咦咦～！？　",
    "voice": "vo_adv_5029000_038",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "什麼都要講求證據，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這世道真的是越來越艱難了……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我知道了！　",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那麼，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那邊那位眼神清澈的少年！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n你現在，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "有沒有什麼想要的東西呢？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵～呵呵！　",
    "voice": "vo_adv_5029000_039",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小事一樁！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐們，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "請妳們看好囉！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "從大袋子裡面……",
    "voice": "vo_adv_5029000_040",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "拿出了",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "圍巾和手套……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5029000_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這一開始就放在裡面了吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵～呵呵！　",
    "voice": "vo_adv_5029000_042",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "還有還有。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "有暖爐、",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "暖桌，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "再追加一個剛烤好的番薯好了！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔～",
    "voice": "vo_adv_5029000_043",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "熱騰騰的呢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那個袋子",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "到底是怎麼回事啊？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然能拿出比袋子本身還要大得多的東西……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這正是",
    "voice": "vo_adv_5029000_044",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "能證明老夫是聖誕老人的證據。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n一個能夠變出人們想要的東西的",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "魔法袋！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "能夠變出想要的東西……",
    "voice": "vo_adv_5029000_045",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "能夠變出想要的東西……",
    "voice": "vo_adv_5029000_046",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……看來似乎沒有半分虛假呢。",
    "voice": "vo_adv_5029000_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聖誕老人找我們有什麼事嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的確是個乖孩子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但已不是會為了聖誕禮物而開心的年紀囉☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵。",
    "voice": "vo_adv_5029000_048",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "說到這個。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "其實我現在，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n正在尋找願意當這個地區的",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "新聖誕老人的人選。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我在空中飛的時候，",
    "voice": "vo_adv_5029000_049",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "聽到令人心曠神怡的歌聲，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n以及許多人的歡笑聲。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n我想那個人",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "或許有成為聖誕老人的天分，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "所以就前來找找看。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你說的是……",
    "voice": "vo_adv_5029000_050",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛剛的聖誕演唱會……？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳意下如何呢？",
    "voice": "vo_adv_5029000_051",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "偶像小姐？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "如果妳願意的話，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "要不要",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "當當看聖誕老人呢？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好、",
    "voice": "vo_adv_5029000_052",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好的！　",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請讓我試試看！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n如果我能成為聖誕老人",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "把幸福傳遞給大家，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我相信我在偶像的道路上也會有所成長的……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這樣啊這樣啊。",
    "voice": "vo_adv_5029000_053",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "既然這樣，我就把這個聖誕老人的袋子――",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜、伊莉亞",
    "words": "給我等一下！",
    "voice": "vo_adv_5029000_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "怎、",
    "voice": "vo_adv_5029000_055",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "怎麼了！？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那個什麼聖誕老人的……",
    "voice": "vo_adv_5029000_056",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咱們也想當！",
    "voice": "vo_adv_5029000_057",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029000_058",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n製作人和伊莉亞，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們也……？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵。",
    "voice": "vo_adv_5029000_059",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那充滿熱忱的眼神，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "不能視而不見呢。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那邊那位，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你覺得",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這兩個人如何？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對吧對吧！",
    "voice": "vo_adv_5029000_060",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真不愧是小子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如此誠實甚好……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
