  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "卻在不知不覺間變得十分可靠了，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "總會被{0}的進步給嚇到呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望能保持著這份溫柔",
    "voice": "vo_adv_7010004_009",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "繼續成長呢～",
