  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "吃到毒蘑菇後倒地了！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒錯喔～",
    "voice": "vo_adv_7010004_001",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那時候",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是把我嚇壞了呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_7010004_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "明明毒蘑菇的麻痺還沒消退，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n卻為了從魔物們手中保護我",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而站起身了呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "居然有這種事……",
    "voice": "vo_adv_7010004_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "伊緒老師，",
    "voice": "vo_adv_7010004_004",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是怎麼和{0}認識的呢？",
