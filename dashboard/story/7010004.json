    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我……",
    "voice": "vo_adv_7010004_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是在森林裡被植物纏住的時候",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "被他幫助了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然不像毒蘑菇那麼嚴重的事態，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但可真丟臉呢～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_7010004_006",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "果然{0}，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n總是抱持著一顆溫柔的心呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好乖好乖、",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "乖孩子～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "再次遇見的時候，",
    "voice": "vo_adv_7010004_007",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "他正在讀和他年紀不相符的讀寫書，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n那時候才知道",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "他失去記憶的事。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n於是就",
    "voice": null,
    "unit_id": 101811
