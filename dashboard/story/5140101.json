[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮＆克蘿依，",
    "voice": "vo_adv_5140101_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "歡迎兩位回來～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "公會管理協會找妳們過去，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "結果怎麼樣？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啊……",
    "voice": "vo_adv_5140101_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們受到了",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n針對本公會冒險進行方針",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "的「指導」。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對方似乎認為我們與危險的魔物對峙時，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會經常性地掉以輕心、志得意滿。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是喔……",
    "voice": "vo_adv_5140101_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "講白一點的話？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們在戰鬥前的對話，",
    "voice": "vo_adv_5140101_003",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "太長了。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_5140101_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我不覺得有這種事呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那是故意找碴啦。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5140101_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們最近捉弄花凜可能捉弄得太過頭了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看來她是那種意外地會記恨的人。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以就報復性地來訓話嗎？",
    "voice": "vo_adv_5140101_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是，妳這樣子講，又會引起事端的。",
    "voice": "vo_adv_5140101_007",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然還不到訓話的程度，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但對方還滿認真地跟我們商量的。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n像是能不能再長話短說一點",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之類的。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦～！",
    "voice": "vo_adv_5140101_008",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "用這種像是在指導短劇演出的感覺！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "明明我們",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也不是因為喜歡，才開那麼長的作戰會議啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "文書人員還真是輕鬆。",
    "voice": "vo_adv_5140101_009",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "把在前線拼命的我們，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只當作是棋盤上的棋子。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然無所謂，",
    "voice": "vo_adv_5140101_010",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但是要求暴怒發狂的魔物配合我們，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "「抱歉，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為上面的人很囉唆，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "今天的戰鬥麻煩縮短」",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這種事，\\n是有可能的嗎？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "它們基本上都是聽不懂人話的吧。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5140101_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那就來試試看吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n用幻影魔法創造出假想魔物",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嘿。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "虛擬魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可惡，出現了啊！",
    "voice": "vo_adv_5140101_012",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這個企圖消滅世界的",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "混帳宇宙暗黑大魔王！",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "慢著慢著。",
    "voice": "vo_adv_5140101_013",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n克蘿依，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "假想敵的規模太過宏大了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是說啊。",
    "voice": "vo_adv_5140101_014",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n那種賭上世界命運的冒險，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "協會也不會交給我們處理呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "稍微會威脅到城鎮和平的敵人，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種程度應該比較實際吧？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，是嗎？",
    "voice": "vo_adv_5140101_015",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那就重來一次。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "小短劇，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "魔物來襲。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "虛擬魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可惡，出現了啊！",
    "voice": "vo_adv_5140101_016",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "叼走魚的混帳野生喵特！",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "停下。",
    "voice": "vo_adv_5140101_017",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "等一下，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "赤腳追趕的陽光克蘿依。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個再怎麼說，也太過安逸了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大家都笑了。",
    "voice": "vo_adv_5140101_018",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "連太陽公公也笑了。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，好難。",
    "voice": "vo_adv_5140101_019",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我不知道啦，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "到底要怎麼樣的敵人才行啊。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個嘛。",
    "voice": "vo_adv_5140101_020",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n看上去很強但其實不強，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過還是有點強……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這樣是最理想的呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "瞭～",
    "voice": "vo_adv_5140101_021",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那麼Take ３，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "開始。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "虛擬魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可惡，出現了啊！",
    "voice": "vo_adv_5140101_022",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "身手還行的混帳強敵！",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "城鎮的和平由我們來守護！",
    "voice": "vo_adv_5140101_023",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n要上了，各位！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n優妮們，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是啊！",
    "voice": "vo_adv_5140101_024",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好朋友社，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "虛擬魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好，Cut──",
    "voice": "vo_adv_5140101_025",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？",
    "voice": "vo_adv_5140101_026",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n什麼嘛，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "成功縮短了啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "成功了呢。",
    "voice": "vo_adv_5140101_027",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "連我都嚇一跳。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "不對，",
    "voice": "vo_adv_5140101_028",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "根本沒有成功。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n已經太長了。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "長到令人吃驚。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學生會長，妳怎麼突然冒出來？",
    "voice": "vo_adv_5140101_029",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "手上還拿著拍攝用的魔導具。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "長過頭了。",
    "voice": "vo_adv_5140101_030",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "以行銷素材來說，內容長到很難使用。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "一般來說，這不是能投稿在魔石通訊網上的影片長度。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我要重新拍攝了，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "禁止超長台詞並請保持良好的節奏。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那麼，",
    "voice": "vo_adv_5140101_031",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "小短劇，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "下回預告──",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "叩叩，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "喀嚓！",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "日安，",
    "voice": "vo_adv_5140101_032",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "各位。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n最近，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我聽說即將舉辦一場特別講座呢。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什麼？",
    "voice": "vo_adv_5140101_033",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "特別講座？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦～",
    "voice": "vo_adv_5140101_034",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又要辦那個啊。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這次到底又要我們做什麼事？",
    "voice": "vo_adv_5140101_035",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "聽說是",
    "voice": "vo_adv_5140101_036",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "「寒冬的盛夏計畫」。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "寒冬的……",
    "voice": "vo_adv_5140101_037",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，什麼？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我也還沒有聽聞詳情，",
    "voice": "vo_adv_5140101_038",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n但聽說是要前往雪山穿著泳裝。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "啥！？",
    "voice": "vo_adv_5140101_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "下一回！",
    "voice": "vo_adv_5140101_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "\\n「寒冬的盛夏",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "與神聖學院的問題兒童」！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "不是，",
    "voice": "vo_adv_5140101_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "你們的腦袋是切嚕了嗎───！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "學生會副會長",
    "words": "哼哼哼……",
    "voice": "vo_adv_5140101_042",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "學生會副會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "學生會副會長",
    "words": "「學院＜高層＞」的想法，這回也很「突然＜任性＞」啊……",
    "voice": null,
    "unit_id": 18211
  }
]
