  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美美和{0}\\n來找之前所救助的小小格里芬玩耍――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇～軟綿綿的～♪",
    "voice": "vo_adv_1020006_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～♪",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯，",
    "voice": "vo_adv_1020006_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美也很開心呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥也快過來這邊～",
    "voice": "vo_adv_1020006_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一起玩吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？",
    "voice": "vo_adv_1020006_003",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥，有許多人朝這裡走過來了耶？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "喔，看來小小格里芬的目擊情報",
    "voice": "vo_adv_1020006_004",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "似乎是真的。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "好呀！那麼就馬上來捕捉吧！",
    "voice": "vo_adv_1020006_005",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦～！？",
    "voice": "vo_adv_1020006_006",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n為什麼你們要抓小小格里芬先生呢？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "啊？這個小鬼幹什麼啊？",
    "voice": "vo_adv_1020006_007",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "因為那傢伙的毛皮可以賣到好價錢啊。",
    "voice": "vo_adv_1020006_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n雖然國家是禁止販賣的。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "知道了就給我去別的地方玩。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你們要小小格里芬先生的毛皮……？",
    "voice": "vo_adv_1020006_009",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不、不能做這種事啦～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n這樣牠好可憐呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "啊啊，",
    "voice": "vo_adv_1020006_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "可惡！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n這小鬼在這裡晃來晃去真煩人！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n別來阻礙我！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊唔……！",
    "voice": "vo_adv_1020006_011",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n嗚哇～好痛喔～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "啊？你也打算來阻礙我嗎？",
    "voice": "vo_adv_1020006_012",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "給我讓開",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "哼！根本只會放話嘛！",
    "voice": "vo_adv_1020006_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "馬上就被打趴在地上了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "這樣就沒有人妨礙我們了。",
    "voice": "vo_adv_1020006_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n那麼，快點抓住牠吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥、哥哥，你不要緊吧？",
    "voice": "vo_adv_1020006_015",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎麼辦……",
    "voice": "vo_adv_1020006_016",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n再這樣下去，小小格里芬先生會……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥有作戰計畫嗎？",
    "voice": "vo_adv_1020006_017",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……美美只要去小小格里芬先生那裡就可以了吧。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美知道了～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥要和美美一起",
    "voice": "vo_adv_1020006_018",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n解救小小格里芬先生喔！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "可惡！",
    "voice": "vo_adv_1020006_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n這傢伙突然大鬧起來了！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "你還想打嗎！？",
    "voice": "vo_adv_1020006_020",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n真是個煩人的傢伙！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "嗯？這個叫聲是……？",
    "voice": "vo_adv_1020006_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n那邊也有小小格里芬嗎！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "是、是你假裝的嗎！",
    "voice": "vo_adv_1020006_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n你竟然趕欺騙我們！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n你是在挑釁我們嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥正在引開那群人的注意呦～",
    "voice": "vo_adv_1020006_023",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小小格里芬先生，趁現在趕快逃走吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔哇！",
    "voice": "vo_adv_1020006_024",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n你突然這樣是怎麼了～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你喜歡和美美在一起嗎？",
    "voice": "vo_adv_1020006_025",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好喔～我們一起逃走吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿，小小格里芬先生的背上好～溫暖♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "喂、喂！",
    "voice": "vo_adv_1020006_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n她們打算逃走喔！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "才不會讓妳們得逞！",
    "voice": "vo_adv_1020006_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜獵者２",
    "words": "\\n發射網槍！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！？",
    "voice": "vo_adv_1020006_028",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們被網子網住了～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗……",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小小格里芬先生也動彈不得了……",
    "voice": "vo_adv_1020006_029",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這、這樣的話……就用美美的劍！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我砍，我砍～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太好了！",
    "voice": "vo_adv_1020006_030",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n網子開了～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小小格里芬先生快點逃～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "糟、糟了！",
    "voice": "vo_adv_1020006_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "盜獵者１",
    "words": "\\n那個小鬼！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇～好～厲害！",
    "voice": "vo_adv_1020006_032",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美飛在天空中耶～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "飛在天空中呦♪",
    "voice": "vo_adv_1020006_033",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n啪噠啪噠、蹦蹦♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n可以飛到任何地方呦～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是小小格里芬平安脫逃，\\n幾天後王宮騎士團根據{0}們的\\n目擊情報抓到了盜獵者們。",
    "voice": null,
    "unit_id": null
  }
]
