  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}因為琳德的拜託",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而正在尋找烏爾姆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501730"
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "──因為偶發的門出現率上升，",
    "voice": "vo_adv_1278004_000",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "魔物從其他世界的湧入",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n增加為以前的數倍。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "由於不曉得堵住門的方法，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n推測損害無法歸零，但──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "各地居民們認知的提升、",
    "voice": "vo_adv_1278004_001",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "相互扶助組織的設立、",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n與蘭德索爾方面的合作……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這些都在進行當中，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n所以我想今後狀況會持續改善的",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……以上是我的報告。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──好的，",
    "voice": "vo_adv_1278004_002",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士他們不必說，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "今後要是也能持續增加和",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n吉歐‧格黑納的交流就好了呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是的。",
    "voice": "vo_adv_1278004_003",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼……",
    "voice": "vo_adv_1278004_004",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "辛苦妳了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n好好休息吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我先告辭了，",
    "voice": "vo_adv_1278004_005",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "萊拉耶爾殿下。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501730"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………",
    "voice": "vo_adv_1278004_006",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……唉。",
    "voice": "vo_adv_1278004_007",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "點心",
    "voice": "vo_adv_1278004_008",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還沒好喔，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n騎士。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "很明顯啦，",
    "voice": "vo_adv_1278004_009",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n因為你做出偷看",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這種不像你會做的事啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不只是我，",
    "voice": "vo_adv_1278004_010",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n萊拉耶爾殿下也注意到了吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊？",
    "voice": "vo_adv_1278004_011",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n意外什麼？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊哈。",
    "voice": "vo_adv_1278004_012",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n討厭啦──騎士先生，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我一直都很認真啦──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……畢竟，",
    "voice": "vo_adv_1278004_013",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我總不能讓主人丟臉，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n所以多少會",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好好做喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……嗯。",
    "voice": "vo_adv_1278004_014",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n那是──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……",
    "voice": "vo_adv_1278004_015",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好刺眼。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n甘蔗燈",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是壞了嗎──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天早上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在{0}醒來的稍早之前──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "早上囉──",
    "voice": "vo_adv_1278004_016",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂──",
    "voice": "vo_adv_1278004_017",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我說早上了──",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……唉，",
    "voice": "vo_adv_1278004_018",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n為什麼我得做這種事……",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哦啦──",
    "voice": "vo_adv_1278004_019",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1278004_020",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n起來了。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "早安啊。",
    "voice": "vo_adv_1278004_021",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你意外地愛賴床呢。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說誰還真是失禮啊。",
    "voice": "vo_adv_1278004_022",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你有委託的吧？",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "女僕服務，",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "代做家事那類的事。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看～吧。",
    "voice": "vo_adv_1278004_023",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n沒忘記",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是太好了呢──",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n因為取消費",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可是很高的。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊？",
    "voice": "vo_adv_1278004_024",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不管從哪裡看都像……",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呃，",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "倒也沒有啊。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不，你想想，",
    "voice": "vo_adv_1278004_025",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就是那個啊，",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "該說這不是憑外表決定的嗎？",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不受成見束縛啦。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我啊。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話說，",
    "voice": "vo_adv_1278004_026",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "枝微末節怎樣都好吧。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你接受吧？",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n既然接受了──",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "今天",
    "voice": "vo_adv_1278004_027",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "就讓我來擔任一天的女僕。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n我叫撫瑠無，",
