[
  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節甜點大賽結束後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又過了一段時間的某天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗨，",
    "voice": "vo_adv_5080007_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老婆婆！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "產地直送",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "印有伊麗莎白牧場標記的食材，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "幫妳送來囉！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "啊，",
    "voice": "vo_adv_5080007_001",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "謝謝妳，真陽。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天就是",
    "voice": "vo_adv_5080007_002",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "重新裝修後的開幕日了吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "是啊，",
    "voice": "vo_adv_5080007_003",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這一切全都",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "多虧大家給了我勇氣。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老婆婆所做的點心那麼美味，",
    "voice": "vo_adv_5080007_004",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n退休實在太可惜了。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎沒看到宮子啊，",
    "voice": "vo_adv_5080007_005",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n她又在店裡吃布丁了嗎？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "宮子她啊……",
    "voice": "vo_adv_5080007_006",
    "unit_id": 7912
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "快來買點心喲～",
    "voice": "vo_adv_5080007_007",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好吃的甜點店",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "重新裝修後今天再度開幕喲～",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好吃的點心等著你來買喲～",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n請收下這張傳單喲～",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真是奇怪……",
    "voice": "vo_adv_5080007_008",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子明明只是想吃布丁而已，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n為何非得",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "做這種事不可……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子在比賽時已經很努力了喲！",
    "voice": "vo_adv_5080007_009",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算什麼事都不做，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "應該也可以吃好吃的布丁吧！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好痛！",
    "voice": "vo_adv_5080007_010",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "別打了啦！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家知道了啦！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要好好幫忙才可以吃布丁！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這傢伙怕宮子會偷懶，所以老是跟得緊緊的。",
    "voice": "vo_adv_5080007_011",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "它好像把宮子誤認為妖精了喲。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家已經跟它說過好幾次宮子是幽靈，它還是聽不懂。",
    "voice": "vo_adv_5080007_012",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n實在有夠笨的喲。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好痛！",
    "voice": "vo_adv_5080007_013",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為什麼說你笨就聽得懂～！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊哈哈，",
    "voice": "vo_adv_5080007_014",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是熱鬧～",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不要笑了，還不快來制止它！",
    "voice": "vo_adv_5080007_015",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n妳們是來做什麼的啊！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為聽說好吃的甜點店正在大肆宣傳，",
    "voice": "vo_adv_5080007_016",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們就來看一下情況囉♪",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "既然這樣，",
    "voice": "vo_adv_5080007_017",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳們就拿著這張傳單去店裡吧！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n會給妳們一些折扣的喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "想不到，",
    "voice": "vo_adv_5080007_018",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳真的有好好在幫忙呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為了布丁，這也是沒辦法的事！",
    "voice": "vo_adv_5080007_019",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳也來幫忙！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "客人增加了，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子的布丁才會增加喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是是，",
    "voice": "vo_adv_5080007_020",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我一開始就有這樣的打算。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也想助老婆婆一臂之力。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人發完傳單後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到店裡去……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "聽說可以見到在空中飛的攬客店員，",
    "voice": "vo_adv_5080007_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就是這間店吧！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "有妖精出沒的甜點店，",
    "voice": "vo_adv_5080007_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "就是這裡嗎～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯，",
    "voice": "vo_adv_5080007_023",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就是這裡的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們準備了許～多的點心，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n請排成一列",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "再稍候一下～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚哇，",
    "voice": "vo_adv_5080007_024",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "人好多！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "有這麼多客人來，",
    "voice": "vo_adv_5080007_025",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子的布丁就穩了喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊！",
    "voice": "vo_adv_5080007_026",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "是妖精！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子不是妖精喲！",
    "voice": "vo_adv_5080007_027",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這傢伙才是妖精喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "……？",
    "voice": "vo_adv_5080007_028",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我什麼都沒看到啊？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你要藏到什麼時候啊！",
    "voice": "vo_adv_5080007_029",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在店裡就快出來，不會有事的！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "妖精",
    "words": "啾～",
    "voice": "vo_adv_5080007_030",
    "unit_id": 15511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哇～！",
    "voice": "vo_adv_5080007_031",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "這裡還有另一隻妖精呢！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "它也好可愛喔～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不對！",
    "voice": "vo_adv_5080007_032",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "它才是這裡的妖精！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子是幽靈喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊哈哈！",
    "voice": "vo_adv_5080007_033",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "幽靈是很可怕的！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n宮子看起來一點也不可怕啊？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "既然妳這麼說，",
    "voice": "vo_adv_5080007_034",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就讓妳瞧瞧宮子的可怕！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家要把店裡的點心",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "全部吃光光喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "妖精",
    "words": "啾啾！",
    "voice": "vo_adv_5080007_035",
    "unit_id": 15512
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好痛！",
    "voice": "vo_adv_5080007_036",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家是開玩笑的啦！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子只吃布丁而已喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家才不會跟你一樣做那種事！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "妖精",
    "words": "啾～",
    "voice": "vo_adv_5080007_037",
    "unit_id": 15511
  },
  {
    "type": "dialogue",
