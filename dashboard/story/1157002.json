  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這麼厲害的東西，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但我還有隨身帶著很多道具。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有機會再讓你看看。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──嗯。",
    "voice": "vo_adv_1157002_055",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是某種生物的蛋吧……？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n說到在這附近棲息，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "且會在沙灘上產卵的動物……？",
