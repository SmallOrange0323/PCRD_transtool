  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "等等，",
    "voice": "vo_adv_1157002_061",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
