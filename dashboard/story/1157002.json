    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "剛好、",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "奇蹟似地來海邊玩罷了，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你是在做送貨的打工嗎？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這、",
    "voice": "vo_adv_1157002_045",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣啊！",
