    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生你快看！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不覺得這個貝殼",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "很稀奇嗎？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不管是形狀還是顏色，",
    "voice": "vo_adv_1157002_058",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都充滿了神祕的魅力。",
