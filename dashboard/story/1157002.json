    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "船上飄逸著大漁旗，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n或許今天的漁獲",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是大豐收呢！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你說這副望遠鏡嗎？",
    "voice": "vo_adv_1157002_054",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然是",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "偵探的愛用品之一。",
