    "words": "要不要跟我一起……",
    "voice": "vo_adv_1157002_046",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在海邊",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "度假呢……？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那真是太好了。",
    "voice": "vo_adv_1157002_047",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "很好，",
    "voice": "vo_adv_1157002_048",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總算是蒙混過去了。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來先跟助手先生一起行動，",
    "voice": "vo_adv_1157002_049",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n想辦法打聽出交易對象的情報。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果會有危險……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就由我來阻止！　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生……",
    "voice": "vo_adv_1157002_050",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就由我來保護！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──",
    "voice": "vo_adv_1157002_051",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看我的～♪",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "衝浪也蠻有趣的呢！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "預測",
    "voice": "vo_adv_1157002_052",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "海浪的強弱跟流向，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n再用衝浪板在海上滑行……！",
