    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──那艘在遠方的船……",
    "voice": "vo_adv_1157002_053",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
