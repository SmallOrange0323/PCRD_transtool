    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我得保護助手先生才行，",
    "voice": "vo_adv_1157002_063",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼可以把目的給忘了呢。　",
