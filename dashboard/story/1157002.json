    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你認錯人了吧？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我只是一位來海邊玩的遊客……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": "vo_adv_1157002_043",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "果然還是太勉強了。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──嗨，",
