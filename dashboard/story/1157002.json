    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n沒想到還有這種項目啊……！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不錯耶，",
    "voice": "vo_adv_1157002_065",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要不要跟我比賽，看誰能釣到比較多魚啊？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n只要推理出魚的想法，再設法釣起來就好。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓你瞧瞧我的推理能力吧！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……咳咳。",
    "voice": "vo_adv_1157002_066",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": "vo_adv_1157002_067",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好，",
    "voice": "vo_adv_1157002_068",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼我們就……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n再玩一下吧。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這、",
    "voice": "vo_adv_1157002_069",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這也是沒辦法的事！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "身為偵探，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓助手能好好放鬆休息也是很重要的！　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊！",
    "voice": "vo_adv_1157002_070",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那邊有海之家喔！",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我一直",
    "voice": "vo_adv_1157002_071",
    "unit_id": 115711
  },
  {
