  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──呵呵♪",
    "voice": "vo_adv_1157002_059",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n在海邊玩也很愉快呢，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生♪",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不知道是不是因為這開闊的環境，",
    "voice": "vo_adv_1157002_060",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓人都不禁興奮起來了……♪",
