    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "既然如此……",
