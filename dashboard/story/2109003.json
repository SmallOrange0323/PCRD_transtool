    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咿呀！？",
    "voice": "vo_adv_2109003_033",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓妳真是的！",
    "voice": "vo_adv_2109003_034",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n火焰也波及到我們了喔！？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇哇哇！",
    "voice": "vo_adv_2109003_035",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n對不起～～！！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們也不能輸！",
    "voice": "vo_adv_2109003_036",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯！",
    "voice": "vo_adv_2109003_037",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "數到三就一起上喔！",
    "voice": "vo_adv_2109003_038",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "「鈴鐺！」",
    "voice": "vo_adv_2109003_039",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "「噗吉！」",
    "voice": "vo_adv_2109003_040",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音、胡桃",
    "words": "「雙重全力揮──擊」！！",
    "voice": "vo_adv_2109003_041",
