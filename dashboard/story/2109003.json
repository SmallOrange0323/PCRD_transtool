    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然有點浪費就是了……！",
