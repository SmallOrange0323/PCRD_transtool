  },
  {
    "type": "background",
    "bg_id": "500351"
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "……！",
    "voice": "vo_adv_2109003_042",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "吃我最後一擊吧！",
    "voice": "vo_adv_2109003_043",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不死鳥之終結！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "background",
    "bg_id": "500351"
  },
  {
