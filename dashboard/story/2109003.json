    "type": "dialogue",
    "name": "禊",
    "words": "鈴莓姐也來了呀！",
    "voice": "vo_adv_2109003_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "嘖！",
    "voice": "vo_adv_2109003_030",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n煩死了！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n是模索路晶留下的麻煩啊！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒、",
    "voice": "vo_adv_2109003_031",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n迎擊陷阱的操作方式是……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯……我想想……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是這樣嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "唔喔！？",
    "voice": "vo_adv_2109003_032",
