  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇，",
    "voice": "vo_adv_2109003_018",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華好聰明～♪",
