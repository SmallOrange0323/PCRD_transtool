    "type": "dialogue",
    "name": "鏡華",
    "words": "咻！！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯、",
    "voice": "vo_adv_2109003_012",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一、二……！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──碰！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紅的",
    "words": "噗嚕！？",
