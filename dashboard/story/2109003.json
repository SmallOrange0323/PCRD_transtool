  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n好燙！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n燙燙燙燙！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
