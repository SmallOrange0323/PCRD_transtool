  {
    "type": "dialogue",
    "name": "藍",
    "words": "噗……嚕……",
    "voice": null,
    "unit_id": 191614
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「沾到粉的史萊姆們行動都變遲鈍了耶──！？」",
    "voice": "vo_adv_2109003_014",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "妳這傢伙",
    "voice": "vo_adv_2109003_015",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n幹了什麼好事！？",
