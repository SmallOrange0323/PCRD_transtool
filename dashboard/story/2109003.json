    "type": "dialogue",
    "name": "卡里莎",
    "words": "竟然是",
    "voice": "vo_adv_2109003_024",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "拘束陷阱！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n而且這不是超高階的魔法嗎──！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哼哼♪",
    "voice": "vo_adv_2109003_025",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n因為最近不太平嘛！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好心的可麗餅店老闆",
