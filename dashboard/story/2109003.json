    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n從麵粉堆中爬出來了嗎……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "黃的",
    "words": "噗嚕噗嚕～♪",
    "voice": null,
    "unit_id": 191615
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊！",
    "voice": "vo_adv_2109003_048",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n又變得黏答答了……！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美、禊",
    "words": "「鏡華！？」\\n「鏡華！？」",
    "voice": "vo_adv_2109003_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "喂喂！！",
    "voice": "vo_adv_2109003_050",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n妳們可別太小看我啊！！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "background",
    "bg_id": "500351"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊！？",
    "voice": "vo_adv_2109003_051",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咲戀媽媽！！",
    "voice": "vo_adv_2109003_052",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「那傢伙竟然也沒事！？」",
    "voice": "vo_adv_2109003_053",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而、",
    "voice": "vo_adv_2109003_054",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而且……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n魔物們的傷口",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "都癒合了……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "哼！",
    "voice": "vo_adv_2109003_055",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n模索路晶的陷阱是很棘手沒錯……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "但少了公主騎士的妳們",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "怎麼可能打得贏我！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗚……！",
    "voice": "vo_adv_2109003_056",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我不會讓你",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對孩子們出手的！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "誰管妳啊！",
    "voice": "vo_adv_2109003_057",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "快給我去死吧！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我接下來可是要去阿澤爾德那裡……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "痛扁霸瞳皇帝啊！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咲戀大小姐！",
    "voice": "vo_adv_2109003_058",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請快逃走吧！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同一時刻，蘭德索爾宮殿附近──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "……",
    "voice": "vo_adv_2109003_059",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "呼……",
    "voice": "vo_adv_2109003_060",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "唉呀唉呀。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "王宮周圍果然",
    "voice": "vo_adv_2109003_061",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n設置了大量",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "針對我們的陷阱。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "看來由我來抓捕霸瞳皇帝",
    "voice": "vo_adv_2109003_062",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "是正確的啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n雖說若換成贊恩，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "應該也能靠武力突破所有陷阱就是了……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "still",
    "still_id": "210900301"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "站住！",
    "voice": "vo_adv_2109003_063",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n【憤怒‧軍團】！！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們不會再讓你",
    "voice": "vo_adv_2109003_064",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前進半步了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_2109003_065",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n原來是【王宮騎士團】團長，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n及其率領的主力部隊諸位啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "話說回來……",
    "voice": "vo_adv_2109003_066",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "現在鎮上各處",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "似乎都充斥著騷動呢。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n你們不需要趕去支援嗎？",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你別裝傻了！",
    "voice": "vo_adv_2109003_067",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那些都是",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你的同伴們搞的鬼吧！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你們真正的目標",
    "voice": "vo_adv_2109003_068",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是七冠……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是霸瞳皇帝對吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "來王宮的你就是敵方的主將！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "真是不錯的判斷──",
    "voice": "vo_adv_2109003_069",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我是很想這麼說，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n但看來你們的兵力已經分散了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n光憑著",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "這點程度的部屬",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "能夠攔得下我嗎？",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "居然瞄準陛下和{0}不在的時機偷襲……",
    "voice": "vo_adv_2109003_070",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看來你們在一定程度上掌握了我方的動向。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……只不過，",
    "voice": "vo_adv_2109003_071",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就算是情報走漏、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "戰況對我們極其不利──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "儘管如此，",
    "voice": "vo_adv_2109003_072",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也不構成我們退縮的理由！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在{0}他們回來以前，",
    "voice": "vo_adv_2109003_073",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們會死守這裡……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "……呵呵，",
    "voice": "vo_adv_2109003_074",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n在他們「回來以前」",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "是麼。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "前提是騎士少年他們──",
    "voice": "vo_adv_2109003_075",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "要能回得來才行啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼……？",
    "voice": "vo_adv_2109003_076",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "「萬能人偶」！",
    "voice": "vo_adv_2109003_077",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n把礙事者通通除掉！",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "萬能人偶",
    "words": "──「嗡──！嗡──！」",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔哇！？",
    "voice": "vo_adv_2109003_078",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那些人偶",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "接連聚集過來了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智、",
    "voice": "vo_adv_2109003_079",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茉莉、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "以及各位！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n魔像就麻煩你們了！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不必勉強，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只需要爭取時間就好！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "210900302"
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "了解！！",
    "voice": "vo_adv_2109003_080",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那純呢！？",
    "voice": "vo_adv_2109003_081",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然──",
    "voice": "vo_adv_2109003_082",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是去對付他！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "…………",
    "voice": "vo_adv_2109003_083",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "上次雖然是我們敗北……",
    "voice": "vo_adv_2109003_084",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
