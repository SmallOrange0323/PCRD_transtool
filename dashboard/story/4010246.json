  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "現實世界？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "為何",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我會",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "在這裡？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "等等，",
    "voice": "vo_adv_4010246_001",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "不太對……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "這是夢嗎。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n我在這夢裡變成了理想中的模樣……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "雖然不知是出於誰的意思，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "但感覺並沒有惡意。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "你也在這裡？",
    "voice": "vo_adv_4010246_002",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n是因為我想要有",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "跟你獨處的時間……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "才產生了這個夢啊。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "……",
    "voice": "vo_adv_4010246_003",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "沒事，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "當我什麼都沒說。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "話說",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "你接下來要幹嘛？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "有什麼想去的地方",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "或想做的事，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我都可以陪你去。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "呼……",
    "voice": "vo_adv_4010246_004",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "找個寧靜的地方放空一下",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "真的很棒呢。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n青翠的草木、",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "晴朗無雲的天空……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "光是看著",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "就覺得心曠神怡……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "老實說，",
    "voice": "vo_adv_4010246_005",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我有點受不了",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "大街上那種吵雜的環境……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n我天生就很難投入一般人",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "所從事的娛樂活動中。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "所以……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "感謝你",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "帶我來這個地方。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "可是……",
    "voice": "vo_adv_4010246_006",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "像這樣呆坐著，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "你都不會覺得無聊嗎？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "一直勉強你配合我的喜好的話，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我會覺得",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "有點過意不去……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "唔……",
    "voice": "vo_adv_4010246_007",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "感謝你的好意……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n但這究竟是",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "基於什麼理由？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "生日",
    "voice": "vo_adv_4010246_008",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "是指……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我的？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n我根本想都沒想過",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "自己會有那種東西呢……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "呵呵……",
    "voice": "vo_adv_4010246_009",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "這麼",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "說起來，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "今天",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "確實是個",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "無比特別的日子。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "那我也就沒有必要客氣了吧……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "你的生日祝福",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我確確實實收到了。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "這是……",
    "voice": "vo_adv_4010246_010",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "釣魚用具？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我會心懷感激地使用的。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "對了，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "下次有機會見面的話，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "一起去釣魚如何？",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "嗯，",
    "voice": "vo_adv_4010246_011",
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我會永遠記得",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "今天的事。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n不論是你送我的禮物，",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "還是一起去釣魚的約定……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "我都絕對不會忘記。",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135631
  },
  {
    "type": "dialogue",
    "name": "志名都",
    "words": "謝謝你，",
    "voice": null,
