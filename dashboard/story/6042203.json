[
  {
    "type": "background",
    "bg_id": "501000"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "救世主嗎……",
    "voice": "vo_adv_6042203_000",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "璃乃真是厲害呢！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總覺得她比平時",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "更沒精神耶……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "平常她見到前輩的話都會",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "激烈地",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "飛撲過來不是嗎？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、",
    "voice": "vo_adv_6042203_001",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那種事情是應該的！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "因為我想變得",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n和璃乃一樣",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "積極向上……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以，為了讓璃乃\\n恢復往常開朗的模樣，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也必須",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "做點什麼才行！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "發生什麼事了嗎……",
    "voice": "vo_adv_6042203_002",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真讓人擔心。",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有沒有什麼是我能幫上忙的呢……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總之，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我先去暗中",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "觀察一下璃乃！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣或許能看出點什麼！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？",
    "voice": "vo_adv_6042203_003",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n沒、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒這回事，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "應該說我只是偶然間看到過很多次，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "並、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "並不是因為我一直注視著前輩才……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呃……",
    "voice": null,
    "unit_id": 113011
  }
]
