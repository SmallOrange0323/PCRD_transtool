[
  {
    "type": "dialogue",
    "name": "真步",
    "words": "員工先生的真面目，",
    "voice": "vo_adv_5146301_000",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是賭場王‧",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "吉諾先生……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他跟王子先生他們",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "以前",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好像也",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有過什麼恩怨呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嗚欸欸欸，",
    "voice": "vo_adv_5146301_001",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "好受打擊……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "一直以來一起共事的員工先生居然……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "員工先生",
    "voice": "vo_adv_5146301_002",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "是對於在我們這裡上班有所不滿嗎……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n像是休假太少，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "或是想要求加薪之類的……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我要反省。",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我明明是經理，卻沒能察覺到……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這應該不是那種",
    "voice": "vo_adv_5146301_003",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "類似罷工的行為吧，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他剛才也說了",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他要奪走",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "「大夢想樂園」……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "總之咱們",
    "voice": "vo_adv_5146301_004",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在先打起精神吧。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "得趕快阻止他，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不然遊行",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可就泡湯了……！",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "說、",
    "voice": "vo_adv_5146301_005",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "說的也是說的也是！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "員工先生！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我們會阻止你的！！",
    "voice": null,
    "unit_id": 130911
  }
]
