    "name": "伊緒",
    "words": "從蔬菜開始切吧。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大家",
    "voice": "vo_adv_1018009_051",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "都有在看嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n要像他這樣切喔～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "學生們",
    "words": "好――――！",
    "voice": "vo_adv_1018009_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1018009_053",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大家都很認真在看人示範，很棒喔。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "身為老師，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也必須好好表現給大家看……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嘿咻！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊啊～！",
    "voice": "vo_adv_1018009_054",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n薰到眼睛了！　",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "被洋蔥～～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "唔～",
    "voice": "vo_adv_1018009_055",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？　",
    "voice": "vo_adv_1018009_056",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你眼睛也紅通通的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也幫你擦。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "伊緒～",
    "voice": "vo_adv_1018009_057",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "我有問題――！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "妳說示範，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "不是指料理，而是指夫妻的事情嗎～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？",
    "voice": "vo_adv_1018009_058",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "因為伊緒你們，",
    "voice": "vo_adv_1018009_059",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n就像我家爸爸媽媽在做料理一樣呀。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生的媽媽",
    "words": "哎呀，討厭！　",
    "voice": "vo_adv_1018009_060",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女學生的媽媽",
    "words": "我家孩子真是的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女學生的爸爸",
    "words": "哦哦，",
    "voice": "vo_adv_1018009_061",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女學生的爸爸",
    "words": "妳要是再亂說話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女學生的爸爸",
    "words": "就沒零用錢囉～？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是，",
    "voice": "vo_adv_1018009_062",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們並不是那種關係～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "可是，",
    "voice": "vo_adv_1018009_063",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "看起來就像是那樣啊～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "就像我家爸爸媽媽一樣～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是的！　",
    "voice": "vo_adv_1018009_064",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那個應該要說是情侶才對吧～？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，",
    "voice": "vo_adv_1018009_065",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那樣也不對！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你也別笑了，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "快點來說些什麼啦～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "眾人有如集中砲火一般扔出問題懷疑兩人的關係，\\n但最後還是品嚐完料理實習中做好的料理，順利結束了教學參觀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，伊緒接到了學院長通知預算超支的警告。",
    "voice": null,
    "unit_id": null
  }
]
