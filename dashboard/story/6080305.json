[
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "『願い竹』を見つけるはずが、",
    "voice": "vo_adv_6044305_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "事が大きくなってしまったな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "しかし、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "あそこまで織姫が悲しんでいる姿を見て",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n見捨てることなどできんからな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "うむ。",
    "voice": "vo_adv_6044305_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドもあの涙を見て",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "放っておけんだろう？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ここは我ら熾炎戦鬼煉獄血盟暗黒団の力、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "見せる時！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そして",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "我らの名を",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "世に轟かせるのだ！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "行くぞっ！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そこ！？　",
    "voice": "vo_adv_6044305_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "え、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "えーと、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そうだな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "その、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "あれだ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もし私が",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルド以外のやつと冒険していたら",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "貴様は",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "寂しいだろう？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そういう気持ちを指すと考えろ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "こら！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "キョトンとするなぁ！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そこは私には",
    "voice": "vo_adv_6044305_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "何とも言えないな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "織姫にとっては",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "付き合いが長く",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "情のある相手なのだろう。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だからこそ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "傷ついた織姫に代わって",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "我らが断罪をするのだ！",
    "voice": null,
    "unit_id": 113211
  }
]
