  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌因為變得坦率而情緒亢奮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她和{0}兩人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "感受到了精靈誕生的預兆──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "看著吧，",
    "voice": "vo_adv_1344004_000",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我和你將要孕育出的",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "新精靈。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊！",
    "voice": "vo_adv_1344004_001",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n一定……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會很可愛的。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我和你孕育的",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "新精靈……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "現在正是",
    "voice": "vo_adv_1344004_002",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "過去的不斷嘗試",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "開花結果的時候……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "拜託了，",
    "voice": "vo_adv_1344004_003",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "精靈啊。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "回應我的……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼喚……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和心意吧！　",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唔唔……",
    "voice": "vo_adv_1344004_004",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好刺眼……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你好，",
    "voice": "vo_adv_1344004_005",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不好意思突然把你叫出來。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你過來。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "其實我",
    "voice": "vo_adv_1344004_006",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "接下來打算要進行大冒險。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我希望你來",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "見證這件事。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……呵呵。",
    "voice": "vo_adv_1344004_007",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我並沒有要去哪裡。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是要去",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "打倒邪惡的大魔王之類的。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我在想──",
    "voice": "vo_adv_1344004_008",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要在這裡進行街頭演出。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你還記得嗎？",
    "voice": "vo_adv_1344004_009",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這個地方",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是我和你初次相遇的地方。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你幫我撿起了",
    "voice": "vo_adv_1344004_010",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我掉落的樂譜。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "假如",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那時候我沒有遇見你，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就不會有現在的我。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以……",
    "voice": "vo_adv_1344004_011",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我很久以前就決定，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n如果要進行街頭演出，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就要把地點定在這裡。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你願意聽嗎？",
    "voice": "vo_adv_1344004_012",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵，",
    "voice": "vo_adv_1344004_013",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n你那樣一說，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感覺我今天能唱得非常好……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就像有什麼新的東西要誕生一樣，",
    "voice": "vo_adv_1344004_014",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我有那種預感。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我開始了！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哦，",
    "voice": "vo_adv_1344004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快看啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在舉行演唱會耶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "竟然只憑一支麥克風演出，",
    "voice": "vo_adv_1344004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "真厲害呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性2",
    "words": "哇，",
    "voice": "vo_adv_1344004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性2",
    "words": "好美的聲音……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性2",
    "words": "\\n去聽一下吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "人聚集起來了……",
    "voice": "vo_adv_1344004_018",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不要緊的。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我已經",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不會害怕在人前",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唱歌了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為第一次在這裡唱歌的時候也好……",
    "voice": "vo_adv_1344004_019",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在打工的店裡",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "代唱的時候也好……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不論何時，",
    "voice": "vo_adv_1344004_020",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}都在守護著我。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像這樣──",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……咦？",
    "voice": "vo_adv_1344004_021",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聲音停止了……？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是喇叭故障嗎。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "連麥克風也是！？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我昨天明明有好好確認過的……！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "什麼什麼？",
    "voice": "vo_adv_1344004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "器材出問題了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "哎呀──",
    "voice": "vo_adv_1344004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "\\n這是街頭表演常有的事呢──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性2",
    "words": "啊～",
    "voice": "vo_adv_1344004_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性2",
    "words": "明明正精彩的說！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "觀眾",
    "voice": "vo_adv_1344004_025",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好不容易才聚集過來的……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "乾脆在沒有伴奏的情況下清唱？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不行，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一定會因為沒能好好抓住節奏",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而失敗的。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "麥克風也不能用，",
    "voice": "vo_adv_1344004_026",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要是提高音量……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "步調一定也會亂的。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這樣子",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只會讓觀眾還有他失望的吧……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哎呀呀……",
    "voice": "vo_adv_1344004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "看來今天就這樣結束了吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n雖然很可惜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "沒辦法啊。",
    "voice": "vo_adv_1344004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性1",
    "words": "畢竟是業餘的女生吧。",
    "voice": null,
    "unit_id": null
  },
