    "type": "dialogue",
    "name": "神官",
    "words": "我們認真地對此祈禱，",
    "voice": "vo_adv_1208001_087",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "希望它能為您帶來庇佑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n祝你們兩位",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "幸福常在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "那就先失陪了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1208001_088",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這還真令人開心啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拿到一樣東西後，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我開始也有點想要別的了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也不是說",
    "voice": "vo_adv_1208001_089",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要以備萬一，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但也是因為新年才剛開始，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就遇到了這麼不得了的事情啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是說啊。",
    "voice": "vo_adv_1208001_090",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果有收集到很多福氣，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n總會讓人覺得比較安心。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵，",
    "voice": "vo_adv_1208001_091",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總覺得開始愉快起來了啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "如此這般，兩人就此展開了收集福氣的旅程。",
    "voice": null,
    "unit_id": null
  }
]
