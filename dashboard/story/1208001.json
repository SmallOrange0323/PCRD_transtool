[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一個人走在蘭德索爾大街上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n街上因為迎來新的一年而十分熱鬧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀，",
    "voice": "vo_adv_1208001_000",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是小哥啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這還真巧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1208001_001",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "新的一年剛開始，你就很有活力呢。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n今年也請多指教啦。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，",
    "voice": "vo_adv_1208001_002",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這句話還真令人開心啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n都讓我想包紅包給你了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說到這個，小哥，",
    "voice": "vo_adv_1208001_003",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你接下來有什麼事情嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒什麼",
    "voice": "vo_adv_1208001_004",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "特別的事情？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那你接下來",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要跟我",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一起去神殿？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_1208001_005",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是也要去參拜，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但那不是我",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唯一的目的。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "護身符？",
    "voice": "vo_adv_1208001_006",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說到這個，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我聽說神殿的護身符",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "相當靈驗啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去求護身符是也不錯，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但我還有其他的目標。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "神殿中祭祀了特別的御神刀，",
    "voice": "vo_adv_1208001_007",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "每逢一年一度的新年，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n神官都會用那把御神刀來進行舞蹈表演。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我聽說那好像十分精彩，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "很想來看一次。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也有邀請公會的人，",
    "voice": "vo_adv_1208001_008",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但大家都有事。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而且我難得準備了新的新年和服，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就自己一個人來了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "事情就是這樣，",
    "voice": "vo_adv_1208001_009",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果小哥不介意的話，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要一起來？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你願意陪我嗎？",
    "voice": "vo_adv_1208001_010",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝謝你啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那我們",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就馬上前往神殿吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想占個好位子。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯～",
    "voice": "vo_adv_1208001_011",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼等都不開始啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "早就已經超過表演開始的時間了……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "我問一下，",
    "voice": "vo_adv_1208001_012",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "表演什麼時候才要開始啊？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "我都要等得不耐煩啦。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "哈",
    "voice": "vo_adv_1208001_013",
    "unit_id": 3512
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "啾……！",
    "voice": null,
    "unit_id": 3512
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 3512
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "好冷啊……",
    "voice": null,
    "unit_id": 3512
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "\\n別讓老人家在大寒天裡等著啊。",
    "voice": null,
    "unit_id": 3512
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "非、",
    "voice": "vo_adv_1208001_014",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "非常抱歉。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "我們目前正在為表演做準備。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "\\n還請各位",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "稍待片刻……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……小哥，我問你，",
    "voice": "vo_adv_1208001_015",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你不覺得情況有點奇怪嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "舞台已經搭好了，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下來只要讓拿著御神刀的神官\\n上台就行了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "他們究竟是在忙著準備什麼？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再說，仔細一看，",
    "voice": "vo_adv_1208001_016",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那位巫女不是遍體鱗傷的嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只是有事情要忙的話，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "她那副模樣也太奇怪了。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也這麼認為嗎？",
    "voice": "vo_adv_1208001_017",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "最好還是去問一下啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小姑娘，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可以耽擱妳一點時間嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "是、",
    "voice": "vo_adv_1208001_018",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "是的……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "那個，",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "如果是要問舞蹈表演的事情，",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "可以勞煩您再等一下嗎？",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～",
    "voice": "vo_adv_1208001_019",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不是要問這個。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我問妳，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "究竟",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是發生什麼事情了？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果妳不嫌棄的話，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可以跟我們商量。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "沒、",
    "voice": "vo_adv_1208001_020",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "沒有……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "完全",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "沒有問題……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但看妳講話時一臉苦惱，實在沒什麼說服力啊。",
    "voice": "vo_adv_1208001_021",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳不用擔心，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然我穿得花枝招展，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但也經歷過不少風浪喔。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "可、",
    "voice": "vo_adv_1208001_022",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "可是……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再說，",
    "voice": "vo_adv_1208001_023",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總不能讓觀眾",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "永無止盡地等下去吧？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "……我明白了。",
    "voice": "vo_adv_1208001_024",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "因為這件事不好張揚，",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "請兩位往這邊走。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "其實是",
    "voice": "vo_adv_1208001_025",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "發生了一點狀況，",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女",
    "words": "\\n讓今天負責進行舞蹈表演的神官大人支不開身。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是什麼樣的",
