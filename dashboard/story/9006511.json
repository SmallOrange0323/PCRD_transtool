  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請看魔物的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "中間左邊第二隻腳。",
