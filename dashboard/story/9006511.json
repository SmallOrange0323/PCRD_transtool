    "name": "雪菲",
    "words": "是啊……",
    "voice": "vo_adv_9006511_008",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n簡單來說，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "牠現在是怒不可遏……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
