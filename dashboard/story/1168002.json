  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "午休時間還沒結束就將鯛魚燒全部賣完的珠希與{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們倆一邊吃著午飯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一邊討論下一個計畫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "銷售十分穩定喵！",
    "voice": "vo_adv_1168002_000",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然銷售穩定，就該準備下一步了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "來擬訂計畫喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "話是這麼說，",
    "voice": "vo_adv_1168002_001",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要想計畫也不簡單喵……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有沒有什麼好點子喵……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "貓1",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵！",
    "voice": "vo_adv_1168002_002",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你是之前的……！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "等我一下喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我想說你可能還會來，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就準備了貓罐頭喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "貓2",
    "words": "嗚喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這些貓咪似乎都住在玩具工廠周邊喵。",
    "voice": "vo_adv_1168002_003",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n牠們經常來玩喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好乖好乖喵～♪",
    "voice": "vo_adv_1168002_004",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n貓罐頭好吃吧喵～♪",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你們那個像洗臉一樣的動作，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真的好可愛喵～♪",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "貓1",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你也要一起想吧喵～？",
    "voice": "vo_adv_1168002_005",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有沒有什麼好點子，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能讓鯛魚燒店生意更興隆喵～？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "貓1",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……？",
    "voice": "vo_adv_1168002_006",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "什麼喵？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要我跟著你走喵？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵！？",
    "voice": "vo_adv_1168002_007",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是工廠喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我都不知道這裡還有其他工廠喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……我懂了，",
    "voice": "vo_adv_1168002_008",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來如此喵～",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n因為這裡的設備壞掉了，所以無法使用了喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在的我應該修得好喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣一來，",
    "voice": "vo_adv_1168002_009",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就可以繼續製造很多玩具……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……對了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我想到一個好點子了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就在這裡",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "製作我的原創玩具喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "概念是這樣喵！",
    "voice": "vo_adv_1168002_010",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n「收到前好期待！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "收到後笑開懷！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "買鯛魚燒就送玩具」喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "蘭德索爾有好多間鯛魚燒店喵。",
    "voice": "vo_adv_1168002_011",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要在味道的品質以外做出差別，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就只能靠服務了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然決定了，",
    "voice": "vo_adv_1168002_012",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n午休結束後就立刻去找工廠長商量喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當天業務順利結束之後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你聽我說喵！",
    "voice": "vo_adv_1168002_013",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n工廠長准許我",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "使用那間老舊工廠了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，我希望你一起來幫忙喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……如此這般，",
    "voice": "vo_adv_1168002_014",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "完成了喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n怎麼樣喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵！",
    "voice": "vo_adv_1168002_015",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "然後只要按下它的肚子……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "鯛魚燒玩具",
    "words": "「來買鯛魚燒喵～♪」",
    "voice": "vo_adv_1168002_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……就會發出聲音喵！",
    "voice": "vo_adv_1168002_017",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是不是很創新喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯嗯～",
    "voice": "vo_adv_1168002_018",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你的反應好普通喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我繼續追加新的語音喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n順便也增加",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不同配色的玩具喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯，",
    "voice": "vo_adv_1168002_019",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然會有點超出預算……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這玩具肯定會大賣，沒問題的喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "放心喵！",
    "voice": "vo_adv_1168002_020",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我對鯛魚燒的味道很講究，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n對玩具的品質當然也會嚴格把關喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然決定了，",
    "voice": "vo_adv_1168002_021",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n明天馬上就來送玩具贈品喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天的午休時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊！",
    "voice": "vo_adv_1168002_022",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我在等你喵！！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "開店之前，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你先看看這個玩具喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n外皮的質感、",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "觸感、",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還有氣味，我都十分講究喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯喵？",
    "voice": "vo_adv_1168002_023",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你問我做了這麼多沒問題嗎？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我還嫌做得不夠多喵！",
    "voice": "vo_adv_1168002_024",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這些玩具的品質那麼棒喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "客人一定也感受得出來，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "肯定會大吃一驚喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼就馬上開賣喵────！！",
    "voice": "vo_adv_1168002_025",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唉…………",
    "voice": "vo_adv_1168002_026",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是為什麼喵？",
    "voice": "vo_adv_1168002_027",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n為什麼大家都不肯收下這個玩具喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這玩具明明……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
