  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽的朋友秋乃小姐……",
    "voice": "vo_adv_6088204_000",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是個精力充沛的人，真厲害。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "要是我",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "也能變得更像秋乃小姐一點的話就好了……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呃、",
    "voice": "vo_adv_6088204_001",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我想想喔……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "喔～呵呵呵！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀育幼院的胡桃！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好的，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n今天也要開開心心地做生意喔！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "感覺好像",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有點怪怪的。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "累積許多迷失方向的經驗",
    "voice": "vo_adv_6088204_002",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才能蛻變成了不起的大人，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你是這個意思吧？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "正因為有各種迷失方向的經驗，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才造就了今日了不起的秋乃小姐。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我也會努力的！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒、",
    "voice": "vo_adv_6088204_003",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒辦法啦。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "光是準備物產展和舞台就讓我焦頭爛額了，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n更多的工作我應付不來。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "唉～",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "秋乃小姐",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "跟咲戀媽媽都好厲害喔。",
    "voice": null,
    "unit_id": 121311
  }
