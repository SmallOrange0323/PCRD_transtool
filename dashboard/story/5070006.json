    "words": "怪物已經來了嗎！？",
    "voice": "vo_adv_5070006_066",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n救、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "救命啊！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "我還不想死！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n未婚妻在故鄉等我回去啊！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": "vo_adv_5070006_067",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人……！",
    "voice": "vo_adv_5070006_068",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
