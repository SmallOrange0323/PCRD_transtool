[
  {
    "type": "background",
    "bg_id": "500366"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從島上回來的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在書桌前奮力趕工剩下的作業，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但距離暑假結束已經沒剩多少時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就{0}大人的作業進度來看，",
    "voice": "vo_adv_5070006_000",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "怎麼想都不可能來得及交……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳怎麼可以說那種洩氣話呢，惠理子！",
    "voice": "vo_adv_5070006_001",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟現在做的是習題對吧？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要我們幫忙寫就來得及！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "說得也是。",
    "voice": "vo_adv_5070006_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n您的暑假",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "可不能被作業破壞。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗚嗚～",
    "voice": "vo_adv_5070006_003",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你是個品行端正的弟弟，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐非常開心，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過姐姐還是想幫忙耶。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有沒有什麼事能幫忙啊……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有沒有什麼能為",
    "voice": "vo_adv_5070006_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人做的事……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "……啊！",
    "voice": "vo_adv_5070006_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "只要……",
    "voice": "vo_adv_5070006_006",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不要讓暑假結束就行了……",
    "voice": "vo_adv_5070006_007",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "動手吧。",
    "voice": "vo_adv_5070006_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "走吧。",
    "voice": "vo_adv_5070006_009",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不，",
    "voice": "vo_adv_5070006_010",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼事都沒有！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "重要的是，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們待在這裡會讓你沒辦法專心對吧。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就是說啊。",
    "voice": "vo_adv_5070006_011",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們先告辭了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們相信",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您一定會完成作業。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們走囉，",
    "voice": "vo_adv_5070006_012",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "background",
    "bg_id": "500365"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳做好心理準備了吧，",
    "voice": "vo_adv_5070006_013",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "惠理子？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": "vo_adv_5070006_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是愚蠢的問題呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "這一切……",
    "voice": "vo_adv_5070006_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "都是為了弟弟！\\n都是為了大人！",
    "voice": "vo_adv_5070006_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人，",
    "voice": "vo_adv_5070006_017",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "祝您健康永久……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "再會了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐",
    "voice": "vo_adv_5070006_018",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會永遠思念著弟弟的喔……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對努力完成作業的{0}的背影",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "投以悲壯的眼神後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n惠理子與靜流靜靜離開了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "朝陽剛升起的早晨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在即將迎來新學期的月光學院裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n出現了兩個穿著不得體的人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "…………",
    "voice": "vo_adv_5070006_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "那個～",
    "voice": "vo_adv_5070006_020",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "兩位小姐……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "妳們看起來不像是我們學校的學生，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "穿成這樣是在做什麼？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "我們游泳池已經沒有對外開放了，",
    "voice": "vo_adv_5070006_021",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "\\n妳們就算待在這裡也進不去喔？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要有我們在，",
    "voice": "vo_adv_5070006_022",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "暑假就不會結束！！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們不會讓它結束！！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "…………啥？",
    "voice": "vo_adv_5070006_023",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "我聽不懂妳們在說什麼，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "但妳們不快點離開的話，我會很困擾。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我不走。",
    "voice": "vo_adv_5070006_024",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "為什麼？",
    "voice": "vo_adv_5070006_025",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "就算待在這裡，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "也進不了游泳池喔？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們的要求只有一個。",
    "voice": "vo_adv_5070006_026",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是不要開始始業式！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "如果你們硬要開始，",
    "voice": "vo_adv_5070006_027",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們就會破壞這個學校！",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "不要說那麼可怕的話嘛。",
    "voice": "vo_adv_5070006_028",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "\\n叔叔基於責任，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "必須叫【王宮騎士團】來管秩序了喔。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒關係。",
    "voice": "vo_adv_5070006_029",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n無論出現什麼樣的敵人，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們都不會撤回要求。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "妳們確定嗎？",
    "voice": "vo_adv_5070006_030",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "\\n叔叔我",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "校工",
    "words": "真的要報案囉！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "接到報案，我還以為是惡作劇……",
    "voice": "vo_adv_5070006_031",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n沒想到居然真的有兩個穿著泳裝的女人。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n這是什麼惡夢嗎……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "我也有看見，",
    "voice": "vo_adv_5070006_032",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "所以很遺憾的，這並不是在做夢呢……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "就稍微強硬地請她們離開吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "唔！？",
    "voice": "vo_adv_5070006_033",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "隊長，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "請看其中一個女人！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "那是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "破壞者！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "不不，",
    "voice": "vo_adv_5070006_034",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "破壞者怎麼可能會在這種…………",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "還真的！！！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n那不管怎麼看都是破壞者不是嗎！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "立即",
    "voice": "vo_adv_5070006_035",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "用通訊魔法請求支援！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n休假的人也通通叫起來！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "把能來的人通通找來！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "還有附近一帶也要封鎖！",
    "voice": "vo_adv_5070006_036",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也太誇張了……",
    "voice": "vo_adv_5070006_037",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "明明只要接受我們的要求，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們就什麼都不會做的說……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "報告，",
    "voice": "vo_adv_5070006_038",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "兩個營前來支援……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n真的有必要來嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "聽說是破壞者，",
    "voice": "vo_adv_5070006_039",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "我還以為是什麼三頭六臂的怪物，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n結果只是一個普通的女人不是嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "那種小角色",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "靠我一個人就足夠了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "少在那邊做蠢事，快點離……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "白痴！",
    "voice": "vo_adv_5070006_040",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "不要隨便靠近她！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐手～～",
    "voice": "vo_adv_5070006_041",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "刀！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "background",
    "bg_id": "501110"
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "唔！",
    "voice": "vo_adv_5070006_042",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵3",
    "words": "怎麼可能！？",
    "voice": "vo_adv_5070006_043",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵3",
    "words": "\\n我們的菁英",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵3",
    "words": "居然被不是破壞者的女人一擊打倒！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵3",
    "words": "怎麼能被她們小看！！",
    "voice": "vo_adv_5070006_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵3",
    "words": "進行鎮壓！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵們",
    "words": "是！",
    "voice": "vo_adv_5070006_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "等、",
    "voice": "vo_adv_5070006_046",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "等等！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n明明不知道對手的實力，不要隨便……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵們",
    "words": "喝啊～～～！！",
    "voice": "vo_adv_5070006_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就說……",
    "voice": "vo_adv_5070006_048",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不會讓你們通過這裡",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "了！",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "background",
    "bg_id": "501110"
  },
  {
    "type": "dialogue",
    "name": "士兵們",
    "words": "咕哇～～～！？",
    "voice": "vo_adv_5070006_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "所以我不是說了嗎……",
    "voice": "vo_adv_5070006_050",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "不過，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "事到如今也沒辦法了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "所有人聽好，",
    "voice": "vo_adv_5070006_051",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "盡全力逮捕她們！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "絕對不准鬆懈！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "怎麼這樣……",
    "voice": "vo_adv_5070006_052",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "明明只要不要開始始業式，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我們就什麼也不會做的……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "士兵們",
    "words": "咕嘿～～～！？",
    "voice": "vo_adv_5070006_053",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "507000601"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "剛才打倒的是第幾人啊？",
    "voice": "vo_adv_5070006_054",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n惠理子打倒幾人了？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "天曉得……？",
    "voice": "vo_adv_5070006_055",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n100人後我就沒在數了……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也是～",
    "voice": "vo_adv_5070006_056",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過，我好像有點累了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳要倒就倒吧。",
    "voice": "vo_adv_5070006_057",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n剩下的人我會設法擊敗的。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": "vo_adv_5070006_058",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳是知道只要那麼說我就會硬撐對吧？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟惠理子其實很溫柔嘛。",
