    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我才不是那種意思！",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "妳、",
    "voice": "vo_adv_5070006_060",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "妳們……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "目的到底是什麼……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n說什麼只要始業式",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "不開始……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們是為了不讓暑假結束！！",
    "voice": "vo_adv_5070006_061",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們只是",
    "voice": "vo_adv_5070006_062",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "在幫{0}大人爭取時間！",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "爭取時間！？",
    "voice": "vo_adv_5070006_063",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n會、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "會有比妳們更難纏的傢伙出現是嗎！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n能對付那種怪物的人，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "除非團長出馬……",
    "voice": null,
    "unit_id": 712
  },
