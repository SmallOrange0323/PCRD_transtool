    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "明明是童話風格，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卻又帶著高雅感……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這種設計",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是很難見到的唷！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "呀啊！？",
    "voice": "vo_adv_6042101_001",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "喂喂",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你突然幹什麼啦！？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "怎麼會有人二話不說就動手拽女孩子的身體！？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n璃乃！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這傢伙是怎麼回事啦！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "呀啊啊，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "而且竟然還不打算收手！？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "嗯……",
    "voice": "vo_adv_6042101_002",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你對我很好奇？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我是能理解你很想",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n觸碰看看如此高雅的我啦，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "但也要稍微多動點腦再行動吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你看，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃的臉都紅透了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你這變態要摸到什麼時候啦。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "唔……！",
    "voice": "vo_adv_6042101_003",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我說過了別突然戳過來吧！？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你這變態！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "變態可疑分子！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……咦，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "什麼？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你已經習慣被這樣叫了？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃啊，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這傢伙沒問題嗎？",
    "voice": null,
    "unit_id": 4611
  }
]
