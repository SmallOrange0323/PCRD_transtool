[
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "成功了……",
    "voice": "vo_adv_5208401_000",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "贏了……！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣一來就沒問題了吧……！？",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個世界",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "已經不會有危險了吧……！？",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不，",
    "voice": "vo_adv_5208401_001",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這種事",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "即使是身為管理者的我也不曉得……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不對，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我已經不是管理者了呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……未來的事誰都不曉得。",
    "voice": "vo_adv_5208401_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n不只有幸福的事，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也有可能",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "會發生不幸的事或災難。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": "vo_adv_5208401_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這不就是",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "自由的未來嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉……！",
    "voice": "vo_adv_5208401_004",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳說得沒錯！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_5208401_005",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我們贏了。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "辛苦妳了，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "霸瞳皇帝……",
    "voice": "vo_adv_5208401_006",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "最後擋在我們面前的果然是你嗎。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n有沒有靈魂並不重要。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "請你安息吧。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……志那都？",
    "voice": "vo_adv_5208401_007",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳在",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感謝他嗎？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不是的。",
    "voice": "vo_adv_5208401_008",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但若不是為了克服那傢伙帶來的恐懼，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n讓大家都團結在一起，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "那我們的未來的確也到此為止了。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……呵呵，",
    "voice": "vo_adv_5208401_009",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n現在就先跟仰望同一片天空的盟友，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "一同分享勝利的喜悅吧──",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉，",
    "voice": "vo_adv_5208401_010",
    "unit_id": 500096
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "辛苦妳了。",
    "voice": null,
    "unit_id": 500096
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "辛苦妳啦，",
    "voice": "vo_adv_5208401_011",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都！",
    "voice": null,
    "unit_id": 135512
  }
]
