    "words": "這個無頭白痴！」",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "還有",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "「快逃啊蠢貨！」",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "之類",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "的話，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶害怕得",
