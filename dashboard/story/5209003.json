    "name": "剎鬼",
    "words": "去幫她吧。",
    "voice": "vo_adv_5209003_014",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n順便用強化之力，",
