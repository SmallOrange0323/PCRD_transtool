  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了釐清雪野能夠認知到剎鬼的原因，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}他們正在討論。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "總結起來……",
    "voice": "vo_adv_5209003_000",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n在送別會時，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "只有騎士公能夠認知到我。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就在剛才雪野也能夠認知到我了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那時候雪野沒有，",
    "voice": "vo_adv_5209003_001",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "而現在卻有的東西。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要說和騎士公有什麼共通點的話……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "對。",
    "voice": "vo_adv_5209003_002",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n跟你的力量",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有關係。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "真是青澀的感覺啊。",
    "voice": "vo_adv_5209003_003",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你喜歡這種的？",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然我也不討厭，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但應該是強化之力才對吧。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "大概是因為生前，",
    "voice": "vo_adv_5209003_004",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我在黑曜宮接受過強化之力。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "在送別會時，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我應該早就已經和騎士公建立起連結了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "說、",
    "voice": "vo_adv_5209003_005",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "說起來……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n剛才那個，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂還是",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "第一次……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是啊。",
    "voice": "vo_adv_5209003_006",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所以",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "伯爵他們才會看不到我。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n反過來說，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "曾經接受過騎士公力量的傢伙，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "應該就能夠看到我。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然全都只是假設，",
    "voice": "vo_adv_5209003_007",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但這份力量的確也讓靈體稍微安定下來。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我不覺得兩者之間沒有關係。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "原、",
    "voice": "vo_adv_5209003_008",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "真高興又能見到妳。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雪野，",
    "voice": "vo_adv_5209003_009",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳過得還好嗎──",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "鬼族男性",
    "words": "喂。",
    "voice": "vo_adv_5209003_010",
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "鬼族男性",
    "words": "那個觸手",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "鬼族男性",
    "words": "不是「深邃庭園」的傢伙嗎？",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "鬼族男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "鬼族男性",
    "words": "上門鬧事？",
