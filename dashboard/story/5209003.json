    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶有話要告訴大家！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n偶知道解開詛咒的方法了！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "雪野、剎鬼",
    "words": "「真、真的嗎！？」\\n「真的假的。」",
