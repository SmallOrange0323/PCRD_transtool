    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "我就把牠們調教成",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "會聽我指令的奴隸了……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "比起讓小可璃亞或小烏爾姆成為我的「戀人」，",
    "voice": "vo_adv_2214096_025",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n還要簡單很～多呢……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "啊♡",
    "voice": "vo_adv_2214096_026",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "對了對了……",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "涅妃‧涅羅王女殿下？",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "關於小可璃亞，",
    "voice": "vo_adv_2214096_027",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n現在的她，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "已經能乖乖聽我的話。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n正跟「色慾之龍」一起──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "去吉歐‧格黑納",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "打擾一下了喔♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "妳那可愛的守護騎士，",
    "voice": "vo_adv_2214096_028",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "有著小小花蕾的小吸血妖花也──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "可能已經被打倒了也說不定♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "花蜜被吸個精光，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "花蕊也被扯下蹂躪，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "之類的……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……既然如此，",
    "voice": "vo_adv_2214096_029",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家應將阻撓眼前的愚昧之物，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "迅速排除。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「滅裂萬化‧",
    "voice": "vo_adv_2214096_030",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "輪迴轉掌」──",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "嗯哼哼♡",
    "voice": "vo_adv_2214096_031",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n不行♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……！？",
    "voice": "vo_adv_2214096_032",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "呀嗯，",
    "voice": "vo_adv_2214096_033",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "好可～怕♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "但是──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "不說",
    "voice": "vo_adv_2214096_034",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "其他地方，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n這裡，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "可是在我的床上。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "用從小幻那獲得的權能，",
    "voice": "vo_adv_2214096_035",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n暴力什麼的，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "全～部禁止……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "是的♡",
    "voice": "vo_adv_2214096_036",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n在這裡能做的事，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n只有身體與身體",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "溫柔地互相磨蹭──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "啊♡",
    "voice": "vo_adv_2214096_037",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n偶爾來點",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "激烈的也不錯♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n不過那種時候，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "要好好取得對方同意喔……？",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": "vo_adv_2214096_038",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "呵呵呵……♡",
    "voice": "vo_adv_2214096_039",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n這樣一看，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "還真是可愛……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n現在的妳彷彿，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "像是跳入蜘蛛巢穴的小蝴蝶♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "因為蜘蛛絲和毒，",
    "voice": "vo_adv_2214096_040",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "身體動彈不得。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n一直被親到變得渾身酥軟為止，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "都不會放過妳喔……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……蜘蛛，",
    "voice": "vo_adv_2214096_041",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "嗎──",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "回顧往昔，",
    "voice": "vo_adv_2214096_042",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "身為蜘蛛的──",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "阿剌克涅，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖本性腐敗，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n然其為被遺忘之鄉愁所苦之狀，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不免令人心生一絲憐惜。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "即便如此，",
    "voice": "vo_adv_2214096_043",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n對汝這般侵略者，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家提不起分毫同情。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "遑論，",
    "voice": "vo_adv_2214096_044",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n汝連源自母星地球之肉身都不具，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n卻仍沉醉於猴戲般之「色慾」，甚是愚物。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "唉呀，",
    "voice": "vo_adv_2214096_045",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "好～過分。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "為了模仿人類",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "而使用了皇家裝備，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n這一點妳不也一樣嗎？",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "「嫉妒」的皇女殿下──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "還是說，",
    "voice": "vo_adv_2214096_046",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "身為「非人」的妳，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n不會對像小櫻桃他們那樣的人類之子",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "懷抱嫉妒心呢……？",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那可未必。",
    "voice": "vo_adv_2214096_047",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "且不論妒意──",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "其餘情念，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "在奴家心中可謂無止境地。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是吧──",
    "voice": "vo_adv_2214096_048",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下？",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家和恁之羈絆，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n就讓這愚昧的山羊傢伙，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "好好見識見識如何。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "……！",
    "voice": "vo_adv_2214096_049",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "對手是公主騎士的權能的話──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n同樣",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "也能用公主騎士的權能",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "來對抗……？",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是。",
    "voice": "vo_adv_2214096_050",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n接受騎士閣下之寵愛於一身，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家已是天下無雙。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「滅裂萬化──",
    "voice": "vo_adv_2214096_051",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "破幻‧",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雲散霧掌」。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "呀",
    "voice": "vo_adv_2214096_052",
    "unit_id": 195611
  },
  {
