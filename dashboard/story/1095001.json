    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不可以，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這對空花來說",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還太早了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真的拜託妳了！",
    "voice": "vo_adv_1095001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不、",
