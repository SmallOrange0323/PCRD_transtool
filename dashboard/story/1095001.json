  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在鬧區散步的{0}，\\n發現了正在看什麼的空花。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻……",
    "voice": "vo_adv_1095001_000",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這間服裝出租店裡的和服，",
    "voice": null,
    "unit_id": 104511
  },
