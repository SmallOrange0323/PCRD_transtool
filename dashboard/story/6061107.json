  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這次有開心的事，也有痛苦的事。",
    "voice": "vo_adv_6061107_000",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這些都是很棒的回憶，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也讓我能夠察覺到重要的事。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這段時間是我有生以來",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最璀璨的日子了。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不，",
    "voice": "vo_adv_6061107_001",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還差得遠呢。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要等到我不會忘記在宅邸的所學到，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n並且以這副模樣受到大家的認同之後，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "才可稱得上是真正的淑女。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以在那天來臨之前，請你要好好",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "守護著我喔♪",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說得也是。",
    "voice": "vo_adv_6061107_002",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有羅伊德先生、瑪莎、",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一起上課的大家，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "以及",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔物的公主殿下。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然最後沒辦法參加舞會，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但跟大家的邂逅，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是我最珍貴的寶物！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我很高興",
    "voice": "vo_adv_6061107_003",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能夠聽到你這麼說！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這表示我在宅邸的學習",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "已經開始發揮作用了。 ",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "希望有一天，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "即便是現在這副模樣，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也能夠讓所有人都肯定我是淑女！",
    "voice": null,
    "unit_id": 105213
  }
]
