[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼！",
    "voice": "vo_adv_3002003_000",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "今天的訓練也是相當嚴苛呢～！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "全身都",
    "voice": "vo_adv_3002003_001",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "癱軟了。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐還",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全沒事的樣子好厲害啊，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n訓練量明明比我多上幾倍！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "超帥的！",
    "voice": "vo_adv_3002003_002",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我好憧憬啊～♪",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊哈哈。謝謝。",
    "voice": "vo_adv_3002003_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "單純是習慣了而已啦，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n因為我家裡本來就是間道場呢……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而且我和妳之間的年齡還是有差距的，",
    "voice": "vo_adv_3002003_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n基礎體力也就有差異了",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "反倒是茉莉，",
    "voice": "vo_adv_3002003_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n更讓我感到欽佩喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "明明還是個可以向父母撒嬌的年齡的小孩子。",
    "voice": "vo_adv_3002003_006",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n還能把【王宮騎士團（NIGHTMARE）】的地獄訓練",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n堅持到最後。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘿嘿♪",
    "voice": "vo_adv_3002003_007",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我對自己的體力可是有相當的自信呢！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我生來",
    "voice": "vo_adv_3002003_008",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就這麼健壯了，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n基本上",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也沒有怎麼感冒過！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以我不需要接種什麼疫苗也沒問題的～，",
    "voice": "vo_adv_3002003_009",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才不會軟弱到被病魔打敗的！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不行不行。",
    "voice": "vo_adv_3002003_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n必須要做好預防啊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "像蘭德索爾這樣，周圍由城墻包圍的要塞都市裡，",
    "voice": "vo_adv_3002003_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n流行病是很容易蔓延開來的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就算茉莉不會有事……",
    "voice": "vo_adv_3002003_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果在體內帶病源的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也會感染給周遭免疫力較低的人，甚至引發症狀。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "接受預防疫苗接種，",
    "voice": "vo_adv_3002003_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也是守護鎮上非常重要的一件事喔",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果害怕打針，我可以陪妳……",
    "voice": "vo_adv_3002003_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會牽住著妳的手的♪",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯～……",
    "voice": "vo_adv_3002003_015",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那我們約定好了喔？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n其實打針什麼的我才不怕呢？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n只是怕有個萬一？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好啦好啦。",
    "voice": "vo_adv_3002003_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳說的都對，公主大人♪",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……嗯？",
    "voice": "vo_adv_3002003_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那是，王宮那邊好像有什麼騷動？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的欸，",
    "voice": "vo_adv_3002003_018",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好奇怪喔！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n總是會佇立在門前的純，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也不在那裡！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好像",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有什麼叫聲或是噪音在嘈雜著～？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "發、發生什麼事了嗎？",
    "voice": "vo_adv_3002003_019",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n是盜賊還是魔物，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n打倒了純而入侵王宮……了嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯～，倘若真是如此那可是國家重大事故了。",
    "voice": "vo_adv_3002003_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n純，她可是守衛王宮最後的壁壘啊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我去查看一下情況。",
    "voice": "vo_adv_3002003_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n茉莉妳去安全的地方避難。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不，",
    "voice": "vo_adv_3002003_022",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也要一起去！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n雖然我只是見習生，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n好歹我也是【王宮騎士團（NIGHTMARE）】的一員！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "英雄，\\n是不會在危急時刻夾著尾巴臨陣脫逃的！",
    "voice": "vo_adv_3002003_023",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯～……",
    "voice": "vo_adv_3002003_024",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也沒時間說服妳了，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們就一起行動吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不知道我有沒有閑暇來保護妳，",
    "voice": "vo_adv_3002003_025",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n要是覺得情況不對妳一定逃跑喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n有時，戰略性撤退也是必要的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉，我們趕緊吧。",
    "voice": "vo_adv_3002003_026",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n雖然不是貴族，不能隨意踏入王宮內。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但可沒時間考慮這些了，這是緊急狀況。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就算之後被發怒，",
    "voice": "vo_adv_3002003_027",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n事後補上悔過書就沒事了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……突擊！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "盜賊往何處逃跑了！？",
    "voice": "vo_adv_3002003_028",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "在這邊！",
    "voice": "vo_adv_3002003_029",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n別想跑！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n把入侵者擊退！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喂～！",
    "voice": "vo_adv_3002003_030",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n發生什麼事了？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "……咦？",
    "voice": "vo_adv_3002003_031",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n妳，區區平民膽敢踏入王宮！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "話也不能這樣說吧，",
    "voice": "vo_adv_3002003_032",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n明明已經是不是區分貴族跟平民的時代了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比起這種事。",
    "voice": "vo_adv_3002003_033",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n到底發生什麼事了？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "嗯……",
    "voice": "vo_adv_3002003_034",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n似乎有個來歷不明的惡人，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n入侵王宮內部裡來了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "這種事情，還真是前所未聞……",
    "voice": "vo_adv_3002003_035",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n因為王宮內部的警備力比較弱吧，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n讓盜賊肆意妄為了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "危急時刻也沒辦法了，",
    "voice": "vo_adv_3002003_036",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n你們也來協助抓賊吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "了解了！",
    "voice": "vo_adv_3002003_037",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "由於王宮警備，完全是依靠純一個人……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n要是純被突破了的話，就變得相當脆弱了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你們知道純人在何處嗎？",
    "voice": "vo_adv_3002003_038",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n身手如此矯健的人，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我完全不認為她會這麼輕易就被打倒……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "我們也不知道。",
    "voice": "vo_adv_3002003_039",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n她這麼有責任感，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n我們也完全不認為她會擅離職守。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "能想到的只有，",
    "voice": "vo_adv_3002003_040",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n她被盜賊打倒……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n棄置在那邊的樹叢裡了吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼會……",
    "voice": "vo_adv_3002003_041",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純是",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不會輸給任何人的，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n她是絕對無敵的英雄！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "我們也希望如此啊，",
    "voice": "vo_adv_3002003_042",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n但只能先預估到最糟糕的情況了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "總之我們把大部分戰力，",
    "voice": "vo_adv_3002003_043",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ａ",
    "words": "\\n調去幫助陛下以及其他王宮要員們避難了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "妳們就，一邊搜索盜賊一邊應對吧。",
    "voice": "vo_adv_3002003_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n擊退不了也無所謂，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n至少得在避難完成之前爭取到時間。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "這種程度還是可以應付的吧，",
    "voice": "vo_adv_3002003_045",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員Ｂ",
    "words": "\\n即使是妳們這兩個尚不成氣候的新人？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果這就是任務的話，我們悉聽尊便。",
    "voice": "vo_adv_3002003_046",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……至少我可不認為我的本事，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n有差到被那些毫無危機意識的團員們當作傻子。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "爭論這些也無濟於事，",
    "voice": "vo_adv_3002003_047",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我們就把該做的事情順利達成來證明我們的實力吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……我們走吧茉莉，",
    "voice": "vo_adv_3002003_048",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那邊有戰鬥的聲響傳過來了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哦，",
    "voice": "vo_adv_3002003_049",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好的！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n唔哇，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我都緊張起來了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我精神都來了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵。",
    "voice": "vo_adv_3002003_050",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這和消滅魔物，或是街道巡守之類的一般勤務，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可完全不一樣喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過守護國家政治中樞的王宮，本來就是我們的職務。",
    "voice": "vo_adv_3002003_051",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們帶著驕傲地面對，去執行我們的職責吧。",
    "voice": "vo_adv_3002003_052",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n為國家奉獻生命，在此凋謝那也是無上榮耀。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過我可不算去死呢。",
    "voice": "vo_adv_3002003_053",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "坦白說……我一直期望有這麼一天，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n期盼著像這樣的發展。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "總是只有訓練和文書工作，",
    "voice": "vo_adv_3002003_054",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n好不容易磨練出來的本事都要生鏽了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500100"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈！",
    "voice": "vo_adv_3002003_055",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n太開心了，我的心，雀躍不已！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我等的就是這一刻！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧我的宿敵！",
    "voice": "vo_adv_3002003_056",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n讓我們更加相愛吧……☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_3002003_057",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "克莉絲提娜！",
    "voice": "vo_adv_3002003_058",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳沒事吧，我來幫忙了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那傢伙，就是入侵者嗎？",
    "voice": "vo_adv_3002003_059",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你到底是什麼人！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈，退下小姑娘！",
    "voice": "vo_adv_3002003_060",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n妳要是來打斷我的興致的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我就先把妳送入地獄了喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "現在是興高采烈的時候嗎",
    "voice": "vo_adv_3002003_061",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這裡可是王座聖殿啊。",
    "voice": "vo_adv_3002003_062",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是王宮最深的內部……是陛下活動的空間，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這事就算被饒恕也會是一生的恥辱啊！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "至少讓我們速速將這個賊人擊敗，",
    "voice": "vo_adv_3002003_063",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n來洗刷恥辱才是我們的使命吧！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳還是這麼熱血啊，一點都沒變。",
    "voice": "vo_adv_3002003_064",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n真是可愛極了",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是，這可不行啊。",
    "voice": "vo_adv_3002003_065",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這比想象中還要不得了了呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n怎麼辦呢，你…… 被人稱呼為賊人了哦？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_3002003_066",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個……",
    "voice": "vo_adv_3002003_067",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不，我不是什麼盜賊。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n看、看不出來嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我沒有和惡黨閒聊的必要！",
    "voice": "vo_adv_3002003_068",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n乖乖在那裡站好，我馬上將你斬首！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500100"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘿……",
    "voice": "vo_adv_3002003_069",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n小智，住手啊！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳太亢奮了，看不出來我是誰嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "閉嘴！",
    "voice": "vo_adv_3002003_070",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n沒道理讓一個盜賊叫我『小智』！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "等下！\\n小智姐！",
    "voice": "vo_adv_3002003_071",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗚呀！？",
    "voice": "vo_adv_3002003_072",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n茉莉？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n等下，妳不要突然衝進來啊……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是，",
    "voice": "vo_adv_3002003_073",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "請妳先冷靜一下！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n妳不可以和他戰鬥，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你會後悔的！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "欸、什麼意思……？",
    "voice": "vo_adv_3002003_074",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈哈。",
    "voice": "vo_adv_3002003_075",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n啊超有趣 的！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也是時候水落石出了。",
    "voice": "vo_adv_3002003_076",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在王宮內鬧過了頭，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n冒犯了陛下可就不妙了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……{0}、",
    "voice": "vo_adv_3002003_077",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "出來。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_3002003_078",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那是，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "{0}！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n怎麼會在這裡……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵。",
    "voice": "vo_adv_3002003_079",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n妳還記得，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n前幾天我開始經營高級食材的事業嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "從那之後……",
    "voice": "vo_adv_3002003_080",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n由於這傢伙的幫忙。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n感覺就開始變得越來越順利了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這傢伙挺能幹的，",
    "voice": "vo_adv_3002003_081",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n意外地非常有人脈，很有才華呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "今天也是為了來商量那件事，",
    "voice": "vo_adv_3002003_082",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n把他叫來【王宮騎士團（NIGHTMARE）】的據點裡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "順便。",
    "voice": "vo_adv_3002003_083",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n稍微在惡作劇上幫了我一把♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂。",
    "voice": "vo_adv_3002003_084",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n把兜帽，還給團長吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "欸、團長…… ？",
    "voice": "vo_adv_3002003_085",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也就是說，咦？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳，是純嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "still",
    "still_id": "300200301"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，嗯。",
    "voice": "vo_adv_3002003_086",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小智，妳就別看了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n很丟人的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": "vo_adv_3002003_087",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "果然是純嗎！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會把純的聲音封入魔法石中，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n拿來作為自己的鬧鐘所以我可以聽得出來！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦、咦？",
    "voice": "vo_adv_3002003_088",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n純，你就是入侵者……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這是怎麼一回事，克莉絲提娜！",
    "voice": "vo_adv_3002003_089",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n給我好好說明清楚！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "自己想想吧，小姑娘。",
    "voice": "vo_adv_3002003_090",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我已經說過了，單純就是惡作劇。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "最近，",
    "voice": "vo_adv_3002003_091",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我偶然代替了團長擔任起了門衛的工作。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正確地來說。\\n一直這樣站著太無趣了，\\n是我讓部下這麼做的。",
    "voice": "vo_adv_3002003_092",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正好，是在門衛換班的時間……",
    "voice": "vo_adv_3002003_093",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n由於團長滿身大汗的進了據點的淋浴間，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我才得以順手把她的兜帽給扒了過來。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就這樣，",
    "voice": "vo_adv_3002003_094",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我就帶著它躲了起來……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我四處宣揚團長是入侵者的同時，",
    "voice": "vo_adv_3002003_095",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n其他團員便一起追了過去。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "為、為什麼要幹這種無聊的惡作劇……？",
    "voice": "vo_adv_3002003_096",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不，我是對團長的真面目感到好奇啊。",
    "voice": "vo_adv_3002003_097",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n妳們難道不會好奇嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "團長總是說家訓什麼的，",
    "voice": "vo_adv_3002003_098",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n非常固執就是不把兜帽摘下……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我只是純粹感到好奇而已。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是出了我意料之外，搞得其他團員很狼狽。",
    "voice": "vo_adv_3002003_099",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這模樣實在太有趣了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就得意忘形起來了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "挑釁的說:如果真的要我把兜帽還給她，就試著將我打倒吧！",
    "voice": "vo_adv_3002003_100",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就這樣開心地玩起了捉迷藏呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很期待團長真的生氣了，",
    "voice": "vo_adv_3002003_101",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n便會全力過來要殺我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為平常把我視為自己人，",
    "voice": "vo_adv_3002003_102",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n所以根本不對我使出全力吧……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就這麼一次，想試著認認真真的打一場看看。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來我的計劃，算是成功了吧。",
    "voice": "vo_adv_3002003_103",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，對這場鬧劇我已經心滿意足了……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這真是一段幸福的時光啊，謝謝妳了團長♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好了別說了……",
    "voice": "vo_adv_3002003_104",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n拜託了，把兜帽還給我……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少、少年。",
    "voice": "vo_adv_3002003_105",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n把兜帽，拿過來。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊哈哈。",
    "voice": "vo_adv_3002003_106",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純扭扭捏捏的，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n被看到真面目有那麼羞恥嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "長得這麼漂亮，",
    "voice": "vo_adv_3002003_107",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n沒必要害羞的吧",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我、對我而言，",
    "voice": "vo_adv_3002003_108",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這就跟全裸一樣的羞恥。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我從出生以來就立刻因家訓而被遮住了臉蛋，",
    "voice": "vo_adv_3002003_109",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n從此之後除了家人以外，就沒有讓任何人見過了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_3002003_110",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別再看了……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀真是的，這種事情請不要再做第二次了。",
    "voice": "vo_adv_3002003_111",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我真的會生氣的，克莉絲。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈。",
    "voice": "vo_adv_3002003_112",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不如說是我真的想讓妳生氣呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這麼欺負妳我也過意不去了，",
    "voice": "vo_adv_3002003_113",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n都到這種程度了還是饒了妳吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "團長。",
    "voice": "vo_adv_3002003_114",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n多注意護髮之類的吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n別浪費了這麼好的底子呀？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵呵。",
    "voice": "vo_adv_3002003_115",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n下次，就以原貌再配點裝飾出來約會吧♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我拒絕。",
    "voice": "vo_adv_3002003_116",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不用了，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我就只是個身穿鎧甲的粗人……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是不打算裝飾，",
    "voice": "vo_adv_3002003_117",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是我現在還覺得很羞恥。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比起這種事。",
    "voice": "vo_adv_3002003_118",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真的，請你快把兜帽還給我。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎，有很多人的腳步聲傳過來了……",
    "voice": "vo_adv_3002003_119",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是其他【王宮騎士團（NIGHTMARE）】的團員們，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以為我是盜賊，所以要來打倒我的吧？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓這麼多的部下知道了……",
    "voice": "vo_adv_3002003_120",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n讓認識的人看到了我的原貌，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會羞愧而死的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈。",
    "voice": "vo_adv_3002003_121",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不如說是更應該要展示出來才對，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n枉費你長得這麼美。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "得知到團長是位絕世美女的話，",
    "voice": "vo_adv_3002003_122",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n團員們肯定會士氣大振的吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔唔……",
    "voice": "vo_adv_3002003_123",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲，妳可別跑。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n待這次的騷動塵埃落定之後，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這可不是禁閉或是減薪就可以草草了事的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦哦真可怕，不小心把你惹過頭了啊……",
    "voice": "vo_adv_3002003_124",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都給妳說教說了半天我已經不耐煩了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我要先告辭了♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再見啦，親愛的團長！",
    "voice": "vo_adv_3002003_125",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n然後是【王宮騎士團（NIGHTMARE）】愉快的伙伴們！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n啊哈哈哈哈……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊！等一下！",
    "voice": "vo_adv_3002003_126",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n別逃啊，這個以犯罪為樂的傢伙……！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊哈哈。",
    "voice": "vo_adv_3002003_127",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以我說過好幾遍了啊，純。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n克莉絲提娜，她遲早會鬧出大事情的……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說真的，還是早早把她趕出去吧？",
    "voice": "vo_adv_3002003_128",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯嗯。",
    "voice": "vo_adv_3002003_129",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是剛才，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n克莉絲還是把我們稱作伙伴了不是嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "慢慢地，",
    "voice": "vo_adv_3002003_130",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我覺得我們已經越來越親近了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果她能成為真誠而有信用的伙伴……",
    "voice": "vo_adv_3002003_131",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "便會成為我們無可替代而寶貴的戰力。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我這麼期待著，",
    "voice": "vo_adv_3002003_132",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以這點惡作劇我是不會追究的，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今後還是想和她繼續相處。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "做了這樣的判斷，或許我遲早會後悔吧……",
    "voice": "vo_adv_3002003_133",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但這就是我此刻真正的心情。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_3002003_134",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n果然就如克莉絲所言，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我真的太天真了吧……♪",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在純說完之後微微一笑的瞬間……\\n其他【王宮騎士團（NIGHTMARE）】的團員們，\\n都趕到了現場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "得知到團長是位絕世美女後，\\n團員們各個士氣大振。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "據說被大伙看見了真面目而極度害羞的純，\\n請了一個多禮拜的假。",
    "voice": null,
    "unit_id": null
  }
]
