  {
    "type": "dialogue",
    "name": "旁白",
    "words": "經歷一場激烈戰鬥，魔法少女們擊敗了反逆獸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾終於恢復和平，而她們在此──",
