  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我怎麼會是這種裝扮！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "別擔心，別擔心～♪",
    "voice": "vo_adv_5042001_001",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n穿上可愛衣服的",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不只璃乃喔！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳看，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "步未也是！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？",
    "voice": "vo_adv_5042001_002",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可是我沒有換衣服呀，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n再說，我怎麼可能穿什麼可愛的衣服……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5042001_003",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳需要鏡子嗎？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_5042001_004",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我怎麼會是這種裝扮～～！！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像",
    "voice": "vo_adv_5042001_005",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "除了騎士先生以外，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所有人的服裝都變了呢～",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我有什麼地方變得不一樣了嗎？",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是不是",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也變得很有趣",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "或是很可愛……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個嘛……",
    "voice": "vo_adv_5042001_006",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "鏡子給妳。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_5042001_007",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "結果我只有顏色跟花紋不一樣啊～！！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為什麼我們會是這種裝扮……",
    "voice": "vo_adv_5042001_008",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還有，這裡到底是什麼地方呀？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──關於這一點，",
    "voice": "vo_adv_5042001_009",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就由我來解釋吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": "vo_adv_5042001_010",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個聲音",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是從哪裡傳來的……？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃等人",
    "words": "呀啊！？",
    "voice": "vo_adv_5042001_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦……",
    "voice": "vo_adv_5042001_012",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你為什麼要戳我的身體呀……？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": "vo_adv_5042001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這個人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是怎麼回事呀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n初次見面就、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "戳女孩子的身體……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是不知羞恥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "奇怪……",
    "voice": "vo_adv_5042001_014",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "戳了我的衣服",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就有聲音冒出來……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "難道",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是我身上",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這件洋裝在說話嗎！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳終於發現了呀？",
    "voice": "vo_adv_5042001_015",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "說話的人就是我，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "愛麗絲！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真、",
    "voice": "vo_adv_5042001_016",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真的是衣服在說話……！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "總之，",
    "voice": "vo_adv_5042001_017",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我先按順序一一解釋，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n你們幾個可要好好聽清楚了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "首先，",
    "voice": "vo_adv_5042001_018",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我想你們應該對這個世界感到很困惑，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我就先從這一點開始說明吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這裡",
    "voice": "vo_adv_5042001_019",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "和你們原來的世界是不同的世界。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "說是書中的世界",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你們或許比較好理解吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "書、",
    "voice": "vo_adv_5042001_020",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "書中的世界……！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n莫非",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是剛才發光的那本書嗎！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "嗯，",
    "voice": "vo_adv_5042001_021",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "你們會驚訝也是合情合理的。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不、",
    "voice": "vo_adv_5042001_022",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我好像稍微可以理解……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "照妳所說的話，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這身裝扮",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "和周圍的景色……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n也就說得通了。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": "vo_adv_5042001_023",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要怎麼做才能回到原本的世界呢？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我也不知道。",
    "voice": "vo_adv_5042001_024",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "再加上，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "如果現在才要開始想辦法，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n你們很難有機會回到原本的世界吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？",
    "voice": "vo_adv_5042001_025",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為什麼這麼說呢……？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "現在這個世界",
    "voice": "vo_adv_5042001_026",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n正因為某個存在而面臨危機。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "在你們離開之前，搞不好這個世界就先消失了呢。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "牠的名字叫做",
    "voice": "vo_adv_5042001_027",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "黑之王。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n牠打算讓這個世界墜入黑暗之中！！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼會……",
    "voice": "vo_adv_5042001_028",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "居然有這麼可怕的存在……",
    "voice": "vo_adv_5042001_029",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個世界也很不容易呢……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳怎麼可以說得這麼事不關己呢。",
    "voice": "vo_adv_5042001_030",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳可是要打倒黑之王的人，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "是這個世界的救世主啊。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "什麼？",
    "voice": "vo_adv_5042001_031",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我、",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我是救世主！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "能夠打倒黑之王的人，",
    "voice": "vo_adv_5042001_032",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n就只有穿得上我「愛麗絲」的人……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "也就是妳！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳、",
    "voice": "vo_adv_5042001_033",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳突然跟我說這些，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "別擔心，別擔心～♪",
    "voice": "vo_adv_5042001_034",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們會和妳並肩作戰的！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一起去懲罰那個叫做黑之王的傢伙吧♪",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒、",
    "voice": "vo_adv_5042001_035",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我也會盡全力",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "支援璃乃妳們的……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也要戰鬥嗎！？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "是的。",
    "voice": "vo_adv_5042001_036",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n妳們的服裝接收到我的力量產生了變化，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n就表示妳們具有和黑之王戰鬥的力量。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了～～！！",
    "voice": "vo_adv_5042001_037",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n好～",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "為了幫助那些有困難的人，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要努力囉～～！！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呃、",
    "voice": "vo_adv_5042001_038",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也會",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "全力以赴的……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "謝謝！",
    "voice": "vo_adv_5042001_039",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那就拜託妳們了！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……不過，",
    "voice": "vo_adv_5042001_040",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那邊那個男的外表看起來",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n好像沒有受到我的影響呢。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "真奇怪，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "怎麼會這樣呢……？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "喔……",
    "voice": "vo_adv_5042001_041",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "嗯，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "很樂觀嘛。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n看起來也滿有幹勁的，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那也拜託你囉。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那、",
    "voice": "vo_adv_5042001_042",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我真的能夠",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "勝任救世主這個角色嗎……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "老實說，",
    "voice": "vo_adv_5042001_043",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我一點自信都沒有……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就連設計師養成學校的考試",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我也落榜了……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我連自己的夢想都實現不了，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼可能拯救世界……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "璃乃。",
    "voice": "vo_adv_5042001_044",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個世界的人們",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "說不定正因為黑之王而傷透了腦筋。",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果我們的力量可以幫上忙，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那我們就去做嘛！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "日和……",
    "voice": "vo_adv_5042001_045",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……救世主終究還是妳。",
    "voice": "vo_adv_5042001_046",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n另外兩個人",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "雖然具備和黑之王作戰的力量，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n但能打倒黑之王的還是只有妳一個人。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "──所以，",
    "voice": "vo_adv_5042001_047",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "要不要戰鬥，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "由妳做決定。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "由我……",
    "voice": "vo_adv_5042001_048",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我完全搞不懂，",
    "voice": "vo_adv_5042001_049",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "該做什麼才好。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但她說，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為黑之王的緣故，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個世界有可能會消失……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那樣一來，",
    "voice": "vo_adv_5042001_050",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們就無法回到原本的世界了……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要是再也見不到哥哥了，",
    "voice": "vo_adv_5042001_051",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "靜流姐會很難過吧……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "肯定也有人",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在等著日和和步未她們回去……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而且，",
    "voice": "vo_adv_5042001_052",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也很傷腦筋呢……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我想要幫她的忙……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……我明白了，",
    "voice": "vo_adv_5042001_053",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會努力看看的。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "說得好。",
    "voice": "vo_adv_5042001_054",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那麼，各位，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們出發吧！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃等人",
    "words": "好～！！",
    "voice": "vo_adv_5042001_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了討伐黑之王，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並且找方法回到原本的世界，一行人開始行動。",
    "voice": null,
    "unit_id": null
  }
]
