  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呵呵呵。",
    "voice": "vo_adv_1021008_000",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n國王陛下，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這可是笨蛋無法看見的衣服啊。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯、呼……♪",
    "voice": "vo_adv_1021008_001",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n已經可以演得很不錯了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這樣的話，",
    "voice": "vo_adv_1021008_002",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n正式上場應該沒有問題……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……！？",
    "voice": "vo_adv_1021008_003",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n噫呀……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥、",
    "voice": "vo_adv_1021008_004",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "從什麼時候開始，就在那裡了……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥看、看、看到了嗎……？",
    "voice": "vo_adv_1021008_005",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚哇哇，這樣我就嫁不出去了……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚……",
    "voice": "vo_adv_1021008_006",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦，哥哥問我剛剛在做什麼嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呃那個那個，",
    "voice": "vo_adv_1021008_007",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "應該怎麼說呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是在練、練習演戲……！",
    "voice": "vo_adv_1021008_008",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊……",
    "voice": "vo_adv_1021008_009",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為哥哥最近，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n也都是住在【咲戀育幼院】……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我想說哥哥應該知道，",
    "voice": "vo_adv_1021008_010",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n應該說哥哥也是在場一起聽過這件事才對……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "由於【咲戀育幼院】這裡，",
    "voice": "vo_adv_1021008_011",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n經營上大致安定下來了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以不是有講到說，",
    "voice": "vo_adv_1021008_012",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n也要做一些公會名義的工作嗎……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以，那個……",
    "voice": "vo_adv_1021008_013",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就變成是去訪問一些看護機構和托兒所之類的，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n然後演一些小短劇這樣的工作……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為我會害怕人群，",
    "voice": "vo_adv_1021008_014",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以本來覺得應該沒辦法參與……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是咲戀媽媽還有大家，",
    "voice": "vo_adv_1021008_015",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n都稱讚我的演技很好……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我雖然沒有什麼擅長的事情……",
    "voice": "vo_adv_1021008_016",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是演戲很有趣……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我總是受到",
    "voice": "vo_adv_1021008_017",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "【咲戀育幼院】的大家照顧……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以我、我想努力看看……",
    "voice": "vo_adv_1021008_018",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我想讓這齣戲，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n演得很成功……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以我才會在沒人看到的地方，",
    "voice": "vo_adv_1021008_019",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n偷偷練習……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇……？",
    "voice": "vo_adv_1021008_020",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n為什麼要突然拍手呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好可怕……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_1021008_021",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥說我演得很好嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥，",
    "voice": "vo_adv_1021008_022",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n在誇獎我呢……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻、嘻嘻……",
    "voice": "vo_adv_1021008_023",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是正式上場時，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n必須要在大家面前演戲……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我說不定，會因為緊張而演不好……",
    "voice": "vo_adv_1021008_024",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以……",
    "voice": "vo_adv_1021008_025",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n如果可以的話，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我想請哥哥陪我練習演戲……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我必須習慣，",
    "voice": "vo_adv_1021008_026",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n把演技展示給別人看……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果是在哥哥面前我會比較安心，",
    "voice": "vo_adv_1021008_027",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n或是說我就不會怕了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不、不行嗎……？",
    "voice": "vo_adv_1021008_028",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這樣子，是撒嬌過頭了嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "噫呀……！？",
    "voice": "vo_adv_1021008_029",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥、哥哥……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你好像、又在發光唷……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎、怎麼回事……？",
    "voice": "vo_adv_1021008_030",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚哇，果然哥哥也好可怕……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "still",
    "still_id": "102100801"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇啊……",
    "voice": "vo_adv_1021008_031",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n嗚嗚、嗯……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，哥哥……",
    "voice": "vo_adv_1021008_032",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗯、咳、咳……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚、",
    "voice": "vo_adv_1021008_033",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咳、咳……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "對、對對、對不起……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哭著哭著，話都講不清楚了……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我先、",
    "voice": "vo_adv_1021008_034",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n冷靜下來……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呼、哈……♪",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那、那個……",
    "voice": "vo_adv_1021008_035",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我等一下，要去參加共同練習……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……",
    "voice": "vo_adv_1021008_036",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n之前話劇社演的戲，評價很好……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "之後有好像是專、專業的……",
    "voice": "vo_adv_1021008_037",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n劇團的星探，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "給了我名片……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "然後我，就分配到了小角色……",
    "voice": "vo_adv_1021008_038",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n今天是參與演出的大家約好要集合，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一起練習的日子……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可是排、排練場的地點，",
    "voice": "vo_adv_1021008_039",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我不知道在哪裡……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇啊……",
    "voice": "vo_adv_1021008_040",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我、我、",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我該怎麼辦才好……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……？",
    "voice": "vo_adv_1021008_041",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就說了，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n不要用力摸我頭嘛……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不過最近，好像也已經習慣了……",
    "voice": "vo_adv_1021008_042",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "被哥哥摸摸頭後，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n就會變得比較冷靜了……♪",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……！？",
    "voice": "vo_adv_1021008_043",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n為什麼連哥哥，\\n也跟著慌張起來了……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這這這、這樣我很困擾……！",
    "voice": "vo_adv_1021008_044",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯、那個那個……？",
    "voice": "vo_adv_1021008_045",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒沒沒、沒事的……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我已經冷靜下來了……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以哥哥，",
    "voice": "vo_adv_1021008_046",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n請不要再做那個奇妙的動作了……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "被好、好多好多的路人，",
    "voice": "vo_adv_1021008_047",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n緊盯著看耶……！？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我不喜歡被人注目……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚……",
    "voice": "vo_adv_1021008_048",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚，地圖嗎……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我是有帶著啦……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "很、很難看懂的地圖對吧……",
    "voice": "vo_adv_1021008_049",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好像有些地圖上有標記的店舖不見了，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我已經搞不清楚自己在哪裡……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_1021008_050",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥常常來這一帶，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n說不定知道在哪裡是嗎……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "真、真是太好了……！",
    "voice": "vo_adv_1021008_051",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……",
    "voice": "vo_adv_1021008_052",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "在那邊的路口轉彎，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n是右轉對嗎……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我知道了，",
    "voice": "vo_adv_1021008_053",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "謝謝哥哥……♪",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我我我",
    "voice": "vo_adv_1021008_054",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "、\\n我必須趕快去排練場了……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇呀呀……！？",
    "voice": "vo_adv_1021008_055",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "太、太慌張結果不小心跌倒了……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚……",
    "voice": "vo_adv_1021008_056",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n共同練習會遲到……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚噫……",
    "voice": "vo_adv_1021008_057",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "果然打從一開始就沒有這個緣份，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我不可能當上主角……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……！？",
    "voice": "vo_adv_1021008_058",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥在做什麼……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥要教我，",
    "voice": "vo_adv_1021008_059",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n讓我冷靜下來的咒語嗎……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，好的……",
    "voice": "vo_adv_1021008_060",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "把眼睛閉起來嗎……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "然後，",
    "voice": "vo_adv_1021008_061",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一直唸「也成近視者至友」……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "雖、雖然不知道是什麼意思……",
    "voice": "vo_adv_1021008_062",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是哥哥應該不會騙我，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n或是教我奇怪的東西吧……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那、那我就相信哥哥，",
    "voice": "vo_adv_1021008_063",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n唸咒語試試看……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "也成近視者至友！",
    "voice": "vo_adv_1021008_064",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n也成近視者至友！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "也成近視者至友！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好、好像心情變比較好了……♪",
    "voice": "vo_adv_1021008_065",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_1021008_066",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n如果還是會緊張，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就把觀眾當成馬鈴薯就好了……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不一定要是馬鈴薯，",
    "voice": "vo_adv_1021008_067",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n當成洋蔥或是胡蘿蔔也不會緊張……？",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "馬鈴薯、洋蔥、胡蘿蔔……",
    "voice": "vo_adv_1021008_068",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "感覺好像咖哩呢……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我最喜歡咖哩了……♪",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "謝謝哥哥。",
    "voice": "vo_adv_1021008_069",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我的心情一下就變得好輕鬆……",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我現在，就趕去排練場囉……♪",
    "voice": "vo_adv_1021008_070",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "也成近視者至友！",
    "voice": "vo_adv_1021008_071",
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我一定會很華麗地，",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n扮演好主角的唷……！",
    "voice": null,
    "unit_id": 102131
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也成近視者至友、",
    "voice": "vo_adv_1021008_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也成近視者至友……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，是「有志者事竟成也」嗎？",
    "voice": "vo_adv_1021008_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你呀，還真是突然想出了這麼胡來的東西呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，這樣也好吧？",
    "voice": "vo_adv_1021008_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n如此一來胡桃就可以恢復精神，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "磊磊落落地迎向舞台……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有道是精誠所至金石為開，",
    "voice": "vo_adv_1021008_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你說不定很適合當幼教師呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": "vo_adv_1021008_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "主角嗎……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "明明還是國小而已，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n卻能擔綱專業劇團的主角，不是很了不起嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "胡桃呀，",
    "voice": "vo_adv_1021008_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n果然很有演戲的天份呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "斷了這樣的孩子的未來，",
    "voice": "vo_adv_1021008_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是件很殘忍的事吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "{0}，",
    "voice": "vo_adv_1021008_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你也是這樣想的吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我要把所有的惡意都驅逐，",
    "voice": "vo_adv_1021008_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n讓那孩子回到「那一側」。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣一來就能看到那孩子，",
    "voice": "vo_adv_1021008_081",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在舞台的中心華麗地綻放光彩……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你要給她許多、許多的鼓勵哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那孩子，",
    "voice": "vo_adv_1021008_082",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n一定也很期待那一天到來呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也成近視者至友！",
    "voice": "vo_adv_1021008_083",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "加油喔……♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥……？",
    "voice": "vo_adv_1021008_084",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥怎麼了嗎，在發呆呢……",
    "voice": "vo_adv_1021008_085",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "要、要不要找醫生來看看……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_1021008_086",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n沒事、嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "請哥哥不要勉強自己，",
    "voice": "vo_adv_1021008_087",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我會擔心唷……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "現在住在同一個屋簷下，",
    "voice": "vo_adv_1021008_088",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們就是一家人了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果有什麼煩惱的話，",
    "voice": "vo_adv_1021008_089",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n要找我聊聊喔……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻、嘻嘻……",
    "voice": "vo_adv_1021008_090",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n雖然，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我可能不太可靠……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，太陽都要下山了……",
    "voice": "vo_adv_1021008_091",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是小孩子應該要回家的時間了呢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為練習演戲演到太投入了，",
    "voice": "vo_adv_1021008_092",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n所以都忘記時間過了多久……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我得回去了……",
    "voice": "vo_adv_1021008_093",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "在家也可以練習……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "再不回去的話，",
    "voice": "vo_adv_1021008_094",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n咲戀媽媽會擔心的……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊哈哈……",
    "voice": "vo_adv_1021008_095",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我剛剛說了「家」呢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我已經完全把【咲戀育幼院】，",
    "voice": "vo_adv_1021008_096",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n當作我自己的家了呢……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "雖然，有家可歸是很可貴的事情……",
    "voice": "vo_adv_1021008_097",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可是，我果然還是想見到真正的父母呀……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "至少，",
    "voice": "vo_adv_1021008_098",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我想告訴他們我現在過得很幸福……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "雖然這樣很像在做白日夢……",
    "voice": "vo_adv_1021008_099",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果這次的劇作有好的評價，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n而我成為很棒的演員……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "然後可以在很大間的劇場之類的地方，",
    "voice": "vo_adv_1021008_100",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n演戲的話……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我那不曉得現在身在何處的爸媽，",
    "voice": "vo_adv_1021008_101",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n會不會也能因此找到我呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "開玩笑的……",
    "voice": "vo_adv_1021008_102",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻、嘻嘻……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好了，反正我們回程的目的地一樣……",
    "voice": "vo_adv_1021008_103",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "走夜路也很危險，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n所以哥哥也和我一起回去吧。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們就手牽手，",
    "voice": "vo_adv_1021008_104",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n肩併肩地回去吧。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "回到那個，",
    "voice": "vo_adv_1021008_105",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我們溫暖的家……♪",
    "voice": null,
    "unit_id": 102111
  }
]
