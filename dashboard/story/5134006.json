    "type": "dialogue",
    "name": "霞",
    "words": "\\n你想選擇一起克服難關的方法。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是這樣吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大家……",
    "voice": "vo_adv_5134006_055",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來是這樣想的……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "妳的「魔法」，",
    "voice": "vo_adv_5134006_056",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "老實說",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "超出了儂的理解範圍。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "而另一方面，少年的力量",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "雖然一樣不明，但性質較為接近。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "因為這樣，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "可能會比儂的強化更加有效。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂的使命",
    "voice": "vo_adv_5134006_057",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "是讓相信儂的人的願望得以實現。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那個，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "雖然一開始發生大失敗所以才導致這種狀況……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "但正因如此，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "剩下的兩個願望儂並不想出錯。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "站在森神大人的立場，",
    "voice": "vo_adv_5134006_058",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也是覺得這樣更為合適，所以才變更的吧。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂無法看見未來。",
    "voice": "vo_adv_5134006_059",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂有責任要收拾這個情況。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "所以",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "才做出了能夠盡量提高可能性的決定。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看妳一臉得意地說著，",
    "voice": "vo_adv_5134006_060",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但這說到底都是妳的錯吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂說啊，",
    "voice": "vo_adv_5134006_061",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這樣儂也不得不說個幾句了！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n妳許那種莫名其妙的願望，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "到底是怎麼回事！？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n如果能更謙虛地許個簡潔易懂的願望，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就不會發生這種事了啊！？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "別吵了",
    "voice": "vo_adv_5134006_062",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "～！！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨、森神",
    "words": "是！",
    "voice": "vo_adv_5134006_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……大家的想法",
    "voice": "vo_adv_5134006_064",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是我",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "錯了！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "未來",
    "voice": "vo_adv_5134006_065",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不知道會怎樣這本來就很正常！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以得相信大家的力量，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一定要成功！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這才是最好的做法對吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然。",
    "voice": "vo_adv_5134006_066",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那還用說嗎！！",
    "voice": "vo_adv_5134006_067",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "森神大人。",
    "voice": "vo_adv_5134006_068",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n照剛剛說的作戰進行就可以了。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我絕對會",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "和他一起擋住碎片的！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯！",
    "voice": "vo_adv_5134006_069",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n時間差不多了，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂先讓龍人族的小女孩巨大化吧。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼，",
    "voice": "vo_adv_5134006_070",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總算等到啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以說",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要用什麼方式巨大化呢？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有需要",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "擺出什麼帥氣的姿勢嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不必。",
    "voice": "vo_adv_5134006_071",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n森神光───束！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫啊啊啊啊啊啊啊啊啊！？",
    "voice": "vo_adv_5134006_072",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "賦予力量原來是這種感覺嗎！？",
    "voice": "vo_adv_5134006_073",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這怎麼看都像是在進行拷問啊！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "大可放心，",
    "voice": "vo_adv_5134006_074",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這次有正確地實現願望了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n看好了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哦哦～！？",
    "voice": "vo_adv_5134006_075",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n好厲害，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真的巨大化了！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈──哈哈哈！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "路人就像垃圾一樣！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那、",
    "voice": "vo_adv_5134006_076",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那是什麼！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n看來今年年底",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "有很豪華的活動啊～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "製作得真是精巧呢。",
    "voice": "vo_adv_5134006_077",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n動作也栩栩如生……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "稍稍引起了騷動，",
    "voice": "vo_adv_5134006_078",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "然而這也是無可奈何。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "接下來輪到",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "少年你了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不必露出那種害怕的表情，",
    "voice": "vo_adv_5134006_079",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "死不了人的。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "只是有點～",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "稍稍的～～～",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "其實滿痛的就是了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那什麼，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就和生長痛差不多的。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那麼，",
    "voice": "vo_adv_5134006_080",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "森神光───束！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生──！？",
    "voice": "vo_adv_5134006_081",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你還好嗎！？",
    "voice": "vo_adv_5134006_082",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "聽你發出了從來沒有聽過的叫聲，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還活著嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太、",
    "voice": "vo_adv_5134006_083",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你沒事吧……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有什麼",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不一樣的感覺嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "小女孩的巨大化，",
    "voice": "vo_adv_5134006_084",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
