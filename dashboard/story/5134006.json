    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "的狀況",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "變得有些危險哪。",
