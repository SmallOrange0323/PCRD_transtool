    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "會用來強化他的那股力量。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "然後，",
    "voice": "vo_adv_5134006_038",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "再藉由少年為妳強化，",
