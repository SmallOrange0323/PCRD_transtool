    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "由於種種原因，",
    "voice": "vo_adv_5134006_035",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "作戰有稍微改變。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我看",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你們可以出來了吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦……",
    "voice": "vo_adv_5134006_036",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦──！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你怎麼會在這裡……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這名少年",
