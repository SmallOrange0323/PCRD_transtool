[
  {
    "type": "background",
    "bg_id": "500182"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}等人為了阻止隕石造成損害而奔走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們各自都下定決心之際，展開了最後的作戰會議。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱歉，",
    "voice": "vo_adv_5134006_000",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓各位久等了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我來報告",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這邊得到的結果。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5134006_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為這樣，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以似乎很難讓居民去避難。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "墜落地點",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "倒是預估得差不多了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖說有人帶路，",
    "voice": "vo_adv_5134006_002",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但要東奔西跑真的是很累人……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過也因此",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "化解了年底的運動不足呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你們那邊如何？",
    "voice": "vo_adv_5134006_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n有找到應對碎片的辦法了嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯。",
    "voice": "vo_adv_5134006_004",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n使用我的「魔法」，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就能夠減緩碎片的速度了。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n只要借助森神大人的力量，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我想應該會有辦法的。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "想不到",
    "voice": "vo_adv_5134006_005",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這個女孩",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "使用的並非魔法，而是叫超能力的東西。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n預知夢也一樣，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "如果是超出儂理解範圍的力量，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那也能夠接受。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不過也因此，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "令人擔心是否能夠確實強化……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "作戰我已經明白了，",
    "voice": "vo_adv_5134006_006",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可是絕對不能失敗哦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "萬一失敗了的話，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在那邊不知道在想些什麼的元凶",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n可是會造成超越那個霸什麼皇帝的擊殺人數啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "欸，",
    "voice": "vo_adv_5134006_007",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不是，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這是因為那個……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不管是下跪道歉還是什麼的儂都願意！！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n就、",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就拜託各位了～！！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "用不著那麼做，",
    "voice": "vo_adv_5134006_008",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們也絕對會守護蘭德索爾的！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "老實說",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是有點害怕啦……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過各位，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "直到最後都請多擔待了！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "喔～！",
    "voice": "vo_adv_5134006_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯？",
    "voice": "vo_adv_5134006_010",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "怎麼了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "你們必須到遠處去不是嗎？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "原來如此，",
    "voice": "vo_adv_5134006_011",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "你的意見儂明白了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那麼做確實有可能，",
    "voice": "vo_adv_5134006_012",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "而且成功率也會提高才是。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不過儂無法保證",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就是了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "都已經到這個地步，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那就竭盡全力吧。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "看來你",
    "voice": "vo_adv_5134006_013",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "已經做出決定了呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "旁邊那位女孩",
    "voice": "vo_adv_5134006_014",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "似乎也有什麼想法呢。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_5134006_015",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然可能",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會惹姊姊生氣……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也決定了。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "森神大人，",
    "voice": "vo_adv_5134006_016",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們也差不多該走了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n大家都已經出發囉。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "霞。",
    "voice": "vo_adv_5134006_017",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n方便聽我說句話嗎？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "background",
    "bg_id": "501472"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "城裡那些人都沉迷於逛攤位啊……",
    "voice": "vo_adv_5134006_018",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是悠哉呢。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "明明巨大的隕石都快掉下來了。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "畢竟原本是值得慶賀的日子嘛。",
    "voice": "vo_adv_5134006_019",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不過能否以值得慶賀的日子結束，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就得看我們的表現了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……好了，",
    "voice": "vo_adv_5134006_020",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "進行最終確認吧。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n雖說依照初音畫的圖，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能夠預測出隕石飛來的方位……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "其他的方位，",
    "voice": "vo_adv_5134006_021",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就由我和惠理子負責監視沒錯吧？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟無法保證一切都會照著預知夢的內容發展。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我會確實監視的。",
    "voice": "vo_adv_5134006_022",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這全都是為了守護",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那位大人與我的世界……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "拜託妳們了。",
    "voice": "vo_adv_5134006_023",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "萬一",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "隕石從其他方位飛過來，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n也請保持冷靜，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "打出信號來告知我們。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "了解。",
    "voice": "vo_adv_5134006_024",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們馬上就去分配的位置上。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n為了成功，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我們盡最大的努力吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我會待在祈梨身邊，",
    "voice": "vo_adv_5134006_025",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "將發射光束的時機告訴她。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我想盡量",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "避免碎片擴散，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以妳一定要等我打出信號後，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再發射光束。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "希望妳盡快打出信號！",
    "voice": "vo_adv_5134006_026",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟要是在不妙的位置碎掉，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "連我都會遭殃的！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而初音",
    "voice": "vo_adv_5134006_027",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在看到光束擊中隕石後，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n請馬上使用魔法阻止碎片墜落。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……",
    "voice": "vo_adv_5134006_028",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音……",
    "voice": "vo_adv_5134006_029",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n她果然",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還是對漏看預知夢這件事耿耿於懷啊。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這種",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "認真過頭的個性，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真的和栞一模一樣。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼",
    "voice": "vo_adv_5134006_030",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "森神大人。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我們也得開始準備了。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n能請祢為我們實現願望嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯。",
    "voice": "vo_adv_5134006_031",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n記得是讓龍人族女孩巨大化，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "以及為妳強化「魔法」對吧。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是的。",
    "voice": "vo_adv_5134006_032",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n雖然不知道會不會成功……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是我會加油的。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂拒絕。",
    "voice": "vo_adv_5134006_033",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝……",
    "voice": "vo_adv_5134006_034",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦──！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n祢",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剛剛是說拒絕嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n怎麼會！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼！？",
