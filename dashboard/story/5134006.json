    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "應該就能使「魔法」的威力變得更大了。",
