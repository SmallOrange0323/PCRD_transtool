[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在眾人為即將到來的聖誕節雀躍不已時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一名少女愁眉苦臉地走在路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "人又多，天氣又冷，還有種格格不入的感覺……",
    "voice": "vo_adv_5106000_000",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "果然不該在聖誕節期間出門的。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好想窩在家裡玩遊戲啊……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "叮叮噹，叮叮噹～♪",
    "voice": "vo_adv_5106000_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "聖誕節好讓人雀躍呀！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里的朋友在那邊，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n要不要去打個招呼呀！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我的確",
    "voice": "vo_adv_5106000_002",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是沒有以前那麼怕生了……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n但也不是完全不怕生呀。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且我有點累了，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我就坐長椅上顧東西吧……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊很沒有體力呢……",
    "voice": "vo_adv_5106000_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里知道了～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那我自己去聊個天吧！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啦啦啦～♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "居然在雪地上小跳步……",
    "voice": "vo_adv_5106000_004",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里的體力好得跟鬼一樣……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "明明不用特地找我這種弱不禁風的人來逛街的……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……咦。",
    "voice": "vo_adv_5106000_005",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那間店陳列的遊戲是……！　",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呵呵♪",
    "voice": "vo_adv_5106000_006",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n聖誕節期間也是有好事的嘛。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我預購的遊戲",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎麼還不快點寄到呢。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "{0}一定也預購了吧……",
    "voice": "vo_adv_5106000_007",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許可以約他一起玩合作模式──",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……唔，",
    "voice": "vo_adv_5106000_008",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可是{0}",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "跟茜里一樣人緣好、朋友多……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我約他玩遊戲會不會造成他的困擾呢……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "唔～",
    "voice": "vo_adv_5106000_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里覺得不會吧～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！？",
    "voice": "vo_adv_5106000_010",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n妳回來了！？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里不能丟下姊姊一個人嘛。",
    "voice": "vo_adv_5106000_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "比起這個，",
    "voice": "vo_adv_5106000_012",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊居然會主動想要約人，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n嚇了茜里好大一跳呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "明天可能要下雪人了呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_5106000_013",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有那麼誇張嗎……？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不管怎樣，",
    "voice": "vo_adv_5106000_014",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "絕對不能放棄喔！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥一定會很高興的！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不然，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也可以幫忙傳話……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！",
    "voice": "vo_adv_5106000_015",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不行不行！",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我自己會去約他的！！",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯，",
    "voice": "vo_adv_5106000_016",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也覺得那麼做比較好♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這可是難得的聖誕節呀。",
    "voice": "vo_adv_5106000_017",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊也留下一個幸福的回憶吧！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "幸福的回憶……",
    "voice": "vo_adv_5106000_018",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "以往的聖誕節，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n好像都沒留下什麼美好的回憶呢。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里會收到很多邀請函，",
    "voice": "vo_adv_5106000_019",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而我當然是沒有。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "大家都笑容滿面地期待聖誕節的到來，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只有我一臉陰沉啊～",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以，",
    "voice": "vo_adv_5106000_020",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "和大家在一起",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "比自己一個人度過還要難堪……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聖誕節就是讓我那麼憂鬱的存在。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但",
    "voice": "vo_adv_5106000_021",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "自從遇見他以後，認識的人越來越多……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n現在甚至能收到邀請函了。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這毫無疑問，",
    "voice": "vo_adv_5106000_022",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n是因為{0}教會了我",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "連結人際關係的樂趣……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然我還沒有自信能夠變得坦率一些……",
    "voice": "vo_adv_5106000_023",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但就像{0}經常來見我一樣，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我也想",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一步一步地",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "向他靠近。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": "vo_adv_5106000_024",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳說得對。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是「那孩子」",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "給了我「邁出第一步的勇氣」，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不能白白浪費掉這份好意。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我",
    "voice": "vo_adv_5106000_025",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "會努力約{0}的！",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就是這股氣勢，",
    "voice": "vo_adv_5106000_026",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "「邁出第一步的勇氣」",
    "voice": "vo_adv_5106000_027",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呀～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要是知道成為天使的經歷",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "現在也對姊姊很有幫助的話，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n拉菲一定會非常高興的♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……不知道拉菲",
    "voice": "vo_adv_5106000_028",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "現在過得好嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她現在",
    "voice": "vo_adv_5106000_029",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許又在某個地方帶給別人幸福吧。",
    "voice": null,
    "unit_id": 102212
  },
  {
