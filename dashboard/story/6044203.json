[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "充滿熱帶風情的晴朗天氣是很不錯～",
    "voice": "vo_adv_6044203_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但穿著泳裝",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感覺會全身都曬黑呢……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我說你，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有做什麼防曬的",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對策嗎？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是的～",
    "voice": "vo_adv_6044203_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "既然會感到不安，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那就要好好防範啊！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……咦，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你問我有沒有做？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "反正",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就算曬黑，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也只會",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n提升七七香的魅力罷了，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以我覺得無所謂呢！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我懂！",
    "voice": "vo_adv_6044203_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然常有人說「陽光是肌膚的天敵」，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這點很讓人擔心，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n但在小麥色肌膚上留下泳裝曬痕的美少女，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是教人興奮呢，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喲呵呵呵！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_6044203_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在來這村子前就塗好了？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "已經沒效了啦！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n既然如此，就輪到新魔法上場了！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "防曬魔法～欸、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇啊這個是",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n日光浴的魔法！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "光、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "光好刺眼！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的眼睛！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的眼睛──！！",
    "voice": null,
    "unit_id": 113311
  }
]
