  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "お化け屋敷も始まって、",
    "voice": "vo_adv_6050207_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ようやくこの衣装にも慣れてきたかな。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ドレスに身を包んで人を驚かすなんて、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\nなかなかできることじゃないから、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "面白い経験だよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "少しだけ。",
    "voice": "vo_adv_6050207_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "いや、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あくまでお化け屋敷の中だけだよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n普段からいたずらするなんて……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "でも",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n貴族の連中を相手にいたずらしてみるのは、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "いいかもしれないね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "い、",
    "voice": "vo_adv_6050207_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "一応私なりに努力しているんだ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "キミには通じていない、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "のかな？　",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "えっと、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "じゃあ、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "その……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ダメだ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "キミ相手に演技なんて、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "上手くできそうにないよ。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "ツムギもそう言っていたね。",
    "voice": "vo_adv_6050207_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "最初は楽しめるわけないと思っていたけど、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "私にも",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "意外といたずらっこの才能があったのかな？",
    "voice": null,
    "unit_id": 114011
  }
]
