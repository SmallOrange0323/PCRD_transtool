    "words": "這麼誇張嗎？　",
    "voice": "vo_adv_9027156_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "需要沉浸在這麼感傷的氛圍嗎？",
    "voice": null,
