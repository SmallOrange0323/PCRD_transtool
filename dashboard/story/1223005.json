[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "班比透過伊莉亞邀請{0}參加午餐會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是{0}來到了伊莉亞的古城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "鹽巴♪",
    "voice": "vo_adv_1223005_000",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牛奶～♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n咕嘟咕嘟咕嘟～♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n變好喝吧～♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不曉得",
    "voice": "vo_adv_1223005_001",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從會不會喜歡",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比煮的湯呢～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚！",
    "voice": "vo_adv_1223005_002",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗呀～！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1223005_003",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從來了！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從～♪",
    "voice": "vo_adv_1223005_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比好想你～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快點快點！",
    "voice": "vo_adv_1223005_005",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比有抱抱你了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你也要抱抱班比才行！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽好囉？",
    "voice": "vo_adv_1223005_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n打招呼是很重要的哦！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚咿！",
    "voice": "vo_adv_1223005_007",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "\\n呀噗呀嗚呀～！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇哇！？",
    "voice": "vo_adv_1223005_008",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "湯快滿出來了！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呼……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好險……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": "vo_adv_1223005_009",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "料理馬上就好了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你去那裡和伊莉亞一起等著吧♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔唔……",
    "voice": "vo_adv_1223005_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n好累…………",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "班比她啊……",
    "voice": "vo_adv_1223005_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n她為了答謝在妾身城裡受到關照，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "開始做家事了……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但她老是把用不到的東西給翻出來，",
    "voice": "vo_adv_1223005_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把屋內弄得亂七八糟……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "後來甚至",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "盡是引出一些惡靈……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n結果",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "搞得妾身必須替她收拾善後。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "出現的惡靈都是",
    "voice": "vo_adv_1223005_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "像那種……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "生理上讓人無法接受的類型……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……多虧如此讓妾身吃了不少苦頭。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對了，",
    "voice": "vo_adv_1223005_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在班比來之前，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身有話想先告訴你。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身有問過班比",
    "voice": "vo_adv_1223005_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "關於她故鄉的事情，但是……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳仔～細看這張地圖，",
    "voice": "vo_adv_1223005_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳知道自己的故鄉在什麼地方嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔～嗯…………",
    "voice": "vo_adv_1223005_017",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": "vo_adv_1223005_018",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沉睡了很長一段時間，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n所以腦袋",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還轉不太過來呢……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比是在一座很大的城堡裡",
    "voice": "vo_adv_1223005_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和大家一起生活。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "明明非常喜歡大家……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是",
    "voice": "vo_adv_1223005_020",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "卻完全想不起來。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……這是為什麼呢？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不曉得班比究竟沉睡了多久，",
    "voice": "vo_adv_1223005_021",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但她的記憶似乎變得很模糊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n貝斯也一樣。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要讓班比回到故鄉，",
    "voice": "vo_adv_1223005_022",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n只能逮到綁架她的",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "罪魁禍首「伯爵」，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "並且逼問他了吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身已經派出蝙蝠們",
    "voice": "vo_adv_1223005_023",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "去找伯爵的所在之處。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你今天就先",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好好品嚐班比煮的料理吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從！",
    "voice": "vo_adv_1223005_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "讓你們久等了～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯！",
    "voice": "vo_adv_1223005_025",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n可以幫忙擺餐具嗎！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚！",
    "voice": "vo_adv_1223005_026",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "鏘──！",
    "voice": "vo_adv_1223005_027",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是班比特製的湯♪",
    "voice": "vo_adv_1223005_028",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n請慢用♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_1223005_029",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就不客氣了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從？",
    "voice": "vo_adv_1223005_030",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "如何？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好喝嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1223005_031",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你也要多吃點，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快快長大喔～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯的是水果！",
    "voice": "vo_adv_1223005_032",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好吃嗎～？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚～！",
    "voice": "vo_adv_1223005_033",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比煮的湯，",
    "voice": "vo_adv_1223005_034",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞喜歡嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": "vo_adv_1223005_035",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然妳打掃是慘不忍睹，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但料理似乎還可以。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔～",
    "voice": "vo_adv_1223005_036",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只是煮湯的話，班比也是會的～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "當然一開始是先跟別人學──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "…………",
    "voice": "vo_adv_1223005_037",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了？",
    "voice": "vo_adv_1223005_038",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……班比是跟誰，",
    "voice": "vo_adv_1223005_039",
