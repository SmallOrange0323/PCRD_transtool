    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那麼，",
    "voice": "vo_adv_5203411_009",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "超越快閃旅行的音速旅行──",
    "voice": null,
    "unit_id": 134511
  },
