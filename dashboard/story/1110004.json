  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "最近{0}\\n似乎時常被優妮叫到「象牙之塔」這來的樣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗨，",
    "voice": "vo_adv_1110004_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "同志。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n感謝你又遠道而來，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "鞠躬。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "今天找你來不為別的。",
    "voice": "vo_adv_1110004_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是我們的研究論文，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "終於面臨重要的轉機了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒錯。",
    "voice": "vo_adv_1110004_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "針對這個地區流傳的民間故事與傳說，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "解讀了許多的文獻，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "還進行了",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "考察與驗證的我們——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然而我們的研究，",
    "voice": "vo_adv_1110004_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n已經不能再只局限於在「這個地區」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "附近進行考古學，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "立足於更為宏觀的觀點之必要性已浮上了檯面。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想分類會橫跨歷史學、",
    "voice": "vo_adv_1110004_004",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "人類學，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "乃至於哲學，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只是或許古板的保守派，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會將其稱之為宗教學吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那～",
    "voice": "vo_adv_1110004_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "新的主題",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是這個咚～！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「盤據在這世界上的根源性虛構｣！",
    "voice": "vo_adv_1110004_006",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦？　",
    "voice": "vo_adv_1110004_007",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你在說什麼啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這個主題是今日，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在我國首次公開的——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！　",
    "voice": "vo_adv_1110004_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "通知優妮博士！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n確認到來源不明的發光現象！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": "vo_adv_1110004_009",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這道光是怎麼回事，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好神祕。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": "vo_adv_1110004_010",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這究竟是什麼……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊！　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啪，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呀啊～～！　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呼、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呼哇、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呼哇哇，好有意思！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "background",
    "bg_id": "510050"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1110004_011",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那本書——",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇哇，",
    "voice": "vo_adv_1110004_012",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對不起突然打擾你！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也讀過那本書，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以一不自覺就……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那、",
    "voice": "vo_adv_1110004_013",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "順便問一下……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你是喜歡",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "寫那本書的教授之類的嗎……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦？",
    "voice": "vo_adv_1110004_014",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是學校的課題？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "逼不得已才看的……？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊……，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我想也是呢，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真不好意思！",
    "voice": "vo_adv_1110004_015",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你繼續看你繼續看。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那失陪了。",
    "voice": "vo_adv_1110004_016",
    "unit_id": 111031
  },
  {
    "type": "still",
    "still_id": "111000401"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊……",
    "voice": "vo_adv_1110004_017",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……",
    "voice": "vo_adv_1110004_018",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯嗯嗯……",
    "voice": "vo_adv_1110004_019",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼哇，",
    "voice": "vo_adv_1110004_020",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對不起！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n沒有啦，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只是因為你一直沒繼續翻頁，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n所以我有點在意……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那本書，",
    "voice": "vo_adv_1110004_021",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我在想該說是對於還不習慣內容的人來說太難了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n還是該說有點難以駕馭～之類的……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1110004_022",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果然是這樣？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我想也是啦？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1110004_023",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可是！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n可是啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "再等一下吧？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這有點訣竅的，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真的。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "首先是一開始的章節，",
    "voice": "vo_adv_1110004_024",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡突然就開始講最難的內容。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但這裡",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "其實沒講什麼重要的事，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以跳過也不要緊。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n畢竟這內容有種老頭子你在說什麼鬼的感覺。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不是，",
    "voice": "vo_adv_1110004_025",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他是個好人喔？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n雖然和孫女玩耍時是個開朗的老爺爺，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是做為學者時最致命的就是會自顧自地講得天花亂墜……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "still",
    "still_id": "111000402"
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": "vo_adv_1110004_026",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我叫",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真行寺由仁……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "是的，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我就是寫了那本書的真行寺老師的孫女，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "這樣啊，你叫做{0}。",
    "voice": "vo_adv_1110004_027",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "謝謝你這麼有禮貌。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n年紀……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我比較年長呢。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "然後……",
    "voice": "vo_adv_1110004_028",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我可以繼續說嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "對，",
    "voice": "vo_adv_1110004_029",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "所以說啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "請跳過第一章，直接看第二章。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n第三和四章的話……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "就算只大概瀏覽一下應該也沒問題，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "然後，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "再來是……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": "vo_adv_1110004_030",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "是上課用的話，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "要寫報告吧？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我幫你在不能漏看的重點上貼上便利貼吧。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n我可以坐這裡嗎？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我移一下你的包包哦？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510050"
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "…………",
    "voice": "vo_adv_1110004_031",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "……嗯，我想，",
    "voice": "vo_adv_1110004_032",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "大概這樣就差不多了吧。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊……",
    "voice": "vo_adv_1110004_033",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真抱歉呢？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "結果幫你",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "貼了滿滿的便利貼。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我突然就這樣冒出來，然後自顧自地講了一大堆呢。",
    "voice": "vo_adv_1110004_034",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，好害羞啊……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我的臉都熱起來了……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "因為我的本性",
    "voice": "vo_adv_1110004_035",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "基本上是家裡蹲，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "所以根本也都沒有朋友，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n偶爾有機會和人說話時，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "就會開啟奇怪的開關。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "如果說的是我喜歡的領域那就會更……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "今天午休時，星野同學她",
    "voice": "vo_adv_1110004_036",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "——啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "她是班上一位非常漂亮的女孩子，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "——她又向我搭話了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "但結果",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我卻一直在聊自己\\n喜歡的書……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我記得",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "本來應該",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "在聊她弟弟的事……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "對，",
    "voice": "vo_adv_1110004_037",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "所以對{0}也一樣，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "抱歉啊？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n因為我第一次遇到在現實中",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "讀我爺爺寫的書的人，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "與其說是感激，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "總之一不小心就心花怒放了……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "唉唷真是的，真的很抱歉哦？",
    "voice": "vo_adv_1110004_038",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n嚇到你了吧？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我這人很莫名其妙對吧？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": "vo_adv_1110004_039",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "太好了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "那其他的書我也順便——",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "——不對，等一下啊我。",
    "voice": "vo_adv_1110004_040",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n把這種客套話全部都當真的話可不太好呀我。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "唉……",
    "voice": "vo_adv_1110004_041",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我真沒用啊……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n這社會真是難啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "不管是表面的或是私底下的。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "沒有啦……",
    "voice": "vo_adv_1110004_042",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "只是我",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "昨天在玩線上遊戲的時候也搞砸了。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n雖然遊戲裡的好友",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "都要我不用太在意……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "唉～",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "總覺得很對不起他們，想上線也覺得很尷尬呢……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "咦？　",
    "voice": "vo_adv_1110004_043",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "玩家ID？　",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你是問",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我的嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯……",
    "voice": "vo_adv_1110004_044",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "告訴你",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "是也沒關係啦……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "咦？",
    "voice": "vo_adv_1110004_045",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你的意思該不會是……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你是想要加我好友嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊……",
    "voice": "vo_adv_1110004_046",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "……嘿嘿嘿。",
    "voice": "vo_adv_1110004_047",
    "unit_id": 111031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1110004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看到的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1110004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n話雖如此，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正你醒來就會忘記了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以現在不用太在意唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不用多久，",
    "voice": "vo_adv_1110004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和優妮",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就會在「象牙之塔」中原本的地方醒過來了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "優妮是學者型的人，",
    "voice": "vo_adv_1110004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以或許不會像其他人一樣說句「什麼嘛是夢啊！」就算了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說不定會因為太難以理解，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而讓她的求知心蠢蠢欲動呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過很可惜的是，",
    "voice": "vo_adv_1110004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這場「夢」不會留在記憶裡。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也無法留下記錄，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也不能進行考察與驗證。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是世界的虛構……",
    "voice": "vo_adv_1110004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n優妮說的那個研究主題。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然不想掃她的興，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但那件事終究也是徒勞無功。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她和",
    "voice": "vo_adv_1110004_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "其他各個賢者都一樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是沒辦法對這個世界持續抱有疑問下去的呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你問為什麼？",
    "voice": "vo_adv_1110004_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那是因為現在這個世界就是這樣構築的呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這世界上可是有著不論多麼聰明，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也依舊無法掌握的真理在呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可是……",
    "voice": "vo_adv_1110004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "優妮，",
    "voice": "vo_adv_1110004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她先前有這麼說過吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說過程比結果更加重要。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說「去知道」的這件事本身才是目的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "若是如此，",
    "voice": "vo_adv_1110004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼對她來說這就是段有意義的時光了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以我",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這麼輕率地就說人家是徒勞無功，似乎也不太好呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500960"
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呼啊～",
    "voice": "vo_adv_1110004_059",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊呼……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "早安啊世界，",
    "voice": "vo_adv_1110004_060",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你今天依舊是個大騙子呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗨，",
    "voice": "vo_adv_1110004_061",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學弟也是。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你好像醒了呢，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "做了個美夢了嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110004_062",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你說你不記得了？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想也是。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為我也是喔。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "似乎像是碰觸到了那宏遠之真實的一隅的感覺……",
    "voice": "vo_adv_1110004_063",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "又像是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "窺視到了壯大的幕間中的一條細縫的感覺……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110004_064",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "想作筆記也無從作起……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n徒留這難以訴諸言語的見聞之餘韻，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "著實令人感到奇妙。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然而，",
    "voice": "vo_adv_1110004_065",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "幸好還記得「我不記得」這件事。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這種不尋常的體驗，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在得要提出假說時或多或少能稍微提高說服力。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "現在我的可是非常亢奮呢，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呀呵～",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那麼同志呀，",
    "voice": "vo_adv_1110004_066",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們就重新再來一遍，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "繼續剛才被中斷的話題吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n新的題目是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「盤據在這世界上的——」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "奇怪？　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是什麼來著？　",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我怎麼又忘了……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想想，",
    "voice": "vo_adv_1110004_067",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "該怎麼辦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "總之看一下筆記……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110004_068",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「盤據在這世界上的根源性虛構」，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是這個。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對，",
    "voice": "vo_adv_1110004_069",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是這個啦，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就是這個讓人很不舒服的忘卻現象。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個世界，",
    "voice": "vo_adv_1110004_070",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "經常以妨礙認知的形式對我們進行著影響。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而此刻，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也正代表這個世界對我們撒了一個相當大的謊言——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "——而這件事，",
    "voice": "vo_adv_1110004_071",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "便是我所提出來的大膽又嶄新的假設。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "怎麼樣呢同志？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你能不能來幫助我撰寫論文呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想也是。",
    "voice": "vo_adv_1110004_072",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真相未必保證會帶來幸福。",
    "voice": "vo_adv_1110004_073",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "維持著未知的現況也是其中的一種選擇吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不是，",
    "voice": "vo_adv_1110004_074",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就算你對研究沒興趣也不要緊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "打從一開始，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我希望能從你身上得到的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就並非是實際的幫助。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只是",
    "voice": "vo_adv_1110004_075",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "希望你偶爾",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "能像這樣陪我閒聊就行了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "現在想想，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我下了「山」來到「街上」，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n是因為我對聽聞中的學園生活那種事很感興趣。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊，",
    "voice": "vo_adv_1110004_076",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也就是說啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_1110004_077",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是我也想要交朋友。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當然我不勉強你，",
    "voice": "vo_adv_1110004_078",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你怎麼想呢？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": "vo_adv_1110004_079",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來如此，",
    "voice": "vo_adv_1110004_080",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是這樣子啊……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這就是友情……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "似乎不是很特別的東西呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？　",
    "voice": "vo_adv_1110004_081",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那就是說？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我已經開始青春了……？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……什麼嘛，",
    "voice": "vo_adv_1110004_082",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以這一陣子的我，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
