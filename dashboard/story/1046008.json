[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}來到珠希打工的鯛魚燒店的攤販。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喲！",
    "voice": "vo_adv_1046008_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你怎麼會來這裡喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "難道是來吃鯛魚燒嗎喵？",
    "voice": "vo_adv_1046008_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣的話，我會給你很多折扣喵！",
    "voice": "vo_adv_1046008_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以，買點什麼吧――",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，這是什麼喵！？",
    "voice": "vo_adv_1046008_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "鯛、鯛魚燒發出光芒――喵啊啊啊啊啊啊！？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "still",
    "still_id": "104600801"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "瞧，是飼料喵。",
    "voice": "vo_adv_1046008_004",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有很多，所以盡情的吃吧喵……哈……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊……",
    "voice": "vo_adv_1046008_005",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n歡迎光臨喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要買鯛魚燒嗎喵？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……不愧是你喵。",
    "voice": "vo_adv_1046008_006",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n立刻就發現我正在煩惱……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "其實，那個……",
    "voice": "vo_adv_1046008_007",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你看到我，",
    "voice": "vo_adv_1046008_008",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有注意到什麼嗎喵？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "其實我……最近，那個、胖了喵。",
    "voice": "vo_adv_1046008_009",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以正在減肥……當像這樣餵牠們飼料時，",
    "voice": "vo_adv_1046008_010",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我也肚子餓了喵……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就連員工餐的鯛魚燒也只能忍痛割捨給貓咪們了喵……",
    "voice": "vo_adv_1046008_011",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是……我已經餓扁了，",
    "voice": "vo_adv_1046008_012",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n忍耐到了極限喵……！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唔……！",
    "voice": "vo_adv_1046008_013",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我相信你，所以有件事要拜託你喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "請你、請你幫我減肥喵！",
    "voice": "vo_adv_1046008_014",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "靠我一個人的意志力做不到……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真的嗎喵！？",
    "voice": "vo_adv_1046008_015",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n謝、謝謝喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "事不宜遲，明天開始減肥喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼呼，呼呼！",
    "voice": "vo_adv_1046008_016",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哈，",
    "voice": "vo_adv_1046008_017",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哈，到底要讓我跑幾公里馬拉松喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n雖然它是有氧運動喵啊……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哈，哈……終、終於看到終點了喵……",
    "voice": "vo_adv_1046008_018",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n到那裡就能休息了……！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最後衝刺，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "加油喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵啊啊啊啊啊啊啊啊……！",
    "voice": "vo_adv_1046008_019",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "終、終點……！",
    "voice": "vo_adv_1046008_020",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抵達終點了喵……！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼啊啊，",
    "voice": "vo_adv_1046008_021",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "累死我了喵啊啊啊啊啊啊……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哈，哈……",
    "voice": "vo_adv_1046008_022",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你怎麼了喵。",
    "voice": "vo_adv_1046008_023",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n怎麼移開視線了喵。",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，難道……",
    "voice": "vo_adv_1046008_024",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你現在是因為看見我流汗而衣服緊貼著的身體，",
    "voice": "vo_adv_1046008_025",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有點心跳加速了嗎喵？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵呵呵，",
    "voice": "vo_adv_1046008_026",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我對你的視線很敏感喵。",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "男孩子都是這樣的喵……",
    "voice": "vo_adv_1046008_027",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n難道你也想看衣服裡面嗎喵……？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果是你……我，",
    "voice": "vo_adv_1046008_028",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n讓你看也沒關係喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "………………",
    "voice": "vo_adv_1046008_029",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "騙──你的喵！",
    "voice": "vo_adv_1046008_030",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n開玩笑的喵──！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你有期待嗎喵？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵呵呵。但是，有你看著我的話，",
    "voice": "vo_adv_1046008_031",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就能防止我偷懶喵！ ",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今後也請多多指教喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1046008_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很難得，你會因為看見女孩子的身體而感到慌張呢～。",
    "voice": "vo_adv_1046008_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "即使如此，珠希她到底是積極，",
    "voice": "vo_adv_1046008_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還是在戲弄你，真是令人摸不透的孩子呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這說明她很任性啊。",
    "voice": "vo_adv_1046008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和那種孩子交往的話，可能會很辛苦吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不過，也許不會感到無聊……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了。",
    "voice": "vo_adv_1046008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n實際上煩惱的人是你。那麼再見囉～。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗚喵……？",
    "voice": "vo_adv_1046008_037",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唔……我好像不知不覺間睡著了喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是不可思議的夢喵……",
    "voice": "vo_adv_1046008_038",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是，就算在夢裡，我還是在鯛魚燒店打工喵！",
    "voice": "vo_adv_1046008_039",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……咦？",
    "voice": "vo_adv_1046008_040",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你的夢裡，我也是在鯛魚燒店打工嗎？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……原來如此喵。",
    "voice": "vo_adv_1046008_041",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你好像跟我做了相同的夢喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還有這樣不可思議的事呢喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵呵，想起夢中的內容，",
    "voice": "vo_adv_1046008_042",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就變得很開心喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不管怎麼說，即使在夢裡，",
    "voice": "vo_adv_1046008_043",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你還是臣服於我的魅力之下喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈哈，作為夢裡的延續……，",
    "voice": "vo_adv_1046008_044",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就讓你看這裡面吧喵……？",
    "voice": null,
    "unit_id": 104611
  },
  {
