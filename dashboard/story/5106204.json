[
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這裡",
    "voice": "vo_adv_5106204_000",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是不是很陰暗啊……？",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n難以想像這是聖誕節的街道……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "──咦？",
    "voice": "vo_adv_5106204_001",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你問我是不是很害怕？",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "胡說什麼！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我才沒有。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "拉菲、艾米",
    "words": "獻上天使的祝福！\\n（變坦率吧～）",
    "voice": "vo_adv_5106204_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": "vo_adv_5106204_003",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "其實我很怕，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你一定要陪著我……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "牽我的手，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "喂，艾米、",
    "voice": "vo_adv_5106204_004",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不可以過度使用變坦率的魔法喔～",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太寵姊姊對姊姊不是好事，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對吧，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "純小姐？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呃。",
    "voice": "vo_adv_5106204_005",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如、",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你的另一隻手空了，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你也……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "牽我的手……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我並不是害怕。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……！！",
    "voice": "vo_adv_5106204_006",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "純小姐，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳又不小心被魔法波及了……！",
    "voice": null,
    "unit_id": 124011
  }
]
