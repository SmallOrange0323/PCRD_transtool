    "name": "傑克",
    "words": "\\n而我則會為秋天帶來豐收，以此作為回禮。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "而且，",
    "voice": "vo_adv_5007003_036",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "只有在萬聖節這天，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我可以混在人群中，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n一起玩不給糖就搗蛋",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "的遊戲……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "可是不知從何時起，",
    "voice": "vo_adv_5007003_037",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "人類已忘了我的存在，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n只顧自己開心舉辦自己的派對！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "遺忘了真正的萬聖節！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "失去貢品後，",
    "voice": "vo_adv_5007003_038",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我也失去了力量……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n最後……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "變成孤零零的一個人。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "所以今年，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我要對那些遺忘我的人類復仇！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "若不在當天、",
    "voice": "vo_adv_5007003_039",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "靈界之門關閉之前",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n找到附身的對象，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我將無法使出全力。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n得再等上一年。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "一定要避免那種結果！",
    "voice": "vo_adv_5007003_040",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n附身在靈力強大的傢伙身上，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "等到萬聖節結束，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我的靈魂就會和宿主的身體",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "完全合而為一！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "最後再把蒐集到的糖果",
    "voice": "vo_adv_5007003_041",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "當成貢品吃掉……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我的力量就能夠完全復活！　",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "在現世大鬧一番！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n給這些愚蠢的人類",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "一些顏色瞧瞧！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "被人類所遺忘……",
    "voice": "vo_adv_5007003_042",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "原來傑克有這樣的過去呢。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那傢伙，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說不定也是個可憐的傢伙。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家也有點",
    "voice": "vo_adv_5007003_043",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "了解傑克的心情……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在人家遇見忍和你之前，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也沒有朋友……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是，",
    "voice": "vo_adv_5007003_044",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算這樣，也不能奪取忍的身體啊！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子沒有做那種事，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "也和大家成為了朋友！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一個人吃布丁，",
    "voice": "vo_adv_5007003_045",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在蘭德索爾閒逛雖然很開心，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但認識大家以後，比原本還要開心好幾倍！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以，",
    "voice": "vo_adv_5007003_046",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家一定要阻止傑克！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n按照這本日記的內容，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "若不在萬聖節結束前\\n處置傑克的話，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍就永遠回不來了！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍會變傑克，傑克會變成忍來的～！",
    "voice": "vo_adv_5007003_047",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那怎麼可以！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子的忍會消失不見來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個身體的主人",
    "voice": "vo_adv_5007003_048",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真的那麼重要嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍！？",
    "voice": "vo_adv_5007003_049",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……不對，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是傑克來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我接到我手下魔物的報告，",
    "voice": "vo_adv_5007003_050",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說城堡裡有侵入者。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n回來一看，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "果然是妳們～",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是厚臉皮。",
    "voice": "vo_adv_5007003_051",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不但闖進城堡，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還偷看了我的日記！",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你這種擅自進入別人身體，",
    "voice": "vo_adv_5007003_052",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n搶走小孩的糖果，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n拿走宮子布丁的傢伙",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "沒有資格說人家！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一定要搶回來！",
    "voice": "vo_adv_5007003_053",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n不論是布丁，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還是忍！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_5007003_054",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "搶得到的話……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳就來搶吧～！",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "傑克，",
    "voice": "vo_adv_5007003_055",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你這樣是不對的！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳再等一下！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家一定會救回妳的身體的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了要救忍，{0}和宮子\\n向傑克下了戰帖。",
    "voice": null,
    "unit_id": null
  }
]
