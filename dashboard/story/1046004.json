  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，\\n{0}正和珠希一起餵貓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "瞧～，我今天也帶飼料來了喵。",
    "voice": "vo_adv_1046004_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "大家要好好吃喔喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……？",
    "voice": "vo_adv_1046004_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，飼料已經沒了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那開新的罐頭吧――",
    "voice": "vo_adv_1046004_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵！？",
    "voice": "vo_adv_1046004_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n什麼喵，從罐頭裡發出光……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵啊啊啊啊啊啊！？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要不要來份～，鯛魚燒～？",
    "voice": "vo_adv_1046004_004",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "特別特別美味的鯛魚燒喵～。",
    "voice": "vo_adv_1046004_005",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "過來看看喔，喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喲！",
    "voice": "vo_adv_1046004_006",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你來得正好喵。喂，過來一下喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "其實喵……我有事想拜託你喵。",
    "voice": "vo_adv_1046004_007",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我想讓你試試看我新研發的樣品鯛魚燒，",
    "voice": "vo_adv_1046004_008",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n請當我的實驗品喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一個100日圓，特別優惠你一個70日圓就好喵。",
    "voice": "vo_adv_1046004_009",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以拜託你喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、那是…",
    "voice": "vo_adv_1046004_010",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "…",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呃……的確，我明白你的心情喵。",
    "voice": "vo_adv_1046004_011",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我、我想應該不會死的喵。",
    "voice": "vo_adv_1046004_012",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以你就乖乖地配合實驗吧―",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那、那個……",
    "voice": "vo_adv_1046004_013",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哦，可愛的兄妹，歡迎光臨喵。",
    "voice": "vo_adv_1046004_014",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "鯛魚燒一個100日圓喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那個……嗯……我們的零用錢很少……",
    "voice": "vo_adv_1046004_015",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "可以用這些錢賣一半的鯛魚燒給我們嗎……？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是……50日圓……？",
    "voice": "vo_adv_1046004_016",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只有50日圓啊喵……",
    "voice": "vo_adv_1046004_017",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n嗯―，那麼……但是，喵……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯，",
    "voice": "vo_adv_1046004_018",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我想到了喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果你們幫忙做鯛魚燒的話，",
    "voice": "vo_adv_1046004_019",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我就送你們鯛魚燒當作打工費吧喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "大姐姐……真的嗎？",
    "voice": "vo_adv_1046004_020",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當然喵，我不會說謊喵！",
    "voice": "vo_adv_1046004_021",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還有……",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "悉悉簌簌……",
    "voice": "vo_adv_1046004_022",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯……",
    "voice": "vo_adv_1046004_023",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯，我知道了！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "交涉成立喵！",
    "voice": "vo_adv_1046004_024",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，馬上開始做鯛魚燒吧喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這裡的訣竅是要再這樣好好地烤……",
    "voice": "vo_adv_1046004_025",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在這個地方一口氣這樣做喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯……這樣嗎……？",
    "voice": "vo_adv_1046004_026",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對喵！",
    "voice": "vo_adv_1046004_027",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "很厲害喵！ ",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳是做鯛魚燒的天才喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嘻嘻嘻……大姐姐，謝謝。",
    "voice": "vo_adv_1046004_028",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，這樣就完成了喵！",
    "voice": "vo_adv_1046004_029",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你們兩人都知道怎麼做了嗎喵？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯，",
    "voice": "vo_adv_1046004_030",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "當然！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "很好很好，那麼走吧喵！",
    "voice": "vo_adv_1046004_031",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "大哥哥！",
    "voice": "vo_adv_1046004_032",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "請買我們做的鯛魚─燒！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這裡面，混有我的試驗品\\n",
    "voice": "vo_adv_1046004_033",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "和孩子們努力做的鯛魚燒喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "以特別促銷價格販售喔喵。",
    "voice": "vo_adv_1046004_034",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為是孩子們做的鯛魚燒，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n必須在他們面前吃喵～？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵呵呵……你就乖乖的當我的實驗品吧喵！",
    "voice": "vo_adv_1046004_035",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "全部都吃完了喵。",
    "voice": "vo_adv_1046004_036",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n跟我計畫的一樣喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，這些鯛魚燒是你們今天的打工費喵。",
    "voice": "vo_adv_1046004_037",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你們兩人選喜歡的吃吧喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗚哇啊啊啊啊啊啊……！",
    "voice": "vo_adv_1046004_038",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "好多鯛魚燒……！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐，謝謝妳！",
    "voice": "vo_adv_1046004_039",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不要吃太多免得吃壞肚子喔喵。",
    "voice": "vo_adv_1046004_040",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯！",
    "voice": "vo_adv_1046004_041",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n真的很謝謝妳！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐，再見喔！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是純樸的孩子們喵。",
    "voice": "vo_adv_1046004_042",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓他們打工真是值得喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，",
    "voice": "vo_adv_1046004_043",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你的身體狀況還好嗎？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有30倍超辣的鯛魚燒，麻辣鯛魚燒，",
    "voice": "vo_adv_1046004_044",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n還有很多充滿熱情的實驗品的喵？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯─，",
    "voice": "vo_adv_1046004_045",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "實驗似乎以失敗收尾喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，開發新商品，犧牲是不可避免的喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是，謝謝你今天陪我喵♪",
    "voice": "vo_adv_1046004_046",
    "unit_id": 104632
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了。",
    "voice": "vo_adv_1046004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1046004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想你醒來以後很快就會忘記的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，我想那些鯛魚燒應該有10個以上，",
    "voice": "vo_adv_1046004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還真虧你能吃完呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖說是為了孩子們，你還真是拼命啊。",
    "voice": "vo_adv_1046004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我要稱讚你。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也虧珠希能馬上想到這樣的策略。",
    "voice": "vo_adv_1046004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以說在生意上……應該說她",
    "voice": "vo_adv_1046004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說話技巧很好呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也是，要小心不要在不知不覺間",
    "voice": "vo_adv_1046004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n接下糟糕的事喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，今天就到這裡。如果你收集到更多的『記憶碎片』，",
    "voice": "vo_adv_1046004_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就會再讓你做『夢』的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1046004_055",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唔……",
    "voice": "vo_adv_1046004_056",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我好像做了奇怪的夢喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我和你在餵貓，",
    "voice": "vo_adv_1046004_057",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "然後被奇怪的光包圍，那是什麼呢喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過……不錯，",
    "voice": "vo_adv_1046004_058",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我知道了原來還有這種方法……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n可以讓你吃下鯛魚燒的新商品喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……咦？",
    "voice": "vo_adv_1046004_059",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你說不要利用孩子們？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為什麼你會知道我夢中的內容喵！",
    "voice": "vo_adv_1046004_060",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……喵來如此。",
    "voice": "vo_adv_1046004_061",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你也做了一樣的夢啊。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是沒關係喵！",
    "voice": "vo_adv_1046004_062",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "下次我會讓你吃",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n很多鯛魚燒喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵呵呵……你期待嗎喵！",
    "voice": "vo_adv_1046004_063",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "珠希一邊說著一邊開心地笑了。",
    "voice": null,
    "unit_id": null
  }
]
