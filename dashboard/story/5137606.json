[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ノウェムは、次の戦いに向けて作戦を立てたいと、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nオクトーに呼び出されていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おーい、",
    "voice": "vo_adv_5111606_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトー！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いないのか～！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n次の作戦を立てようって呼び出したのはそっちだろ～？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "やぁ、",
    "voice": "vo_adv_5111606_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "ノウェム。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "\\n待たせてすまなかったね、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "怒ってないかい？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "キミの美しい眉間に、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "しわが寄ってなければいいのだけれど。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いや、",
    "voice": "vo_adv_5111606_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そこまで待たされたわけじゃ……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "は？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nちょっと待て、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "何言ってんだオマエ！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "キミが美しいと言ったのさ。",
    "voice": "vo_adv_5111606_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "この世に存在するどんな宝石でも、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "\\nキミの瞳の美しさにはかなわないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……分かった、",
    "voice": "vo_adv_5111606_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "さてはネネカだろ！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーは絶対にそんなこと言わないからな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "思ったより簡単にバレてしまいましたね。",
    "voice": "vo_adv_5111606_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "彼に化けて歯の浮くようなセリフを吐けば、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "面白い貴方が見られるかもと",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "期待したのですが。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "……",
    "voice": "vo_adv_5111606_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ちょっと遅刻したボクも悪いんだけどさ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n本人がいないところで",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "悪質過ぎるでしょー、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そのいやがらせ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nボクがセクハラオヤジみたいな扱いになったら、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "どうしてくれるわけ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "今度は本物のオクトーだ、",
    "voice": "vo_adv_5111606_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "間違いない！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n面倒なことに巻き込むなっていう雰囲気が、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちゃんとにじみ出てるぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "それはそれで傷つく評価だけどなー",
    "voice": "vo_adv_5111606_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "事実だから否定もできないんだけど。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "ふむ……",
    "voice": "vo_adv_5111606_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "貴方たちはお互い、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "深く信頼しあっているのですね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "では、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "今度は少し難易度をあげてみましょうか。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\nもう一度、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "彼に化けてみます……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "分身のおまけつきで。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "……うわっ！？",
    "voice": "vo_adv_5111606_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "\\nなんだよこれ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？",
    "words": "ボクだらけじゃないか！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？",
    "words": "さすがに勘弁してよねー……",
    "voice": "vo_adv_5111606_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？",
    "words": "\\n自分と同じ顔が見渡す限り広がってるって、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？",
    "words": "完全にホラーだしさ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オ、",
    "voice": "vo_adv_5111606_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーが一人、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーが二人、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーがたくさん！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n見た目は完全に同じだし、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "すごい変身能力だ……！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "見た目はさておき、",
    "voice": "vo_adv_5111606_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "ボクって周りからこんなに気の抜けた",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "\\nしゃべり方をしてると思われてるわけ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "もう少し、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "ハキハキ……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "してなかったかなー、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー？？？",
    "words": "別に。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "しかも、",
    "voice": "vo_adv_5111606_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "今度はちゃんと性格まで真似してるみたいだ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nでも、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシの目は",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そんなことじゃごまかせないぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "本物のオクトーは……",
    "voice": "vo_adv_5111606_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "こいつだ～！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "うん、",
    "voice": "vo_adv_5111606_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "正解～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "よく分かったねー",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "……驚きました。",
    "voice": "vo_adv_5111606_017",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n今度は騙せる自信があったのですが、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "どうやって本物が彼だと見抜いたのです？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "もちろん、",
    "voice": "vo_adv_5111606_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "勘だ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n一番オクトーっぽいと感じたオクトーを選んだだけだぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "相変わらず雑だねー、",
    "voice": "vo_adv_5111606_019",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "キミ……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "本当にボクに化ける敵が出てきたときは、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nもうちょっと慎重に選んでよ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "任せとけ！",
    "voice": "vo_adv_5111606_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nオクトーのことが一番よく分かってるのは、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシなんだからな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nどんな偽物が出てきても、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "絶対に見抜いてやるぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "なるほど、",
    "voice": "vo_adv_5111606_021",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "参考になりました。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n深い絆を結んだ人間が相手だと、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n私の変身能力も見破られるリスクが高いようですね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクにはさっぱり分からない理屈だけどねー",
    "voice": "vo_adv_5111606_022",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そんな曖昧なもので",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "本物か偽物か区別するなんて、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "できる気がしないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "そうでしょうか？",
    "voice": "vo_adv_5111606_023",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "私がノウェムに化けたとしても、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "貴方が相手では",
    "voice": null,
    "unit_id": 107011
  },
  {
