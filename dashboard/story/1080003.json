  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "早安，",
    "voice": "vo_adv_1080003_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我正等著你喔。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個行李你拿！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我們立刻出發吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你問要上哪去？",
    "voice": "vo_adv_1080003_001",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這句問得好啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "現在我們要去挖掘溫泉！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊。",
    "voice": "vo_adv_1080003_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看你臉色，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是想著不可能吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒問題的，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我有到礦坑打工的經驗。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "挖坑是我的拿手好戲。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我靈光一閃！",
    "voice": "vo_adv_1080003_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "打造最棒度假村的最後關鍵……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n那就是，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "溫泉了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在美麗的大海盡情徜徉後，",
    "voice": "vo_adv_1080003_004",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "用溫泉暖和身心，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n再配上極品美食與美體療癒……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你不覺得這就是完美的旅程嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總之，",
    "voice": "vo_adv_1080003_005",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "開發溫泉已經是最優先事項囉。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果明白的話，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就盡快出發！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我看過地質調查的資料，",
    "voice": "vo_adv_1080003_006",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這附近還挺適合的。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n來！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "開始囉～！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼……",
    "voice": "vo_adv_1080003_007",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我以為開挖就會挖到，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n結果完全感覺不像有溫泉的樣子。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "暫時休息一會吧。",
    "voice": "vo_adv_1080003_008",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果不休息，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可會撐不住的。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不。",
    "voice": "vo_adv_1080003_009",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "溫泉在打造最棒的度假村過程中是絕對不可或缺的喔。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我沒打算放棄啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒有這回事。",
    "voice": "vo_adv_1080003_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要打造最棒的度假村，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是最短",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "且最有效率的路線喔。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我想{0}也是好好考慮過，",
    "voice": "vo_adv_1080003_011",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n才說過很多話來勸我的……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但這件事情，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也不打算放棄。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀……",
    "voice": "vo_adv_1080003_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "什、什麼！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等等，",
    "voice": "vo_adv_1080003_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "突然拉著我",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是要帶我去哪裡！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "去大商會會長那裡？",
    "voice": "vo_adv_1080003_014",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為什麼要去那種地方……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我可先說清楚，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不管找誰來勸什麼都沒用的喔？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "喔？",
    "voice": "vo_adv_1080003_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這不是帝王章魚那時候的小子跟小姐嘛。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n是怎麼了？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這，",
    "voice": "vo_adv_1080003_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "喂喂。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "什麼呀小子，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "一上門來就低著頭。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等、等等！",
    "voice": "vo_adv_1080003_017",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n怎麼{0}要做這種事啊！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "什麼？",
    "voice": "vo_adv_1080003_018",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "想要我們一起挖掘溫泉？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n為了小姐想打造最棒的度假村？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1080003_019",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最棒的度假村……",
    "voice": "vo_adv_1080003_020",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n{0}也是認真地考慮的。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就算向敵對的一方低頭，",
    "voice": "vo_adv_1080003_021",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也要請他們來挖溫泉……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那就算是我，",
    "voice": "vo_adv_1080003_022",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也得對{0}的心意有所回應才對！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "會長，",
    "voice": "vo_adv_1080003_023",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也拜託你了！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我想打造出屬於這片海景的驕傲，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n想打造最棒的度假村。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請你也來幫助我！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "連小姐也……",
    "voice": "vo_adv_1080003_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "饒了我好嗎，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "真是的。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "……最棒的度假村呢。",
    "voice": "vo_adv_1080003_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這個口氣真大呀。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "不過……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "話倒說得很好。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "令人心動，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "很響亮的理念。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "我很中意啊，小姐。",
    "voice": "vo_adv_1080003_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "憑這句話，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "我就信你們這一次。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n也讓我看看吧，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "最棒的度假村。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊……",
    "voice": "vo_adv_1080003_027",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "非常感謝你！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "那，",
    "voice": "vo_adv_1080003_028",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "什麼時候要開工啊？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個。",
    "voice": "vo_adv_1080003_029",
    "unit_id": 108011
  },
