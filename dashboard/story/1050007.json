  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你別驚慌。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n今天，你就配合我演一場戲。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為現在大家，",
    "voice": "vo_adv_1050007_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n一定都在某個地方監視著我們。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "其實……",
