  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被美咲叫出來，\\n正在蘭德索爾的大街上等著她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
