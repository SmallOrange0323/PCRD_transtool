  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走在街上時，\\n聽到一陣令人耳熟的童音與穿著高跟鞋的走路聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊！",
    "voice": "vo_adv_1050002_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n{0}，我總算找到你了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼！？",
    "voice": "vo_adv_1050002_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我才不要吃糖果！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你不要把我當成小孩子！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "比起那個！",
    "voice": "vo_adv_1050002_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要給我負起責任！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "負責任！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為我被你救了的關係，",
    "voice": "vo_adv_1050002_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我身為成熟淑女的尊嚴，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "都被搞得亂七八糟了啦！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼！？",
    "voice": "vo_adv_1050002_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你說你完全不知道我在說什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我呢，",
    "voice": "vo_adv_1050002_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在那之後可是被男生們一直嘲笑！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "他們對我說「妳打不倒怪物，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n才不是什麼成熟的淑女」！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊──",
    "voice": "vo_adv_1050002_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我只要一想起那群幼稚的臭男生，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就覺得實在是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "氣死人了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你呀，",
    "voice": "vo_adv_1050002_007",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對於成熟淑女來說，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n要怎麼做才算是負責……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你應該知道吧？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說起大人呢，",
    "voice": "vo_adv_1050002_008",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是要在高級餐廳享用晚餐啊。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當然，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是要由男方請客。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "之後，",
    "voice": "vo_adv_1050002_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就讓你買個名牌包包給我吧。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也要買雙新款的高跟鞋送我！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊啊……",
    "voice": "vo_adv_1050002_010",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是多麼美好",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "又成熟的夜晚啊。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我光是想像一下，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "內心就激動不已♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呵呵，",
    "voice": "vo_adv_1050002_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你可沒有任何",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "拒絕的權利喔。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為你讓我遭遇到那種事，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可要好好地負起責任喔？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什、",
    "voice": "vo_adv_1050002_012",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "誰是小孩！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n不准把我當成小孩！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話、",
    "voice": "vo_adv_1050002_013",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話說回來！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這個才不是約會！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是笨蛋嗎、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是笨蛋嗎！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呵呵，",
    "voice": "vo_adv_1050002_014",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣子你就會緊張？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你也有可愛的一面嘛。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過呢，",
    "voice": "vo_adv_1050002_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你就放心吧。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我身為一位成熟的淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "會從頭到尾教你――",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1050002_016",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你說不是這樣，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是和小孩兩個人走在一起，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "會害怕世人的眼光而覺得緊張！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所・",
    "voice": "vo_adv_1050002_017",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "以・",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你別把我當小孩子看──！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的！",
    "voice": "vo_adv_1050002_018",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們要一起外出！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "今天，我們要度過一個優雅又成熟的夜晚♪",
    "voice": "vo_adv_1050002_019",
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哼～哼～哼♪",
    "voice": "vo_adv_1050002_020",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀！？",
    "voice": "vo_adv_1050002_021",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔……",
    "voice": "vo_adv_1050002_022",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好痛……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n因為我今天",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "穿了稍微高一點的跟鞋……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": "vo_adv_1050002_023",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚嗚嗚……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚嗚嗚，",
    "voice": "vo_adv_1050002_024",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "吵死了――笨蛋！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚嗚嗚嗚……！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哇……",
    "voice": "vo_adv_1050002_025",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "被摸摸頭，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺好舒服……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我說，",
    "voice": "vo_adv_1050002_026",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你別把我當小孩子！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "摸、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "摸摸頭什麼的……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "笨蛋――！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": "vo_adv_1050002_027",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的是、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "糟透了……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n為什麼我非得落入這種窘境不可？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "做、",
    "voice": "vo_adv_1050002_028",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "做什麼啦？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
