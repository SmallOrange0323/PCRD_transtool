  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "本当に",
    "voice": "vo_adv_6050110_000",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "帰っちゃった……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "んですよね？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nあんまり実感ないですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "また明日も会えるような。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "霊界にですか？　",
    "voice": "vo_adv_6050110_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "嫌ですよ！　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "い、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "行くのが嫌なんじゃなくて、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nすぐに会いに来たと思われるのが恥ずかしいだけです。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "もう少し時間が経てば……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "それはそのとき考えましょう。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "え～",
    "voice": "vo_adv_6050110_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "来年もやるつもりですか～？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "きっと来年は",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "あの子たちが楽しませてくれますよ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "私はそう信じてます。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "また会えるからって",
    "voice": "vo_adv_6050110_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "さみしくないわけじゃ……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "あ、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いや別にさみしくなんかないですよ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "でも、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そうですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "また会える日が楽しみです。",
    "voice": null,
    "unit_id": 113911
  }
]
