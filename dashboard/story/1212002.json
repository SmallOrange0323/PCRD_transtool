[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與{0}重逢後過了幾天，在某個日子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉比林斯達和璃乃跟靜流",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起賣力地製作著可麗餅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "121200101"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓您久等了。",
    "voice": "vo_adv_1212002_000",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "抹茶紅豆奶油口味！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "謝謝妳～！",
    "voice": "vo_adv_1212002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後這一份是──",
    "voice": "vo_adv_1212002_002",
    "unit_id": 106812
  },
  {
    "type": "still",
    "still_id": "121200102"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "！！",
    "voice": "vo_adv_1212002_003",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "啊！",
    "voice": "vo_adv_1212002_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對不起！",
    "voice": "vo_adv_1212002_005",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我馬上為您重做一份……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……靜流、璃乃。",
    "voice": "vo_adv_1212002_006",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我想先讓妳們自己顧店，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以拜託妳們嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們是沒什麼問題……",
    "voice": "vo_adv_1212002_007",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會長，",
    "voice": "vo_adv_1212002_008",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳還好嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不久之前是沒什麼問題啦。",
    "voice": "vo_adv_1212002_009",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但保險起見，我去幫自己做個檢查，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n妳們就先做新的可麗餅給客人吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "了解！",
    "voice": "vo_adv_1212002_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳要保重喔，",
    "voice": "vo_adv_1212002_011",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會長！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好了……",
    "voice": "vo_adv_1212002_012",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總之我就先幫自己診療一下吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不知道結果",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是吉是兇……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯……",
    "voice": "vo_adv_1212002_013",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒有異狀啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……這真是奇怪極了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒有異狀的異狀嗎……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果目前為止都沒有痕跡和變化，",
    "voice": "vo_adv_1212002_014",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就不是由我這個本體，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而是與我相關的外部因素所導致的現象……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "菲歐，妳在嗎～？",
    "voice": "vo_adv_1212002_015",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很抱歉這麼突然，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但我想跟妳確認一下跟少年有關的事情……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "晶！",
    "voice": "vo_adv_1212002_016",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "太好了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想找妳確認一件……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……發生什麼事情了？",
    "voice": "vo_adv_1212002_017",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "從不久前開始，",
    "voice": "vo_adv_1212002_018",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就沒辦法連接上{0}被隔離出來的精神了！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以前明明沒有",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "發生過這樣的事情，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為什麼突然……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "隔離？",
    "voice": "vo_adv_1212002_019",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原來他需要採取這麼嚴重的處置嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而且妖精竟然無法主動與玩家接觸……？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這個功能應該沒有發生異常啊……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且包括他的精神在內，",
    "voice": "vo_adv_1212002_020",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我從這裡什麼都感應不到。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "晶，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以請妳那邊調查一下這件事嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當然沒問題。",
    "voice": "vo_adv_1212002_021",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我馬上來嘗試與少年接觸。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n如果知道了什麼，我再跟妳分享情報。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜託妳了！",
    "voice": "vo_adv_1212002_022",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……狀況似乎糟糕到超乎預期啊。",
    "voice": "vo_adv_1212002_023",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "希望少年他沒事……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "background",
    "bg_id": "500360"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你好～！",
    "voice": "vo_adv_1212002_024",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "有人在嗎～？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……都沒人在？",
    "voice": "vo_adv_1212002_025",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "有少年在啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這真是太好了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n他有在好好睡覺。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "肉體是平安的……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "打擾一下囉。",
    "voice": "vo_adv_1212002_026",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒想到，",
    "voice": "vo_adv_1212002_027",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我居然會有把七冠的權能用在擅自闖入民宅的這一天……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗨，少年。",
    "voice": "vo_adv_1212002_028",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你睡得真香啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……不對。",
    "voice": "vo_adv_1212002_029",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這不是在睡覺。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這已經不是那個層級的狀態了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就讓我看看吧。",
    "voice": "vo_adv_1212002_030",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看看你身上發生了什麼事情。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n開始連線──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "──咦？",
    "voice": "vo_adv_1212002_031",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "連不上去……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這怎麼可能。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "既然如此，就算有點強硬，我也要連線上去！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "──！",
    "voice": "vo_adv_1212002_032",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唔！",
    "voice": "vo_adv_1212002_033",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這邊主動發出的連線",
    "voice": "vo_adv_1212002_034",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一點都不穩定……！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n而且間隔越來越大了！　",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "再這樣下去就糟了……！",
    "voice": "vo_adv_1212002_035",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n至少暫時先把公主騎士之力，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "回收到我這邊──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗚",
    "voice": "vo_adv_1212002_036",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗚唔……",
    "voice": "vo_adv_1212002_037",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "糟糕！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "行不通嗎……",
    "voice": "vo_adv_1212002_038",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可惡！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n怎麼會發生這種事情……",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年的座標……",
    "voice": "vo_adv_1212002_039",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒辦法確認！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "～為什麼啊！我這個笨蛋！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可別以為我只有被侵蝕的份喔……？",
    "voice": "vo_adv_1212002_040",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我一定會理解這所有一切的……！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是啊，沒錯。",
    "voice": "vo_adv_1212002_041",
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我無論如何都會完成對「你」的分析……！",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我怎麼能",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "再次失去你。",
    "voice": null,
    "unit_id": 106814
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我回來了，璃乃，",
    "voice": "vo_adv_1212002_042",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "靜流……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會長！",
    "voice": "vo_adv_1212002_043",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳跑去哪裡閒晃了啊！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "游泳好閒也要有個限度！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳想說的是",
    "voice": "vo_adv_1212002_044",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「遊手好閒」才對吧，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但璃乃說得沒錯喔，會長。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也沒想到妳居然沒有在關店之前回來。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唉呀，真是抱歉！",
    "voice": "vo_adv_1212002_045",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n因為我被正在忙的事情耽擱了一下！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其實",
    "voice": "vo_adv_1212002_046",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我還有一件事情",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "想拜託妳們……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯？",
    "voice": "vo_adv_1212002_047",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是什麼事情？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於蘭德索爾的各種地方和各種人，",
    "voice": "vo_adv_1212002_048",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我有一些想調查的事情。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這是祕密結社的工作！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這麼說起來，",
    "voice": "vo_adv_1212002_049",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們其實是祕密結社呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是啊。",
    "voice": "vo_adv_1212002_050",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然我們直到不久之前，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n都還在缺了某個人的可麗餅店",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "努力地工作呢。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唔哇，",
    "voice": "vo_adv_1212002_051",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我嚐到了成堆的濃重挖苦……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是希望",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們能為少年露一手，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但妳們不願意的話，我就自己──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為了弟弟！？",
    "voice": "vo_adv_1212002_052",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "討厭啦會長，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳早點說嘛！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n如果是為了弟弟，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐可不會只露一手就算了！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就算要我露到一絲不掛，我也會完成任務的！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "既然姐姐要來這招，我也會露一手的！",
    "voice": "vo_adv_1212002_053",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然很害羞，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但如果是為了哥哥，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n要我露一點也……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒人要妳們真的露吧～？",
    "voice": "vo_adv_1212002_054",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是希望妳們能拿出這麼多的努力。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n明白了嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流、璃乃",
    "words": "是──！",
    "voice": "vo_adv_1212002_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這種時候",
    "voice": "vo_adv_1212002_056",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就得先從收集資料開始。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "又要讓可麗餅店歇業一陣子了啊……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "比起那個，",
    "voice": "vo_adv_1212002_057",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在這件事",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "比什麼都還要重要。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "為了等待少年甦醒過來的人們，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我們來驗證各種可能性吧！　",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": "vo_adv_1212002_058",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "天才會用天才般的方式迎戰，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n來拯救你的！　",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拉比林斯達為了釐清發生在{0}身上的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "找不出答案的事態，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n讓自己那顆被稱為天才的腦袋動力全開地運轉了起來。",
    "voice": null,
    "unit_id": null
  }
]
