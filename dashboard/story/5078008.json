[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "黑暗力量互相角力的戰鬥結束，蘭德索爾恢復了和平。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是在事件解決之後，城裡發生了異變，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n返回城內的魔法少女們察覺到氣氛有異，開始採取行動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "──都到齊了嗎，",
    "voice": "vo_adv_5078008_000",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "各位。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是的，",
    "voice": "vo_adv_5078008_001",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "Lovely★莫妮卡。",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "大家都到齊了。",
    "voice": "vo_adv_5078008_002",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "那麼Misty★霞。",
    "voice": "vo_adv_5078008_003",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n麻煩妳報告調查狀況。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗯，",
    "voice": "vo_adv_5078008_004",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "最近幾天，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我們四個人各自有事，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n因而離開了蘭德索爾……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "看來在這段期間，",
    "voice": "vo_adv_5078008_005",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "城裡出現了反逆獸的樣子。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "我也向【王宮騎士團】確認過了。",
    "voice": "vo_adv_5078008_006",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "普通攻擊完全無效的敵人……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "是反逆獸沒錯。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "回來後感覺城裡的狀況很奇怪，",
    "voice": "vo_adv_5078008_007",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n是反逆獸造成的嗎？",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "該說城裡很安靜才好……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "還是人莫名其妙變少了才好……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不，",
    "voice": "vo_adv_5078008_008",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "根據我打聽到的消息，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n反逆獸……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "好像早就被打倒了。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "什麼？",
    "voice": "vo_adv_5078008_009",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "出現了新的魔法少女嗎！？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不是，",
    "voice": "vo_adv_5078008_010",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "接下來這部分",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我也還沒有完全釐清情報內容……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "好像",
    "voice": "vo_adv_5078008_011",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "說是",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "有個奇怪的三人組，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n一邊將城裡的居民們變成學生……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "又或者是變成被虐狂，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n莫名其妙地拯救了城鎮",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "什麼的。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "妳剛剛說了被虐狂嗎？",
    "voice": "vo_adv_5078008_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "總、",
    "voice": "vo_adv_5078008_013",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "總之，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "先不提那個令人在意的詞，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n變成學生還真是難以理解……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "那麼，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "所謂奇怪的三人組又是？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "呃……",
    "voice": "vo_adv_5078008_014",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "聽說他們在城外建了個基地。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "城裡似乎有不少人",
    "voice": "vo_adv_5078008_015",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "也都聚集在那裡。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n好像連【王宮騎士團】也有好幾個隊員參與其中。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n應該可以看做是規模相當龐大的組織吧。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "唔……",
    "voice": "vo_adv_5078008_016",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "身為魔法少女，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "似乎不能對此事置之不理啊。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "就是說啊。",
    "voice": "vo_adv_5078008_017",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "搞不好，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "這件事",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "會是將要展開的戰鬥前兆，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "說不定已有比反逆獸",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "更巨大的邪惡誕生了……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "或許這正是",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "魔法少女漫長的戰鬥即將揭開序幕的時刻……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "妳是不是很期待呀？",
    "voice": "vo_adv_5078008_018",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "栞……？　",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "很好！",
    "voice": "vo_adv_5078008_019",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "我們就馬上",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "朝那什麼基地出發吧！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n身為魔法少女，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "讓我們親自確認該組織的真面目！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "喔──！",
    "voice": "vo_adv_5078008_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "這麼說來，",
    "voice": "vo_adv_5078008_021",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "摩拉那傢伙跑哪去了？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n這種時候",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "牠應該會最先出現才是……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "background",
    "bg_id": "501450"
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "這裡就是",
    "voice": "vo_adv_5078008_022",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "基地……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "的確很有那種氣氛。",
    "voice": "vo_adv_5078008_023",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "路上的人們",
    "words": "…………",
    "voice": "vo_adv_5078008_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "雖然想辦法混進了人群裡，",
    "voice": "vo_adv_5078008_025",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n但這到底是什麼集會啊……？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "天知道，",
    "voice": "vo_adv_5078008_026",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "雖然什麼都不清楚，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n卻感覺有種邪惡的氣息……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "嗯？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "那是……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "唉……",
    "voice": "vo_adv_5078008_027",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我還真是做了件不得了的事……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "摩拉！",
    "voice": "vo_adv_5078008_028",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n這不是摩拉嗎！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "咦！？",
    "voice": "vo_adv_5078008_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "莫、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "莫妮卡！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n大家也都在！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳們回來了是嗎！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗚哇──",
    "voice": "vo_adv_5078008_030",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "大家，該怎麼辦才好！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "身為魔法生物，",
    "voice": null,
    "unit_id": 4211
  },
