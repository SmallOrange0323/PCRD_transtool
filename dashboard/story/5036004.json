  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "但妳們打算開演唱會對吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "那麼，",
