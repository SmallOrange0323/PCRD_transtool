    "type": "dialogue",
    "name": "３人",
    "words": "嗯！",
    "voice": "vo_adv_5036004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，到了演唱會的當天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "503600401"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位……",
    "voice": "vo_adv_5036004_035",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "馬上就是開演的時間了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "外面的舞台，",
