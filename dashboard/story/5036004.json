    "voice": "vo_adv_5036004_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也準備好囉。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她們說其他城鎮的廣場上，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也聚集了很多閒閒沒事的人呢！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們知道了！",
    "voice": "vo_adv_5036004_038",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣呀～",
    "voice": "vo_adv_5036004_039",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "要讓那麼多人，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n聽我們唱歌啊～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真緊張呀～♪",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央，",
    "voice": "vo_adv_5036004_040",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳臉上寫的是「真期待」喔。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嘿嘿～☆　",
    "voice": "vo_adv_5036004_041",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "被妳發現了？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是呀！",
    "voice": "vo_adv_5036004_042",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我現在也是",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "非常期待呢♪",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……呵呵。",
    "voice": "vo_adv_5036004_043",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……？",
    "voice": "vo_adv_5036004_044",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n卯月？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "島村村？",
    "voice": "vo_adv_5036004_045",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n妳怎麼啦？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5036004_046",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n總覺得，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好奇怪呀。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "究竟是何事呢，",
    "voice": "vo_adv_5036004_047",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "卯月小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "因為呀，",
    "voice": "vo_adv_5036004_048",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "明明不久之前的我們，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n光要在小鎮村民們面前唱歌",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n就害羞到不行呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是現在……",
    "voice": "vo_adv_5036004_049",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們卻竟是如此地期待，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n能讓擠滿會場的觀眾，甚至是位在遠方城鎮的觀眾們……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n都聽到我們的歌聲。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是啊。",
    "voice": "vo_adv_5036004_050",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n不過總覺得……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "在更久之前，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我們似乎曾在更多更多人面前唱過歌。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈！",
    "voice": "vo_adv_5036004_051",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n真是這樣的話，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n或許我們本來是什麼超厲害的偶像也說不定呢♪",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵！",
    "voice": "vo_adv_5036004_052",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一定是那樣沒錯☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": "vo_adv_5036004_053",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "啊，",
    "voice": "vo_adv_5036004_054",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "皮喵。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "直到最後都還陪著我們練習。",
    "voice": null,
    "unit_id": 112511
  },
  {
