    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍好冷淡喔……",
    "voice": "vo_adv_7018000_030",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實是",
    "voice": "vo_adv_7018000_031",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我在占卜{0}的運勢時……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n占卜出了不好的結果。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以我今天是想",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給你與這件事有關的忠告，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "才會追過來的。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
