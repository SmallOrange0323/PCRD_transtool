    "name": "鈴莓",
    "words": "這樣啊……",
    "voice": "vo_adv_7018000_034",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯～",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你想怎麼做呢？",
