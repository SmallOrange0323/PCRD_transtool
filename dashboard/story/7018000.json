  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難道說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "他會在這裡遇到某些事情！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "乖乖待在家裡就不會有事了嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果不是什麼重大事件，",
    "voice": "vo_adv_7018000_033",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算能改變發生的事情，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也無法改變命運。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在{0}身邊戒備",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "降臨在他身上的不幸，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n再一起應對，我認為這麼做會比較好。",
