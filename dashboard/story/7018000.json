[
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到露娜之塔的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n陪在他身旁的還有冒失女僕鈴莓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "與你的記憶有關的線索",
    "voice": "vo_adv_7018000_000",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就在這裡啊。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n既然如此──",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有句話叫平安回家前都要多加小心",
    "voice": "vo_adv_7018000_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "。\\n為了不讓你受傷，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也會全力以赴地服務你的！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那我們就",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "趕快進塔裡……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "──呀哇！？",
    "voice": "vo_adv_7018000_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……對、",
    "voice": "vo_adv_7018000_003",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對不起！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我居然牽連了你，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓你跟我一起跌倒了……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我馬上到旁邊去……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這明明是我的錯……",
    "voice": "vo_adv_7018000_004",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你這個人真是的。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "托你的福，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我完全沒有受傷。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不管我再怎麼小心，還是冒冒失失的……",
    "voice": "vo_adv_7018000_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這實在是太丟臉了。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果能改過來，我也很想改掉，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但就只有這一點……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……沒、",
    "voice": "vo_adv_7018000_006",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒事！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "反省是很重要，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但也不能這麼消極啊！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就打起精神，重新開始吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "…………說到這個，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要怎麼進入塔裡啊？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "原來如此，",
    "voice": "vo_adv_7018000_007",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是使用在這裡的術式來移動啊。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀！？",
    "voice": "vo_adv_7018000_008",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有個女孩子在不知不覺間冒出來了！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "…………難道說，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你認識她嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………",
    "voice": "vo_adv_7018000_009",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃……",
    "voice": "vo_adv_7018000_010",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "被漂亮的人盯著看，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會讓人很緊張呢！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "初次見面，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我叫鈴莓。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我是在當占卜師的忍。",
    "voice": "vo_adv_7018000_011",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "旁邊這位則是我的……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咻～！",
    "voice": "vo_adv_7018000_012",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這位女僕妹妹挺清純的嘛！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n本大爺對小鬼沒興趣，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "但仔細一瞧，妳發育得還不錯……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就讓妳來服侍本大爺吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀哇～！？",
    "voice": "vo_adv_7018000_013",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "骷、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "骷髏頭說話了耶！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "它是魔物嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "突然叫人魔物，妳這小鬼真是沒禮貌啊！",
    "voice": "vo_adv_7018000_014",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "因為本大爺心胸寬大……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n如果妳能用自己的胸口來安慰本大爺，也是可以原諒妳啦！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔嘻嘻～！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咿～！？",
    "voice": "vo_adv_7018000_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請你不要靠過來……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是的……",
    "voice": "vo_adv_7018000_016",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n別做這種丟臉的事情啦。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "沒有沒有，",
    "voice": "vo_adv_7018000_017",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n本大爺是想以靈媒的身分調查女僕妹妹……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍也很在意",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "後面的「那個」吧？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然是這樣沒錯……",
    "voice": "vo_adv_7018000_018",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那",
    "voice": "vo_adv_7018000_019",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這件事就交給本大爺吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n本大爺會好好調查她的，仔細到像是把女僕妹妹的全身上下都舔過一遍！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊！？",
    "voice": "vo_adv_7018000_020",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請你別過來，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請你別過來！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……啊！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我一個失手，",
    "voice": "vo_adv_7018000_021",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓手杖飛出去了！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "手杖到底飛去哪裡了……！？　",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那本大爺就來見識一……",
    "voice": "vo_adv_7018000_022",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘔嗚！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "為、",
    "voice": "vo_adv_7018000_023",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "為什麼有隻巨大的魔物從天而降……？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "…………啊！",
    "voice": "vo_adv_7018000_024",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "找到",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的手杖了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但手杖",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼會從天上掉下來呢……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鈴莓丟出去的手杖被樹反彈，",
    "voice": "vo_adv_7018000_025",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n最後打中飛在天上的魔物，掉到這裡來……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "事情應該就是這樣吧。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是天譴喔，",
    "voice": "vo_adv_7018000_026",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？",
    "voice": "vo_adv_7018000_027",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這位是妳的父親嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對對對、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對不起……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "都是因為我冒冒失失的……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不，",
    "voice": "vo_adv_7018000_028",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳不必介意。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為父親",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "以前雖是位德高望重的靈媒……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一如妳所見，",
    "voice": "vo_adv_7018000_029",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他現在變成了會在女兒面前坦蕩蕩地丟人現眼，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n令人十分困擾的骷髏頭。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以說，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算他吃了一點苦頭，",
