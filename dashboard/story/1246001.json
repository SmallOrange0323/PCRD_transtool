  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年期間的某一天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美里與{0}接下祭司的請託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到神殿幫忙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "新年快樂♪",
    "voice": "vo_adv_1246001_000",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n歡迎前來參拜～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "啊，美里。",
    "voice": "vo_adv_1246001_001",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "接班的巫女已經到了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n妳幫忙到這裡就行了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n才剛過新年就請妳過來幫忙，真不好意思。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不，",
    "voice": "vo_adv_1246001_002",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "請不用放在心上～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我正好送來要供奉在祭壇上的",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "精靈之森藥草，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n只是順手幫個小忙而已♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "再說，",
    "voice": "vo_adv_1246001_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "反而是我該說聲謝謝呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n謝謝偶然相遇的{0}，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n願意陪我一起留下來幫忙──",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": "vo_adv_1246001_004",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也是～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很好很好，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是個",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "乖孩子～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "真的很謝謝",
    "voice": "vo_adv_1246001_005",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "你們兩位的幫忙。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "……對了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "若不嫌棄的話，在回去之前",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n很歡迎你們去正殿參拜一下喔。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯，",
    "voice": "vo_adv_1246001_006",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "樂意至極♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……啊，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你怕我在雪地滑倒，所以牽住我的手嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你真體貼♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n那麼，{0}，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們就手牽著手一起過去正殿吧～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": "vo_adv_1246001_007",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不管什麼時候看，正殿總是這麼宏偉壯觀。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，我們來進行新年的參拜吧──",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦……？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗚哇～～～",
    "voice": "vo_adv_1246001_008",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我抽到大凶了～～～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我不要這個～～～！！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "不要在這裡哭鬧……！",
    "voice": "vo_adv_1246001_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n你這樣會給周遭人們帶來困擾，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我們快點回去吧……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我～不～要～～！",
    "voice": "vo_adv_1246001_010",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我還要再抽一次～～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我要抽到大吉才回家～～～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真是的……",
    "voice": "vo_adv_1246001_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n你這孩子",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "老是愛無理取鬧……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你們好啊～♪",
    "voice": "vo_adv_1246001_012",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……",
    "voice": "vo_adv_1246001_013",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐，妳是誰啊？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "快走開啦！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……嗚哇～～～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我要再抽一次，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我不要大凶～～～！！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1246001_014",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你討厭大凶嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我很羨慕你呢～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "這、",
    "voice": "vo_adv_1246001_015",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "這有什麼好羨慕的……！？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我知道",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大凶是最不好的籤喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": "vo_adv_1246001_016",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你懂真多，很厲害喔～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過啊……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我是這麼想的～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在抽中",
    "voice": "vo_adv_1246001_017",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大凶的那一刻運勢是最糟的，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n但之後的運勢就只會慢慢好轉。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以說，",
    "voice": "vo_adv_1246001_018",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "接下來等著你的，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只有數不清的好事。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以我才會說很羨慕你啊～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……",
    "voice": "vo_adv_1246001_019",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "有數不清的",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "好事……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好了，",
    "voice": "vo_adv_1246001_020",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "把眼淚擦乾，笑一個吧♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n俗話說，笑門來福喔。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "像這樣，",
    "voice": "vo_adv_1246001_021",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊哈哈哈～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你可以學老師這樣開口笑嗎～？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊哈哈哈～♪",
