    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我不是笑你寫得很奇怪。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我會笑出來，那是因為……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你看我的繪馬。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我的願望是～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "「希望大家都能常保笑容」！",
    "voice": "vo_adv_1246001_084",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "想不到我們兩個都寫一樣的願望，真令人開心♪",
    "voice": "vo_adv_1246001_085",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，我們去供奉起來吧。",
    "voice": "vo_adv_1246001_086",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望我們的願望都能實現……♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人相視而笑地供奉完繪馬後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便轉身離開了擠滿新年參拜人潮的神殿。",
    "voice": null,
    "unit_id": null
  }
]
