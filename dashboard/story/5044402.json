[
  {
    "type": "background",
    "bg_id": "501031"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼，",
    "voice": "vo_adv_5044402_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "花心星終於安分點了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太讓人折騰了吧，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「呵呵呵……",
    "voice": "vo_adv_5044402_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那傢伙是花心星裡面最弱的一個……！」",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "待會應該不會",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "突然冒出另一個四天王說出這種話吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊！ ",
    "voice": "vo_adv_5044402_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也有可能暗中策劃這場騷動的邪神會出現，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吸收花心星的力量，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對我們發動襲擊！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們",
    "voice": "vo_adv_5044402_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為什麼這麼興奮啊……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我們都已經戰鬥這麼久了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種發展還是別了吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過，",
    "voice": "vo_adv_5044402_004",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們都把他打得抬不起頭了，應該沒問題啦。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這一切能平安過去都要感謝七七香的努力──！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是是是。",
    "voice": "vo_adv_5044402_005",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣就算是告一段落了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們也去享受七夕祭吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯。",
    "voice": "vo_adv_5044402_006",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "讓我們盡情沉醉於勝利之宴吧！",
    "voice": null,
    "unit_id": 113211
  }
]
