  {
    "type": "dialogue",
    "name": "白鯨",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凍結海水，形成冰牆……？",
    "voice": "vo_adv_5152001_029",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得救了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就有充足的時間能夠絆住牠了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "突然出現於平穩海邊的巨大鯨魚！",
    "voice": "vo_adv_5152001_030",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "然而過去曾一同作戰的夥伴也在此時現身，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n這展開也太熱血了吧！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喔～",
    "voice": "vo_adv_5152001_031",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "兄弟。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n你過得好嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過這種事光看就知道了呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "咦？",
    "voice": "vo_adv_5152001_032",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你該不會，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "忘記我了？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也是，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "上次我的臉幾乎都被長袍遮住了。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "仔細想想，那根本就是可疑人物嘛……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我啊，是我！",
    "voice": "vo_adv_5152001_033",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "菜月昴！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n遇合有緣，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "天地無垠的預言者！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我們可是乾杯結拜為兄弟的交情對吧～？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "所以說將美味食物吃個精光的公會",
    "voice": "vo_adv_5152001_034",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "【美食殿堂】\\n這次的目標，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是那隻巨大鯨魚嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "無法想像那會是幾人份的分量呢～",
    "voice": "vo_adv_5152001_035",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常可惜，",
    "voice": "vo_adv_5152001_036",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這次",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是收到來自公會管理協會的討伐委託呢～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該死的眼鏡女要我們來調查",
    "voice": "vo_adv_5152001_037",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n出沒在海邊的巨大黑影的真面目，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "結果就是這樣！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可沒聽說會是這麼巨大的鯨魚啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": "vo_adv_5152001_038",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「看我三兩下結束討伐，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剩下的時間就優雅地享受海水浴！」",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原本明明這麼地興致勃勃，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在是太令人同情了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喂喂，",
    "voice": "vo_adv_5152001_039",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你說這話也太見外了。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n能在這裡遇到也是某種緣分。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我也還欠兄弟你們人情呢──",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "讓我們",
    "voice": "vo_adv_5152001_040",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也來幫忙吧。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是啊，",
    "voice": "vo_adv_5152001_041",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "說的沒錯，昴。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "貪吃佩可，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也讓我們一起戰鬥吧。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣可以嗎……？",
    "voice": "vo_adv_5152001_042",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果有愛蜜莉雅你們在，當然是很讓人安心……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但你們難得來海邊……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請交給我處理！",
    "voice": "vo_adv_5152001_043",
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "有這樣的魔物在，",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴和姊姊都不能安心遊玩。",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "難得的休息時間都要白白浪費了呢。",
    "voice": "vo_adv_5152001_044",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我當然",
    "voice": "vo_adv_5152001_045",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不會放過危害莉雅安寧的傢伙哦。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的",
    "voice": "vo_adv_5152001_046",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很謝謝大家！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼就讓我們",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再度攜手吧！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "再一次請多指教囉，",
    "voice": "vo_adv_5152001_047",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "貪吃佩可！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "好啊弟兄們！",
    "voice": "vo_adv_5152001_048",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n讓牠瞧瞧",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我們的力量吧！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆、雷姆。",
    "voice": "vo_adv_5152001_049",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真不可思議。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n作戰時最沒用的巴魯斯，",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n為什麼會那麼自信滿滿呢。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊、姊姊。",
    "voice": "vo_adv_5152001_050",
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴一定是想透過那樣率先發出高聲吶喊，",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n鼓舞雷姆我們的士氣。",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n看看他高舉向天的拳頭，",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆的心正為之震撼……！",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就不能稍微讓我耍帥一下嗎！？",
    "voice": "vo_adv_5152001_051",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n雖然我",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "在戰場上的確可以說是沒有用處啦！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "好啦好啦，",
    "voice": "vo_adv_5152001_052",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "就算沒用也別哭別哭。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "昴你啊，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "只要待著就能炒熱氣氛這點我覺得很好喔？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這根本就是把我當成職場邊緣人，或者說是海岸邊緣的我了吧！",
    "voice": "vo_adv_5152001_053",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "可惡！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "會熱烈地追著我的就只有魔獸嗎！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "……不對，等等。",
    "voice": "vo_adv_5152001_054",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n雖然不確定這個世界的魔物吃不吃這招，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但是那傢伙和白鯨這麼像。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n搞不好我可以作為誘餌……！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼首先，",
    "voice": "vo_adv_5152001_055",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們先來分享關於那隻白島鯨的資訊……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "好。",
    "voice": "vo_adv_5152001_056",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "由我來當誘餌，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "大家就趁這個空檔攻擊……！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": "vo_adv_5152001_057",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "等等，昴！",
