    "type": "dialogue",
    "name": "帕克",
    "words": "會變這樣啊。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "真是有趣呢～",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_5152001_101",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您這聲音……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是肚子餓了吧？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請稍待片刻，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下馬上為您準備餐點……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了，",
    "voice": "vo_adv_5152001_102",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有飯糰喔。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n酸梅有籽，會很危險呢。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給你這個鮭魚的好了。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是揮起劍的話會很危險，",
    "voice": "vo_adv_5152001_103",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他的劍就由我保管吧♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你就握著這根掉在沙灘上的",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "帥氣木棍來代替吧♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……",
    "voice": "vo_adv_5152001_104",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，貪吃佩可。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我想這應該是很～嚴重的情況才對……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是妳們三個",
    "voice": "vo_adv_5152001_105",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "為什麼看起來都這麼平靜呢？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可等人",
    "words": "…………",
    "voice": "vo_adv_5152001_106",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可等人",
    "words": "「因為習慣了！」\\n「已經習慣了。」\\n「早就習慣啦。」",
    "voice": "vo_adv_5152001_107",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅等人",
    "words": "咦────",
