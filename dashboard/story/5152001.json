    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只有我嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只有我在認真戰鬥嗎！？",
