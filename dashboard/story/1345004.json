    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空調",
    "words": "呼唔唔唔～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "碗盤亮晶晶，",
    "voice": "vo_adv_1345004_026",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "溫度很舒適♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n嘿嘿，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "主人家的孩子們都很努力呢！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "啊，",
    "voice": "vo_adv_1345004_027",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "你肚子餓了嗎？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "那我",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "來煮飯吧！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n我會為主人",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "做好吃的料理……",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "唔～？",
    "voice": "vo_adv_1345004_028",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n奇怪奇怪，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "為什麼我的肚子也發出了和主人一樣的聲音？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "原來如此！",
    "voice": "vo_adv_1345004_029",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我一直覺得肚子有種空虛的感覺！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "原來這就代表",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "肚子餓了呀～",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "……話說回來，",
    "voice": "vo_adv_1345004_030",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "料理要怎麼做呢？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好的♪",
    "voice": "vo_adv_1345004_031",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n我之前吃的飯菜做成了真空包裝，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n但如果是現在的我，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "這次或許就可以正常飲食了！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好的♪",
    "voice": "vo_adv_1345004_032",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n我開動了～！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "嚼嚼，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "嚼嚼嚼……",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "嗯嗯嗯！？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好……",
    "voice": "vo_adv_1345004_033",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好厲害！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n味覺感應器檢測到",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "在口中",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "瞬間",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "擴散開來的感覺！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n這就是大家所說的",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "「好吃」",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "對吧！！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "主人，",
    "voice": "vo_adv_1345004_034",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我想再多吃一點！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "我可以再試試看其他料理嗎？",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "哇，",
    "voice": "vo_adv_1345004_035",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "好香的味道喔♪",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "這次的",
