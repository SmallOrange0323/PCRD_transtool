    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "所以一直在找你喔！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "然後我就發現你的背影，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
