    "name": "千惠",
    "words": "好像、",
    "voice": "vo_adv_1345004_043",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "有點……",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "難講話？",
    "voice": null,
    "unit_id": 126431
  },
