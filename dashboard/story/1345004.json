    "name": "千惠",
    "words": "但是，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "有主人幫我維護，",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "讓我覺得胸口暖暖的♪",
