    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "對吧。",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "已經過３分鐘了！",
    "voice": "vo_adv_1345004_036",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n那麼──",
    "voice": null,
    "unit_id": 126431
  },
  {
