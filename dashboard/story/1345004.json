    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "～～～～！！？",
    "voice": "vo_adv_1345004_038",
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n哈、",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "呼、",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "呼呼！",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 126431
  },
  {
    "type": "dialogue",
    "name": "千惠",
    "words": "這是什麼啊～？",
