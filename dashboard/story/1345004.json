    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "請你好好抓緊我喔！",
