    "type": "dialogue",
    "name": "媞雅",
    "words": "你這個金魚腦。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n少給我忘得一乾二淨了。",
