    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "奇怪奇怪？",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n眼前",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "閃閃發光的！",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n視線感應器明明沒有異常，",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "究竟是怎麼回事？",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "而且",
    "voice": "vo_adv_1345004_002",
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "能量明明是騎士先生提供給我的，",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n但好奇怪喔，",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就像之前一樣，",
    "voice": null,
    "unit_id": 134513
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "突然進入了休眠狀態──",
    "voice": null,
    "unit_id": 134513
  },
