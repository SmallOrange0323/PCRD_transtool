    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "志那都！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼啊，志那都。",
    "voice": "vo_adv_5136068_031",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們才分開一下子妳就交到新朋友了嗎？",
