    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喔喔，",
    "voice": "vo_adv_5136068_030",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！！",
