[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾商圈林立著各式各樣的商店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n志那都站在其中一間店前，盯著擺放在門口的商品。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "《輕鬆學習皇族歷史》……",
    "voice": "vo_adv_5136068_000",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "《蘭德索爾漫遊指南》……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……閱讀這一區的書，",
    "voice": "vo_adv_5136068_001",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就能瞭解這邊的世界，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n或許也不錯呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "雖然我不能待在這裡太久……",
    "voice": "vo_adv_5136068_002",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n但是這樣或許也有助於",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "讓我跟怜他們能夠順利對話。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "還有……",
    "voice": "vo_adv_5136068_003",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "《冥風戰記》，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是小說吧。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不過這位作者的名字，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我好像在哪看過……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "莫非……",
    "voice": "vo_adv_5136068_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳也是",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對魔導書有共鳴的盟友之一，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n受「魔瞳」所指引的",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "宿命戰士嗎！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯？",
    "voice": "vo_adv_5136068_005",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那麼此番的邂逅",
    "voice": "vo_adv_5136068_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "必定也是宿命。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我也很歡迎",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳踏出邁向霸道的一步喔！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈～哈哈哈！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……她是這個世界的",
    "voice": "vo_adv_5136068_007",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "安妮羅潔嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n然後這本書，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n很有可能",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是她所寫的小說……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……原來如此。",
    "voice": "vo_adv_5136068_008",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n她是看到好像有人對自己寫的小說有興趣，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n所以才來跟我搭話……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是吧。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "…………",
    "voice": "vo_adv_5136068_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我那個世界的安妮羅潔，",
    "voice": "vo_adv_5136068_010",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n雖然也寫了有著獨特世界觀的小說……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n但她的外表和言行舉止",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "應該跟一般的少女沒什麼不同。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不過，",
    "voice": "vo_adv_5136068_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這邊的安妮羅潔，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "似乎更加地",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n沉浸在自己描繪的世界裡。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "既然如此，我……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊、",
    "voice": "vo_adv_5136068_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嚇到妳了吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "請別介意，繼續購物──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………原來如此。",
    "voice": "vo_adv_5136068_013",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這場邂逅不是偶然，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "而是必然嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……！",
    "voice": "vo_adv_5136068_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我的風和妳的冥風……",
    "voice": "vo_adv_5136068_015",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "之所以會相互交疊，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "一定是創世之時",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就注定好了……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……這樣的感覺可以嗎？",
    "voice": "vo_adv_5136068_016",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在另一個世界裡，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "安妮羅潔所寫的小說，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n應該也是一樣的文體……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……她都來向我搭話了，",
    "voice": "vo_adv_5136068_017",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "那就不能無視。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我已經盡我所能地表現出敬意……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n難道是我搞錯了嗎？　",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈～哈哈哈！",
    "voice": "vo_adv_5136068_018",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我的「魔瞳」果然沒有看走眼！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "既然妳有投身於無盡鬥爭的覺悟，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我就歡迎妳吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n歡迎妳加入我疾風之冥姬的",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "無盡鬥爭輪迴！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "看來是對的嗎…………",
    "voice": "vo_adv_5136068_019",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "太好了。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳的雙眼中，",
    "voice": "vo_adv_5136068_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也寄宿著和我相同的意志。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那是打算殲滅任何阻擋自身霸道的敵人，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "魔王的意志。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "在這個世界之中，",
    "voice": "vo_adv_5136068_021",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳的力量很明顯地不同……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳身上穿著的漆黑裝束",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "彷彿就是那股力量的體現。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "根本無法掩蓋住滿溢而出的",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "魔力波動……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……莫非，",
    "voice": "vo_adv_5136068_022",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "她是在說衣服的事嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n確實……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n或許有和她的品味",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "相通的地方。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……我的存在，",
    "voice": "vo_adv_5136068_023",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n是出自黑暗，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "並回歸黑暗。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我的姿態",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "也不過是象徵那道黑暗罷了……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "僅此而已。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喔喔！",
    "voice": "vo_adv_5136068_024",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "誕生於冥府深淵的黑暗劍士啊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n報上",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳的名來吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……志那都。",
    "voice": "vo_adv_5136068_025",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這是我",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "於現世所現之身被賦予的",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "偽名。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………這種說話方式",
    "voice": "vo_adv_5136068_026",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "意外地好溝通呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "因為用字遣詞很困難，",
    "voice": "vo_adv_5136068_027",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "所以在說出口之前必須先思考過。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……這種節奏，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "或許很適合不擅說話的我。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "志那都，",
    "voice": "vo_adv_5136068_028",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我就讓妳",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "見識一下更漆黑的深淵吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "具體而言，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是我要鉅細靡遺地",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n把我親自創作的敘事詩從起源開始──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔，",
    "voice": "vo_adv_5136068_029",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這個聲音是……",
