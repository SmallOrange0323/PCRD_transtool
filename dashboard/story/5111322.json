[
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀啊！",
    "voice": "vo_adv_5111322_000",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "望！",
    "voice": "vo_adv_5111322_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這些傢伙是！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是",
    "voice": "vo_adv_5111322_002",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們嗎……！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哦，",
    "voice": "vo_adv_5111322_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "想用冒牌貨這種無聊的手段來動搖心理啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好啊，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那就由我來──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝你替我們操心，",
    "voice": "vo_adv_5111322_004",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，這場面不需要你出手。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘉夜說得沒錯，",
    "voice": "vo_adv_5111322_005",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們要靠自己做個了斷。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是這樣，",
    "voice": "vo_adv_5111322_006",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你就在旁邊看吧！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "區區冒牌貨，我們馬上就能解決！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……唉呀，",
    "voice": "vo_adv_5111322_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是可靠呢。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我就先休息一下了，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳們加油喔～",
    "voice": null,
    "unit_id": 106211
  }
]
