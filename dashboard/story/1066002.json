[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遇見祈梨的數日後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又一次迷失於蘭德索爾巷弄間的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在聽見有些熟悉的說話聲後回過了頭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼哼哼～哼♪",
    "voice": "vo_adv_1066002_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我要做好今天的生意，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "讓老大和嘉夜夜",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大吃一驚！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好痛……！",
    "voice": "vo_adv_1066002_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喂你這傢伙！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n幹嘛呆站在路中……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦，",
    "voice": "vo_adv_1066002_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊──！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你是之前的那個人！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在這裡做什麼啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "哦，",
    "voice": "vo_adv_1066002_003",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "你不是之前遇到的那個小哥嗎。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "當時真是多謝啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1066002_004",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "我們接下來要去處理生意了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n小哥你看起來很閒嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "今天的生意是上門討債！",
    "voice": "vo_adv_1066002_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "比起腕力更需要智力！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是我的聰明才智發揮效用的地方！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這次我要大顯身手，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓大家都向我臣服！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "……話是這麼說啦，",
    "voice": "vo_adv_1066002_006",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "但帶上祈梨的話，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n我們會被討債對象小看啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n所以我們想拜託小哥",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "幫一個小忙……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "能不能麻煩小哥",
    "voice": "vo_adv_1066002_007",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "幫我們照顧好祈梨啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "放心放心，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "我們的討債生意是合法的。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n也會付你酬勞，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "拜託啦……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "好了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "拿著。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "這是預付款。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯？",
    "voice": "vo_adv_1066002_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們兩個，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在那裡做什麼？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "沒事，",
    "voice": "vo_adv_1066002_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "只是覺得肚子餓了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "想稍微休息一下。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "也給祈梨一些零用錢，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "妳去買點什麼來吃吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1066002_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "反正今天的生意應該很好解決，我們就放輕鬆點吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉～",
    "voice": "vo_adv_1066002_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的，你們",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還真是缺乏幹勁耶……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然你們都這麼說了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n也不是不能停下來休息啦。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這",
    "voice": "vo_adv_1066002_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可不是因為我想要拿零用錢之類的喔？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟聆聽部下們的意見也是幹部該做的事嘛！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快把零用錢給我！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "給，",
    "voice": "vo_adv_1066002_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "都在這裡了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "那麼，",
    "voice": "vo_adv_1066002_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "還請往那邊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼哼，",
    "voice": "vo_adv_1066002_015",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來你們終於明白我的偉大之處了呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們兩個？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是要去哪裡？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "工作交給我們處理，",
    "voice": "vo_adv_1066002_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "妳就放心吧──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "抱歉啦～",
    "voice": "vo_adv_1066002_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "小哥！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n祈梨就拜託你囉！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你、",
    "voice": "vo_adv_1066002_018",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們兩個──！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n把我這個幹部當成什麼了───！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……算了，",
    "voice": "vo_adv_1066002_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他們都已經跑了也沒辦法……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就只能來有效地運用這筆零用錢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說回來你！",
    "voice": "vo_adv_1066002_020",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底要跟著我多久！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我也差不多開始覺得煩了喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉……",
    "voice": "vo_adv_1066002_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該怎麼說，看來你是那種不知變通的人呢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣子人生會錯失很多樂趣喔。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你以為你是我的監護人嗎？",
    "voice": "vo_adv_1066002_022",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉～",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還真是個讓人感到噁心的傢伙。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你總有一天會被當成可疑分子抓起來的。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是犯罪，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是犯罪事件啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過好吧……",
    "voice": "vo_adv_1066002_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總之的確是多虧了你，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我才能拿到這筆錢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n看在你的分上，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就盡情地邊走邊吃吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以啊，",
    "voice": "vo_adv_1066002_024",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你從剛才開始就想說什麼？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是有什麼想問的問題",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就直接說出來。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還真是深入的問題耶……",
    "voice": "vo_adv_1066002_025",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過也無所謂。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也不是自願待在這個幫派裡的喔。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n最主要的原因是欠了老大一大筆債……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": "vo_adv_1066002_026",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也不光是這樣喔。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n因為龍人族很稀有，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以常常會有人來找我們麻煩也是原因之一。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_1066002_027",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你以為我是魔族或蜥蜴獸人之類的……？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我現在已經不會",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "被那種話激怒了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n畢竟我至今為止都不知道被說了多少次……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "再加上我個子矮，",
    "voice": "vo_adv_1066002_028",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "本來就很容易被人瞧不起……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以我要成為大人物，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓他們好看！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為此我需要力量！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "需要擁有壓倒性的力量！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "正好",
    "voice": "vo_adv_1066002_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "幫派這種組織，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是獲取力量的最佳管道。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就讓我來告訴無知的你吧，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "力量也是有分很多種的喔。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不只是腕力，",
    "voice": "vo_adv_1066002_030",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還有智力、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "權力、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "財力……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "特別是權力和財力，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我覺得跟我很相稱呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "況且，",
    "voice": "vo_adv_1066002_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也沒辦法丟下其他龍人族的夥伴不管嘛……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜要是沒有我的話感覺會很危險，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大她……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "她就無所謂了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以說，",
    "voice": "vo_adv_1066002_032",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我今天要做好這份重要生意，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n讓他們認可我，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "本來",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "應該是那樣的……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都是因為你才會變成現在這樣啦。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，算了。",
    "voice": "vo_adv_1066002_033",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n今天就讓你見識見識我的人脈有多廣吧。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "介紹給你我的私房愛店！",
    "voice": "vo_adv_1066002_034",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你就空著肚子跟我來吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……你們兩個，",
    "voice": "vo_adv_1066002_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在這裡做什麼？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "咦，",
    "voice": "vo_adv_1066002_036",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "祈梨……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "什麼做什麼，",
    "voice": "vo_adv_1066002_037",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "我們在工作啊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "跟著祈梨到達了目的地，在那裡見到的卻是剛才的幫派成員，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和被他們所包圍，看起來像是攤販店長的人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳是",
    "voice": "vo_adv_1066002_038",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "常常來光顧的小姑娘……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳認識這些人嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "難道說，",
    "voice": "vo_adv_1066002_039",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "今天要討債的對象，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是這間攤販嗎！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "哎呀……",
    "voice": "vo_adv_1066002_040",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "所以我們才不想帶妳來啊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "不，",
    "voice": "vo_adv_1066002_041",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "這不是小哥你的錯。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n是沒說清楚狀況的我們不好。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所、",
    "voice": "vo_adv_1066002_042",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以說",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "積欠的金額大概有多少？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n今天之內還得完嗎！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這個嘛……",
    "voice": "vo_adv_1066002_043",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "今天之內的話",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "應該勉勉強強",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "算是可以還得完",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "店長大哥啊",
    "voice": "vo_adv_1066002_044",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "說謊可不好喔？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "最近這裡都沒什麼客人，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "收入幾乎是零吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "你還是快點放棄另謀出路吧。",
    "voice": "vo_adv_1066002_045",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們兩個都給我安靜！",
    "voice": "vo_adv_1066002_046",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n現在就讓我來為攤販收入做出貢獻吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我看看……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……一塊──",
    "voice": "vo_adv_1066002_047",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "兩塊──",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "三塊──",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……咦？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "差那麼一點點……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……",
    "voice": "vo_adv_1066002_048",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳的好意我心領了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n反正都到最後了，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不夠的那部分就當作優惠……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣不行！",
    "voice": "vo_adv_1066002_049",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n要是沒辦法提高收入的話",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "攤販就要沒了耶？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我才不要那樣！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳……",
    "voice": "vo_adv_1066002_050",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": "vo_adv_1066002_051",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真的可以嗎……？",
    "voice": null,
