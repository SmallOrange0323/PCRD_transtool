    "words": "來了超級多客人啊～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n會這樣也是因為……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這都是多虧了你們啊。",
    "voice": "vo_adv_1066002_076",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n似乎是路過的人看見了",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們吃得津津有味的樣子，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n才對我賣的塔可餅產生了興趣。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈──哈哈哈！",
    "voice": "vo_adv_1066002_077",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就跟我計劃的一樣！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "那些人只是碰巧看到而已吧。",
    "voice": "vo_adv_1066002_078",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "才不是那樣呢！",
    "voice": "vo_adv_1066002_079",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我當然",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在一開始就預料到了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這也是我計畫中的一環喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "非常感謝！",
    "voice": "vo_adv_1066002_080",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們是敝店的恩人！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼～！",
    "voice": "vo_adv_1066002_081",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你可以盡量稱讚我喔？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n來嘛來嘛，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥也是！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "不過啊，",
    "voice": "vo_adv_1066002_082",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "這樣一來老大的計畫就泡湯了吧……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": "vo_adv_1066002_083",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是什麼意思？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "也就是說，",
    "voice": "vo_adv_1066002_084",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "我們這次來討債的目的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "不是為了收回本金，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n而是為了將這間作為抵押品的攤販",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "給收下來啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "祈梨覺得這種結果比較好那就這樣吧。",
    "voice": "vo_adv_1066002_085",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n反正我們也已經收回本金了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "沒有什麼損失。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "不過老大會怎麼想呢？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸？",
    "voice": "vo_adv_1066002_086",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦……？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥……？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥啊啊啊啊～！？",
    "voice": "vo_adv_1066002_087",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這種事情應該要早點說啊！",
    "voice": "vo_adv_1066002_088",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這件事要是被老大知道了，我會受到懲罰吧！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "這個嘛……",
    "voice": "vo_adv_1066002_089",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "大概吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "八九不離十吧。",
    "voice": "vo_adv_1066002_090",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎、",
    "voice": "vo_adv_1066002_091",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是──",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊啊，",
    "voice": "vo_adv_1066002_092",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "能還清債務真是太好了……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n謝謝你們！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "下次你們來光顧的話，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "請讓我給你們一些優惠吧！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_1066002_093",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "比起失去這樣的美食，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n懲罰之類的根本不算什麼！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "儘管放馬過來吧！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "懲罰……",
    "voice": "vo_adv_1066002_094",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "算個什麼東西嘛～！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在被夕陽染紅的蘭德索爾街道上，\\n迴盪著祈梨自暴自棄般的叫喊聲……",
    "voice": null,
    "unit_id": null
  }
]
