  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「3000年只開一次的花」綻放的夢幻地點──欣特蘭德，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可璃亞和安涅默涅以那裡為目標啟程出發。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人為了購買旅行所需的物資，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順道前往某座村子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "前方的路途還很漫長，",
    "voice": "vo_adv_5207001_000",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們一起去買點食物吧。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要是能買些點心就更好了♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這樣啊──",
    "voice": "vo_adv_5207001_001",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "先失陪了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_5207001_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n安、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──只不過是採購，",
    "voice": "vo_adv_5207001_003",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我一個人也辦得到。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "況且……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我們，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "並非正在",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "一起旅行。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "話是這麼說沒錯……",
    "voice": "vo_adv_5207001_004",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但沒問題嗎……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──首先，",
    "voice": "vo_adv_5207001_005",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是食物。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n再來是，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "要配合氣候，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "購買需要的",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "上衣──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……欣特蘭德",
    "voice": "vo_adv_5207001_006",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "什麼樣的地方呢。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n因為會開花，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "所以很溫暖？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "如果是山上的話，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "也要考慮到氣候寒冷──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "哎呀，",
    "voice": "vo_adv_5207001_007",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "有什麼需要為您服務的嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──！",
    "voice": "vo_adv_5207001_008",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "要找東西的話，",
    "voice": "vo_adv_5207001_009",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我可以協助您喔！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "還是說，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "您不曉得",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "該選哪個好呢？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不用──",
    "voice": "vo_adv_5207001_010",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不必了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊、",
    "voice": "vo_adv_5207001_011",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "難道我",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嚇到她了嗎……？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──衣服，",
    "voice": "vo_adv_5207001_012",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "之後再看。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "接下來，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是食物……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "只要看看這附近的攤販──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……食材",
    "voice": "vo_adv_5207001_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "和吉歐‧格黑納",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "完全不同……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "總之，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "先挑看起來加熱過，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就能吃的東西──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "那邊那位小妹妹！",
    "voice": "vo_adv_5207001_014",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "要不要試吃看看",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "我家的蘋果呢？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──",
    "voice": "vo_adv_5207001_015",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我不需要。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "妳別這麼說嘛！",
    "voice": "vo_adv_5207001_016",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "\\n這是我們村子的特產，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "甜度十足喔？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "只是試吃而已",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "不用錢的啦！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "話說小妹妹，",
    "voice": "vo_adv_5207001_017",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "妳的眼睛怎麼了嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "\\n裝飾？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "是都市的流行嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "攤販店員",
    "words": "很可愛呢～！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……！",
    "voice": "vo_adv_5207001_018",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n──請不要管我。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "啊，",
    "voice": "vo_adv_5207001_019",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那邊那位大姐姐！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n拜託妳，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "把掉在那附近的球──",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──！",
    "voice": "vo_adv_5207001_020",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵～",
    "voice": "vo_adv_5207001_021",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "請讓我──",
    "voice": "vo_adv_5207001_022",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n通過那裡。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "嘶呀────！！",
    "voice": "vo_adv_5207001_023",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "好痛！",
    "voice": "vo_adv_5207001_024",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n可惡──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那是，",
    "voice": "vo_adv_5207001_025",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "貓──？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n明明這麼嬌小……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "卻如此",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "凶暴。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "跟在蘭德索爾見過的，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "完全不一樣……！　",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "background",
    "bg_id": "502580"
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我感受到了。",
    "voice": "vo_adv_5207001_026",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n村民的",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "視線……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "像是在",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "探查──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就算是同一個世界──",
    "voice": "vo_adv_5207001_027",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n這裡跟",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "蘭德索爾，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "還是不一樣。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我搞不懂──",
    "voice": "vo_adv_5207001_028",
    "unit_id": 129612
  },
