    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n以及細菌入侵喔。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還有，",
    "voice": "vo_adv_5207001_058",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我用剛才安涅默涅小姐的花，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "製作了花飾。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我作了兩個，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "一個給妳♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_5207001_059",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……安涅默涅小姐。",
    "voice": "vo_adv_5207001_060",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這裡的人，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是敵人喔。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……！",
    "voice": "vo_adv_5207001_061",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我從村民們那裡聽到的，",
    "voice": "vo_adv_5207001_062",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n聽說直到最近之前，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這裡都",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很少有旅行者造訪。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我猜想他們會在意安涅默涅小姐的事情，",
    "voice": "vo_adv_5207001_063",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n只是因為很少見到外來人士",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "吧。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "妳想，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我剛才問了問題後，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對方也告訴了我們不少事情。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……還真是，",
    "voice": "vo_adv_5207001_064",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "樂觀的想法呢。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "沒有這回事啦。",
    "voice": "vo_adv_5207001_065",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我只是認為──",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真正心懷惡意的人，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n應該",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "會採取更一目瞭然的行動",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "而已。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──？",
    "voice": "vo_adv_5207001_066",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那麼，",
    "voice": "vo_adv_5207001_067",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們接下來去採購食物……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呃，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們是",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "個別行動呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_5207001_068",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "────",
    "voice": "vo_adv_5207001_069",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n……可以。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_5207001_070",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──行動。",
    "voice": "vo_adv_5207001_071",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n要一起",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "行動，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "也可以。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……真的可以嗎？",
    "voice": "vo_adv_5207001_072",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我不會說",
    "voice": "vo_adv_5207001_073",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "第二次。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──要買食物，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "對吧？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是的！",
    "voice": "vo_adv_5207001_074",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我們走吧，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，可璃亞與安涅默涅一起開始採購，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n同一時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嚼嚼……",
    "voice": "vo_adv_5207001_075",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "安涅默涅這傢伙一開始就讓人捏把冷汗！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家須得向成功調停之",
    "voice": "vo_adv_5207001_076",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可璃亞閣下致謝。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於默涅而言，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實為良機難得之經歷。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n且",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此地所結之果……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": "vo_adv_5207001_077",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "美味非常。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "尤以",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此冷凍蘋果，清涼爽口……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若能通商互市，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吉歐‧格黑納的人民",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "必定亦會喜不自勝。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是，",
    "voice": "vo_adv_5207001_078",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我們這麼悠哉",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不要緊嗎……？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉，",
    "voice": "vo_adv_5207001_079",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟這種事著急也沒用啊──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此行冒險成功與否，",
    "voice": "vo_adv_5207001_080",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "全看那兩人之意。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n咱們縱多操心，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此事亦非朝夕能成。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "況且，",
    "voice": "vo_adv_5207001_081",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "自古有云：",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n「欲求相知，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "偶有衝突，亦屬必然……」",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此刻，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "咱們只需靜靜守望於旁便是。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "欲求相知，",
    "voice": "vo_adv_5207001_082",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "偶有衝突，亦屬……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n或許",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "您說的沒錯。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "因為璃亞她一直都很溫柔……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "甚至可說溫柔過了頭。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可璃亞閣下的內心，",
    "voice": "vo_adv_5207001_083",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "猶如此蘭德索爾和煦之陽。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對已習慣吉歐‧格黑納酷暑的默涅而言，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n想必滿是困惑吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟",
    "voice": "vo_adv_5207001_084",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吉歐‧格黑納就像是灼熱地獄一樣嘛……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今年蘭德索爾的夏天",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像稍微舒適了一點？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這就叫冷夏嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
