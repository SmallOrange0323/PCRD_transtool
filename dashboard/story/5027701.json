  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似龍和祈梨繼續進行著特訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很有效果呢。",
    "voice": "vo_adv_5027701_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n變得聰明多了耶！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "似龍！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……似龍這個名字感覺不怎麼可愛耶。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說，",
    "voice": "vo_adv_5027701_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那不是祈梨妳自己幫牠取的名字嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且這傢伙，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可愛嗎……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯～",
    "voice": "vo_adv_5027701_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可愛的名字，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可愛的名字……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "叫哆啦怎麼樣！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔！　",
    "voice": "vo_adv_5027701_003",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔喔！！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔喔～",
    "voice": "vo_adv_5027701_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很開心的樣子！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你也希望我叫你哆啦吧。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔♪　",
    "voice": "vo_adv_5027701_005",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔♪",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔～",
    "voice": "vo_adv_5027701_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好乖好乖……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "做得很棒！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哆啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n嘿嘿嘿嘿嘿，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙可是能稱霸世界的奇才呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": "vo_adv_5027701_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "稱霸什麼世界啊……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近這幾場",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "的確開始稱得上是對決了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n教到這樣應該差不多了吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼！　",
    "voice": "vo_adv_5027701_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜妳就在那邊安靜看著吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n看我把妳逼到",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一個字都接不下去！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔喔喔！　",
    "voice": "vo_adv_5027701_009",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "似龍",
    "words": "咕喔喔喔！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳都說成這樣了，",
    "voice": "vo_adv_5027701_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那我就不會再放水了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "放馬過來吧！！",
    "voice": null,
    "unit_id": 106511
  }
]
