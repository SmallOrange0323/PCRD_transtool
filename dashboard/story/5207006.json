    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還傷害了妳。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "甚至害安涅默涅小姐受了傷……",
