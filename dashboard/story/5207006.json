    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "明明如此，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我卻覺得",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很高興能一起旅行。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_5207006_024",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真的",
    "voice": "vo_adv_5207006_025",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很對不起。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說得沒錯。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我並非表裡如一……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "根本不是",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "什麼好孩子。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "從以前開始……",
    "voice": "vo_adv_5207006_026",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "當然",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "現在也是。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我只是看著別人的臉色，",
