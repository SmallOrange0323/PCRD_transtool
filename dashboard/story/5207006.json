  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可璃亞和安涅默涅的旅程迎接關鍵時刻之時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}一行人也在不遠處，\\n持續與大群魔物展開交戰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500562"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可惡……",
    "voice": "vo_adv_5207006_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "往那邊過去了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本沒完沒了啊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "聰明狡詐的配合──",
    "voice": "vo_adv_5207006_001",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "即使如此。",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我也不會",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "讓你們繼續前進……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……嗯？",
    "voice": "vo_adv_5207006_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是。",
    "voice": "vo_adv_5207006_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家令幼蛇尾隨兩人身後……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然其腳步",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "突然加快了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是什麼意思？",
    "voice": "vo_adv_5207006_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n難道是",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "目的地快到了……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來好像不是啊。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為前方可是座高山喔？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "原來「欣特蘭德」此地，",
    "voice": "vo_adv_5207006_005",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟隱於深山之祕境──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n亦或此事，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "莫非另有緣由？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……璃亞……",
    "voice": "vo_adv_5207006_006",
    "unit_id": 125811
  },
  {
    "type": "background",
    "bg_id": "500212"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "…………",
    "voice": "vo_adv_5207006_007",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "可璃亞小姐──",
    "voice": "vo_adv_5207006_008",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不覺得冷嗎？",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……我不要緊。",
    "voice": "vo_adv_5207006_009",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n安涅默涅小姐才是，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "妳沒事吧？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──唔，",
    "voice": "vo_adv_5207006_010",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是的──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "可璃亞小姐──",
    "voice": "vo_adv_5207006_011",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n從剛才開始……",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就一直在",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "勉強自己吧。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "即使在路上絆倒……",
    "voice": "vo_adv_5207006_012",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "即使遇到任何狀況。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n她全都",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "承受下來──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "全身遍體麟傷，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "腳步不停地往前走。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "都是，",
    "voice": "vo_adv_5207006_013",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我的錯。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n我──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "一直不願意，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "相信她。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "因此……",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "將可璃亞小姐",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "逼到絕境……",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "早知道，",
    "voice": "vo_adv_5207006_014",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "會變成這樣──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我要是",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "更早一點",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "說出來就好了。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……唉，",
    "voice": "vo_adv_5207006_015",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可璃亞和安涅默涅",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "懷著各自的想法，持續朝深山邁步前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501682"
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──這裡就是，",
    "voice": "vo_adv_5207006_016",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "欣特蘭德……？",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "可是──",
    "voice": "vo_adv_5207006_017",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "沒有任何地方，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "開著花。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n到處都沒看到……",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……是的。",
    "voice": "vo_adv_5207006_018",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n安涅默涅小姐，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個──",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "─",
    "voice": "vo_adv_5207006_019",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "─對不起！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_5207006_020",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n這是──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "其實，",
    "voice": "vo_adv_5207006_021",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "叫做欣特蘭德的地方……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "根本就不存在。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "3000年只開一次的花也是，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "全部都是我編造的故事。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我",
    "voice": "vo_adv_5207006_022",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "想要和安涅默涅做朋友……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n想要抓住契機……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "忍不住說了謊。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我明明知道，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這是不對的……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這趟旅程中，",
    "voice": "vo_adv_5207006_023",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我把安涅默涅小姐耍得團團轉，",
