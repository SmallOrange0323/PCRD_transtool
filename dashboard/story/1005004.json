    "name": "茉莉",
    "words": "啊哈哈。",
    "voice": "vo_adv_1005004_036",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n因為我一直盯著老虎的布偶看，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你以為我想要，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以就跑去買了是嗎？",
