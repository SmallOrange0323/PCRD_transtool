    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在電視上！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}大哥，",
    "voice": "vo_adv_1005004_050",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你果然是個好人對吧？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是個Nice guy對吧？",
