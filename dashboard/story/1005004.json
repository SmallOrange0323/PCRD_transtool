    "words": "\\n請你不要那麼沮喪，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n都難得來動物園了～♪",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "耶嘿嘿。",
    "voice": "vo_adv_1005004_060",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n大哥",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為動物園到處都是情侶羨慕得不得了……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n顯得很沮喪呢。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "畢竟，",
    "voice": "vo_adv_1005004_061",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這裡有種像約會地點的感覺嘛。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯～",
    "voice": "vo_adv_1005004_062",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那不然，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這樣好了。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我來和",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "寂寞的大哥",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "來場約會。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然我還只是個小孩，",
    "voice": "vo_adv_1005004_063",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n可能也沒有什麼女孩子的感覺。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是我",
    "voice": "vo_adv_1005004_064",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "最喜歡大哥了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我陪你一起玩吧♪",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……不可以嗎？",
    "voice": "vo_adv_1005004_065",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n感覺",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不需要我？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇哇，",
    "voice": "vo_adv_1005004_066",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "請不要突然抱過來啦！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你一直說謝謝，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是在跟我道謝嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1005004_067",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對「正義的夥伴」來說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n幫助有困難的人是理所當然的！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以說大哥，",
    "voice": "vo_adv_1005004_068",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "請不要沮喪……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不管是假日，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還是動物園，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n都和我一起盡情享受吧～♪",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "來，我們快走！",
    "voice": "vo_adv_1005004_069",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n一直盯著布偶看也不是個辦法，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "接下來",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們就去見見真正的老虎吧～♪",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，辛苦你了。",
    "voice": "vo_adv_1005004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛才看見的，是如同夢境一般的情景哦。",
    "voice": "vo_adv_1005004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以你和你結下羈絆的對象……",
    "voice": "vo_adv_1005004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次是以茉莉的記憶為基礎所構成的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "大概像是電影之類的東西哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在不用那麼在意也沒關係哦。",
    "voice": "vo_adv_1005004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n反正你醒來以後，馬上就會忘記了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只不過……",
    "voice": "vo_adv_1005004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你還真是丟人呢，{0}。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "竟然讓小學女生對你說：",
    "voice": "vo_adv_1005004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n「因為很可憐所以和你約會」……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n既顧慮你的心情還陪你玩。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，開心的話就再好不過了。",
    "voice": "vo_adv_1005004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是個乖孩子呢，",
    "voice": "vo_adv_1005004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然說出口的話大多像是從特攝節目中現學現賣的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但她卻打從心底深信著那些漂亮話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "善良又率直，",
    "voice": "vo_adv_1005004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是純真呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只不過，",
    "voice": "vo_adv_1005004_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在這現實裡，並不像電視節目那樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n將骯髒以及血淋淋的事物都過濾掉了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而茉莉，",
    "voice": "vo_adv_1005004_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n或許會因為這樣而受到傷害也說不定呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……要好好地注意並保護著她哦，\\n{0}。",
    "voice": "vo_adv_1005004_081",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對獨自在動物園閒逛，",
    "voice": "vo_adv_1005004_082",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n且寂寞的你親切地伸出關心的手……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n對這小小的「正義的夥伴」，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要好好的報恩哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那孩子溫柔地陪在你的身邊……",
    "voice": "vo_adv_1005004_083",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那孩子要是心情不好的話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n下次就輪到你去幫助她了哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼嚕、",
    "voice": "vo_adv_1005004_084",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……",
    "voice": "vo_adv_1005004_085",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼啊？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦～？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "睡著了嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總覺得，",
    "voice": "vo_adv_1005004_086",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好像做了個很美好的夢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一個像是女孩子會作的，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n和最喜歡的男生",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一起約會～這種感覺的夢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯……",
    "voice": "vo_adv_1005004_087",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n既然要夢的話，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我還比較想夢見成為英雄的夢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我果然",
    "voice": "vo_adv_1005004_088",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還是有點奇怪吧。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……{0}？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": "vo_adv_1005004_089",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}也睡著了呢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你的嘴角，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "口水流出來了哦。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也是？",
    "voice": "vo_adv_1005004_090",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚呀，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真是丟臉！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚嗚～",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "擦擦！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘿嘿。",
    "voice": "vo_adv_1005004_091",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在睡著的期間，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n已經完全",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "天黑了呢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要是晚回家了的話，",
    "voice": "vo_adv_1005004_092",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n爸爸和媽媽會擔心的。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我還真是個",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "壞孩子呢。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯？",
    "voice": "vo_adv_1005004_093",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你說「茉莉是好孩子哦」，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "耶嘿嘿，",
    "voice": "vo_adv_1005004_094",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不敢當！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "為了能讓你這麼覺得，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我相當努力！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然我還沒有辦法做得很好。",
    "voice": "vo_adv_1005004_095",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但我要成為好孩子、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好人……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "與善意畫上等號的，",
    "voice": "vo_adv_1005004_096",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「正義的夥伴」。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那是我，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一直以來的夢想。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……所以說，",
    "voice": "vo_adv_1005004_097",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我沒有像普通女孩子一樣，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n和帥氣的男生約會的閒暇時間。",
    "voice": null,
    "unit_id": 100511
  }
]
