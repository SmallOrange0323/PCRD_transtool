    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你要送給我",
    "voice": "vo_adv_1005004_037",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "當禮物嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "謝、",
    "voice": "vo_adv_1005004_038",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然很開心，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n但又覺得有點不好意思呢～？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是",
    "voice": "vo_adv_1005004_039",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "退回去又覺得怪怪的，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n而且我也真的很想要這個布偶……",
