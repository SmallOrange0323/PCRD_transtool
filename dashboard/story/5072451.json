  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們花了那麼多",
    "voice": "vo_adv_5072451_000",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "時間和工夫來籌備的演唱會，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n也即將要",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "落幕了呢……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊……",
    "voice": "vo_adv_5072451_001",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然覺得有點寂寞，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們現在還站在舞台上。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒錯，紡希！",
    "voice": "vo_adv_5072451_002",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算快要結束了，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但演唱會現在還在進行著！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們得讓粉絲們",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "盡興到最後一刻！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是的，",
    "voice": "vo_adv_5072451_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我當然知道！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "慈樂之音的演唱會，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "從頭到尾總是火力全開！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們會帶來滿滿的精采演出，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "讓大家看得目不轉睛！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請你也聲援我們到最後吧！",
    "voice": "vo_adv_5072451_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你的這份心意",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "將激勵我們邁向偶像的更高境界♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為我們總能很清楚地聽到",
    "voice": "vo_adv_5072451_005",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你的聲音。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是你稍微移開視線我也會注意到的喔！",
    "voice": "vo_adv_5072451_006",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": "vo_adv_5072451_007",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓我們一舉成為真正的",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "頂尖偶像吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "喔──♪",
    "voice": "vo_adv_5072451_008",
    "unit_id": null
  }
]
