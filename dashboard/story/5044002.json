    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "只要和那裡的巫女說明來意，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "她就會讓你們見面吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來如此，",
