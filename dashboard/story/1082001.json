[
  {
    "type": "background",
    "bg_id": "505030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節即將到來，蘭德索爾也變得熱鬧了起來。\\n在前往打工的{0}面前，\\n尋找布丁的宮子出現了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，這麼巧，在這裡遇見你！",
    "voice": "vo_adv_1082001_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你知道什麼日子快要到了嗎？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "沒錯，就是萬聖節來的！　",
    "voice": "vo_adv_1082001_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為宮子是真正的幽靈，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n所以一定可以拿到很多的布丁～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以呢，",
    "voice": "vo_adv_1082001_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家是「不給布丁就搗蛋」來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要給我布丁才行～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這沒關係的！　",
    "voice": "vo_adv_1082001_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果是這樣的話，就為了宮子努力地工作賺錢吧！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那種事怎樣都好吧～",
    "voice": "vo_adv_1082001_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n世界上沒有其他事情比宮子的布丁還重要來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯，",
    "voice": "vo_adv_1082001_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你是要去靈異旅行扮鬼嗎？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嚇人好像很好玩來的！",
    "voice": "vo_adv_1082001_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n也帶宮子一起去～！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算不帶我去，我也會跟去的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500034"
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "嗨，",
    "voice": "vo_adv_1082001_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "要扮鬼的工讀生就是你們對吧？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n今天就請多指教囉。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "包在我身上～！　",
    "voice": "vo_adv_1082001_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就讓宮子來讓大家知道，什麼是真正的恐怖！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_1082001_009",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "真是可靠啊～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n那些預約的客人們，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "也都很期待唷！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "我們有準備一些扮裝的衣服，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "去選喜歡的穿吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "有好多唷～！",
    "voice": "vo_adv_1082001_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}要選什麼？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你準備的還真齊全～",
    "voice": "vo_adv_1082001_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那宮子……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔～嗯，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯～唔……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，這件！　",
    "voice": "vo_adv_1082001_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我要選這個！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "感覺好恐怖來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我去換衣服，在這邊等我一下喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "窸窸窣窣，",
    "voice": "vo_adv_1082001_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "窸窸窣窣",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "鏘～！　",
    "voice": "vo_adv_1082001_014",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家是狼女來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吼～，",
    "voice": "vo_adv_1082001_015",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不給人家布丁的話就搗蛋來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "才不是那樣呢！　",
    "voice": "vo_adv_1082001_016",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要更吃驚才對喲！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子可是冷血無情的狼女來的！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊嗚來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "呵呵呵～",
    "voice": "vo_adv_1082001_017",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "給我布丁就原諒你！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子不是肉食系也不是草食系。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是布丁系來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "很好！　",
    "voice": "vo_adv_1082001_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那麼就請你們兩個在墓地待機吧！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n我會把客人帶過去，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "到時可要好好地嚇他們唷！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "background",
    "bg_id": "500535"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "已經有好幾個扮鬼的人做好準備了。",
    "voice": "vo_adv_1082001_019",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我們也在這邊準備吧～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "呵呵……",
    "voice": "vo_adv_1082001_020",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子現在這樣，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "終於像是在做幽靈會做的事情！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n好期待喲～！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，馬上就有人過來了！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "魔物({0})",
    "words": "――吼歐歐歐歐歐！",
    "voice": "vo_adv_1082001_021",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呀――！　",
    "voice": "vo_adv_1082001_022",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是魔物幽靈——！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，感覺不錯來的！　",
    "voice": "vo_adv_1082001_023",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也要試試看～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吼歐～！　",
    "voice": "vo_adv_1082001_024",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "快把布丁交出來喲～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n不給我的話，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就把你變成布丁給吃掉來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呀――！　",
    "voice": "vo_adv_1082001_025",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "別把我變成布丁――！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1082001_026",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大家好像都很開心來的。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "開始有萬聖節的感覺喲！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吼歐吼歐～！　",
    "voice": "vo_adv_1082001_027",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家要繼續多嚇嚇大家喲～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……奇怪？　",
    "voice": "vo_adv_1082001_028",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "入口那邊好像發生了什麼事。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n我去看看～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "啊？　",
    "voice": "vo_adv_1082001_029",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "這是什麼……靈異旅行？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "哼，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "因為萬聖節要到了，所以你們才搞了這種無聊的玩意啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這位客人，",
    "voice": "vo_adv_1082001_030",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "現在馬上就可以入場……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n招待你來場",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "恐怖的靈異旅行。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "哈！　",
    "voice": "vo_adv_1082001_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我才不相信有什麼幽靈勒！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n來啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "有辦法的話就來嚇我看看啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "要是我一點都不害怕的話，可要罰錢喔～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "罰、罰錢！？　",
    "voice": "vo_adv_1082001_032",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "怎樣，不敢是吧！？",
    "voice": "vo_adv_1082001_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n連嚇人的自信都沒有，就別來做這種事情啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "唔……",
    "voice": "vo_adv_1082001_034",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "那麼，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "就讓你見識一下吧！ ",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
