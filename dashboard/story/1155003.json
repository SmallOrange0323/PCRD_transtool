[
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在{0}等人要離開可可蘿故鄉的前一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n村子裡的精靈族人們為了可可蘿舉辦了一場歡送會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "這是剛採下來的貴重藥草。",
    "voice": "vo_adv_1155003_000",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "如果在回去路上受傷的話就能派上用場，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "妳就收下吧。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1155003_001",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此貴重的藥草……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常感謝您。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "回蘭德索爾的路那麼長，",
    "voice": "vo_adv_1155003_002",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n藥草什麼的",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "路上隨便都有啦。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "而且",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "那個沒受傷就沒用了嘛。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "比、",
    "voice": "vo_adv_1155003_003",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "起、",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "那、",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "個……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "更重要的是食物！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "畢竟妳說有個夥伴是大胃王嘛，",
    "voice": "vo_adv_1155003_004",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "乾糧我也準備了非常多，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "裝到馬車裝不下為止，都帶走吧！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非、",
    "voice": "vo_adv_1155003_005",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常感謝您。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐肯定也會非常高興的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可可蘿姐姐！",
    "voice": "vo_adv_1155003_006",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "還有這是剛剛才採下來的水果！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是我從種子開始種的喔！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦，",
    "voice": "vo_adv_1155003_007",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下會細心品嚐的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n謝謝妳。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "這個也拿去吧。",
    "voice": "vo_adv_1155003_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人3",
    "words": "來，",
    "voice": "vo_adv_1155003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人3",
    "words": "這個。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人3",
    "words": "\\n只是為了可可蘿而織的帽子喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是、",
    "voice": "vo_adv_1155003_010",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然在下一個人返鄉時，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也總是收到許多東西……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但這次",
    "voice": "vo_adv_1155003_011",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是與主公大人你們一起回來，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以各位村民，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像也比平常還要更熱忱呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "平常總是",
    "voice": "vo_adv_1155003_012",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下照顧主公大人，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒想到會在主公大人面前展現出",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被像孩童般對待、受到照顧的樣貌……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身為主公大人的隨從，",
    "voice": "vo_adv_1155003_013",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下感到",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有些不踏實。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然成功完成了精靈的進化儀式，",
    "voice": "vo_adv_1155003_014",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "於村中",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "仍算是年幼的一輩。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在周遭自幼照顧在下的",
    "voice": "vo_adv_1155003_015",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大人眼中，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "仍認為在下還跟小孩或小孫女一樣……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然在下",
    "voice": "vo_adv_1155003_016",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也經歷過了許多事，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "認為自己有所成長，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但以實際年齡而言，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎還無法被當成大人對待呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1155003_017",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說的沒錯。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這眾多禮物，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位擔心在下的證明吧……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "既然如此，",
    "voice": "vo_adv_1155003_018",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了讓各位能打從心底安心地為我們送別，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n同時當作這場歡送會的謝禮，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就請他們觀看在下成長後的樣貌吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能獲得如此肯定的讚賞，",
    "voice": "vo_adv_1155003_019",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常感謝您。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人能在一旁守候，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也十分安心。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……各位，",
    "voice": "vo_adv_1155003_020",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是否能給在下一些時間呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "要做什麼呀？",
    "voice": "vo_adv_1155003_021",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天",
    "voice": "vo_adv_1155003_022",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位替在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "舉辦了這場歡送會，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "著實感謝。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也請讓在下",
    "voice": "vo_adv_1155003_023",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n表達一點感謝的心意給各位。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了能讓各位安心地送別，",
    "voice": "vo_adv_1155003_024",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請讓在下誠心誠意地",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "獻上感謝的祝福。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請各位",
    "voice": "vo_adv_1155003_025",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "務必看到最後。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……狂風之精靈啊。",
    "voice": "vo_adv_1155003_026",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請以溫柔的恩惠之息，",
    "voice": "vo_adv_1155003_027",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "撫觸同胞們的臉頰吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "哦哦……！",
    "voice": "vo_adv_1155003_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "這就是",
    "voice": "vo_adv_1155003_029",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "進化之後的精靈啊……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "長大了……",
    "voice": "vo_adv_1155003_030",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "可可蘿她真的長大了呢……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1155003_031",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n各位",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看起來都很開心，真是太好了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……哎呀？",
    "voice": "vo_adv_1155003_032",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有位沒見過的精靈也聚過來了呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這幼小的精靈，",
    "voice": "vo_adv_1155003_033",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n並不是在下召喚來的……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是怎麼回事呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……！",
    "voice": "vo_adv_1155003_034",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那孩子是……",
    "voice": "vo_adv_1155003_035",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n該不會",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是在那之後……？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此。",
    "voice": "vo_adv_1155003_036",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "身為他所憧憬的對象，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下可必須完美達成這個職責才行。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n絕不能",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "背叛那時對他所說的話呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1155003_037",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐、",
    "voice": "vo_adv_1155003_038",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n共同生活、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "共同跨越困難，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n共同分享無數喜悅的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "家人羈絆……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【破曉之星】的各位……",
    "voice": "vo_adv_1155003_039",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不顧危險趕來，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那充滿勇敢與",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "溫柔的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "閃耀羈絆……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及……",
    "voice": "vo_adv_1155003_040",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n比起任何事物都還要重要，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無可取代的在下的主公大人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下於此刻，",
    "voice": "vo_adv_1155003_041",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再次打從心底感受到",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n能這樣與您並肩的幸福。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從這個村子",
    "voice": "vo_adv_1155003_042",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "孤身一人踏上旅程，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到遙遠的蘭德索爾……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下能找到",
    "voice": "vo_adv_1155003_043",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自己的歸屬，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都要歸功於",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與各位所構築的羈絆。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然後，",
    "voice": "vo_adv_1155003_044",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是因為有著奉獻此身也無怨無悔的夥伴，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下才能",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成長得如此堅強、善良。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與各位共同築起的羈絆……",
    "voice": "vo_adv_1155003_045",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對在下而言，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那正是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "至高的祝福。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由那祝福所獲得的力量，",
    "voice": "vo_adv_1155003_046",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要對這個故鄉報恩。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "狂風之精靈啊！",
    "voice": "vo_adv_1155003_047",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請用流轉不止的羈絆之風，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "守護這座村子吧！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1155003_048",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "嗚嗚……",
    "voice": "vo_adv_1155003_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "明明彷彿到昨天為止都還是個吸著奶嘴的孩子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n竟然已經在不知不覺間變得這麼優秀了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "在王都成長到能獨當一面了呢……",
    "voice": "vo_adv_1155003_050",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "我們",
    "voice": "vo_adv_1155003_051",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "應該已經不用再替她擔心了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "……畢竟",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "她有了重要的夥伴。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "好的。",
    "voice": "vo_adv_1155003_052",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "既然主人是{0}先生的話，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n可可蘿的未來肯定會很幸福的。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "今後也要請你",
    "voice": "vo_adv_1155003_053",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "成人1",
    "words": "多照顧可可蘿了！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "呼……",
    "voice": "vo_adv_1155003_054",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "呼……",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……方才的精靈，",
    "voice": "vo_adv_1155003_055",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是您召喚出來的吧？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是、",
    "voice": "vo_adv_1155003_056",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是的。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "在那之後，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我把我的想法全都跟父母說了。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "在那之後，",
    "voice": "vo_adv_1155003_057",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "雖然不知道是為什麼……",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我就覺得",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "現在的話精靈應該會回應我。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "然後嘗試之後，",
    "voice": "vo_adv_1155003_058",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我真的就成功跟精靈締結契約了！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "精靈回應我的感情，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "把力量借給我了！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1155003_059",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這肯定",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是您的心之風向",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "改變了的關係吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "平常而言，",
    "voice": "vo_adv_1155003_060",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並沒有辦法看見精靈的姿態。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈總是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "守候在我們的身邊。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以，",
    "voice": "vo_adv_1155003_061",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您一個人勤奮修行的努力，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n肯定也被那個精靈",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看在眼裡。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是這樣子啊……！",
    "voice": "vo_adv_1155003_062",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "雖然還不能自在地驅使……",
    "voice": "vo_adv_1155003_063",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n但我想為可可蘿小姐的啟程",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "獻上祝福。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我認為那就是……",
    "voice": "vo_adv_1155003_064",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n這樣的我，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "也能在身為村子裡的精靈族的現在",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "所能辦到的職責。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您成功地",
    "voice": "vo_adv_1155003_065",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "完成了那個職責呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您那想要激勵人的溫暖心意，",
    "voice": "vo_adv_1155003_066",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實地傳達到了",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的心中。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "太好了……！",
    "voice": "vo_adv_1155003_067",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我會繼續努力，",
    "voice": "vo_adv_1155003_068",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "將來總有一天",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "要追上可可蘿小姐！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "然後，",
    "voice": "vo_adv_1155003_069",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我想為了我們的故鄉",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "跟在未來等著我的夥伴們，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n變得能夠善用力量！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是您，",
    "voice": "vo_adv_1155003_070",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定沒問題的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "欸，",
    "voice": "vo_adv_1155003_071",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "可可蘿～！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "來這邊～！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "再多說一些蘭德索爾的事",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "成人2",
    "words": "給我們聽！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "妳主人也在等妳喔──！",
    "voice": "vo_adv_1155003_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n說些能讓我這老人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "也能振奮起來的冒險故事吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的，",
    "voice": "vo_adv_1155003_073",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然沒問題。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那確實是……",
    "voice": "vo_adv_1155003_074",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與【美食殿堂】的各位",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n前往名為瑪爾傑海岸的海時所發生的事──",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "圍繞著可可蘿的歡送會",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣直到深夜都十分熱鬧。",
