  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哇啊，",
    "voice": "vo_adv_1245002_041",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好驚訝♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來我會流淚呢～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我自從懂事以來，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就不記得自己有哭過。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真有趣。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……雖然我畫的同人誌有被人二次創作過，",
    "voice": "vo_adv_1245002_042",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但這是第一次",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有人為我自己畫漫畫……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而且，",
    "voice": "vo_adv_1245002_043",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "或許是你",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那份純粹的心意令我感到很開心。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以我才會流淚吧♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……這個世界很扭曲，",
    "voice": "vo_adv_1245002_044",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n有許多令人感到憤怒的事情。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "即使如此……",
    "voice": "vo_adv_1245002_045",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也還是有許多",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "開心的事情。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是多虧你，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才讓我重新想起了重要的事情，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "謝謝♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "收到了好棒的東西呢☆",
    "voice": "vo_adv_1245002_046",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這部作品",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會珍惜的♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "既然收到了這麼棒的禮物，",
    "voice": "vo_adv_1245002_047",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我也得好好回禮才行呢♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不～行，",
    "voice": "vo_adv_1245002_048",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這種時候應該要坦率地收下才對～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "包含你至今當漫畫助手的謝禮在內，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我總有一天會好好回禮給你的，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "請你好好等著喔☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要送你什麼呢～？",
    "voice": "vo_adv_1245002_049",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n像是給你和雪菲兩人",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "各一套同款的漫畫用具，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你覺得這如何？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟【美食殿堂】有兩位前途光明的未來的漫畫家呀♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還是說，",
    "voice": "vo_adv_1245002_050",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要送其他東西呢？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……不過",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這些",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "之後再來想就行了吧☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": "vo_adv_1245002_051",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然多虧了你的同人誌，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n讓我深深體會了過除夕的氣氛……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但也來做些其他",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有除夕氣氛的活動吧♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "比如說……",
    "voice": "vo_adv_1245002_052",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "吃跨年蕎麥麵！",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_1245002_053",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "去請廚師幫我們做吧☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n一起悠閒",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "放鬆地",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "享受除夕吧♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，帆稀與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起享用美味的跨年蕎麥麵，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並充分地體驗了過除夕的氣氛。",
    "voice": null,
    "unit_id": null
  }
]
