[
  {
    "type": "background",
    "bg_id": "501880"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "除夕，這天是為一整年劃下尾聲的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n帆稀與{0}依舊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n作為小老闆娘與小老闆在手腳俐落地工作著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──呼～",
    "voice": "vo_adv_1245002_000",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大掃除",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "結束了♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n像是擦地板、擦窗戶等等，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你也打掃了很多地方，辛苦了☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "環境變得相當整潔明亮呢～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然，",
    "voice": "vo_adv_1245002_001",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "由於旅館不僅大還正在營業，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以有約九成，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都是用我的魔法迅速打掃乾淨的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但是，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "如果不多少自己親手打掃，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就沒情調了呢♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": "vo_adv_1245002_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "順帶一提，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們的據點早就大掃除完囉☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "主要都是讓祈梨打掃的♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "人懷著真心打掃乾淨的房間，",
    "voice": "vo_adv_1245002_003",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n比起用魔法整理的房間，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "感覺住起來更舒服不是嗎？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這是心情上的問題，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "先不說這些……",
    "voice": "vo_adv_1245002_004",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大掃除已經結束了，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n工作方面目前也沒那麼忙了。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n暫時有點空閒了呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……像這樣",
    "voice": "vo_adv_1245002_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "稍微閒下來後，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就開始有種今年真的即將結束的感覺呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "除夕",
    "voice": "vo_adv_1245002_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n如果是平時，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我就會去買同人誌之類的了。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯。",
    "voice": "vo_adv_1245002_007",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖是這麼說，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但那是我在現實世界時的事情。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n現實世界在除夕時，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會舉辦大規模的同人誌販售會。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "以這裡來比喻的話，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就類似蘭祭吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我呀，",
    "voice": "vo_adv_1245002_008",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "經常會去參加那個活動♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我沒有參加社團就是了。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我的同人誌",
    "voice": "vo_adv_1245002_009",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都只會用寄售的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我每次都是",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "作為一般參加者參加活動的～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n真懷念……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……啊啊，",
    "voice": "vo_adv_1245002_010",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n在「米奈娃的禁錮」",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "之前舉辦的那場活動，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我好像因為太忙沒時間參加。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "早知道就去參加了……",
    "voice": "vo_adv_1245002_011",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在發生這種事情後，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n《阿斯特朗傳奇》的同人誌",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該會急遽減少吧。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唔～嗯……",
    "voice": "vo_adv_1245002_012",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這個嘛～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n雖然也不是說只要是同人誌就什麼都可以……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但如果是有趣的作品，我應該會想看。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "身為漫畫家，",
    "voice": "vo_adv_1245002_013",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該要多接觸各種作品，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n盡量充實自己的知識才行呀☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……",
    "voice": "vo_adv_1245002_014",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你果然",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都會想些有趣的事呢～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而且，",
    "voice": "vo_adv_1245002_015",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在旅館畫漫畫這種想法，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n說不定",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還滿合乎道理的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在現實世界中，",
    "voice": "vo_adv_1245002_016",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也有人是在閉關在旅館中完成原稿的呀。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這裡或許是個",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "能專心作業的好地方呢♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "既然都這麼決定了，",
    "voice": "vo_adv_1245002_017",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我幫你準備空客房，當你作業用的房間喔☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你可以",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在那裡",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "盡情地作畫♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……啊，",
    "voice": "vo_adv_1245002_018",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對了，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我說不定想到了好點子。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你在作業時，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會去確認你的進度喔♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要讓作品完成，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有人督促和遵守期限很重要呀☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": "vo_adv_1245002_019",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你要加油喔？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我很期待你會創作出",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "什麼樣的作品♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "background",
    "bg_id": "501890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──數小時過後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "辛苦了～☆",
    "voice": "vo_adv_1245002_020",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我拿了點東西來給你吃♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有順便",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "讓我確認一下你的進度吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哦哦，",
    "voice": "vo_adv_1245002_021",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你這真是誇下海口了呢～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "居然只靠一天就要完成同人誌，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一般來說這是很魯莽的行為……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你或許做得到呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但是",
    "voice": "vo_adv_1245002_022",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要獨自畫漫畫，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這還是會很辛苦吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我也來幫你忙吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "無論是塗黑、貼網點我都會，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n當然",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就算是畫背景，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我也能做得很完美喔。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喔……",
    "voice": "vo_adv_1245002_023",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n既然你都這麼說了，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我相信你一定沒問題吧。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": "vo_adv_1245002_024",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會拭目以待的☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n請你繼續努力",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "完成原稿的作業，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會替你加油的♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──又過了數小時後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呀呼～☆",
    "voice": "vo_adv_1245002_025",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n小老闆娘的工作",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "暫時告一段落了，所以我又來了♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你在那之後的",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "進度如何呢？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哦哦，",
    "voice": "vo_adv_1245002_026",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真佩服～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒想到",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你真的",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "花不到幾個小時，就畫好同人誌了……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n雖說照你的畫風是能畫得比較快，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但還是很令人驚訝♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟",
    "voice": "vo_adv_1245002_027",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你為了解決大家的煩惱，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n每天",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要跑行程可是異常地滿呀。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以就算是漫畫，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你也能以這個速度來畫好啊。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_1245002_028",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "謝謝☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我馬上來讀讀看囉♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "still",
    "still_id": "124500201"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喔……",
    "voice": "vo_adv_1245002_029",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這是……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你將我們之間的回憶畫成漫畫了？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "和我第一次相遇時的事，",
    "voice": "vo_adv_1245002_030",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有大家一起在艾爾皮斯島探索的事……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哼哼。",
    "voice": "vo_adv_1245002_031",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "下一頁是",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "書中世界的故事啊。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n討伐賈巴沃克當時，我幾乎都只在旁邊看，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但很有趣呢～☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "透過希望的力量來戰鬥的橋段，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我並不討厭喔♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有這是……",
    "voice": "vo_adv_1245002_032",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "時間儀失控時的故事呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……哼～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我當時去幫助你們，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n讓你覺得我非常帥啊？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這挺讓人開心的呢♪",
    "voice": "vo_adv_1245002_033",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你如果又遇上什麼麻煩，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我基本上都會去幫你的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我很喜歡這周次的一切……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也不希望事到如今還要重新輪迴呀☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊。",
    "voice": "vo_adv_1245002_034",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我支援化身為怪盜的步未和祈梨，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這你也畫成漫畫了啊，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n那時候也很開心呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "下次我也",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "想當當看",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "怪盜呢♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哦，",
    "voice": "vo_adv_1245002_035",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "連你來幫我畫漫畫的橋段都畫出來了呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n對你來說，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "當漫畫助手有讓你這麼印象深刻嗎？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來你是這麼想的啊？",
    "voice": "vo_adv_1245002_036",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "謝謝♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我也覺得",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "和你一起畫漫畫很開心喔☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……還有這本同人誌中",
    "voice": "vo_adv_1245002_037",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n充滿了許多開心的回憶呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不知不覺間，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我和你已經有了這麼多的回憶啊。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_1245002_038",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你的畫給人溫馨的感覺，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以不管打開哪一頁，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都會令人感到心暖暖的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……真的、",
    "voice": "vo_adv_1245002_039",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真的，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n每個故事都好令人懷念……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好開心呢……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "still",
    "still_id": "124500202"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──",
    "voice": "vo_adv_1245002_040",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這是……",
    "voice": null,
    "unit_id": 124511
  },
