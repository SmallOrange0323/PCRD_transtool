[
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "愛梅斯一如往常地關注著{0}一行人的動向。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而意料之外的某種東西正悄悄逼近她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哼。",
    "voice": "vo_adv_5152000_000",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n{0}真是的，又要去海邊呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "又是什麼委託嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正肯定是和平時一樣，",
    "voice": "vo_adv_5152000_001",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想趁著委託順便大玩一番吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真搞不懂那種又鹹又大片的水窪到底有哪裡好了？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n人類這種生物還真是不可思議啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然也正因如此，",
    "voice": "vo_adv_5152000_002",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我才會想了解他們。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──真的是，",
    "voice": "vo_adv_5152000_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "意見相同呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──",
    "voice": "vo_adv_5152000_004",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "領域……",
    "voice": "vo_adv_5152000_005",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正受到干擾！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不行，",
    "voice": "vo_adv_5152000_006",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會被覆蓋過去……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "movie",
    "movie_id": "515200001"
  },
  {
    "type": "background",
    "bg_id": "502340"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳說妳是……",
    "voice": "vo_adv_5152000_007",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "強欲的魔女，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "艾姬多娜？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "請多指教。",
    "voice": "vo_adv_5152000_008",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不是，",
    "voice": "vo_adv_5152000_009",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼請多指教啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以這麼形跡詭異的方式登場，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n怎麼可能有什麼好指教的啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "被這麼直接地說很詭異，我好受傷啊。",
    "voice": "vo_adv_5152000_010",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如妳所見，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我可是纖弱的少女喔？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這什麼滿溢而出的可疑感。",
    "voice": "vo_adv_5152000_011",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "完全就是不能放鬆警戒的類型嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀，",
    "voice": "vo_adv_5152000_012",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想說要讓妳安心，反而導致妳閉口不言了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我本來",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還想多跟妳聊聊的。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──畢竟",
    "voice": "vo_adv_5152000_013",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是難得一見的「異世界」呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "異世界……",
    "voice": "vo_adv_5152000_014",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這傢伙……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n和先前來的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那些傢伙",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有所關聯嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "老實說，",
    "voice": "vo_adv_5152000_015",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我有很多事想問妳，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但總覺得不該和妳有太多的對話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "向冠有強欲之名的傢伙提問，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可不是個好主意。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "妳不用這麼提防我。",
    "voice": "vo_adv_5152000_016",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就如同剛才說過的，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我是纖弱的──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_5152000_017",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就問妳一件事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳的目的是什麼？",
    "voice": "vo_adv_5152000_018",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就如自我介紹時所說的，",
    "voice": "vo_adv_5152000_019",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我很貪婪呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就只是想要知道這個世界的事情而已。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為了消除妳的不安，我就直接明說吧。",
    "voice": "vo_adv_5152000_020",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──我不是敵人喔。",
    "voice": "vo_adv_5152000_021",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5152000_022",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這樣妳有比較放心了嗎？",
    "voice": "vo_adv_5152000_023",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一點都沒有呢。",
    "voice": "vo_adv_5152000_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我知道妳不是會突然就大打出手的傢伙了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好吧，",
    "voice": "vo_adv_5152000_025",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就陪陪妳吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n與妳來段有趣的對話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真是太開心了呢。",
    "voice": "vo_adv_5152000_026",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "能在異世界與未知邂逅──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我的內心好雀躍啊。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可不能讓這樣來歷不明的傢伙離開我的視線。",
    "voice": "vo_adv_5152000_027",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n如果我能夠在這裡把她擋住，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就再好不過了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺我這樣的想法也被她看透了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "跟麻煩事扯上關係了啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不管怎麼說。",
    "voice": "vo_adv_5152000_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n似乎又要交會了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n與來自異世界的來訪者──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "movie",
    "movie_id": "515200002"
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你很吵啊，巴魯斯。",
    "voice": "vo_adv_5152000_029",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n快去拿新的飲料來。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "還真是會使喚人的姊姊啊！",
    "voice": "vo_adv_5152000_030",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我也是正值青春的男孩子！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我也想去玩啊！？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "夏天！",
    "voice": "vo_adv_5152000_031",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "大海！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "在海邊嬉戲的愛蜜莉雅醬！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n這可是",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "人人夢寐以求的夏日假期！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "「夏日佳期」？",
    "voice": "vo_adv_5152000_032",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我不太懂你在說什麼。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "在海邊嬉戲的昴，",
    "voice": "vo_adv_5152000_033",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "好可愛……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "但是他看莉雅的眼神讓人有～點無法接受呢。",
    "voice": "vo_adv_5152000_034",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "要不要讓他變成冰塊",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "在休息處冰鎮一下？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那會死人的啊！？",
    "voice": "vo_adv_5152000_035",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "而且我才沒有用那種猥瑣的視線看著……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是說就算有一點也沒有辦法──",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哎呀，",
    "voice": "vo_adv_5152000_036",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你的手指間有縫隙呢，巴魯斯。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n真是下流。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳，",
    "voice": "vo_adv_5152000_037",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就算這樣也不要突然戳眼睛啊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵。",
    "voice": "vo_adv_5152000_038",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "大家，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "看起來都好～開心。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可是……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這個樣子沒問題嗎。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這裡……",
    "voice": "vo_adv_5152000_039",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n自從我們來到阿斯特賴亞大陸，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "都已經過了相當長的時間了。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "說的也是……",
    "voice": "vo_adv_5152000_040",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n透過之前獲得的「福音書」",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "和碧翠絲小姐取得聯絡後，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "應該已經找到了回去的辦法才對……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那時候的我，",
    "voice": "vo_adv_5152000_041",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "還說了「",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就算明天可能會回去，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也要向今天的我們舉杯」",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這種話。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是丟人現眼。",
    "voice": "vo_adv_5152000_042",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "來到了別的世界，竟然還玷汙羅茲瓦爾大人的顏面。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你去死吧。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "姊姊妳對我不會有點太嚴苛了嗎！？",
    "voice": "vo_adv_5152000_043",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳以為妳手上的那杯果汁",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是誰做的啊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這也是沒辦法的事。",
    "voice": "vo_adv_5152000_044",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n我之前也說過了，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "那裡和這裡似乎有時間上的落差。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "以前",
    "voice": "vo_adv_5152000_045",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "大精靈大人曾說過，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "「這裡的一天",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "在那邊可能是一分鐘」",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n這樣的話呢。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也就是說，",
    "voice": "vo_adv_5152000_046",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "如果碧翠子看了30分鐘的書，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "可能就過了30天是嗎。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "沒錯，",
    "voice": "vo_adv_5152000_047",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "如果貝蒂睡了一小時的午覺，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "就是60天呢。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喂喂喂喂。",
    "voice": "vo_adv_5152000_048",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n那樣的話，要是在碧翠子想把那頭豎捲髮換造型的日子……！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "說不定",
    "voice": "vo_adv_5152000_049",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "得要有耗上個幾年的心理準備呢～",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真是的，",
    "voice": "vo_adv_5152000_050",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你們不要鬧了。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n碧翠絲現在也在努力地",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "準備轉移……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "準備機遇門呀。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要連結完全不知道的地方和屋子。",
    "voice": "vo_adv_5152000_051",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這一定是很～辛苦的事。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "……也是呢。",
    "voice": "vo_adv_5152000_052",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過話雖如此，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就算愛蜜莉雅醬煩惱也沒有用啊。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n碧翠子正在努力。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這就是我們能回去的最快捷徑。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊……",
    "voice": "vo_adv_5152000_053",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "即便不是現在這樣的情況，",
    "voice": "vo_adv_5152000_054",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "平時的各種事情就已經很辛苦了。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我認為轉換心情",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也是很重要的事喔。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳看？",
    "voice": "vo_adv_5152000_055",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "大家看起來很開心吧？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n海邊就是像這樣，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "會讓大家露出笑容的地方。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n所以啊──",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅醬也",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "盡情地享受當下吧？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴……",
    "voice": "vo_adv_5152000_056",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "多麼深奧的話語……",
    "voice": "vo_adv_5152000_057",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真不愧是昴。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆深感佩服。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哼！",
    "voice": "vo_adv_5152000_058",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "反正只是巴魯斯自己想偷懶而已吧。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆可是一清二楚──",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "沒錯，",
    "voice": "vo_adv_5152000_059",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這裡是海邊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n這是和愛蜜莉雅醬共度夏日假期的機會！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是我夢寐以求的",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "異世界慢活人生！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "──巴魯斯。",
    "voice": "vo_adv_5152000_060",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你要發呆到什麼時候。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "咦？",
    "voice": "vo_adv_5152000_061",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "什麼……？",
    "voice": "vo_adv_5152000_062",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n有東西從海上",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "逐漸靠了過來？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "……又白、又大……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18511
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "鯨魚──────────！？",
    "voice": "vo_adv_5152000_063",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正當昴想要盡情享受夏日之時，巨大的鯨魚出現在他的眼前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n映照在鯨魚巨大眼眸裡的他，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聽到了異世界慢活人生之夢碎裂的聲音。",
    "voice": null,
    "unit_id": null
  }
]
