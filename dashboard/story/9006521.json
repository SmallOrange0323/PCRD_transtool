[
  {
    "type": "dialogue",
    "name": "無名的藝術",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14511
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "切、",
    "voice": "vo_adv_9006521_000",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "嚕──────！！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_9006521_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是怎麼回事？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很眼熟的難搞傢伙",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "居然手牽手搞合作。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n簡直是復活的強敵",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "夢幻同台。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是在演劇場版喔？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "巨大優妮藝品",
    "voice": "vo_adv_9006521_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "加上巨大優妮機器人──",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "本來聽說是討伐魔物，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但現在根本是優妮祭典嘛。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不要擅自舉辦敗壞人名聲的祭典。",
    "voice": "vo_adv_9006521_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我再重申一次，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那兩次事件我也是受害者。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "先不管那個，",
    "voice": "vo_adv_9006521_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼這兩個傢伙又學不乖復活了啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聽學長說，",
    "voice": "vo_adv_9006521_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好像是個年齡不明，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "叫作彌勒的斯文大叔，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n到處復活已經終結的災難。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呵～",
    "voice": "vo_adv_9006521_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真好笑，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那不是糟透了嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我可是一點都不想再見到這兩個傢伙。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "吵死了～",
    "voice": "vo_adv_9006521_007",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "禿頭。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n妳以為我們想看到妳們啊，",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "三個白癡。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啥？",
    "voice": "vo_adv_9006521_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你說什麼？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再說一次？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你這破銅爛鐵醜八怪，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "信不信我拿廢油灌你？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你被資源回收之後，個性還是一樣渣啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "它的個性，",
    "voice": "vo_adv_9006521_009",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好像是照克蘿依學姐設定的說。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "各位──！",
    "voice": "vo_adv_9006521_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n對、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起我來晚了，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也要加入戰鬥──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小碧！？",
    "voice": "vo_adv_9006521_011",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，不行，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳現在過來的話……！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "聊天功能──",
    "voice": "vo_adv_9006521_012",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "目標，",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "碧。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "糟了，",
    "voice": "vo_adv_9006521_013",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "碧，快做好準備！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n它們的聲波攻擊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會透過聽覺侵蝕目標的神經系統！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "無情的咒語會打擊心靈，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "讓妳瞬間喪失自我！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什麼！？",
    "voice": "vo_adv_9006521_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n它它它、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "它們會對我說什麼！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "公會走失兒童。",
    "voice": "vo_adv_9006521_015",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "【森林守衛】看家組。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "自虐和當笑柄是妳的精神安定劑。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n拚命三郎過氣諧星。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "妄想半裸露營者。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n每天舉辦無觀眾無轉播，",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "演給無機物看的個人Live。",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不、",
    "voice": "vo_adv_9006521_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不管用……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你說的……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我一點",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "都不在意……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "糟糕！",
    "voice": "vo_adv_9006521_017",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小碧雖然努力硬撐，但眼淚很明顯已經快潰堤了！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "碧，別哭，",
    "voice": "vo_adv_9006521_018",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳要嗆回去。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳不斷磨練的無形武器，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不就是要用在這種時候嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什、",
    "voice": "vo_adv_9006521_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什麼？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我有那種武器",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗆爆它，碧──",
    "voice": "vo_adv_9006521_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不對，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是MC BenYen。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "內心是狂風暴雨！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "Free Style鑽研徹底！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "麥克風所向披靡！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啥！？",
    "voice": "vo_adv_9006521_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在這種關頭，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我該不會要被迫表演自學的搞笑饒舌吧！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依，",
    "voice": "vo_adv_9006521_022",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "給她點伴奏。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "用妳超狂的",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "人聲節拍器引導她吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳是想說節奏口技吧？",
    "voice": "vo_adv_9006521_023",
    "unit_id": 110911
  },
  {
