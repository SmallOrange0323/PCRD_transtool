    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n破銅爛鐵！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "放尊重點！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "YO在那邊拿我說嘴！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n嗆聲虛得讓我掩面，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像盤番茄肉醬麵，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吃個幾口給你情面！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我這個人可是專業邊緣！",
    "voice": "vo_adv_9006521_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "隨時腦中開會砥礪自己勇敢向前！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "YO聽你老生常談重講一遍！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "膩得像盤培根蛋麵，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吃個幾口留你顏面！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "Yeah！",
    "voice": "vo_adv_9006521_027",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是嗆爆了！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就算是它們，這下子也回不了嘴──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "妳說妳邊緣？",
    "voice": "vo_adv_9006521_028",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "我聽妳在嘴！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "角色賣點早就崩毀！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n那間校舍？",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "那座工廠？",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "諒妳不敢Call人過來大團圓！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "認知障礙根本是無病呻吟！",
    "voice": "vo_adv_9006521_029",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "「沒朋友」只是方便妳找藉口逃避！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n缺乏的其實是手段和骨氣！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "一旦承認就得結束掰掰邊緣這個假議題！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n伸手就能抓住的蜃樓泡影！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "跨出那一步的勇氣到底在哪裡？",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "妳這屁孩就跟妳的名字一樣屁！",
    "voice": "vo_adv_9006521_030",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "所謂孤獨才不是妳自認為有的病！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n裝死躺平還好意思自號孤寂！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "只會裝熟最好拿得出認真的勇氣！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n「想交朋友」嘴巴說說怎麼可能有戲！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "勸妳早點放棄一輩子龜森林裡！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊啊啊啊啊啊啊──────！",
    "voice": "vo_adv_9006521_031",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不、",
    "voice": "vo_adv_9006521_032",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不妙！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n碧的腦波波動進入危險區域……！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n由於存在證明遭到否定，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她正在喪失內在的自我！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐，",
    "voice": "vo_adv_9006521_033",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳乘著好像很有一回事的節奏都說了些什麼啊！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這樣太超過了！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳還是不是人啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又不是我，",
    "voice": "vo_adv_9006521_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我百分之百是冤枉的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n而且音源根本是妳的聲音吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_9006521_035",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊啊啊啊─────！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "喔",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊啊啊─────！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳們看。",
    "voice": "vo_adv_9006521_036",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n以大叫反應多樣性著稱的碧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只發得出單調的音節……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這下傷得不輕啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哈、",
    "voice": "vo_adv_9006521_037",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哈哈……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n優花梨小姐～",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種菇類，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有彩虹女神的味道耶～",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n哇，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "純小姐盔甲底下，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來是宏觀大宇宙啊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不好了。",
    "voice": "vo_adv_9006521_038",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n因為腦內物質過度分泌，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "碧和神明跟宇宙建立起連結了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這樣下去，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她會知曉世間萬物一切的真理。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喂～",
    "voice": "vo_adv_9006521_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "碧～？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳還好嗎～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "趕快醒醒吧～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n要準備開始戰鬥囉～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃……",
    "voice": "vo_adv_9006521_040",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "克蘿依……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "早安……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n對了，妳聽我說，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我剛剛窺見了真理之門了──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各位，我們上！",
    "voice": "vo_adv_9006521_041",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n讓我們閉上不停口出惡言的機器，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "還有旁邊那尊前衛泥巴人偶的嘴！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "使出全力，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "跟我來──！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊──！",
    "voice": "vo_adv_9006521_042",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請等一下，我也要幫忙～！！",
    "voice": null,
    "unit_id": 104011
  }
]
