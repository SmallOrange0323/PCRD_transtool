    "voice": "vo_adv_1049011_031",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "魔法喔。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說是這麼說，",
    "voice": "vo_adv_1049011_032",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "其實是我剛剛才想到的。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你嚇了一跳嗎？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你眨眼睛的樣子",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真可愛～☆",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……或許沒有什麼效果，",
    "voice": "vo_adv_1049011_033",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "裡面充滿了姐姐的愛喔♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的嗎！？",
    "voice": "vo_adv_1049011_034",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐的愛",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然勝過所有藥呢♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊！",
    "voice": "vo_adv_1049011_035",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那再多親幾下，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "搞不好效果會更好呢！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐的愛是即效性的～♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？",
    "voice": "vo_adv_1049011_036",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "已經夠了？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為什麼～！？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呼。",
    "voice": "vo_adv_1049011_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛還真是驚險呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我強制讓你睡著，",
    "voice": "vo_adv_1049011_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n讓你稍微梳理一下記憶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次你之所以會身體不舒服，",
    "voice": "vo_adv_1049011_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是因為你的記憶受到過度的刺激。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你太想嘗試回想起\\n靜流口中的「從前的弟弟」，",
    "voice": "vo_adv_1049011_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "給大腦和身體造成負擔了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，就像以往那樣。",
    "voice": "vo_adv_1049011_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你很快就會忘記在這裡發生過的事情。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n包含這次",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "帶來負擔的記憶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這麼一來，你身體方面的不適就會舒緩了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次或許是靜流的行動太過草率了。",
    "voice": "vo_adv_1049011_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她太急著採取行動了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過……",
    "voice": "vo_adv_1049011_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我也沒有辦法",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "譴責她的行為。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想奪回失去的東西，",
    "voice": "vo_adv_1049011_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n任誰都會有這種想法──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就連我也一樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "靜流",
    "voice": "vo_adv_1049011_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n想必是得消沉一段時間了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該做什麼才好，",
    "voice": "vo_adv_1049011_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你應該很明白吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "吶，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她最寶貝的弟弟。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我能說的也只有這些了。",
    "voice": "vo_adv_1049011_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "睡一整天也很無聊吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "快點醒過來吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就這樣，",
    "voice": "vo_adv_1049011_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜拜。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n保重啊",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500123"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯……",
    "voice": "vo_adv_1049011_049",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "哇啊！",
    "voice": "vo_adv_1049011_050",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n糟糕，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我睡著了……！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "總覺得",
    "voice": "vo_adv_1049011_051",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "作了一個很令人懷念的夢……",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不對，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我完全想不起來。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "先不說這個了，",
    "voice": "vo_adv_1049011_052",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1049011_053",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "太好了，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你退燒了。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n呼吸也和平時一樣平穩，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好像穩定多了……！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗚～",
    "voice": "vo_adv_1049011_054",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我終於能放心了……",
    "voice": null,
    "unit_id": 104911
  },
