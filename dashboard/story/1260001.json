[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "趁著在背面世界冒險的空檔時間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n暫時返回蘭德索爾的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和可璃亞一起走在小巷子裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵呵，",
    "voice": "vo_adv_1260001_000",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n好期待啊～♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊……",
    "voice": "vo_adv_1260001_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不小心就高興到小跳步起來了，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好害羞……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……可是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我真的很興奮。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "因為接下來，",
    "voice": "vo_adv_1260001_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就要開始我的第一份打工了……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我想說",
    "voice": "vo_adv_1260001_003",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在空閒的時間裡賺點錢，拿來貼補伙食費……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "而且也想累積一些社會經驗，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以才找哥哥商量了短期打工的事。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但是沒想到哥哥居然也會來跟我一起打工。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我覺得非常高興，",
    "voice": "vo_adv_1260001_004",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n而且也放心了許多……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這樣不會給你添麻煩嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵，",
    "voice": "vo_adv_1260001_005",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "聽你這麼說我就放心了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那麼哥哥，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "小女子不才，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還請你多多指教囉♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……啊，",
    "voice": "vo_adv_1260001_006",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n興奮起來，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就忘記問最重要的事了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥幫我找的是什麼打工啊？",
    "voice": "vo_adv_1260001_007",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "像是花店之類的？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "或是可愛的生活雜貨店好像也很棒……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哇啊，",
    "voice": "vo_adv_1260001_008",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原來是餐廳！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我對",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "做菜和做家事稍微有點自信，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n如果是備料",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "或洗碗之類的，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我應該能夠幫上忙♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "順便問一下，",
    "voice": "vo_adv_1260001_009",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥有去過那間餐廳嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "你說雖然沒去過，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但感覺是間好餐廳……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這就是那間餐廳的招募傳單啊……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我看看。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "「氣氛活潑、",
    "voice": "vo_adv_1260001_010",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "充滿歡笑的職場☆」",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……上面是這麼寫的耶！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "似乎真的是間好餐廳，好令人期待呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……啊！",
    "voice": "vo_adv_1260001_011",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是那間店對吧！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們快過去吧♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "呀～哈～哈～！！",
    "voice": "vo_adv_1260001_012",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n在大白天喝的麥酒真是太好喝啦～～～！！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "嘎哈哈……！",
    "voice": "vo_adv_1260001_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "看你那囂張的眼神，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "挺有意思的嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n我看",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "你是想被揍對吧！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞3",
    "words": "嘻嘻～！！",
    "voice": "vo_adv_1260001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞3",
    "words": "打架了、打架了！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞3",
    "words": "\\n就來賭賭看你們誰會贏吧～！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "…………",
    "voice": "vo_adv_1260001_015",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……呃，",
    "voice": "vo_adv_1260001_016",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這是……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哦哦……！",
    "voice": "vo_adv_1260001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們是來應徵短期打工的人對吧……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我等好久了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真的等好久了……！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "快救救我！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_1260001_018",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們好像走錯店了～",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "先告辭了……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "等一下，不要走啊！！",
    "voice": "vo_adv_1260001_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們沒有走錯！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n妳手上拿的那張傳單，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就是我們這裡發的！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦……",
    "voice": "vo_adv_1260001_020",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可是你們店裡跟上面寫的完全不一樣耶……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "你看這張傳單。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n上面寫著「氣氛活潑、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "充滿歡笑的職場☆」",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "地痞們",
    "words": "「呀哈哈～！！」\\n「嘎哈哈……！！」\\n「嗚嘻嘻～！！」",
    "voice": "vo_adv_1260001_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……沒說錯吧？",
    "voice": "vo_adv_1260001_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n的確是充滿了",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "歡笑聲對吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原來是指那種的歡笑聲嗎！！？",
    "voice": "vo_adv_1260001_023",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "內容寫得容易讓人誤會真的很抱歉！！",
    "voice": "vo_adv_1260001_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n……可是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "正如你們所見，我們這裡成了地痞的聚集地，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n連想找個工讀生都很困難……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "求求你們不要走啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可、",
    "voice": "vo_adv_1260001_025",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可是。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就算你這麼說……",
    "voice": null,
    "unit_id": 126012
  },
  {
