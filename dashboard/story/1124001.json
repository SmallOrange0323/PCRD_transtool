  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是{0}\\n和【new generations】的三人相遇前的故事——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個，",
    "voice": "vo_adv_1124001_000",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "小凜。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我今天想去一趟公會管理協會，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n有什麼需要我先幫忙詢問的事情嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "管理協會……",
    "voice": "vo_adv_1124001_001",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "啊，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是要去蒐集情報呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就打聽一下其他公會的動向吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "搞不好",
    "voice": "vo_adv_1124001_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "能掌握意料之外的情報也說不定。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不過，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果太勉強的話，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "調查看看現有的委託就好了喔。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "其他公會的動向和委託，",
    "voice": "vo_adv_1124001_003",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對吧。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那我出發了！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "哎呀小卯月，",
    "voice": "vo_adv_1124001_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "歡迎妳呀。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "是要來接委託的嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "您好！　",
    "voice": "vo_adv_1124001_005",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我是來看看今天是不是有新的委託。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "請問還沒刊登的委託裡，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有沒有比較推薦的呢？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "好的，",
    "voice": "vo_adv_1124001_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "我看看。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "還沒刊登的委託在這邊～",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "不過好像都不太適合委託小卯月的樣子呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦，",
    "voice": "vo_adv_1124001_007",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是這樣嗎？　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嗯……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "如果不是給我，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "例如說，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是委託給小凜的話呢？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "啊～",
    "voice": "vo_adv_1124001_008",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "小凜的話身手不錯應該是可以。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "那再加上這個……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "來，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "新委託的一覽表。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n有想要接的隨時跟我說吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好的，",
    "voice": "vo_adv_1124001_009",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "非常感謝您！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有很多都寫著「募集精銳冒險者」呢。",
    "voice": "vo_adv_1124001_010",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我應該派不太上用場……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "的確，",
    "voice": "vo_adv_1124001_011",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "內容似乎都有點困難的樣子。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我好像幫不上什麼忙，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有點可惜。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "嗯……",
    "voice": "vo_adv_1124001_012",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "啊，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "對了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "這樣的話妳能接下我個人的委託嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n因為用品用完了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "想請妳幫忙跑個腿。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "讓我來",
    "voice": "vo_adv_1124001_013",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n可是跑腿的話，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不是都交由這裡的員工嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "其實啊，",
    "voice": "vo_adv_1124001_014",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "平常拜託的那孩子身體不適所以正在休息呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "而我不能離開工作崗位所以想請妳幫忙，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好的，",
    "voice": "vo_adv_1124001_015",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "當然沒問題！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不嫌棄的話，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "請讓我幫忙吧。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "謝謝妳，",
    "voice": "vo_adv_1124001_016",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "這是採買的清單。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n不是很緊急，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "慢慢來就好了喲。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "早安——",
    "voice": "vo_adv_1124001_017",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "啊，小卯月。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n妳接了什麼委託嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "妳好！　",
    "voice": "vo_adv_1124001_018",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "現在正好要出發去採買。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n各位",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是過來接什麼委託的嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "我們是有其他事情要辦。",
    "voice": "vo_adv_1124001_019",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "先前拜託您的這個，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "能幫我們在協會找個地方貼起來嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "好的。",
    "voice": "vo_adv_1124001_020",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "感覺終於要冒險者畢業了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "有點寂寞呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦，",
    "voice": "vo_adv_1124001_021",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "冒險者畢業！？　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "哈哈哈，",
    "voice": "vo_adv_1124001_022",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "並不是有什麼變故啦。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "之前我們同伴之間",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "討論過好幾次了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n我們想釐清自己真正想做的事。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "雖說也不是對冒險者有所不滿，",
    "voice": "vo_adv_1124001_023",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "大概是討厭這種沒有目標",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "的感覺吧。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "所以，",
    "voice": "vo_adv_1124001_024",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "我們就順其自然地放棄當冒險者，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "並且決定今後要作為街頭藝人公會展開活動！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "哇，",
    "voice": "vo_adv_1124001_025",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好厲害！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "從冒險者到街頭藝人，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是跟以前截然不同的公會活動呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "啊哈哈，",
    "voice": "vo_adv_1124001_026",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "確實是如此呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "會覺得街頭藝人不錯，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "\\n也是因為不小心接錯委託不得以去嘗試的工作。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "不過",
    "voice": "vo_adv_1124001_027",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "多虧如此，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我們查覺到自己「想讓人們綻放笑容」的心情。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "比起冒險者，這方面好像更適合我們。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "這個，",
    "voice": "vo_adv_1124001_028",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "是下次表演的傳單。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "小卯月和朋友有空的話就來看看吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好的，",
    "voice": "vo_adv_1124001_029",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "當然沒問題。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "謝謝你們！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "唔，",
    "voice": "vo_adv_1124001_030",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這些就是所有該買的東西了……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "花了好多的時間在找，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "要快點回去才行——",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "哎呀，",
    "voice": "vo_adv_1124001_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊。",
    "voice": "vo_adv_1124001_032",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對不起，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不小心撞到……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊！？　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那是，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我的包包！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "請等一下——！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "該不會是搶劫！？　",
    "voice": "vo_adv_1124001_033",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "怎、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "怎麼辦……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n那個人腳程好快……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這樣下去追不上的……！　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "誰、",
    "voice": "vo_adv_1124001_034",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "誰可以幫幫我！　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個人，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是強盜——！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n請抓住他，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "拜託請抓住他——！！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "什麼！？　",
    "voice": "vo_adv_1124001_035",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "覺悟吧……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "看招——！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "嗚啊！",
    "voice": "vo_adv_1124001_036",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "　放、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "放開！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "快給我放開，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "混蛋！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "呼……",
    "voice": "vo_adv_1124001_037",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "呼……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "真的很謝謝你……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "不用放在心上，",
    "voice": "vo_adv_1124001_038",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "這種時候就交給我這樣的人吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店裡的大叔",
    "words": "像小妹妹這樣的女孩子可不能亂來啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嗚嗚……",
    "voice": "vo_adv_1124001_039",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "人家",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好歹也算是個冒險者……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "結果比商店的大叔還靠不住……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "——因為發生這樣的事，",
    "voice": "vo_adv_1124001_040",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "所以回來晚了，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對不起！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "沒事沒事，",
    "voice": "vo_adv_1124001_041",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "我說過不用急的嘛。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "東西也都有好好買回來了，別在意唷。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "只是，",
    "voice": "vo_adv_1124001_042",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "雖然就結果來說是順利解決了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n但去追強盜可是很危險的喔？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦？　",
    "voice": "vo_adv_1124001_043",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n採買用的包包被搶走了，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不能就那樣不管……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "我舉例來說好了。",
    "voice": "vo_adv_1124001_044",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "比方說在強盜逃走的方向上，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n有同夥埋伏著……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "像這種事也是有可能發生的吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊……",
    "voice": "vo_adv_1124001_045",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "聽您這麼說確實是這樣呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n當時只想著得先追上去，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "所以沒想得那麼多。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "妳很努力想幫忙的心情我很開心。",
    "voice": "vo_adv_1124001_046",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "可是",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "最重要的是",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "妳的人身安全，不小心點可不行。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "小卯月只是普通的女孩子呀，",
    "voice": "vo_adv_1124001_047",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "\\n希望妳以後不要太勉強自己了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "協會的阿姨",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好的……",
    "voice": "vo_adv_1124001_048",
    "unit_id": 112411
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "普通的女孩子……",
    "voice": "vo_adv_1124001_049",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "說得",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "身為冒險者沒辦法像小凜那樣活躍，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n也不像未央，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "各式各樣的事情都能妥善處理。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我想要做的事情，",
    "voice": "vo_adv_1124001_050",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "到底是什麼呢？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我能不能像那時遇到的街頭藝人公會一樣，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "找到真正想做的事呢……？　",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然和小凜、",
    "voice": "vo_adv_1124001_051",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "未央一起生活很開心。",
