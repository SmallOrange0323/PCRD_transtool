  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被可蘿約出來的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了會合地點公園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您來了呀，",
    "voice": "vo_adv_9006003_000",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不對，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "大人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您忠誠的僕人",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "棗可蘿……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "前來見您了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是呀，",
    "voice": "vo_adv_9006003_001",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下必須先解釋一下……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請您先收下這個。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這是在下剛才在那邊的攤販買的可麗餅。",
    "voice": "vo_adv_9006003_002",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "趁鮮奶油還沒流下來，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "快……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請吃吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那個……",
    "voice": "vo_adv_9006003_003",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "或許您已經不記得了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "今天是在下和您初次見面的",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "日子。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "當在下問",
    "voice": "vo_adv_9006003_004",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "「您是在下的主人嗎？」時，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您那訝異的表情，在下至今仍記得很清楚。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您也還記得嗎？",
    "voice": "vo_adv_9006003_005",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這真是",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "太令人高興了，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "謝……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您說",
    "voice": "vo_adv_9006003_006",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "要付可麗餅的錢？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您就直接收下吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個可麗餅是用在下的零用錢買的，",
    "voice": "vo_adv_9006003_007",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n讓在下聊表",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "祝賀和感謝之意。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n如果不會造成您的困擾的話，希望您能收下。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好的。",
    "voice": "vo_adv_9006003_008",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n那在下也一起品嚐吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您真的很體貼呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嚼嚼……",
    "voice": "vo_adv_9006003_009",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好甜呀。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n像這樣在外面吃東西，總覺得很神奇呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "該說是很開心呢，",
    "voice": "vo_adv_9006003_010",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還是很雀躍呢……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您突然摸在下的臉頰……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您幫我擦掉鮮奶油了呀。",
    "voice": "vo_adv_9006003_011",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n謝謝您……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這……",
    "voice": "vo_adv_9006003_012",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是太讓人難為情了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下的臉頰發燙，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "心跳得好快……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一開始",
    "voice": "vo_adv_9006003_013",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "只是米奈娃要在下見他一面……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n但正如米奈娃所說，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "他是一位很棒的人呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "難道在下現在感受到的雀躍和",
    "voice": "vo_adv_9006003_014",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "心動，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n都是因為和這個人",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在一起嗎？　",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊，",
    "voice": "vo_adv_9006003_015",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下沒事。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您和在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "待在一起不會覺得無聊嗎？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣啊……",
    "voice": "vo_adv_9006003_016",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "和您待在一起",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的、",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的很開心。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "包括",
    "voice": "vo_adv_9006003_017",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "阿斯特朗傳奇在內，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您帶在下去過很多地方，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "遇見了許多人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這一切",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "全都是",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "託您的福。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您",
    "voice": "vo_adv_9006003_018",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "確實",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "拓寬了在下的世界。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……如果",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您不嫌棄",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "的話，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n今後在下也想與您一同看看新的景色……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "謝謝您！",
    "voice": "vo_adv_9006003_019",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n雖然在下還是個不成熟的僕人……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n以後也請您",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "多多關照了。",
    "voice": null,
    "unit_id": 105932
  }
]
