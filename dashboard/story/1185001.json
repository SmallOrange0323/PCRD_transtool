    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "好不容易才贏錢的說……",
    "voice": "vo_adv_1185001_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "趁著各位賭興正盛的時候，",
    "voice": "vo_adv_1185001_068",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我已經掌握各位的人數了，",
