[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走在街上時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n碰巧遇見匆忙趕路的花凜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，{0}先生，真巧啊。",
    "voice": "vo_adv_1185001_000",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "本來應該停下來好好打聲招呼的，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n但我目前還有十分要緊的工作，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請容我失陪了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我正要去調查被魔物襲擊的村莊。",
    "voice": "vo_adv_1185001_001",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "本來應該由公會管理協會派遣公會去解決，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但目前那些公會要不是有委託要處理，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要不就是在遠處無法趕來……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要對付魔物，必須盡早展開行動、研擬對策，",
    "voice": "vo_adv_1185001_002",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不然災害的範圍很容易擴大，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因此我打算先過去看看情況。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你願意嗎！？",
    "voice": "vo_adv_1185001_003",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能多點人手的話，會非常有幫助。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "當然，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我會為此",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "支付報酬的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然之前已經聽說了大致的情況，",
    "voice": "vo_adv_1185001_004",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但情況真是慘不忍睹呢。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "光是要掌握災情",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就得費一番功夫。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "幸好有您來",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "分邊幫忙。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你們難道是",
    "voice": "vo_adv_1185001_005",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "公會派來調查的人嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "太好了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我等你們好久了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的，",
    "voice": "vo_adv_1185001_006",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我來自公會管理協會。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我想要直接向村裡的人",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "探聽目前的情況，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n請問可以找個地方讓各位聚集過來嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我去把有空的人聚集起來，",
    "voice": "vo_adv_1185001_007",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你們稍等一下。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝。",
    "voice": "vo_adv_1185001_008",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我去向村民打聽被襲擊的情況，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n可以麻煩您",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "巡邏一下村莊嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好的，",
    "voice": "vo_adv_1185001_009",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "麻煩你了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "快點",
    "voice": "vo_adv_1185001_010",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "運出來！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "說是這麼說，",
    "voice": "vo_adv_1185001_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "但我已經拉著搬運車來來回回都快累死了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "到底為什麼我們要這麼悲哀地運送這些雜草啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "不能讓我休息一下嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "被發現的話就會被抓去關，",
    "voice": "vo_adv_1185001_012",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n不搬出去你要怎麼辦？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "有沒有腦袋啊？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "唉……",
    "voice": "vo_adv_1185001_013",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "呃！？",
    "voice": "vo_adv_1185001_014",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "你、",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "你什麼時候……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "喔，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "算了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n我們沒事。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "謝謝",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "你的關心。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n就先這樣啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "喂！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "走啦，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "你這個蠢蛋！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "喔……",
    "voice": "vo_adv_1185001_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "……就這樣，",
    "voice": "vo_adv_1185001_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我們好不容易",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "才活著逃出來。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原來如此。",
    "voice": "vo_adv_1185001_017",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "從你們的描述聽看。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n村裡出現的魔物",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "本來並不是會攻擊人的種類。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我可以馬上安排人來修復壞掉的設備，",
    "voice": "vo_adv_1185001_018",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不過在釐清魔物作亂的原因之前，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "想必各位也無法安心。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這時候還是",
    "voice": "vo_adv_1185001_019",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請熟悉魔物生態的公會過來……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "安全起見，擅長戰鬥的公會最好也……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能在最短時間內趕來的組合是……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "哇！？",
    "voice": "vo_adv_1185001_020",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你回來啦。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "村裡的情況怎樣？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n如果有嚴重損壞的地方，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請向我報告。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……？",
    "voice": "vo_adv_1185001_021",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "已經來到村子的外緣了，",
    "voice": "vo_adv_1185001_022",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你要帶我看什麼……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這座倉庫嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "已經破破爛爛的了，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不太像是魔物的攻擊造成的，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "應該本來就相當老舊……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有人趁火打劫嗎？",
    "voice": "vo_adv_1185001_023",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這種地方看起來實在不像是有東西值得偷。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦？",
    "voice": "vo_adv_1185001_024",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那些人是在",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "搬運牧草嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n牧草的確是散落在地上……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n難道說……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我記得【王宮騎士團】之前發的資料上有記載特徵……",
    "voice": "vo_adv_1185001_025",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我看看……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不是這個，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也不是這樣……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "找到了！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是這個！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這種牧草是一種飼料，",
    "voice": "vo_adv_1185001_026",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但最近發現給魔物食用",
