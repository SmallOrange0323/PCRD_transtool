    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "除了魔物之外，我們不是還有得抓的人嗎？",
    "voice": "vo_adv_1185001_060",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "很好，",
    "voice": "vo_adv_1185001_061",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "所有人的注意力都在魔物身上了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n趁現在開溜啦。",
