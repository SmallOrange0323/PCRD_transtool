    "voice": "vo_adv_1185001_042",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n向【王宮騎士團】回報我們找到正確地點，\\n然後慢慢等人過來吧。",
