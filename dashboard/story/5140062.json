[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "頭を冷やすべく街を散策していたクレジッタの元に、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n良くない知らせが届けられた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あーもうまったくもう！　",
    "voice": "vo_adv_5132062_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんてことですの！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nやっぱり予感が的中しましたわ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "頼んでいた高級チーズの手配ミスだなんて！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わざわざ国外のブランド品を発注したのが間違いでしたわ……",
    "voice": "vo_adv_5132062_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "輸送中のトラブルに",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "受注数量の読み違え……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ダブルパンチなんて聞いてませんわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こちらから受け取りに行く……？　",
    "voice": "vo_adv_5132062_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さらに高値で買い占める……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いいえ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どっちも間に合いませんわね……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "とはいえ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あのレベルのチーズが他で手に入るかというと……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お姉さんお姉さん、",
    "voice": "vo_adv_5132062_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "チーズのことでお悩みだべか？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そんならうちのチーズ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "いかがだべ？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "え？",
    "voice": "vo_adv_5132062_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……悪いけど、",
    "voice": "vo_adv_5132062_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今子どものお店屋さんごっこに付き合っている暇は",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nありませんの。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "急いでますので、失礼。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ま、",
    "voice": "vo_adv_5132062_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "待ってけろ！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラ、立派な大人だど！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "それに、【牧場】ってギルドのギルドマスターやってるべさ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "今日は大人気のチーズを売りに来てんだ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ということは、",
    "voice": "vo_adv_5132062_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女のとこの商品を売り込むつもりですわね。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "確かに路線変更して地産地消で売れば、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n地元産の地味なチーズでもあるいは……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "しかし",
    "voice": "vo_adv_5132062_008",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "街の商店に卸すのならともかく、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくしのクリスマスに相応しいかどうかというと疑問ですわね。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "贈答用や高級料理に使える品じゃなくては意味がありませんわ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "疑うなら一度試食してみてけろ。",
    "voice": "vo_adv_5132062_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\nしたっけお姉さんもぜってぇ気に入るはずだべ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ささ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "どうぞどうぞ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……はぁ、",
    "voice": "vo_adv_5132062_010",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そもそも気分転換で街に来たんですから、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nちょっとくらいなら付き合って差し上げますわ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "む……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "え？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nな、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ななななんですの、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これ……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "なんまらおっかねぇ顔してるけんど……",
    "voice": "vo_adv_5132062_011",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\nこれは……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ウッカリしただか……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "もしやまた、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "牧場没収されたりしちゃうべか……！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "くっ、",
    "voice": "vo_adv_5132062_012",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "よもやランドソルにこれほどの品があったなんて……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "【牧場】のチーズ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いけ好かない貴族どもが騒いでいるだけだと",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n甘く見ていましたわ……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これはわたくしの調査不足ですわね……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……貴女、",
    "voice": "vo_adv_5132062_013",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お名前は？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オ、",
    "voice": "vo_adv_5132062_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラはマヒルってんだ……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "頼む、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "許してけろ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n牧場と命だけは",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "取らね",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ぇでけろ……！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はぁ？　",
    "voice": "vo_adv_5132062_015",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……何言ってるんですの？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "マヒルさん、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女のところのチーズ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nぜひ今度のクリスマスイベントで取り扱わせてほしいのですが。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ほ、",
    "voice": "vo_adv_5132062_016",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ほんとだべか！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "もちろんお願いするべさ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "……って、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "取り扱い……？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\nさっきまで、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "なんまらおっかねぇ顔してたのに？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あれは己の不明を恥じたまでですわ。",
    "voice": "vo_adv_5132062_017",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女のことを怪しげな行商人と甘く見たことはお詫びします。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "早速ですけど、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仕入れのご相談をさせていただけますわね？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お？　",
    "voice": "vo_adv_5132062_018",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ええと、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "いつもは……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "こんなとこだべか。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はああああああっ？　",
    "voice": "vo_adv_5132062_019",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女バカにしてますの！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "え、",
    "voice": "vo_adv_5132062_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラなんか悪いことしただか？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ、",
    "voice": "vo_adv_5132062_021",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "悪いですわよ",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "極悪ですわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこれほどのクオリティのチーズを、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこんな安値で売るなんてどうかしてますわ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そ、",
    "voice": "vo_adv_5132062_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そうだべか……？　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "でもオラ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "安く提供して",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "たくさんの人に",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n手に取ってもらって、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "笑顔になってもらいてぇんだけど……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女の言いたいこともわかりますし、",
    "voice": "vo_adv_5132062_023",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "立派な志だと思いますわ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nでも、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これほどのチーズを作るには手間もコストも必要なはず。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これから先もみんなにおいしく食べてもらいたいなら、",
    "voice": "vo_adv_5132062_024",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n儲けられる機会にちゃんと儲けておきなさい。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "むやみに安売りするのは、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "客にも失礼ですわよ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "多少高くとも必ず買ってくれる。",
    "voice": "vo_adv_5132062_025",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女には",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そういう顧客がついているのではなくて？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "だな。",
    "voice": "vo_adv_5132062_026",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お姉さんの言う通りだべ。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "でも……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "先ほど出会ったばかりですが、",
    "voice": "vo_adv_5132062_027",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n貴女の無欲ぶりからして",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "きっと儲けたところで",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n無駄遣いなどなさらないですわよね？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "も、",
    "voice": "vo_adv_5132062_028",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "もちろんだべ！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そんなつもりで作ってねぇべさ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それなら儲けた分は",
    "voice": "vo_adv_5132062_029",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "設備投資や仲間にボーナスでもあげなさいな。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そうすれば巡り巡って",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お客にもしっかりと還元できるはずですわよ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お、",
    "voice": "vo_adv_5132062_030",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お姉さん、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "スゲェ人だべな……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そこまで考えてなかったべさ……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "商人ならこれくらいのことは考えて当然ですわ。",
    "voice": "vo_adv_5132062_031",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n売り方はわたくしが考えます。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "だから貴女は",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "おいしいチーズを作りなさい。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "わかっただ！　",
    "voice": "vo_adv_5132062_032",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お姉さんなら信用できるべ。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "よろしく頼むど！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "あ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "そういえばお姉さんの名前、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "まだ聞いてなかったべ。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "申し遅れましたわね。",
    "voice": "vo_adv_5132062_033",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしクレジッタ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nランドソルの行政長官を務める",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "クレジッタ・キャッシュですわ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "よく覚えておきなさいな、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "マヒルさん。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "クレジッタ……",
    "voice": "vo_adv_5132062_034",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ならクレクレだな！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "改めてよろしくだべ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "クレクレ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ク、",
    "voice": "vo_adv_5132062_035",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "クレクレ！？　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いきなりあだ名とか距離感おかしいですわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれに",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "クレクレって",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "物乞いみたいじゃありませんこと！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "すぐにお止めなさい！",
    "voice": "vo_adv_5132062_036",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nさもなければ",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "付き合いを考えさせていただきますわ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ちょっと待ってクリーム！　",
    "voice": "vo_adv_5132062_037",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "せっかく構ンベールてくれたんだべさ、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "チーズで結ばれた縁、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "今後とも",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "よろチーズだべな！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ひいぃ！　",
    "voice": "vo_adv_5132062_038",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "寒い、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "寒すぎますわ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "つまらないダジャレはやめなシャレ……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あっ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "お、",
    "voice": "vo_adv_5132062_039",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "クレクレ結構いけるでねぇか？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ち、",
    "voice": "vo_adv_5132062_040",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "違いますわ！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これは貴女につられただけで……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "なぁ、",
    "voice": "vo_adv_5132062_041",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "オラとお笑いコンビくまねぇか？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "ビジュアル的にもいいデコボココンビになると思うべさ！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "絶対にお断りですわ！　",
    "voice": "vo_adv_5132062_042",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もう破談ですわ破談！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n貴女とはやってられませんわ……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ってもう！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこれじゃ漫才のオチじゃございませんこと！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "あはは！　",
    "voice": "vo_adv_5132062_043",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "マヒル",
    "words": "やっぱりクレクレはお笑いの素質があるべ！",
    "voice": null,
    "unit_id": 103311
  }
]
