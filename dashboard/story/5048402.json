    "words": "哈、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈哈……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "成、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "成功了……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇！",
    "voice": "vo_adv_5048402_001",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊、",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳沒事吧！？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": "vo_adv_5048402_002",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我沒事啦……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可能是繃緊的神經一下子鬆懈下來，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n突然全身沒有力氣了……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "唉，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我這樣子",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還真是狼狽啊。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才沒那回事！",
    "voice": "vo_adv_5048402_003",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為姊姊妳在我的身邊，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n一直保護著我，我們才能戰勝的。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不管別人怎麼說，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊都是最厲害的！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里……",
    "voice": "vo_adv_5048402_004",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "能聽見妳這麼說，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我作為雙胞胎的姊姊，面子也保住了。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": "vo_adv_5048402_005",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我能努力到這一步全都是因為有妳陪著我。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "多虧有妳，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我才有辦法戰鬥到最後一刻。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯，",
    "voice": "vo_adv_5048402_006",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳說得對！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "只要我們兩個同心協力，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就是所向披靡的雙胞胎！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "以後也請多關照囉，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊♪",
    "voice": null,
    "unit_id": 113711
  }
]
