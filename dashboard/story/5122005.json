[
  {
    "type": "background",
    "bg_id": "502013"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "度過了混亂與插曲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n四人在那之後依然埋首於淨化大海。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "終於，全部的祕密魔物",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n都被歸還給了所有者。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "太棒了────！",
    "voice": "vo_adv_5122005_000",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n祕密魔物",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "全數歸還！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n大海淨化",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "完成～～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "放眼望去，",
    "voice": "vo_adv_5122005_001",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一整片都是乾乾淨淨的海底！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這下子，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "金槍鮪也能恢復原本的味道了吧！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "太感謝了……",
    "voice": "vo_adv_5122005_002",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "真的太感謝了！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n這份恩情",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "我一輩子都不會忘記！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5122005_003",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "似似花大人，",
    "voice": "vo_adv_5122005_004",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "您的祕密物品有出現嗎？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒有……",
    "voice": "vo_adv_5122005_005",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是奇怪。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼就立刻把海水灌回去……",
    "voice": "vo_adv_5122005_006",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "很想這麼說，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不過在那之前還有一個問題。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n漁協協會長？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你能正式答應我，",
    "voice": "vo_adv_5122005_007",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不再承辦祕密廢棄服務嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這是為了大間的海、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這裡的居民，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n以及",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "期待吃到大間的魚的所有人。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "好……",
    "voice": "vo_adv_5122005_008",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "我答應妳，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "我們再也不會做出",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "汙染這片大海的行為。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝你……！",
    "voice": "vo_adv_5122005_009",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "──那麼，",
    "voice": "vo_adv_5122005_010",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就把海水",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "恢復原狀吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "紫藤土木相關企業的各位～！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請將海水──",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給我等～～",
    "voice": "vo_adv_5122005_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一下～～～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "……！？",
    "voice": "vo_adv_5122005_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什、",
    "voice": "vo_adv_5122005_013",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什什什麼！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n海底……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "裂了開來……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n有什麼東西出現了──！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "512200501"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你是……",
    "voice": "vo_adv_5122005_014",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "島鯨！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n你還活著嗎！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "又──",
    "voice": "vo_adv_5122005_015",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "是你們在礙事啊？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n你們還是一樣高舉著低級正義感的旗號，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n看不出半點成長的跡象啊。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一見面就說得那麼難聽……",
    "voice": "vo_adv_5122005_016",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不先打個招呼嗎？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像是好久不見～",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "或是",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "久疏問候～",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "之類的。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話說",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什麼叫做我們在礙事？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大海被淨化似乎讓牠很困擾呢……",
    "voice": "vo_adv_5122005_017",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來這一切的背後主謀",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是這傢伙……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "什麼！？",
    "voice": "vo_adv_5122005_018",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可是，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我記得你想要的",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是人類的「欲望」吧？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那跟祕密物品有什麼關係……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "越是強烈的欲望，",
    "voice": "vo_adv_5122005_019",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "人就越是會想要藏起來。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "哦，",
    "voice": "vo_adv_5122005_020",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "也有很敏銳的人嘛。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就是說，",
    "voice": "vo_adv_5122005_021",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你看上的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是隱藏在「祕密」之中的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「欲望」……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "從慫恿漁協協會長，",
    "voice": "vo_adv_5122005_022",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "誘使他展開祕密廢棄服務的那一步起，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你就已經展開你的陰謀了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "正是如此。",
    "voice": "vo_adv_5122005_023",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "「東西一旦沉下去就永遠不會浮起的漩渦」",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "就是我的噴氣孔。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n你們拚命丟了一堆祕密物品下來呢，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "我要向你們道謝啊，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "大間的人類們♪",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "和正、漁協協會長",
    "words": "什麼──！？",
    "voice": "vo_adv_5122005_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "祕密的「欲望」",
    "voice": "vo_adv_5122005_025",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "充滿愧疚感，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n又濃郁深沉，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "非常美味呢。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你就是靠著這個方式利用大間的人們，",
    "voice": "vo_adv_5122005_026",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n在海底苟延殘喘的吧……！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "是啊。",
    "voice": "vo_adv_5122005_027",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n不過你們也充分享受到了好處吧？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n漁協協會長，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "之後也要繼續麻煩你囉♪",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "這、",
    "voice": "vo_adv_5122005_028",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "這可不行。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n我已經決定不會繼續提供祕密廢棄服務了！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "哇──",
    "voice": "vo_adv_5122005_029",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "哈哈哈哈！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n少自以為是了，人類們。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "你們",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "可沒有",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "決定權。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "喝──",
    "voice": "vo_adv_5122005_030",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "哈！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "still",
    "still_id": "512200502"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咚嘣────！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "──！？",
    "voice": "vo_adv_5122005_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "從、",
    "voice": "vo_adv_5122005_032",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "從島鯨的噴氣孔……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "又有更多的祕密魔物……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "噴出來了～！？",
    "voice": "vo_adv_5122005_033",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n而且數量非常多～～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "討厭，",
    "voice": "vo_adv_5122005_034",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好不容易才把海底清乾淨的！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這下不就又回到原點了嗎～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "看～啊，",
    "voice": "vo_adv_5122005_035",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "你們快看，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "要多少有多少喔！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n這是你們人類所丟棄、",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "成堆的自私念頭！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……！",
    "voice": "vo_adv_5122005_036",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那樣的話，",
    "voice": "vo_adv_5122005_037",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "由我們親手處理也是應該的呢……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "既然如此，就只能用體力跟牠耗下去了。",
    "voice": "vo_adv_5122005_038",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n直到牠的祕密魔物耗盡為止，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n讓我們一個不剩地",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "歸還、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "淨化那些祕密吧！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "了、",
    "voice": "vo_adv_5122005_039",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "了解！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n那麼，每個人",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都盡可能多抱一點祕密魔物──",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "background",
    "bg_id": "502014"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──！",
    "voice": "vo_adv_5122005_040",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……奇怪？",
    "voice": "vo_adv_5122005_041",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我的腳……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "動不了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我、",
    "voice": "vo_adv_5122005_042",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我也是……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我的腳……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "正確來說，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是身體",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "動不了……！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨、秋乃",
    "words": "為、為什麼……！？\\n怎、怎麼會這樣……！？",
    "voice": "vo_adv_5122005_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "因為「罪惡感」啊。",
    "voice": "vo_adv_5122005_044",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "優花梨、秋乃",
    "words": "咦……？",
    "voice": "vo_adv_5122005_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "看來你們什～",
    "voice": "vo_adv_5122005_046",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "麼也不知道，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "就一頭栽進來了啊。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n真可憐哪。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "雖然為時已晚，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "不過我還是告訴你們吧。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "所謂的祕密呢，",
    "voice": "vo_adv_5122005_047",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n一半是由「欲望」，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "另一半",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "是由「罪惡感」所組成的。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "這種叫罪惡感的東西",
    "voice": "vo_adv_5122005_048",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "對我來說沒有任何味道，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "但對人類來說好像非常難吃，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n聽說是種會侵蝕身心的",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "毒藥呢♪",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "你們揚言要淨化魔物，",
    "voice": "vo_adv_5122005_049",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "因而與他人共享了太多的祕密。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n在那個過程中共同承擔的罪惡感，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "都累積在你們那瘦弱的身體裡了。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n唉唷，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "真是可憐啊。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "優花梨、秋乃",
    "words": "……！",
    "voice": "vo_adv_5122005_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，",
    "voice": "vo_adv_5122005_051",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "糟糕……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "心也……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "變得消沉了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是我們",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不好……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊……",
    "voice": "vo_adv_5122005_052",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這種事……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不該只憑自己的一廂情願",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就出手干涉的……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我感覺",
    "voice": "vo_adv_5122005_053",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就連一根手指也動不了了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "background",
    "bg_id": "502020"
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "雖然很遺憾，",
    "voice": "vo_adv_5122005_054",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "不過事情就是這樣。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "試著回想一下吧，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n那些被歸還了祕密的人",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "露出的那狼狽模樣，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "還有哀號慘叫。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "still",
    "still_id": "512200401"
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "或者是",
    "voice": "vo_adv_5122005_055",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "只因一個祕密就輕易扭曲的",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "人際關係，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "以及這個社會。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……",
    "voice": "vo_adv_5122005_056",
    "unit_id": 126711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "502014"
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "無法承受。",
    "voice": "vo_adv_5122005_057",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "想放手拋開。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n就是因為這樣，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "他們才會主動廢棄這些祕密不是嗎？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "要是你們沒有把這些東西挖出來，",
    "voice": "vo_adv_5122005_058",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n祕密就會永遠沉在深海之中，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n不會擾亂任何人的心。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "人類是",
    "voice": "vo_adv_5122005_059",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "難以承擔祕密的。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n正因為如此，我才會提議",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "繼續提供祕密廢棄服務。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "你們別誤會了，",
    "voice": "vo_adv_5122005_060",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "我可不是想單方面壓榨人類喔？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "這就好比是",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "共存協議。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "共存",
    "voice": "vo_adv_5122005_061",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "協議……？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "以前",
    "voice": "vo_adv_5122005_062",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "你們也跟我提過吧？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "就跟那個協議一樣。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n把潛藏在祕密之中的「欲望」給我。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n作為交換，",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "我會將人類的祕密永永遠遠、",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "確實地",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "埋葬起來。",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "永永",
    "voice": "vo_adv_5122005_063",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "遠遠……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "確實地……",
    "voice": "vo_adv_5122005_064",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "這對我們雙方都有好處，",
    "voice": "vo_adv_5122005_065",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n我覺得是個不壞的提案呢？",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "優花梨、秋乃",
    "words": "……！",
    "voice": "vo_adv_5122005_066",
    "unit_id": null
  }
]
