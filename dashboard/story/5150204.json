    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n妳看到這景色有何感想？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……簡直像是",
    "voice": "vo_adv_5150204_001",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "映照出",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我的內心一樣……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵～",
    "voice": "vo_adv_5150204_002",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "意思是內心就像",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "下雨前陰沉沉的樣子～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "愛梅斯，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她一點都沒在反省哦。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "帆稀，我們繼續前進吧。",
    "voice": "vo_adv_5150204_003",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n前方有強烈的反應。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "確實是有",
    "voice": "vo_adv_5150204_004",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "強烈的反應呢～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣或許正好～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳們要用強烈的反應對我怎樣！？",
    "voice": "vo_adv_5150204_005",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "自食其果！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是要我自食其果吧！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "救命啊～～～～～～～～～～～～～～～～～～～～～～～！",
    "voice": "vo_adv_5150204_006",
    "unit_id": 190912
  }
