    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "結構立派な会場じゃない。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "さすがはギルド管理協会が用意しただけあるわね。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
