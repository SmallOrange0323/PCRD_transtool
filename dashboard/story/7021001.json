  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人一邊擊退湧來的魔物群，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n順利地在露娜之塔中前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哈～～～！",
    "voice": "vo_adv_7021001_000",
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "又是只用一擊……",
    "voice": "vo_adv_7021001_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還真厲害。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "小智實在太強了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "根本輪不到我出手。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "和在【王宮騎士團】的訓練中",
    "voice": "vo_adv_7021001_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "接受純的\\n魔鬼鍛鍊相比，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這種程度根本不算什麼。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果這樣能讓深月小姐",
    "voice": "vo_adv_7021001_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "得以專心尋找{0}記憶的線索",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那麼就太好了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我從剛才開始就在觀察周圍，",
    "voice": "vo_adv_7021001_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n不過放眼望去",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "全都是些沒見過的草株呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這蠻有採集的價值，倒是幫了我不少忙。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真的耶，",
    "voice": "vo_adv_7021001_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "{0}手上的行李",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n越來越多了……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還好嗎？",
    "voice": "vo_adv_7021001_006",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "太重的話我也幫忙拿。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "既然{0}都這麼說了那就好……",
    "voice": "vo_adv_7021001_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "話說回來，",
    "voice": "vo_adv_7021001_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "它們是某種罕見的藥草嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n比方說帶回蘭德索爾",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "能高價賣出之類的？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯？",
    "voice": "vo_adv_7021001_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒那種事啊。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只不過是",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我沒見過而已，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "搞不好",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n實際上只是沒有任何藥效的雜草呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該這麼說，",
    "voice": "vo_adv_7021001_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "它們十有八九",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就只是雜草吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "普通草株",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在特殊環境下交配，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "僅有外觀產生了變化這樣。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要把平凡無奇的雜草帶回去嗎？",
    "voice": "vo_adv_7021001_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "事情總有萬一嘛。",
    "voice": "vo_adv_7021001_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟之前",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也碰過偶然調配出很厲害的藥品之類的事。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "厲害的藥品……",
    "voice": "vo_adv_7021001_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果發生了那種事，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "應該會成為話題才對。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "既然我從未聽說過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那果然就和地下社會……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "試著套情報看看吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "舉例來說",
    "voice": "vo_adv_7021001_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "做出了什麼藥品呢？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要說可能和小智有關的藥品，",
    "voice": "vo_adv_7021001_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我想想……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "治癒速度比市面上的療傷藥",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "高出數倍的藥品，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種妳覺得如何？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "居然有那麼厲害的藥品？",
    "voice": "vo_adv_7021001_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果有的話",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "請務必連絡【王宮騎士團】……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果賣得了那也不錯，",
    "voice": "vo_adv_7021001_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n不過材料過於貴重",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而且也無法量產所以很有難度呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我的研究幾乎都是那種東西。",
    "voice": "vo_adv_7021001_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "效果頂多都只能擴及小範圍。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說你啊，",
    "voice": "vo_adv_7021001_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別用那種眼神看我。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就算你",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一直都在那小範圍中受影響也一樣。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_7021001_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "{0}知道",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n深月小姐調配的藥品是嗎。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呃……",
    "voice": "vo_adv_7021001_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這意思是……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "他說他知道，這就代表",
    "voice": "vo_adv_7021001_022",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要是深月小姐被捕",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那麼{0}也會因為掩飾罪行而一起被……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不，",
    "voice": "vo_adv_7021001_023",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "即使如此也不能對壞事視若無睹！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n就這樣繼續調查下去，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有機會也得順便掌握證據！　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_7021001_024",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真的很可愛呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n很有逗弄她的價值。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒什麼。",
    "voice": "vo_adv_7021001_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別在意。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "智和深月兩人的思緒交互影響，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}一行人朝塔的上方繼續前進。",
    "voice": null,
    "unit_id": null
  }
]
