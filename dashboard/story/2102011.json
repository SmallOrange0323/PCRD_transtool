    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳怎麼了？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛剛，",
    "voice": "vo_adv_2102011_062",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我好像在這個陰暗處看見了雪菲……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哎呀，",
    "voice": "vo_adv_2102011_063",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜妳真是的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n怎麼可能會有那種事嘛～。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……",
    "voice": "vo_adv_2102011_064",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……好像",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是不在……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我多心了嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": "vo_adv_2102011_065",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n畢竟雪菲她",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在應該在床上睡得正熟才對。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說得也是。",
    "voice": "vo_adv_2102011_066",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我看錯了吧……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯……",
    "voice": "vo_adv_2102011_067",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然最後弄得有點慌了手腳。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但差不多，【王宮騎士團】和",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n貴族們的士兵也快到這裡來了吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "噁……",
    "voice": "vo_adv_2102011_068",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然沒做什麼虧心事，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但在那之前我們還是先離開這吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "豪紳那張方方正正的臉，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可不想要在睡前看到它啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們也一樣，",
    "voice": "vo_adv_2102011_069",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不想要接近屬於那一塊領域的人們呢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯！",
    "voice": "vo_adv_2102011_070",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們可是行走於冥府魔道的集團，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和國家權力",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可說是不共戴天嘛！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "反倒是貪吃佩可小姐……",
    "voice": "vo_adv_2102011_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您不顧王宮跑到這來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不會有事嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_2102011_072",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "關於那件事我自有辦法♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n話說回來小可蘿，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的很謝謝妳！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯嗯！",
    "voice": "vo_adv_2102011_073",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果我們沒有可可蘿的話，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛剛真的就很危險了呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。",
    "voice": "vo_adv_2102011_074",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "非常感謝妳的努力……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎麼了？",
    "voice": "vo_adv_2102011_075",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n可可蘿，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳的臉色似乎不太好……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……非常不好意思。",
    "voice": "vo_adv_2102011_076",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n老實說從方才開始，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就一直拼命忍耐著……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎也到此為止了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦！？",
    "voice": "vo_adv_2102011_077",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n可可蘿，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳沒事吧！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔！？",
    "voice": "vo_adv_2102011_078",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳被魔物打傷了嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這種事妳早點說啦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_2102011_079",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並非是那麼一回事……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知是否是因為公主型態的副作用，",
    "voice": "vo_adv_2102011_080",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常令人感覺到了飢餓感。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下已經……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肚子快要餓扁……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……在下，",
    "voice": "vo_adv_2102011_081",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變成餓餓蘿",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "了……",
    "voice": null,
    "unit_id": 105913
  },
