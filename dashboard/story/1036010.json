  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總算是答出來了……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那題的答案──",
    "voice": "vo_adv_1036010_035",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我覺得應該是",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為光在漫射。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該有",
    "voice": "vo_adv_1036010_036",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "稍微冷靜一點了……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊！",
    "voice": "vo_adv_1036010_037",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "拜託住手！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n不需要拍手啦！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是受不了，",
    "voice": "vo_adv_1036010_038",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這種程度是理所當然的事，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n根本不需要那麼高興……！　",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1036010_039",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "老師。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那裡的問題",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "答案有錯。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n正確答案是──",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "謝謝。",
    "voice": "vo_adv_1036010_040",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "真不愧是鏡華同學，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n妳或許比",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "老師還要可靠呢。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒、",
    "voice": "vo_adv_1036010_041",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒有……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒這回事。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你、",
    "voice": "vo_adv_1036010_042",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你是在大叫什麼奇怪的話啦！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再這樣就要你立刻離開教室喔！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然這裡已經是外面了！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我可不打算當你家的孩子！",
    "voice": "vo_adv_1036010_043",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該說",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你至今為止都用把自己當成是家長嗎！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "討厭，",
    "voice": "vo_adv_1036010_044",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這人實在讓人好害羞喔……！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過，",
    "voice": "vo_adv_1036010_045",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是為什麼呢……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一被那個人誇獎，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然覺得害羞，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但總覺得……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在胸口周圍",
    "voice": "vo_adv_1036010_046",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺的癢癢的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這股感情",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "究竟是什麼呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這跟考到高分被媽媽誇獎時，",
    "voice": "vo_adv_1036010_047",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n感覺又",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不太一樣……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然不懂……",
    "voice": "vo_adv_1036010_048",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是感覺似乎",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不差。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呵呵……♪",
    "voice": "vo_adv_1036010_049",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "好的，",
    "voice": "vo_adv_1036010_050",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "今天的課程",
