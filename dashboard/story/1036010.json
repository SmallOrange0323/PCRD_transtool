    "type": "dialogue",
    "name": "鏡華",
    "words": "討厭～！",
    "voice": "vo_adv_1036010_059",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那個人真的是個",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "讓我丟臉到家了啦～～～～～！",
    "voice": null,
    "unit_id": 103611
  }
