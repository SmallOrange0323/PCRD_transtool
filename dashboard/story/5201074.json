[
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……這還不夠完美呢。",
    "voice": "vo_adv_5201074_000",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "牙齒再長一點，",
    "voice": "vo_adv_5201074_001",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "爪子加上毒性，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "眼睛能發射石化光線，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n一根尾巴不夠改成三根，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "能獨自行動加上攻擊複數目標。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "體力的數值也太低了，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這樣打起來不過癮。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "弱點屬性？",
    "voice": "vo_adv_5201074_002",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "什麼軟弱的設計……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "不過，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "要他人配合我的基準或許很困難呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n那就設計為物理以外",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "減半的程度吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這樣的話，",
    "voice": "vo_adv_5201074_003",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "各項能力值",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就可以再拉高一點了呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "為了給戰鬥帶來緊張感，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n調整為能夠打很久的數值吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "所以。",
    "voice": "vo_adv_5201074_004",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這種魔物誰能打得倒？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……有什麼意見嗎，",
    "voice": "vo_adv_5201074_005",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "真那。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n你在妨礙我工作，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "給我離開。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妨礙工作的人是你啊。",
    "voice": "vo_adv_5201074_006",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我才在想為什麼我調整好的魔物戰鬥難度，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n怎麼會一個個都被調整成劣作等級了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "劣作？",
    "voice": "vo_adv_5201074_007",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "這話我可不能當作沒聽見呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n最能夠理解戰鬥樂趣的人",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "毫無疑問是我本人。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "而我正在",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "親自幫忙調整喔？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "烏帕魯帕",
    "voice": "vo_adv_5201074_008",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "用眼睛都看不到的速度噴出毒素了呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "沒錯。",
    "voice": "vo_adv_5201074_009",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "外表看來遲鈍卻能使出",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "高速的一擊。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n想必能給玩家",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "戰鬥不能只看外表的教訓。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "那麼遠距離攻擊為什麼變得打不中洞窟蝙蝠了？",
    "voice": "vo_adv_5201074_010",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "會飛的魔物怎麼可能不戒備空中攻擊。",
    "voice": "vo_adv_5201074_011",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "作為戰士，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就該擁有能夠照樣痛扁飛行對手的能力。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "你還給軟泥怪",
    "voice": "vo_adv_5201074_012",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "追加了新的攻擊方法對吧？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是啊，",
    "voice": "vo_adv_5201074_013",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是窒息攻擊呢。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "很難應付對吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "誰叫牠不知道為什麼只設定了衝撞這招，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我就按照牠的生態",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "追加了合理的攻擊方法。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……唉。",
    "voice": "vo_adv_5201074_014",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我不明白。",
    "voice": "vo_adv_5201074_015",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n到底",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "是哪裡讓你覺得不滿？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "大概是你",
    "voice": "vo_adv_5201074_016",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "缺乏常人感性",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "的部分吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……竟然",
    "voice": "vo_adv_5201074_017",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "會被你批評沒有常人感性……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "總之，",
    "voice": "vo_adv_5201074_018",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "關於戰鬥調整的部分，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "請你不要再去動了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我明明已經設計得這麼簡單了……",
    "voice": "vo_adv_5201074_019",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "無法理解……",
    "voice": null,
    "unit_id": 107331
  }
]
