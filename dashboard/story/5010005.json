[
  {
    "type": "background",
    "bg_id": "500552"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到了晚上，逐漸熟悉淨化願望的{0}一行人。\\n前往神殿的人潮源源不絕，工作愈來愈忙碌。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們回來了〜……",
    "voice": "vo_adv_5010005_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "話說我們，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "已經持續工作幾個小時了啊〜……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "差不多該休息一下？",
    "voice": "vo_adv_5010005_001",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這樣不休息一直工作的話，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "等等就會很累唷？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……的確已經到體力的極限了，",
    "voice": "vo_adv_5010005_002",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不知道願望何時會出現呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "各位，",
    "voice": "vo_adv_5010005_003",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "真的很謝謝你們的努力。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_5010005_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "祭司大人！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "如果累了的話，請趁現在好好休息呢。",
    "voice": "vo_adv_5010005_005",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "因為，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "過了這個時間後可能會變得更忙也說不定。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也是呢——……",
    "voice": "vo_adv_5010005_006",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "接近新年的最後幾個小時，",
    "voice": "vo_adv_5010005_007",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "是一年當中願望會變得最密集的時候。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "人們無法實現的願望交纏在一起，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "引發無法預料的情況也是時常出現。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "請各位盡可能，",
    "voice": "vo_adv_5010005_008",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "不要掉以輕心。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無法預料的情況？",
    "voice": "vo_adv_5010005_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "在悠久的歷史當中，",
    "voice": "vo_adv_5010005_010",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "也不少像是這樣的事。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "如果大家有想達成的願望，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n請趁現在寫在護符上",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "然後投入祭壇。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我好想把剛剛的回憶給燒掉啊。",
    "voice": "vo_adv_5010005_011",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈、",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！　",
    "voice": "vo_adv_5010005_012",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "快回神啊——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家寫完了嗎？",
    "voice": "vo_adv_5010005_013",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我完成了唷——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也寫完了喔。",
    "voice": "vo_adv_5010005_014",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳寫了什麼？　",
    "voice": "vo_adv_5010005_015",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "給我看給我看——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "討厭，",
    "voice": "vo_adv_5010005_016",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不能看啦。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好丟臉唷……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳這麼一說就更令人在意了啊！",
    "voice": "vo_adv_5010005_017",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵",
    "voice": "vo_adv_5010005_018",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就算不問我也知道了，",
    "voice": "vo_adv_5010005_019",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓她靜一靜吧……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生呢？　",
    "voice": "vo_adv_5010005_020",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "準備好護符了嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生沒有嗎？",
    "voice": "vo_adv_5010005_021",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒實現的或想忘記的事。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_5010005_022",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你的記憶……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……騎士先生。",
    "voice": "vo_adv_5010005_023",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確是……",
    "voice": "vo_adv_5010005_024",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和伙伴的回憶",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也不忍燒掉呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼那麼，",
    "voice": "vo_adv_5010005_025",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家接下來一起",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "去製造更多的回憶吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　對吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！",
    "voice": "vo_adv_5010005_026",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說得也是。",
    "voice": "vo_adv_5010005_027",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們去把紙投進去就回來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你在這裡等一下。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……今天",
    "voice": "vo_adv_5010005_028",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把他帶來這裡，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也許不是件好事也說不定。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "為什麼？　",
    "voice": "vo_adv_5010005_029",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今天看起來非常開心唷？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……怜想說的事情，",
    "voice": "vo_adv_5010005_030",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我知道唷。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他現在喪失了記憶。",
    "voice": "vo_adv_5010005_031",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這種稱為「消除記憶」",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的儀式，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不可能讓他開心起來呢……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃……！　",
    "voice": "vo_adv_5010005_032",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是這樣",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "的呢……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不過！　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今天的事情也一定，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "會成為回憶唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我們能為騎士先生做的事情，",
    "voice": "vo_adv_5010005_033",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不知道有什麼呢……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一定有的唷！　",
    "voice": "vo_adv_5010005_034",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一定……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "絕對有的！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯。",
    "voice": "vo_adv_5010005_035",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當他依靠我們的時候，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一定要助他一臂之力。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有困難的時候就是要互相幫助幫助，",
    "voice": "vo_adv_5010005_036",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "才對嘛！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_5010005_037",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！　",
    "voice": "vo_adv_5010005_038",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說的也是！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……所以，",
    "voice": "vo_adv_5010005_039",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們去迎接騎士先生吧！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n來比賽誰最快！　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "預備，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "跑！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和，",
    "voice": "vo_adv_5010005_040",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "穿著和服跑很危險唷！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算因為單獨跑比較容易，竟然敢先偷跑，",
    "voice": "vo_adv_5010005_041",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真行呢！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒關係沒關係！",
    "voice": "vo_adv_5010005_042",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n因為突然變得很想看到騎士先生的臉呢！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜和優衣也是這樣吧――",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "女性的聲音",
    "words": "――呀啊啊啊啊！！！",
    "voice": "vo_adv_5010005_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "！？",
    "voice": "vo_adv_5010005_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼了！？",
    "voice": "vo_adv_5010005_045",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "又是願望實體化了嗎？",
    "voice": "vo_adv_5010005_046",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總覺得，",
    "voice": "vo_adv_5010005_047",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺和之前不一樣的……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總之加快腳步！",
    "voice": "vo_adv_5010005_048",
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500552"
  },
  {
    "type": "dialogue",
    "name": "願望A",
    "words": "……大學……",
    "voice": "vo_adv_5010005_049",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "願望A",
    "words": "合格……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "願望B",
    "words": "被劈腿了……",
    "voice": "vo_adv_5010005_050",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "願望B",
    "words": "不要拋棄我……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "願望C",
    "words": "波奇……",
    "voice": "vo_adv_5010005_051",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "願望C",
    "words": "一直不回家……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這是什麼啊。",
    "voice": "vo_adv_5010005_052",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們才稍微離開一下而已！？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就已經有這麼多願望實體化了嗎……！？",
    "voice": "vo_adv_5010005_053",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "喔喔，各位！　",
    "voice": "vo_adv_5010005_054",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "原來妳們在這裡啊！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "祭司大人！　",
    "voice": "vo_adv_5010005_055",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請快逃走！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這裡我們會想辦法的！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "好的。",
    "voice": "vo_adv_5010005_056",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我們也來讓參拜的客人們",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "開始去避難。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n之後就拜託妳們了……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這麼多的願望，",
    "voice": "vo_adv_5010005_057",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一個個淨化的話……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今年就要過了，",
    "voice": "vo_adv_5010005_058",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣就不妙了……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總之",
    "voice": "vo_adv_5010005_059",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就算只有一點也好，得讓數量減少才行！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "等等，日和！　",
    "voice": "vo_adv_5010005_060",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "危險！",
    "voice": null,
    "unit_id": 108911
  }
