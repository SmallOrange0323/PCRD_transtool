    "type": "dialogue",
    "name": "優衣",
    "words": "這個聲音……！",
    "voice": "vo_adv_5136001_095",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這次換日和被攻擊了嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為什麼只攻擊她們兩個人……！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正當{0}等人被紅霧包圍，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與看不見的敵人苦戰之際……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有兩個人在旁觀著他們的情況。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊哈哈哈哈哈！",
    "voice": "vo_adv_5136001_096",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n唉呀～",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個的確有一～點難纏呢？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "揮拳！",
    "voice": "vo_adv_5136001_097",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "落空！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n踢擊！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒中！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n是像這樣嗎？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5136001_098",
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過啊，",
    "voice": "vo_adv_5136001_099",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那團霧也不曉得是太認真還是怎樣～？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n瞄準對手就要徹底地",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "排除！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "排除！！排除！！！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n退一百步來說，",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就算它採取的行動沒有問題……",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但它是不是沒有看清楚對手啊？",
    "voice": "vo_adv_5136001_100",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n要排除的目標，",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "應該是我們才對吧？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不是嗎？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………那團霧還很年幼。",
    "voice": "vo_adv_5136001_101",
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n如果有近似目標的對象出現，",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "會誤認也是無可奈何的。",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……而且。",
    "voice": "vo_adv_5136001_102",
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n有了多次被反擊的經驗後，",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "它現在警戒心變高了。",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n即使只有些微的可能性也想全部排除吧。",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊～這樣喔！",
    "voice": "vo_adv_5136001_103",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "歸根究柢這全都是我們的錯囉？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這實在是太抱歉了呢～",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………去幫忙吧。",
    "voice": "vo_adv_5136001_104",
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好的好的～！",
    "voice": "vo_adv_5136001_105",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我想說時間也差不多了♪",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……妳的回答彷彿就像是知道我在想什麼呢。",
    "voice": "vo_adv_5136001_106",
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我們才剛剛認識吧？",
    "voice": null,
    "unit_id": 135615
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只是在「這邊」",
    "voice": "vo_adv_5136001_107",
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "才剛認識而已吧？",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這點小事就別在意別在意～♪",
    "voice": null,
    "unit_id": 135513
  },
  {
    "type": "movie",
    "movie_id": "513600101"
  }
]
