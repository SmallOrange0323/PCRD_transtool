  {
    "type": "dialogue",
    "name": "實況",
    "words": "選手們正在爭奪1位男性！",
    "voice": "vo_adv_5031002_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n這恬不知恥又讓人羨慕不已的情景",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "正在眼前上演──！",
