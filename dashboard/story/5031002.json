    "name": "克莉絲提娜",
    "words": "對了，這樣正好！",
    "voice": "vo_adv_5031002_062",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不如",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就賭上這小子來場決鬥吧，",
