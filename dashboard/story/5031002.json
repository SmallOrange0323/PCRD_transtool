    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "2個檢查站提出的題目。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這場競速賽……",
    "voice": "vo_adv_5031002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "只有跑速和體力是無法獲勝的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n目前排名",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第一名，克莉絲提娜選手。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第二名，莫妮卡選手。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n第三名，秋乃選手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "　其他公會選手們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "則繼續在後面追趕～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感謝你仔細的狀況說明！",
    "voice": "vo_adv_5031002_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "各位觀眾，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我正是克莉絲提娜☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "第一名正是我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "克莉絲提娜‧摩根！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "竟然還整個大聲復誦一遍，",
    "voice": "vo_adv_5031002_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是庸俗呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我馬上就會把妳從第一名拉下來！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "以我來看，",
    "voice": "vo_adv_5031002_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "兩位都很大聲就是了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "　那個是……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "前3名的選手好像",
    "voice": "vo_adv_5031002_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "已經到達中間點了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "令人在意的題目內容是！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我看看……",
    "voice": "vo_adv_5031002_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "「將你心目中的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "款待用料理帶到檢查站」",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔？",
    "voice": "vo_adv_5031002_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我心目中的款待用料理嗎……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "太簡單了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在馬上",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "把王宮專屬主廚叫來，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓他做出款待用全餐！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "什麼！？",
    "voice": "vo_adv_5031002_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "　沒、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒時間浪費在那種事情上啦！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳想讓我的辛苦白費嗎！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "克莉絲提娜阿姨！",
    "voice": "vo_adv_5031002_009",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我覺得",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "虎虎脆片很不錯！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不是叫妳別喊我「阿姨」嗎？小姑娘♪",
    "voice": "vo_adv_5031002_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那就把那個加到款待用全餐裡吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "王宮專屬主廚！？",
    "voice": "vo_adv_5031002_011",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "　這我可不能輸……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就讓紫藤家專屬主廚來當妳們的對手！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5031002_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過就只是商人雇的主廚，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳以為能跟我們對抗嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "衛兵！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "　現在馬上就叫王宮主廚去準備款待用全餐！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n給我做好輸了就要掉腦袋的準備！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "沒想到沒想到──！",
    "voice": "vo_adv_5031002_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "　明明題目並沒有說要進行料理對決，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n她們卻擅自",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "更改了內容！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n就在她們爭執不休時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "落後的選手們也到達檢查站了～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我心目中的款待用料理？",
    "voice": "vo_adv_5031002_014",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "　……那樣的話……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "哎呀！",
    "voice": "vo_adv_5031002_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "　就在這時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "【小小甜心】的鏡華選手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n已經把某個東西帶來了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，",
    "voice": "vo_adv_5031002_016",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我媽媽讓我帶來當點心的",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "杯子蛋糕。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然外面賣的杯子蛋糕也很好吃，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是我最喜歡的",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還是媽媽做的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這",
    "voice": "vo_adv_5031002_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "毫無疑問的是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "款待用料理啊啊啊啊啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n沒想到是由後來居上的鏡華選手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第一個通過考驗！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "怎麼辦……",
    "voice": "vo_adv_5031002_018",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果題目是要推薦的書，我馬上就能拿出來了……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞！",
    "voice": "vo_adv_5031002_019",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "　這個如何！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "　牧場特製起司！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n這個精心製作的起司，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要是蘭德索爾的人",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n應該至少都吃過一次！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽！！",
    "voice": "vo_adv_5031002_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n的、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的確，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這個起司不但味道醇厚，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "營養也相當豐富……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吃了之後就會打起精神，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的確是個能當作款待用料理的好東西。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的身體狀況能變好的其中一個原因",
    "voice": "vo_adv_5031002_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n也是因為",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吃了這麼新鮮的食物……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以我心目中的款待用料理",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就是牧場的起司！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "原來如此！",
    "voice": "vo_adv_5031002_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "　這的確是大家都很熟悉的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "款待用料理！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n栞選手",
