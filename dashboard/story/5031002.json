    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "觀眾中也有流著血淚、",
    "voice": "vo_adv_5031002_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "咬牙切齒的人！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n我身為男性，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "也是同樣的心情啊啊啊啊！！",
