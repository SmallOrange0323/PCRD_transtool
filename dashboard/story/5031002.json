    "name": "實況",
    "words": "比賽進行到1區時就已經發生很多戲劇化的事了呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n凱留選手幫忙了倒下的胡桃選手……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n實在是很有運動精神的行為！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "另外，",
    "voice": "vo_adv_5031002_079",
    "unit_id": null
  },
