[
  {
    "type": "background",
    "bg_id": "502590"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可璃亞和安涅默涅好不容易完成採購，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n離開了村子，正一起走在街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "話說回來──",
    "voice": "vo_adv_5207002_000",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n欣特蘭德，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "到底在哪裡？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_5207002_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我想想……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我記得聽說是",
    "voice": "vo_adv_5207002_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "再往東邊……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "走一段路之後，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "更加北邊的地方！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "所以，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們得先穿越對面的草原。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這樣啊──",
    "voice": "vo_adv_5207002_003",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "地圖上，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "沒有記載位置嗎？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是、",
    "voice": "vo_adv_5207002_004",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是啊。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n似乎是只以口耳相傳的形式",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "流傳下來……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_5207002_005",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不過，請放心！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我會在途中好好帶路──",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呀！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──！",
    "voice": "vo_adv_5207002_006",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "痛痛痛……",
    "voice": "vo_adv_5207002_007",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對不起，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我好像有幹勁過了頭。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這種小傷，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "只要貼上OK繃──",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_5207002_008",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這是──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "藥草",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_5207002_009",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "OK繃──",
    "voice": "vo_adv_5207002_010",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n只是遮住傷口，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "對吧。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那麼，",
    "voice": "vo_adv_5207002_011",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "請先塗上這個。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這樣做，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "傷口",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "才會好得快。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……！",
    "voice": "vo_adv_5207002_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "攜手合作誠屬佳事。",
    "voice": "vo_adv_5207002_013",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "且因默涅本就",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是個心地善良的姑娘。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞",
    "voice": "vo_adv_5207002_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看上去好像也比平時更開朗。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然接下來的路程",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有段距離……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "非常抱歉。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "明明是承蒙馬車夫先生的好意，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "讓我們搭乘馬車……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "沒關係沒關係！",
    "voice": "vo_adv_5207002_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n對我來說，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "有小姐你們為我護衛，真是幫了大忙！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "最近，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "這一帶的魔物可多了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魔物啊……",
    "voice": "vo_adv_5207002_016",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果村民所說的是真的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也是想趁現在設法解決啦……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "502580"
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "「夏天快被奪走了」……？",
    "voice": "vo_adv_5207002_017",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這到底",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是什麼意思呢？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "據傳",
    "voice": "vo_adv_5207002_018",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "寒帶地區的魔物最近正在失控！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "聽說它們集結成大群，正在南下前進！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "唔嗯。",
    "voice": "vo_adv_5207002_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n寒帶地區之魔物……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n失控原因",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是否為北方暑熱難耐？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "這個嘛，",
    "voice": "vo_adv_5207002_020",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "雖然是這樣沒錯，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "但正確來說，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "該說是好像有點",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "微妙地",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "不同嗎……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啥？",
    "voice": "vo_adv_5207002_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那是什麼意思？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "傳聞說，",
    "voice": "vo_adv_5207002_022",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "該地區的魔物",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "本來就具有高度的智慧和自尊心……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n但會因為敗給炎熱",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "而變得很好捕獲。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "然後，",
    "voice": "vo_adv_5207002_023",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "聽說",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "它們無法原諒這麼愚蠢的自己，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "「那麼，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "就用魔法",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "使天氣變冷，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "讓夏天消失吧──！」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "似乎是……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "這麼一回事……？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真搞不懂它們是聰明，",
    "voice": "vo_adv_5207002_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還是笨蛋了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "不過，大事不好這件事是真的！",
    "voice": "vo_adv_5207002_025",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
