[
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在露娜之塔塔底──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "鏘鏘鏘～♪",
    "voice": "vo_adv_7028000_000",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n終於輪到",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "壓軸‧",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "迷宮女王，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n也就是拉比林斯達姐姐我登場",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "了喔！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀～",
    "voice": "vo_adv_7028000_001",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我本來就想著",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總有一天要來這裡喔？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只是",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "得優先處理的事實在是太多了～",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "露娜之塔……",
    "voice": "vo_adv_7028000_002",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡的構造充滿謎團，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且與你的記憶有所關連，這點我也有聽說。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_7028000_003",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總而言之",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "終於可以認真起來調查了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n既然我出馬，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "目標就是把那層祕密的薄紗",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n揭得一乾二淨對吧！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼就趕快打起精神出發～！",
    "voice": "vo_adv_7028000_004",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……雖然我是很想這樣說。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……少年。",
    "voice": "vo_adv_7028000_005",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你身邊那位可～愛的女孩子是？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "初次見面妳好！",
    "voice": "vo_adv_7028000_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大姐姐！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比呀，",
    "voice": "vo_adv_7028000_007",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是來幫忙",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從工作的！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊～",
    "voice": "vo_adv_7028000_008",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "請多指教囉班比！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n謝謝妳這麼有精神地跟我打招呼！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只是，",
    "voice": "vo_adv_7028000_009",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然很感謝妳願意幫忙……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這場調查可能會挺危險的喲？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比知道！",
    "voice": "vo_adv_7028000_010",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這裡",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有很多魔物對吧～？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "既然如此，",
    "voice": "vo_adv_7028000_011",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就得保護僕從才行！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比和僕從有訂「契約」",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘛！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "契約？",
    "voice": "vo_adv_7028000_012",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯！",
    "voice": "vo_adv_7028000_013",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "如果僕從遇到困難，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比就會保護他。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後，",
    "voice": "vo_adv_7028000_014",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "當班比遇到困難的時候，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從就會來幫班比。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這就是「契約」！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯～",
    "voice": "vo_adv_7028000_015",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊……！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那就沒辦法了！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我同意班比也一起來幫忙！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大姐姐，",
    "voice": "vo_adv_7028000_016",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝妳──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我是拉比林斯達。",
    "voice": "vo_adv_7028000_017",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以用妳喜歡的方式叫我喔！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "像是「拉比林斯達小姐」",
    "voice": "vo_adv_7028000_018",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或是「拉比姐姐」。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有在經營可麗餅店，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以叫「老闆」之類的？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要取暱稱我也很歡迎！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比知道了！",
    "voice": "vo_adv_7028000_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "請多指教喔，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拉比林斯達！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喔喔，",
    "voice": "vo_adv_7028000_020",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "居然直接喊名字……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "姐姐我",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "感受到妳的大器量了！",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿♪",
    "voice": "vo_adv_7028000_021",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拉比林斯達",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好帥喔！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "感覺是很可靠的大姐姐！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是嗎？",
    "voice": "vo_adv_7028000_022",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "誇獎我也",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "得不到什麼好處喔？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "之後來做可麗餅給妳吃好了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然我是希望能盡量減少",
    "voice": "vo_adv_7028000_023",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n調查中的不確定因素……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但也不能把她一個人留在這裡吧。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也罷，",
    "voice": "vo_adv_7028000_024",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "反正就算出了什麼事，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要用權能把他們兩個帶回去就好了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且…………",
    "voice": "vo_adv_7028000_025",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯在睡午覺，",
    "voice": "vo_adv_7028000_026",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以留下來看家了！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "把牠叫起來不是很可憐嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "別擔心！",
    "voice": "vo_adv_7028000_027",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比會",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n好～好地",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "保護僕從的！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": "vo_adv_7028000_028",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在的你和大家所繫起的羈絆……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我也想盡最大努力為你珍惜啊。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
