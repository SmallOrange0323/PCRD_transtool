[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鏡華放棄與花朵先生踏上旅途，決定留在蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在破除迷惘之後，她更賣力地參與地方的綠化活動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呵呵呵♪",
    "voice": "vo_adv_1307004_000",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那是當然了。",
    "voice": "vo_adv_1307004_001",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我拒絕了花朵先生的邀請，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要是不好好成長的話，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "他會對我很失望的。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "來吧，",
    "voice": "vo_adv_1307004_002",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "吸收大量的水分和陽光，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "成長茁壯吧。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……話說，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這陽光是不是有點強？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再怎麼說這也太刺眼了，",
    "voice": "vo_adv_1307004_003",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀～！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，{0}收到鏡華的邀約，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起來到了自然庭園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……到了喔。",
    "voice": "vo_adv_1307004_004",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "首先先冷靜下來深呼吸。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "吸氣～",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "吐氣……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼就出發吧！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是，",
    "voice": "vo_adv_1307004_005",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是一年一度的鮮花節。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n可以看到當季的花卉，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "甚至是稀有的植物喔！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我已經完美預習了所有會展出的植物情報，",
    "voice": "vo_adv_1307004_006",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也想好怎樣的路線才是最有效率的！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再來是……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、",
    "voice": "vo_adv_1307004_007",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我可沒有很雀躍喔？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我又不是小孩子。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這只不過",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是純粹的",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「學術興趣」而已。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你該不會什麼都不知道就跟著我來了吧？",
    "voice": "vo_adv_1307004_008",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我只有說希望你跟我一起來自然庭園？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那、",
    "voice": "vo_adv_1307004_009",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那真是抱歉了……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就是呢，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "自然庭園現在，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "正在舉辦鮮花節。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "當季的花朵當然不用說，",
    "voice": "vo_adv_1307004_010",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n在玫瑰庭園中還展示了稀有的品種。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n對喜歡花的人而言，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這是絕對不能錯過的活動！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我先說清楚，",
    "voice": "vo_adv_1307004_011",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果是跟美美或禊，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺沒辦法安靜地欣賞，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以我才會找你來的。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然要請你陪我",
    "voice": "vo_adv_1307004_012",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是可不要誤會了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的，",
    "voice": "vo_adv_1307004_013",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我早就猜到會是這樣了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過請放心吧，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我在來這裡之前已經完美地預習過了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我會好好地說明給你聽，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "絕對不會讓你感到無聊的。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "例如說呢……",
    "voice": "vo_adv_1307004_014",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那邊那棵是櫻花樹對吧？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "其實日本的櫻花樹",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "幾乎都是名為染井吉野櫻的品種。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而那種染井吉野櫻，",
    "voice": "vo_adv_1307004_015",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "它原本是以同一棵樹，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n透過嫁接和扦插來進行無性繁殖的。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個你知道嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也是，",
    "voice": "vo_adv_1307004_016",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺對你來說，食物比起植物還要更重要呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼我再告訴你",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "另一個跟櫻花，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n同時也跟甜點有關的小知識吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "櫻餅這種甜點",
    "voice": "vo_adv_1307004_017",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "外面會捲著一片櫻花葉吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n其實櫻花的葉子……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "含有毒性喔。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": "vo_adv_1307004_018",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你昨天吃了三個嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼已經太遲了……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……開玩笑的，",
    "voice": "vo_adv_1307004_019",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你不用那麼慌張。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖說有毒，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但只是少量攝取的話就沒問題。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "反而",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還會有抗菌的作用呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "嗯嗯，",
    "voice": "vo_adv_1307004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "我想聽，我想聽！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "告訴我們吧，",
    "voice": "vo_adv_1307004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "大姐姐～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這還真是，",
    "voice": "vo_adv_1307004_022",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒有辦法呢……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這些孩子是誰！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "該不會是走失兒童？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "啊啊！？",
    "voice": "vo_adv_1307004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "竟然在這種地方！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "真的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "非常抱歉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "不能隨便亂跑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "大姐姐也很困擾吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、",
    "voice": "vo_adv_1307004_024",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我沒有關係……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請問，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這該不會是幼兒園的遠足吧？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "是的。",
    "voice": "vo_adv_1307004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "其實是希望他們好好賞花的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n但孩子們果然還是待不住……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "真的很抱歉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "來，",
    "voice": "vo_adv_1307004_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "不能再打擾大姐姐了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "咦～",
    "voice": "vo_adv_1307004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "我還想再聽大姐姐說更多",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "故事～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "告",
    "voice": "vo_adv_1307004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "訴我們告訴我們！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "真是的，",
    "voice": "vo_adv_1307004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "不能這麼任性。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "那麼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "我們就先告辭──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請、",
    "voice": "vo_adv_1307004_030",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請等一下。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果不嫌棄的話，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請讓我來跟他們講解吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "咦，",
    "voice": "vo_adv_1307004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "可是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "難得大家對植物感興趣，",
    "voice": "vo_adv_1307004_032",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n想請你們",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "務必讓我來介紹！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "太好了～！",
    "voice": "vo_adv_1307004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "大姐姐！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "…",
    "voice": "vo_adv_1307004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "…",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "不好意思，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "那麼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "就拜託妳了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "130700401"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼大姐姐的植物講座，",
    "voice": "vo_adv_1307004_035",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就要開始囉～",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n各位要當個乖寶寶認真聽喔。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好～！",
    "voice": "vo_adv_1307004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很棒的回答。",
    "voice": "vo_adv_1307004_037",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼──",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這座自然庭園中，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然開著很多種類的花，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但世界上",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還有很多稀有的花。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "特別罕見的",
    "voice": "vo_adv_1307004_038",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是一種名為巨花魔芋的花，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n它可是要好幾年才會開一次花喔！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "什麼！",
    "voice": "vo_adv_1307004_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "真的嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "對。",
    "voice": "vo_adv_1307004_040",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且它的花",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "長得非常大。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就跟那位大哥哥差不多大，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還非～常地臭喔！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "啊哈哈哈！",
    "voice": "vo_adv_1307004_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "明明是花卻臭臭的，好好玩～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那種事我知道啦。",
    "voice": "vo_adv_1307004_042",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n現在是在孩子面前，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請再稍微正經一點。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼接下來",
    "voice": "vo_adv_1307004_043",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就來說說的",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "大家熟悉玫瑰花吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n大家有沒有看過",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "藍色的玫瑰呢？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "藍色的玫瑰？",
    "voice": "vo_adv_1307004_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "我沒看過那種花耶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "真的有嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "我有看過喔！",
    "voice": "vo_adv_1307004_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "超級漂亮的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒錯，",
    "voice": "vo_adv_1307004_046",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "有藍色的玫瑰花。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n其實一直到最近幾年，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "它都還不存在於自然界中。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以藍玫瑰",
    "voice": "vo_adv_1307004_047",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就象徵著「不可能」。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "不可能～？",
    "voice": "vo_adv_1307004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就是做不到，",
    "voice": "vo_adv_1307004_049",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "或是沒辦法的意思。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在許多人的努力之下，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "最後終於成功培育出藍色的玫瑰了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "藍玫瑰的花語是",
    "voice": "vo_adv_1307004_050",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「奇蹟」、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「美夢成真」。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n很適合這種將不可能變為可能的花呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以大家也一樣，",
    "voice": "vo_adv_1307004_051",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "即使未來有很累人、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很痛苦的事情，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n也不能輕易放棄喔。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只要努力的話，",
    "voice": "vo_adv_1307004_052",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就會像藍玫瑰一樣綻放的！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好～！",
    "voice": "vo_adv_1307004_053",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "──真的",
    "voice": "vo_adv_1307004_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "非常謝謝妳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n沒想到那些孩子竟然會這麼專心地聽……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "其實連我",
    "voice": "vo_adv_1307004_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "都聽得入神了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n妳真的講得很好呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "大姐姐說的故事",
    "voice": "vo_adv_1307004_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "都很有趣耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "\\n我變得",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子1",
    "words": "喜歡上花了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "我也是！",
    "voice": "vo_adv_1307004_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "下次再告訴我其他的喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子2",
    "words": "掰掰～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……",
    "voice": "vo_adv_1307004_058",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總算是講完了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "有好好地介紹嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然是順勢答應的，",
    "voice": "vo_adv_1307004_059",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但我也才剛學了這些東西，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n很擔心有沒有講得清楚……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……如果是這樣，",
    "voice": "vo_adv_1307004_060",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那我說不定可以稍微有自信一點呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我有好好地",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "做出大姐姐的表現呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼，",
    "voice": "vo_adv_1307004_061",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "接下來就換我們去賞花了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n趕快走吧，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "花兒們在等我們了！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，鏡華和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n盡情享受了活動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "感謝",
    "voice": "vo_adv_1307004_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "各位今天的蒞臨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n這個花",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "是給各位的伴手禮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇啊，",
    "voice": "vo_adv_1307004_063",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "太漂亮了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "還有，",
    "voice": "vo_adv_1307004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這是我們要私下給兩位的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "特別贈禮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個是，",
    "voice": "vo_adv_1307004_065",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "花的種子……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過特別贈禮是指？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "小姐妳，",
    "voice": "vo_adv_1307004_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "剛才在孩子們面前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "向他們解說植物吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n周圍，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "有不少人在聽妳的解說喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "大家聽了都很欽佩，",
    "voice": "vo_adv_1307004_067",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "就去看了妳解說過的花。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n這個",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "是感謝你們炒熱活動氣氛的小小謝禮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請兩位務必",
    "voice": "vo_adv_1307004_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "要栽種看看。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我的介紹……",
    "voice": "vo_adv_1307004_069",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "原來，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總覺得很開心呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我會好好地種植……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "包裝上的照片",
    "voice": "vo_adv_1307004_070",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是秋海棠。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "花語是",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「暗戀」、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「愛的告白」……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要我們兩人一起栽種的話，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那不就……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這只是碰巧而已！　",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再說",
    "voice": "vo_adv_1307004_071",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我對這個人根本就，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "根本就……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什、",
    "voice": "vo_adv_1307004_072",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什麼都沒有！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什麼都沒有啦～！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的好的，",
    "voice": "vo_adv_1307004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "心靈祥和啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看著鏡華",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是能讓人變得心靈祥和啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼小的孩子拼命努力著，",
    "voice": "vo_adv_1307004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n結果自己一個人在腦中胡思亂想，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那份可愛真的是供給過剩了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦？",
    "voice": "vo_adv_1307004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不知道為什麼她會在腦中胡思亂想？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的，",
    "voice": "vo_adv_1307004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看來你還得再多學習各種東西才行呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請多向鏡華學習。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不論有多麼地聰明努力，",
    "voice": "vo_adv_1307004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她也還只是個孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你要在她身旁好好支持她，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "作一個值得效仿的大人啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼",
    "voice": "vo_adv_1307004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今天就到此為止。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜拜～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……奇怪？",
    "voice": "vo_adv_1307004_079",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們睡著了嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是因為今天陽光很溫暖嗎……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過還真是不可思議的夢呢。",
    "voice": "vo_adv_1307004_080",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我夢到了",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "自己在跟小孩子們介紹有關植物的事……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": "vo_adv_1307004_081",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你也作了同樣的夢？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "解說得很棒？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……是啊，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "的確是不錯。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "關於花的知識和我的口條都還過得去，",
    "voice": "vo_adv_1307004_082",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n最重要的是孩子們看起來都很開心，真是太好了。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是……",
    "voice": "vo_adv_1307004_083",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你不覺得若是現在的我，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一定可以表現得更好嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這陣子",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "遇到了很多人，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "做了很多事，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "作為一名大人我經歷了許多的磨練呢。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我當然",
    "voice": "vo_adv_1307004_084",
    "unit_id": 130711
  },
  {
