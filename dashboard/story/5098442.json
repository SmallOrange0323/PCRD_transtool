  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "二人のおかげよ。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "本当にありがとう。",
