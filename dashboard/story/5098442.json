    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "ならばありがたくいただこうかのう。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "いいのかい？",
    "voice": "vo_adv_5082442_006",
    "unit_id": 120811
